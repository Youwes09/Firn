# Core kernel, on top of allnoconfig. allnoconfig also turns off the
# kernel's own defaults, so the useful ones are listed here.

CONFIG_LOCALVERSION="-firn"
CONFIG_ARCH_APPLE=y
# The DARTs work in 16K pages.
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_VA_BITS_47=y
CONFIG_NR_CPUS=10
CONFIG_HOTPLUG_CPU=y
CONFIG_SCHED_MC=y
# The E and P clusters each share an L2.
CONFIG_SCHED_CLUSTER=y
CONFIG_SCHED_CACHE=y
CONFIG_CPU_ISOLATION=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PM=y

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLK_DEV_INITRD=y
# The installer and firn-boot require a gzip initrd.
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_PRESERVE_MTIME=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_CORE_DUMP_DEFAULT_ELF_HEADERS=y
CONFIG_FW_LOADER=y
CONFIG_PREVENT_FIRMWARE_BUILD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_TIME_NS=y
CONFIG_RELR=y

CONFIG_SWAP=y
CONFIG_COMPACTION=y
CONFIG_SLAB_MERGE_DEFAULT=y

# Readable traces and error names in crash reports and logs.
CONFIG_KALLSYMS=y
CONFIG_SYMBOLIC_ERRNAME=y
CONFIG_SECTION_MISMATCH_WARN_ONLY=y
# Firn's hardware probe tools read registers through /dev/mem.
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=y

CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MODULE_REGION_FULL=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_CHECK_WX=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# CPU features the J713 reports at boot ("CPU features: detected").
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
# Userspace BTI; the kernel's own (BTI_KERNEL) is disabled for GCC and
# for Clang 21+.
CONFIG_ARM64_BTI=y
CONFIG_ARM64_CNP=y
CONFIG_ARM64_E0PD=y
CONFIG_ARM64_EPAN=y
CONFIG_ARM64_RAS_EXTN=y
CONFIG_ARM64_TLB_RANGE=y
# SME and SME2; the kernel's SME support needs SVE.
CONFIG_ARM64_SVE=y
CONFIG_ARM64_SME=y
CONFIG_ARM64_TAGGED_ADDR_ABI=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y
