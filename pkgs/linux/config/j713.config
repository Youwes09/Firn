# The MacBook Air (13-inch, M4, 2025) hardware. Built in what the boot
# needs; modules for what loads firmware or is loaded by Firn.

CONFIG_APPLE_AIC=y
CONFIG_PINCTRL=y
CONFIG_GPIOLIB=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_COMMON_CLK=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_RESET_CONTROLLER=y
CONFIG_WATCHDOG=y
CONFIG_APPLE_WATCHDOG=y
# Keep m1n1's watchdog fed until userspace takes over.
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y

# Coprocessors
CONFIG_MAILBOX=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_SART=y
CONFIG_APPLE_DART=y

# Storage
CONFIG_NVME_APPLE=y

# SMC and PMU
CONFIG_MFD_MACSMC=y
CONFIG_GPIO_MACSMC=y
CONFIG_SPMI=y
CONFIG_SPMI_APPLE=y
CONFIG_NVMEM=y
CONFIG_NVMEM_APPLE_SPMI=y
CONFIG_NVMEM_SYSFS=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MACSMC=y
# Set the clock from the RTC at boot, and keep the RTC in step.
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_NVMEM=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_PROC=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_MACSMC=y
CONFIG_POWER_SUPPLY=y
CONFIG_MACSMC_POWER=y
CONFIG_POWER_SUPPLY_HWMON=y
CONFIG_HWMON=y
CONFIG_SENSORS_MACSMC_HWMON=y

# PCIe: Wi-Fi and Bluetooth
CONFIG_PCI=y
CONFIG_PCIEASPM=y
CONFIG_PCIE_APPLE=y
# The radio's port is powered by an SMC GPIO through a fixed regulator.
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_PCI_PWRCTRL_GENERIC=y

# PMP, the power management coprocessor. Its driver is in Rust.
CONFIG_RUST=y
CONFIG_RUST_APPLE_RTKIT=y
CONFIG_APPLE_PMP=m

# Idle cores power down in wfi.
CONFIG_CPU_IDLE=y
CONFIG_ARM_APPLE_CPUIDLE=y

# Loaded by Firn before it caps the clocks.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=m

# Keyboard backlight
CONFIG_PWM=y
CONFIG_PWM_APPLE=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_PWM=y

# Console on the framebuffer m1n1 sets up
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_LEDS=y

# Display: DCP drives the panel and its backlight through the DP TX PHY.
# Built in, so DCP takes the panel over from m1n1's framebuffer early in boot.
CONFIG_DRM_APPLE=y
CONFIG_PHY_APPLE_DPTX=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Serial console on the UART m1n1's hypervisor forwards over USB
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y

# Keyboard and trackpad: the MTP behind DockChannel
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_APPLE=y
CONFIG_HID_MAGICMOUSE=y
# Raw HID access for userspace; the MTP's stm interface has no other user.
CONFIG_HIDRAW=y

# Lid switch and power button
CONFIG_INPUT_MISC=y
CONFIG_INPUT_MACSMC_INPUT=y

# USB-C: the two left ports. Host only; Firn does not use gadget mode.
CONFIG_TYPEC=y
CONFIG_TYPEC_SN201202X=y
CONFIG_PHY_APPLE_ATC=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_APPLE=y

# USB devices: input, storage and Ethernet adapters
CONFIG_USB_HID=m
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m

CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BT_HCIBCM4377=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
