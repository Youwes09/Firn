# What NixOS, systemd and the Nix sandbox need.

CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
# systemd attaches BPF to every unit; compile it rather than interpret it.
CONFIG_BPF_JIT=y
# systemd-oomd
CONFIG_PSI=y

CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_FHANDLE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y

CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
# The EFI partition
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# NixOS's systemd initrd always asks for efivarfs. m1n1 boots without
# EFI, so it finds nothing to mount.
CONFIG_EFI=y
CONFIG_EFIVAR_FS=m
# NixOS loads atkbd on every machine; a missing module fails the unit.
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=m
# hardware.firmware is zstd-compressed.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# USB drives
CONFIG_NLS_UTF8=m
CONFIG_EXFAT_FS=m

CONFIG_BLK_DEV=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_BLK_DEV_LOOP=m
CONFIG_FUSE_FS=m
