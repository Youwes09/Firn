From 949f68c371bafd8eb601e9a586a2a5aecb09b207 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Thu, 5 Nov 2026 19:07:41 -0600
Subject: [PATCH 373/375] cpufreq: apple-soc: Apply PMP's fast die-temperature
 limit

Without a host enforcing it, PMP's effort has no effect: on a J713 the
P cluster held 3756 MHz up to 112 C with the effort at 255. Map the
effort to a maximum-frequency QoS request, the fastest state whose
power fits (255 - effort) / 255 of the fastest state's. The first busy
CPU of the cluster in each tick samples it from a deferrable timer,
and a work item keeps sampling while a limit is in force. Until PMP
runs, hold the cluster at a third of its fastest state's power.

Based on Ryan Murray's fast-die limit in Aurora Silicon's tree
(116ec26bc074).

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 drivers/cpufreq/apple-soc-cpufreq.c | 287 +++++++++++++++++++++++++++-
 1 file changed, 281 insertions(+), 6 deletions(-)

diff --git a/drivers/cpufreq/apple-soc-cpufreq.c b/drivers/cpufreq/apple-soc-cpufreq.c
index 7c50ce74f911..9ed99fda013e 100644
--- a/drivers/cpufreq/apple-soc-cpufreq.c
+++ b/drivers/cpufreq/apple-soc-cpufreq.c
@@ -11,16 +11,23 @@
 #include <linux/bitops.h>
 #include <linux/cpu.h>
 #include <linux/cpufreq.h>
+#include <linux/cpuhotplug.h>
 #include <linux/cpumask.h>
 #include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
+#include <linux/jiffies.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
+#include <linux/percpu.h>
 #include <linux/pm_opp.h>
+#include <linux/pm_qos.h>
 #include <linux/slab.h>
+#include <linux/soc/apple/pmp-report.h>
+#include <linux/timer.h>
+#include <linux/workqueue.h>
 
 #define APPLE_DVFS_CMD				0x20
 #define APPLE_DVFS_CMD_BUSY			BIT(31)
@@ -69,10 +76,50 @@ struct apple_soc_cpufreq_info {
 	u64 ps1_shift;
 };
 
+/*
+ * PMP's fast die-temperature effort caps the cluster at the fastest state
+ * whose power fits (255 - effort) / 255 of the fastest state's. Busy CPUs
+ * sample it every tick; while a cap holds, a work item samples it too, so
+ * the cap lifts on an idle cluster.
+ */
+#define APPLE_FAST_DIE_EFFORT_MAX	255
+#define APPLE_FAST_DIE_FALLBACK_EFFORT	170
+#define APPLE_FAST_DIE_WAIT_MS		100
+#define APPLE_FAST_DIE_WARN_MS		30000
+
+struct apple_fast_die;
+
+struct apple_fast_die_timer {
+	struct timer_list timer;
+	struct apple_fast_die *fd;
+};
+
+struct apple_fast_die {
+	struct cpufreq_policy *policy;
+	struct device_node *report;
+	unsigned int lane;
+	/* Power of each frequency table entry, in uW */
+	unsigned long *power;
+	unsigned long max_power;
+	unsigned int max_freq;
+	unsigned int min_freq;
+	/* Current QoS value, in kHz */
+	unsigned int limit;
+	struct freq_qos_request req;
+	struct delayed_work work;
+	unsigned long sampled;
+	unsigned long warn_at;
+	bool warned;
+};
+
+static DEFINE_PER_CPU(struct apple_fast_die_timer, apple_fast_die_timers);
+static enum cpuhp_state apple_fast_die_hp;
+
 struct apple_cpu_priv {
 	struct device *cpu_dev;
 	void __iomem *reg_base;
 	const struct apple_soc_cpufreq_info *info;
+	struct apple_fast_die *fast_die;
 };
 
 static struct cpufreq_driver apple_soc_cpufreq_driver;
@@ -205,9 +252,210 @@ static unsigned int apple_soc_cpufreq_fast_switch(struct cpufreq_policy *policy,
 	return policy->freq_table[policy->cached_resolved_idx].frequency;
 }
 
+static unsigned int apple_fast_die_limit(struct apple_fast_die *fd,
+					 unsigned int effort)
+{
+	struct cpufreq_frequency_table *pos;
+	unsigned long budget;
+	unsigned int limit = 0;
+	int i;
+
+	budget = fd->max_power * (APPLE_FAST_DIE_EFFORT_MAX - effort) /
+		 APPLE_FAST_DIE_EFFORT_MAX;
+
+	cpufreq_for_each_valid_entry_idx(pos, fd->policy->freq_table, i)
+		if (fd->power[i] <= budget && pos->frequency > limit)
+			limit = pos->frequency;
+
+	return limit ?: fd->min_freq;
+}
+
+static int apple_fast_die_sample(struct apple_fast_die *fd, unsigned int *limit)
+{
+	u8 effort;
+	int err;
+
+	err = apple_pmp_report_fast_die_effort(fd->report, fd->lane, &effort);
+	*limit = apple_fast_die_limit(fd, err ? APPLE_FAST_DIE_FALLBACK_EFFORT : effort);
+
+	return err;
+}
+
+static void apple_fast_die_tick(struct timer_list *t)
+{
+	struct apple_fast_die_timer *ft = timer_container_of(ft, t, timer);
+	struct apple_fast_die *fd = ft->fd;
+	unsigned long now = jiffies;
+	unsigned int limit;
+
+	if (xchg(&fd->sampled, now) != now) {
+		apple_fast_die_sample(fd, &limit);
+		if (limit != READ_ONCE(fd->limit))
+			mod_delayed_work(system_highpri_wq, &fd->work, 0);
+	}
+
+	mod_timer(t, now + 1);
+}
+
+static void apple_fast_die_work(struct work_struct *work)
+{
+	struct apple_fast_die *fd = container_of(to_delayed_work(work),
+						 struct apple_fast_die, work);
+	unsigned int limit;
+	int err;
+
+	err = apple_fast_die_sample(fd, &limit);
+	if (limit != fd->limit) {
+		freq_qos_update_request(&fd->req, limit);
+		WRITE_ONCE(fd->limit, limit);
+	}
+
+	if (err) {
+		if (!fd->warned && time_after(jiffies, fd->warn_at)) {
+			pr_warn("CPUs %*pbl: no PMP fast die-temperature limit (%d), held at %u kHz\n",
+				cpumask_pr_args(fd->policy->related_cpus), err, limit);
+			fd->warned = true;
+		}
+		queue_delayed_work(system_highpri_wq, &fd->work,
+				   msecs_to_jiffies(APPLE_FAST_DIE_WAIT_MS));
+	} else if (limit < fd->max_freq) {
+		queue_delayed_work(system_highpri_wq, &fd->work, 1);
+	}
+}
+
+static void apple_fast_die_start_timer(unsigned int cpu)
+{
+	struct apple_fast_die_timer *ft = per_cpu_ptr(&apple_fast_die_timers, cpu);
+
+	timer_delete_sync(&ft->timer);
+	ft->timer.expires = jiffies + 1;
+	add_timer_on(&ft->timer, cpu);
+}
+
+static int apple_fast_die_cpu_online(unsigned int cpu)
+{
+	if (per_cpu(apple_fast_die_timers, cpu).fd)
+		apple_fast_die_start_timer(cpu);
+
+	return 0;
+}
+
+static int apple_fast_die_cpu_offline(unsigned int cpu)
+{
+	struct apple_fast_die_timer *ft = per_cpu_ptr(&apple_fast_die_timers, cpu);
+
+	if (ft->fd)
+		timer_delete_sync(&ft->timer);
+
+	return 0;
+}
+
+static void apple_fast_die_exit(struct apple_fast_die *fd)
+{
+	int cpu;
+
+	for_each_possible_cpu(cpu) {
+		struct apple_fast_die_timer *ft = per_cpu_ptr(&apple_fast_die_timers, cpu);
+
+		if (ft->fd == fd) {
+			timer_shutdown_sync(&ft->timer);
+			ft->fd = NULL;
+		}
+	}
+	cancel_delayed_work_sync(&fd->work);
+	freq_qos_remove_request(&fd->req);
+	of_node_put(fd->report);
+	kfree(fd->power);
+	kfree(fd);
+}
+
+static int apple_fast_die_init(struct cpufreq_policy *policy,
+			       struct device_node *cluster)
+{
+	struct apple_cpu_priv *priv = policy->driver_data;
+	struct cpufreq_frequency_table *pos;
+	struct of_phandle_args args;
+	struct apple_fast_die *fd;
+	int ret, cpu, i, n = 0;
+
+	ret = of_parse_phandle_with_fixed_args(cluster, "apple,fast-die-effort",
+					       1, 0, &args);
+	if (ret)
+		return ret == -ENOENT ? 0 : ret;
+
+	fd = kzalloc_obj(*fd);
+	if (!fd) {
+		of_node_put(args.np);
+		return -ENOMEM;
+	}
+	fd->policy = policy;
+	fd->report = args.np;
+	fd->lane = args.args[0];
+	fd->min_freq = UINT_MAX;
+
+	cpufreq_for_each_entry(pos, policy->freq_table)
+		n++;
+	fd->power = kcalloc(n, sizeof(*fd->power), GFP_KERNEL);
+	if (!fd->power) {
+		ret = -ENOMEM;
+		goto out_free;
+	}
+
+	cpufreq_for_each_valid_entry_idx(pos, policy->freq_table, i) {
+		unsigned long rate = pos->frequency * 1000UL + 999;
+		struct dev_pm_opp *opp;
+
+		opp = dev_pm_opp_find_freq_floor(priv->cpu_dev, &rate);
+		if (IS_ERR(opp)) {
+			ret = PTR_ERR(opp);
+			goto out_free;
+		}
+		fd->power[i] = dev_pm_opp_get_power(opp);
+		dev_pm_opp_put(opp);
+
+		if (!fd->power[i]) {
+			ret = -ENODATA;
+			goto out_free;
+		}
+		fd->max_power = max(fd->max_power, fd->power[i]);
+		fd->max_freq = max(fd->max_freq, pos->frequency);
+		fd->min_freq = min(fd->min_freq, pos->frequency);
+	}
+
+	fd->limit = apple_fast_die_limit(fd, APPLE_FAST_DIE_FALLBACK_EFFORT);
+	ret = freq_qos_add_request(&policy->constraints, &fd->req, FREQ_QOS_MAX,
+				   fd->limit);
+	if (ret < 0)
+		goto out_free;
+
+	fd->warn_at = jiffies + msecs_to_jiffies(APPLE_FAST_DIE_WARN_MS);
+	INIT_DELAYED_WORK(&fd->work, apple_fast_die_work);
+	queue_delayed_work(system_highpri_wq, &fd->work, 0);
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct apple_fast_die_timer *ft = per_cpu_ptr(&apple_fast_die_timers, cpu);
+
+		timer_setup(&ft->timer, apple_fast_die_tick,
+			    TIMER_DEFERRABLE | TIMER_PINNED);
+		ft->fd = fd;
+		if (cpu_online(cpu))
+			apple_fast_die_start_timer(cpu);
+	}
+
+	priv->fast_die = fd;
+	return 0;
+
+out_free:
+	kfree(fd->power);
+	of_node_put(fd->report);
+	kfree(fd);
+	return ret;
+}
+
 static int apple_soc_cpufreq_find_cluster(struct cpufreq_policy *policy,
 					  void __iomem **reg_base,
-					  const struct apple_soc_cpufreq_info **info)
+					  const struct apple_soc_cpufreq_info **info,
+					  struct device_node **cluster)
 {
 	struct of_phandle_args args;
 	const struct of_device_id *match;
@@ -220,16 +468,20 @@ static int apple_soc_cpufreq_find_cluster(struct cpufreq_policy *policy,
 		return ret;
 
 	match = of_match_node(apple_soc_cpufreq_of_match, args.np);
-	of_node_put(args.np);
-	if (!match)
+	if (!match) {
+		of_node_put(args.np);
 		return -ENODEV;
+	}
 
 	*info = match->data;
 
 	*reg_base = of_iomap(args.np, 0);
-	if (!*reg_base)
+	if (!*reg_base) {
+		of_node_put(args.np);
 		return -ENOMEM;
+	}
 
+	*cluster = args.np;
 	return 0;
 }
 
@@ -242,6 +494,7 @@ static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
 	struct apple_cpu_priv *priv;
 	const struct apple_soc_cpufreq_info *info;
 	struct cpufreq_frequency_table *freq_table;
+	struct device_node *cluster;
 
 	cpu_dev = get_cpu_device(policy->cpu);
 	if (!cpu_dev) {
@@ -253,7 +506,7 @@ static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
 	if (!priv)
 		return -ENOMEM;
 
-	ret = apple_soc_cpufreq_find_cluster(policy, &reg_base, &info);
+	ret = apple_soc_cpufreq_find_cluster(policy, &reg_base, &info, &cluster);
 	if (ret) {
 		dev_err(cpu_dev, "%s: failed to get cluster info: %d\n", __func__, ret);
 		goto out_free_priv;
@@ -306,6 +559,11 @@ static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
 	policy->fast_switch_possible = true;
 	policy->suspend_freq = freq_table[0].frequency;
 
+	ret = apple_fast_die_init(policy, cluster);
+	if (ret)
+		dev_warn(cpu_dev, "no fast die-temperature limit: %d\n", ret);
+	of_node_put(cluster);
+
 	return 0;
 
 out_free_cpufreq_table:
@@ -314,6 +572,7 @@ static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
 	dev_pm_opp_of_cpumask_remove_table(policy->cpus);
 out_iounmap:
 	iounmap(reg_base);
+	of_node_put(cluster);
 out_free_priv:
 	kfree(priv);
 	return ret;
@@ -323,6 +582,8 @@ static void apple_soc_cpufreq_exit(struct cpufreq_policy *policy)
 {
 	struct apple_cpu_priv *priv = policy->driver_data;
 
+	if (priv->fast_die)
+		apple_fast_die_exit(priv->fast_die);
 	dev_pm_opp_free_cpufreq_table(priv->cpu_dev, &policy->freq_table);
 	dev_pm_opp_of_cpumask_remove_table(policy->cpus);
 	iounmap(priv->reg_base);
@@ -346,16 +607,30 @@ static struct cpufreq_driver apple_soc_cpufreq_driver = {
 
 static int __init apple_soc_cpufreq_module_init(void)
 {
+	int ret;
+
 	if (!of_machine_is_compatible("apple,arm-platform"))
 		return -ENODEV;
 
-	return cpufreq_register_driver(&apple_soc_cpufreq_driver);
+	ret = cpuhp_setup_state_nocalls(CPUHP_AP_ONLINE_DYN, "cpufreq/apple:fast-die",
+					apple_fast_die_cpu_online,
+					apple_fast_die_cpu_offline);
+	if (ret < 0)
+		return ret;
+	apple_fast_die_hp = ret;
+
+	ret = cpufreq_register_driver(&apple_soc_cpufreq_driver);
+	if (ret)
+		cpuhp_remove_state_nocalls(apple_fast_die_hp);
+
+	return ret;
 }
 module_init(apple_soc_cpufreq_module_init);
 
 static void __exit apple_soc_cpufreq_module_exit(void)
 {
 	cpufreq_unregister_driver(&apple_soc_cpufreq_driver);
+	cpuhp_remove_state_nocalls(apple_fast_die_hp);
 }
 module_exit(apple_soc_cpufreq_module_exit);
 
-- 
2.54.0

