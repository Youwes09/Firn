+/// Put the firmware to sleep while the GPU is still bound. Clients that keep
+/// the DRM device open see it fail from here on.
+pub(crate) fn unbind(pdev: &platform::Device<Bound>, device: &Device) {
+    device.failed.store(true, Ordering::Release);
+    device.notifications.notify(false);
+    device.runtime.lock().shutdown(pdev.as_ref());
+}
