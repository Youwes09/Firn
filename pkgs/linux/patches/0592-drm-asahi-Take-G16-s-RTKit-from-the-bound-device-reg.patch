+/// Send a message to a firmware endpoint, failing once the GPU unbinds.
+fn send_message(rtkit: &rtkit::DevresRegistration<BootData>, endpoint: u8, message: u64) -> Result {
+    rtkit
+        .try_access()
+        .ok_or(ENODEV)?
+        .rtkit()
+        .send_message_atomic(endpoint, message)
+}
