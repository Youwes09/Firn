 impl Bootstrap {
+    /// Put the firmware to sleep while its mailbox is still bound. Call on
+    /// unbind; a failure leaves the GPU mappings to be retained on drop.
+    pub(crate) fn shutdown(&mut self, dev: &kernel::device::Device<kernel::device::Bound>) {
+        if self.stopped {
+            return;
+        }
+        match self._rtkit.access(dev).and_then(|rtkit| rtkit.rtkit().shutdown()) {
+            Ok(()) => self.stopped = true,
+            Err(e) => dev_err!(dev, "G16: shutdown failed {:?}\n", e),
