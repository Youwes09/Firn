From 6e389ea0ee1d4e7bed6bab0c2a26787aaecdaf0d Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Fri, 30 Oct 2026 18:44:50 -0500
Subject: [PATCH] HID: dockchannel: Check the sub-header length before
 dispatching

The ACK handler and the packet worker each reject a sub-header that
claims more data than the packet carries, but a report packet is only
checked after a work item has been allocated and queued for it. Drop
such packets in dchid_dispatch() instead.

From Gravity Linux d4e7c10c30b61, which integrates Niklas Sheth's
bits/090-spi-hid.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 drivers/hid/dockchannel-hid/dockchannel-hid.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid.c b/drivers/hid/dockchannel-hid/dockchannel-hid.c
index 0639a3097d9e..d8b43cabbc6a 100644
--- a/drivers/hid/dockchannel-hid/dockchannel-hid.c
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid.c
@@ -1222,6 +1222,9 @@ static int dchid_dispatch(struct dockchannel_hid *dchid, struct dchid_hdr *hdr,
 
 	if (hdr->iface >= MAX_INTERFACES || hdr->length < sizeof(struct dchid_subhdr))
 		return 0;
+	if (((struct dchid_subhdr *)data)->length >
+	    hdr->length - sizeof(struct dchid_subhdr))
+		return 0;
 	iface = dchid->ifaces[hdr->iface];
 	if (!iface) {
 		dev_err(dchid->dev, "Received packet for uninitialized iface %d\n", hdr->iface);
