From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Mon, 2 Nov 2026 20:56:36 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j713: Add the CPU thermal zone

Cap both CPU clusters through power_allocator on TCMz.

TCMz is the hottest of the CPU sensors, but the SMC refreshes it once a
second, while on the J713 the hot spot follows CPU power within 0.1 s,
about 3 C per watt above the package. So the zone has a single passive
trip and no switch-on trip, and the governor works on the clusters'
power below the 90 C target as well as above it.

This holds sustained load: all ten CPUs busy for 15 minutes average
90.0 C and peak 93.5 C. It cannot stop a step. Idle CPUs leave their
cooling devices uncapped, and four P cores starting at 3.9 GHz heat the
hot spot by up to 48 C before the next reading, so the P cluster needs a
clock limit outside the zone. The critical trip is a backstop.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 arch/arm64/boot/dts/apple/t8132-j713.dts | 47 ++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713.dts b/arch/arm64/boot/dts/apple/t8132-j713.dts
index 685ed36bd6e1..b4e4d150ee84 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j713.dts
@@ -12,6 +12,7 @@
 #include "t8132.dtsi"
 #include "t8132-jxxx.dtsi"
 #include <dt-bindings/leds/common.h>
+#include <dt-bindings/thermal/thermal.h>
 
 / {
 	compatible = "apple,j713", "apple,t8132", "apple,arm-platform";
@@ -36,6 +37,50 @@ led-0 {
 		};
 	};
 
+	thermal-zones {
+		/*
+		 * The CPU hot spot follows CPU power within 0.1 s, far faster than
+		 * the SMC reports it, so the zone has no switch-on trip and
+		 * power_allocator works below the target as well as above it.
+		 */
+		cpu-thermal {
+			polling-delay-passive = <500>;
+			polling-delay = <500>;
+			thermal-sensors = <&smc_hwmon 4>;
+			sustainable-power = <6000>;
+
+			trips {
+				cpu_control: cpu-control {
+					temperature = <90000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				cpu-critical {
+					temperature = <105000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu_control>;
+					cooling-device =
+						<&cpu_e0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_e1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_e2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_e3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_e4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_e5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+	};
 };
 
 &wifi0 {
@@ -282,6 +327,8 @@ &ps_nub_spi0 {
 #include "hwmon-laptop.dtsi"
 
 &smc_hwmon {
+	#thermal-sensor-cells = <1>;
+
 	current-IP0b {
 		label = "P-cluster Rail Current";
 		apple,key-id = "IP0b";
