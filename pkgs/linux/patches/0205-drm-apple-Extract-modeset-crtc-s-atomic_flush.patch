 	.get_modes		= dcp_get_modes,
 	.mode_valid		= dcp_mode_valid,
+	.atomic_check		= dcp_connector_atomic_check,
+
 };
 
 static const struct drm_crtc_helper_funcs apple_crtc_helper_funcs = {
