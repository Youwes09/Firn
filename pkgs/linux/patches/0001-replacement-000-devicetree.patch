+			       <0x3 0x91028000 0x0 0x4000>,	/* port1 */
+			       <0x3 0x92028000 0x0 0x4000>,	/* port2 */
+			       <0x3 0x97020000 0x0 0x4000>,	/* phy0 */
+			       <0x3 0x97024000 0x0 0x4000>,	/* phy1 */
+			       <0x3 0x97028000 0x0 0x4000>;	/* phy2 */
+			reg-names = "config", "rc", "port0", "port1", "port2", "phy0", "phy1", "phy2";
+
+			interrupt-parent = <&aic>;
