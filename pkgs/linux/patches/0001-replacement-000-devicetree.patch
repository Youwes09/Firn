 	ps_pms_fpwm0: power-controller@140 {
@@ -152,8 +154,8 @@ ps_dispext0_cpu: power-controller@1e8 {
 		#reset-cells = <0>;
 		label = "dispext0_cpu";
 		power-domains = <&ps_dispext0_fe>;
-
-		status = "disabled"; /* Locked, don't touch it */
