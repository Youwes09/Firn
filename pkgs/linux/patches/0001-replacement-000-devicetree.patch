+&aop_audio {
+	apple,chassis-name = "J616";
+	apple,machine-kind = "MacBook Pro";
+};
+/ {
+    compatible = "apple,j616c", "apple,t6041", "apple,arm-platform";
+    model = "Apple MacBook Pro (16-inch, M4 Max, 2024)";
+    chassis-type = "laptop";
+    chosen { stdout-path = "serial0:115200n8"; };
+    memory@800000000 { device_type = "memory"; reg = <8 0 0 0>; };
+};
+
+&dcp {
+	panel {
+		/* 3456 x 2234 at 254 ppi: 345.6 x 223.4 mm. */
+		width-mm = <346>;
+		height-mm = <223>;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6041-mtp.dtsi b/arch/arm64/boot/dts/apple/t6041-mtp.dtsi
new file mode 100644
index 0000000000000..5864a645965ad
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6041-mtp.dtsi
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/* J616c MTP. Addresses are resolved CPU physical addresses from the board ADT.
+ * Raw arm-io addresses for these devices require a 0x200000000 translation.
+ */
+/ {
+	aliases {
+		keyboard = &mtp_keyboard;
+	};
+};
+
+&{/soc} {
+	mtp: mtp@514600000 {
+		compatible = "apple,t6041-mtp", "apple,mtp", "apple,rtk-helper-asc4";
+		reg = <0x5 0x14600000 0 0x4000>;
+		reg-names = "asc";
+		mboxes = <&mtp_mbox>;
+		iommus = <&mtp_dart 0>;
+		#helper-cells = <0>;
+	};
+
+	mtp_mbox: mailbox@514608000 {
+		compatible = "apple,t6041-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x5 0x14608000 0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 792 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 793 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 794 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 795 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+
+	mtp_dart: iommu@514800000 {
+		compatible = "apple,t6041-dart", "apple,t8110-dart";
+		reg = <0x5 0x14800000 0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 775 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		apple,sid-remap = <1 0>, <2 0>, <3 0>;
+	};
+
+	mtp_dockchannel: fifo@514b14000 {
+		compatible = "apple,t6041-dockchannel", "apple,dockchannel";
+		reg = <0x5 0x14b14000 0 0x1000>;
+		reg-names = "irq";
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 776 IRQ_TYPE_LEVEL_HIGH>;
+		ranges = <0 0x5 0x14b28000 0x10000>;
+		nonposted-mmio;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+
+		mtp_hid: input@0 {
+			/* M4-family shared-ring transport, rather than the older FIFO ABI. */
+			compatible = "apple,t6041-dockchannel-hid", "apple,t8132-dockchannel-hid", "apple,dockchannel-hid";
+			reg = <0x0000 0x1000>, <0x4000 0x1000>, <0x8000 0x1000>, <0xc000 0x1000>;
+			reg-names = "rmt-config", "rmt-data", "config", "data";
+			iommus = <&mtp_dart 0>;
+			interrupt-parent = <&mtp_dockchannel>;
+			interrupts = <2 IRQ_TYPE_LEVEL_HIGH>, <3 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "tx", "rx";
+			apple,fifo-size = <0x800>;
+			apple,helper-cpu = <&mtp>;
+
+			mtp_keyboard: keyboard {
+				hid-country-code = <0>;
+				apple,keyboard-layout-id = <0>;
+			};
+			multi-touch {
+				firmware-name = "apple/tpmtfw-j616c.bin";
+			};
+			stm {};
+			actuator {};
+			tp-accel {};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6041-pmgr.dtsi b/arch/arm64/boot/dts/apple/t6041-pmgr.dtsi
new file mode 100644
index 0000000000000..36e49669c239d
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6041-pmgr.dtsi
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/* Verified J616c power-state nodes needed by PMP, ISP and internal DCP. */
+&{/soc} {
+	pmgr0: power-management@502280000 {
+		compatible = "apple,t6041-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		reg = <0x5 0x2280000 0 0x8000>;
+		ps_ispsens0: power-controller@0 {
+			compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x0 4>;
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+			label = "ispsens0";
+		};
+		ps_disp_sys: power-controller@258 {
+			compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x258 4>;
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+			label = "disp_sys";
+			power-domains = <&ps_fab6_soc>;
+		};
+		ps_disp_fe: power-controller@368 {
+			compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x368 4>;
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+			label = "disp_fe";
+			power-domains = <&ps_disp_sys>;
+		};
+		ps_isp_sys: power-controller@378 {
+			compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x378 4>;
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+			label = "isp_sys";
+			power-domains = <&ps_fab6_soc>;
+		};
+	};
+	pmgr1: power-management@502800000 {
+		compatible = "apple,t6041-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		reg = <0x5 0x2800000 0 0x4000>;
+		ps_pms: power-controller@100 {
+			compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x100 4>;
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+			label = "pms";
+			apple,always-on;
+		};
+		ps_afi: power-controller@110 {
+			compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x110 4>;
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+			label = "afi";
+			apple,always-on;
+		};
+		ps_pmp: power-controller@410 {
+			compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x410 4>;
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+			label = "pmp";
+			apple,always-on;
+			power-domains = <&ps_pms>;
+		};
+		ps_pms_sram: power-controller@418 {
+			compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x418 4>;
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+			label = "pms_sram";
+			apple,always-on;
+			power-domains = <&ps_pms>;
+		};
+		ps_fab6_soc: power-controller@480 {
+			compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x480 4>;
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+			label = "fab6_soc";
+			apple,always-on;
+			power-domains = <&ps_afi>;
+		};
+	};
+};
+
+/* Native ISP virtual-domain implementation uses this six-register bank.
+ * It is not described by ordinary PMGR ps-groups entries in the ADT.
+ */
+&pmgr0 {
+	ps_isp_block0: power-controller@4000 {
+		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4000 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp-block0";
+		power-domains = <&pmp_report_isp_sys>;
+	};
+	ps_isp_block1: power-controller@4008 {
+		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4008 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp-block1";
+		power-domains = <&pmp_report_isp_sys>;
+	};
+	ps_isp_block2: power-controller@4010 {
+		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4010 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp-block2";
+		power-domains = <&pmp_report_isp_sys>;
+	};
+	ps_isp_block3: power-controller@4018 {
+		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4018 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp-block3";
+		power-domains = <&pmp_report_isp_sys>;
+	};
+	ps_isp_block4: power-controller@4020 {
+		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4020 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp-block4";
+		power-domains = <&pmp_report_isp_sys>;
+	};
+	ps_isp_block5: power-controller@4028 {
+		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4028 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp-block5";
+		power-domains = <&pmp_report_isp_sys>;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6041-pmp.dtsi b/arch/arm64/boot/dts/apple/t6041-pmp.dtsi
new file mode 100644
index 0000000000000..810030befb249
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6041-pmp.dtsi
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/* J616c PMP: native resource, mailbox and DMA topology. m1n1 supplies
+ * board calibration and tunables through the pmp alias.
+ */
+/ {
+	aliases { pmp = &pmp; };
+};
+
+&{/soc} {
+	pmp_report: power-management@5003c0000 {
+		compatible = "apple,t6041-pmp-v2-report";
+		reg = <5 0x003c0000 0 0x20000>;
+		power-domains = <&ps_pms_sram>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		pmp_report_isp_sys: report@f {
+			compatible = "apple,t6000-pmp-v2-report-entry";
+			reg = <15>;
+			label = "pmp-isp-sys";
+			#power-domain-cells = <0>;
+			power-domains = <&ps_isp_sys>;
+		};
+
+		pmp_report_disp: report@10 {
+			compatible = "apple,t6000-pmp-v2-report-entry";
+			reg = <16>;
+			label = "pmp-disp";
+			#power-domain-cells = <0>;
+			power-domains = <&ps_disp_fe>;
+			/* Keep the resident internal DCP/display active. */
+			apple,always-on;
+		};
+	};
+
+	pmp_dart: iommu@500300000 {
+		compatible = "apple,t6041-dart", "apple,t8110-dart";
+		reg = <5 0x00300000 0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 389 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		power-domains = <&ps_pmp>;
+		apple,dma-range = <0x100 0x00014000 0xf 0xfffec000>;
+	};
+
+	pmp_mbox: mailbox@500e08000 {
+		compatible = "apple,t6041-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <5 0x00e08000 0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 414 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 415 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 416 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 417 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+			"recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+		power-domains = <&ps_pmp>, <&ps_pms_sram>;
+	};
+
+	pmp: pmp@500700000 {
+		compatible = "apple,t6041-pmp-v2";
+		reg = <5 0x00700000 0 0xe0000>,
+		      <5 0x00e00000 0 0x4000>;
+		reg-names = "pmp", "asc";
+		mboxes = <&pmp_mbox>;
+		mbox-names = "mbox";
+		iommus = <&pmp_dart 0>;
+		power-domains = <&ps_pmp>;
+		status = "disabled";
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6041-wireless.dtsi b/arch/arm64/boot/dts/apple/t6041-wireless.dtsi
new file mode 100644
index 0000000000000..34835009d4667
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6041-wireless.dtsi
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/* J616c Wi-Fi/Bluetooth PCIe port. Resources verified through live ADT get_reg.
+ * m1n1 supplies MAC addresses, antenna SKU and calibration blobs.
+ */
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/apple.h>
+/ {
+	aliases { wifi0 = &wifi0; bluetooth0 = &bluetooth0; };
+};
+&{/soc} {
+	pinctrl_ap: pinctrl@51c000000 {
+		compatible = "apple,t6041-pinctrl", "apple,t8103-pinctrl";
+		reg = <5 0x1c000000 0 0x4000>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&pinctrl_ap 0 0 200>;
+		apple,npins = <200>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 478 IRQ_TYPE_LEVEL_HIGH>, <AIC_IRQ 479 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 480 IRQ_TYPE_LEVEL_HIGH>, <AIC_IRQ 481 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 482 IRQ_TYPE_LEVEL_HIGH>, <AIC_IRQ 483 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 484 IRQ_TYPE_LEVEL_HIGH>;
+		pcie0_pins: pcie0-pins { pinmux = <APPLE_PINMUX(0, 2)>; };
+	};
+	pcie0_dart: iommu@410000000 {
+		compatible = "apple,t6041-dart", "apple,t8110-dart";
+		reg = <4 0x10000000 0 0x20000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1724 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+	};
+	pcie0: pcie@1cb0000000 {
+		compatible = "apple,t6041-pcie", "apple,t6020-pcie";
+		device_type = "pci";
+		reg = <0x1c 0xb0000000 0 0x1000000>, <4 0x14000000 0 0x4000>,
+			<4 0x10028000 0 0x8000>, <4 0x17020000 0 0x4000>;
+		reg-names = "config", "rc", "port0", "phy0";
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1723 IRQ_TYPE_LEVEL_HIGH>;
+		msi-controller;
+		msi-parent = <&pcie0>;
+		msi-ranges = <&aic AIC_IRQ 2071 IRQ_TYPE_EDGE_RISING 32>;
+		iommu-map = <0x100 &pcie0_dart 0 1>, <0x101 &pcie0_dart 1 1>;
+		iommu-map-mask = <0xffff>;
+		bus-range = <0 4>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges = <0x43000000 0xb 0xc0000000 0xb 0xc0000000 0 0x20000000>,
+			<0x02000000 0 0x80000000 0xb 0x80000000 0 0x40000000>;
+		pinctrl-0 = <&pcie0_pins>;
+		pinctrl-names = "default";
+		port00: pci@0,0 {
+			compatible = "pciclass,0604";
+			device_type = "pci";
+			reg = <0 0 0 0 0>;
+			reset-gpios = <&pinctrl_ap 4 GPIO_ACTIVE_LOW>;
+			power-supply = <&vreg_wifi>;
+			bus-range = <1 1>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges;
+			interrupt-controller;
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &port00 0 0 0 0>, <0 0 0 2 &port00 0 0 0 1>,
+				<0 0 0 3 &port00 0 0 0 2>, <0 0 0 4 &port00 0 0 0 3>;
+			wifi0: wifi@0,0 {
+				compatible = "pci14e4,4434";
+				reg = <0x10000 0 0 0 0>;
+				brcm,board-type = "apple,hostomel";
+				local-mac-address = [00 00 00 00 00 00];
+				apple,antenna-sku = "XX";
+			};
+			bluetooth0: bluetooth@0,1 {
+				compatible = "pci14e4,5f72";
+				reg = <0x10100 0 0 0 0>;
+				brcm,board-type = "apple,hostomel";
+				local-bd-address = [00 00 00 00 00 00];
+			};
+		};
+	};
+};
+
+/ {
+	vreg_wifi: regulator-wifi {
+		compatible = "regulator-fixed";
+		regulator-name = "pwren-wifi-bt";
+		/* /amfm/function-reg_on identifies SMC GPIO gP13. */
+		gpio = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+&{/soc} {
+	smc_mbox: mailbox@50c608000 {
+		compatible = "apple,t6041-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <5 0x0c608000 0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 996 IRQ_TYPE_LEVEL_HIGH>, <AIC_IRQ 997 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 998 IRQ_TYPE_LEVEL_HIGH>, <AIC_IRQ 999 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+	smc: smc@50c600000 {
+		compatible = "apple,t6041-smc", "apple,t8103-smc";
+		reg = <5 0x0c600000 0 0x4000>, <5 0x0de00000 0 0x100000>;
+		reg-names = "smc", "sram";
+		mboxes = <&smc_mbox>;
+		smc_gpio: gpio {
+			compatible = "apple,smc-gpio";
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6041.dtsi b/arch/arm64/boot/dts/apple/t6041.dtsi
new file mode 100644
index 0000000000000..05655a7e9fbc9
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6041.dtsi
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Minimal T6041 CPU/interrupt/GPU bring-up description. Peripheral support is
+ * intentionally added only with its own hardware evidence. GPU calibration,
+ * OPPs and reserved firmware ranges are supplied by m1n1, never read as ADT
+ * by the Linux driver. Addresses: clean J616c ADT and source-qualified shim.
+ */
+#include <dt-bindings/interrupt-controller/apple-aic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+/ {
+    compatible = "apple,t6041", "apple,arm-platform";
+    #address-cells = <2>;
+    #size-cells = <2>;
+    aliases { gpu = &gpu; serial0 = &serial0; };
+    cpus {
+        #address-cells = <2>;
+        #size-cells = <0>;
+        cpu0: cpu@0 {
+            compatible = "apple,sawtooth";
+            device_type = "cpu";
+            reg = <0 0x0>;
+#ifdef M1N1_MONITOR
+            enable-method = "psci";
+#else
+            enable-method = "spin-table";
+#endif
+            cpu-release-addr = <0 0>;
+        };
+        cpu1: cpu@1 {
+            compatible = "apple,sawtooth";
+            device_type = "cpu";
+            reg = <0 0x1>;
+#ifdef M1N1_MONITOR
+            enable-method = "psci";
+#else
+            enable-method = "spin-table";
+#endif
+            cpu-release-addr = <0 0>;
+        };
+        cpu2: cpu@2 {
+            compatible = "apple,sawtooth";
+            device_type = "cpu";
+            reg = <0 0x2>;
+#ifdef M1N1_MONITOR
+            enable-method = "psci";
+#else
+            enable-method = "spin-table";
+#endif
+            cpu-release-addr = <0 0>;
+        };
+        cpu3: cpu@3 {
+            compatible = "apple,sawtooth";
+            device_type = "cpu";
+            reg = <0 0x3>;
+#ifdef M1N1_MONITOR
+            enable-method = "psci";
+#else
+            enable-method = "spin-table";
+#endif
+            cpu-release-addr = <0 0>;
+        };
+        cpu4: cpu@10100 {
+            compatible = "apple,everest";
+            device_type = "cpu";
+            reg = <0 0x10100>;
+#ifdef M1N1_MONITOR
+            enable-method = "psci";
+#else
+            enable-method = "spin-table";
+#endif
+            cpu-release-addr = <0 0>;
+        };
+        cpu5: cpu@10101 {
+            compatible = "apple,everest";
