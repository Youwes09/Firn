diff --git a/arch/arm64/boot/dts/apple/t6041-cpufreq.dtsi b/arch/arm64/boot/dts/apple/t6041-cpufreq.dtsi
new file mode 100644
index 0000000000000..0a842388b1726
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6041-cpufreq.dtsi
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/* Three independent T6041 CPU DVFS domains. m1n1 fills the frequencies from
+ * each board's PMGR SRAM table; Linux consumes only standard FDT OPPs.
+ * Keep the last E step and the last two P steps behind the boost switch.
+ */
+/ {
+	cpu_e_opp: opp-table-cpu-e {
+		compatible = "operating-points-v2";
+		opp-shared;
+		opp01 { opp-hz = /bits/ 64 <0>; opp-level = <1>; };
+		opp02 { opp-hz = /bits/ 64 <0>; opp-level = <2>; };
+		opp03 { opp-hz = /bits/ 64 <0>; opp-level = <3>; };
+		opp04 { opp-hz = /bits/ 64 <0>; opp-level = <4>; };
+		opp05 { opp-hz = /bits/ 64 <0>; opp-level = <5>; };
+		opp06 { opp-hz = /bits/ 64 <0>; opp-level = <6>; };
+		opp07 { opp-hz = /bits/ 64 <0>; opp-level = <7>; turbo-mode; };
+	};
+	cpu_p0_opp: opp-table-cpu-p0 {
+		compatible = "operating-points-v2";
+		opp-shared;
+		opp01 { opp-hz = /bits/ 64 <0>; opp-level = <1>; };
+		opp02 { opp-hz = /bits/ 64 <0>; opp-level = <2>; };
+		opp03 { opp-hz = /bits/ 64 <0>; opp-level = <3>; };
+		opp04 { opp-hz = /bits/ 64 <0>; opp-level = <4>; };
+		opp05 { opp-hz = /bits/ 64 <0>; opp-level = <5>; };
+		opp06 { opp-hz = /bits/ 64 <0>; opp-level = <6>; };
+		opp07 { opp-hz = /bits/ 64 <0>; opp-level = <7>; };
+		opp08 { opp-hz = /bits/ 64 <0>; opp-level = <8>; };
+		opp09 { opp-hz = /bits/ 64 <0>; opp-level = <9>; };
+		opp10 { opp-hz = /bits/ 64 <0>; opp-level = <10>; };
+		opp11 { opp-hz = /bits/ 64 <0>; opp-level = <11>; };
+		opp12 { opp-hz = /bits/ 64 <0>; opp-level = <12>; };
+		opp13 { opp-hz = /bits/ 64 <0>; opp-level = <13>; };
+		opp14 { opp-hz = /bits/ 64 <0>; opp-level = <14>; };
+		opp15 { opp-hz = /bits/ 64 <0>; opp-level = <15>; };
+		opp16 { opp-hz = /bits/ 64 <0>; opp-level = <16>; };
+		opp17 { opp-hz = /bits/ 64 <0>; opp-level = <17>; };
+		opp18 { opp-hz = /bits/ 64 <0>; opp-level = <18>; };
+		opp19 { opp-hz = /bits/ 64 <0>; opp-level = <19>; turbo-mode; };
+		opp20 { opp-hz = /bits/ 64 <0>; opp-level = <20>; turbo-mode; };
+	};
+	cpu_p1_opp: opp-table-cpu-p1 {
+		compatible = "operating-points-v2";
+		opp-shared;
+		opp01 { opp-hz = /bits/ 64 <0>; opp-level = <1>; };
+		opp02 { opp-hz = /bits/ 64 <0>; opp-level = <2>; };
+		opp03 { opp-hz = /bits/ 64 <0>; opp-level = <3>; };
+		opp04 { opp-hz = /bits/ 64 <0>; opp-level = <4>; };
+		opp05 { opp-hz = /bits/ 64 <0>; opp-level = <5>; };
+		opp06 { opp-hz = /bits/ 64 <0>; opp-level = <6>; };
+		opp07 { opp-hz = /bits/ 64 <0>; opp-level = <7>; };
+		opp08 { opp-hz = /bits/ 64 <0>; opp-level = <8>; };
+		opp09 { opp-hz = /bits/ 64 <0>; opp-level = <9>; };
+		opp10 { opp-hz = /bits/ 64 <0>; opp-level = <10>; };
+		opp11 { opp-hz = /bits/ 64 <0>; opp-level = <11>; };
+		opp12 { opp-hz = /bits/ 64 <0>; opp-level = <12>; };
+		opp13 { opp-hz = /bits/ 64 <0>; opp-level = <13>; };
+		opp14 { opp-hz = /bits/ 64 <0>; opp-level = <14>; };
+		opp15 { opp-hz = /bits/ 64 <0>; opp-level = <15>; };
+		opp16 { opp-hz = /bits/ 64 <0>; opp-level = <16>; };
+		opp17 { opp-hz = /bits/ 64 <0>; opp-level = <17>; };
+		opp18 { opp-hz = /bits/ 64 <0>; opp-level = <18>; };
+		opp19 { opp-hz = /bits/ 64 <0>; opp-level = <19>; turbo-mode; };
+		opp20 { opp-hz = /bits/ 64 <0>; opp-level = <20>; turbo-mode; };
+	};
+};
+
+&{/soc} {
+	cpufreq_e: performance-controller@210e20000 {
+		compatible = "apple,t6041-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
+		reg = <0x2 0x10e20000 0 0x1000>;
+		#performance-domain-cells = <0>;
+	};
+	cpufreq_p0: performance-controller@211e20000 {
+		compatible = "apple,t6041-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
+		reg = <0x2 0x11e20000 0 0x1000>;
+		#performance-domain-cells = <0>;
+	};
+	cpufreq_p1: performance-controller@212e20000 {
+		compatible = "apple,t6041-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
+		reg = <0x2 0x12e20000 0 0x1000>;
+		#performance-domain-cells = <0>;
+	};
+};
+
+&cpu0 { operating-points-v2 = <&cpu_e_opp>; performance-domains = <&cpufreq_e>; };
+&cpu1 { operating-points-v2 = <&cpu_e_opp>; performance-domains = <&cpufreq_e>; };
+&cpu2 { operating-points-v2 = <&cpu_e_opp>; performance-domains = <&cpufreq_e>; };
+&cpu3 { operating-points-v2 = <&cpu_e_opp>; performance-domains = <&cpufreq_e>; };
+&cpu4 { operating-points-v2 = <&cpu_p0_opp>; performance-domains = <&cpufreq_p0>; };
+&cpu5 { operating-points-v2 = <&cpu_p0_opp>; performance-domains = <&cpufreq_p0>; };
+&cpu6 { operating-points-v2 = <&cpu_p0_opp>; performance-domains = <&cpufreq_p0>; };
+&cpu7 { operating-points-v2 = <&cpu_p0_opp>; performance-domains = <&cpufreq_p0>; };
+&cpu8 { operating-points-v2 = <&cpu_p0_opp>; performance-domains = <&cpufreq_p0>; };
+&cpu9 { operating-points-v2 = <&cpu_p0_opp>; performance-domains = <&cpufreq_p0>; };
+&cpu10 { operating-points-v2 = <&cpu_p1_opp>; performance-domains = <&cpufreq_p1>; };
+&cpu11 { operating-points-v2 = <&cpu_p1_opp>; performance-domains = <&cpufreq_p1>; };
+&cpu12 { operating-points-v2 = <&cpu_p1_opp>; performance-domains = <&cpufreq_p1>; };
+&cpu13 { operating-points-v2 = <&cpu_p1_opp>; performance-domains = <&cpufreq_p1>; };
+&cpu14 { operating-points-v2 = <&cpu_p1_opp>; performance-domains = <&cpufreq_p1>; };
+&cpu15 { operating-points-v2 = <&cpu_p1_opp>; performance-domains = <&cpufreq_p1>; };
diff --git a/arch/arm64/boot/dts/apple/t6041-display.dtsi b/arch/arm64/boot/dts/apple/t6041-display.dtsi
new file mode 100644
index 0000000000000..3ebb30116437c
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6041-display.dtsi
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/* Primary internal-display bringup. The loader supplies native reservations
+ * and firmware properties. External display controllers are a later step.
+ */
+/ {
+	aliases {
+		dcp = &dcp;
+		disp0 = &display;
+		disp0_piodma = &disp0_piodma;
+	};
+	clk_disp0: clock-disp0 {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		/* Retained iBoot rate: native 26.6 D408 replies 712 MHz on J616c.
+		 * This describes the boot clock; runtime DVFS is not implemented. */
+		clock-frequency = <712000000>;
+	};
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		framebuffer0: framebuffer@0 {
+			compatible = "apple,simple-framebuffer", "simple-framebuffer";
+			reg = <0 0 0 0>;
+			status = "disabled";
+		};
+	};
+};
+
+&{/soc} {
+	disp0_dart: iommu@402300000 {
+		compatible = "apple,t6041-dart", "apple,t8110-dart";
+		reg = <4 0x02300000 0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1090 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		/* Native locked three-level tables use the low 36-bit aperture. */
+		status = "disabled";
+	};
+	dcp_dart: iommu@402340000 {
+		compatible = "apple,t6041-dart", "apple,t8110-dart";
+		reg = <4 0x02340000 0 0x20000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1090 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+	};
+	dcp_mbox: mailbox@402e08000 {
+		compatible = "apple,t6041-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <4 0x02e08000 0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1143 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 1144 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 1145 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 1146 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+	pmgr_dcp: power-management@504800000 {
+		reg = <5 0x04800000 0 0xbc000>;
+		#apple,bw-scratch-cells = <3>;
+	};
+	dcp: dcp@402e00000 {
+		compatible = "apple,t6041-dcp", "apple,dcp";
+		mboxes = <&dcp_mbox>;
+		mbox-names = "mbox";
+		iommus = <&dcp_dart 23>;
+		reg-names = "coproc", "disp-0", "disp-1", "disp-2", "disp-3";
+		reg = <4 0x02e00000 0 0x4000>,
+		      <4 0x00000000 0 0x4000000>,
+		      <4 0x02240000 0 0x10000>,
+		      <4 0x023a8000 0 0x4000>,
+		      <4 0x02800000 0 0x800000>;
+		/* Native 26.6 D003 replies use PMGR 0x504820000. */
+		apple,bw-scratch = <&pmgr_dcp 0 4 0x20000>;
+		clocks = <&clk_disp0>;
+		phandle = <&dcp>;
+		status = "disabled";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		disp0_piodma: piodma {
+			iommus = <&disp0_dart 16>;
+			phandle = <&disp0_piodma>;
+		};
+		panel {
+			compatible = "apple,panel-mini-led";
+			apple,max-brightness = <500>;
+		};
+	};
+	display: display-subsystem {
+		compatible = "apple,display-subsystem";
+		iommus = <&disp0_dart 0>;
+		dma-noncoherent;
+		phandle = <&display>;
+	};
+};
