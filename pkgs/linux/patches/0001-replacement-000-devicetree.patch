+	ps_nub_sram: power-controller@a8 {
+		compatible = "apple,t8140-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0xa8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "nub_sram";
+		apple,always-on;
+	};
+
+	ps_debug_switch: power-controller@b0 {
+		compatible = "apple,t8140-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0xb0 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "debug_switch";
+		apple,always-on;
+	};
+
+	ps_smc_i2cm0: power-controller@8028 {
+		compatible = "apple,t8140-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x8028 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "smc_i2cm0";
+		apple,always-on;
+	};
+
+	ps_smc_i2cm1: power-controller@8030 {
+		compatible = "apple,t8140-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x8030 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "smc_i2cm1";
+		apple,always-on;
+	};
+
+	ps_smc_i2cm2: power-controller@8038 {
+		compatible = "apple,t8140-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x8038 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "smc_i2cm2";
+		apple,always-on;
+	};
+};
+
diff --git a/arch/arm64/boot/dts/apple/t8140-pmp.dtsi b/arch/arm64/boot/dts/apple/t8140-pmp.dtsi
new file mode 100644
index 0000000000000..3d16098def8f3
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8140-pmp.dtsi
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Neo resources/report IDs from live J700 ADT.
+ * Report bits are soc-device TABLE INDICES, not PMGR id1 - 1.
+ * ISP: firmware ID7 at index11; DISP ID8 at12; DISPEXT ID9 at13.
+ * Use the existing Asahi PMP-v2 protocol driver. No native startup replay.
+ */
+/ {
+	aliases {
+		pmp = &pmp;
+	};
+};
+
+&soc {
+	pmp_dart: iommu@300300000 {
+		compatible = "apple,t8140-dart", "apple,t8110-dart";
+		reg = <0x3 0x00300000 0 0xc000>;
+		#iommu-cells = <1>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 827 IRQ_TYPE_LEVEL_HIGH>;
+		/* Native PMP CPU MMIO streams; retain the DAPF filters. */
+		apple,bypass-sids = <12 14>;
+		power-domains = <&ps_pmp>;
+	};
+
+	pmp_mbox: mailbox@300e08000 {
+		compatible = "apple,t8140-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x3 0x00e08000 0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 823 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 824 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 825 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 826 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+		power-domains = <&ps_pmp>, <&ps_pms_sram>;
+	};
+
+	pmp: pmp@300500000 {
+		compatible = "apple,t8140-pmp-v2", "apple,t6000-pmp-v2";
+		reg = <0x3 0x00500000 0 0xa0000>,
+		      <0x3 0x00e00000 0 0x4000>;
+		reg-names = "pmp", "asc";
+		mboxes = <&pmp_mbox>;
+		mbox-names = "mbox";
+		iommus = <&pmp_dart 0>;
+		power-domains = <&ps_pmp>;
+		/* kboot transfers board/DRAM IDs and native ADT tunables. */
+		status = "disabled";
+	};
+
+	pmp_report: pmp-report@3003c0000 {
+		compatible = "apple,t8140-pmp-v2-report";
+		reg = <0x3 0x003c0000 0 0x30000>;
+		/* Per-record flags distinguish notifications from acknowledged reports. */
+		apple,pmp = <&pmp>;
+		power-domains = <&ps_pms_sram>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		pmp_report_isp: report@b {
+			compatible = "apple,t6000-pmp-v2-report-entry";
+			reg = <11>;
+			label = "pmp-isp";
+			#power-domain-cells = <0>;
+			power-domains = <&ps_isp_sys>;
+		};
+
+		pmp_report_disp: report@c {
+			compatible = "apple,t6000-pmp-v2-report-entry";
+			reg = <12>;
+			label = "pmp-disp";
+			#power-domain-cells = <0>;
+			power-domains = <&ps_disp_cpu>;
+			apple,always-on;
+		};
+
+		pmp_report_dispext: report@d {
+			compatible = "apple,t6000-pmp-v2-report-entry";
+			reg = <13>;
+			label = "pmp-dispext";
+			#power-domain-cells = <0>;
+			power-domains = <&ps_dispext0_cpu>;
+		};
+	};
+};
+
+/* PMP requires the PMC register bank independently of display activity. */
+&ps_pmp {
+	power-domains = <&ps_pmc>;
+};
+
+/* Preserve every ISP power domain while routing its system request via PMP. */
+&isp {
+	power-domains = <&pmp_report_isp>, <&ps_isp_cpu>,
+		<&ps_isp_cpu_core0>, <&ps_isp_cpu_core1>, <&ps_isp_fe>,
+		<&ps_isp_dprx>, <&ps_isp_secure>, <&ps_isp_sts0>, <&ps_isp_sts1>,
+		<&ps_isp_pearl>, <&ps_isp_be>, <&ps_isp_clr>,
+		<&ps_isp_cvd>, <&ps_isp_cvm>;
+};
+
+&dcp {
+	power-domains = <&pmp_report_disp>;
+};
+
+&dcpext0 {
+	power-domains = <&pmp_report_dispext>;
+};
diff --git a/arch/arm64/boot/dts/apple/t8140.dtsi b/arch/arm64/boot/dts/apple/t8140.dtsi
new file mode 100644
index 0000000000000..cb4d4540299bd
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8140.dtsi
@@ -0,0 +1,845 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple T8140 "A18 Pro" SoC
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/apple-aic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/pinctrl/apple.h>
+#include <dt-bindings/spmi/spmi.h>
+#include "t8140-neo-gpu-memory.dtsi"
+
+/ {
+	compatible = "apple,t8140", "apple,arm-platform";
+
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+
+
+	aliases {
+		gpu = &gpu;
+	};
+
+	reserved-memory {
+		/* m1n1 supplies the ADT ranges before the kernel can use them. */
+		uat_ttbs: uat-ttbs { status = "disabled"; no-map; };
+		uat_pagetables: uat-pagetables { status = "disabled"; no-map; };
+		uat_l2: uat-l2 { status = "disabled"; no-map; };
+		uat_handoff: uat-handoff { status = "disabled"; no-map; };
+		gpu_firmware: gpu-firmware { status = "disabled"; no-map; };
+		gpu_firmware_secondary: gpu-firmware-secondary { status = "disabled"; no-map; };
+	};
+
+	cpus {
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		cpu-map {
+			cluster0 {
+				core0 {
+					cpu = <&cpu_e0>;
+				};
+				core1 {
+					cpu = <&cpu_e1>;
+				};
+				core2 {
+					cpu = <&cpu_e2>;
+				};
+				core3 {
+					cpu = <&cpu_e3>;
+				};
+			};
+
+			cluster1 {
+				core0 {
+					cpu = <&cpu_p0>;
+				};
+				core1 {
+					cpu = <&cpu_p1>;
+				};
+			};
+		};
+
+		cpu_e0: cpu@0 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x0>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_0>;
+		};
+
+		cpu_e1: cpu@1 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x1>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_0>;
+		};
+
+
+		cpu_e2: cpu@2 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x2>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_0>;
+		};
+
+		cpu_e3: cpu@3 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x3>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_0>;
+		};
+
+		cpu_p0: cpu@10100 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10100>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_1>;
+		};
+
+		cpu_p1: cpu@10101 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10101>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_1>;
+		};
+
+		l2_cache_0: l2-cache-0 {
+			compatible = "cache";
+			cache-level = <2>;
+			cache-unified;
+			cache-size = <0x400000>;
+		};
+		l2_cache_1: l2-cache-1 {
+			compatible = "cache";
+			cache-level = <2>;
+			cache-unified;
+			cache-size = <0x1000000>;
+		};
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupt-parent = <&aic>;
+		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
+		interrupts = <AIC_FIQ AIC_TMR_GUEST_PHYS IRQ_TYPE_LEVEL_HIGH>,
+		             <AIC_FIQ AIC_TMR_GUEST_VIRT IRQ_TYPE_LEVEL_HIGH>,
+		             <AIC_FIQ AIC_TMR_HV_PHYS IRQ_TYPE_LEVEL_HIGH>,
+		             <AIC_FIQ AIC_TMR_HV_VIRT IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	clkref: clock-ref {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+		clock-output-names = "clkref";
+	};
+
+	soc: soc {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+
+		nonposted-mmio;
+		ranges;
+
+		gpu: gpu@480000000 {
+			compatible = "apple,agx-t8140", "apple,agx-g17p";
+			reg = <0x4 0x80000000 0 0x4000000>,
+			      <0x4 0x82600000 0 0x88000>,
+			      <0x4 0x82e00000 0 0x88000>,
+			      <0x4 0x80d00000 0 0x12c000>;
+			reg-names = "sgx", "asc", "asc-secondary", "sgx-aux";
+			power-domains = <&ps_gfx>;
+			mboxes = <&agx_mbox>, <&agx1_mbox>;
+			mbox-names = "primary", "secondary";
+			memory-region = <&uat_ttbs>, <&uat_pagetables>, <&uat_l2>,
+					<&uat_handoff>, <&gpu_firmware>, <&gpu_firmware_secondary>,
+					<NEO_GPU_SOURCE_REGIONS>;
+			memory-region-names = "ttbs", "pagetables", "l2", "handoff",
+					      "firmware", "firmware-secondary", NEO_GPU_SOURCE_NAMES;
+		};
+
+		agx_mbox: mailbox@482608000 {
+			compatible = "apple,t8140-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x4 0x82608000 0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 993 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 994 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 995 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 996 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+			                  "recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			power-domains = <&ps_gfx>;
+		};
+
+		agx1_mbox: mailbox@482e08000 {
+			compatible = "apple,t8140-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x4 0x82e08000 0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 997 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 998 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 999 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 1000 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+			                  "recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			power-domains = <&ps_gfx>;
+		};
+
+		serial0: serial@385200000 {
+			compatible = "apple,s5l-uart";
+			reg = <0x3 0x85200000 0x0 0x4000>;
+			reg-io-width = <4>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1092 IRQ_TYPE_LEVEL_HIGH>;
+			/*
+			 * TODO: figure out the clocking properly, there may
+			 * be a third selectable clock.
+			 */
+			clocks = <&clkref>, <&clkref>;
+			clock-names = "uart", "clk_uart_baud0";
+			power-domains = <&ps_uart0>;
+			status = "disabled";
+		};
+
+		aic: interrupt-controller@301000000 {
+			compatible = "apple,t8140-aic3", "apple,t8122-aic3";
+			#interrupt-cells = <3>;
+			interrupt-controller;
+			reg = <0x00000003 0x01000000 0x00000000 0x1cc000>,
+			      <0x00000003 0x01040000 0x00000000 0x4000>;
+			reg-names = "core", "event";
+			power-domains = <&ps_aic>;
+
+			affinities {
+				e-core-pmu-affinity {
+					apple,fiq-index = <AIC_CPU_PMU_E>;
+					cpus = <&cpu_e0 &cpu_e1 &cpu_e2 &cpu_e3>;
+				};
+
+				p-core-pmu-affinity {
+					apple,fiq-index = <AIC_CPU_PMU_P>;
+					cpus = <&cpu_p0 &cpu_p1>;
+				};
+			};
+		};
+
+		pmgr: power-management@300700000 {
+			compatible = "apple,t8140-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/* child nodes are added in t8140-pmgr.dtsi */
+			reg = <0x3 0x700000 0 0x14000>;
+		};
+
+		pmgr_mini: power-management@308280000 {
+			compatible = "apple,t8140-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/* child nodes are added in t8140-pmgr.dtsi */
+			reg = <0x3 0x8280000 0 0xc000>;
+		};
+
+
+		mtp: mtp@314600000 {
+			compatible = "apple,t8140-mtp", "apple,t8140-rtk-helper-asc4", "apple,mtp", "apple,rtk-helper-asc4";
+			reg = <0x3 0x14600000 0x0 0x4000>,
+			      <0x3 0x14c00000 0x0 0x100000>;
+			reg-names = "asc", "sram";
+			mboxes = <&mtp_mbox>;
+			iommus = <&mtp_dart 0>;
+			#helper-cells = <0>;
+
+			status = "disabled";
+		};
+
+		mtp_mbox: mbox@314608000 {
+			compatible = "apple,t8140-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x3 0x14608000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1152 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 1153 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 1154 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 1155 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+			                  "recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+
+			status = "disabled";
+		};
+
+		mtp_dart: iommu@314800000 {
+			compatible = "apple,t8140-dart", "apple,t8110-dart";
+			reg = <0x3 0x14800000 0x0 0xc000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1135 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			apple,sid-remap = <1 0>, <2 0>, <3 0>;
+
+			status = "disabled";
+		};
+
+		mtp_dockchannel: fifo@314b14000 {
+			compatible = "apple,t8140-dockchannel", "apple,dockchannel";
+			reg = <0x3 0x14b14000 0x0 0x1000>;
+			reg-names = "irq";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1137 IRQ_TYPE_LEVEL_HIGH>;
+
+			ranges = <0 0x3 0x14b28000 0x10000>;
+			nonposted-mmio;
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			status = "disabled";
+
+			mtp_hid: input@8000 {
+				compatible = "apple,t8140-dockchannel-hid", "apple,dockchannel-hid";
+				reg = <0x8000 0x1000>,
+					<0xc000 0x1000>,
+					<0x0000 0x1000>,
+					<0x4000 0x1000>;
+				reg-names = "config", "data",
+					"rmt-config", "rmt-data";
+				iommus = <&mtp_dart 0>;
+				interrupt-parent = <&mtp_dockchannel>;
+				interrupts = <2 IRQ_TYPE_LEVEL_HIGH>,
+					<3 IRQ_TYPE_LEVEL_HIGH>;
+				interrupt-names = "tx", "rx";
+
+				apple,fifo-size = <0x800>;
+				apple,helper-cpu = <&mtp>;
+			};
+		};
+
+		pinctrl_ap: pinctrl@31a000000 {
+			compatible = "apple,t8140-pinctrl", "apple,t8103-pinctrl";
+			reg = <0x3 0x1a000000 0x0 0x100000>;
+			power-domains = <&ps_gpio>;
+
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl_ap 0 0 216>;
+			gpio-reserved-ranges = <49 3 134 1>;
+			apple,npins = <216>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 263 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 264 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 265 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 266 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 267 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 268 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 269 IRQ_TYPE_LEVEL_HIGH>;
+
+			pcie_pins: pcie-pins {
+				// clkreq pins
+				pinmux = <APPLE_PINMUX(101, 1)>,
+				         <APPLE_PINMUX(102, 1)>;
+			};
+
+			i2c0_pins: i2c0-pins {
+				pinmux = <APPLE_PINMUX(171, 1)>,
+					 <APPLE_PINMUX(170, 1)>;
+			};
+
+			i2c2_pins: i2c2-pins {
+				pinmux = <APPLE_PINMUX(165, 1)>,
+					 <APPLE_PINMUX(164, 1)>;
+			};
+		};
+
+		pinctrl_nub: pinctrl@3081f0000 {
+			compatible = "apple,t8140-pinctrl", "apple,t8103-pinctrl";
+			reg = <0x3 0x081f0000 0x0 0x4000>;
+			power-domains = <&ps_nub_gpio>;
+
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl_nub 0 0 30>;
+			apple,npins = <30>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 473 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 474 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 475 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 476 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 477 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 478 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 479 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		pinctrl_smc: pinctrl@30c820000 {
+			compatible = "apple,t8140-pinctrl", "apple,t8103-pinctrl";
+			reg = <0x3 0x0c820000 0x0 0x4000>;
+
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl_smc 0 0 30>;
+			apple,npins = <30>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
