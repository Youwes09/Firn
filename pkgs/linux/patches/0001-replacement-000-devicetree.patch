+				interrupt-map-mask = <0 0 0 7>;
+				interrupt-map = <0 0 0 1 &port01 0 0 0 0>,
+						<0 0 0 2 &port01 0 0 0 1>,
+						<0 0 0 3 &port01 0 0 0 2>,
+						<0 0 0 4 &port01 0 0 0 3>;
+				status = "disabled";
+			};
+
+			port02: pci@2,0 {
+				compatible = "pciclass,0604";
+				device_type = "pci";
+				reg = <0x1000 0x0 0x0 0x0 0x0>;
+				reset-gpios = <&pinctrl_ap 165 GPIO_ACTIVE_LOW>; // perst
+
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+
+				interrupt-controller;
+				#interrupt-cells = <1>;
+
+				interrupt-map-mask = <0 0 0 7>;
+				interrupt-map = <0 0 0 1 &port02 0 0 0 0>,
+						<0 0 0 2 &port02 0 0 0 1>,
+						<0 0 0 3 &port02 0 0 0 2>,
+						<0 0 0 4 &port02 0 0 0 3>;
+				status = "disabled";
+			};
+		};
+
+		ans_mbox: mbox@481608000 {
+			compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x4 0x81608000 0x0 0x4000>;
+
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1003 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 1004 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 1005 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 1006 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+			                  "recv-empty", "recv-not-empty";
+
+			#mbox-cells = <0>;
+			power-domains = <&ps_ans>;
+		};
+
+		sart: sart@485c50000 {
+			compatible = "apple,t8132-sart", "apple,t6000-sart";
+			reg = <0x4 0x85c50000 0x0 0x10000>;
+			power-domains = <&ps_ans>;
+		};
+
+		nvme: nvme@4c5cc0000 {
+			compatible = "apple,t8132-nvme-ans2";
+			reg = <0x4 0xc5cc0000 0x0 0x60000>,
+			      <0x4 0x81600000 0x0 0x4000>;
+			reg-names = "nvme", "ans";
+
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1018 IRQ_TYPE_LEVEL_HIGH>;
+
+			mboxes = <&ans_mbox>;
+
+			power-domains = <&ps_ans>, <&ps_apcie_sys_st>;
+			power-domain-names = "ans", "apcie0";
+			resets = <&ps_ans>;
+
+			apple,sart = <&sart>;
+		};
 	};
 };
 
diff --git a/arch/arm64/boot/dts/apple/t8140-dcp-reference.dtsi b/arch/arm64/boot/dts/apple/t8140-dcp-reference.dtsi
new file mode 100644
index 0000000000000..2ad357d1791ea
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8140-dcp-reference.dtsi
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MacBook Neo display register windows and stream IDs from the J700 ADT. */
+/ {
+	aliases {
+		dcp = &dcp;
+		disp0 = &display;
+		disp0_piodma = &disp0_piodma;
+	};
+
+	reserved-memory {
+		neo_scanout: scanout-pool {
+			compatible = "shared-dma-pool";
+			phandle = <&neo_scanout>;
+			no-map;
+			/* The loader selects the available display carveout. */
+			status = "disabled";
+		};
+	};
+};
+
+&soc {
+	/* Allow the DARTs' firmware address windows above 32 bits. */
+	dma-ranges = <0 0 0 0 0xffffffff 0xffffc000>;
+	disp0_dart: iommu@412300000 {
+		compatible = "apple,t8140-dart", "apple,t8110-dart";
+		reg = <0x4 0x12300000 0 0xc000>;
+		#iommu-cells = <1>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 698 IRQ_TYPE_LEVEL_HIGH>;
+		apple,dma-range = <0x100 0 0x10 0>;
+		status = "disabled";
+	};
+
+	dcp_dart: iommu@412340000 {
+		compatible = "apple,t8140-dart", "apple,t8110-dart";
+		reg = <0x4 0x12340000 0 0xc000>;
+		#iommu-cells = <1>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 698 IRQ_TYPE_LEVEL_HIGH>;
+		apple,dma-range = <0x100 0 0x10 0>;
+		status = "disabled";
+	};
+
+	dcp_mbox: mailbox@412e08000 {
+		compatible = "apple,t8140-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x4 0x12e08000 0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 679 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 680 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 681 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 682 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+		status = "disabled";
+	};
+
+	pmgr_dcp: power-management@302800000 {
+		reg = <0x3 0x02800000 0 0xbc000>;
+		#apple,bw-scratch-cells = <3>;
+	};
+
+	pmgr_dcp_doorbell: power-management@302868000 {
+		reg = <0x3 0x02868000 0 4>;
+		#apple,bw-doorbell-cells = <2>;
+	};
+
+	dcp: dcp@412e00000 {
+		compatible = "apple,t8140-dcp", "apple,dcp";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		mboxes = <&dcp_mbox>;
+		mbox-names = "mbox";
+		power-domains = <&ps_disp_cpu>;
+		iommus = <&dcp_dart 23>;
+		reg-names = "coproc", "disp-0", "disp-1", "disp-2", "disp-3", "disp-4";
+		reg = <0x4 0x12e00000 0 0x4000>,
+		      <0x4 0x10000000 0 0xafc000>,
+		      <0x4 0x12240000 0 0x10000>,
+		      <0x4 0x123a8000 0 0x4000>,
+		      <0x4 0x123ac000 0 0x4000>,
+		      <0x4 0x12800000 0 0x800000>;
+		apple,bw-scratch = <&pmgr_dcp 0 5 0x20000>;
+		apple,bw-doorbell = <&pmgr_dcp_doorbell 0 6>;
+		apple,iomfb-surfaces = <1 0 0 0>;
+		clocks = <&clkref>;
+		phandle = <&dcp>;
+		status = "disabled";
+
+		disp0_piodma: piodma {
+			iommus = <&disp0_dart 16>;
+			phandle = <&disp0_piodma>;
+		};
+
+		panel {
+			compatible = "apple,panel";
+			/* ADT dot-pitch is 219 dpi; native pixels are 2408x1506. */
+			width-mm = <279>;
+			height-mm = <175>;
+			/* Upper brightness observed in the complete native sweep. */
+			apple,max-brightness = <420>;
+		};
+	};
+
+	display: display-subsystem {
+		compatible = "apple,display-subsystem";
+		iommus = <&disp0_dart 0>;
+		dma-noncoherent;
+		apple,scanout-memory-is-nomap;
+		phandle = <&display>;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t8140-dcpext.dtsi b/arch/arm64/boot/dts/apple/t8140-dcpext.dtsi
new file mode 100644
index 0000000000000..850af65d82e3b
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8140-dcpext.dtsi
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Neo external pipeline: physical resources from the J700 ADT. No sink modes. */
+/ {
+	aliases {
+		dcpext = &dcpext0;
+		dispext0_piodma = &dispext0_piodma;
+	};
+};
+
+&soc {
+	dispext0_dart: iommu@416300000 {
+		compatible = "apple,t8140-dart", "apple,t8110-dart";
+		reg = <0x4 0x16300000 0 0xc000>;
+		#iommu-cells = <1>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 770 IRQ_TYPE_LEVEL_HIGH>;
+		apple,dma-range = <0x100 0 0x10 0>;
+	};
+
+	dcpext0_dart: iommu@416340000 {
+		compatible = "apple,t8140-dart", "apple,t8110-dart";
+		reg = <0x4 0x16340000 0 0xc000>;
+		#iommu-cells = <1>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 770 IRQ_TYPE_LEVEL_HIGH>;
+		apple,dma-range = <0x100 0 0x10 0>;
+	};
+
+	dcpext0_mbox: mailbox@416e08000 {
+		compatible = "apple,t8140-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x4 0x16e08000 0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 751 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 752 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 753 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 754 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+
+	pmgr_dcpext_doorbell: power-management@302870000 {
+		reg = <0x3 0x02870000 0 4>;
+		#apple,bw-doorbell-cells = <2>;
+	};
+
+	atc0_dpxbar: mux@40b04c000 {
+		compatible = "apple,t8140-display-crossbar", "apple,t6020-display-crossbar";
+		reg = <0x4 0x0b04c000 0 0x4000>;
+		#mux-control-cells = <1>;
+		power-domains = <&ps_atc0_common>;
+	};
+
+	dcpext0: dcp@416e00000 {
+		compatible = "apple,t8140-dcpext", "apple,dcpext";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		mboxes = <&dcpext0_mbox>;
+		mbox-names = "mbox";
+		power-domains = <&ps_dispext0_cpu>;
+		iommus = <&dcpext0_dart 23>;
+		reg-names = "coproc", "disp-0", "disp-1", "disp-2", "disp-3";
+		reg = <0x4 0x16e00000 0 0x4000>,
+		      <0x4 0x14000000 0 0xafc000>,
+		      <0x4 0x16240000 0 0x10000>,
+		      <0x4 0x163ac000 0 0x4000>,
+		      <0x4 0x16800000 0 0x800000>;
+		apple,bw-scratch = <&pmgr_dcp 0 4 0x28000>;
+		apple,bw-doorbell = <&pmgr_dcpext_doorbell 0 5>;
+		apple,iomfb-surfaces = <1 0 0 0>;
+		apple,dcp-index = <1>;
+		apple,connector-type = "DP";
+		apple,dptx-phy = <0>;
+		apple,typec-connector = <&typec0>;
+		clocks = <&clkref>;
+		phys = <&atcphy0 PHY_TYPE_DP>;
+		phy-names = "dp-phy";
+		mux-controls = <&atc0_dpxbar 0>;
+		mux-control-names = "dp-xbar";
+		/* SoC topology: dispext input 1, stream 0. Not a monitor setting. */
+		mux-index = <2>;
+		phandle = <&dcpext0>;
+		status = "disabled";
+
+		dispext0_piodma: piodma {
+			iommus = <&dispext0_dart 16>;
+			phandle = <&dispext0_piodma>;
+		};
+	};
+};
+
+/* Both display engines consume the DRM master's common scanout address space. */
+&display {
+	iommus = <&disp0_dart 0>, <&dispext0_dart 0>;
+};
diff --git a/arch/arm64/boot/dts/apple/t8140-isp.dtsi b/arch/arm64/boot/dts/apple/t8140-isp.dtsi
new file mode 100644
index 0000000000000..74ef19fd4b1e6
--- /dev/null
