diff --git a/arch/arm64/boot/dts/apple/t6041-aop.dtsi b/arch/arm64/boot/dts/apple/t6041-aop.dtsi
new file mode 100644
index 0000000000000..0a71c9ad5cc18
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6041-aop.dtsi
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/* J616c AOP and LEAP microphone DMA. CPU addresses and stream topology
+ * verified through native macOS audio capture; m1n1 retains the firmware.
+ */
+/ {
+	aliases { aop = &aop; };
+};
+
+&{/soc} {
+	aop_mbox: mailbox@510608000 {
+		compatible = "apple,t6041-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <5 0x10608000 0 0x4000>;
+		interrupt-parent = <&aic>;
+		/* ADT lists not-empty before empty within each mailbox pair. */
+		interrupts = <AIC_IRQ 710 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 711 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 712 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 713 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+			"recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+
+	aop_dart: iommu@510f00000 {
+		compatible = "apple,t6041-dart", "apple,t8110-dart";
+		reg = <5 0x10f00000 0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 734 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		/* EC0p=1 TiB in the existing T6020 AOP boot profile. */
+		apple,dma-range = <0x100 0x00014000 0x2ff 0xfffec000>;
+	};
+
+	aop_admac: dma-controller@513300000 {
+		compatible = "apple,t6041-admac", "apple,t8132-admac";
+		reg = <5 0x13300000 0 0x34000>;
+		#dma-cells = <1>;
+		dma-channels = <18>;
+		interrupts-extended = <&aic AIC_IRQ 757 IRQ_TYPE_LEVEL_HIGH>,
+				      <0>, <0>, <0>;
+		iommus = <&aop_dart 10>;
+	};
+
+	speaker_admac: dma-controller@513800000 {
+		compatible = "apple,t6041-admac", "apple,t8132-admac";
+		reg = <5 0x13800000 0 0x34000>;
+		#dma-cells = <1>;
+		dma-channels = <26>;
+		interrupts-extended = <&aic AIC_IRQ 754 IRQ_TYPE_LEVEL_HIGH>,
+				      <0>, <0>, <0>;
+		iommus = <&aop_dart 8>;
+	};
+
+	aop: aop@510c10000 {
+		compatible = "apple,t6041-aop", "apple,t6020-aop";
+		reg = <5 0x10c10000 0 0x2e0000>,
+		      <5 0x10600000 0 0x4000>;
+		mboxes = <&aop_mbox>;
+		mbox-names = "mbox";
+		iommus = <&aop_dart 0>;
+
+		aop_audio: audio {
+			compatible = "apple,t6041-aop-audio", "apple,t6030-aop-audio";
+			dmas = <&aop_admac 1>, <&speaker_admac 0>;
+			dma-names = "dma", "speaker-tx";
+			apple,protected-speakers;
+			speaker-enable-gpios = <&pinctrl_ap 54 GPIO_ACTIVE_HIGH>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6041-audio.dtsi b/arch/arm64/boot/dts/apple/t6041-audio.dtsi
new file mode 100644
index 0000000000000..8de7e057195ff
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6041-audio.dtsi
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/* J616 six SN012776 amplifiers, resources and slots from the verified ADT. */
+/ {
+	speaker_sdz_supply: regulator-speaker-sdz {
+		compatible = "regulator-fixed";
+		regulator-name = "Speaker SDZ reference";
+		/* Common SDZ is owned by the protected machine driver. */
+	};
+};
+&pmgr0 {
+	ps_fab3_soc: power-controller@118 {
+		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x118 4>; #power-domain-cells = <0>; #reset-cells = <0>;
+		label = "fab3_soc"; power-domains = <&ps_afc>;
+	};
+	ps_sio: power-controller@120 {
+		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x120 4>; #power-domain-cells = <0>; #reset-cells = <0>;
+		label = "sio"; power-domains = <&ps_fab3_soc>;
+	};
+	ps_i2c1: power-controller@158 {
+		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x158 4>; #power-domain-cells = <0>; #reset-cells = <0>;
+		label = "i2c1"; power-domains = <&ps_sio>;
+	};
+	ps_i2c3: power-controller@168 {
+		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x168 4>; #power-domain-cells = <0>; #reset-cells = <0>;
+		label = "i2c3"; power-domains = <&ps_sio>;
+	};
+};
+&pmgr1 {
+	ps_afc: power-controller@178 {
+		compatible = "apple,t6041-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x178 4>; #power-domain-cells = <0>; #reset-cells = <0>;
+		label = "afc";
+	};
+};
+&pinctrl_ap {
+	i2c1_pins: i2c1-pins { pinmux = <APPLE_PINMUX(58, 1)>, <APPLE_PINMUX(59, 1)>; };
+	i2c3_pins: i2c3-pins { pinmux = <APPLE_PINMUX(62, 1)>, <APPLE_PINMUX(63, 1)>; };
+};
+&{/soc} {
+	i2c1: i2c@429014000 {
+		compatible = "apple,t6041-i2c", "apple,t8103-i2c";
+		reg = <4 0x29014000 0 0x4000>;
+		interrupt-parent = <&aic>; interrupts = <AIC_IRQ 1576 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clkref>; clock-frequency = <100000>;
+		power-domains = <&ps_i2c1>; resets = <&ps_i2c1>;
+		pinctrl-0 = <&i2c1_pins>; pinctrl-names = "default";
+		#address-cells = <1>; #size-cells = <0>;
+		amp_left_woofer1: amplifier@38 {
+			compatible = "ti,sn012776", "ti,tas2764";
+			reg = <0x38>; #sound-dai-cells = <0>;
+			sound-name-prefix = "Left Woofer 1";
+			SDZ-supply = <&speaker_sdz_supply>;
+			ti,vmon-slot-no = <0>; ti,imon-slot-no = <2>;
+		};
+		amp_left_woofer2: amplifier@39 {
+			compatible = "ti,sn012776", "ti,tas2764";
+			reg = <0x39>; #sound-dai-cells = <0>;
+			sound-name-prefix = "Left Woofer 2";
+			SDZ-supply = <&speaker_sdz_supply>;
+			ti,vmon-slot-no = <8>; ti,imon-slot-no = <10>;
+		};
+		amp_left_tweeter: amplifier@3a {
+			compatible = "ti,sn012776", "ti,tas2764";
+			reg = <0x3a>; #sound-dai-cells = <0>;
+			sound-name-prefix = "Left Tweeter";
+			SDZ-supply = <&speaker_sdz_supply>;
+			ti,vmon-slot-no = <16>; ti,imon-slot-no = <18>;
+		};
+	};
+	i2c3: i2c@42901c000 {
+		compatible = "apple,t6041-i2c", "apple,t8103-i2c";
+		reg = <4 0x2901c000 0 0x4000>;
+		interrupt-parent = <&aic>; interrupts = <AIC_IRQ 1578 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clkref>; clock-frequency = <100000>;
+		power-domains = <&ps_i2c3>; resets = <&ps_i2c3>;
+		pinctrl-0 = <&i2c3_pins>; pinctrl-names = "default";
+		#address-cells = <1>; #size-cells = <0>;
+		amp_right_woofer1: amplifier@3b {
+			compatible = "ti,sn012776", "ti,tas2764";
+			reg = <0x3b>; #sound-dai-cells = <0>;
+			sound-name-prefix = "Right Woofer 1";
+			SDZ-supply = <&speaker_sdz_supply>;
+			ti,vmon-slot-no = <4>; ti,imon-slot-no = <6>;
+		};
+		amp_right_woofer2: amplifier@3c {
+			compatible = "ti,sn012776", "ti,tas2764";
+			reg = <0x3c>; #sound-dai-cells = <0>;
+			sound-name-prefix = "Right Woofer 2";
+			SDZ-supply = <&speaker_sdz_supply>;
+			ti,vmon-slot-no = <12>; ti,imon-slot-no = <14>;
+		};
+		amp_right_tweeter: amplifier@3d {
+			compatible = "ti,sn012776", "ti,tas2764";
+			reg = <0x3d>; #sound-dai-cells = <0>;
+			sound-name-prefix = "Right Tweeter";
+			SDZ-supply = <&speaker_sdz_supply>;
+			ti,vmon-slot-no = <20>; ti,imon-slot-no = <22>;
+		};
+	};
+};
+&aop_audio {
+	apple,speaker-codecs = <&amp_left_woofer1>, <&amp_right_woofer1>,
+		<&amp_left_woofer2>, <&amp_right_woofer2>, <&amp_left_tweeter>, <&amp_right_tweeter>;
