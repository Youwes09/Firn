+            apple,sram-microvolt = <0 0 0 0>;
+            apple,perf-index = <0 0>;
+            apple,relative-power = <0 0>;
+        };
+        opp10 {
+            opp-hz = /bits/ 64 <0>;
+            apple,alternate-opp-hz = /bits/ 64 <0>;
+            opp-microvolt = <0 0 0 0>;
+            apple,sram-microvolt = <0 0 0 0>;
+            apple,perf-index = <0 0>;
