+/* Same two manufacturer privacy records qualified in m1n1 044d00d8.
+ * Index39 is inclusive (40 bitmap bytes); extension58 occupies the LAST byte.
+ * These are IE permissions, not RF-power or timing calibration settings.
+ * Repeat before MLME/scan activation after every firmware initialization.
+ */
+static int mt7932_probe_privacy(struct mt76_dev *mdev)
+{
+	static const u8 ordinary[] = {
+		WLAN_EID_SSID, WLAN_EID_SUPP_RATES, WLAN_EID_DS_PARAMS,
+		WLAN_EID_HT_CAPABILITY, WLAN_EID_EXT_SUPP_RATES,
+		WLAN_EID_BSS_COEX_2040, WLAN_EID_INTERWORKING,
+		WLAN_EID_ADVERTISEMENT_PROTOCOL, WLAN_EID_EXT_CAPABILITY,
+		WLAN_EID_VHT_CAPABILITY, WLAN_EID_VENDOR_SPECIFIC, WLAN_EID_EXTENSION,
+	};
+	static const u8 extended[] = {
+		WLAN_EID_EXT_HE_CAPABILITY, WLAN_EID_EXT_SHORT_SSID_LIST,
+	};
+	struct mt7932_probe_privacy bitmap = {
+		.last_bitmap_byte = sizeof(bitmap.bitmap) - 1,
+	};
+	struct mt7932_probe_privacy policy = {
+		.subcommand = 1,
+		.unknown_policy0 = 20,
+		.unknown_policy1 = 20,
+	};
+	struct sk_buff *reply;
+	int ret, i;
+
+	for (i = 0; i < ARRAY_SIZE(ordinary); i++)
+		bitmap.bitmap[ordinary[i] / BITS_PER_BYTE] |=
+			BIT(ordinary[i] % BITS_PER_BYTE);
+	for (i = 0; i < ARRAY_SIZE(extended); i++)
+		bitmap.bitmap[MT7932_PRIVACY_ORDINARY_BYTES +
+			      extended[i] / BITS_PER_BYTE] |=
+			BIT(extended[i] % BITS_PER_BYTE);
+	ret = mt76_mcu_send_msg(mdev, MT7932_CMD_PROBE_PRIVACY,
+			       &bitmap, sizeof(bitmap), false);
+	if (ret)
+		return ret;
+	ret = mt76_mcu_send_msg(mdev, MT7932_CMD_PROBE_PRIVACY,
+			       &policy, sizeof(policy), false);
+	if (ret)
+		return ret;
+	/* Consume a synchronous capability reply before discovery starts. */
+	ret = mt76_mcu_send_and_get_msg(mdev, MCU_CE_CMD(GET_NIC_CAPAB),
+				      NULL, 0, true, &reply);
+	if (!ret) {
+		dev_kfree_skb(reply);
+		dev_info(mdev->dev, "MT7932 probe-request privacy initialized\n");
+	}
+	return ret;
+}
+
+static int mt7932_basic_config(struct mt76_dev *mdev)
+{
+	struct mt7932_basic_config basic = MT7932_BASIC_CONFIG_INITIALIZER(1);
+	u8 mlme[4];
+	/* Queue-management startup records observed on this 7932 firmware ABI. */
+	u8 qm[3][32] = {
+		{ 0x10, 0x11, 2, 0, 3, 0, 7, 0, 0x2f, 0, 2 },
+		{ 0xe0, 0x6e, 2, 0, 0x0f, 0, 0xff, 3, 0, 0, 3 },
+		{ 0x0f, 0, 1 },
+	};
+	int ret = mt76_mcu_send_msg(mdev, MT7932_CMD_BASIC_CONFIG,
+				     &basic, sizeof(basic), false);
+	int i;
+
+	if (ret)
+		return ret;
+	ret = mt7932_probe_privacy(mdev);
+	if (ret)
+		return ret;
+	/* Test host SME operation; the offload configuration bits are undocumented. */
+	put_unaligned_le32(mt7932_mlme_config, mlme);
+	ret = mt76_mcu_send_msg(mdev, MT7932_CMD_SME_CONFIG,
+			       mlme, sizeof(mlme), false);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(qm); i++) {
+		ret = mt76_mcu_send_msg(mdev, MT7932_CMD_QUEUE_MANAGEMENT,
+			       qm[i], sizeof(qm[i]), false);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+int mt7932_start(struct mt792x_phy *phy)
+{
+	struct mt76_dev *mdev = phy->mt76->dev;
+	u8 dbdc[36] = { [4] = 2, [6] = 36 };
+	u8 power[4] = {};
+	int ret;
+
+	ret = mt76_mcu_send_msg(mdev, MCU_CMD(NIC_POWER_CTRL),
+			       power, sizeof(power), false);
+	if (ret)
+		return ret;
+	ret = mt76_mcu_send_msg(mdev, MT7932_CMD_DBDC, dbdc, sizeof(dbdc), false);
+	if (ret)
+		return ret;
+	ret = mt76_connac_mcu_set_channel_domain(phy->mt76);
+	if (ret)
+		return ret;
+	set_bit(MT76_STATE_RUNNING, &phy->mt76->state);
+	return 0;
+}
+
+static int mt7932_fill_rlm(struct mt792x_phy *phy,
+			 const struct cfg80211_chan_def *ch, u8 bss_idx,
+			 struct mt7932_rlm *rlm)
+{
+	if (!ch->chan)
+		return -EINVAL;
+	rlm->bss_idx = bss_idx;
+	rlm->band = ch->chan->band == NL80211_BAND_2GHZ ? MT7932_BAND_2GHZ :
+		    ch->chan->band == NL80211_BAND_5GHZ ? MT7932_BAND_5GHZ :
+						       MT7932_BAND_6GHZ;
+	rlm->primary_channel = ch->chan->hw_value;
+	if (ch->width != NL80211_CHAN_WIDTH_20 &&
+	    ch->width != NL80211_CHAN_WIDTH_20_NOHT)
+		rlm->secondary_channel_offset =
+			ch->center_freq1 > ch->chan->center_freq ?
+			IEEE80211_HT_PARAM_CHA_SEC_ABOVE :
+			IEEE80211_HT_PARAM_CHA_SEC_BELOW;
+	rlm->short_slot_time = 1;
+	switch (ch->width) {
+	case NL80211_CHAN_WIDTH_80:
+		rlm->vht_width = IEEE80211_VHT_CHANWIDTH_80MHZ;
+		break;
+	case NL80211_CHAN_WIDTH_160:
+		rlm->vht_width = IEEE80211_VHT_CHANWIDTH_160MHZ;
+		break;
+	case NL80211_CHAN_WIDTH_80P80:
+		rlm->vht_width = IEEE80211_VHT_CHANWIDTH_80P80MHZ;
+		break;
+	default:
+		rlm->vht_width = IEEE80211_VHT_CHANWIDTH_USE_HT;
+		break;
+	}
+	if (rlm->vht_width)
+		rlm->center_channel1 = ieee80211_frequency_to_channel(ch->center_freq1);
+	if (ch->center_freq2)
+		rlm->center_channel2 = ieee80211_frequency_to_channel(ch->center_freq2);
+	rlm->tx_nss = rlm->rx_nss = hweight8(phy->mt76->antenna_mask);
+	return 0;
+}
+
+int mt7932_set_channel(struct mt792x_phy *phy, u8 bss_idx)
+{
+	struct mt7932_rlm rlm = {};
+	int ret = mt7932_fill_rlm(phy, &phy->mt76->chandef, bss_idx, &rlm);
+
+	if (ret)
+		return ret;
+	return mt76_mcu_send_msg(phy->mt76->dev, MT7932_CMD_SET_RLM,
+			       &rlm, sizeof(rlm), false);
+}
+
+int mt7932_add_interface(struct mt792x_dev *dev, struct ieee80211_vif *vif,
+			struct mt792x_vif *mvif, bool enable)
+{
+	struct mt7932_activate_bss activate = {};
+	struct mt7932_ais_mac mac = {};
+	int ret;
+
+	if (vif->type != NL80211_IFTYPE_STATION ||
+	    mvif->bss_conf.mt76.idx > MT7932_DISCOVERY_BSS)
+		return -EOPNOTSUPP;
+	/* AIS binds its address directly; host-owned roles use MUAR. */
+	if (enable && mvif->bss_conf.mt76.idx == MT7932_AIS_BSS) {
+		mac.bss_idx = mvif->bss_conf.mt76.idx;
+		ether_addr_copy(mac.mac, vif->addr);
+		ret = mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_AIS_MAC,
+				       &mac, sizeof(mac), false);
+		if (ret)
+			return ret;
+	}
+	activate.bss_idx = mvif->bss_conf.mt76.idx;
+	activate.active = enable;
+	/* The P2P client role delegates management frames to the host SME. */
+	activate.network_type = mvif->bss_conf.mt76.idx ? 1 : 0;
+	activate.omac_idx = mvif->bss_conf.mt76.omac_idx;
+	ether_addr_copy(activate.mac, vif->addr);
+	/* Scan-only contexts have no group key or allocated firmware BMC row. */
+	activate.bmc_wcid = MT7932_NO_WCID;
+	activate.unknown_11 = 1;
+	return mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_ACTIVATE_BSS,
+			       &activate, sizeof(activate), false);
+}
+
+int mt7932_bss_update(struct mt792x_dev *dev, struct ieee80211_vif *vif)
+{
+	struct mt792x_vif *mvif = (void *)vif->drv_priv;
+	struct ieee80211_bss_conf *info = &vif->bss_conf;
+	const struct cfg80211_chan_def *ch;
+	u8 bss[116] = {};
+	int ret;
+
+	ch = mvif->bss_conf.mt76.ctx ? &mvif->bss_conf.mt76.ctx->def :
+		&dev->mphy.chandef;
+	if (!ch->chan)
+		return -EINVAL;
+	bss[0] = mvif->bss_conf.mt76.idx;
+	/* Legacy ENUM_PARAM_MEDIA_STATE: connected=0, disconnected=1. */
+	bss[1] = !vif->cfg.assoc;
+	bss[3] = vif->cfg.ssid_len;
+	memcpy(bss + 4, vif->cfg.ssid, bss[3]);
+	if (info->bssid)
+		memcpy(bss + 0x24, info->bssid, ETH_ALEN);
+	bss[0x2a] = info->qos;
+	bss[0x2b] = 1;
+	put_unaligned_le16(ch->chan->band == NL80211_BAND_2GHZ ? 0xfff : 0xff0,
+			   bss + 0x2c);
+	put_unaligned_le16(info->basic_rates <<
+			   (ch->chan->band == NL80211_BAND_2GHZ ? 0 : 4), bss + 0x2e);
+	bss[0x30] = mvif->wep_sta ? mvif->wep_sta->deflink.wcid.idx + 2 : 0xfe;
+	bss[0x34] = ch->chan->band == NL80211_BAND_2GHZ ? 1 : 2;
+	bss[0x37] = 0x7f;
+	bss[0x3a] = 7;
+	ret = mt7932_fill_rlm(&dev->phy, ch, bss[0], (void *)(bss + 0x44));
+	if (ret)
+		return ret;
+	bss[0x5b] = mvif->bss_conf.mt76.wmm_idx;
+	bss[0x5d] = hweight8(dev->mphy.antenna_mask);
+	memcpy(bss + 0x60, &info->he_oper.params, 3);
+	bss[0x63] = info->he_bss_color.color;
+	put_unaligned_le16(info->he_oper.nss_set, bss + 0x64);
+	dev_info(dev->mt76.dev, "MT7932 BSS bss=%u media_state=%u ap=%u bmc=%u band=%u channel=%u\n",
+		 bss[0], bss[1], bss[0x30], bss[0x3a], bss[0x45], bss[0x46]);
+	ret = mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_SET_RLM, bss + 0x44, 22, false);
+	if (ret)
+		return ret;
+	return mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_SET_BSS, bss, sizeof(bss), false);
+}
+
+int mt7932_sta_update(struct mt792x_dev *dev, struct ieee80211_sta *sta,
+		     struct ieee80211_vif *vif, bool enable,
+		     enum mt76_sta_info_state state)
+{
+	struct mt792x_vif *mvif = (void *)vif->drv_priv;
+	struct mt792x_sta *msta;
+	struct ieee80211_link_sta *link;
+	u8 body[200] = {};
+	int idx, band, shift;
+
+	if (!sta)
+		return mt7932_bss_update(dev, vif);
+	msta = (void *)sta->drv_priv;
+	link = &sta->deflink;
+	idx = msta->deflink.wcid.idx;
+	if (idx > 12)
+		return -ENOSPC;
+	if (!enable) {
+		u8 remove[5] = { 0, idx + 2, mvif->bss_conf.mt76.idx };
+
+		return mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_REMOVE_STA, remove, sizeof(remove), false);
+	}
+	band = mvif->bss_conf.mt76.ctx ? mvif->bss_conf.mt76.ctx->def.chan->band :
+		NL80211_BAND_2GHZ;
+	shift = band == NL80211_BAND_2GHZ ? 0 : 4;
+	body[0] = idx + 2;
+	body[1] = mvif->bss_conf.mt76.idx ? 0x42 : 0x41;
+	memcpy(body + 2, sta->addr, ETH_ALEN);
+	put_unaligned_le16(sta->aid, body + 8);
+	put_unaligned_le16(dev->mphy.hw->conf.listen_interval, body + 10);
+	body[0xc] = mvif->bss_conf.mt76.idx;
+	body[0xd] = band == NL80211_BAND_2GHZ ? 7 : 8;
+	put_unaligned_le16(link->supp_rates[band] << shift, body + 0xe);
+	put_unaligned_le16(vif->bss_conf.basic_rates << shift, body + 0x10);
+	body[0x12] = sta->wme;
+	body[0x14] = state == MT76_STA_INFO_STATE_ASSOC ? 2 : 0;
+	body[0x17] = 1;
+	if (link->ht_cap.ht_supported) {
+		body[0xd] |= BIT(4);
+		body[0x15] = link->ht_cap.mcs.rx_mask[0];
+		memcpy(body + 0x18, link->ht_cap.mcs.rx_mask, 10);
+		memcpy(body + 0x22, &link->ht_cap.mcs.rx_highest, 2);
+		memcpy(body + 0x24, &link->ht_cap.mcs.tx_params, 1);
+		put_unaligned_le16(link->ht_cap.cap, body + 0x28);
+		body[0x30] = link->ht_cap.ampdu_factor | link->ht_cap.ampdu_density << 2;
+	}
+	body[0x32] = to_rcpi(-ewma_rssi_read(&mvif->bss_conf.rssi));
+	body[0x33] = body[0x14] == 2;
+	body[0x36] = idx;
+	body[0x37] = 0xff;
+	if (link->vht_cap.vht_supported) {
+		body[0xd] |= BIT(5);
+		put_unaligned_le32(link->vht_cap.cap, body + 0x38);
+		memcpy(body + 0x3c, &link->vht_cap.vht_mcs, 8);
+	}
+	body[0x44] = 3;
+	put_unaligned_le16(0xffff, body + 0x60);
+	body[0x7d] = 1;
+	if (link->he_cap.has_he) {
+		body[0xd] |= BIT(6);
+		memcpy(body + 0x88, link->he_cap.he_cap_elem.mac_cap_info, 6);
+		memcpy(body + 0x8e, link->he_cap.he_cap_elem.phy_cap_info, 11);
+		memcpy(body + 0x9c, &link->he_cap.he_mcs_nss_supp, 12);
+		memcpy(body + 0xa8, &link->he_6ghz_capa.capa, 2);
+	}
+	dev_info(dev->mt76.dev, "MT7932 STA sta=%u wcid=%u bss=%u state=%u\n",
+		 body[0], body[0x36], body[0xc], body[0x14]);
+	return mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_SET_STA, body, sizeof(body), body[0x33]);
+}
+
+int mt7932_set_key(struct mt792x_dev *dev, struct ieee80211_vif *vif,
+		   struct ieee80211_sta *sta, struct ieee80211_key_conf *key,
+		   enum set_key_cmd cmd)
+{
+	struct mt792x_vif *mvif = (void *)vif->drv_priv;
+	struct mt792x_sta *msta = sta ? (void *)sta->drv_priv : &mvif->sta;
+	struct mt76_wcid *wcid = &msta->deflink.wcid;
+	u8 body[64] = {};
+	int ret;
+
+	if (key->cipher != WLAN_CIPHER_SUITE_CCMP || key->keylen != 16)
+		return -EOPNOTSUPP;
+	body[0] = cmd == SET_KEY;
+	body[1] = !!(key->flags & IEEE80211_KEY_FLAG_PAIRWISE);
+	body[2] = body[1];
+	if (sta)
+		memcpy(body + 4, sta->addr, ETH_ALEN);
+	else
+		eth_broadcast_addr(body + 4);
+	body[10] = mvif->bss_conf.mt76.idx;
+	body[11] = 4;
+	body[12] = key->keyidx;
+	body[13] = key->keylen;
+	body[14] = wcid->idx;
+	memcpy(body + 16, key->key, key->keylen);
+	mt792x_mutex_acquire(dev);
+	ret = mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_ADD_REMOVE_KEY, body, sizeof(body), false);
+	if (!ret) {
+		wcid->hw_key_idx = cmd == SET_KEY ? key->keyidx : -1;
+		mt76_wcid_key_setup(&dev->mt76, wcid, cmd == SET_KEY ? key : NULL);
+	}
+	mt792x_mutex_release(dev);
+	memzero_explicit(body, sizeof(body));
+	return ret;
+}
+
+int mt7932_load_calibration(struct mt792x_dev *dev)
+{
+	const struct mt7932_cal_file_header *header;
+	const struct mt7932_cal_profile_reply *profile;
+	const struct firmware *fw;
+	struct sk_buff *reply;
+	struct mt7932_cal_profile_query query = {
+		.selector = MT7932_CAL_PROFILE_SELECTOR,
+	};
+	char name[80];
+	size_t pos;
+	u32 count, i;
+	int ret;
+
+	ret = mt7932_basic_config(&dev->mt76);
+	if (ret)
+		return ret;
+	snprintf(name, sizeof(name), "mediatek/mt7932/calibration-%pm.bin",
+		 dev->mphy.macaddr);
+	ret = request_firmware(&fw, name, dev->mt76.dev);
+	if (ret)
+		return ret;
+	ret = -EINVAL;
+	header = (const void *)fw->data;
+	if (fw->size < sizeof(*header) || fw->size > MT7932_CAL_MAX_FILE_SIZE ||
+	    memcmp(header->magic, MT7932_CAL_MAGIC, sizeof(header->magic)) ||
+	    !ether_addr_equal(header->mac, dev->mphy.macaddr))
+		goto out;
+	count = le32_to_cpu(header->count);
+	if (!count || count > MT7932_CAL_MAX_RECORDS)
+		goto out;
+	/* Validate the entire replay before provisioning this individual board. */
+	for (pos = sizeof(*header), i = 0; i < count; i++) {
+		const struct mt7932_cal_file_record *record;
+		u32 size;
+
+		if (pos > fw->size || fw->size - pos < sizeof(*record))
+			goto out;
+		record = (const void *)(fw->data + pos);
+		size = le32_to_cpu(record->len);
+		pos += sizeof(*record);
+		if (!size || size > MT7932_CAL_MAX_PAYLOAD || size > fw->size - pos ||
+		    record->set_query > 1 || record->wait_response > 1)
+			goto out;
+		if (record->cid == FIELD_GET(__MCU_CMD_FIELD_ID, MT7932_CMD_CAL_EXT_21)) {
+			const struct mt7932_cal_ext_fragment *fragment = (const void *)record->data;
+
+			if (record->ext_cid != FIELD_GET(__MCU_CMD_FIELD_EXT_ID,
+							 MT7932_CMD_CAL_EXT_21) ||
+			    size < sizeof(*fragment) ||
+			    size > sizeof(*fragment) + MT7932_CAL_EXT_MAX_DATA ||
+			    fragment->type != MT7932_CAL_EXT_FRAGMENT ||
+			    le16_to_cpu(fragment->len) != size - sizeof(*fragment))
+				goto out;
+		} else if ((record->cid != MT7932_CMD_PRECAL &&
+			    record->cid != MT7932_CMD_CAL_D7) || record->ext_cid) {
+			goto out;
+		}
+		pos += size;
+	}
+	if (pos != fw->size)
+		goto out;
+	ret = mt76_mcu_send_and_get_msg(&dev->mt76,
+			MT7932_CMD_CAL_PROFILE | __MCU_CMD_FIELD_QUERY,
+			&query, sizeof(query), true, &reply);
+	if (ret)
+		goto out;
+	profile = (const void *)reply->data;
+	if (reply->len < sizeof(*profile) || profile->cid != MT7932_CMD_CAL_PROFILE) {
+		dev_err(dev->mt76.dev, "MT7932 calibration-type query invalid (len %u)\n",
+			 reply->len);
+		ret = -EINVAL;
+	} else {
+		dev_info(dev->mt76.dev, "MT7932 calibration profile: %*ph\n",
+			 (int)sizeof(*profile), reply->data);
+	}
+	dev_kfree_skb(reply);
+	if (ret)
+		goto out;
+	for (pos = sizeof(*header), i = 0; i < count; i++) {
+		const struct mt7932_cal_file_record *record = (const void *)(fw->data + pos);
+		u32 size = le32_to_cpu(record->len);
+		int cmd = FIELD_PREP(__MCU_CMD_FIELD_ID, record->cid) |
+			  FIELD_PREP(__MCU_CMD_FIELD_EXT_ID, record->ext_cid);
+
+		if (!record->set_query)
+			cmd |= __MCU_CMD_FIELD_QUERY;
+		ret = mt76_mcu_send_msg(&dev->mt76, cmd, record->data, size,
+				      !record->set_query || record->wait_response);
+		if (ret)
+			goto out;
+		pos += sizeof(*record) + size;
+	}
+	dev_info(dev->mt76.dev, "MT7932 board calibration uploaded (%u records)\n", count);
+out:
+	release_firmware(fw);
+	return ret;
+}
+
+int mt7932_mcu_send_message(struct mt76_dev *mdev, struct sk_buff *skb,
+			  int cmd, int *wait_seq)
+{
+	struct mt792x_dev *dev = container_of(mdev, struct mt792x_dev, mt76);
+	struct mt76_connac2_mcu_txd *hdr;
+	u8 seq = ++mdev->mcu.msg_seq;
+	bool running = test_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
+
+	if (!seq)
+		seq = ++mdev->mcu.msg_seq;
+	if (wait_seq)
+		*wait_seq = seq;
+	mdev->mcu.timeout = 6 * HZ;
+	if (cmd == MCU_CMD(FW_SCATTER))
+		return mt76_tx_queue_skb_raw(dev, mdev->q_mcu[MT_MCUQ_FWDL], skb, 0);
+	/* MT7932 uses legacy flat commands; do not send CONNAC UNI TLVs. */
+	if (cmd & __MCU_CMD_FIELD_UNI) {
+		dev_err(mdev->dev, "MT7932 unsupported UNI command %#x\n", cmd);
+		dev_kfree_skb(skb);
+		return -EOPNOTSUPP;
+	}
+	if (running && cmd == MCU_CE_CMD(SET_CHAN_DOMAIN)) {
+		struct mt7932_channel_domain_input *input = (void *)skb->data;
+		struct mt7932_channel_domain *domain = (void *)skb->data;
+		struct mt7932_domain_channel *channels;
+		unsigned int count, i;
+
+		if (skb->len < sizeof(*input)) {
+			dev_kfree_skb(skb);
+			return -EINVAL;
+		}
+		count = input->n_2ch + input->n_5ch + input->n_6ch;
+		if (skb->len != sizeof(*domain) + sizeof(*channels) * count) {
+			dev_kfree_skb(skb);
+			return -EINVAL;
+		}
+		if (domain->alpha2[0] == '0' && domain->alpha2[1] == '0') {
+			domain->alpha2[0] = 'X';
+			domain->alpha2[1] = 'Z';
+		}
+		domain->unknown_policy4 = cpu_to_le16(1);
+		domain->unknown_policy6 = dev->mphy.cap.has_6ghz ? 2 : 0;
+		domain->flags = (mdev->region ? MT7932_DOMAIN_HAS_DFS_REGION |
+				FIELD_PREP(MT7932_DOMAIN_DFS_REGION, mdev->region) : 0) |
+				(input->n_6ch ? MT7932_DOMAIN_HAS_6GHZ : 0);
+		domain->unknown_fcc_policy = mdev->region == NL80211_DFS_FCC ? 0x0f : 0;
+		channels = (void *)(domain + 1);
+		for (i = 0; i < count; i++) {
+			u32 flags = le32_to_cpu(channels[i].flags);
+
+			flags = (flags & IEEE80211_CHAN_NO_IR ? MT7932_CHANNEL_PASSIVE : 0) |
+				(flags & IEEE80211_CHAN_RADAR ? MT7932_CHANNEL_DFS : 0);
+			channels[i].flags = cpu_to_le32(flags);
+		}
+	}
+
+	if (running && cmd == MCU_CE_CMD(START_HW_SCAN)) {
+		struct mt76_connac_hw_scan_req *req = (void *)skb->data;
+		struct mt7932_scan_request *native;
+		struct mt76_connac_hw_scan_req *common;
+		struct sk_buff *wire;
+
+		if (skb->len != sizeof(*req)) {
+			dev_kfree_skb(skb);
+			return -EINVAL;
+		}
+		wire = mt76_mcu_msg_alloc(mdev, NULL, sizeof(*native));
+		if (!wire) {
+			dev_kfree_skb(skb);
+			return -ENOMEM;
+		}
+		native = skb_put_zero(wire, sizeof(*native));
+		common = (void *)native->common;
+		memcpy(native->common, req, sizeof(native->common));
+		memcpy(native->ext_ssids, req->ext_ssids, sizeof(native->ext_ssids));
+		ether_addr_copy(native->bssid, req->bssid);
+		ether_addr_copy(native->random_mac, req->random_mac);
+		/* No split scan or DBDC policy on this single-radio setup. */
+		common->scan_func &= ~SCAN_FUNC_SPLIT_SCAN;
+		common->scan_func |= MT7932_SCAN_DISABLE_DBDC;
+		common->probe_req_num = 0;
+		common->version = 1;
+		/* Receive beacons while the active-probe ABI is brought up. */
+		common->scan_type = 0;
+		if (req->ssid_type_ext && common->ssids_num)
+			common->ssid_type = MT7932_SCAN_SPECIFIED_SSIDS;
+		/* Firmware generates rate and PHY capability IEs itself. Keep the
+		 * caller's additional IEs without duplicating those capabilities.
+		 */
+		{
+			u8 *ies = common->ies;
+			unsigned int len = le16_to_cpu(common->ies_len);
+			unsigned int pos = 0, out = 0;
+
+			if (len > sizeof(common->ies))
+				goto invalid_scan;
+			while (pos < len) {
+				unsigned int size;
+				u8 id;
+				bool generated;
+
+				if (len - pos < 2)
+					goto invalid_scan;
+				id = ies[pos];
+				size = 2 + ies[pos + 1];
+				if (size > len - pos)
+					goto invalid_scan;
+				generated = id == WLAN_EID_SSID ||
+					id == WLAN_EID_SUPP_RATES ||
+					id == WLAN_EID_EXT_SUPP_RATES ||
+					id == WLAN_EID_HT_CAPABILITY ||
+					id == WLAN_EID_VHT_CAPABILITY ||
+					id == WLAN_EID_EXT_CAPABILITY ||
+					id == WLAN_EID_SUPPORTED_REGULATORY_CLASSES ||
+					(id == WLAN_EID_EXTENSION && size > 2 &&
+					 (ies[pos + 2] == WLAN_EID_EXT_HE_CAPABILITY ||
+					  ies[pos + 2] == WLAN_EID_EXT_HE_6GHZ_CAPA));
+				if (!generated) {
+					memmove(ies + out, ies + pos, size);
+					out += size;
+				}
+				pos += size;
+			}
+			memset(ies + out, 0, sizeof(common->ies) - out);
+			common->ies_len = cpu_to_le16(out);
+		}
+		goto scan_valid;
+invalid_scan:
+		dev_kfree_skb(wire);
+		dev_kfree_skb(skb);
+		return -EINVAL;
+scan_valid:
+		dev_info(mdev->dev, "MT7932 scan seq=%u bss=%u type=%u mask=%#x channels=%u+%u band=%u\n",
+			 common->seq_num, common->bss_idx, common->scan_type,
+			 common->scan_func, common->channels_num,
+			 common->ext_channels_num, common->channel_type);
+		common->channel_dwell_time = cpu_to_le16(MT7932_SCAN_DWELL_MS);
+		common->timeout_value = cpu_to_le16(MT7932_SCAN_FW_TIMEOUT_MS);
+		common->channel_min_dwell_time = cpu_to_le16(MT7932_SCAN_MIN_DWELL_MS);
+		dev_kfree_skb(skb);
+		skb = wire;
+	}
+	if (running && cmd == MCU_CE_CMD(SET_RATE_TX_POWER)) {
+		struct mt76_connac_tx_power_limit_tlv *req = (void *)skb->data;
+		struct mt76_connac_sku_tlv *rates;
+		struct mt76_connac_tx_power_limit_tlv *header;
+		struct mt7932_power_channel *channels;
+		struct sk_buff *wire;
+		int i, j, len;
+
+		if (skb->len < sizeof(*req) || req->n_chan > MT7932_POWER_MAX_CHANNELS ||
+		    skb->len != sizeof(*req) + req->n_chan * sizeof(*rates)) {
+			dev_kfree_skb(skb);
+			return -EINVAL;
+		}
+		len = sizeof(*header) + sizeof(*channels) * req->n_chan;
+		wire = mt76_mcu_msg_alloc(mdev, NULL, len);
+		if (!wire) {
+			dev_kfree_skb(skb);
+			return -ENOMEM;
+		}
+		header = skb_put_zero(wire, len);
+		memcpy(header, req, sizeof(*header));
+		header->ver = MT7932_POWER_WIRE_VERSION;
+		header->pad0 = MT7932_POWER_WIRE_FORMAT;
+		header->len = cpu_to_le16(len);
+		channels = (void *)(header + 1);
+		rates = (void *)(skb->data + sizeof(*req));
+		for (i = 0; i < req->n_chan; i++) {
+			s8 limit = MT7932_POWER_CEILING_HALF_DBM;
+
+			for (j = 0; j < ARRAY_SIZE(rates[i].pwr_limit); j++)
+				limit = min(limit, rates[i].pwr_limit[j]);
+			channels[i].channel = rates[i].channel;
+			memset(channels[i].rate_limit, limit, sizeof(channels[i].rate_limit));
+		}
+		dev_kfree_skb(skb);
+		skb = wire;
+	}
+	hdr = (void *)skb_push(skb, sizeof(*hdr));
+	memset(hdr, 0, sizeof(*hdr));
+	hdr->txd[0] = cpu_to_le32(FIELD_PREP(MT_TXD0_TX_BYTES, skb->len) |
+				FIELD_PREP(MT_TXD0_PKT_FMT, MT_TX_TYPE_CMD));
+	hdr->txd[1] = cpu_to_le32(FIELD_PREP(MT_TXD1_HDR_FORMAT, MT_HDR_FORMAT_CMD));
+	hdr->len = cpu_to_le16(skb->len - sizeof(hdr->txd));
+	hdr->cid = FIELD_GET(__MCU_CMD_FIELD_ID, cmd);
+	hdr->pkt_type = MCU_PKT_ID;
+	hdr->seq = seq;
+	if (running) {
+		hdr->ext_cid = FIELD_GET(__MCU_CMD_FIELD_EXT_ID, cmd);
+		hdr->set_query = !(cmd & __MCU_CMD_FIELD_QUERY) &&
+				 hdr->cid != MCU_CE_CMD_GET_NIC_CAPAB;
+		hdr->ext_cid_ack = !!wait_seq;
+	}
+	return mt76_tx_queue_skb_raw(dev, mdev->q_mcu[MT_MCUQ_WM], skb, 0);
+}
+EXPORT_SYMBOL_GPL(mt7932_mcu_send_message);
+
+int mt7932_mcu_parse_response(struct mt76_dev *mdev, int cmd,
+			    struct sk_buff *skb, int seq)
+{
+	struct mt792x_dev *dev = container_of(mdev, struct mt792x_dev, mt76);
+	const struct mt76_connac2_mcu_rxd *rxd;
+	u8 cid = FIELD_GET(__MCU_CMD_FIELD_ID, cmd);
+	u16 type;
+
+	if (!skb) {
+		dev_err(mdev->dev, "MT7932 command %#x seq %u timed out\n", cmd, seq);
+		return -ETIMEDOUT;
+	}
+	if (cid == MCU_CMD_PATCH_SEM_CONTROL || cid == MCU_CE_CMD_GET_NIC_CAPAB)
+		dev_info(mdev->dev, "MT7932 CID %#x reply len=%u: %*ph\n", cid,
+			 skb->len, min_t(unsigned int, skb->len, 48), skb->data);
+	if (skb->len < MT7932_BOOT_HEADER_SIZE)
+		return -EINVAL;
+	rxd = (const void *)skb->data;
+	if (rxd->seq != seq)
+		return -EAGAIN;
+	type = le16_to_cpu(rxd->pkt_type_id);
+	/* The Neo ROM emits packet type7 in its eight-byte event header. */
+	if (type == MT7932_BOOT_PACKET_TYPE || (type == MT7932_ROM_PACKET_TYPE &&
+	    !test_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state))) {
+		u8 expected_eid = cid == MCU_CMD_PATCH_SEM_CONTROL ? MCU_EVENT_MT_PATCH_SEM :
+				  cid == MCU_CMD_INIT_ACCESS_REG ? MCU_EVENT_ACCESS_REG :
+								  MCU_EVENT_GENERIC;
+		u8 status;
+
+		/* Preserve the existing four-byte minimum boot reply payload. */
+		if (skb->len < MT7932_BOOT_HEADER_SIZE + sizeof(__le32))
+			return -EINVAL;
+		if (rxd->eid != expected_eid)
+			return -EAGAIN;
+		status = skb->data[MT7932_BOOT_HEADER_SIZE];
+		skb_pull(skb, MT7932_BOOT_HEADER_SIZE);
+		if (cid == MCU_CMD_PATCH_SEM_CONTROL) {
+			dev_info(mdev->dev, "MT7932 patch semaphore status %u\n", status);
+			return status;
+		}
+		if (cid == MCU_CMD_INIT_ACCESS_REG)
+			return 0;
+		if (status != MT7932_BOOT_SUCCESS)
+			dev_err(mdev->dev, "MT7932 boot CID %#x status %u\n", cid, status);
+		return status == MT7932_BOOT_SUCCESS ? 0 : -EIO;
+	}
+	if (type != MT7932_RUNTIME_PACKET_TYPE || skb->len < sizeof(*rxd))
+		return -EINVAL;
+	if (cmd == MCU_CE_QUERY(REG_READ)) {
+		const struct mt7932_register_result *result = (const void *)rxd->tlv;
+
+		if (skb->len < sizeof(*rxd) + sizeof(*result))
+			return -EINVAL;
+		return (int)le32_to_cpu(result->value);
+	}
+	/* A generic result includes the CID; reject unrelated command replies. */
+	if (rxd->eid == MT7932_EVENT_COMMAND_RESULT) {
+		const struct mt7932_command_result *result = (const void *)rxd->tlv;
+
+		if (skb->len < sizeof(*rxd) + sizeof(*result))
+			return -EINVAL;
+		if (result->cid != cid)
+			return -EAGAIN;
+		if (result->status)
+			return -EIO;
+	}
+	skb_pull(skb, sizeof(*rxd));
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt7932_mcu_parse_response);
+
+static int mt7932_scatter(struct mt792x_dev *dev, const u8 *data, size_t len)
+{
+	struct mt76_queue *q = dev->mt76.q_mcu[MT_MCUQ_FWDL];
+	unsigned long expires;
+
+	while (len) {
+		size_t size = min_t(size_t, len, MT7932_FW_SCATTER_CHUNK);
+		int ret;
+
+		expires = jiffies + 6 * HZ;
+		while (READ_ONCE(q->queued) + 1 >= q->ndesc - 1) {
+			mt76_queue_tx_cleanup(dev, q, false);
+			if (time_after(jiffies, expires)) {
+				dev_err(dev->mt76.dev, "MT7932 firmware download ring stalled\n");
+				return -ETIMEDOUT;
+			}
+			usleep_range(100, 200);
+		}
+		ret = mt76_mcu_send_msg(&dev->mt76, MCU_CMD(FW_SCATTER),
+				       data, size, false);
+		if (ret)
+			return ret;
+		mt76_queue_tx_cleanup(dev, q, false);
+		data += size;
+		len -= size;
+	}
+	/* Finish consuming this target before issuing the next boot command. */
+	expires = jiffies + 6 * HZ;
+	while (READ_ONCE(q->queued)) {
+		mt76_queue_tx_cleanup(dev, q, false);
+		if (time_after(jiffies, expires))
+			return -ETIMEDOUT;
+		usleep_range(100, 200);
+	}
+	return 0;
+}
+
+static int mt7932_download(struct mt792x_dev *dev, u8 cid, u32 addr,
+			  const u8 *data, u32 len)
+{
+	struct { __le32 addr, len, mode; } req = {
+		cpu_to_le32(addr), cpu_to_le32(len), cpu_to_le32(DL_MODE_NEED_RSP),
+	};
+	int ret = mt76_mcu_send_msg(&dev->mt76, cid, &req,
+				   sizeof(req), true);
+
+	if (ret)
+		return ret;
+	return mt7932_scatter(dev, data, len);
+}
+
+static int mt7932_secure_command(struct mt792x_dev *dev, u8 cid,
+				 const void *data, size_t len)
+{
+	int ret;
+
+	mt76_wr(dev, MT7932_PCIE_REMAP(0), MT7932_PCIE_REMAP_BOOT);
+	udelay(MT7932_PCIE_REMAP_SETTLE_US);
+	if (!mt76_poll_msec(dev, MT7932_SECURE_READY, MT7932_SECURE_READY_BIT,
+			    MT7932_SECURE_READY_BIT, 5000)) {
+		ret = -ETIMEDOUT;
+		goto restore;
+	}
+	ret = mt76_mcu_send_msg(&dev->mt76, cid, data, len, true);
+	mt76_wr(dev, MT7932_SECURE_COMPLETE, MT7932_SECURE_COMPLETE_BIT);
+restore:
+	mt76_wr(dev, MT7932_PCIE_REMAP(0), MT7932_PCIE_REMAP_RUNTIME);
+	return ret;
+}
+
+static int mt7932_load_patch(struct mt792x_dev *dev)
+{
+	const struct mt76_connac2_patch_hdr *hdr;
+	const struct firmware *fw;
+	u8 sem[4] = { MT7932_PATCH_SEM_REQUEST };
+	u32 n, i, wifi_sections = 0;
+	int ret, tries;
+
+	for (tries = 0; tries < 50; tries++) {
+		ret = mt76_mcu_send_msg(&dev->mt76, MCU_CMD(PATCH_SEM_CONTROL),
+					sem, sizeof(sem), true);
+		if (ret != MT7932_PATCH_SEM_BUSY)
+			break;
+		msleep(100);
+	}
+	if (ret == MT7932_PATCH_ALREADY_LOADED)
+		return 0;
+	if (ret != MT7932_PATCH_SEM_ACQUIRED)
+		dev_err(dev->mt76.dev, "MT7932 patch semaphore request failed: %d\n", ret);
+	if (ret != MT7932_PATCH_SEM_ACQUIRED)
+		return ret < 0 ? ret : -EIO;
+	ret = request_firmware(&fw, MT7932_ROM_PATCH, dev->mt76.dev);
+	if (ret)
+		return ret;
+	ret = -EINVAL;
+	if (fw->size < sizeof(*hdr))
+		goto out;
+	hdr = (const void *)fw->data;
+	n = be32_to_cpu(hdr->desc.n_region);
+	if (!n || n > (fw->size - sizeof(*hdr)) / sizeof(struct mt76_connac2_patch_sec))
+		goto out;
+	/* Reject malformed sections before sending any of the patch. */
+	for (i = 0; i < n; i++) {
+		const struct mt76_connac2_patch_sec *sec =
+			(const void *)(fw->data + sizeof(*hdr) + i * sizeof(*sec));
+		u32 off = be32_to_cpu(sec->offs), len = be32_to_cpu(sec->info.len);
+
+		if (get_unaligned_be32(&sec->info.rsv[0]) != MT7932_PATCH_WIFI_SECTION)
+			continue;
+		wifi_sections++;
+		if (!len || off < sizeof(*hdr) + n * sizeof(*sec) ||
+		    off > fw->size || len > fw->size - off ||
+		    len > be32_to_cpu(sec->size))
+			goto out;
+		if (be32_to_cpu(sec->info.sec_key_idx) != PATCH_SEC_NOT_SUPPORT) {
+			ret = -EOPNOTSUPP;
+			goto out;
+		}
+	}
+	if (!wifi_sections)
+		goto out;
+	for (i = 0; i < n; i++) {
+		const struct mt76_connac2_patch_sec *sec =
+			(const void *)(fw->data + sizeof(*hdr) + i * sizeof(*sec));
+		u32 off = be32_to_cpu(sec->offs), len = be32_to_cpu(sec->info.len);
+
+		if (get_unaligned_be32(&sec->info.rsv[0]) != MT7932_PATCH_WIFI_SECTION)
+			continue;
+		ret = mt7932_download(dev, MCU_CMD_PATCH_START_REQ,
+				      be32_to_cpu(sec->info.addr),
+				      fw->data + off, len);
+		if (ret)
+			goto out;
+	}
+	{
+		u8 finish[4] = {};
+		ret = mt7932_secure_command(dev, MCU_CMD_PATCH_FINISH_REQ,
+					    finish, sizeof(finish));
+	}
+out:
+	release_firmware(fw);
+	return ret;
+}
+
+static int mt7932_load_ram(struct mt792x_dev *dev)
+{
+	const struct mt76_connac2_fw_trailer *trailer;
+	const struct mt76_connac2_fw_region *regions;
+	const struct firmware *fw;
+	struct { __le32 option, addr; } start = {};
+	size_t data_size, off = 0;
+	int ret, i;
+
+	ret = request_firmware(&fw, MT7932_FIRMWARE_WM, dev->mt76.dev);
+	if (ret)
+		return ret;
+	ret = -EINVAL;
+	if (fw->size < sizeof(*trailer))
+		goto out;
+	trailer = (const void *)(fw->data + fw->size - sizeof(*trailer));
+	if (!trailer->n_region || trailer->n_region > MT7932_FW_MAX_REGIONS ||
+	    fw->size < sizeof(*trailer) + trailer->n_region * sizeof(*regions))
+		goto out;
+	data_size = fw->size - sizeof(*trailer) - trailer->n_region * sizeof(*regions);
+	regions = (const void *)(fw->data + data_size);
+	/* Validate every region before issuing the first download command. */
+	for (i = 0; i < trailer->n_region; i++) {
+		u32 len = le32_to_cpu(regions[i].len);
+		if (off > data_size || len > data_size - off)
+			goto out;
+		if (regions[i].feature_set & FW_FEATURE_SET_ENCRYPT) {
+			ret = -EOPNOTSUPP;
+			goto out;
+		}
+		off += len;
+	}
+	off = 0;
+	for (i = 0; i < trailer->n_region; i++) {
+		u32 len = le32_to_cpu(regions[i].len);
+		if (!(regions[i].feature_set & FW_FEATURE_NON_DL)) {
+			ret = mt7932_download(dev, MCU_CMD_TARGET_ADDRESS_LEN_REQ,
+					      le32_to_cpu(regions[i].addr),
+					      fw->data + off, len);
+			if (ret)
+				goto out;
+		}
+		if (regions[i].feature_set & FW_FEATURE_OVERRIDE_ADDR) {
+			start.option = cpu_to_le32(FW_START_OVERRIDE);
+			start.addr = regions[i].addr;
+		}
+		off += len;
+	}
+	ret = mt7932_secure_command(dev, MCU_CMD_FW_START_REQ, &start, sizeof(start));
+out:
+	release_firmware(fw);
+	return ret;
+}
+
+int mt7932_load_firmware(struct mt792x_dev *dev)
+{
+	struct pci_dev *pdev = to_pci_dev(dev->mt76.dev);
+	u32 state;
+	int ret, i;
+
+	mt7932_fullmac_reset(dev);
+	clear_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
+	ret = mt7932_publish_shared_memory(dev);
+	if (ret)
+		return ret;
+	ret = mt7932_load_patch(dev);
+	if (ret)
+		return ret;
+	ret = mt7932_load_ram(dev);
+	if (ret)
+		return ret;
+	for (i = 0; i < 1000; i++) {
+		ret = pci_read_config_dword(pdev, MT7932_PCIE_FW_STATE, &state);
+		if (ret || state == ~0U)
+			return -EIO;
+		if (FIELD_GET(MT7932_PCIE_FW_STATE_MASK, state) ==
+		    MT7932_PCIE_FW_STATE_READY) {
+			set_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
+			dev_info(dev->mt76.dev, "MT7932 firmware ready\n");
+			return mt76_mcu_send_msg(&dev->mt76, __MCU_CMD_FIELD_CE, NULL, 0, false);
+		}
+		msleep(5);
+	}
+	return -ETIMEDOUT;
+}
+MODULE_FIRMWARE(MT7932_FIRMWARE_WM);
+MODULE_FIRMWARE(MT7932_ROM_PATCH);
diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_cfg80211.c b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_cfg80211.c
new file mode 100644
index 0000000000000..2d322f5506eb5
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_cfg80211.c
@@ -0,0 +1,494 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MT7932 firmware SME frontend using the standard cfg80211 station API. */
+#include <linux/etherdevice.h>
+#include <linux/unaligned.h>
+#include "mt7921.h"
+#include "regd.h"
+#include "mt7932_offload.h"
+#include "mt7932_fullmac.h"
+#include "mt7932_mcu.h"
+
+#define MT7932_SCAN_MAX_SSIDS 4
+#define MT7932_SCAN_TIMEOUT (20 * HZ)
+#define MT7932_CONNECT_TIMEOUT (45 * HZ)
+#define MT7932_DISCONNECT_TIMEOUT (5 * HZ)
+
+static struct mt7932_fullmac *mt7932_wiphy_priv(struct wiphy *wiphy)
+{
+	return *(struct mt7932_fullmac **)wiphy_priv(wiphy);
+}
+
+void mt7932_cfg80211_scan_done(struct mt7932_fullmac *fm, bool aborted)
+{
+	struct cfg80211_scan_info info = { .aborted = aborted };
+	struct cfg80211_scan_request *request = fm->scan_request;
+
+	lockdep_assert_wiphy(fm->wiphy);
+	if (!request)
+		return;
+	fm->scan_request = NULL;
+	fm->scan_next_channel = 0;
+	wiphy_delayed_work_cancel(fm->wiphy, &fm->scan_timeout);
+	cfg80211_scan_done(request, &info);
+}
+
+static void mt7932_cancel_scan(struct mt7932_fullmac *fm)
+{
+	struct {
+		u8 seq_num;
+		u8 is_ext_channel;
+		u8 reserved[2];
+	} __packed cmd = { .seq_num = fm->scan_seq & MT7932_SCAN_SEQUENCE_MASK };
+	int ret;
+
+	if (!fm->scan_request)
+		return;
+	mt792x_mutex_acquire(fm->dev);
+	ret = mt76_mcu_send_msg(&fm->dev->mt76, MCU_CE_CMD(CANCEL_HW_SCAN),
+			       &cmd, sizeof(cmd), false);
+	mt792x_mutex_release(fm->dev);
+	/* Same ordered cancel protocol used by mt76_connac_mcu_cancel_hw_scan.
+	 * Finish once; late completions cannot finish a newer scan sequence.
+	 */
+	mt7932_cfg80211_scan_done(fm, true);
+	if (ret)
+		mt792x_reset(&fm->dev->mt76);
+}
+
+static void mt7932_scan_timeout(struct wiphy *wiphy, struct wiphy_work *work)
+{
+	mt7932_cancel_scan(mt7932_wiphy_priv(wiphy));
+}
+
+static void mt7932_cfg_abort_scan(struct wiphy *wiphy, struct wireless_dev *wdev)
+{
+	mt7932_cancel_scan(mt7932_wiphy_priv(wiphy));
+}
+
+void mt7932_cfg80211_connected(struct mt7932_fullmac *fm)
+{
+	lockdep_assert_wiphy(fm->wiphy);
+	if (!fm->connecting || fm->disconnecting)
+		return;
+	fm->connecting = false;
+	fm->connected = true;
+	fm->connected_at = jiffies;
+	WRITE_ONCE(fm->last_activity, jiffies);
+	WRITE_ONCE(fm->signal_valid, false);
+	dev_get_stats(fm->netdev, &fm->station_start_stats);
+	wiphy_delayed_work_cancel(fm->wiphy, &fm->connect_timeout);
+	cfg80211_connect_result(fm->netdev, fm->bssid, NULL, 0, NULL, 0,
+				WLAN_STATUS_SUCCESS, GFP_KERNEL);
+	cfg80211_port_authorized(fm->netdev, fm->bssid, NULL, 0, GFP_KERNEL);
+	netif_carrier_on(fm->netdev);
+}
+
+void mt7932_cfg80211_disconnected(struct mt7932_fullmac *fm, u16 reason)
+{
+	lockdep_assert_wiphy(fm->wiphy);
+	netif_carrier_off(fm->netdev);
+	fm->active = false;
+	fm->peer_wcid = MT7932_NO_WCID;
+	wiphy_delayed_work_cancel(fm->wiphy, &fm->connect_timeout);
+	if (fm->connecting)
+		cfg80211_connect_result(fm->netdev, fm->bssid, NULL, 0, NULL, 0,
+					WLAN_STATUS_UNSPECIFIED_FAILURE, GFP_KERNEL);
+	else if (fm->connected)
+		cfg80211_disconnected(fm->netdev,
+			fm->disconnecting ? fm->disconnect_reason : reason,
+			NULL, 0, fm->disconnecting, GFP_KERNEL);
+	fm->connecting = false;
+	fm->connected = false;
+	fm->disconnecting = false;
+}
+
+static void mt7932_connect_timeout(struct wiphy *wiphy, struct wiphy_work *work)
+{
+	struct mt7932_fullmac *fm = mt7932_wiphy_priv(wiphy);
+
+	if (fm->disconnecting) {
+		/* A missing firmware completion requires actual recovery, not a
+		 * fabricated success notification while the radio stays joined.
+		 */
+		mt792x_reset(&fm->dev->mt76);
+		return;
+	}
+	if (fm->connecting) {
+		cfg80211_connect_timeout(fm->netdev, fm->bssid, NULL, 0,
+			GFP_KERNEL, NL80211_TIMEOUT_UNSPECIFIED);
+		fm->connecting = false;
+		fm->disconnecting = true;
+		fm->disconnect_reason = WLAN_REASON_UNSPECIFIED;
+		if (mt7932_offload_disconnect(fm->dev, fm->bssid))
+			mt792x_reset(&fm->dev->mt76);
+		else
+			wiphy_delayed_work_queue(wiphy, &fm->connect_timeout,
+						MT7932_DISCONNECT_TIMEOUT);
+	}
+}
+
+/* Discovery uses the firmware's host-owned context separately from AIS.
+ * The old mac80211 add_interface callback supplied this initialization.
+ */
+static int mt7932_prepare_discovery(struct mt7932_fullmac *fm)
+{
+	struct mt792x_dev *dev = fm->dev;
+	struct mt7932_activate_bss activate = {
+		.bss_idx = MT7932_DISCOVERY_BSS,
+		.active = 1,
+		.network_type = 1, /* Host-managed P2P client role. */
+		.omac_idx = MT7932_DISCOVERY_BSS,
+		.bmc_wcid = MT7932_NO_WCID,
+		.unknown_11 = 1,
+	};
+	int ret;
+
+	if (fm->scan_context_active)
+		return 0;
+	ether_addr_copy(activate.mac, dev->mphy.macaddr);
+	ret = mt7932_start(&dev->phy);
+	if (!ret)
+		ret = mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_ACTIVATE_BSS,
+				       &activate, sizeof(activate), false);
+	if (!ret && !dev->mphy.chandef.chan) {
+		struct ieee80211_supported_band *band;
+
+		band = fm->wiphy->bands[NL80211_BAND_2GHZ];
+		if (!band || !band->n_channels)
+			return -ENODEV;
+		cfg80211_chandef_create(&dev->mphy.chandef,
+				       &band->channels[0], NL80211_CHAN_NO_HT);
+		ret = mt7932_set_channel(&dev->phy, MT7932_AIS_BSS);
+	}
+	if (!ret)
+		ret = mt7921_mcu_set_rxfilter(dev, 0, 0, 0);
+	if (!ret)
+		fm->scan_context_active = true;
+	return ret;
+}
+
+static int mt7932_scan_batch(struct mt7932_fullmac *fm)
+{
+	struct cfg80211_scan_request *request = fm->scan_request;
+	struct mt76_connac_hw_scan_req *cmd;
+	unsigned int first = fm->scan_next_channel;
+	unsigned int count, i;
+	int ret;
+
+	cmd = kzalloc(sizeof(*cmd), GFP_KERNEL);
+	if (!cmd)
+		return -ENOMEM;
+	count = min_t(unsigned int, request->n_channels - first,
+		      ARRAY_SIZE(cmd->channels) + ARRAY_SIZE(cmd->ext_channels));
+	cmd->seq_num = ++fm->scan_seq & MT7932_SCAN_SEQUENCE_MASK;
+	cmd->bss_idx = MT7932_DISCOVERY_BSS;
+	cmd->version = 1;
+	cmd->scan_type = request->n_ssids ? 1 : 0;
+	cmd->ssid_type = request->n_ssids ? BIT(2) : BIT(0);
+	cmd->ssids_num = request->n_ssids;
+	for (i = 0; i < request->n_ssids; i++) {
+		cmd->ssids[i].ssid_len = cpu_to_le32(request->ssids[i].ssid_len);
+		memcpy(cmd->ssids[i].ssid, request->ssids[i].ssid,
+		       request->ssids[i].ssid_len);
+	}
+	cmd->channel_type = 4; /* Specified channels, including each batch. */
+	cmd->channels_num = min_t(unsigned int, count, ARRAY_SIZE(cmd->channels));
+	cmd->ext_channels_num = count - cmd->channels_num;
+	for (i = 0; i < count; i++) {
+		struct ieee80211_channel *ch = request->channels[first + i];
+		struct mt76_connac_mcu_scan_channel *c = i < ARRAY_SIZE(cmd->channels) ?
+			&cmd->channels[i] : &cmd->ext_channels[i - ARRAY_SIZE(cmd->channels)];
+
+		c->band = ch->band == NL80211_BAND_2GHZ ? MT7932_BAND_2GHZ :
+			  ch->band == NL80211_BAND_5GHZ ? MT7932_BAND_5GHZ :
+							MT7932_BAND_6GHZ;
+		c->channel_num = ch->hw_value;
+	}
+	cmd->channel_dwell_time = cpu_to_le16(MT7932_SCAN_DWELL_MS);
+	cmd->channel_min_dwell_time = cpu_to_le16(MT7932_SCAN_MIN_DWELL_MS);
+	cmd->timeout_value = cpu_to_le16(MT7932_SCAN_FW_TIMEOUT_MS);
+	cmd->ies_len = cpu_to_le16(request->ie_len);
+	if (request->ie_len)
+		memcpy(cmd->ies, request->ie, request->ie_len);
+	ether_addr_copy(cmd->bssid, request->bssid);
+	mt792x_mutex_acquire(fm->dev);
+	ret = mt7932_prepare_discovery(fm);
+	if (!ret)
+		ret = mt76_mcu_send_msg(&fm->dev->mt76,
+			MCU_CE_CMD(START_HW_SCAN), cmd, sizeof(*cmd), false);
+	mt792x_mutex_release(fm->dev);
+	kfree(cmd);
+	if (!ret) {
+		fm->scan_next_channel += count;
+		wiphy_delayed_work_queue(fm->wiphy, &fm->scan_timeout,
+					MT7932_SCAN_TIMEOUT);
+	}
+	return ret;
+}
+
+void mt7932_cfg80211_scan_complete(struct mt7932_fullmac *fm, u8 sequence)
+{
+	lockdep_assert_wiphy(fm->wiphy);
+	if (!fm->scan_request || (sequence & MT7932_SCAN_SEQUENCE_MASK) !=
+	    (fm->scan_seq & MT7932_SCAN_SEQUENCE_MASK))
+		return;
+	wiphy_delayed_work_cancel(fm->wiphy, &fm->scan_timeout);
+	if (fm->scan_next_channel == fm->scan_request->n_channels)
+		mt7932_cfg80211_scan_done(fm, false);
+	else if (mt7932_scan_batch(fm))
+		mt7932_cfg80211_scan_done(fm, true);
+}
+
+static int mt7932_cfg_scan(struct wiphy *wiphy,
+			  struct cfg80211_scan_request *request)
+{
+	struct mt7932_fullmac *fm = mt7932_wiphy_priv(wiphy);
+	int ret;
+
+	if (fm->scan_request || fm->connecting || fm->disconnecting)
+		return -EBUSY;
+	if (READ_ONCE(fm->removing) || fm->dev->fw_assert)
+		return -EIO;
+	if (test_bit(MT76_RESET, &fm->dev->mphy.state))
+		return -EBUSY;
+	if (!request->n_channels || request->n_ssids > MT7932_SCAN_MAX_SSIDS ||
+	    request->ie_len > MT76_CONNAC_SCAN_IE_LEN)
+		return -EINVAL;
+	fm->scan_request = request;
+	fm->scan_next_channel = 0;
+	ret = mt7932_scan_batch(fm);
+	if (ret)
+		fm->scan_request = NULL;
+	return ret;
+}
+
+static int mt7932_cfg_connect(struct wiphy *wiphy, struct net_device *netdev,
+			     struct cfg80211_connect_params *sme)
+{
+	struct mt7932_fullmac *fm = mt7932_wiphy_priv(wiphy);
+	struct mt7932_connect_params *params;
+	struct cfg80211_bss *bss;
+	int ret;
+
+	if (fm->connecting || fm->connected || fm->disconnecting || fm->scan_request)
+		return -EBUSY;
+	if (READ_ONCE(fm->removing) || fm->dev->fw_assert)
+		return -EIO;
+	if (test_bit(MT76_RESET, &fm->dev->mphy.state))
+		return -EBUSY;
+	/* Advertise and accept only the firmware security path verified so far. */
+	if (sme->crypto.n_akm_suites != 1 ||
+	    sme->crypto.akm_suites[0] != WLAN_AKM_SUITE_SAE ||
+	    sme->crypto.n_ciphers_pairwise != 1 ||
+	    sme->crypto.ciphers_pairwise[0] != WLAN_CIPHER_SUITE_CCMP ||
+	    sme->crypto.cipher_group != WLAN_CIPHER_SUITE_CCMP ||
+	    sme->mfp != NL80211_MFP_REQUIRED || !sme->crypto.sae_pwd ||
+	    !sme->crypto.sae_pwd_len || sme->crypto.sae_pwd_len > 64)
+		return -EOPNOTSUPP;
+	if (!sme->ssid_len || sme->ssid_len > IEEE80211_MAX_SSID_LEN)
+		return -EINVAL;
+	bss = cfg80211_get_bss(wiphy, sme->channel, sme->bssid,
+			      sme->ssid, sme->ssid_len, IEEE80211_BSS_TYPE_ESS,
+			      IEEE80211_PRIVACY_ON);
+	if (!bss)
+		return -ENOENT;
+	/* Temporary calibration coverage bound; never substitute another
+	 * frequency's DPD coefficients. General coverage is a separate task.
+	 */
+	if (bss->channel->band != NL80211_BAND_6GHZ ||
+	    bss->channel->hw_value != 5) {
+		ret = -EOPNOTSUPP;
+		goto put_bss;
+	}
+	params = kzalloc(sizeof(*params), GFP_KERNEL);
+	if (!params) {
+		ret = -ENOMEM;
+		goto put_bss;
+	}
+	params->ssid_len = sme->ssid_len;
+	memcpy(params->ssid, sme->ssid, sme->ssid_len);
+	params->password_len = sme->crypto.sae_pwd_len;
+	memcpy(params->password, sme->crypto.sae_pwd, params->password_len);
+	params->band = MT7932_BAND_6GHZ;
+	params->channel = bss->channel->hw_value;
+	ether_addr_copy(params->bssid, bss->bssid);
+	fm->connecting = true;
+	ret = mt7932_offload_connect(fm->dev, params);
+	kfree_sensitive(params);
+	if (ret)
+		fm->connecting = false;
+	else
+		wiphy_delayed_work_queue(wiphy, &fm->connect_timeout,
+					MT7932_CONNECT_TIMEOUT);
+put_bss:
+	cfg80211_put_bss(wiphy, bss);
+	return ret;
+}
+
+static int mt7932_cfg_disconnect(struct wiphy *wiphy, struct net_device *netdev,
+				u16 reason)
+{
+	struct mt7932_fullmac *fm = mt7932_wiphy_priv(wiphy);
+	int ret;
+
+	if (READ_ONCE(fm->removing) || fm->dev->fw_assert)
+		return -EIO;
+	if (test_bit(MT76_RESET, &fm->dev->mphy.state) || fm->disconnecting)
+		return -EBUSY;
+	if (!fm->connected && !fm->connecting)
+		return -ENOTCONN;
+	ret = mt7932_offload_disconnect(fm->dev, fm->bssid);
+	if (ret)
+		return ret;
+	fm->disconnecting = true;
+	fm->disconnect_reason = reason;
+	wiphy_delayed_work_cancel(wiphy, &fm->connect_timeout);
+	wiphy_delayed_work_queue(wiphy, &fm->connect_timeout,
+				MT7932_DISCONNECT_TIMEOUT);
+	return 0;
+}
+
+static int mt7932_cfg_get_station(struct wiphy *wiphy, struct wireless_dev *wdev,
+				  const u8 *mac, struct station_info *sinfo)
+{
+	struct mt7932_fullmac *fm = mt7932_wiphy_priv(wiphy);
+	const struct rtnl_link_stats64 *stats;
+	struct rtnl_link_stats64 storage;
+
+	if (!fm->connected || !ether_addr_equal(mac, fm->bssid))
+		return -ENOENT;
+	stats = dev_get_stats(fm->netdev, &storage);
+	sinfo->rx_bytes = stats->rx_bytes - fm->station_start_stats.rx_bytes;
+	sinfo->tx_bytes = stats->tx_bytes - fm->station_start_stats.tx_bytes;
+	sinfo->rx_packets = stats->rx_packets - fm->station_start_stats.rx_packets;
+	sinfo->tx_packets = stats->tx_packets - fm->station_start_stats.tx_packets;
+	sinfo->connected_time = (jiffies - fm->connected_at) / HZ;
+	sinfo->inactive_time = jiffies_to_msecs(jiffies - READ_ONCE(fm->last_activity));
+	sinfo->sta_flags.mask = BIT(NL80211_STA_FLAG_AUTHENTICATED) |
+				BIT(NL80211_STA_FLAG_ASSOCIATED) |
+				BIT(NL80211_STA_FLAG_AUTHORIZED);
+	sinfo->sta_flags.set = sinfo->sta_flags.mask;
+	sinfo->filled = BIT_ULL(NL80211_STA_INFO_RX_BYTES64) |
+			BIT_ULL(NL80211_STA_INFO_TX_BYTES64) |
+			BIT_ULL(NL80211_STA_INFO_RX_PACKETS) |
+			BIT_ULL(NL80211_STA_INFO_TX_PACKETS) |
+			BIT_ULL(NL80211_STA_INFO_CONNECTED_TIME) |
+			BIT_ULL(NL80211_STA_INFO_INACTIVE_TIME) |
+			BIT_ULL(NL80211_STA_INFO_STA_FLAGS);
+	if (READ_ONCE(fm->signal_valid)) {
+		sinfo->signal = READ_ONCE(fm->last_signal);
+		sinfo->filled |= BIT_ULL(NL80211_STA_INFO_SIGNAL);
+	}
+	/* No invented rate, retry, ACK-failure or RF measurements. */
+	return 0;
+}
+
+static int mt7932_cfg_dump_station(struct wiphy *wiphy, struct wireless_dev *wdev,
+				   int index, u8 *mac, struct station_info *sinfo)
+{
+	struct mt7932_fullmac *fm = mt7932_wiphy_priv(wiphy);
+
+	if (index || !fm->connected)
+		return -ENOENT;
+	ether_addr_copy(mac, fm->bssid);
+	return mt7932_cfg_get_station(wiphy, wdev, mac, sinfo);
+}
+
+static void mt7932_cfg_regulatory(struct wiphy *wiphy,
+				  struct regulatory_request *request)
+{
+	struct mt7932_fullmac *fm = mt7932_wiphy_priv(wiphy);
+	struct mt792x_dev *dev = fm->dev;
+	int ret;
+
+	memcpy(dev->mt76.alpha2, request->alpha2, sizeof(dev->mt76.alpha2));
+	dev->mt76.region = request->dfs_region;
+	dev->country_ie_env = request->country_ie_env;
+	dev->regd_change = true;
+	if (READ_ONCE(fm->removing) || dev->fw_assert || dev->pm.suspended ||
+	    test_bit(MT76_RESET, &dev->mphy.state))
+		return;
+	/* Preserve the complete domain AND transmit-power/SAR programming
+	 * previously supplied by the mac80211 regulatory notifier.
+	 */
+	ret = mt7921_mcu_regd_update(dev, dev->mt76.alpha2,
+				    dev->country_ie_env);
+	if (ret) {
+		wiphy_err(wiphy, "regulatory %.2s update failed: %d\n",
+			  request->alpha2, ret);
+		return;
+	}
+	wiphy_info(wiphy, "regulatory %.2s region %u applied\n",
+		   request->alpha2, request->dfs_region);
+}
+
+static const struct cfg80211_ops mt7932_cfg80211_ops = {
+	.scan = mt7932_cfg_scan,
+	.abort_scan = mt7932_cfg_abort_scan,
+	.connect = mt7932_cfg_connect,
+	.disconnect = mt7932_cfg_disconnect,
+	.get_station = mt7932_cfg_get_station,
+	.dump_station = mt7932_cfg_dump_station,
+};
+
+int mt7932_cfg80211_register(struct mt7932_fullmac *fm)
+{
+	static const u32 ciphers[] = { WLAN_CIPHER_SUITE_CCMP,
+				       WLAN_CIPHER_SUITE_AES_CMAC };
+	static const u32 akms[] = { WLAN_AKM_SUITE_SAE };
+	struct wiphy *wiphy;
+	int i, ret;
+
+	wiphy = wiphy_new(&mt7932_cfg80211_ops, sizeof(fm));
+	if (!wiphy)
+		return -ENOMEM;
+	fm->wiphy = wiphy;
+	*(struct mt7932_fullmac **)wiphy_priv(wiphy) = fm;
+	set_wiphy_dev(wiphy, fm->dev->mt76.dev);
+	wiphy->interface_modes = BIT(NL80211_IFTYPE_STATION);
+	wiphy->signal_type = CFG80211_SIGNAL_TYPE_MBM;
+	wiphy->max_scan_ssids = MT7932_SCAN_MAX_SSIDS;
+	wiphy->max_scan_ie_len = MT76_CONNAC_SCAN_IE_LEN;
+	wiphy->cipher_suites = ciphers;
+	wiphy->n_cipher_suites = ARRAY_SIZE(ciphers);
+	wiphy->akm_suites = akms;
+	wiphy->n_akm_suites = ARRAY_SIZE(akms);
+	wiphy->reg_notifier = mt7932_cfg_regulatory;
+	ether_addr_copy(wiphy->perm_addr, fm->dev->mphy.macaddr);
+	wiphy_ext_feature_set(wiphy, NL80211_EXT_FEATURE_SAE_OFFLOAD);
+	for (i = 0; i < NUM_NL80211_BANDS; i++)
+		wiphy->bands[i] = fm->dev->mphy.hw->wiphy->bands[i];
+	wiphy_delayed_work_init(&fm->scan_timeout, mt7932_scan_timeout);
+	wiphy_delayed_work_init(&fm->connect_timeout, mt7932_connect_timeout);
+	ret = wiphy_register(wiphy);
+	if (ret)
+		goto free_wiphy;
+	fm->wdev.wiphy = wiphy;
+	fm->wdev.iftype = NL80211_IFTYPE_STATION;
+	fm->wdev.netdev = fm->netdev;
+	fm->netdev->ieee80211_ptr = &fm->wdev;
+	strscpy(fm->netdev->name, "wlan%d", IFNAMSIZ);
+	ret = register_netdev(fm->netdev);
+	if (!ret) {
+		mt7932_diag_init(fm->dev, wiphy->debugfsdir);
+		return 0;
+	}
+	wiphy_unregister(wiphy);
+free_wiphy:
+	wiphy_free(wiphy);
+	fm->wiphy = NULL;
+	return ret;
+}
+
+void mt7932_cfg80211_unregister(struct mt7932_fullmac *fm)
+{
+	unregister_netdev(fm->netdev);
+	wiphy_lock(fm->wiphy);
+	mt7932_cfg80211_scan_done(fm, true);
+	mt7932_cfg80211_disconnected(fm, WLAN_REASON_DEAUTH_LEAVING);
+	wiphy_delayed_work_cancel(fm->wiphy, &fm->scan_timeout);
+	wiphy_delayed_work_cancel(fm->wiphy, &fm->connect_timeout);
+	wiphy_unlock(fm->wiphy);
+	wiphy_unregister(fm->wiphy);
+	wiphy_free(fm->wiphy);
+}
diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_fullmac.c b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_fullmac.c
new file mode 100644
index 0000000000000..ec94e75f32617
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_fullmac.c
@@ -0,0 +1,462 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Native MT7932 Ethernet transport. cfg80211 control is under bring-up. */
+#include <linux/etherdevice.h>
+#include <linux/unaligned.h>
+#include "mt7921.h"
+#include "mt7932_offload.h"
+#include "../mt76_connac2_mac.h"
+
+#include "mt7932_fullmac.h"
+#include "mt7932_mcu.h"
+
+#define MT7932_EVENT_QUEUE_MAX 64
+#define MT7932_TX_RESERVE 8
+
+static void mt7932_fullmac_event_work(struct wiphy *wiphy, struct wiphy_work *work)
+{
+	struct mt7932_fullmac *fm = container_of(work, struct mt7932_fullmac, event_work);
+	struct sk_buff *skb;
+
+	if (READ_ONCE(fm->removing)) {
+		skb_queue_purge(&fm->events);
+		return;
+	}
+	if (xchg(&fm->reset_pending, false)) {
+		mt7932_cfg80211_scan_done(fm, true);
+		mt7932_cfg80211_disconnected(fm, WLAN_REASON_UNSPECIFIED);
+		skb_queue_purge(&fm->events);
+	}
+	while ((skb = skb_dequeue(&fm->events))) {
+		const struct mt76_connac2_mcu_rxd *rxd = (void *)skb->data;
+		const struct mt7932_mlme_event *event = (void *)rxd->tlv;
+		const u8 *p = rxd->tlv;
+		size_t plen = skb->len - sizeof(*rxd);
+		u8 eid = rxd->eid;
+		u32 type, len;
+		int ret = 0;
+
+		if (fm->dev->fw_assert) {
+			mt7932_cfg80211_scan_done(fm, true);
+			mt7932_cfg80211_disconnected(fm, WLAN_REASON_UNSPECIFIED);
+			goto next;
+		}
+		if (eid == MCU_EVENT_SCAN_DONE) {
+			if (plen)
+				mt7932_cfg80211_scan_complete(fm, p[0]);
+			goto next;
+		}
+		if (eid == MT7932_EVENT_PRECAL_REQUEST) {
+			ret = mt7932_precal_request(fm->dev, fm->cal, p, plen);
+			goto result;
+		}
+		if ((eid != MT7932_EVENT_MLME && eid != MT7932_EVENT_MLME_ALT) ||
+		    plen < sizeof(*event) || le32_to_cpu(event->unknown_0))
+			goto next;
+		type = le32_to_cpu(event->type);
+		len = le32_to_cpu(event->len);
+		if (len > plen - sizeof(*event))
+			goto next;
+		p = event->data;
+		switch (type) {
+		case MT7932_MLME_CONNECTING: {
+			const struct mt7932_mlme_connecting *connecting = (void *)p;
+			enum nl80211_band band;
+
+			if (!fm->connecting || len < sizeof(*connecting) ||
+			    !ether_addr_equal(connecting->bssid, fm->bssid) ||
+			    connecting->band < MT7932_BAND_2GHZ ||
+			    connecting->band > MT7932_BAND_6GHZ)
+				break;
+			fm->cal_band = connecting->band;
+			band = connecting->band == MT7932_BAND_2GHZ ? NL80211_BAND_2GHZ :
+			       connecting->band == MT7932_BAND_5GHZ ? NL80211_BAND_5GHZ :
+								     NL80211_BAND_6GHZ;
+			fm->cal_center_khz = ieee80211_channel_to_frequency(
+				connecting->center_channel, band) * 1000;
+			fm->active = true;
+			ret = mt7932_precal_preload(fm->dev, fm->cal, fm->cal_band);
+			break;
+		}
+		case MT7932_MLME_ASSOCIATED: {
+			const struct mt7932_mlme_associated *associated = (void *)p;
+
+			if (!fm->connecting || len < sizeof(*associated) ||
+			    !ether_addr_equal(associated->bssid, fm->bssid))
+				break;
+			if (le32_to_cpu(associated->status) ||
+			    associated->peer_wcid >= MT7932_PEER_WCID_LIMIT) {
+				mt7932_cfg80211_disconnected(fm, WLAN_REASON_UNSPECIFIED);
+				break;
+			}
+			fm->peer_wcid = associated->peer_wcid;
+			break;
+		}
+		case MT7932_MLME_AUTHORIZED: {
+			const struct mt7932_mlme_authorized *authorized = (void *)p;
+
+			if (!fm->connecting || len < sizeof(*authorized) ||
+			    fm->peer_wcid >= MT7932_PEER_WCID_LIMIT ||
+			    !ether_addr_equal(authorized->bssid, fm->bssid))
+				break;
+			if (le32_to_cpu(authorized->status)) {
+				mt7932_cfg80211_disconnected(fm, WLAN_REASON_UNSPECIFIED);
+				break;
+			}
+			ret = mt7932_precal_apply(fm->dev, fm->cal,
+						 fm->cal_band, fm->cal_center_khz);
+			if (!ret) {
+				fm->cal_applied = true;
+				mt7932_cfg80211_connected(fm);
+			}
+			break;
+		}
+		case MT7932_MLME_DISCONNECTED:
+			mt7932_cfg80211_disconnected(fm, WLAN_REASON_UNSPECIFIED);
+			break;
+		}
+result:
+		if (ret) {
+			wiphy_warn(fm->wiphy, "firmware event %#x failed: %d\n", eid, ret);
+			mt7932_cfg80211_disconnected(fm, WLAN_REASON_UNSPECIFIED);
+		}
+next:
+		dev_kfree_skb(skb);
+	}
+}
+
+void mt7932_fullmac_connecting(struct mt792x_dev *dev, const u8 *bssid)
+{
+	struct mt7932_fullmac *fm = READ_ONCE(dev->fullmac);
+
+	if (fm) {
+		netif_carrier_off(fm->netdev);
+		WRITE_ONCE(fm->peer_wcid, MT7932_NO_WCID);
+		WRITE_ONCE(fm->cal_applied, false);
+		WRITE_ONCE(fm->cal_band, 0);
+		WRITE_ONCE(fm->cal_center_khz, 0);
+		ether_addr_copy(fm->bssid, bssid);
+		/* Discovery management frames must reach the existing RX path. */
+		WRITE_ONCE(fm->active, false);
+	}
+}
+
+void mt7932_fullmac_reset(struct mt792x_dev *dev)
+{
+	struct mt7932_fullmac *fm = READ_ONCE(dev->fullmac);
+
+	if (!fm || READ_ONCE(fm->removing))
+		return;
+	netif_carrier_off(fm->netdev);
+	WRITE_ONCE(fm->active, false);
+	WRITE_ONCE(fm->peer_wcid, MT7932_NO_WCID);
+	WRITE_ONCE(fm->cal_applied, false);
+	WRITE_ONCE(fm->scan_context_active, false);
+	WRITE_ONCE(fm->cal_band, 0);
+	WRITE_ONCE(fm->cal_center_khz, 0);
+	WRITE_ONCE(fm->reset_pending, true);
+	wiphy_work_queue(fm->wiphy, &fm->event_work);
+}
+
+void mt7932_fullmac_reset_prepare(struct mt792x_dev *dev)
+{
+	struct mt7932_fullmac *fm = READ_ONCE(dev->fullmac);
+
+	if (!fm || READ_ONCE(fm->removing))
+		return;
+	netif_tx_disable(fm->netdev);
+	mt7932_fullmac_reset(dev);
+}
+
+/* Called with the MCU mutex held after firmware reload. Restore both domain
+ * and the existing conservative SAR/power programming before any new scan or
+ * transmission. The firmware lost RLM state even if Linux kept its chandef.
+ */
+int mt7932_fullmac_reinit(struct mt792x_dev *dev)
+{
+	int ret;
+
+	ret = mt76_connac_mcu_set_channel_domain(&dev->mphy);
+	if (!ret)
+		ret = mt7921_set_tx_sar_pwr(dev->mphy.hw, NULL);
+	if (!ret && dev->mphy.chandef.chan)
+		ret = mt7932_set_channel(&dev->phy, MT7932_AIS_BSS);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt7932_fullmac_reinit);
+
+void mt7932_fullmac_reset_done(struct mt792x_dev *dev, int error)
+{
+	struct mt7932_fullmac *fm = READ_ONCE(dev->fullmac);
+
+	if (!fm || READ_ONCE(fm->removing))
+		return;
+	if (error)
+		dev->fw_assert = true;
+	else if (netif_running(fm->netdev))
+		netif_wake_queue(fm->netdev);
+	dev_info(dev->mt76.dev, "MT7932 firmware recovery completed: %d\n", error);
+}
+
+int mt7932_fullmac_preload(struct mt792x_dev *dev, u8 band)
+{
+	struct mt7932_fullmac *fm = READ_ONCE(dev->fullmac);
+
+	return fm ? mt7932_precal_preload(dev, fm->cal, band) : -ENODEV;
+}
+
+static int mt7932_native_open(struct net_device *netdev)
+{
+	netif_start_queue(netdev);
+	return 0;
+}
+
+static int mt7932_native_stop(struct net_device *netdev)
+{
+	netif_stop_queue(netdev);
+	return 0;
+}
+
+static netdev_tx_t mt7932_native_tx(struct sk_buff *skb,
+				 struct net_device *netdev)
+{
+	struct mt7932_fullmac *fm = *(void **)netdev_priv(netdev);
+	struct mt76_phy *phy = &fm->dev->mphy;
+	struct mt76_dev *mdev = &fm->dev->mt76;
+	struct mt76_queue *q = phy->q_tx[MT_TXQ_BE];
+	unsigned int bytes = skb->len;
+	int ret;
+
+	if (!netif_carrier_ok(netdev) || skb_linearize(skb)) {
+		netdev->stats.tx_dropped++;
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+	memset(skb->cb, 0, sizeof(skb->cb));
+	IEEE80211_SKB_CB(skb)->flags = IEEE80211_TX_CTL_HW_80211_ENCAP;
+	skb_set_queue_mapping(skb, 0);
+	spin_lock_bh(&q->lock);
+	if (q->queued >= q->ndesc - MT7932_TX_RESERVE ||
+	    mdev->token_count >= mdev->token_size - MT7932_TX_RESERVE) {
+		spin_unlock_bh(&q->lock);
+		return NETDEV_TX_BUSY;
+	}
+	ret = mdev->queue_ops->tx_queue_skb(phy, q, MT_TXQ_BE, skb, NULL, NULL);
+	if (ret >= 0)
+		mdev->queue_ops->kick(mdev, q);
+	spin_unlock_bh(&q->lock);
+	if (ret >= 0) {
+		netdev->stats.tx_packets++;
+		netdev->stats.tx_bytes += bytes;
+		WRITE_ONCE(fm->last_activity, jiffies);
+	} else {
+		netdev->stats.tx_errors++;
+	}
+	return NETDEV_TX_OK;
+}
+
+static const struct net_device_ops mt7932_native_ops = {
+	.ndo_open = mt7932_native_open,
+	.ndo_stop = mt7932_native_stop,
+	.ndo_start_xmit = mt7932_native_tx,
+	.ndo_validate_addr = eth_validate_addr,
+};
+
+int mt7932_fullmac_init(struct mt792x_dev *dev)
+{
+	struct mt7932_fullmac *fm;
+	struct net_device *netdev;
+	int ret;
+
+	fm = kzalloc(sizeof(*fm), GFP_KERNEL);
+	if (!fm)
+		return -ENOMEM;
+	netdev = alloc_etherdev(sizeof(fm));
+	if (!netdev) {
+		kfree(fm);
+		return -ENOMEM;
+	}
+	fm->dev = dev;
+	fm->netdev = netdev;
+	wiphy_work_init(&fm->event_work, mt7932_fullmac_event_work);
+	skb_queue_head_init(&fm->events);
+	ret = mt7932_precal_load(dev, &fm->cal);
+	if (ret) {
+		free_netdev(netdev);
+		kfree(fm);
+		return ret;
+	}
+	/* Assigned from the firmware association event before authorizing TX. */
+	fm->peer_wcid = MT7932_NO_WCID;
+	*(void **)netdev_priv(netdev) = fm;
+	strscpy(netdev->name, "wlan%d", IFNAMSIZ);
+	netdev->netdev_ops = &mt7932_native_ops;
+	SET_NETDEV_DEV(netdev, dev->mt76.dev);
+	eth_hw_addr_set(netdev, dev->mphy.macaddr);
+	netif_carrier_off(netdev);
+	WRITE_ONCE(dev->fullmac, fm);
+	ret = mt7932_cfg80211_register(fm);
+	if (ret) {
+		WRITE_ONCE(dev->fullmac, NULL);
+		free_netdev(netdev);
+		kfree(fm);
+		return ret;
+	}
+	dev_info(dev->mt76.dev, "MT7932 cfg80211 station interface %s\n",
+		 netdev->name);
+	return 0;
+}
+
+bool mt7932_fullmac_is_tx(struct mt792x_dev *dev, struct sk_buff *skb)
+{
+	struct mt7932_fullmac *fm = READ_ONCE(dev->fullmac);
+
+	return fm && skb && skb->dev == fm->netdev;
+}
+EXPORT_SYMBOL_GPL(mt7932_fullmac_is_tx);
+
+void mt7932_fullmac_txwi(struct mt792x_dev *dev, __le32 *txwi,
+			struct sk_buff *skb)
+{
+	struct mt76_wcid wcid = { .idx = dev->fullmac->peer_wcid };
+
+	mt76_connac2_mac_write_txwi(&dev->mt76, txwi, skb, &wcid,
+				  NULL, 0, MT_TXQ_BE, 0);
+	/* Firmware installed the pairwise key; hardware supplies PN and sequence. */
+	txwi[3] |= cpu_to_le32(MT_TXD3_PROTECT_FRAME);
+}
+EXPORT_SYMBOL_GPL(mt7932_fullmac_txwi);
+
+bool mt7932_fullmac_tx_free(struct mt792x_dev *dev, struct mt76_txwi_cache *t)
+{
+	if (!mt7932_fullmac_is_tx(dev, t->skb))
+		return false;
+	mt76_connac_txp_skb_unmap(&dev->mt76, t);
+	dev_consume_skb_any(t->skb);
+	t->skb = NULL;
+	mt76_put_txwi(&dev->mt76, t);
+	return true;
+}
+
+void mt7932_fullmac_quiesce(struct mt792x_dev *dev)
+{
+	struct mt7932_fullmac *fm = READ_ONCE(dev->fullmac);
+
+	if (!fm)
+		return;
+	wiphy_lock(fm->wiphy);
+	WRITE_ONCE(fm->removing, true);
+	netif_tx_disable(fm->netdev);
+	wiphy_work_cancel(fm->wiphy, &fm->event_work);
+	wiphy_delayed_work_cancel(fm->wiphy, &fm->scan_timeout);
+	wiphy_delayed_work_cancel(fm->wiphy, &fm->connect_timeout);
+	mt7932_cfg80211_scan_done(fm, true);
+	mt7932_cfg80211_disconnected(fm, WLAN_REASON_DEAUTH_LEAVING);
+	skb_queue_purge(&fm->events);
+	wiphy_unlock(fm->wiphy);
+}
+EXPORT_SYMBOL_GPL(mt7932_fullmac_quiesce);
+
+/* Caller has stopped native TX and quiesced DMA/NAPI. The common token
+ * teardown unmaps each TXP exactly once. Only detach Ethernet SKBs here,
+ * so it cannot send their completions to an unregistered mac80211 device.
+ */
+void mt7932_fullmac_tx_purge(struct mt792x_dev *dev)
+{
+	struct mt76_txwi_cache *t;
+	int id;
+
+	spin_lock_bh(&dev->mt76.token_lock);
+	idr_for_each_entry(&dev->mt76.token, t, id) {
+		if (!mt7932_fullmac_is_tx(dev, t->skb))
+			continue;
+		dev_kfree_skb_any(t->skb);
+		t->skb = NULL;
+	}
+	spin_unlock_bh(&dev->mt76.token_lock);
+}
+EXPORT_SYMBOL_GPL(mt7932_fullmac_tx_purge);
+
+void mt7932_fullmac_remove(struct mt792x_dev *dev)
+{
+	struct mt7932_fullmac *fm = READ_ONCE(dev->fullmac);
+
+	if (!fm)
+		return;
+	mt7932_fullmac_quiesce(dev);
+	mt7932_cfg80211_unregister(fm);
+	mt7932_fullmac_tx_purge(dev);
+	mt76_wcid_cleanup(&dev->mt76, &dev->mt76.global_wcid);
+	WRITE_ONCE(dev->fullmac, NULL);
+	synchronize_net();
+	free_netdev(fm->netdev);
+	kfree(fm);
+}
+EXPORT_SYMBOL_GPL(mt7932_fullmac_remove);
+
+void mt7932_fullmac_event(struct mt792x_dev *dev, struct sk_buff *skb)
+{
+	struct mt7932_fullmac *fm = READ_ONCE(dev->fullmac);
+	struct sk_buff *copy;
+
+	if (!fm || !fm->wiphy || READ_ONCE(fm->removing) ||
+	    skb->len < sizeof(struct mt76_connac2_mcu_rxd) ||
+	    skb_queue_len(&fm->events) >= MT7932_EVENT_QUEUE_MAX)
+		return;
+	copy = skb_copy(skb, GFP_ATOMIC);
+	if (!copy)
+		return;
+	skb_queue_tail(&fm->events, copy);
+	wiphy_work_queue(fm->wiphy, &fm->event_work);
+}
+
+bool mt7932_fullmac_rx(struct mt792x_dev *dev, struct sk_buff *skb)
+{
+	struct mt7932_fullmac *fm = READ_ONCE(dev->fullmac);
+	struct mt76_rx_status *status = (void *)skb->cb;
+	unsigned int bytes;
+
+	/* Firmware-owned Ethernet goes to the station netdev. Management RX is
+	 * reported through cfg80211, including scans while associated.
+	 */
+	if (!fm)
+		return false;
+	if (!(status->flag & RX_FLAG_8023)) {
+		struct ieee80211_mgmt *mgmt = (void *)skb->data;
+		struct ieee80211_channel *channel;
+		struct cfg80211_bss *bss;
+
+		if (skb->len >= offsetof(struct ieee80211_mgmt, u.beacon.variable) &&
+		    (ieee80211_is_beacon(mgmt->frame_control) ||
+		     ieee80211_is_probe_resp(mgmt->frame_control)) &&
+		    !(status->flag & (RX_FLAG_ONLY_MONITOR | RX_FLAG_FAILED_FCS_CRC))) {
+			channel = ieee80211_get_channel(fm->wiphy, status->freq);
+			if (channel) {
+				bss = cfg80211_inform_bss_frame(fm->wiphy, channel,
+					mgmt, skb->len, status->signal * 100, GFP_ATOMIC);
+				cfg80211_put_bss(fm->wiphy, bss);
+			}
+		}
+		dev_kfree_skb(skb);
+		return true;
+	}
+	if (!READ_ONCE(fm->connected) || skb->len < ETH_HLEN ||
+	    !netif_running(fm->netdev) ||
+	    status->flag & (RX_FLAG_ONLY_MONITOR | RX_FLAG_FAILED_FCS_CRC)) {
+		dev_kfree_skb(skb);
+		return true;
+	}
+	WRITE_ONCE(fm->last_activity, jiffies);
+	if (status->chains && status->signal < 0 && status->signal > S8_MIN) {
+		WRITE_ONCE(fm->last_signal, status->signal);
+		WRITE_ONCE(fm->signal_valid, true);
+	}
+	bytes = skb->len;
+	skb->dev = fm->netdev;
+	memset(skb->cb, 0, sizeof(skb->cb));
+	skb->ip_summed = CHECKSUM_NONE;
+	skb->protocol = eth_type_trans(skb, fm->netdev);
+	fm->netdev->stats.rx_packets++;
+	fm->netdev->stats.rx_bytes += bytes;
+	netif_rx(skb);
+	return true;
+}
diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_fullmac.h b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_fullmac.h
