@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __MT7932_OFFLOAD_H
+#define __MT7932_OFFLOAD_H
+
+/* Host configuration, not the firmware's connection command. No cached keys. */
+struct mt7932_connect_params {
+	u8 ssid_len;
+	u8 password_len;
+	u8 band;
+	u8 channel;
+	u8 bssid[ETH_ALEN];
+	u8 ssid[IEEE80211_MAX_SSID_LEN];
+	u8 password[64];
+};
+
+struct mt7932_cal_cache;
+int mt7932_offload_disconnect(struct mt792x_dev *dev, const u8 *bssid);
+
+int mt7932_offload_connect(struct mt792x_dev *dev,
+			   const struct mt7932_connect_params *params);
+int mt7932_precal_load(struct mt792x_dev *dev, struct mt7932_cal_cache **out);
+int mt7932_precal_preload(struct mt792x_dev *dev, struct mt7932_cal_cache *cache,
+			   u8 band);
+int mt7932_precal_apply(struct mt792x_dev *dev, struct mt7932_cal_cache *cache,
+			 u8 band, u32 center_khz);
+int mt7932_precal_request(struct mt792x_dev *dev, struct mt7932_cal_cache *cache,
+			   const u8 *request, size_t len);
+void mt7932_fullmac_connecting(struct mt792x_dev *dev, const u8 *bssid);
+int mt7932_fullmac_preload(struct mt792x_dev *dev, u8 band);
+void mt7932_fullmac_reset(struct mt792x_dev *dev);
+#endif
diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_regs.h b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_regs.h
new file mode 100644
index 0000000000000..b494690eb72d9
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_regs.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __MT7932_REGS_H
+#define __MT7932_REGS_H
+
+/* All offsets below are PCI BAR0 offsets, not SoC physical addresses. */
+#define MT7932_BAR_SIZE			SZ_1M
+#define MT7932_CHIP_ID			0x7932
+#define MT7932_HW_REV			0xb1000
+#define MT7932_HW_REV_MASK		GENMASK(7, 0)
+#define MT7932_REMAP_WINDOW_SIZE		SZ_64K
+#define MT7932_WF_REMAP_PHYS		0x70000000
+#define MT7932_WF_REMAP_BAR		0x70000
+#define MT7932_CONN_REMAP_PHYS		0x18050000
+#define MT7932_CONN_REMAP_ALIAS		0x7c050000
+#define MT7932_CONN_REMAP_BAR		0x90000
+
+#define MT7932_PCIE_REMAP(_n)		(0xfe24c + 4 * (_n))
+#define MT7932_PCIE_REMAP_TARGET		GENMASK(31, 16)
+/* Low halves are observed remap controls, not decoded address bits. */
+#define MT7932_PCIE_REMAP_WF_CONTROL	0x1846
+#define MT7932_PCIE_REMAP_CONN_CONTROL	0x1848
+#define MT7932_PCIE_REMAP_BOOT		0x18451807
+#define MT7932_PCIE_REMAP_RUNTIME		0x1845184f
+#define MT7932_PCIE_REMAP_SETTLE_US	2
+
+#define MT7932_SECURE_READY		0x40060
+#define MT7932_SECURE_READY_BIT		BIT(0)
+#define MT7932_SECURE_COMPLETE		0x40260
+#define MT7932_SECURE_COMPLETE_BIT	BIT(0)
+
+/* Observed shared-buffer publication sequence. Detailed buffer ownership,
+ * enable-bit meanings and descriptor formats remain unresolved. Keep the
+ * native order; do not describe these as ordinary WFDMA rings.
+ */
+#define MT7932_HOST_DMA_CONTROL0		0x93c28
+#define MT7932_HOST_DMA_CONTROL0_INIT	BIT(0)
+#define MT7932_HOST_DMA_CONTROL1		0x93a38
+#define MT7932_HOST_DMA_CONTROL1_INIT	BIT(1)
+#define MT7932_HOST_DMA_ADDR0		0x93a3c
+#define MT7932_HOST_DMA_ADDR1		0x93a30
+#define MT7932_HOST_DMA_ADDR2		0x93a54
+
+/* PCI configuration space, unlike the BAR0 offsets above. */
+#define MT7932_PCIE_FW_STATE		0x48c
+#define MT7932_PCIE_FW_STATE_MASK		GENMASK(19, 16)
+#define MT7932_PCIE_FW_STATE_READY	2
+
+#endif
diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/pci.c b/drivers/net/wireless/mediatek/mt76/mt7921/pci.c
index 56a914aaa81ea..6de8d486eab0f 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7921/pci.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/pci.c
@@ -9,12 +9,15 @@
 #include <linux/of.h>
 
 #include "mt7921.h"
+#include "mt7932_regs.h"
 #include "../mt76_connac2_mac.h"
 #include "../dma.h"
 #include "mcu.h"
 #include "regd.h"
 
 static const struct pci_device_id mt7921_pci_device_table[] = {
+	{ PCI_DEVICE(PCI_VENDOR_ID_MEDIATEK, MT7932_CHIP_ID),
+		.driver_data = (kernel_ulong_t)MT7932_FIRMWARE_WM },
 	{ PCI_DEVICE(PCI_VENDOR_ID_MEDIATEK, 0x7961),
 		.driver_data = (kernel_ulong_t)MT7921_FIRMWARE_WM },
 	{ PCI_DEVICE(PCI_VENDOR_ID_MEDIATEK, 0x7922),
@@ -51,12 +54,22 @@ static void mt7921e_unregister_device(struct mt792x_dev *dev)
 		wiphy_rfkill_stop_polling(hw->wiphy);
 
 	cancel_work_sync(&dev->init_work);
+	if (is_mt7932(&dev->mt76)) {
+		/* Stop accepting recovery requests before quiescing NAPI/DMA. */
+		dev->hw_init_done = false;
+		mt7932_fullmac_quiesce(dev);
+		cancel_work_sync(&dev->reset_work);
+	}
 	mt76_unregister_device(&dev->mt76);
 	mt76_for_each_q_rx(&dev->mt76, i)
 		napi_disable(&dev->mt76.napi[i]);
 	cancel_delayed_work_sync(&pm->ps_work);
 	cancel_work_sync(&pm->wake_work);
 	cancel_work_sync(&dev->reset_work);
+	if (is_mt7932(&dev->mt76)) {
+		mt792x_dma_disable(dev, true);
+		mt7932_fullmac_remove(dev);
+	}
 
