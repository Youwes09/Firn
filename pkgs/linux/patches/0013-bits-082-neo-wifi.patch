+// SPDX-License-Identifier: GPL-2.0-only
+/* MT7932 CONNAC2 boot transport, based on documented hardware behavior. */
+#include <linux/firmware.h>
+#include <linux/debugfs.h>
+#include <linux/ktime.h>
+#include <linux/pci.h>
+#include <linux/unaligned.h>
