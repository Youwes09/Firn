index 0000000000000..0d653906ece50
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_fullmac.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __MT7932_FULLMAC_H
+#define __MT7932_FULLMAC_H
+
+struct mt7932_fullmac {
+	struct mt792x_dev *dev;
+	struct net_device *netdev;
+	struct wiphy *wiphy;
+	struct wireless_dev wdev;
+	struct cfg80211_scan_request *scan_request;
+	unsigned int scan_next_channel;
+	struct wiphy_delayed_work scan_timeout;
+	struct wiphy_delayed_work connect_timeout;
+	bool connecting, connected, disconnecting, active, scan_context_active;
+	bool reset_pending, removing;
+	bool signal_valid;
+	s8 last_signal;
+	unsigned long connected_at, last_activity;
+	struct rtnl_link_stats64 station_start_stats;
+	u16 disconnect_reason;
+	u8 scan_seq, peer_wcid, cal_band;
+	u32 cal_center_khz;
+	bool cal_applied;
+	u8 bssid[ETH_ALEN];
+	struct mt7932_cal_cache *cal;
+	struct sk_buff_head events;
+	struct wiphy_work event_work;
+};
+
+int mt7932_cfg80211_register(struct mt7932_fullmac *fm);
+void mt7932_cfg80211_unregister(struct mt7932_fullmac *fm);
+void mt7932_cfg80211_scan_done(struct mt7932_fullmac *fm, bool aborted);
+void mt7932_cfg80211_scan_complete(struct mt7932_fullmac *fm, u8 sequence);
+void mt7932_cfg80211_connected(struct mt7932_fullmac *fm);
+void mt7932_cfg80211_disconnected(struct mt7932_fullmac *fm, u16 reason);
+#endif
diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_mcu.h b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_mcu.h
new file mode 100644
index 0000000000000..f19925c927b35
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_mcu.h
@@ -0,0 +1,373 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __MT7932_MCU_H
+#define __MT7932_MCU_H
+
+/* Private, observed MT7932 ABI. Evidence and unresolved fields are in
+ * Documentation/networking/device_drivers/wifi/mt7932-abi.txt. These are legacy
+ * flat command IDs, not CONNAC UNI commands with coincidentally equal IDs.
+ */
+enum mt7932_mcu_command {
+	MT7932_CMD_BASIC_CONFIG = 0x02,
+	MT7932_CMD_ADD_REMOVE_KEY = 0x07,
+	MT7932_CMD_ACTIVATE_BSS = 0x11,
+	MT7932_CMD_SET_BSS = 0x12,
+	MT7932_CMD_SET_STA = 0x13,
+	MT7932_CMD_REMOVE_STA = 0x14,
+	MT7932_CMD_SET_RLM = 0x19,
+	MT7932_CMD_DBDC = 0x28,
+	MT7932_CMD_QUEUE_MANAGEMENT = 0x6b,
+	MT7932_CMD_CUSTOMER_CONFIG = 0x70,
+	MT7932_CMD_RUNTIME_93 = 0x93, /* Meaning not established on this ABI. */
+	MT7932_CMD_PROBE_PRIVACY = 0x9b,
+	MT7932_CMD_BEACON_PARSE = 0xaf,
+	MT7932_CMD_AIS_MAC = 0xb8,
+	MT7932_CMD_CAL_PROFILE = 0xbf,
+	MT7932_CMD_PRECAL = 0xd6,
+	MT7932_CMD_CAL_D7 = 0xd7,
+	MT7932_CMD_RTS = 0xdc,
+	MT7932_CMD_SME_CONNECT = 0x40ea,
+	MT7932_CMD_SME_DISCONNECT = 0x42ea,
+	MT7932_CMD_SME_DHCP_RELEASE = 0x47ea,
+	MT7932_CMD_SME_CONFIG = 0x4eea,
+	MT7932_CMD_SME_RNR = 0x60ea,
+	MT7932_CMD_CAL_EXT_21 = 0x21ed,
+};
+
+enum mt7932_fw_band {
+	MT7932_BAND_2GHZ = 1,
+	MT7932_BAND_5GHZ = 2,
+	MT7932_BAND_6GHZ = 3,
+};
+
+enum mt7932_bss_index {
+	MT7932_AIS_BSS = 0,
+	MT7932_DISCOVERY_BSS = 1,
+};
+
+#define MT7932_NO_WCID			U8_MAX
+/* Retain the existing defensive bound; this is not a decoded table size. */
+#define MT7932_PEER_WCID_LIMIT		48
+#define MT7932_SCAN_SEQUENCE_MASK	GENMASK(6, 0)
+#define MT7932_SCAN_DISABLE_DBDC		BIT(1)
+#define MT7932_SCAN_SPECIFIED_SSIDS	BIT(3)
+#define MT7932_SCAN_DWELL_MS		150
+#define MT7932_SCAN_MIN_DWELL_MS		120
+#define MT7932_SCAN_FW_TIMEOUT_MS		10000
+
+/* MT7932 boot replies are one-based, unlike mt76's generic PATCH_* enum. */
+enum mt7932_patch_sem_status {
+	MT7932_PATCH_SEM_BUSY = 1,
+	MT7932_PATCH_ALREADY_LOADED = 2,
+	MT7932_PATCH_SEM_ACQUIRED = 3,
+};
+
+#define MT7932_PATCH_SEM_REQUEST		2
+#define MT7932_PATCH_WIFI_SECTION		0x100
+#define MT7932_FW_SCATTER_CHUNK		2048
+#define MT7932_FW_MAX_REGIONS		10
+
+/* Private board-calibration replay file. Command descriptors/sequence
+ * numbers are constructed afresh; this records payloads and command policy.
+ */
+#define MT7932_CAL_MAGIC			"MT7932C1"
+#define MT7932_CAL_MAX_FILE_SIZE		SZ_64K
+#define MT7932_CAL_MAX_RECORDS		128
+#define MT7932_CAL_MAX_PAYLOAD		1536
+#define MT7932_CAL_EXT_FRAGMENT		3
+#define MT7932_CAL_EXT_MAX_DATA		SZ_1K
+#define MT7932_CAL_PROFILE_SELECTOR	9 /* Selector semantics unresolved. */
+
+struct mt7932_cal_file_header {
+	u8 magic[8];
+	u8 mac[ETH_ALEN];
+	u8 reserved[2];
+	__le32 count;
+} __packed;
+
+struct mt7932_cal_file_record {
+	u8 cid;
+	u8 ext_cid;
+	u8 set_query;
+	u8 wait_response;
+	__le32 len;
+	u8 data[];
+} __packed;
+
+struct mt7932_cal_ext_fragment {
+	u8 type;
+	u8 reserved;
+	__le16 len;
+	u8 data[];
+} __packed;
+
+struct mt7932_cal_profile_query {
+	u8 unknown_0[3];
+	u8 selector;
+	u8 unknown_4[16];
+} __packed;
+
+struct mt7932_cal_profile_reply {
+	u8 unknown_0[12];
+	u8 cid;
+	u8 unknown_13[7];
+} __packed;
+
+/* Bits/values here belong to MT7932's password-offload ABI, not nl80211
+ * suite selectors or gen4m's separate authentication-mode enum.
+ */
+#define MT7932_SME_AUTH_SAE		BIT(10)
+#define MT7932_SME_CIPHER_CCMP		BIT(4)
+#define MT7932_SME_CONNECT_FLAGS		BIT(16)
+#define MT7932_SME_PASSWORD_FORMAT	10
+#define MT7932_SME_PMF_REQUIRED		2
+#define MT7932_SME_NATIVE_AUTH_POLICY	(BIT(30) | BIT(2))
+/* Units and individual semantics of these observed native policies unknown. */
+#define MT7932_SME_NATIVE_DEADLINE	120
+#define MT7932_SME_NATIVE_OPERATION	8
+#define MT7932_SME_NATIVE_COMPATIBILITY	20
+#define MT7932_SME_NATIVE_PROFILE		0x00020407
+#define MT7932_DISCONNECT_POLICY		8
+#define MT7932_DISCONNECT_PEER_TAG	1
+#define MT7932_DISCONNECT_TRAILER		30
+#define MT7932_POWER_MAX_CHANNELS		8
+#define MT7932_POWER_RATE_ENTRIES		121
+#define MT7932_POWER_WIRE_VERSION		3
+#define MT7932_POWER_WIRE_FORMAT		0x0a /* Individual format bits unknown. */
+/* Existing conservative 10 dBm bring-up ceiling; firmware units are 0.5 dBm. */
+#define MT7932_POWER_CEILING_HALF_DBM	20
+
+struct mt7932_power_channel {
+	u8 channel;
+	s8 rate_limit[MT7932_POWER_RATE_ENTRIES];
+} __packed;
+
+struct mt7932_basic_config {
+	u8 native_80211;
+	u8 assert_path;
+	u8 debug_level;
+	u8 unknown_3;
+	__le16 rx_checksum;
+	__le16 tx_checksum;
+	u8 segmentation;
+	u8 reserved[3];
+	u8 unknown_extension[12];
+} __packed;
+
+/* MT7932 extends the legacy 12-byte config. Preserve the observed extension
+ * while its individual controls remain unresolved. One shared initializer
+ * keeps raw-802.11 startup and Ethernet-offload startup in sync.
+ */
+#define MT7932_BASIC_CONFIG_INITIALIZER(_native) { \
+	.native_80211 = (_native), \
+	.unknown_3 = 3, \
+	.unknown_extension = { 1, 0, 2, 3, 0, 0x20, 0, 0, 2 }, \
+}
+
+/* Privacy bitmap: ordinary IE IDs occupy 256 bits, followed by 64 extension
+ * IDs. The inclusive final-byte index is 39; extension 58 is in that byte.
+ */
+#define MT7932_PRIVACY_ORDINARY_BYTES	(U8_MAX / BITS_PER_BYTE + 1)
+#define MT7932_PRIVACY_EXTENSION_BYTES	8
+struct mt7932_probe_privacy {
+	u8 subcommand;
+	u8 unknown_1[3];
+	u8 last_bitmap_byte;
+	u8 unknown_policy0;
+	u8 unknown_policy1;
+	u8 bitmap[MT7932_PRIVACY_ORDINARY_BYTES + MT7932_PRIVACY_EXTENSION_BYTES];
+	u8 reserved_tail[13];
+} __packed;
+
+/* The native activation command's last byte is 1, although an older public
+ * gen4m structure calls it reserved. Do not infer a new meaning from that.
+ */
+struct mt7932_activate_bss {
+	u8 bss_idx;
+	u8 active;
+	u8 network_type;
+	u8 omac_idx;
+	u8 mac[ETH_ALEN];
+	u8 bmc_wcid;
+	u8 unknown_11;
+} __packed;
+
+struct mt7932_ais_mac {
+	u8 bss_idx;
+	u8 reserved;
+	u8 mac[ETH_ALEN];
+} __packed;
+
+/* Legacy RLM layout, corroborated against gen4m CMD_SET_BSS_RLM_PARAM. */
+struct mt7932_rlm {
+	u8 bss_idx;
+	u8 band;
+	u8 primary_channel;
+	u8 secondary_channel_offset;
+	u8 erp_protection;
+	u8 ht_protection;
+	u8 greenfield_operation;
+	u8 tx_rifs;
+	__le16 ht_operation3;
+	__le16 ht_operation2;
+	u8 ht_operation1;
+	u8 short_preamble;
+	u8 short_slot_time;
+	u8 vht_width;
+	u8 center_channel1;
+	u8 center_channel2;
+	__le16 vht_basic_mcs;
+	u8 tx_nss;
+	u8 rx_nss;
+} __packed;
+
+/* The prefix through ext_channels matches mt76_connac_hw_scan_req, then
+ * MT7932 inserts two
+ * bytes before ext_ssids; named tail fields prevent accidental use of the
+ * generic bssid/random_mac offsets on this wire format.
+ */
+struct mt7932_scan_request {
+	u8 common[offsetof(struct mt76_connac_hw_scan_req, ext_ssids)];
+	u8 unknown_before_ext_ssids[2];
+	struct mt76_connac_mcu_scan_ssid ext_ssids[6];
+	u8 bssid[ETH_ALEN];
+	u8 random_mac[ETH_ALEN];
+	u8 unknown_tail[112];
+} __packed;
+
+enum mt7932_event {
+	MT7932_EVENT_PRECAL_REQUEST = 0xd7,
+	MT7932_EVENT_PRECAL_DONE = 0xd9,
+	MT7932_EVENT_MLME = 0xea,
+	MT7932_EVENT_MLME_ALT = 0xee,
+	MT7932_EVENT_COMMAND_RESULT = 0xfd,
+};
+
+#define MT7932_BOOT_PACKET_TYPE		0xe000
+#define MT7932_ROM_PACKET_TYPE		7
+#define MT7932_RUNTIME_PACKET_TYPE	0x3800
+#define MT7932_BOOT_SUCCESS		1
+/* ROM has no four-byte extended event tail. */
+#define MT7932_BOOT_HEADER_SIZE		offsetof(struct mt76_connac2_mcu_rxd, ext_eid)
+
+struct mt7932_command_result {
+	u8 cid;
+	u8 status;
+	u8 reserved[2];
+} __packed;
+
+struct mt7932_register_result {
+	__le32 address;
+	__le32 value;
+} __packed;
+
+/* Input header produced by mt76_connac_mcu_set_channel_domain. */
+struct mt7932_channel_domain_input {
+	u8 alpha2[4];
+	u8 bw_2g;
+	u8 bw_5g;
+	u8 bw_6g;
+	u8 reserved;
+	u8 n_2ch;
+	u8 n_5ch;
+	u8 n_6ch;
+	u8 reserved2;
+} __packed;
+
+/* Native variant of that header. Preserve observed policy fields without
+ * interpreting them as the generic header's bandwidth bytes.
+ */
+struct mt7932_channel_domain {
+	u8 alpha2[4];
+	__le16 unknown_policy4;
+	u8 unknown_policy6;
+	u8 flags;
+	u8 n_2ch;
+	u8 n_5ch;
+	u8 n_6ch;
+	u8 unknown_fcc_policy;
+} __packed;
+
+struct mt7932_domain_channel {
+	__le16 number;
+	__le16 reserved;
+	__le32 flags;
+} __packed;
+
+#define MT7932_DOMAIN_HAS_DFS_REGION	BIT(0)
+#define MT7932_DOMAIN_HAS_6GHZ		BIT(3)
+#define MT7932_DOMAIN_DFS_REGION		GENMASK(7, 4)
+#define MT7932_CHANNEL_PASSIVE		BIT(8)
+#define MT7932_CHANNEL_DFS		BIT(3)
+
+enum mt7932_mlme_event_type {
+	MT7932_MLME_ASSOCIATED = 0x40,
+	MT7932_MLME_AUTHORIZED = 0x41,
+	MT7932_MLME_DISCONNECTED = 0x44,
+	MT7932_MLME_CONNECTING = 0x4d,
+};
+
+struct mt7932_mlme_event {
+	__le32 unknown_0; /* Only the observed zero-valued envelope is handled. */
+	__le32 type;
+	__le32 len;
+	u8 data[];
+} __packed;
+
+struct mt7932_mlme_connecting {
+	u8 unknown_0[4];
+	u8 bssid[ETH_ALEN];
+	u8 center_channel;
+	u8 unknown_11;
+	u8 band;
+	u8 unknown_13[11];
+} __packed;
+
+struct mt7932_mlme_associated {
+	__le32 status;
+	u8 unknown_4;
+	u8 bssid[ETH_ALEN];
+	u8 unknown_11[10];
+	u8 peer_wcid;
+} __packed;
+
+struct mt7932_mlme_authorized {
+	__le32 status;
+	u8 bssid[ETH_ALEN];
+	u8 unknown_10[10];
+} __packed;
+
+static_assert(sizeof(struct mt7932_activate_bss) == 12);
+static_assert(sizeof(struct mt7932_basic_config) == 24);
+static_assert(sizeof(struct mt7932_power_channel) == 122);
+static_assert(sizeof(struct mt7932_probe_privacy) == 60);
+static_assert(offsetof(struct mt7932_probe_privacy, bitmap) == 7);
+static_assert(offsetof(struct mt7932_basic_config, unknown_extension) == 12);
+static_assert(sizeof(struct mt7932_ais_mac) == 8);
+static_assert(sizeof(struct mt7932_rlm) == 22);
+static_assert(offsetof(struct mt7932_rlm, short_slot_time) == 14);
+static_assert(sizeof(struct mt7932_scan_request) == 1236);
+static_assert(offsetof(struct mt7932_scan_request, ext_ssids) == 0x380);
+static_assert(offsetof(struct mt7932_scan_request, bssid) == 0x458);
+static_assert(offsetof(struct mt7932_scan_request, random_mac) == 0x45e);
+static_assert(sizeof(struct mt7932_mlme_event) == 12);
+static_assert(sizeof(struct mt7932_mlme_connecting) == 24);
+static_assert(offsetof(struct mt7932_mlme_connecting, band) == 12);
+static_assert(sizeof(struct mt7932_mlme_associated) == 22);
+static_assert(offsetof(struct mt7932_mlme_associated, peer_wcid) == 21);
+static_assert(sizeof(struct mt7932_mlme_authorized) == 20);
+static_assert(MT7932_BOOT_HEADER_SIZE == 32);
+static_assert(sizeof(struct mt76_connac2_mcu_rxd) == 36);
+static_assert(offsetof(struct mt76_connac2_mcu_rxd, eid) == 28);
+static_assert(sizeof(struct mt7932_command_result) == 4);
+static_assert(sizeof(struct mt7932_register_result) == 8);
+static_assert(sizeof(struct mt7932_channel_domain_input) == 12);
+static_assert(sizeof(struct mt7932_channel_domain) == 12);
+static_assert(sizeof(struct mt7932_domain_channel) == 8);
+static_assert(sizeof(struct mt7932_cal_file_header) == 20);
+static_assert(sizeof(struct mt7932_cal_file_record) == 8);
+static_assert(sizeof(struct mt7932_cal_ext_fragment) == 4);
+static_assert(sizeof(struct mt7932_cal_profile_query) == 20);
+static_assert(sizeof(struct mt7932_cal_profile_reply) == 20);
+static_assert(offsetof(struct mt7932_cal_profile_reply, cid) == 12);
+
+#endif
diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_offload.c b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_offload.c
new file mode 100644
index 0000000000000..a702e11267905
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_offload.c
@@ -0,0 +1,408 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MT7932 firmware MLME and opaque, board-specific calibration cache. */
+#include <linux/firmware.h>
+#include <linux/etherdevice.h>
+#include <linux/unaligned.h>
+#include "mt7921.h"
+#include "mt7932_offload.h"
+#include "mt7932_mcu.h"
+
+/* Observed ABI offsets. Padding and the unclassified security buffer remain zero. */
+struct mt7932_connect_command {
+	__le32 auth_suite, pairwise_cipher, operation_deadline;
+	__le32 reserved0, flags, operation;
+	__le32 ssid_len;
+	u8 ssid[IEEE80211_MAX_SSID_LEN];
+	__le32 reserved1, password_len, password_format, reserved2;
+	u8 password[64];
+	u8 reserved3[308];
+	__le32 pmf;
+	__le32 reserved4, security_buffer_len;
+	u8 security_buffer[32], reserved4b[32];
+	__le32 allowed_auth;
+	u8 reserved5[24];
+	__le32 compatibility_policy;
+	u8 reserved5b[252];
+	__le32 candidate_flags;
+	u8 bssid[ETH_ALEN], reserved6[6];
+	u8 band, channel, reserved7[2];
+	u8 candidate_policy[8];
+	__le32 reserved8;
+	u8 candidate_tail_policy[4];
+	u8 reserved9[8];
+	__le32 candidates;
+} __packed;
+
+static_assert(sizeof(struct mt7932_connect_command) == 856);
+static_assert(sizeof(struct mt7932_connect_params) == 106);
+static_assert(offsetof(struct mt7932_connect_command, ssid_len) == 24);
+static_assert(offsetof(struct mt7932_connect_command, ssid) == 28);
+static_assert(offsetof(struct mt7932_connect_command, password_len) == 64);
+static_assert(offsetof(struct mt7932_connect_command, password) == 76);
+static_assert(offsetof(struct mt7932_connect_command, pmf) == 448);
+static_assert(offsetof(struct mt7932_connect_command, security_buffer_len) == 456);
+static_assert(offsetof(struct mt7932_connect_command, security_buffer) == 460);
+static_assert(offsetof(struct mt7932_connect_command, allowed_auth) == 524);
+static_assert(offsetof(struct mt7932_connect_command, bssid) == 812);
+static_assert(offsetof(struct mt7932_connect_command, band) == 824);
+static_assert(offsetof(struct mt7932_connect_command, candidates) == 852);
+
+int mt7932_offload_connect(struct mt792x_dev *dev,
+			   const struct mt7932_connect_params *p)
+{
+	struct mt7932_connect_command *cmd;
+	struct mt7932_ais_mac mac = {};
+	__le32 profile = cpu_to_le32(MT7932_SME_NATIVE_PROFILE);
+	struct mt7932_basic_config basic = MT7932_BASIC_CONFIG_INITIALIZER(0);
+	int ret;
+
+	if (!p->ssid_len || p->ssid_len > sizeof(p->ssid) ||
+	    !p->password_len || p->password_len > sizeof(p->password) ||
+	    !is_valid_ether_addr(p->bssid) || p->band < MT7932_BAND_2GHZ || p->band > MT7932_BAND_6GHZ ||
+	    !p->channel || (p->band == MT7932_BAND_2GHZ && p->channel > 14) ||
+	    (p->band == MT7932_BAND_6GHZ && (p->channel > 233 || (p->channel - 1) % 4)))
+		return -EINVAL;
+	cmd = kzalloc(sizeof(*cmd), GFP_KERNEL);
+	if (!cmd)
+		return -ENOMEM;
+	/* SAE password offload, CCMP, mandatory PMF; no host-supplied PMK. */
+	cmd->auth_suite = cpu_to_le32(MT7932_SME_AUTH_SAE);
+	cmd->pairwise_cipher = cpu_to_le32(MT7932_SME_CIPHER_CCMP);
+	cmd->operation_deadline = cpu_to_le32(MT7932_SME_NATIVE_DEADLINE);
+	cmd->flags = cpu_to_le32(MT7932_SME_CONNECT_FLAGS);
+	cmd->operation = cpu_to_le32(MT7932_SME_NATIVE_OPERATION);
+	cmd->ssid_len = cpu_to_le32(p->ssid_len);
+	memcpy(cmd->ssid, p->ssid, p->ssid_len);
+	cmd->password_len = cpu_to_le32(p->password_len);
+	/* This field is 10 for the observed password encoding; it is not
+	 * gen4m's AUTH_MODE enum (SAE is 11 in that separate namespace).
+	 */
+	cmd->password_format = cpu_to_le32(MT7932_SME_PASSWORD_FORMAT);
+	memcpy(cmd->password, p->password, p->password_len);
+	cmd->pmf = cpu_to_le32(MT7932_SME_PMF_REQUIRED);
+	/* No cached security value for fresh SAE. Its role in the captured
+	 * request is unclassified. An absent buffer, zero buffer and newly
+	 * derived PSK are being checked independently of radio controls.
+	 */
+	/* Observed firmware authentication policy. Bit 2's meaning is pending
+	 * independent verification; this is not the public gen4m auth enum.
+	 */
+	cmd->allowed_auth = cpu_to_le32(MT7932_SME_NATIVE_AUTH_POLICY);
+	/* Compatibility fields under investigation. These contain public
+	 * policy/PHY information, not any network identity or secret. Keep
+	 * them explicit so individual fields can be tested independently.
+	 */
+	cmd->compatibility_policy = cpu_to_le32(MT7932_SME_NATIVE_COMPATIBILITY);
+	cmd->candidate_policy[0] = 1;
+	cmd->candidate_policy[1] = 2;
+	cmd->candidate_policy[2] = 4;
+	cmd->candidate_policy[4] = 6;
+	cmd->candidate_policy[5] = 7;
+	cmd->candidate_tail_policy[0] = 4;
+	cmd->candidate_tail_policy[1] = 16;
+	cmd->candidate_tail_policy[2] = 18;
+	cmd->candidate_tail_policy[3] = 20;
+	memcpy(cmd->bssid, p->bssid, ETH_ALEN);
+	cmd->band = p->band;
+	cmd->channel = p->channel;
+	cmd->candidates = cpu_to_le32(1);
+
+	mt792x_mutex_acquire(dev);
+	ret = mt7932_start(&dev->phy);
+	if (!ret)
+		ret = mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_BASIC_CONFIG,
+				       &basic, sizeof(basic), false);
+	if (!ret)
+		ret = mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_SME_CONFIG,
+				       &profile, sizeof(profile), false);
+	ether_addr_copy(mac.mac, dev->mphy.macaddr);
+	if (!ret)
+		ret = mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_AIS_MAC,
+				       &mac, sizeof(mac), false);
+	if (!ret) {
+		mt7932_fullmac_connecting(dev, p->bssid);
+		ret = mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_SME_CONNECT, cmd, sizeof(*cmd), false);
+	}
+	mt792x_mutex_release(dev);
+	kfree_sensitive(cmd);
+	return ret;
+}
+
+/* EA/42 is emitted by the native CoreWLAN disassociate operation.
+ * Preserve the observed policy words until their individual semantics are
+ * established. Construct the peer field from the current connection.
+ */
+struct mt7932_disconnect_command {
+	__le32 policy;
+	__le32 reserved;
+	__le16 peer_tag;
+	__le16 peer_len;
+	struct_group(peer,
+		u8 bss_idx;
+		u8 bssid[ETH_ALEN];
+		u8 padding;
+	);
+	__le32 trailer;
+} __packed;
+
+static_assert(sizeof(struct mt7932_disconnect_command) == 24);
+static_assert(offsetof(struct mt7932_disconnect_command, bssid) == 13);
+
+int mt7932_offload_disconnect(struct mt792x_dev *dev, const u8 *bssid)
+{
+	struct mt7932_disconnect_command cmd = {
+		.policy = cpu_to_le32(MT7932_DISCONNECT_POLICY),
+		.peer_tag = cpu_to_le16(MT7932_DISCONNECT_PEER_TAG),
+		.peer_len = cpu_to_le16(sizeof(cmd.peer)),
+		.trailer = cpu_to_le32(MT7932_DISCONNECT_TRAILER),
+	};
+	int ret;
+
+	if (!is_valid_ether_addr(bssid))
+		return -EINVAL;
+	ether_addr_copy(cmd.bssid, bssid);
+	mt792x_mutex_acquire(dev);
+	ret = mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_SME_DISCONNECT,
+			       &cmd, sizeof(cmd), false);
+	mt792x_mutex_release(dev);
+	return ret;
+}
+
+/* On disk: MT7932P1, MAC[6], LE16 record count, LE32 total size, records.
+ * Each record is calibration metadata followed by opaque RF data. There are
+ * no MCU descriptors, sequence numbers, commands or connection credentials.
+ */
+#define MT7932_PRECAL_MAGIC "MT7932P1"
+#define MT7932_PRECAL_MAX_SIZE (400 * SZ_1K)
+#define MT7932_PRECAL_MAX_RECORDS 128
+#define MT7932_PRECAL_GROUP_CLASS 1
+#define MT7932_PRECAL_CHANNEL_CLASS 2
+#define MT7932_PRECAL_CHANNEL_INFO_CLASS 3
+#define MT7932_PRECAL_GROUP_BYTES 1080
+#define MT7932_PRECAL_CHANNEL_BYTES 604
+#define MT7932_PRECAL_CHANNEL_INFO_BYTES 16
+#define MT7932_PRECAL_GROUP_MASK GENMASK(15, 0)
+#define MT7932_PRECAL_PRELOAD_MASK GENMASK(31, 16)
+#define MT7932_PRECAL_FREQUENCY_MASK GENMASK(23, 0)
+/* Explicit coverage restriction, not a general band-to-calibration map. */
+#define MT7932_PRECAL_QUALIFIED_6GHZ_GROUP 28
+
+struct mt7932_precal_file_header {
+	u8 magic[8];
+	u8 mac[ETH_ALEN];
+	__le16 count;
+	__le32 size;
+} __packed;
+static_assert(sizeof(struct mt7932_precal_file_header) == 20);
+
+struct mt7932_precal_key {
+	__le32 selector;
+	__le32 frequency;
+	__le32 control;
+} __packed;
+
+struct mt7932_precal_request {
+	__le32 unknown_0;
+	struct mt7932_precal_key key;
+} __packed;
+static_assert(sizeof(struct mt7932_precal_request) == 16);
+
+struct mt7932_cal_record {
+	u8 class, operation;
+	__le16 id;
+	__le32 len;
+	union {
+		struct mt7932_precal_key key;
+		struct { __le32 selector, frequency, control; };
+	};
+	u8 data[];
+} __packed;
+static_assert(sizeof(struct mt7932_cal_record) == 20);
+
+struct mt7932_cal_cache {
+	unsigned int count;
+	u8 data[];
+};
+
+int mt7932_precal_load(struct mt792x_dev *dev, struct mt7932_cal_cache **out)
+{
+	struct mt7932_cal_cache *cache;
+	const struct mt7932_precal_file_header *header;
+	const struct firmware *fw;
+	char name[80];
+	size_t pos;
+	u16 count;
+	int i, ret;
+
+	*out = NULL;
+	snprintf(name, sizeof(name), "mediatek/mt7932/precal-%pm.bin", dev->mphy.macaddr);
+	ret = request_firmware(&fw, name, dev->mt76.dev);
+	if (ret)
+		return ret;
+	ret = -EINVAL;
+	header = (const void *)fw->data;
+	if (fw->size < sizeof(*header) || fw->size > MT7932_PRECAL_MAX_SIZE ||
+	    memcmp(header->magic, MT7932_PRECAL_MAGIC, sizeof(header->magic)) ||
+	    !ether_addr_equal(header->mac, dev->mphy.macaddr) ||
+	    le32_to_cpu(header->size) != fw->size)
+		goto out;
+	count = le16_to_cpu(header->count);
+	if (!count || count > MT7932_PRECAL_MAX_RECORDS)
+		goto out;
+	for (i = 0, pos = sizeof(*header); i < count; i++) {
+		const struct mt7932_cal_record *r;
+		u32 len;
+
+		if (fw->size - pos < sizeof(*r))
+			goto out;
+		r = (const void *)(fw->data + pos);
+		len = le32_to_cpu(r->len);
+		if (r->operation || r->class < MT7932_PRECAL_GROUP_CLASS ||
+		    r->class > MT7932_PRECAL_CHANNEL_INFO_CLASS ||
+		    len != (r->class == MT7932_PRECAL_GROUP_CLASS ? MT7932_PRECAL_GROUP_BYTES :
+			    r->class == MT7932_PRECAL_CHANNEL_CLASS ? MT7932_PRECAL_CHANNEL_BYTES :
+								    MT7932_PRECAL_CHANNEL_INFO_BYTES) ||
+		    len > fw->size - pos - sizeof(*r))
+			goto out;
+		pos += sizeof(*r) + len;
+	}
+	if (pos != fw->size)
+		goto out;
+	cache = devm_kzalloc(dev->mt76.dev,
+			     sizeof(*cache) + fw->size - sizeof(*header), GFP_KERNEL);
+	if (!cache) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	cache->count = count;
+	memcpy(cache->data, fw->data + sizeof(*header), fw->size - sizeof(*header));
+	*out = cache;
+	dev_info(dev->mt76.dev, "MT7932 board precal cache loaded (%u records)\n", count);
+	ret = 0;
+out:
+	release_firmware(fw);
+	return ret;
+}
+
+static int mt7932_precal_send(struct mt792x_dev *dev,
+			    const struct mt7932_cal_record *r)
+{
+	struct mt7932_cal_record *req;
+	u32 len = le32_to_cpu(r->len);
+	int ret;
+
+	req = kzalloc(sizeof(*req) + len, GFP_KERNEL);
+	if (!req)
+		return -ENOMEM;
+	req->class = r->class;
+	req->id = r->id;
+	req->len = cpu_to_le32(len);
+	req->selector = r->selector;
+	req->frequency = r->frequency;
+	req->control = r->control;
+	memcpy(req->data, r->data, len);
+	/* Completion is an unsolicited D9, never a sequence-number reply. */
+	ret = mt76_mcu_send_msg(&dev->mt76, MT7932_CMD_PRECAL,
+			       req, sizeof(*req) + len, false);
+	kfree(req);
+	return ret;
+}
+
+int mt7932_precal_preload(struct mt792x_dev *dev, struct mt7932_cal_cache *cache,
+			   u8 band)
+{
+	const struct mt7932_cal_record *r;
+	size_t pos = 0;
+	int i, sent = 0, ret = 0;
+
+	if (!cache)
+		return -ENOENT;
+	mt792x_mutex_acquire(dev);
+	for (i = 0; i < cache->count; i++) {
+		u32 selector;
+
+		r = (const void *)(cache->data + pos);
+		pos += sizeof(*r) + le32_to_cpu(r->len);
+		selector = le32_to_cpu(r->selector);
+		if (band != MT7932_BAND_6GHZ || r->class != MT7932_PRECAL_GROUP_CLASS ||
+		    FIELD_GET(MT7932_PRECAL_GROUP_MASK, selector) !=
+		    MT7932_PRECAL_QUALIFIED_6GHZ_GROUP ||
+		    !(selector & MT7932_PRECAL_PRELOAD_MASK))
+			continue;
+		ret = mt7932_precal_send(dev, r);
+		if (ret)
+			break;
+		sent++;
+	}
+	mt792x_mutex_release(dev);
+	dev_info(dev->mt76.dev, "MT7932 group precal preload band=%u records=%d result=%d\n",
+		 band, sent, ret);
+	return ret ?: (sent ? 0 : -ENOENT);
+}
+
+int mt7932_precal_apply(struct mt792x_dev *dev, struct mt7932_cal_cache *cache,
+			 u8 band, u32 center_khz)
+{
+	const struct mt7932_cal_record *r;
+	size_t pos = 0;
+	int i, sent = 0, ret = 0;
+
+	if (!cache)
+		return -ENOENT;
+	mt792x_mutex_acquire(dev);
+	for (i = 0; i < cache->count; i++) {
+		u32 frequency, group;
+
+		r = (const void *)(cache->data + pos);
+		pos += sizeof(*r) + le32_to_cpu(r->len);
+		frequency = le32_to_cpu(r->frequency) & MT7932_PRECAL_FREQUENCY_MASK;
+		group = FIELD_GET(MT7932_PRECAL_GROUP_MASK, le32_to_cpu(r->selector));
+		/* Preload-marked group records were submitted before connect. */
+		if (r->class == MT7932_PRECAL_GROUP_CLASS &&
+		    (le32_to_cpu(r->selector) & MT7932_PRECAL_PRELOAD_MASK))
+			continue;
+		/* This bank covers the observed 6 GHz group 28 only. Never apply
+		 * another channel's DPD data to an unsupported frequency.
+		 */
+		if (band != MT7932_BAND_6GHZ ||
+		    (r->class == MT7932_PRECAL_GROUP_CLASS ?
+		     group != MT7932_PRECAL_QUALIFIED_6GHZ_GROUP : frequency != center_khz))
+			continue;
+		ret = mt7932_precal_send(dev, r);
+		if (ret)
+			break;
+		sent++;
+	}
+	mt792x_mutex_release(dev);
+	dev_info(dev->mt76.dev, "MT7932 precal apply band=%u center=%u kHz records=%d result=%d\n",
+		 band, center_khz, sent, ret);
+	return ret ?: (sent ? 0 : -ENOENT);
+}
+
+int mt7932_precal_request(struct mt792x_dev *dev, struct mt7932_cal_cache *cache,
+			   const u8 *request, size_t len)
+{
+	const struct mt7932_cal_record *r;
+	size_t pos = 0;
+	int i, ret = -ENOENT;
+
+	if (!cache || len < sizeof(struct mt7932_precal_request))
+		return -EINVAL;
+	/* The D7 key split is still undocumented. Match all three words
+	 * exactly, rather than guessing a frequency or returning a wrong block.
+	 */
+	mt792x_mutex_acquire(dev);
+	for (i = 0; i < cache->count; i++) {
+		r = (const void *)(cache->data + pos);
+		pos += sizeof(*r) + le32_to_cpu(r->len);
+		if (memcmp(&r->key,
+			   &((const struct mt7932_precal_request *)request)->key,
+			   sizeof(r->key)))
+			continue;
+		ret = mt7932_precal_send(dev, r);
+		if (ret)
+			break;
+	}
+	mt792x_mutex_release(dev);
+	return ret;
+}
diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_offload.h b/drivers/net/wireless/mediatek/mt76/mt7921/mt7932_offload.h
