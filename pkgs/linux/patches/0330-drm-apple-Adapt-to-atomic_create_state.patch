From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Fri, 30 Oct 2026 22:13:23 -0500
Subject: [PATCH] drm/apple: Adapt to atomic_create_state

Mainline replaced the plane and CRTC reset hooks with
atomic_create_state and moved the fbdev helpers into the client library.

The driver was written for older kernels and builds against this one
only from here, so its Kconfig entry is added here rather than with the
driver.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 drivers/gpu/drm/Kconfig           |  1 +
 drivers/gpu/drm/apple/apple_drv.c |  3 +--
 drivers/gpu/drm/apple/plane.c     | 24 ++++++++++++------------
 3 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/drivers/gpu/drm/Kconfig b/drivers/gpu/drm/Kconfig
index 61111d50b1c6..fe16c6f3d2ee 100644
--- a/drivers/gpu/drm/Kconfig
+++ b/drivers/gpu/drm/Kconfig
@@ -305,6 +305,7 @@ config DRM_PRIVACY_SCREEN
 # DRM driver Kconfig files, sorted
 source "drivers/gpu/drm/adp/Kconfig"
 source "drivers/gpu/drm/amd/amdgpu/Kconfig"
+source "drivers/gpu/drm/apple/Kconfig"
 source "drivers/gpu/drm/arm/Kconfig"
 source "drivers/gpu/drm/armada/Kconfig"
 source "drivers/gpu/drm/aspeed/Kconfig"
diff --git a/drivers/gpu/drm/apple/apple_drv.c b/drivers/gpu/drm/apple/apple_drv.c
index 630ba467868b..befb3b8114fd 100644
--- a/drivers/gpu/drm/apple/apple_drv.c
+++ b/drivers/gpu/drm/apple/apple_drv.c
@@ -24,7 +24,6 @@
 #include <drm/clients/drm_client_setup.h>
 #include <drm/drm_crtc.h>
 #include <drm/drm_drv.h>
-#include <drm/drm_fb_helper.h>
 #include <drm/drm_fbdev_dma.h>
 #include <drm/drm_fb_dma_helper.h>
 #include <drm/drm_gem_dma_helper.h>
@@ -215,7 +214,7 @@ static const struct drm_crtc_funcs apple_crtc_funcs = {
 	.atomic_duplicate_state = drm_atomic_helper_crtc_duplicate_state,
 	.destroy		= apple_crtc_cleanup,
 	.page_flip		= drm_atomic_helper_page_flip,
-	.reset			= drm_atomic_helper_crtc_reset,
+	.atomic_create_state = drm_atomic_helper_crtc_create_state,
 	.set_config             = drm_atomic_helper_set_config,
 	.set_crc_source		= apple_crtc_set_crc_source,
 	.verify_crc_source	= apple_crtc_verify_crc_source,
diff --git a/drivers/gpu/drm/apple/plane.c b/drivers/gpu/drm/apple/plane.c
index 3d966f222231..4befd25e107a 100644
--- a/drivers/gpu/drm/apple/plane.c
+++ b/drivers/gpu/drm/apple/plane.c
@@ -303,18 +303,18 @@ static const struct drm_plane_helper_funcs apple_plane_helper_funcs = {
 	.atomic_update	= apple_plane_atomic_update,
 };
 
-// Duplicate drm_atomic_helper_plane_reset but allocate struct apple_plane_state
-static void apple_plane_reset(struct drm_plane *plane)
+// Like drm_atomic_helper_plane_create_state, but for struct apple_plane_state
+static struct drm_plane_state *apple_plane_create_state(struct drm_plane *plane)
 {
-        struct apple_plane_state *state = to_apple_plane_state(plane->state);
-	if (state)
-		__drm_atomic_helper_plane_destroy_state(&state->base);
-
-	kfree(state);
-	plane->state = NULL;
-	state = kzalloc(sizeof(*state), GFP_KERNEL);
-	if (state)
-		__drm_atomic_helper_plane_reset(plane, &state->base);
+	struct apple_plane_state *state;
+
+	state = kzalloc_obj(*state);
+	if (!state)
+		return ERR_PTR(-ENOMEM);
+
+	__drm_atomic_helper_plane_state_init(&state->base, plane);
+
+	return &state->base;
 }
 
 static struct drm_plane_state *
@@ -349,7 +349,7 @@ apple_plane_duplicate_state(struct drm_plane *plane)
 static const struct drm_plane_funcs apple_plane_funcs = {
 	.update_plane		= drm_atomic_helper_update_plane,
 	.disable_plane		= drm_atomic_helper_disable_plane,
-	.reset			= apple_plane_reset,
+	.atomic_create_state	= apple_plane_create_state,
 	.atomic_duplicate_state = apple_plane_duplicate_state,
 	// .atomic_destroy_state	= apple_plane_destroy_state,
 	.atomic_destroy_state	= drm_atomic_helper_plane_destroy_state,
