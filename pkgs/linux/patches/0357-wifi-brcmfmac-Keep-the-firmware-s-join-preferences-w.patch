From 36bd6831771cd2fb99d04e084f627befba7b0571 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Sat, 31 Oct 2026 14:26:37 -0500
Subject: [PATCH] wifi: brcmfmac: Keep the firmware's join preferences when it
 refuses ours

The BCM4388 firmware (23.50.20.2.41.51.209) holds its own join
preferences and refuses the RSSI delta preference with BCME_ERROR, so
the default RSSI-with-5GHz-boost list is rejected on every interface
start and the firmware keeps its own. Log that at debug level, not as
an error.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 drivers/net/wireless/broadcom/brcm80211/brcmfmac/common.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/common.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/common.c
index e3a9ca5526c4..cfe003861e7f 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/common.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/common.c
@@ -96,7 +96,10 @@ void brcmf_c_set_joinpref_default(struct brcmf_if *ifp)
 	join_pref_params[1].band = 0;
 	err = brcmf_fil_iovar_data_set(ifp, "join_pref", join_pref_params,
 				       sizeof(join_pref_params));
-	if (err)
+	/* Firmware without the RSSI delta preference keeps its own. */
+	if (err == -EBADE)
+		brcmf_dbg(INFO, "Firmware refused the default join_pref\n");
+	else if (err)
 		bphy_err(drvr, "Set join_pref error (%d)\n", err);
 }
 
