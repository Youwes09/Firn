index 000000000000..d1a52bd5e2b9
--- /dev/null
+++ b/rust/kernel/soc/apple/rtkit.rs
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! Support for Apple RTKit coprocessors.
+//!
+//! C header: [`include/linux/soc/apple/rtkit.h`](srctree/include/linux/soc/apple/rtkit.h)
+
+use crate::{
+    bindings,
+    device::{
+        Bound,
+        Device, //
+    },
+    error::{
+        from_err_ptr,
+        to_result, //
+    },
+    prelude::*,
+    sync::atomic::{
+        Acquire,
+        Atomic,
+        Relaxed,
+        Release, //
+    },
+    types::Opaque, //
+};
+use core::{
+    ffi::c_void,
+    marker::PhantomPinned,
+    ptr,
+    slice, //
+};
+
+/// Callbacks for an RTKit client.
+#[vtable]
+pub trait Operations: Sync {
+    /// Called when the coprocessor has crashed, with its crash log if it sent one.
+    fn crashed(&self, _crashlog: Option<&[u8]>) {}
+
+    /// Called in process context for a message on an application endpoint.
+    ///
+    /// Messages are delivered one at a time, in the order they arrive.
+    fn recv_message(&self, _rtkit: &RtKit, _endpoint: u8, _message: u64) {}
+}
+
+/// An RTKit instance, `struct apple_rtkit`.
+///
+/// # Invariants
+///
+/// A `&RtKit` refers to an initialised `struct apple_rtkit` that stays valid for the lifetime of
+/// the reference.
+#[repr(transparent)]
+pub struct RtKit(Opaque<bindings::apple_rtkit>);
+
+// SAFETY: The C functions `RtKit` exposes may be called from any thread; the mailbox serialises
+// the messages they send.
+unsafe impl Sync for RtKit {}
+
+impl RtKit {
+    /// # Safety
+    ///
+    /// `ptr` must point to an initialised `struct apple_rtkit` that stays valid for `'a`.
+    unsafe fn from_raw<'a>(ptr: *mut bindings::apple_rtkit) -> &'a Self {
+        // SAFETY: `RtKit` is a transparent wrapper, and `ptr` is valid for `'a` by the safety
+        // requirement.
+        unsafe { &*ptr.cast() }
+    }
+
+    fn as_raw(&self) -> *mut bindings::apple_rtkit {
+        self.0.get()
+    }
+
+    /// Starts an application endpoint.
+    pub fn start_endpoint(&self, endpoint: u8) -> Result {
+        // SAFETY: `self.as_raw()` is valid by the type invariant.
+        to_result(unsafe { bindings::apple_rtkit_start_ep(self.as_raw(), endpoint) })
+    }
+
+    /// Sends a message to an endpoint.
+    pub fn send_message(&self, endpoint: u8, message: u64) -> Result {
+        // SAFETY: `self.as_raw()` is valid by the type invariant.
+        to_result(unsafe {
+            bindings::apple_rtkit_send_message(
+                self.as_raw(),
+                endpoint,
+                message,
+                ptr::null_mut(),
+                false,
+            )
+        })
+    }
+}
+
+/// An RTKit client for a bound device.
+///
+/// The handler's callbacks run until the [`Registration`] is dropped. Dropping it stops the
+/// mailbox and waits for any running callback, so the handler and anything it borrows outlive
+/// every callback.
+///
+/// # Invariants
+///
+/// Once initialised, `rtk` points to the instance `apple_rtkit_init()` created, whose cookie is a
+/// pointer to `Self`.
+#[pin_data(PinnedDrop)]
+pub struct Registration<'a, T: Operations> {
+    dev: &'a Device<Bound>,
+
+    rtk: Atomic<*mut bindings::apple_rtkit>,
+
+    #[pin]
+    handler: T,
+
+    /// RTKit holds a pointer to `Self`.
+    #[pin]
+    _pin: PhantomPinned,
+}
+
+// SAFETY: `rtk` is only used through C functions that may be called from any thread, or that
+// take `Pin<&mut Self>`.
+unsafe impl<T: Operations + Send> Send for Registration<'_, T> {}
+
+// SAFETY: As above; the handler is `Sync`.
+unsafe impl<T: Operations> Sync for Registration<'_, T> {}
+
+impl<'a, T: Operations + 'a> Registration<'a, T> {
+    const OPS: bindings::apple_rtkit_ops = bindings::apple_rtkit_ops {
+        crashed: if T::HAS_CRASHED {
+            Some(crashed_callback::<T>)
+        } else {
+            None
+        },
+        recv_message: if T::HAS_RECV_MESSAGE {
+            Some(recv_message_callback::<T>)
+        } else {
+            None
+        },
+        recv_message_early: None,
+        shmem_setup: None,
+        shmem_destroy: None,
+    };
+
+    /// Creates an RTKit client on the device's mailbox `mbox_name`, or its first mailbox.
+    ///
+    /// # Safety
+    ///
+    /// The [`Registration`] must not be forgotten (e.g. with `mem::forget()`): its destructor has
+    /// to run before `'a` ends.
+    pub unsafe fn new(
+        dev: &'a Device<Bound>,
+        mbox_name: Option<&'static CStr>,
+        handler: impl PinInit<T, Error> + 'a,
+    ) -> impl PinInit<Self, Error> + 'a {
+        // INVARIANT: `rtk` is set once `apple_rtkit_init()` succeeds, with a pointer to `Self` as
+        // the cookie.
+        try_pin_init!(&this in Self {
+            dev,
+            rtk: Atomic::new(ptr::null_mut()),
+            handler <- handler,
+            _pin: PhantomPinned,
+            _: {
+                let name = mbox_name.map_or(ptr::null(), |name| name.as_char_ptr());
+
+                // SAFETY:
+                // - `dev` is a bound device and `OPS` is static.
+                // - The cookie points to `Self`, which is pinned. Its destructor frees the
+                //   instance, waiting for running callbacks, before the memory goes away.
+                // - All fields are initialised, so a callback may run at once.
+                let rtk = from_err_ptr(unsafe {
+                    bindings::apple_rtkit_init(
+                        dev.as_raw(),
+                        this.as_ptr().cast(),
+                        name,
+                        0,
+                        &Self::OPS,
+                    )
+                })?;
+
+                // SAFETY: `this` points to `Self`, whose `rtk` is initialised.
+                unsafe { (*this.as_ptr()).rtk.store(rtk, Release) };
+            },
+        })
+    }
+}
+
+impl<T: Operations> Registration<'_, T> {
+    /// Returns the RTKit instance.
+    pub fn rtkit(&self) -> &RtKit {
+        // SAFETY: By the type invariant, `rtk` is valid until `self` is dropped.
+        unsafe { RtKit::from_raw(self.rtk.load(Relaxed)) }
+    }
+
+    /// Returns the handler.
+    pub fn handler(&self) -> &T {
+        &self.handler
+    }
+
+    /// Boots the coprocessor and waits until it is running.
+    pub fn wake(self: Pin<&mut Self>) -> Result {
+        // SAFETY: `rtk` is valid by the type invariant, and `Pin<&mut Self>` keeps power state
+        // changes exclusive.
+        to_result(unsafe { bindings::apple_rtkit_wake(self.rtk.load(Relaxed)) })
+    }
+}
+
+#[pinned_drop]
+impl<T: Operations> PinnedDrop for Registration<'_, T> {
+    fn drop(self: Pin<&mut Self>) {
+        // SAFETY: `rtk` is valid by the type invariant. This stops the mailbox and waits for
+        // running callbacks, so none can reach `self` after it returns.
+        unsafe { bindings::apple_rtkit_free(self.rtk.load(Relaxed)) };
+    }
+}
+
+/// # Safety
+///
+/// `cookie` must be the pointer [`Registration::new`] passed to `apple_rtkit_init()`.
+unsafe extern "C" fn crashed_callback<T: Operations>(
+    cookie: *mut c_void,
+    crashlog: *const c_void,
+    size: usize,
+) {
+    // SAFETY: By the safety requirement, `cookie` points to a live `Registration<'_, T>`.
+    let reg = unsafe { &*cookie.cast::<Registration<'_, T>>() };
+
+    let crashlog = (!crashlog.is_null() && size > 0)
+        // SAFETY: RTKit passes a crash log of `size` bytes, valid for the call.
+        .then(|| unsafe { slice::from_raw_parts(crashlog.cast::<u8>(), size) });
+
+    reg.handler.crashed(crashlog);
+}
+
+/// # Safety
+///
+/// `cookie` must be the pointer [`Registration::new`] passed to `apple_rtkit_init()`.
+unsafe extern "C" fn recv_message_callback<T: Operations>(
+    cookie: *mut c_void,
+    endpoint: u8,
+    message: u64,
+) {
+    // SAFETY: By the safety requirement, `cookie` points to a live `Registration<'_, T>`.
+    let reg = unsafe { &*cookie.cast::<Registration<'_, T>>() };
+
+    // Messages can arrive as soon as the mailbox starts, before `apple_rtkit_init()` returns.
+    // No application endpoint has been started then, so there is nothing to deliver to.
+    let rtk = reg.rtk.load(Acquire);
+    if rtk.is_null() {
+        dev_warn!(
+            reg.dev,
+            "RTKit: early message to EP{endpoint:02x}: {message:#x}\n"
+        );
+        return;
+    }
+
+    // SAFETY: `rtk` is valid while `reg` is.
+    let rtkit = unsafe { RtKit::from_raw(rtk) };
+    reg.handler.recv_message(rtkit, endpoint, message);
+}
