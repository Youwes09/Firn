+		core_clear32(atcphy, ACIOPHY_BIST_MAC_USBPHY_CFG_OV2, masks[i]);
+		err = atcphy_t8130_bist_latch(atcphy);
+		if (!ret)
+			ret = err;
+	}
+	core_clear32(atcphy, ACIOPHY_BIST_CFG1, ACIOPHY_BIST_CFG1_CLOCK_EN);
+	return ret;
+}
