From 898454317e15dabb6f3d61056ad922810024a6f1 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Fri, 30 Oct 2026 18:44:50 -0500
Subject: [PATCH] HID: dockchannel: Free the work item on a bad sub-header
 length

dchid_packet_work() returned without freeing the work item when the
sub-header length exceeded the packet. Free it on that path as well.

From Gravity Linux d4e7c10c30b61, which integrates Niklas Sheth's
bits/090-spi-hid.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 drivers/hid/dockchannel-hid/dockchannel-hid.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid.c b/drivers/hid/dockchannel-hid/dockchannel-hid.c
index 76bb5f70f368..0639a3097d9e 100644
--- a/drivers/hid/dockchannel-hid/dockchannel-hid.c
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid.c
@@ -1126,7 +1126,7 @@ static void dchid_packet_work(struct work_struct *ws)
 	if (shdr->length + sizeof(*shdr) > work->hdr.length) {
 		dev_err(dchid->dev, "Bad sub header length (%hu > %zu)\n",
 			shdr->length, work->hdr.length - sizeof(*shdr));
-		return;
+		goto done;
 	}
 
 	switch (type) {
@@ -1141,6 +1141,7 @@ static void dchid_packet_work(struct work_struct *ws)
 		break;
 	}
 
+done:
 	kfree(work);
 }
 
