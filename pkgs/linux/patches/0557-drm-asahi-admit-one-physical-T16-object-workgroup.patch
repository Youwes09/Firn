From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Mon, 19 Oct 2026 14:43:49 -0400
Subject: [PATCH] drm/asahi: admit one physical T16 object workgroup

The paired compiler expands the taskless object to physical T16 and now dispatches 16 total and local threads. The old all-ones admission rule rejected this stream before native Work publication.

Keep the working scalar research carrier and admit matching (16,1,1) total/local dimensions. Reject other shapes, mismatches, extra workgroups and truncation. The parser remains reachable only with native_mesh=1; ordinary serialization and the UAPI are unchanged.

Add host coverage of both dispatch widths and their rejection boundary. Based on the minimal admission patch and candidate-A captures from codex-hw.
---
 drivers/gpu/drm/asahi/README.native-mesh.md   |  7 +++-
 drivers/gpu/drm/asahi/g16_mesh.rs             | 13 +++---
 .../drivers/gpu/asahi/native-mesh.rs          | 40 ++++++++++++++++++-
 3 files changed, 52 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/asahi/README.native-mesh.md b/drivers/gpu/drm/asahi/README.native-mesh.md
index d1dfcfd8d464..10753e368f77 100644
--- a/drivers/gpu/drm/asahi/README.native-mesh.md
+++ b/drivers/gpu/drm/asahi/README.native-mesh.md
@@ -6,7 +6,7 @@ is provided. The paired stream starts with complete native object/mesh state.
 The decoder runs only with the option enabled; ordinary streams are identified
 by their first packet, without searching their contents for native state.
 
-The admitted class has T16 mesh execution, one direct object invocation,
+The admitted class has T16 mesh execution, one direct object workgroup,
 four-vertex storage and one triangle primitive. It supports 4–128 per-vertex
 32-bit scalar components, including XYZW. The two scalar counts and output-row
 count must agree: N components, N+1 rows, with no reserved upper bits. This
@@ -16,6 +16,11 @@ per-primitive outputs, culling, multiple draws, indirect draws and wider
 resource classes remain rejected. Single-sample, single-layer restrictions
 also remain in the runtime.
 
+Object dispatch total and local thread dimensions must match, and must be
+either (1,1,1) for the existing scalar carrier or (16,1,1) for physical T16.
+The mesh execution width in the state packet does not set the object dispatch
+width. Mismatched dimensions, other shapes and multiple workgroups are rejected.
+
 This is bounded resource-class admission, not validation of arbitrary shader
 programs. Launches and their local-allocation instructions remain userspace
 programs; the kernel does not assume a compiler-specific instruction sequence
diff --git a/drivers/gpu/drm/asahi/g16_mesh.rs b/drivers/gpu/drm/asahi/g16_mesh.rs
index c30dfb9749c1..55bcc650bf95 100644
--- a/drivers/gpu/drm/asahi/g16_mesh.rs
+++ b/drivers/gpu/drm/asahi/g16_mesh.rs
@@ -34,7 +34,7 @@ pub(crate) enum DecodeError {
 }
 
 /// Admit the paired T16 class: four vertices' storage, one primitive and one
-/// direct object invocation, with position and up to 124 per-vertex scalars.
+/// direct object workgroup, with position and up to 124 per-vertex scalars.
 /// Primitive outputs, task payload and wider resource classes remain excluded.
 /// The packet budget bounds malformed streams, including a missing terminator.
 pub(crate) fn decode(
@@ -100,11 +100,12 @@ pub(crate) fn decode(
             }
             1 if word & !0x2000_0013 == 0 => {} // G16 coherency barrier
             3 if word == 0x7000_0600 && !drew => {
-                // Direct object grid and local dimensions, three words each.
-                for _ in 0..6 {
-                    if next()? != 1 {
-                        return Err(DecodeError::Unsupported);
-                    }
+                // Exactly one object workgroup: total threads equal local
+                // threads. Keep the scalar carrier and admit physical T16.
+                let total = [next()?, next()?, next()?];
+                let local = [next()?, next()?, next()?];
+                if total != local || (local != [1, 1, 1] && local != [16, 1, 1]) {
+                    return Err(DecodeError::Unsupported);
                 }
                 drew = true;
             }
diff --git a/tools/testing/selftests/drivers/gpu/asahi/native-mesh.rs b/tools/testing/selftests/drivers/gpu/asahi/native-mesh.rs
index 5b99fc3395d7..1866e43093bf 100644
--- a/tools/testing/selftests/drivers/gpu/asahi/native-mesh.rs
+++ b/tools/testing/selftests/drivers/gpu/asahi/native-mesh.rs
@@ -3,7 +3,7 @@
 use g16_mesh::{DecodeError, Profile};
 
 fn stream() -> Vec<u32> {
-    // Source-authored T16, position-only state and direct one-group draw.
+    // T16 mesh state with the research carrier's scalar object dispatch.
     vec![
         0x40000d2c, 0x504, 0x10, 0, 0, 0x01000000, 0x22224, 0x01000000, 0x22220, 1, 0, 0x400810, 0,
         5, 0x500, 0x4001000, 0x20000013, 0x70000600, 1, 1, 1, 1, 1, 1, 0xc0000000,
@@ -33,6 +33,44 @@ fn native_packets_are_relocatable_and_bounded() {
     assert_eq!(decode(&words, 0x1004000000), Err(DecodeError::Unsupported));
 }
 
+#[test]
+fn object_dispatch_is_one_scalar_or_physical_t16_workgroup() {
+    for base in [0x1004000000, 0x10d1233ffc] {
+        for width in [1, 16] {
+            let mut words = stream();
+            words[18] = width;
+            words[21] = width;
+            assert_eq!(decode(&words, base), Ok(Some(Profile { payload: 0 })));
+            for len in 0..words.len() {
+                assert!(decode(&words[..len], base).is_err(), "truncated at {len}");
+            }
+            for index in 18..24 {
+                for value in [0, 1, 2, 15, 16, 17, 32, u32::MAX] {
+                    if value == words[index] {
+                        continue;
+                    }
+                    let mut bad = words.clone();
+                    bad[index] = value;
+                    assert_eq!(decode(&bad, base), Err(DecodeError::Unsupported));
+                }
+            }
+            // Matching total/local dimensions alone must not widen the class.
+            for dimensions in [
+                [2, 1, 1], [32, 1, 1], [1, 16, 1], [1, 1, 16], [16, 2, 1], [16, 1, 2],
+            ] {
+                let mut bad = words.clone();
+                bad[18..21].copy_from_slice(&dimensions);
+                bad[21..24].copy_from_slice(&dimensions);
+                assert_eq!(decode(&bad, base), Err(DecodeError::Unsupported));
+            }
+            let mut twice = words.clone();
+            twice.pop();
+            twice.extend_from_slice(&words[17..]);
+            assert_eq!(decode(&twice, base), Err(DecodeError::Unsupported));
+        }
+    }
+}
+
 #[test]
 fn ordinary_data_is_not_searched_for_mesh_magic() {
     let words = [0x4000002e, 0x40000d2c, 0x504, 0x10];
