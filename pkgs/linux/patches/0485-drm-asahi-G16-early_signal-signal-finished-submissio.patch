@@ -246,6 +255,7 @@ pub(crate) fn register<'a>(
         _profile: profile,
         _maint: maint,
         _queue_cap: queue_cap,
+        _early: early,
         _lane_cap: lane_cap,
         _debugfs: dir, });
     let device = drm::UnregisteredDevice::<Driver>::new(pdev, data)?;
@@ -1441,6 +1451,54 @@ fn run(this: Arc<Self>) {
                     }
                     progress = true;
                 }
+                Ok(progress)
+            })();
+            // Signal every finished job before admitting more work, with the
+            // locks dropped: a completed fence must not wait behind a
+            // publication pass. Upstream signals from its event path.
+            let mut finished = KVec::new();
+            if result.is_ok()
+                && crate::g16_timeline::EARLY_SIGNAL.load(Ordering::Relaxed) == 1
+                && finished.reserve(engine.jobs.len(), GFP_KERNEL).is_ok()
+            {
+                let mut index = 0;
+                while index < engine.jobs.len() {
+                    let j = &engine.jobs[index];
+                    if j.pending == 0
+                        && (j.error.is_some() || j.next == j.execution.parameters.len())
+                    {
+                        let job = engine.jobs.remove(index).expect("index in range");
+                        finished
+                            .push_within_capacity(job)
+                            .map_err(|_| ())
+                            .expect("reserved for every job");
+                    } else {
+                        index += 1;
+                    }
+                }
+                // Removal shifts later entries; keep the admission cursor valid.
+                if engine.cursor > engine.jobs.len() {
+                    engine.cursor = 0;
+                }
+            }
+            let signalled = !finished.is_empty();
+            if signalled {
+                drop(runtime);
+                drop(engine);
+                for job in finished.drain_all() {
+                    if let Some(ring) = &this.device.timeline {
+                        trace_record(ring, &job);
+                    }
+                    if let Some(error) = job.error {
+                        job.execution.completion.set_error(error);
+                    }
+                    let _ = job.execution.completion.signal();
+                }
+                engine = this.device.engine.lock();
+                runtime = this.device.runtime.lock();
+            }
+            let result = result.and_then(|progress| (|| -> Result<bool> {
+                let mut progress = progress || signalled;
                 let mut admitted = 0;
                 loop {
                     let previous = admitted;
@@ -1561,7 +1619,7 @@ fn run(this: Arc<Self>) {
                     }
                 }
                 Ok(progress)
-            })();
+            })());
             if let Err(error) = result {
                 pr_err!(
                     "G16: submission pipeline failed: {:?}, {} jobs, {} issued\n",
@@ -1584,6 +1642,45 @@ fn run(this: Arc<Self>) {
                 }
                 return;
             }
+            // early_signal=2: publish first (above), then signal every
+            // finished job in one batch with the locks dropped.
+            if crate::g16_timeline::EARLY_SIGNAL.load(Ordering::Relaxed) == 2 {
+                let mut finished = KVec::new();
+                if finished.reserve(engine.jobs.len(), GFP_KERNEL).is_ok() {
+                    let mut index = 0;
+                    while index < engine.jobs.len() {
+                        let j = &engine.jobs[index];
+                        if j.pending == 0
+                            && (j.error.is_some() || j.next == j.execution.parameters.len())
+                        {
+                            let job = engine.jobs.remove(index).expect("index in range");
+                            finished
+                                .push_within_capacity(job)
+                                .map_err(|_| ())
+                                .expect("reserved for every job");
+                        } else {
+                            index += 1;
+                        }
+                    }
+                    if engine.cursor > engine.jobs.len() {
+                        engine.cursor = 0;
+                    }
+                }
+                if !finished.is_empty() {
+                    drop(runtime);
+                    drop(engine);
+                    for job in finished.drain_all() {
+                        if let Some(ring) = &this.device.timeline {
+                            trace_record(ring, &job);
+                        }
+                        if let Some(error) = job.error {
+                            job.execution.completion.set_error(error);
+                        }
+                        let _ = job.execution.completion.signal();
+                    }
+                    continue;
+                }
+            }
             if let Some(index) = engine.jobs.iter().position(|j| {
                 j.pending == 0 && (j.error.is_some() || j.next == j.execution.parameters.len())
             }) {
diff --git a/drivers/gpu/drm/asahi/g16_runtime.rs b/drivers/gpu/drm/asahi/g16_runtime.rs
index 7145d77c09fb..8a02e007bc94 100644
--- a/drivers/gpu/drm/asahi/g16_runtime.rs
+++ b/drivers/gpu/drm/asahi/g16_runtime.rs
@@ -192,18 +192,24 @@ fn event(&self, stage: u32) -> Result<u32> {
 
 /// Firmware words read once per retirement scan (per-lane stamps and ring
 /// cursors are shared by every flight on the lane).
+/// A fixed table on the stack: no allocation per scan. Words beyond its
+/// capacity are read directly.
 #[derive(Default)]
 struct WordSnapshot {
-    words: KVec<(u64, u32)>,
+    words: [(u64, u32); 32],
+    len: usize,
 }
 
 impl WordSnapshot {
     fn read(&mut self, fw: &g16_vm::FirmwareSpace, address: u64) -> Result<u32> {
-        if let Some(&(_, value)) = self.words.iter().find(|(a, _)| *a == address) {
+        if let Some(&(_, value)) = self.words[..self.len].iter().find(|(a, _)| *a == address) {
             return Ok(value);
         }
         let value = fw.read_u32(address)?;
-        self.words.push((address, value), GFP_KERNEL)?;
+        if self.len < self.words.len() {
+            self.words[self.len] = (address, value);
+            self.len += 1;
+        }
         Ok(value)
     }
 }
diff --git a/drivers/gpu/drm/asahi/g16_timeline.rs b/drivers/gpu/drm/asahi/g16_timeline.rs
index fea0f14be804..6a4d7b28e743 100644
--- a/drivers/gpu/drm/asahi/g16_timeline.rs
+++ b/drivers/gpu/drm/asahi/g16_timeline.rs
@@ -310,3 +310,44 @@ pub(crate) fn init_caps(queue: u32, lane: u32) -> Result {
     LANE_CAP.store(lane, core::sync::atomic::Ordering::Relaxed);
     Ok(())
 }
+
+/// Signal finished jobs before each admission pass (asahi_m4.early_signal,
+/// runtime: debugfs `asahi_m4/early_signal`). 0 restores signalling one job
+/// per pump pass after admission.
+pub(crate) static EARLY_SIGNAL: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(1);
+
+/// A 0/1 debugfs switch over a static.
+pub(crate) struct FlagKnob {
+    cell: &'static core::sync::atomic::AtomicU32,
+    name: &'static str,
+}
+
+impl FlagKnob {
+    pub(crate) const EARLY_SIGNAL: Self = Self { cell: &EARLY_SIGNAL, name: "early_signal" };
+}
+
+impl kernel::debugfs::Writer for FlagKnob {
+    fn write(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        writeln!(f, "{}", self.cell.load(core::sync::atomic::Ordering::Relaxed))
+    }
+}
+
+impl kernel::debugfs::Reader for FlagKnob {
+    fn read_from_slice(&self, reader: &mut kernel::uaccess::UserSliceReader) -> Result {
+        let mut buf = [0u8; 8];
+        let n = reader.len();
+        if n == 0 || n > buf.len() {
+            return Err(EINVAL);
+        }
+        reader.read_slice(&mut buf[..n])?;
+        let value = match core::str::from_utf8(&buf[..n]).map_err(|_| EINVAL)?.trim() {
+            "0" => 0,
+            "1" => 1,
+            "2" if self.name == "early_signal" => 2,
+            _ => return Err(EINVAL),
+        };
+        self.cell.store(value, core::sync::atomic::Ordering::Relaxed);
+        pr_info!("G16: {}={}\n", self.name, value);
+        Ok(())
+    }
+}
