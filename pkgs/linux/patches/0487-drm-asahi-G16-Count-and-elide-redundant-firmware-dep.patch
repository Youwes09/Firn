diff --git a/drivers/gpu/drm/asahi/g16_runtime.rs b/drivers/gpu/drm/asahi/g16_runtime.rs
index 8a02e007bc94..07ac4d3bb74d 100644
--- a/drivers/gpu/drm/asahi/g16_runtime.rs
+++ b/drivers/gpu/drm/asahi/g16_runtime.rs
@@ -31,6 +31,9 @@ pub(crate) struct FirmwareQueues {
     /// Render Works counted into the queue's shared notifier (two per render).
     notified_works: u32,
     pub(crate) last: [Option<Stamp>; 2],
+    /// Per lane (TA, 3D, compute), the latest stamps its published Works
+    /// waited on as firmware items, keyed by address (dep_elide bit 4).
+    waited: [[Option<Stamp>; 2]; 3],
     /// Kernel-side dependency resolution statistics (logged at teardown with
     /// dep_stats=1).
     deps: DependencyStats,
@@ -97,6 +100,20 @@ fn drop(&mut self) {
     }
 }
 
+impl FirmwareQueues {
+    /// Remember that a published Work on `lane` waited on `dep` (a field-level
+    /// borrow, usable while the queue's lanes are borrowed).
+    fn note_wait(waited: &mut [[Option<Stamp>; 2]; 3], lane: usize, dep: Stamp) {
+        let slots = &mut waited[lane];
+        if let Some(s) = slots.iter_mut().find(|s| s.is_some_and(|w| w.address == dep.address)) {
+            *s = Some(dep);
+        } else {
+            slots[1] = slots[0];
+            slots[0] = Some(dep);
+        }
+    }
+}
+
 #[derive(Clone, Copy)]
 struct Lane {
     queue: u64,
@@ -181,6 +198,7 @@ pub(crate) fn new(priority: u32) -> Self {
             compute_count: crate::module_parameters::fw_counter_start.value(),
             notified_works: 0,
             last: [None; 2],
+            waited: [[None; 2]; 3],
             deps: DependencyStats::default(),
         }
     }
@@ -1905,6 +1923,45 @@ fn drain_trace_rx(&mut self) -> Result {
     /// let the worker retry after the next completion. The render then
     /// reaches the firmware with no dependency items; its internal TA-to-3D
     /// link is unchanged. render_deps=0 keeps the items.
+    /// dep_elide: count the item and decide whether to drop it.
+    fn elide_item(&self, queue: &FirmwareQueues, lane: usize, dep: &Stamp, same_lane: bool) -> Result<bool> {
+        use crate::g16_timeline as t;
+        let mode = t::DEP_ELIDE.load(Ordering::Relaxed);
+        t::DEP_ITEMS.fetch_add(1, Ordering::Relaxed);
+        let drop = if same_lane {
+            t::DEP_SAME_LANE.fetch_add(1, Ordering::Relaxed);
+            mode & 1 != 0
+        } else if queue.waited[lane]
+            .iter()
+            .flatten()
+            .any(|w| w.address == dep.address && g16_stamp::reached(w.value, dep.value))
+        {
+            t::DEP_REPEAT.fetch_add(1, Ordering::Relaxed);
+            mode & 4 != 0
+        } else if mode & 2 != 0 {
+            let fw = self._firmware_space.as_ref().ok_or(EIO)?;
+            let reached = g16_stamp::reached(fw.read_u32(dep.address)?, dep.value);
+            if reached {
+                t::DEP_REACHED.fetch_add(1, Ordering::Relaxed);
+            }
+            reached
+        } else {
+            false
+        };
+        if drop {
+            t::DEP_DROPPED.fetch_add(1, Ordering::Relaxed);
+        }
+        Ok(drop)
+    }
+
+    /// The lane a render's dependency item sits on: slot 0 (render) on the
+    /// fragment lane with a fragment barrier, else the tiling lane.
+    fn render_item_lane(params: &render::Parameters, slot: usize) -> usize {
+        let fragment = params.vdm_barrier_fragment
+            || crate::module_parameters::render_barrier.value() & 1 != 0;
+        usize::from(slot == 0 && fragment)
+    }
+
     fn resolve_render_dependencies(
         &self,
         queue: &mut FirmwareQueues,
@@ -1912,7 +1969,18 @@ fn resolve_render_dependencies(
         dependencies: &[Option<Stamp>; 2],
     ) -> Result<[Option<Stamp>; 2]> {
         if crate::module_parameters::render_deps.value() == 0 {
-            return Ok(*dependencies);
+            crate::g16_timeline::DEP_WORKS.fetch_add(1, Ordering::Relaxed);
+            let own_fragment = queue.lanes.as_ref().map(|lanes| lanes[1].firmware_stamp());
+            let mut kept = *dependencies;
+            for (slot, dep) in dependencies.iter().enumerate() {
+                let Some(dep) = dep else { continue };
+                let lane = Self::render_item_lane(params, slot);
+                let same_lane = lane == 1 && own_fragment == Some(dep.address);
+                if self.elide_item(queue, lane, dep, same_lane)? {
+                    kept[slot] = None;
+                }
+            }
+            return Ok(kept);
         }
         let fragment_stage = params.vdm_barrier_fragment
             || crate::module_parameters::render_barrier.value() & 1 != 0;
@@ -2336,6 +2404,11 @@ fn submit_render_pool(
         };
         let receipt = Receipt { id: va, stamp };
         queue.last[0] = Some(stamp);
+        for (slot, dep) in dependencies.iter().enumerate() {
+            if let Some(dep) = dep {
+                FirmwareQueues::note_wait(&mut queue.waited, Self::render_item_lane(&params, slot), *dep);
+            }
+        }
         queue.pending += 1;
         self.flights.push(
             Flight {
@@ -2601,10 +2674,13 @@ fn resolve_compute_dependencies(
         let keep_own_render = crate::module_parameters::compute_deps.value() == 2;
         let mut kept = [None; 2];
         let fw = self._firmware_space.as_ref().ok_or(EIO)?;
+        crate::g16_timeline::DEP_WORKS.fetch_add(1, Ordering::Relaxed);
         for (slot, dep) in dependencies.iter().enumerate() {
             let Some(dep) = dep else { continue };
             if keep_own_render && own_render.is_some_and(|r| r.contains(&dep.address)) {
-                kept[slot] = Some(*dep);
+                if !self.elide_item(queue, 2, dep, false)? {
+                    kept[slot] = Some(*dep);
+                }
                 continue;
             }
             if own_lane != Some(dep.address) {
@@ -2781,6 +2857,9 @@ fn submit_compute_queue(
         };
         let pointers = lane.pointers;
         queue.last[1] = Some(stamp);
+        for dep in dependencies.iter().flatten() {
+            FirmwareQueues::note_wait(&mut queue.waited, 2, *dep);
+        }
         queue.pending += 1;
         self.flights.push(
             Flight {
diff --git a/drivers/gpu/drm/asahi/g16_timeline.rs b/drivers/gpu/drm/asahi/g16_timeline.rs
index 2f71e9e504ef..ef238c8f8e42 100644
--- a/drivers/gpu/drm/asahi/g16_timeline.rs
+++ b/drivers/gpu/drm/asahi/g16_timeline.rs
@@ -325,11 +325,13 @@ pub(crate) fn init_caps(queue: u32, lane: u32) -> Result {
 pub(crate) struct FlagKnob {
     cell: &'static core::sync::atomic::AtomicU32,
     name: &'static str,
+    max: u32,
 }
 
 impl FlagKnob {
-    pub(crate) const EARLY_SIGNAL: Self = Self { cell: &EARLY_SIGNAL, name: "early_signal" };
-    pub(crate) const PROFILE: Self = Self { cell: &PROFILE, name: "profile" };
+    pub(crate) const EARLY_SIGNAL: Self = Self { cell: &EARLY_SIGNAL, name: "early_signal", max: 2 };
+    pub(crate) const PROFILE: Self = Self { cell: &PROFILE, name: "profile", max: 1 };
+    pub(crate) const DEP_ELIDE: Self = Self { cell: &DEP_ELIDE, name: "dep_elide", max: 7 };
 }
 
 impl kernel::debugfs::Writer for FlagKnob {
@@ -346,14 +348,51 @@ fn read_from_slice(&self, reader: &mut kernel::uaccess::UserSliceReader) -> Resu
             return Err(EINVAL);
         }
         reader.read_slice(&mut buf[..n])?;
-        let value = match core::str::from_utf8(&buf[..n]).map_err(|_| EINVAL)?.trim() {
-            "0" => 0,
-            "1" => 1,
-            "2" if self.name == "early_signal" => 2,
-            _ => return Err(EINVAL),
-        };
+        let value: u32 = core::str::from_utf8(&buf[..n])
+            .map_err(|_| EINVAL)?
+            .trim()
+            .parse()
+            .map_err(|_| EINVAL)?;
+        if value > self.max {
+            return Err(EINVAL);
+        }
         self.cell.store(value, core::sync::atomic::Ordering::Relaxed);
         pr_info!("G16: {}={}\n", self.name, value);
         Ok(())
     }
 }
+
+/// Firmware dependency-item elision (asahi_m4.dep_elide, runtime: debugfs
+/// `asahi_m4/dep_elide`), a bitmask. An item is redundant when:
+/// 1: it waits on the same lane's earlier Work (lane order implies it);
+/// 2: its stamp has already been reached at publish (costs a firmware read);
+/// 4: this lane's previous Work already waited on that stamp or a later one
+///    (Works on a lane start in order).
+/// Counters in debugfs `asahi_m4/dep_stats` (category 2 only while bit 2 is set).
+pub(crate) static DEP_ELIDE: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(0);
+pub(crate) static DEP_ITEMS: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+pub(crate) static DEP_SAME_LANE: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+pub(crate) static DEP_REACHED: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+pub(crate) static DEP_REPEAT: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+pub(crate) static DEP_DROPPED: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+pub(crate) static DEP_WORKS: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+
+/// The debugfs view of the dependency-item counters.
+pub(crate) struct DepStats;
+
+impl kernel::debugfs::Writer for DepStats {
+    fn write(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        use core::sync::atomic::Ordering::Relaxed;
+        writeln!(
+            f,
+            "works {}\nitems {}\nsame_lane {}\nrepeat {}\nreached {}\ndropped {}\ndep_elide {}",
+            DEP_WORKS.load(Relaxed),
+            DEP_ITEMS.load(Relaxed),
+            DEP_SAME_LANE.load(Relaxed),
+            DEP_REPEAT.load(Relaxed),
+            DEP_REACHED.load(Relaxed),
+            DEP_DROPPED.load(Relaxed),
+            DEP_ELIDE.load(Relaxed)
+        )
+    }
+}
