+        let mut bad=boot(&r);bad.write64(r.regions[1].base+24,target|3)?;
+        let before=bad.snapshot(&ranges(&r));assert!(Vm::build_g16c(&mut bad,&r,&image).is_err());assert_eq!(before,bad.snapshot(&ranges(&r)));
