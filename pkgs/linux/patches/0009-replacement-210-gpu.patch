+ OK(fd,DRM_IOCTL_ASAHI_QUEUE_CREATE,&q[0]);OK(fd,DRM_IOCTL_ASAHI_QUEUE_CREATE,&q[1]);
+ struct image *images=calloc(generations,sizeof(*images));CHECK(images);uint32_t handles[128]={0};
+ for(unsigned i=0;i<h[2];i++) {
