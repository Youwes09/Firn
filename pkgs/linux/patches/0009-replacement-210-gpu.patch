diff --git a/drivers/gpu/drm/asahi/scheduled_compute_preparation.rs b/drivers/gpu/drm/asahi/scheduled_compute_preparation.rs
new file mode 100644
index 0000000000000..5afeebde057e5
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_compute_preparation.rs
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! Wrapped submission-entry encoding for the common immutable preparation pass.
+//! This module owns bytes only: no Session lock, live memory or producer writes.
+
+use super::{PreparationSeed,PreparedWork};
+use super::super::g17p_compute::{self as protocol,work};
+use kernel::prelude::*;
+const PAGE:usize=0x4000;
+
+#[derive(Clone,Copy,PartialEq,Eq)]
+pub(crate) struct WrappedSeed {
+    pub(crate) context:u16,
+    pub(crate) root:u64,
+    pub(crate) queue:u64,
+    pub(crate) queue_control:u64,
+    pub(crate) uuid:u16,
+    pub(crate) queue_ordinal:u32,
+    pub(crate) support_ordinal:u32,
+    pub(crate) support:u64,
+    pub(crate) save:u64,
+    pub(crate) robustness:u64,
+    pub(crate) operand_state:u64,
+    pub(crate) save_slot:usize,
+}
+pub(super) struct WrappedWork {
+    pub(super) wrapper:[u8;0xc0],
+    pub(super) marker:[u8;0x40],
+    pub(super) scheduler:[u8;0x100],
+}
+impl WrappedSeed {
+    pub(super) fn prepare(self,seed:PreparationSeed)->Result<KBox<PreparedWork>> {
+        let l=seed.layout;let sequence=seed.ordinal;let command=sequence%256;
+        let p=&seed.parameters;let event=l.grid;let stamp=sequence.wrapping_add(1).wrapping_shl(8);
+        let command_save=self.save;let command_robustness=self.robustness;
+        let scheduler_address=l.scheduler(command);let scheduler_slot=l.scheduler_slot(command);
+        let descriptor_address=l.descriptor(sequence%240);let alias=l.descriptor_low(sequence%240);
+        let status=l.status(command);let driver_address=l.dispatch(command)[0];
+        let namespace=self.context.checked_sub(1).ok_or(EIO)?;
+        let support_ordinal=self.support_ordinal;
+        let identity=((u64::from(self.uuid))<<32)|0xc0|u64::from(self.context);
+        let program = protocol::ProgramG16C {
+            preempt: command_save,
+            cdm: p.cdm,
+            identity,
+            context: self.context as u32,
+            ordinal: support_ordinal & 255,
+            robustness: command_robustness,
+            operand_state: self.operand_state,
+            usc_exec_base: Some(1 << 40),
+            helper_binary: 0,
+            helper_data: 0,
+            helper_cfg: 0,
+            // Our live-pool reservation uses context-1. This is a host policy,
+            // not an inherent firmware association between bank and ASID.
+            execution_gate: u64::from(self.context - 1),
+            register_a599: 0x13200400020,
+        }.build()
+        .map_err(|_| EINVAL)?;
+        let mut descriptor=KVVec::with_capacity(PAGE,GFP_KERNEL)?;
+        descriptor.resize(PAGE,0,GFP_KERNEL)?;
+        protocol::DescriptorG16C {
+                save_area: command_save,
+                cdm: p.cdm,
+                identity,
+                sequence: u64::from(support_ordinal),
+                context: self.context as u32,
+                scheduler: scheduler_address,
+                low_alias: alias,
+                cdm_terminator: p.end.checked_sub(4).ok_or(EINVAL)?,
+                sampler_array: p.sampler,
+                sampler_count: p.sampler_count,
+                // Shared Neo names: dispatch = completion stamps; status = internal timestamps.
+                dispatch: [driver_address, self.queue + 0x1040],
+                grid: u32::from(event),
+                queue_submission: stamp >> 8,
+                queue_ordinal: 0,
+                submission_index: sequence.checked_add(1).ok_or(EOVERFLOW)?,
+                ordinal: support_ordinal,
+                status: [status, status + 8],
+                timestamps: p.timestamps,
+                shared_control: self.support,
+                support_control: 0x6c000001,
+                support_flags: 6,
+                support_kind: 0x45f,
+                support_phase: 1,
+                zero_page: l.completion_scratch(command),
+            }.build(&mut descriptor,program.registers())
+        .map_err(|_| EINVAL)?;
+
+        let wrapper = work::ComputeWrapperG16C::new(&work::WrapperParameters {
+            scratch_low: l.context_low(),
+            scratch_high: l.context(),
+            support: self.support,
+            queue_control: self.queue_control,
+            grid: u16::from(event),
+            item: self.queue_ordinal as u16 & 255,
+            ordinal: self.queue_ordinal as u16,
+            context: self.context,
+            support_id: namespace,
+            uuid: self.uuid,
+            scheduler: seed.priority as u16,
+            scheduler_hint: 0,
+            first: sequence == 0,
+            field_52: u16::from(self.queue_ordinal == 0),
+            field_5e: 2,
+            field_62: u16::from(self.queue_ordinal == 0),
+        })
+        .map_err(|_| EINVAL)?;
+
+        let mut end = [0u8; 0x40];
+        end[..4].copy_from_slice(&16u32.to_le_bytes());
+        end[4..8].copy_from_slice(&(((sequence.wrapping_add(1) & 0xffff) << 16) | u32::from(event)).to_le_bytes());
+        end[8..16].copy_from_slice(
+            &(0x00fe000000000000u64 | ((sequence as u64 + 1) >> 16)).to_le_bytes(),
+        );
+
+        let mut points=[(event,sequence);4];let mut point_count=1;
+        for &point in &seed.dependencies[..seed.dependency_count] {
+            if point.0>=128 || point.1>=1<<30 || (point.0==event && point.1>sequence) {return Err(EIO);}
+            points[point_count]=point;point_count+=1;
+        }
+        let mut record = work::ComputeRecordG16C::new(&work::RecordParametersG16C {
+            descriptor: descriptor_address,
+            queue: self.queue,
+            grid: event,
+            item: sequence,
+            primary_count: (program.registers().len() - 2) as u16,
+            control: 0x0800 | namespace,
+            retire_control: 2,
+            ..Default::default()
+        })
+        .map_err(|_| EINVAL)?;
+        record.append_dependencies(&points[..point_count]).map_err(|_|EINVAL)?;
+
+        let mut context=KVVec::with_capacity(0x200,GFP_KERNEL)?;
+        context.resize(0x200,0,GFP_KERNEL)?;context.copy_from_slice(record.as_bytes());
+        let wrapped=WrappedWork {
+            wrapper:wrapper.as_bytes().try_into().map_err(|_|EINVAL)?, marker:end,
+            scheduler:work::ComputeSchedulerG16C::for_compute(scheduler_slot,support_ordinal)
+                .as_bytes().try_into().map_err(|_|EINVAL)?,
+        };
+        Ok(KBox::new(PreparedWork {seed,descriptor,context,optional:None,wrapped:Some(wrapped)},GFP_KERNEL)?)
+    }
+}
diff --git a/drivers/gpu/drm/asahi/scheduled_compute_queue.rs b/drivers/gpu/drm/asahi/scheduled_compute_queue.rs
new file mode 100644
index 0000000000000..42ce1f5999b16
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_compute_queue.rs
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! G16C wire geometry for the common retained compute generation.
+//! Selection, leases, root replacement and transport rotation stay in Queues.
+
+use super::{Client, Layout, Memory, Parameters, Vm, WrappedSeed};
+use super::super::{
+    g17p_compute_runtime::client_storage,
+    g17p_queue as q,
+    scheduled_dispatch::DispatchStateG16C,
+    scheduled_operands as operands,
+};
+use kernel::prelude::*;
+const PAGE:u64=0x4000;
+const DISPATCH:u64=0xfffffc2001550000;
+const SAVE_STRIDE:u64=0x78000;
+
+#[derive(Clone,Copy,PartialEq,Eq)]
+pub(crate) struct PrivateLayout {
+    pub(crate) base:u64,
+    pub(crate) table:u64,
+    pub(crate) state:u64,
+    pub(crate) buffers:u64,
+    pub(crate) save:u64,
+    pub(crate) robustness:u64,
+    pub(crate) end:u64,
+}
+impl PrivateLayout {
+    pub(crate) fn new(p:&Parameters)->Result<Self> {
+        let base=p.preempt;
+        let table=base.checked_add(operands::DIRECTORY_SIZE+2*PAGE).ok_or(EOVERFLOW)?;
+        let state=table.checked_add(operands::TABLE_SIZE+2*PAGE).ok_or(EOVERFLOW)?;
+        let buffers=state.checked_add(0x80000).ok_or(EOVERFLOW)?;
+        let save=buffers.checked_add(u64::from(operands::INITIAL_BUFFERS)*operands::BUFFER_STRIDE+0x80000).ok_or(EOVERFLOW)?;
+        let robustness=save.checked_add(256*SAVE_STRIDE).ok_or(EOVERFLOW)?;
+        let end=robustness.checked_add(PAGE).ok_or(EOVERFLOW)?;
+        if base<PAGE || base&(PAGE-1)!=0 || end>p.kernel_end || p.kernel_end>1<<42 {return Err(EINVAL);}
+        Ok(Self {base,table,state,buffers,save,robustness,end})
+    }
+    pub(crate) fn offsets(&self)->Result<KVec<u64>> {
+        let mut offsets=KVec::new();
+        for (address,size) in [(self.base,operands::DIRECTORY_SIZE),(self.table,operands::TABLE_SIZE),
+            (self.state,0x7c000),(self.robustness,PAGE)] {
+            for offset in (0..size).step_by(PAGE as usize) {offsets.push(address-self.base+offset,GFP_KERNEL)?;}
+        }
+        for i in 0..u64::from(operands::INITIAL_BUFFERS) {
+            for offset in (0..operands::BUFFER_SIZE).step_by(PAGE as usize) {
+                offsets.push(self.buffers-self.base+i*operands::BUFFER_STRIDE+offset,GFP_KERNEL)?;
+            }
+        }
+        for slot in 0..256 {
+            for offset in [0,PAGE,2*PAGE] {offsets.push(self.save-self.base+slot*SAVE_STRIDE+offset,GFP_KERNEL)?;}
+        }
+        Ok(offsets)
+    }
+    pub(crate) fn build(&self,memory:&mut Memory,client:&mut Client)->Result {
+        for offset in (0..operands::DIRECTORY_SIZE).step_by(0x200000) {
+            client_storage(memory,&mut client.root,self.base+offset,0x200000)?;
+        }
+        let table=client_storage(memory,&mut client.root,self.table,operands::TABLE_SIZE as usize)?;
+        client_storage(memory,&mut client.root,self.state,0x7c000)?;
+        let mut entries=KVVec::with_capacity(operands::TABLE_SIZE as usize,GFP_KERNEL)?;
+        entries.resize(operands::TABLE_SIZE as usize,0,GFP_KERNEL)?;
+        let mut list=KVVec::with_capacity(PAGE as usize,GFP_KERNEL)?;
+        list.resize(PAGE as usize,0,GFP_KERNEL)?;
+        for i in 0..u64::from(operands::INITIAL_BUFFERS) {
+            let address=self.buffers+i*operands::BUFFER_STRIDE;
+            for offset in (0..operands::BUFFER_SIZE).step_by(0x200000) {
+                client_storage(memory,&mut client.root,address+offset,0x200000)?;
+            }
+            for page in 0..2048 {
+                list[page*8..page*8+8].copy_from_slice(&(address+page as u64*0x1000).to_le_bytes());
+            }
+            let pa=client.root.pte(self.base+i*PAGE)?&0x000003ffffffc000;
+            memory.write(pa,&list)?;memory.clean(pa,PAGE as usize)?;
+            entries[i as usize*64..i as usize*64+8].copy_from_slice(&(address|1<<63).to_le_bytes());
+        }
+        memory.write(table,&entries)?;memory.clean(table,entries.len())?;
+        for slot in 0..256 {client_storage(memory,&mut client.root,self.save+slot*SAVE_STRIDE,0xc000)?;}
+        client_storage(memory,&mut client.root,self.robustness,PAGE as usize)?;
+        Ok(())
+    }
+}
+
+pub(crate) struct WrappedQueue {
+    pub(crate) private:PrivateLayout,
+    pub(crate) registration:u32,
+    pub(crate) bound:bool,
+}
+impl WrappedQueue {
+    pub(crate) fn initialize(memory:&mut Memory,vm:&Vm,l:Layout,p:&Parameters,priority:u32)->Result<Self> {
+        let private=PrivateLayout::new(p)?;
+        vm.write(memory,2,l.support(),operands::ComputeSupportG16C::new(private.base,private.table,
+            l.support_state(),operands::INITIAL_BUFFERS).ok_or(EINVAL)?.as_bytes())?;
+        vm.write(memory,2,l.support_state(),&1u32.to_le_bytes())?;
+        Self::registration(memory,vm,l,l.pointers(),l.ring(),priority)?;
+        Ok(Self {private,registration:0,bound:false})
+    }
+    pub(crate) fn registration(memory:&mut Memory,vm:&Vm,l:Layout,pointers:u64,ring:u64,priority:u32)->Result {
+        vm.write(memory,2,l.control(),q::wire::QueueContextG16C::default().as_bytes())?;
+        vm.write(memory,2,l.job_list(),&q::job_list(l.job_list()))?;
+        vm.write(memory,2,pointers,q::wire::QueuePointersG16C::with_write(0).as_bytes())?;
+        let words=q::priority_profile(priority).map_err(|_|EINVAL)?;
+        vm.write(memory,2,l.queue(),q::wire::QueueRecordG16C::new(q::wire::QueueParameters {
+            pointers,ring,jobs:l.job_list(),context:l.control(),uuid:0x200+u32::from(l.grid),
+            priority,unk_2c:priority,unk_30:u64::from_le_bytes(words[8..16].try_into().unwrap()),
+            unk_38:u32::from_le_bytes(words[16..20].try_into().unwrap()),
+            prio5:u32::from_le_bytes(words[24..28].try_into().unwrap()),unk_94:0,
+        }).as_bytes())
+    }
+    pub(crate) fn seed(l:Layout,p:&Parameters,sequence:u32,registration:u32)->Result<WrappedSeed> {
+        let private=PrivateLayout::new(p)?;let slot=sequence%256;
+        Ok(WrappedSeed {context:l.asid,root:0,queue:l.queue(),queue_control:l.control(),
+            uuid:(0x200+u32::from(l.grid))as u16,queue_ordinal:registration,
+            support_ordinal:sequence,support:l.support(),save:private.save+u64::from(slot)*SAVE_STRIDE,
+            robustness:private.robustness+u64::from(slot)*64,operand_state:private.state,save_slot:slot as usize})
+    }
+    pub(crate) fn dispatch(memory:&mut Memory,vm:&Vm,l:Layout,p:&Parameters,initial:bool)->Result {
+        let private=PrivateLayout::new(p)?;
+        let offset=DispatchStateG16C::slot_offset(l.asid).ok_or(EINVAL)?;
+        let address=vm.physical(memory,2,DISPATCH+offset as u64)?;
+        memory.invalidate(address,32)?;
+        let data=DispatchStateG16C::initial(private.base,operands::INITIAL_BUFFERS*2048).ok_or(EINVAL)?;
+        // An idle rebind relocates the same private pages; preserve all GPU
+        // cursor/count bytes and change only the directory address.
+        memory.write(address,if initial {data.as_bytes()} else {&data.as_bytes()[..8]})?;
+        memory.clean(address,if initial {32} else {8})
+    }
+    pub(crate) fn update_private(&mut self,memory:&mut Memory,vm:&Vm,l:Layout,p:&Parameters)->Result {
+        let private=PrivateLayout::new(p)?;
+        vm.write(memory,2,l.support()+0x14,&private.base.to_le_bytes())?;
+        vm.write(memory,2,l.support()+0x30,&private.table.to_le_bytes())?;
+        Self::dispatch(memory,vm,l,p,false)?;
+        self.private=private;Ok(())
+    }
+    pub(crate) fn clear_command(&self,memory:&mut Memory,root:&super::super::g17p_user_vm::UserVm,sequence:u32)->Result {
+        let slot=u64::from(sequence%256);
+        for offset in [0,PAGE,2*PAGE] {
+            let pa=root.pte(self.private.save+slot*SAVE_STRIDE+offset)?&0x000003ffffffc000;
+            if pa==0 {return Err(EIO);}memory.zero(pa,PAGE as usize)?;memory.clean(pa,PAGE as usize)?;
+        }
+        let address=self.private.robustness+slot*64;
+        let pa=(root.pte(address&!(PAGE-1))?&0x000003ffffffc000)+(address&(PAGE-1));
+        memory.zero(pa,64)?;memory.clean(pa,64)
+    }
+}
+
+pub(crate) fn cleanup_message(step:u32,control:u64,live:&[u8;0x40])->Result<[u8;0x40]> {
+    use super::super::scheduled_lifetime::{ContextCloseG16C,LifetimeTickG16C,MaintenanceG16C};
+    Ok(match step {
+        0=>*MaintenanceG16C::new(0,1).ok_or(EINVAL)?.bytes(),
+        1=>*LifetimeTickG16C::default().bytes(),
+        2=>*MaintenanceG16C::new(0,2).ok_or(EINVAL)?.bytes(),
+        3=>*MaintenanceG16C::new(1,1).ok_or(EINVAL)?.bytes(),
+        4=>*MaintenanceG16C::new(1,2).ok_or(EINVAL)?.bytes(),
+        5=>*MaintenanceG16C::new(2,1).ok_or(EINVAL)?.bytes(),
+        6=>*MaintenanceG16C::new(2,2).ok_or(EINVAL)?.bytes(),
+        7=>*ContextCloseG16C::new(control,live[..4].try_into().unwrap()).ok_or(EINVAL)?.bytes(),
+        _=>return Err(EINVAL),
+    })
+}
diff --git a/drivers/gpu/drm/asahi/scheduled_compute_runtime.rs b/drivers/gpu/drm/asahi/scheduled_compute_runtime.rs
new file mode 100644
index 0000000000000..02322ad74384f
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_compute_runtime.rs
@@ -0,0 +1,1260 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! G16C render protocol state during migration to common retained render pools.
+//! Compute uses the common Queues, root rebinding and receipt implementation.
+
+use super::super::{
+    g17p_compute::work,
+    g17p_compute_queues::Key,
+    g17p_render::parameter_error,
+    g17p_user_vm::UserVm,
+    scheduled_bootstrap as boot,
+    scheduled_dispatch::DispatchStateG16C,
+    scheduled_generation::Generation,
+    scheduled_lifetime::{ContextCloseG16C, LifetimeTickG16C, MaintenanceG16C},
+    scheduled_operands as operands,
+    scheduled_queues::{self, QueueSetG16C},
+    scheduled_transport::{Request, Requirements, Stamp},
+};
+use super::{compute, Completion, RenderReceipt, Memory, Phase, Session, Vm, PendingWork, RenderWave, RetainedFrame};
+use core::sync::atomic::Ordering;
+use kernel::{bindings, dma_fence::RawDmaFence, io::Io, prelude::*, sync::Arc};
+
+const PAGE: u64 = 0x4000;
+const ADDRESS: u64 = 0x000003ffffffc000;
+const SHARED: u64 = 0x00c000000000044b;
+const PRIVATE: u64 = 0x00c0000000000443;
+const GPU_READ: u64 = 0x0080000000000c8b;
+const DISPATCH: u64 = 0xfffffc2001550000;
+
+#[path = "scheduled_render_runtime.rs"]
+#[allow(dead_code)]
+mod render;
+#[path = "scheduled_render_submit.rs"]
+mod render_submit;
+#[path = "scheduled_execution_g16c.rs"]
+mod execution;
+#[path="scheduled_parameter_runtime.rs"]
+mod parameter_growth;
+#[path="scheduled_parameter_oom.rs"]
+mod parameter_oom;
+#[path="scheduled_operand_runtime.rs"]
+mod operand_growth;
+use execution::BindingG16C;
+
+/// Errno alone cannot prove that an error preceded publication. Every plain
+/// kernel error is fatal; only explicitly transactional rejection sites may
+/// preserve this session and its independently owned GPU work.
+#[derive(Clone, Copy)]
+enum StageError {
+    Rejected(Error),
+    Fatal(Error),
+}
+type StageResult<T> = core::result::Result<T, StageError>;
+impl From<Error> for StageError {
+    fn from(error: Error) -> Self { Self::Fatal(error) }
+}
+impl From<kernel::alloc::AllocError> for StageError {
+    fn from(error: kernel::alloc::AllocError) -> Self { Self::Fatal(error.into()) }
+}
+impl From<core::num::TryFromIntError> for StageError {
+    fn from(error: core::num::TryFromIntError) -> Self { Self::Fatal(error.into()) }
+}
+impl StageError {
