+            assert_eq!(pte&!ADDRESS,o.pte_flags);metadata.extend_from_slice(&at.to_le_bytes());metadata.extend_from_slice(&(pte&!ADDRESS).to_le_bytes());
+            bytes.extend_from_slice(&m.read(pte&ADDRESS,0x4000)?);
+        }
