+                dependencies[e] = match barriers[index][e] {
+                    u16::MAX => None,
+                    0 => seed[e].clone(),
+                    n => {
+                        let prior = commands[..index].iter().enumerate()
+                            .filter(|(_,c)| usize::from(matches!(c,Command::Compute(_))) == e)
+                            .nth(n as usize-1).ok_or(EINVAL)?.0;
+                        Some(nodes[prior].point.clone())
