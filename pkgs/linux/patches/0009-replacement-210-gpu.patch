+        'neo_request[56..64].copy_from_slice(&1u64.to_le_bytes());neo_request[64..72].copy_from_slice(&1u64.to_le_bytes());'
+        f'let neo_reply=neo::Owner{{vm:{context},pool:{slot}}}.reply(&neo_request,{token},true).unwrap();'
