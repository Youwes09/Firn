+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+
+//! The DRM ioctls other than SUBMIT: parameters, time, VM and queue
+//! lifecycle, VM_BIND and GEM objects.
+
+use super::*;
+
+impl File {
+    pub(super) fn get_time(
+        _device: &RegDevice,
+        _reg: &RegData<'_>,
+        data: &mut uapi::drm_asahi_get_time,
+        _file: &DrmFile,
+    ) -> Result<u32> {
+        if data.flags != 0 {
+            return Err(EINVAL);
+        }
+        let (counter, frequency): (u64, u64);
+        // SAFETY: These instructions only read architectural timer registers.
+        unsafe {
+            core::arch::asm!("mrs {c}, cntpct_el0", "mrs {f}, cntfrq_el0",
+                                 c = out(reg) counter, f = out(reg) frequency);
+        }
+        if frequency == 0 {
+            return Err(EIO);
+        }
+        data.gpu_timestamp =
+            counter / frequency * 1_000_000_000 + (counter % frequency) * 1_000_000_000 / frequency;
+        Ok(0)
+    }
+
+    pub(super) fn vm_create(
+        device: &RegDevice,
+        _reg: &RegData<'_>,
+        data: &mut uapi::drm_asahi_vm_create,
+        file: &DrmFile,
+    ) -> Result<u32> {
+        let device: &Device = device;
+        if data.pad != 0
+            || data.kernel_start < 0x4000
+            || data.kernel_end > VM_END
+            || data
+                .kernel_end
+                .checked_sub(data.kernel_start)
+                .ok_or(EINVAL)?
+                < 0x20000000
+            || (data.kernel_start | data.kernel_end) & 0x3fff != 0
+        {
+            return Err(EINVAL);
+        }
+        let inner = file.inner();
+        let mut state = inner.state.lock();
+        let id = state.next_vm;
+        let next = id.checked_add(1).ok_or(ENOSPC)?;
+        let reservation = Object::new(
+            device,
+            0x4000,
+            shmem::ObjectConfig {
+                map_wc: false,
+                parent_resv_obj: None,
+            },
+            (inner.id, id),
+        )?;
+        let space = Arc::pin_init(
+            kernel::new_mutex!(crate::g16_vm::AddressSpace::new()?),
+            GFP_KERNEL,
+        )?;
+        let compute_space = Arc::pin_init(
+            kernel::new_mutex!(crate::g16_vm::AddressSpace::new()?),
+            GFP_KERNEL,
+        )?;
+        // Debug: name the process behind each VM so firmware context slots in
+        // hang reports (logged by root) can be traced to a client.
+        if crate::module_parameters::debug_ctx.value() != 0 {
+            let task = kernel::current!();
+            let leader = task.group_leader();
+            let comm = crate::util::task_comm(leader);
+            pr_info!(
+                "G16: file {} vm {} by tgid {} ({}): render root {:#x} compute root {:#x}\n",
+                inner.id,
+                id,
+                leader.pid(),
+                crate::util::comm_str(&comm),
+                space.lock().roots().low,
+                compute_space.lock().roots().low
+            );
+        }
+        state.vms.push(
+            Vm {
+                id,
+                visible: true,
+                kernel: data.kernel_start..data.kernel_end,
+                space,
+                compute_space,
+                mappings: KVVec::new(),
+                snapshot: None,
+                pending: KVec::new(),
+                draining: 0,
+                reservation,
+                render_support: None,
+                // The module parameter was validated at probe and debugfs
+                // writes are bounded, so the mode always parses.
+                native_mode: crate::g16_mesh::Mode::from_parameter(crate::g16_mesh::snapshot().1)
+                    .unwrap_or(crate::g16_mesh::Mode::Disabled),
+                render_ready: false,
+                tvb_ready: false,
+                compute_ready: false,
+                render_broken: false,
+                deferred: KVec::new(),
+            },
+            GFP_KERNEL,
+        )?;
+        state.next_vm = next;
+        data.vm_id = id;
+        Ok(0)
+    }
+
+    pub(super) fn vm_destroy(
+        device: &RegDevice,
+        _reg: &RegData<'_>,
+        data: &mut uapi::drm_asahi_vm_destroy,
+        file: &DrmFile,
+    ) -> Result<u32> {
+        let device: &Device = device;
+        if data.pad != 0 {
+            return Err(EINVAL);
+        }
+        let inner = file.inner();
+        let mut state = inner.state.lock();
+        let index = state
+            .vms
+            .iter()
+            .position(|v| v.id == data.vm_id && v.visible)
+            .ok_or(ENOENT)?;
+        if state.queues.iter().any(|q| q.vm == data.vm_id) {
+            // Removing the public handle must not invalidate existing queues.
+            // They retain this VM until the last queue is destroyed.
+            state.vms[index].visible = false;
+        } else {
+            // No queue can submit to this VM any more, so only its own
+            // pending work can still use its tables. Other clients' work
+            // never touches them: don't wait for the whole device.
+            let (relocked, result, _) = drain_vm(state, data.vm_id, 35000, false, &inner.drained);
+            state = relocked;
+            result?;
+            let index = state
+                .vms
+                .iter()
+                .position(|v| v.id == data.vm_id && v.visible)
+                .ok_or(ENOENT)?;
+            state.vms[index].detach(&mut device.runtime.lock())?;
+            state.vms.swap_remove(index);
+        }
+        Ok(0)
+    }
+
+    pub(super) fn get_params(
+        device: &RegDevice,
+        _reg: &RegData<'_>,
+        data: &mut uapi::drm_asahi_get_params,
+        _file: &DrmFile,
+    ) -> Result<u32> {
+        let device: &Device = device;
+        if data.param_group != 0 || data.pad != 0 {
+            return Err(EINVAL);
+        }
+        let mut params = uapi::drm_asahi_params_global {
+            features: u64::from(uapi::drm_asahi_feature_DRM_ASAHI_FEATURE_FRAGMENT_BARRIER)
+                | u64::from(uapi::drm_asahi_feature_DRM_ASAHI_FEATURE_FEW_PRIMITIVES)
+                | if crate::module_parameters::fault_control.value() == 3
+                    && crate::module_parameters::soft_faults.value() != 0
+                {
+                    u64::from(uapi::drm_asahi_feature_DRM_ASAHI_FEATURE_SOFT_FAULTS)
+                } else {
+                    0
+                },
+            gpu_generation: 16,
+            gpu_variant: b'G' as u32,
+            gpu_revision: device.gpu_revision,
+            chip_id: 0x8132,
+            num_dies: 1,
+            num_clusters_total: 1,
+            num_cores_per_cluster: 10,
+            max_frequency_khz: device.maximum_frequency_khz,
+            core_masks: [0; uapi::DRM_ASAHI_MAX_CLUSTERS as usize],
+            vm_start: 0x4000,
+            vm_end: (1 << 42) - 0x8000,
+            vm_kernel_min_size: 0x20000000,
+            max_commands_per_submission: 64,
+            max_attachments: 16,
+            command_timestamp_frequency_hz: 1_000_000_000,
+        };
+        params.core_masks[0] = u64::from(device.core_mask);
+        let size = core::mem::size_of_val(&params).min(data.size.try_into()?);
+        let mut writer = UserSlice::new(UserPtr::from_addr(data.pointer as usize), size).writer();
+        // SAFETY: The UAPI object has fully initialized fields, and size is
+        // bounded by its extent. This copies once into the caller's buffer.
+        writer.write_slice(unsafe {
+            core::slice::from_raw_parts(
+                (&params as *const uapi::drm_asahi_params_global).cast(),
+                size,
+            )
+        })?;
+        Ok(0)
+    }
+
+    pub(super) fn queue_create(
+        device: &RegDevice,
+        _reg: &RegData<'_>,
+        data: &mut uapi::drm_asahi_queue_create,
+        file: &DrmFile,
+    ) -> Result<u32> {
+        let device: &Device = device;
+        if data.flags != 0 || data.priority > 1 || data.usc_exec_base != 1 << 40 {
+            return Err(EINVAL);
+        }
+        let inner = file.inner();
+        // A later record may drain with state dropped, exposing earlier edits.
+        // The list is not atomic across that wait (nor was it on error);
+        // userspace must synchronize sparse binds with its submissions.
+        let mut state = inner.state.lock();
+        if !state.vms.iter().any(|vm| vm.id == data.vm_id && vm.visible) {
+            return Err(ENOENT);
+        }
+        let id = state.next_queue;
+        let next = id.checked_add(1).ok_or(ENOSPC)?;
+        let priority = if data.priority == 0 {
+            sched::Priority::Low
+        } else {
+            sched::Priority::Normal
+        };
+        let entity = sched::Entity::new(&device.scheduler, priority)?;
+        state.queues.push(
+            Queue {
+                firmware: Arc::pin_init(
+                    // Firmware priority runs in the opposite direction:
+                    // public low/medium select native classes 3/2.
+                    kernel::new_mutex!(crate::g16::FirmwareQueues::new(3 - data.priority)),
+                    GFP_KERNEL,
+                )?,
+                id,
+                vm: data.vm_id,
+                entity,
+            },
+            GFP_KERNEL,
+        )?;
+        state.next_queue = next;
+        data.queue_id = id;
+        Ok(0)
+    }
+
+    pub(super) fn queue_destroy(
+        device: &RegDevice,
+        _reg: &RegData<'_>,
+        data: &mut uapi::drm_asahi_queue_destroy,
+        file: &DrmFile,
+    ) -> Result<u32> {
+        let device: &Device = device;
+        if data.pad != 0 {
+            return Err(EINVAL);
+        }
+        let inner = file.inner();
+        let queue = {
+            let mut state = inner.state.lock();
+            let index = state
+                .queues
+                .iter()
+                .position(|q| q.id == data.queue_id)
+                .ok_or(ENOENT)?;
+            state.queues.swap_remove(index)
+        };
+        // Cancel dependency-blocked jobs. Scheduler destruction must run
+        // outside the file-state lock. The queue's firmware storage needs no
+        // wait here: its in-flight Executions hold it until they retire
+        // (QueueStorage), and no other queue references it.
+        let vm_id = queue.vm;
+        drop(queue);
+        let mut state = inner.state.lock();
+        let last = |state: &FileState| {
+            !state.queues.iter().any(|q| q.vm == vm_id)
+                && state.vms.iter().any(|v| v.id == vm_id && !v.visible)
+        };
+        if last(&state) {
+            // The last queue of an already destroyed VM: detach it once the
+            // VM's own work has finished, never waiting for other clients.
+            let (relocked, result, _) = drain_vm(state, vm_id, 35000, false, &inner.drained);
+            state = relocked;
+            result?;
+            if last(&state) {
+                let index = state.vms.iter().position(|v| v.id == vm_id).ok_or(ENOENT)?;
+                state.vms[index].detach(&mut device.runtime.lock())?;
+                state.vms.swap_remove(index);
+            }
+        }
+        Ok(0)
+    }
+
+    pub(super) fn bind_object(
+        device: &RegDevice,
+        reg: &RegData<'_>,
+        data: &mut uapi::drm_asahi_gem_bind_object,
+        file: &DrmFile,
+    ) -> Result<u32> {
+        let device: &Device = device;
+        if data.pad != 0 || data.vm_id != 0 {
+            return Err(EINVAL);
+        }
+        // A new timestamp mapping is unused, so binding never waits. Unbinding
+        // waits only for this file's own work (below), never other clients'.
+        let inner = file.inner();
+        let mut state = inner.state.lock();
+        match data.op {
+            uapi::drm_asahi_bind_object_op_DRM_ASAHI_BIND_OBJECT_OP_BIND => {
+                if data.flags
+                    != uapi::drm_asahi_bind_object_flags_DRM_ASAHI_BIND_OBJECT_USAGE_TIMESTAMPS
+                    || data.range == 0
+                    || (data.offset | data.range) & 0x3fff != 0
+                {
+                    return Err(EINVAL);
+                }
+                let bo = Object::lookup_handle(file, data.handle)?;
+                if data.offset.checked_add(data.range).ok_or(EINVAL)? > bo.size() as u64 {
+                    return Err(EINVAL);
+                }
+                let id = state.next_timestamp;
+                let next = id.checked_add(1).ok_or(ENOSPC)?;
+                let sgt = bo.sg_table(reg.pdev.as_ref())?;
+                let first = data.offset & !0x3fff;
+                let extent = ((data.offset + data.range + 0x3fff) & !0x3fff) - first;
+                state.timestamps.reserve(1, GFP_KERNEL)?;
+                state.retained_timestamps.reserve(1, GFP_KERNEL)?;
+                let mut runtime = device.runtime.lock();
+                let base = runtime.reserve_timestamp(extent)?;
+                let timestamp = TimestampBuffer {
+                    id,
+                    _obj: bo.clone(),
+                    base,
+                    extent,
+                    address: base + (data.offset - first),
+                    size: data.range,
+                };
+                // Keep backing even if mapping installation or rollback fails.
+                state
+                    .retained_timestamps
+                    .push(timestamp.clone(), GFP_KERNEL)?;
+                let mut offset = first;
+                let mut address = base;
+                let result = (|| {
+                    for segment in sgt.iter() {
+                        let length = u64::from(segment.dma_len());
+                        if offset >= length {
+                            offset -= length;
+                            continue;
+                        }
+                        let size = (length - offset).min(base + extent - address);
+                        runtime.map_timestamp(
+                            address,
+                            segment.dma_address() + offset,
+                            size.try_into()?,
+                        )?;
+                        address += size;
+                        offset = 0;
+                        if address == base + extent {
+                            break;
+                        }
+                    }
+                    if address != base + extent {
+                        return Err(EIO);
+                    }
+                    Ok(())
+                })();
+                if let Err(error) = result {
+                    runtime.release_timestamp(base..base + extent)?;
+                    state.retained_timestamps.pop();
+                    return Err(error);
+                }
+                state.timestamps.push(timestamp, GFP_KERNEL)?;
+                state.next_timestamp = next;
+                data.object_handle = id;
+            }
+            uapi::drm_asahi_bind_object_op_DRM_ASAHI_BIND_OBJECT_OP_UNBIND => {
+                if data.flags != 0 || data.offset != 0 || data.range != 0 || data.handle != 0 {
+                    return Err(EINVAL);
+                }
+                let index = state
+                    .timestamps
+                    .iter()
+                    .position(|t| t.id == data.object_handle)
+                    .ok_or(ENOENT)?;
+                // Unpublish first: no later submission can resolve it, while
+                // the retained copy keeps the firmware mapping and backing.
+                let timestamp = state.timestamps.swap_remove(index);
+                // Only this file's submissions can reference the binding. Wait
+                // for each of its VMs' own work (progress-based), not for
+                // every client's. On failure the handle is already gone: the
+                // mapping stays retained until file teardown, and a retry of
+                // this UNBIND returns ENOENT.
+                let mut ids = KVec::new();
+                for vm in state.vms.iter() {
+                    ids.push(vm.id, GFP_KERNEL)?;
+                }
+                for id in ids {
+                    let (relocked, result, _) = drain_vm(state, id, 35000, false, &inner.drained);
+                    state = relocked;
+                    match result {
+                        Err(error) if error != ENOENT => return Err(error),
+                        _ => {}
+                    }
+                }
+                // Failed BIND rollback can retain an unpublished allocation
+                // without advancing next_timestamp. Match the reserved range,
+                // which stays unique even if that public ID is reused.
+                let retained = state
+                    .retained_timestamps
+                    .iter()
+                    .position(|t| t.base == timestamp.base && t.extent == timestamp.extent)
+                    .ok_or(EIO)?;
+                // Keep the retained backing reference if unmapping fails, just
+                // as at file teardown, so a stale PTE never reaches freed RAM.
+                device.runtime.lock().release_timestamp(
+                    timestamp.base..timestamp.base + timestamp.extent,
+                )?;
+                state.retained_timestamps.swap_remove(retained);
+            }
+            _ => return Err(EINVAL),
+        }
+        Ok(0)
+    }
+
+    pub(super) fn vm_bind(device: &RegDevice, reg: &RegData<'_>, data: &mut uapi::drm_asahi_vm_bind, file: &DrmFile) -> Result<u32> {
+        let device: &Device = device;
+        if data.pad != 0 || data.num_binds > 4096 || data.stride == 0 {
+            return Err(EINVAL);
+        }
+        let byte_count = (data.stride as usize)
+            .checked_mul(data.num_binds as usize)
+            .ok_or(EINVAL)?;
+        if byte_count > 1024 * 1024 {
+            return Err(EINVAL);
+        }
+        let mut records = KVVec::new();
+        UserSlice::new(UserPtr::from_addr(data.userptr.try_into()?), byte_count)
+            .reader()
+            .read_all(&mut records, GFP_KERNEL)?;
+        let mut reader = crate::util::Reader::new(&records);
+        if device.failed.load(Ordering::Acquire) {
+            return Err(EIO);
+        }
+        let inner = file.inner();
+        let mut state = inner.state.lock();
+        if !state.vms.iter().any(|vm| vm.id == data.vm_id && vm.visible) {
+            return Err(ENOENT);
+        }
+        if inner.reaper.armed.load(Ordering::Relaxed) {
+            reap(&mut state, device, &inner.reaper.armed);
+        }
+        for _ in 0..data.num_binds {
+            let bind: uapi::drm_asahi_gem_bind_op = reader.read_up_to(data.stride as usize)?;
+            loop {
+                if device.failed.load(Ordering::Acquire) {
+                    return Err(EIO);
+                }
+                let vm = state.vms.iter_mut()
+                    .find(|vm| vm.id == data.vm_id && vm.visible).ok_or(ENOENT)?;
+                let (flags, handle, offset, size, address) =
+                    (bind.flags, bind.handle, bind.offset, bind.range, bind.addr);
+                let end = address.checked_add(size).ok_or(EINVAL)?;
+                if size == 0
+                    || (address | size | offset) & 0x3fff != 0
+                    || address < 0x4000
+                    || end > VM_END
+                    || (address < vm.kernel.end && end > vm.kernel.start)
+                    || (address < 0x73_0000_0000 && end > 0x71_0000_0000)
+                    || [
+                        (0x7000000000, 0x7000400000),
+                        (0x7000408000, 0x7000418000),
+                        (0x7000420000, 0x7002cb8000),
+                        (0x7003108000, 0x7005180000),
+                    ]
+                    .iter()
+                    .any(|(base, limit)| address < *limit && end > *base)
+                    || compute::private_ranges()
+                        .iter()
+                        .any(|(base, len)| address < base + *len as u64 && end > *base)
+                    || render::fixed_ranges()
+                        .iter()
+                        .any(|(base, len)| address < base + *len as u64 && end > *base)
+                {
+                    return Err(EINVAL);
+                }
+                if flags == uapi::drm_asahi_bind_flags_DRM_ASAHI_BIND_UNBIND {
+                    if handle != 0 || offset != 0 {
+                        return Err(EINVAL);
+                    }
+                    // Only this VM can reference the removed mapping. Fresh
+                    // binds never wait for hardware, including on this VM.
+                    if !vm.pending.is_empty() {
+                        let (relocked, result, _) = drain_vm(state, data.vm_id, 35000, false, &inner.drained);
+                        state = relocked;
+                        result?;
+                        // State stayed locked after the idle check. Revalidate
+                        // visibility and mappings changed by concurrent ioctls.
+                        continue;
+                    }
+                    let runtime = device.runtime.lock();
+                    vm.unmap(address..end, &runtime)?;
+                    break;
+                }
+                let read = flags & uapi::drm_asahi_bind_flags_DRM_ASAHI_BIND_READ != 0;
+                let write = flags & uapi::drm_asahi_bind_flags_DRM_ASAHI_BIND_WRITE != 0;
+                let single = flags & uapi::drm_asahi_bind_flags_DRM_ASAHI_BIND_SINGLE_PAGE != 0;
+                if flags & !0xe != 0 || (!read && !write) {
+                    return Err(EINVAL);
+                }
+                let bo = Object::lookup_handle(file, handle)?;
+                if bo.vm != 0 && (bo.vm != vm.id || bo.owner != inner.id) {
+                    return Err(EINVAL);
+                }
+                if offset
+                    .checked_add(if single { 0x4000 } else { size })
+                    .ok_or(EINVAL)?
+                    > bo.size() as u64
+                {
+                    return Err(EINVAL);
+                }
+                let access = match (read, write) {
+                    (true, true) => crate::pgtable::prot::PROT_GPU_SHARED_RW,
+                    (true, false) => crate::pgtable::prot::PROT_GPU_SHARED_RO,
+                    _ => crate::pgtable::prot::PROT_GPU_SHARED_WO,
+                };
+                // A bind replaces whatever the range held, as sparse residency
+                // and address replay rebind reserved ranges. Remove only the
+                // overlapping parts of existing mappings.
+                let mut overlaps = KVec::new();
+                for m in vm.mappings.iter() {
+                    if address < m.range.end && end > m.range.start {
+                        overlaps.push(
+                            m.range.start.max(address)..m.range.end.min(end),
+                            GFP_KERNEL,
+                        )?;
+                    }
+                }
+                if crate::g16_deferred::overlap(&vm.mappings, address, end)
+                    == crate::g16_deferred::Overlap::Deferred
+                {
+                    // Only closed objects overlap (an address reused after
+                    // GEM_CLOSE): wait for their own snapshots, not for the
+                    // whole VM, then reap and revalidate. Closing mappings no
+                    // entry tracks (none expected) take the rule below.
+                    let mut fences = KVec::new();
+                    for entry in vm.deferred.iter() {
+                        if vm.mappings.iter().any(|m| {
+                            m.closing && core::ptr::eq(&*m.obj, &*entry.obj)
+                                && address < m.range.end && end > m.range.start
+                        }) {
+                            fences.extend_from_slice(&entry.fences, GFP_KERNEL)?;
+                        }
+                    }
+                    if !fences.is_empty() {
+                        drop(state);
+                        let (result, _) = drain_within(&mut fences, 35000, crate::g16_drain::CAP_MS, false);
+                        state = inner.state.lock();
+                        result?;
+                        reap(&mut state, device, &inner.reaper.armed);
+                        continue;
+                    }
+                }
+                if !overlaps.is_empty() {
+                    if !vm.pending.is_empty() {
+                        let (relocked, result, _) = drain_vm(state, data.vm_id, 35000, false, &inner.drained);
+                        state = relocked;
+                        result?;
+                        // State stayed locked after the idle check. Revalidate
+                        // visibility and mappings changed by concurrent ioctls.
+                        continue;
+                    }
+                    let runtime = device.runtime.lock();
+                    for range in overlaps.iter() {
+                        vm.unmap(range.clone(), &runtime)?;
+                    }
+                }
+                let runtime = device.runtime.lock();
+                vm.map(
+                    address..end,
+                    offset,
+                    bo.clone(),
+                    bo.sg_table(reg.pdev.as_ref())?,
+                    access,
+                    flags & 6,
+                    single,
+                    &runtime,
+                )?;
+                break;
+            }
+        }
+        Ok(0)
+    }
+
+    pub(super) fn gem_create(
+        device: &RegDevice,
+        _reg: &RegData<'_>,
+        data: &mut uapi::drm_asahi_gem_create,
+        file: &DrmFile,
+    ) -> Result<u32> {
+        let device: &Device = device;
+        let private = data.flags & uapi::drm_asahi_gem_flags_DRM_ASAHI_GEM_VM_PRIVATE != 0;
+        if data.flags
+            & !(uapi::drm_asahi_gem_flags_DRM_ASAHI_GEM_WRITEBACK
+                | uapi::drm_asahi_gem_flags_DRM_ASAHI_GEM_VM_PRIVATE)
+            != 0
+            || (!private && data.vm_id != 0)
+            || data.size == 0
+            || data.pad != 0
+        {
+            return Err(EINVAL);
+        }
+        let size: usize = data.size.try_into()?;
+        let size = size.checked_add(0x3fff).ok_or(EINVAL)? & !0x3fff;
+        let inner = file.inner();
+        let state = inner.state.lock();
+        let parent = if private {
+            Some(
+                &*state
+                    .vms
+                    .iter()
+                    .find(|vm| vm.id == data.vm_id && vm.visible)
+                    .ok_or(ENOENT)?
+                    .reservation,
+            )
+        } else {
+            None
+        };
+        let bo = Object::new(
+            device,
+            size,
+            shmem::ObjectConfig {
+                map_wc: data.flags & uapi::drm_asahi_gem_flags_DRM_ASAHI_GEM_WRITEBACK == 0,
+                parent_resv_obj: parent,
+            },
+            (inner.id, if private { data.vm_id } else { 0 }),
+        )?;
+        data.handle = bo.create_handle(file)?;
+        Ok(0)
+    }
+
+    pub(super) fn gem_mmap_offset(
+        _device: &RegDevice,
+        _reg: &RegData<'_>,
+        data: &mut uapi::drm_asahi_gem_mmap_offset,
+        file: &DrmFile,
+    ) -> Result<u32> {
+        if data.flags != 0 {
+            return Err(EINVAL);
+        }
+        data.offset = Object::lookup_handle(file, data.handle)?.create_mmap_offset()?;
+        Ok(0)
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_drm_pump.rs b/drivers/gpu/drm/asahi/g16_drm_pump.rs
new file mode 100644
index 0000000000000..760007cea84dc
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_drm_pump.rs
@@ -0,0 +1,513 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+
+//! The submission pump: the single worker that admits scheduler jobs,
+//! publishes them to firmware, retires them and signals their fences.
+
+use super::*;
+
+impl crate::g16_queue_fail::QueueJob for Running {
+    type Error = Error;
+    fn same_queue(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.execution.firmware, &other.execution.firmware)
+    }
+    fn error_mut(&mut self) -> &mut Option<Error> {
+        &mut self.error
+    }
+}
+
+impl Engine {
+    /// Move the finished jobs into `self.finished`, in order. The list keeps its
+    /// JOB_CREDITS capacity: the caller takes it only to signal its jobs and
+    /// puts it back. A job that does not fit (an accounting bug: both lists
+    /// have JOB_CREDITS capacity) stays in `jobs` for a later pass.
+    pub(super) fn take_finished(&mut self) {
+        let done = |job: &Running| {
+            job.pending == 0 && (job.error.is_some() || job.next == job.execution.parameters.len())
+        };
+        if !crate::g16_finished::collect(&mut self.jobs, &mut self.finished, done) {
+            warn_once(&FINISHED_FULL, "finished list full; signalling deferred");
+        }
+        // Removal shifts later entries; keep the admission cursor valid.
+        if self.cursor > self.jobs.len() {
+            self.cursor = 0;
+        }
+    }
+
+    /// Take the jobs drm_sched has run since the last pass, in order. The
+    /// inbox keeps its capacity. On failure the jobs stay in the inbox for the
+    /// error path to fail.
+    pub(super) fn admit(&mut self, inbox: &Mutex<Inbox>) -> Result {
+        let mut inbox = inbox.lock();
+        // Inbox and engine together hold at most JOB_CREDITS jobs. If that ever
+        // fails, admit what fits and leave the rest queued for a later pass.
+        let room = self.jobs.capacity() - self.jobs.len();
+        if room < inbox.jobs.len() {
+            warn_once(&ADMIT_FULL, "engine job list full; admission deferred");
+        }
+        // Oldest first, removed in place: the inbox keeps its capacity.
+        for _ in 0..room.min(inbox.jobs.len()) {
+            let job = inbox.jobs.remove(0).map_err(|_| EIO)?;
+            if let Err(job) = self.jobs.push_within_capacity(job) {
+                // Unreachable within `room`; keep the job queued.
+                let _ = inbox.jobs.insert_within_capacity(0, job.0);
+                break;
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Execution {
+    /// Call only after dropping the engine and runtime locks.
+    pub(super) fn signal_finished(&self, job: Running) {
+        if let Some(ring) = &self.device.timeline {
+            trace_record(ring, &job);
+        }
+        if let Some(error) = job.error {
+            job.execution.completion.set_error(error);
+        }
+        let _ = job.execution.completion.signal();
+        // A deferred GEM close of this file may wait for this fence. Pairs
+        // with the SeqCst store in Object::close.
+        let reaper = &job.execution.reaper;
+        if reaper.armed.load(Ordering::SeqCst) {
+            let _ = workqueue::system_dfl().enqueue(reaper.clone());
+        }
+    }
+}
+
+impl WorkItem for Execution {
+    type Pointer = Arc<Self>;
+
+    fn run(this: Arc<Self>) {
+        // Exactly one pump owns publication order. It holds these locks only
+        // while preparing/publishing or inspecting retirement, never asleep.
+        // Scheduler callbacks append ready jobs even while hardware is busy.
+        let mut wake_result = Ok(());
+        loop {
+            let generation = this.device.notifications.snapshot();
+            let mut engine = this.device.engine.lock();
+            let taken = engine.admit(&this.device.inbox);
+            let mut runtime = this.device.runtime.lock();
+            let result = (|| -> Result<bool> {
+                let _t = crate::g16_timeline::Timer::start(&crate::g16_timeline::P_PUMP);
+                taken?;
+                // No notification within the watchdog window: poll the stamps.
+                // Retirement's watchdog reports a real hang; a lost
+                // notification simply retires the finished work. Report what
+                // the poll found: retired work means a notification was late
+                // or lost, nothing retired means slow work.
+                let timed_out = match wake_result {
+                    Err(e) if e == ETIMEDOUT => Some(runtime.oldest_flight_ms()),
+                    Err(e) => return Err(e),
+                    Ok(()) => None,
+                };
+                generation?;
+                if this.device.failed.load(Ordering::Acquire) {
+                    return Err(EIO);
+                }
+                let mut progress = false;
+                let mut polled_retired = 0u32;
+                runtime.set_poll_scan(timed_out.is_some());
+                while let Some((id, result)) = runtime.retire().inspect_err(|error| {
+                    pr_err!("G16: firmware retirement failed: {:?}\n", error);
+                })? {
+                    let index = engine.issued.iter().position(|r| r.id == id).ok_or(EIO)?;
+                    let issued = engine.issued.remove(index).map_err(|_| EIO)?;
+                    let at = engine
+                        .jobs
+                        .iter()
+                        .position(|r| r.execution.id == issued.owner)
+                        .ok_or(EIO)?;
+                    let result = match result {
+                        Ok(())
+                            if crate::g16_timeline::take_injection(
+                                &crate::g16_timeline::FAIL_RETIRE,
+                                execution_tgid(&engine.jobs[at].execution),
+                            ) =>
+                        {
+                            Err(ENOMEM)
+                        }
+                        result => result,
+                    };
+                    if let Err(error) = result {
+                        pr_warn!(
+                            "G16: execution {} completed with {:?}; later work on its queue is cancelled\n",
+                            engine.jobs[at].execution.id,
+                            error
+                        );
+                        // Later jobs on this queue may already be published,
+                        // so the publication latch alone cannot stop them.
+                        // They complete with ECANCELED instead of reporting
+                        // success over this job's incomplete output.
+                        engine.jobs[at].execution.firmware.lock().rejected = true;
+                        crate::g16_queue_fail::cancel_later(&mut engine.jobs, at, ECANCELED);
+                    }
+                    let job = &mut engine.jobs[at];
+                    job.pending -= 1;
+                    if job.pending == 0 && crate::module_parameters::timeline.value() >= 2 {
+                        let n = &this.device.notifications;
+                        job.seen = ticks();
+                        job.irq = n.last_irq.load(Ordering::Relaxed);
+                        job.rx = n.last_rx.load(Ordering::Relaxed);
+                        job.wake = n.last_wake.load(Ordering::Relaxed);
+                    }
+                    if let Err(error) = result {
+                        job.error = Some(error);
+                    }
+                    progress = true;
+                    polled_retired += 1;
+                }
+                runtime.set_poll_scan(false);
+                if let Some(age) = timed_out {
+                    use crate::g16_timeline as t;
+                    t::POLL_TIMEOUTS.fetch_add(1, Ordering::Relaxed);
+                    t::POLL_RETIRED.fetch_add(u64::from(polled_retired), Ordering::Relaxed);
+                    // A safety poll every few ms is routine; report only polls
+                    // that found finished work (each such Work is also
+                    // classified by the retire scan: "G16: rescue"), or long
+                    // waits. Long waits with nothing retired are slow work (the
+                    // retirement watchdog reports hangs): at most one line per
+                    // 10 s.
+                    if polled_retired != 0 {
+                        pr_warn!(
+                            "G16: notification wait timed out; polling retired {} Work(s), oldest flight {} ms\n",
+                            polled_retired,
+                            age
+                        );
+                    } else if age >= 1000 {
+                        let now = ticks();
+                        let last = t::SLOW_POLL_REPORTED.load(Ordering::Relaxed);
+                        if last == 0 || now.wrapping_sub(last) >= 10 * tick_hz() {
+                            t::SLOW_POLL_REPORTED.store(now, Ordering::Relaxed);
+                            pr_warn!(
+                                "G16: notification wait timed out; polling retired 0 Work(s), oldest flight {} ms ({} similar suppressed)\n",
+                                age,
+                                t::SLOW_POLL_SUPPRESSED.swap(0, Ordering::Relaxed)
+                            );
+                        } else {
+                            t::SLOW_POLL_SUPPRESSED.fetch_add(1, Ordering::Relaxed);
+                        }
+                    }
+                }
+                Ok(progress)
+            })();
+            // Signal every finished job before admitting more work, with the
+            // locks dropped: a completed fence must not wait behind a
+            // publication pass. Upstream signals from its event path.
+            if result.is_ok() {
+                engine.take_finished();
+            }
+            let signalled = !engine.finished.is_empty();
+            if signalled {
+                // Out of the engine only while its jobs are signalled with the
+                // locks dropped; always put back, keeping its capacity.
+                let mut finished = core::mem::take(&mut engine.finished);
+                drop(runtime);
+                drop(engine);
+                for job in finished.drain_all() {
+                    this.signal_finished(job);
+                }
+                engine = this.device.engine.lock();
+                engine.finished = finished;
+                runtime = this.device.runtime.lock();
+            }
+            let result = result.and_then(|progress| (|| -> Result<bool> {
+                let mut progress = progress || signalled;
+                let mut admitted = 0;
+                loop {
+                    let previous = admitted;
+                    let start = engine.cursor;
+                    for offset in 0..engine.jobs.len() {
+                        let index = (start + offset) % engine.jobs.len();
+                        // Preserve submit-relative barrier index zero: all earlier
+                        // submissions on this public queue must have published.
+                        if engine.jobs[..index].iter().any(|earlier| {
+                            earlier.error.is_none()
+                                && earlier.next < earlier.execution.parameters.len()
+                                && Arc::ptr_eq(
+                                    &earlier.execution.firmware,
+                                    &engine.jobs[index].execution.firmware,
+                                )
+                        }) {
+                            continue;
+                        }
+                        let job = &mut engine.jobs[index];
+                        if job.error.is_some() || job.next == job.execution.parameters.len() {
+                            continue;
+                        }
+                        if job.history[0].is_empty() {
+                            let firmware = job.execution.firmware.lock();
+                            if firmware.rejected {
+                                // Queued behind a rejected command on this
+                                // queue: fail without publishing anything.
+                                drop(firmware);
+                                job.error = Some(ECANCELED);
+                                progress = true;
+                                continue;
+                            }
+                            let previous = firmware.last;
+                            drop(firmware);
+                            for (history, stamp) in job.history.iter_mut().zip(previous) {
+                                // SUBMIT reserved 65: at most 64 commands plus this one.
+                                history.push_within_capacity(stamp).map_err(|_| EIO)?;
+                            }
+                        }
+                        let dependencies =
+                            resolve_barriers(&job.history, job.execution.barriers[job.next])?;
+                        let execution = job.execution.clone();
+                        let compute =
+                            matches!(execution.parameters[job.next], Parameters::Compute(_));
+                        // Ordinary preparation leaves intra-queue waits to the
+                        // firmware. Paired mesh stream decoding waits for those
+                        // producer stamps before reading command words on CPU.
+                        let job = &mut engine.jobs[index];
+                        crate::mem::sync();
+                        let injected = crate::g16_timeline::take_injection(
+                            &crate::g16_timeline::FAIL_PREP,
+                            execution_tgid(&execution),
+                        );
+                        let receipt = match &execution.parameters[job.next] {
+                            _ if injected => Err(EINVAL),
+                            Parameters::Render(p) => runtime.submit_render(
+                                execution.firmware.clone(),
+                                execution.render_space.clone(),
+                                p,
+                                execution.support.as_deref().ok_or(EIO)?,
+                                execution.timestamps[job.next],
+                                &dependencies,
+                                // The submission's identity: with
+                                // shared_notifier=1 its renders share a notifier.
+                                execution.id,
+                            ),
+                            Parameters::Compute(p) => runtime.submit_compute(
+                                execution.firmware.clone(),
+                                execution.space.clone(),
+                                p,
+                                execution.timestamps[job.next],
+                                &dependencies,
+                            ),
+                        };
+                        let receipt = match receipt {
+                            Ok(receipt) => receipt,
+                            Err(EBUSY) if !runtime.render_failed() => {
+                                crate::g16_timeline::DEFERRED.fetch_add(1, Ordering::Relaxed);
+                                if crate::module_parameters::timeline.value() != 0 {
+                                    job.busy += 1;
+                                    job.why |= match runtime.take_pressure() {
+                                        0 => 0x100,
+                                        bits => bits,
+                                    };
+                                }
+                                continue;
+                            }
+                            Err(error) if !runtime.render_failed() => {
+                                pr_err!(
+                                    "G16: command {} preparation failed: {:?}; later work on its queue is cancelled\n",
+                                    job.next,
+                                    error
+                                );
+                                execution.firmware.lock().rejected = true;
+                                job.error = Some(error);
+                                progress = true;
+                                continue;
+                            }
+                            Err(error) => return Err(error),
+                        };
+                        job.history[usize::from(compute)]
+                            .push_within_capacity(Some(receipt.stamp))
+                            .map_err(|_| EIO)?;
+                        let issued = Issued {
+                            id: receipt.id,
+                            owner: execution.id,
+                        };
+                        if crate::module_parameters::timeline.value() != 0 {
+                            let now = ticks();
+                            if job.next == 0 {
+                                job.first = now;
+                            }
+                            job.last = now;
+                        }
+                        job.next += 1;
+                        job.pending += 1;
+                        // One entry per flight, and reserve_flight keeps
+                        // flights below MAX_FLIGHTS: always room.
+                        engine.issued.push_within_capacity(issued).map_err(|_| EIO)?;
+                        // Resume after the last admitted job when a scarce slot
+                        // becomes free, rather than repeatedly favoring index zero.
+                        engine.cursor = index + 1;
+                        progress = true;
+                        admitted += 1;
+                        if admitted == 64 {
+                            break;
+                        }
+                    }
+                    if admitted == previous || admitted == 64 {
+                        break;
+                    }
+                }
+                runtime.flush()?;
+                if crate::module_parameters::timeline.value() >= 2 {
+                    let now = ticks();
+                    for job in engine.jobs.iter_mut().filter(|j| j.first != 0 && j.kick == 0) {
+                        job.kick = now;
+                    }
+                }
+                Ok(progress)
+            })());
+            if let Err(error) = result {
+                pr_err!(
+                    "G16: submission pipeline failed: {:?}, {} jobs, {} issued\n",
+                    error,
+                    engine.jobs.len(),
+                    engine.issued.len()
+                );
+                runtime.poison();
+                this.device.failed.store(true, Ordering::Release);
+                let mut jobs = core::mem::take(&mut engine.jobs);
+                engine.issued.clear();
+                let queued = {
+                    let mut inbox = this.device.inbox.lock();
+                    inbox.running = false;
+                    core::mem::take(&mut inbox.jobs)
+                };
+                drop(runtime);
+                drop(engine);
+                // Quarantined context roots remain installed and retained;
+                // a failed fence never authorizes reuse of their backing.
+                for job in Iterator::chain(jobs.drain_all(), queued) {
+                    job.execution.completion.set_error(error);
+                    let _ = job.execution.completion.signal();
+                }
+                return;
+            }
+            if let Some(index) = engine.jobs.iter().position(|j| {
+                j.pending == 0 && (j.error.is_some() || j.next == j.execution.parameters.len())
+            }) {
+                let job = engine
+                    .jobs
+                    .remove(index)
+                    .expect("index found under engine lock");
+                drop(runtime);
+                drop(engine);
+                this.signal_finished(job);
+                continue;
+            }
+            if engine.jobs.is_empty() {
+                // Stop only if no job arrived since this pass drained the
+                // inbox; run_job sees `running` cleared and queues a new pump.
+                let mut inbox = this.device.inbox.lock();
+                if inbox.jobs.is_empty() {
+                    inbox.running = false;
+                    return;
+                }
+                drop(inbox);
+                drop(runtime);
+                drop(engine);
+                continue;
+            }
+            let timeout_ms = runtime.watchdog_remaining_ms();
+            drop(runtime);
+            drop(engine);
+            if !result.unwrap_or(false) {
+                wake_result = this.device.notifications.wait(
+                    generation.expect("checked before servicing jobs"),
+                    timeout_ms,
+                );
+                if crate::module_parameters::timeline.value() >= 2 {
+                    this.device.notifications.last_wake.store(ticks(), Ordering::Relaxed);
+                }
+            }
+        }
+    }
+}
+
+#[pinned_drop]
+impl PinnedDrop for Execution {
+    fn drop(self: Pin<&mut Self>) {
+        // An entity can discard a job still waiting for its dependencies.
+        // Such a job never published to firmware, but its fence must finish.
+        if !self.started.load(Ordering::Acquire) {
+            self.completion.set_error(ECANCELED);
+            let _ = self.completion.signal();
+        }
+    }
+}
+
+impl sched::JobImpl for SubmissionJob {
+    fn run(job: &mut sched::Job<Self>) -> Result<Option<dma_fence::Fence>> {
+        // SUBMIT allocated it; run_job runs once per job.
+        let history = job.history.take();
+        let execution = &job.execution;
+        if crate::module_parameters::timeline.value() != 0 {
+            execution.trace.run.store(ticks(), Ordering::Relaxed);
+        }
+        // Firmware jobs cannot be replayed after a fault without a reboot.
+        if execution.started.swap(true, Ordering::AcqRel) {
+            return Err(EIO);
+        }
+        let fence = execution.completion.clone();
+        let running = (|| -> Result<Running> {
+            let history = history.ok_or(EIO)?;
+            Ok(Running {
+                execution: execution.clone(),
+                next: 0,
+                first: 0,
+                last: 0,
+                busy: 0,
+                why: 0,
+                kick: 0,
+                irq: 0,
+                rx: 0,
+                wake: 0,
+                seen: 0,
+                pending: 0,
+                error: None,
+                history,
+            })
+        })();
+        let mut inbox = execution.device.inbox.lock();
+        // JOB_CREDITS capacity: drm_sched never runs more jobs than that at once.
+        if let Err(error) = running.and_then(|r| inbox.jobs.push_within_capacity(r).map_err(|_| EIO)) {
+            drop(inbox);
+            execution.completion.set_error(error);
+            let _ = execution.completion.signal();
+            return Err(error);
+        }
+        if !inbox.running {
+            inbox.running = true;
+            let _ = workqueue::system_dfl().enqueue(execution.clone());
+        }
+        drop(inbox);
+        // A running worker may be asleep waiting for firmware on another
+        // queue. New ready work must wake it even if no GPU event arrives.
+        execution.device.notifications.notify(false);
+        Ok(Some(fence))
+    }
+
+    fn timed_out(job: &mut sched::Job<Self>) -> sched::Status {
+        job.execution.device.failed.store(true, Ordering::Release);
+        job.execution.device.notifications.notify(false);
+        // Wake the worker to quarantine firmware mappings and fail the jobs.
+        // Do not signal its lifetime fence before that cleanup here.
+        sched::Status::NoDevice
+    }
+
+    fn cancel(job: &mut sched::Job<Self>) {
+        if !job.execution.started.load(Ordering::Acquire) {
+            job.execution.completion.set_error(ECANCELED);
+            let _ = job.execution.completion.signal();
+        }
+    }
+}
+
+#[vtable]
+impl dma_fence::FenceOps for Completion {
+    fn get_driver_name<'a>(self: &'a dma_fence::FenceObject<Self>) -> &'a kernel::str::CStr {
+        c_str!("asahi")
+    }
+    fn get_timeline_name<'a>(self: &'a dma_fence::FenceObject<Self>) -> &'a kernel::str::CStr {
+        c_str!("m4-execution")
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_drm_submit.rs b/drivers/gpu/drm/asahi/g16_drm_submit.rs
new file mode 100644
index 0000000000000..8eaa3ef8d0a64
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_drm_submit.rs
@@ -0,0 +1,594 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+
+//! SUBMIT: parsing and validating commands into render and compute
+//! parameters, and queueing them as scheduler jobs.
+
+use super::*;
+
+impl File {
+    pub(super) fn submit(device: &RegDevice, _reg: &RegData<'_>, data: &mut uapi::drm_asahi_submit, file: &DrmFile) -> Result<u32> {
+        let device: &Device = device;
+        if data.flags != 0
+            || data.pad != 0
+            || data.cmdbuf_size == 0
+            || data.cmdbuf_size > 1024 * 1024
+            || data.in_sync_count > 4096
+            || data.out_sync_count > 4096
+        {
+            return Err(reject(format_args!("bad flags/pad, cmdbuf size {} or sync counts {}/{}", data.cmdbuf_size, data.in_sync_count, data.out_sync_count)));
+        }
+        let mut bytes = KVVec::new();
+        UserSlice::new(
+            UserPtr::from_addr(data.cmdbuf.try_into()?),
+            data.cmdbuf_size as usize,
+        )
+        .reader()
+        .read_all(&mut bytes, GFP_KERNEL)?;
+        let mut commands = KVec::new();
+        let mut barriers = KVec::new();
+        let mut attachments = KVec::new();
+        let mut offset = 0usize;
+        let mut renders = 0u16;
+        let mut computes = 0u16;
+        while offset < bytes.len() {
+            let mut reader = crate::util::Reader::new(&bytes[offset..]);
+            let header: uapi::drm_asahi_cmd_header = reader.read()?;
+            offset = offset.checked_add(8).ok_or_else(|| reject(format_args!("command header past the buffer")))?;
+            let end = offset.checked_add(header.size as usize).ok_or_else(|| reject(format_args!("command size overflows")))?;
+            let payload = bytes.get(offset..end).ok_or_else(|| reject(format_args!("command payload past the buffer ({} > {})", end, bytes.len())))?;
+            offset = end;
+            match u32::from(header.cmd_type) {
+                uapi::drm_asahi_cmd_type_DRM_ASAHI_CMD_RENDER => {
+                    if (header.vdm_barrier != 0xffff && header.vdm_barrier > renders)
+                        || (header.cdm_barrier != 0xffff && header.cdm_barrier > computes)
+                        || renders + computes == 64
+                    {
+                        return Err(reject(format_args!("render barrier {}/{} beyond {} renders/{} computes, or 64 commands", header.vdm_barrier, header.cdm_barrier, renders, computes)));
+                    }
+                    let command = crate::util::Reader::new(payload)
+                        .read_up_to::<uapi::drm_asahi_cmd_render>(payload.len())?;
+                    commands.push(Command::Render(command), GFP_KERNEL)?;
+                    barriers.push([header.vdm_barrier, header.cdm_barrier], GFP_KERNEL)?;
+                    renders += 1;
+                }
+                uapi::drm_asahi_cmd_type_DRM_ASAHI_CMD_COMPUTE => {
+                    if (header.vdm_barrier != 0xffff && header.vdm_barrier > renders)
+                        || (header.cdm_barrier != 0xffff && header.cdm_barrier > computes)
+                        || renders + computes == 64
+                    {
+                        return Err(reject(format_args!("compute barrier {}/{} beyond {} renders/{} computes, or 64 commands", header.vdm_barrier, header.cdm_barrier, renders, computes)));
+                    }
+                    let command = crate::util::Reader::new(payload)
+                        .read_up_to::<uapi::drm_asahi_cmd_compute>(payload.len())?;
+                    commands.push(Command::Compute(command), GFP_KERNEL)?;
+                    barriers.push([header.vdm_barrier, header.cdm_barrier], GFP_KERNEL)?;
+                    computes += 1;
+                }
+                uapi::drm_asahi_cmd_type_DRM_ASAHI_SET_VERTEX_ATTACHMENTS
+                | uapi::drm_asahi_cmd_type_DRM_ASAHI_SET_FRAGMENT_ATTACHMENTS
+                | uapi::drm_asahi_cmd_type_DRM_ASAHI_SET_COMPUTE_ATTACHMENTS => {
+                    if header.vdm_barrier != 0xffff
+                        || header.cdm_barrier != 0xffff
+                        || payload.len() % 24 != 0
+                        || payload.len() / 24 > 16
+                    {
+                        return Err(reject(format_args!("attachment command with barriers, or {} bytes (not 24 x 1..16)", payload.len())));
+                    }
+                    let mut reader = crate::util::Reader::new(payload);
+                    while !reader.is_empty() {
+                        let attachment: uapi::drm_asahi_attachment = reader.read()?;
+                        if attachment.flags != 0
+                            || attachment.pad != 0
+                            || attachment.pointer.checked_add(attachment.size).is_none()
+                        {
+                            return Err(reject(format_args!("attachment flags/pad nonzero or range overflows")));
+                        }
+                        attachments.push(attachment, GFP_KERNEL)?;
+                    }
+                }
+                kind => return Err(unsupported(format_args!("command type {}", kind))),
+            }
+        }
+        if renders + computes == 0 {
+            return Err(reject(format_args!("no render or compute command")));
+        }
+        let count = data.in_sync_count + data.out_sync_count;
+        let mut sync_bytes = KVec::new();
+        UserSlice::new(
+            UserPtr::from_addr(data.syncs.try_into()?),
+            count as usize * 16,
+        )
+        .reader()
+        .read_all(&mut sync_bytes, GFP_KERNEL)?;
+        let mut outputs = KVec::new();
+        let mut dependencies = KVec::new();
+        for (index, bytes) in sync_bytes.chunks_exact(16).enumerate() {
+            let kind = u32::from_ne_bytes(bytes[0..4].try_into().map_err(|_| EINVAL)?);
+            let handle = u32::from_ne_bytes(bytes[4..8].try_into().map_err(|_| EINVAL)?);
+            let point = u64::from_ne_bytes(bytes[8..16].try_into().map_err(|_| EINVAL)?);
+            if kind > 1 || (kind == 0 && point != 0) {
+                return Err(reject(format_args!("sync {} kind {} point {}", index, kind, point)));
+            }
+            let object = drm::syncobj::SyncObj::lookup_handle(file, handle)?;
+            if index >= data.in_sync_count as usize {
+                outputs.push(
+                    OutputSync {
+                        object,
+                        point,
+                        chain: if kind == 1 {
+                            Some(dma_fence::FenceChain::new()?)
+                        } else {
+                            None
+                        },
+                    },
+                    GFP_KERNEL,
+                )?;
+            } else {
+                let fence = object.fence_get().ok_or_else(|| reject(format_args!("in-sync {} (handle {}) has no fence: waited before any signal was submitted", index, handle)))?;
+                let fence = if kind == 1 {
+                    fence.chain_find_seqno(point)?
+                } else {
+                    Some(fence)
+                };
+                if let Some(fence) = fence {
+                    dependencies.push(fence, GFP_KERNEL)?;
+                }
+            }
+        }
+        let mut trace = Trace::default();
+        if crate::module_parameters::timeline.value() != 0 {
+            trace.ioctl = ticks();
+            trace.queue = data.queue_id;
+            trace.inputs = dependencies.len() as u32;
+            trace.pending = dependencies
+                .iter()
+                // SAFETY: The vector holds a live reference to each fence.
+                .filter(|f| !unsafe { bindings::dma_fence_is_signaled(f.raw()) })
+                .count() as u32;
+        }
+        let inner = file.inner();
+        let (mut admission, mut state) = loop {
+            let admission = device.admission.lock();
+            if device.failed.load(Ordering::Acquire) {
+                return Err(EIO);
+            }
+            let mut state = inner.state.lock();
+            let queue = state.queues.iter()
+                .find(|q| q.id == data.queue_id).ok_or(ENOENT)?;
+            let vm = state.vms.iter().find(|vm| vm.id == queue.vm).ok_or(ENOENT)?;
+            if vm.draining == 0 {
+                break (admission, state);
+            }
+            // Wait atomically with state dropped. Drop admission as well:
+            // holding it would block submissions to unrelated VMs and other
+            // files and teardown paths that need admission before state.
+            drop(admission);
+            // No submission state has been published yet; let a signalled
+            // submitter leave without waiting for the drainer's whole budget.
+            if inner.drained.wait_interruptible(&mut state) {
+                return Err(ERESTARTSYS);
+            }
+            drop(state);
+            // Reacquire in admission -> state order and re-find both IDs.
+        };
+        // Completed records no longer need lifetime bookkeeping.
+        admission.retain(|f| {
+            // SAFETY: The vector retains a live reference while queried.
+            !unsafe { bindings::dma_fence_is_signaled(f.raw()) }
+        });
+        admission.reserve(1, GFP_KERNEL)?;
+        let queue = state
+            .queues
+            .iter()
+            .find(|q| q.id == data.queue_id)
+            .ok_or(ENOENT)?;
+        // Render and compute on even one public queue may complete out of
+        // order. Give each submission its own timeline: a later independent
+        // completion must never subsume an earlier dependency in DRM.
+        let unique = dma_fence::FenceContexts::new(1, c_str!("asahi_m4"), FENCE_KEY)?
+            .new_fence(0, Completion)?;
+        // A queue that has failed work stays failed: refuse new work instead
+        // of accepting jobs that can only complete with ECANCELED.
+        if queue.firmware.lock().rejected {
+            return Err(ECANCELED);
+        }
+        let vm_id = queue.vm;
+        let firmware = queue.firmware.clone();
+        let mut timestamps = KVec::new();
+        let resolve = |stamp: &uapi::drm_asahi_timestamp| -> Result<u64> {
+            if stamp.handle == 0 {
+                return if stamp.offset == 0 {
+                    Ok(0)
+                } else {
+                    Err(reject(format_args!("timestamp offset {} without a handle", stamp.offset)))
+                };
+            }
+            let binding = state
+                .timestamps
+                .iter()
+                .find(|t| t.id == stamp.handle)
+                .ok_or(ENOENT)?;
+            let offset = u64::from(stamp.offset);
+            if offset & 7 != 0 || offset.checked_add(8).ok_or_else(|| reject(format_args!("timestamp offset overflows")))? > binding.size {
+                return Err(reject(format_args!("timestamp offset {} unaligned or beyond {}", offset, binding.size)));
+            }
+            Ok(binding.address + offset)
+        };
+        for command in &commands {
+            let resolved = match command {
+                Command::Render(c) => [
+                    resolve(&c.ts_vtx.start)?,
+                    resolve(&c.ts_vtx.end)?,
+                    resolve(&c.ts_frag.start)?,
+                    resolve(&c.ts_frag.end)?,
+                ],
+                Command::Compute(c) => [resolve(&c.ts.start)?, resolve(&c.ts.end)?, 0, 0],
+            };
+            timestamps.push(resolved, GFP_KERNEL)?;
+        }
+        let mut timestamp_bindings = KVec::new();
+        for binding in &state.timestamps {
+            timestamp_bindings.push(binding.clone(), GFP_KERNEL)?;
+        }
+        let index = state.vms.iter().position(|v| v.id == vm_id).ok_or(ENOENT)?;
+        let vm = &mut state.vms[index];
+        if vm.render_broken {
+            return Err(EIO);
+        }
+        for attachment in &attachments {
+            vm.cover(attachment.pointer, attachment.size, 4)?;
+        }
+        let mut parameters = KVec::new();
+        for command in &commands {
+            parameters.push(
+                match command {
+                    Command::Render(c) => Parameters::Render(vm.render_parameters(c)?),
+                    Command::Compute(c) => Parameters::Compute(vm.compute_parameters(c)?),
+                },
+                GFP_KERNEL,
+            )?;
+        }
+        let needs_mapping =
+            (renders != 0 && !vm.render_ready) || (computes != 0 && !vm.compute_ready);
+        if needs_mapping {
+            // These reserved namespaces are initialized once before this
+            // VM's first command on the corresponding engine.
+            let mut runtime = device.runtime.lock();
+            if runtime.render_failed() {
+                return Err(EIO);
+            }
+            if renders != 0 && !vm.render_ready {
+                let pool =
+                    render::OperandPool::new(vm.kernel.start, vm.kernel.end).ok_or_else(|| reject(format_args!("VM kernel VA {:#x}..{:#x} too small for the render operand pool", vm.kernel.start, vm.kernel.end)))?;
+                // Acquire scarce support and its Arc before editing this
+                // root. ENOSPC/ENOMEM here must not quarantine a healthy VM.
+                let support = Arc::new(
+                    runtime.acquire_render_support(&pool, vm.native_mode)?,
+                    GFP_KERNEL,
+                )?;
+                if let Err(error) = vm.space.lock()
+                    .alloc_render_private(vm.kernel.start, vm.kernel.end)
+                {
+                    // The unpublished graph owns every partial allocation
+                    // and resumes on ENOMEM. Structural/PTE inconsistencies
+                    // still quarantine the VM; do not mask those failures.
+                    vm.render_broken = error != ENOMEM;
+                    return Err(error);
+                }
+                vm.render_support = Some(support);
+                vm.render_ready = true;
+            }
+            if computes != 0 && !vm.compute_ready {
+                vm.render_broken = true;
+                runtime.map_compute_work(&mut vm.compute_space.lock(), vm.kernel.clone())?;
+                vm.compute_ready = true;
+                vm.render_broken = false;
+            }
+        }
+        // Provision what this queue's or VM root's first publication would
+        // otherwise allocate in the job worker, so a failure returns here with
+        // nothing queued instead of failing the queue later.
+        let tvb = renders != 0 && !vm.tvb_ready;
+        if tvb || !firmware.lock().provisioned() {
+            let mut runtime = device.runtime.lock();
+            if runtime.render_failed() {
+                return Err(EIO);
+            }
+            runtime.provision_queue(&mut firmware.lock())?;
+            if tvb {
+                let support = vm.render_support.as_deref().ok_or(EIO)?;
+                runtime.provision_tvb(&mut vm.space.lock(), support)?;
+                vm.tvb_ready = true;
+            }
+        }
+        // Every submission retains the VM's mappings until it completes.
+        // Share one copy until the mappings change: CS2-sized address spaces
+        // hold thousands of mappings and submit hundreds of times a frame.
+        let mappings = match &vm.snapshot {
+            Some(snapshot) => snapshot.clone(),
+            None => {
+                let mut copy = KVVec::with_capacity(vm.mappings.len(), GFP_KERNEL)?;
+                for mapping in &vm.mappings {
+                    copy.push(mapping.clone(), GFP_KERNEL)?;
+                }
+                let snapshot = Arc::new(copy, GFP_KERNEL)?;
+                vm.snapshot = Some(snapshot.clone());
+                snapshot
+            }
+        };
+        let bindings = Bindings {
+            _mappings: mappings,
+            _timestamps: timestamp_bindings,
+        };
+        vm.pending.retain(|f| {
+            // SAFETY: Each entry owns its live fence reference.
+            !unsafe { bindings::dma_fence_is_signaled(f.raw()) }
+        });
+        vm.pending.reserve(1, GFP_KERNEL)?;
+        let completion = dma_fence::Fence::from_fence(&unique);
+        let worker_completion = completion.clone();
+        let execution = Arc::pin_init(
+            try_pin_init!(Execution {
+                id: NEXT_EXECUTION.fetch_add(1, Ordering::Relaxed), firmware, barriers,
+                device: device.into(), _owner: inner.state.clone(), reaper: inner.reaper.clone(),
+                render_space: vm.space.clone(), space: vm.compute_space.clone(), _bindings: bindings,
+                support: vm.render_support.clone(),
+                parameters, timestamps, completion: worker_completion,
+                started: AtomicBool::new(false), trace, work <- new_work!("m4-execution"),
+            }),
+            GFP_KERNEL,
+        )?;
+        state.vms[index]
+            .pending
+            .push(completion.clone(), GFP_KERNEL)?;
+        let queue = state
+            .queues
+            .iter_mut()
+            .find(|q| q.id == data.queue_id)
+            .ok_or(ENOENT)?;
+        let mut history = [KVec::new(), KVec::new()];
+        // One entry per command (at most 64, checked above) plus the queue's
+        // previous stamp: run_job and the worker never grow them.
+        for events in &mut history {
+            events.reserve(65, GFP_KERNEL)?;
+        }
+        let mut job = queue.entity.new_job(1, SubmissionJob { execution, history: Some(history) })?;
+        for fence in dependencies {
+            job.add_dependency(fence)?;
+        }
+        // No fallible operation follows output-fence publication.
+        // Publish the hardware lifetime fence directly. Scheduler finished
+        // fences can be downgraded to scheduled dependencies by DRM; our
+        // external inputs must wait for actual hardware completion.
+        let fence = completion.clone();
+        admission.push(completion, GFP_KERNEL)?;
+        let job = job.arm();
+        for output in outputs {
+            if let Some(chain) = output.chain {
+                output.object.add_point(chain, &fence, output.point);
+            } else {
+                output.object.replace_fence(Some(&fence));
+            }
+        }
+        job.push();
+        Ok(0)
+    }
+}
+
+impl Vm {
+    pub(super) fn cover(&self, start: u64, size: u64, permissions: u32) -> Result {
+        Mapping::cover(&self.mappings, start, size, permissions)
+    }
+
+    pub(super) fn compute_parameters(&self, c: &uapi::drm_asahi_cmd_compute) -> Result<compute::Parameters> {
+        if c.flags != 0 || c.helper.binary != 0 || c.helper.cfg != 0 || c.helper.data != 0 {
+            return Err(unsupported(format_args!("compute flags {:#x} or a helper program", c.flags)));
+        }
+        let size = c
+            .cdm_ctrl_stream_end
+            .checked_sub(c.cdm_ctrl_stream_base)
+            .ok_or_else(|| reject(format_args!("compute stream end before base")))?;
+        if (c.cdm_ctrl_stream_base | c.cdm_ctrl_stream_end) & 3 != 0
+            || size < 4
+            || c.sampler_heap & 7 != 0
+            || c.sampler_count > 1024
+            || (c.sampler_count == 0) != (c.sampler_heap == 0)
+        {
+            return Err(reject(format_args!("compute stream {:#x}..{:#x} or sampler heap {:#x} x {}", c.cdm_ctrl_stream_base, c.cdm_ctrl_stream_end, c.sampler_heap, c.sampler_count)));
+        }
+        self.cover(c.cdm_ctrl_stream_base, size, 2)?;
+        if c.sampler_count != 0 {
+            self.cover(c.sampler_heap, u64::from(c.sampler_count) * 8, 2)?;
+        }
+        Ok(compute::Parameters {
+            tgid: kernel::current!().group_leader().pid(),
+            comm: current_comm(),
+            cdm: c.cdm_ctrl_stream_base,
+            cdm_end: c.cdm_ctrl_stream_end,
+            sampler: c.sampler_heap,
+            sampler_count: c.sampler_count,
+            scratch: compute::SCRATCH,
+            marker: compute::MARKER,
+            save_area: 0,
+        })
+    }
+
+    pub(super) fn render_parameters(&self, c: &uapi::drm_asahi_cmd_render) -> Result<render::Parameters> {
+        use uapi::{
+            drm_asahi_render_flags_DRM_ASAHI_RENDER_DBIAS_IS_INT as DBIAS_IS_INT,
+            drm_asahi_render_flags_DRM_ASAHI_RENDER_FEW_PRIMITIVES as FEW_PRIMITIVES,
+            drm_asahi_render_flags_DRM_ASAHI_RENDER_PROCESS_EMPTY_TILES as PROCESS_EMPTY_TILES,
+            drm_asahi_render_flags_DRM_ASAHI_RENDER_VDM_BARRIER_FRAGMENT as VDM_BARRIER_FRAGMENT,
+        };
+
+        if c.flags & !(PROCESS_EMPTY_TILES | DBIAS_IS_INT | VDM_BARRIER_FRAGMENT | FEW_PRIMITIVES) != 0
+            || c.vertex_helper.binary != 0
+            || c.vertex_helper.cfg != 0
+            || c.vertex_helper.data != 0
+            || c.fragment_helper.binary != 0
+            || c.fragment_helper.cfg != 0
+            || c.fragment_helper.data != 0
+        {
+            return Err(unsupported(format_args!(
+                "render flags {:#x} (known {:#x}) or a vertex/fragment helper program",
+                c.flags,
+                PROCESS_EMPTY_TILES | DBIAS_IS_INT | VDM_BARRIER_FRAGMENT | FEW_PRIMITIVES
+            )));
+        }
+        let mut p = render::Parameters::default();
+        p.tgid = kernel::current!().group_leader().pid();
+        p.comm = current_comm();
+        p.vdm_barrier_fragment = c.flags & VDM_BARRIER_FRAGMENT != 0;
+        p.set_private(self.kernel.start, self.kernel.end)
+            .ok_or_else(|| reject(format_args!("render private area outside the kernel VA")))?;
+        p.width = u64::from(c.width_px);
+        p.height = u64::from(c.height_px);
+        p.layers = u64::from(c.layers);
+        p.utile_width = u64::from(c.utile_width_px);
+        p.utile_height = u64::from(c.utile_height_px);
+        p.samples = u64::from(c.samples);
+        p.sample_size = u64::from(c.sample_size_B);
+        p.tib_blocks = (p.sample_size * p.utile_width * p.utile_height * p.samples).div_ceil(2048);
+        p.encoder = c.vdm_ctrl_stream_base;
+        if !p.valid() || p.encoder == 0 || p.encoder & 3 != 0 {
+            return Err(reject(format_args!("render parameters or encoder {:#x}", p.encoder)));
+        }
+        self.cover(p.encoder, 4, 2)?;
+        p.utile_config = (p.utile_width / 16) << 12
+            | (p.utile_height / 16) << 14
+            | match p.samples {
+                1 => 0,
+                2 => 1,
+                4 => 2,
+                _ => return Err(reject(format_args!("render samples {}", p.samples))),
+            };
+        p.process_empty_tiles = c.flags & PROCESS_EMPTY_TILES != 0;
+        p.tile_config =
+            0x280 | u64::from(p.layers > 1) | if p.process_empty_tiles { 0x10000 } else { 0 };
+        p.multisample_control = c.ppp_multisamplectl;
+        p.ppp_control = u64::from(c.ppp_ctrl);
+        p.merge_upper_x_bits = u64::from(c.isp_merge_upper_x);
+        p.merge_upper_y_bits = u64::from(c.isp_merge_upper_y);
+        // ISP control: bit 18 is the integer depth-bias formula (the UAPI flag
+        // matches it). Bit 0 selects a faster fragment tile dispatch that is
+        // only safe for passes with very few primitives; macOS sets it for at
+        // most four statically known primitives per pass, and userspace
+        // asserts the same bound with FEW_PRIMITIVES.
+        p.aux_fb_flags = 0xc000
+            | u64::from(c.flags & DBIAS_IS_INT)
+            | u64::from(c.flags & FEW_PRIMITIVES != 0);
+        p.aux_fb_page_count = 0x100000;
+        p.scissor_array = c.isp_scissor_base;
+        p.depth_bias_array = c.isp_dbias_base;
+        p.occlusion_query_base = c.isp_oclqry_base;
+        if p.scissor_array == 0 {
+            return Err(reject(format_args!("render without a scissor array")));
+        }
+        for (address, access) in [
+            (p.scissor_array, 2),
+            (p.depth_bias_array, 2),
+            (p.occlusion_query_base, 4),
+        ] {
+            if address != 0 {
+                if address & 7 != 0 {
+                    return Err(reject(format_args!("render array {:#x} unaligned", address)));
+                }
+                self.cover(address, 8, access)?;
+            }
+        }
+        for zls in [&c.depth, &c.stencil] {
+            if (zls.base == 0 && (zls.comp_base != 0 || zls.stride != 0 || zls.comp_stride != 0))
+                || (zls.comp_base == 0 && zls.comp_stride != 0)
+                || (p.layers > 1 && zls.base != 0 && zls.stride == 0)
+                || (zls.stride != 0 && zls.stride & 0x3fff != 1)
+                || zls.comp_stride & 0x3fff != 0
+            {
+                return Err(reject(format_args!("render depth/stencil base {:#x} stride {:#x} comp stride {:#x} layers {}", zls.base, zls.stride, zls.comp_stride, p.layers)));
+            }
+            if zls.base != 0 {
+                let stride = if zls.stride == 0 {
+                    0
+                } else {
+                    (u64::from(zls.stride >> 14) + 1) * 0x4000
+                };
+                self.cover(zls.base, stride * (p.layers - 1) + 1, 6)?;
+            }
+            if zls.comp_base != 0 {
+                self.cover(
+                    zls.comp_base,
+                    (u64::from(zls.comp_stride >> 14) + 1) * 0x80 * (p.layers - 1) + 1,
+                    6,
+                )?;
+            }
+        }
+        p.depth_buffer = c.depth.base;
+        p.depth_aux_buffer = c.depth.comp_base;
+        p.depth_stride = u64::from(c.depth.stride);
+        p.depth_aux_stride = u64::from(c.depth.comp_stride);
+        p.stencil_buffer = c.stencil.base;
+        p.stencil_aux_buffer = c.stencil.comp_base;
+        p.stencil_stride = u64::from(c.stencil.stride);
+        p.stencil_aux_stride = u64::from(c.stencil.comp_stride);
+        p.depth_flags = c.zls_ctrl;
+        p.depth_dimensions = u64::from(c.isp_zls_pixels);
+        p.depth_clear_value_bits = u64::from(c.isp_bgobjdepth);
+        p.stencil_clear_value = u64::from(c.isp_bgobjvals);
+        p.sampler_array = c.sampler_heap;
+        p.sampler_count = u64::from(c.sampler_count);
+        if !p.valid() || p.sampler_count > 1024 {
+            return Err(reject(format_args!("render parameters or {} samplers", p.sampler_count)));
+        }
+        if p.sampler_count != 0 {
+            self.cover(p.sampler_array, p.sampler_count * 8, 2)?;
+        }
+        for (program, optional) in [
+            (&c.bg, true),
+            (&c.eot, false),
+            (&c.partial_bg, c.bg.usc == 0),
+            (&c.partial_eot, false),
+        ] {
+            if program.usc == 0 {
+                if !optional || program.rsrc_spec != 0 {
+                    return Err(reject(format_args!("render background/end-of-tile program missing or with resources")));
+                }
+            } else {
+                self.cover((1 << 40) + u64::from(program.usc & !7), 4, 2)?;
+            }
+        }
+        let pipeline = |v: u32| if v == 0 { 0 } else { (1 << 40) + u64::from(v) };
+        let load_bind = |v: &uapi::drm_asahi_bg_eot| {
+            if v.usc == 0 {
+                0
+            } else {
+                0xffff800000000000 | u64::from(v.rsrc_spec)
+            }
+        };
+        p.load_pipeline = pipeline(c.bg.usc);
+        p.load_pipeline_bind = load_bind(&c.bg);
+        p.partial_load_pipeline = pipeline(c.partial_bg.usc);
+        p.partial_load_pipeline_bind = load_bind(&c.partial_bg);
+        p.store_pipeline = pipeline(c.eot.usc);
+        p.store_pipeline_bind = u64::from(c.eot.rsrc_spec);
+        p.partial_store_pipeline = pipeline(c.partial_eot.usc);
+        p.partial_store_pipeline_bind = u64::from(c.partial_eot.rsrc_spec);
+        p.request_tvb_growth = true;
+        p.tiling_admission = 7;
+        p.fragment_admission = 7;
+        p.cycle = 0x240030;
+        p.tiling_gate = 0xa900400020;
+        p.fragment_gate = 0xd500400020;
+        p.tiling_lifecycle = 0x08009f520900a6bb;
+        p.fragment_lifecycle = 0x08009f520900a6ba;
+        p.tiling_work_stamp = 0x120;
+        p.fragment_work_stamp = 0x121;
+        // macOS writes 0-3 (3 solo, mostly 1 under contention); this driver's
+        // original value is 4.
+        p.completion_control = 4;
+        p.layermeta = p.heapmeta;
+        if p.layers > 1 {
+            p.heapmeta += 0x100;
+        }
+        Ok(p)
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_finished.rs b/drivers/gpu/drm/asahi/g16_finished.rs
new file mode 100644
index 0000000000000..dd03eb876027f
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_finished.rs
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright 2026 The Asahi Linux Contributors
+
+//! Collecting finished jobs into a bounded, reusable list.
+//!
+//! The job worker moves finished jobs out of the engine's job list into a
+//! list preallocated to the scheduler's credit limit, and signals them with
+//! the locks dropped. Both lists are fixed-capacity: nothing here allocates,
+//! and a job that does not fit stays where it is for a later pass instead of
+//! being lost or panicking. Pure list logic, host-tested.
+
+/// A fixed-capacity list as this logic sees it (`KVec` in the kernel).
+pub(crate) trait Bounded<T> {
+    fn len(&self) -> usize;
+    fn capacity(&self) -> usize;
+    fn get_at(&self, index: usize) -> Option<&T>;
+    fn remove_at(&mut self, index: usize) -> Option<T>;
+    /// Push without growing; gives the value back if full.
+    fn push_within(&mut self, value: T) -> Result<(), T>;
+    /// Insert without growing; gives the value back if full.
+    fn insert_within(&mut self, index: usize, value: T) -> Result<(), T>;
+}
+
+/// Moves every job of `jobs` for which `done` holds into `finished`, keeping
+/// both lists' order. Stops early, leaving the rest in `jobs`, when `finished`
+/// is full. Returns whether every finished job was moved.
+pub(crate) fn collect<T, L: Bounded<T>>(jobs: &mut L, finished: &mut L, done: impl Fn(&T) -> bool) -> bool {
+    let mut index = 0;
+    while let Some(job) = jobs.get_at(index) {
+        if !done(job) {
+            index += 1;
+            continue;
+        }
+        if finished.len() >= finished.capacity() {
+            return false;
+        }
+        let Some(job) = jobs.remove_at(index) else { return false };
+        if let Err(job) = finished.push_within(job) {
+            // Unreachable after the check; put the job back where it was.
+            let _ = jobs.insert_within(index, job);
+            return false;
+        }
+    }
+    true
+}
diff --git a/drivers/gpu/drm/asahi/g16_fw.rs b/drivers/gpu/drm/asahi/g16_fw.rs
new file mode 100644
index 0000000000000..253bcdcf03064
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_fw.rs
@@ -0,0 +1,274 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+// Adapted from Niklas Sheth's linux-m4-integration prototype.
+
+//! G16 firmware initialization descriptors, serialized independently of Rust
+//! structure alignment. Fields follow the source-built m1n1 G16 model.
+
+use crate::util::{put64};
+
+#[path = "g16_queue.rs"]
+pub(crate) mod queue;
+
+pub(crate) const ROOT_ADDRESS: u64 = 0xffff_fc20_0010_0000;
+pub(crate) const ROOT_SIZE: usize = 0xc8;
+pub(crate) const BUNDLE_ADDRESS: u64 = 0xffff_fc20_c04d_8000;
+pub(crate) const BUNDLE_SIZE: usize = 0x20000;
+pub(crate) const MAIN_OFFSET: usize = 0x1da40;
+pub(crate) const MAIN_SIZE: usize = 0x500;
+pub(crate) const CONTROL_DATA: u64 = 0xffff_fc20_c052_8000;
+pub(crate) const CONTROL_AUX: u64 = 0xffff_fc20_0014_8000;
+pub(crate) const OPERAND_TABLE: u64 = 0x70_0040_8000;
+pub(crate) const TIMESTAMP_BASE: u64 = 0xffff_fc21_8140_0000;
+pub(crate) const TIMESTAMP_SIZE: u64 = 0x400_0000;
+
+/// Control message releasing firmware's GPU context ID binding for a context
+/// object. The fields are copied from bytes firmware maintains in the context.
+pub(crate) fn destroy_context(address: u64, fields: [u8; 4]) -> [u8; 0x40] {
+    let mut out = [0; 0x40];
+    out[..4].copy_from_slice(&0x14u32.to_le_bytes());
+    out[8..12].copy_from_slice(&fields);
+    put64(&mut out, 12, address);
+    out
+}
+
+/// The two publications following firmware's already-consumed slot zero.
+pub(crate) fn opening_control() -> [u8; 0x80] {
+    let mut out = [0u8; 0x80];
+    out[..4].copy_from_slice(&0x16u32.to_le_bytes());
+    let record = &mut out[0x40..];
+    for (offset, value) in [(0, 0x20u32), (4, 1), (8, 0x3f), (0x2c, 20 * 8), (0x34, 1)] {
+        record[offset..offset + 4].copy_from_slice(&value.to_le_bytes());
+    }
+    put64(record, 0x14, CONTROL_DATA);
+    put64(record, 0x1c, OPERAND_TABLE);
+    put64(record, 0x24, OPERAND_TABLE);
+    out
+}
+
+/// Fresh opening FList; its operand descriptors are admitted by opcode 0x20.
+pub(crate) fn opening_flist() -> [u8; 0x80] {
+    let mut out = [0; 0x80];
+    for (off, value) in [(0, 1u32), (0x1c, 0x400000 / 8), (0x28, 1)] {
+        out[off..off + 4].copy_from_slice(&value.to_le_bytes());
+    }
+    put64(&mut out, 0x14, 0x70_0000_0000);
+    put64(&mut out, 0x30, OPERAND_TABLE);
+    put64(&mut out, 0x4c, CONTROL_AUX);
+    out
+}
+
+/// One freshly owned parameter-buffer descriptor; firmware owns both cursors.
+pub(crate) fn parameter_buffer_descriptor(page_list: u64, page_count: u32) -> Option<[u8; 16]> {
+    if !(0x10_0000_0000..0x20_0000_0000).contains(&page_list)
+        || page_list & 0x7f != 0
+        || page_count == 0
+        || page_count >= 1 << 22
+    {
+        return None;
+    }
+    let mut out = [0; 16];
+    out[..4].copy_from_slice(&((page_list >> 4) as u32 & 0xfffffff8).to_le_bytes());
+    out[4..8].copy_from_slice(&page_count.to_le_bytes());
+    Some(out)
+}
+
+/// Addresses of 4 KiB accelerator pages within twenty guarded 2 MiB buffers.
+pub(crate) fn operand_page(index: usize) -> u64 {
+    0x70_0042_0000 + (index / 512) as u64 * 0x208000 + (index % 512) as u64 * 0x1000
+}
+
+
+/// Three independent cursor addresses followed by the ring address.
+pub(crate) struct Channel {
+    pub(crate) state: [u64; 3],
+    pub(crate) ring: u64,
+}
+
+pub(crate) struct MainConfig {
+    pub(crate) hwdata: u64,
+    pub(crate) repeated: u64,
+    pub(crate) header: u64,
+    pub(crate) channels: [Channel; 17],
+    pub(crate) addresses: [u64; 5],
+    pub(crate) regions: [u64; 6],
+    pub(crate) unaligned: u64,
+}
+
+const WORK_RINGS: [u64; 12] = [
+    0x10240, 0x16240, 0x1c240, 0xea40, 0x14a40, 0x1aa40, 0xd240, 0x13240, 0x19240, 0xba40,
+    0x11a40, 0x17a40,
+];
+const WORK_STATES: [(u64, u64); 12] = [
+    (0, 0),
+    (0x40, 0x20),
+    (0x80, 0x40),
+    (0x10, 8),
+    (0x50, 0x28),
+    (0x90, 0x48),
+    (0x20, 0x10),
+    (0x60, 0x30),
+    (0xa0, 0x50),
+    (0x30, 0x18),
+    (0x70, 0x38),
+    (0xb0, 0x58),
+];
+
+/// One work channel's route (priority * 3 + stage), without building the
+/// whole configuration: the submission path needs only this.
+pub(crate) fn work_channel(bundle: u64, i: usize) -> Channel {
+    let a = 0xffff_fc20_0002_8000 + WORK_STATES[i].0;
+    Channel {
+        state: [a, a + 8, 0xffff_fc20_0002_0000 + WORK_STATES[i].1],
+        ring: bundle + WORK_RINGS[i],
+    }
+}
+
+impl MainConfig {
+    pub(crate) fn bootstrap(bundle: u64) -> Self {
+        let channels = core::array::from_fn(|i| {
+            if i < 12 {
+                work_channel(bundle, i)
+            } else {
+                let (state, ring) = match i {
+                    12 => (
+                        [
+                            0xffff_fc20_0002_80c0,
+                            0xffff_fc20_0002_80c8,
+                            0xffff_fc20_0002_0060,
+                        ],
+                        BUNDLE_ADDRESS + 0x1df00,
+                    ),
+                    13 => (
+                        [
+                            0xffff_fc20_0003_f1c0,
+                            0xffff_fc20_0003_f440,
+                            0xffff_fc20_0003_f200,
+                        ],
+                        0xffff_fc20_0004_3c40,
+                    ),
+                    14 => (
+                        [
+                            0xffff_fc20_0003_f3c0,
+                            0xffff_fc20_000e_5c40,
+                            0xffff_fc20_0003_f400,
+                        ],
+                        0xffff_fc20_000e_ec40,
+                    ),
+                    15 => ([0xffff_fc20_0006_c440, 0, 0], 0),
+                    _ => ([0, 0, 0], 0),
+                };
+                Channel { state, ring }
+            }
+        });
+        Self {
+            hwdata: bundle,
+            repeated: bundle + 0xb980,
+            header: 0xffff_fc20_0002_0068,
+            channels,
+            addresses: [
+                0,
+                bundle + 0x2680,
+                bundle + 0x32c0,
+                bundle + 0x4540,
+                bundle + 0xb900,
+            ],
+            regions: [
+                0xffff_fc20_c051_8000,
+                0x70_0027_8000,
+                0xffff_fc20_0012_8000,
+                0x70_0028_0000,
+                0xffff_fc20_0013_0000,
+                0,
+            ],
+            unaligned: bundle + 0x5380,
+        }
+    }
+
+    pub(crate) fn encode(&self) -> [u8; MAIN_SIZE] {
+        let mut out = [0; MAIN_SIZE];
+        for (offset, value) in [
+            (0, self.hwdata),
+            (8, self.repeated),
+            (16, self.repeated),
+            (24, self.header),
+            (0x469, self.unaligned),
+        ] {
+            put64(&mut out, offset, value);
+        }
+        for (i, channel) in self.channels.iter().enumerate() {
+            let base = 0x20 + i * 0x20;
+            for (j, value) in channel.state.iter().enumerate() {
+                put64(&mut out, base + j * 8, *value);
+            }
+            put64(&mut out, base + 24, channel.ring);
+        }
+        for (i, value) in self.addresses.iter().enumerate() {
+            put64(&mut out, 0x24c + i * 8, *value);
+        }
+        for (i, value) in self.regions.iter().enumerate() {
+            put64(&mut out, 0x2c8 + i * 8, *value);
+        }
+        for (offset, value) in [(0x2f8, 4u32), (0x3d8, 0xff), (0x4c0, 0x16)] {
+            out[offset..offset + 4].copy_from_slice(&value.to_le_bytes());
+        }
+        out
+    }
+}
+
+pub(crate) struct RootPointers {
+    pub(crate) region_a: u64,
+    pub(crate) main_config: u64,
+    pub(crate) region_c: u64,
+    pub(crate) status_a: u64,
+    pub(crate) status_b: u64,
+    pub(crate) extra_0: u64,
+    pub(crate) extra_1: u64,
+}
+
+impl RootPointers {
+    /// Initial firmware namespace. Client addresses are allocated separately.
+    pub(crate) const fn bootstrap() -> Self {
+        Self {
+            region_a: 0xffff_fc20_0010_8000,
+            main_config: BUNDLE_ADDRESS + MAIN_OFFSET as u64,
+            region_c: 0xffff_fc20_000f_8000,
+            status_a: 0xffff_fc20_0003_f180,
+            status_b: 0xffff_fc20_0003_0000,
+            extra_0: 0xffff_fc20_0003_eb00,
+            extra_1: 0xffff_fc20_000f_3440,
+        }
+    }
+
+    pub(crate) fn encode(&self) -> [u8; ROOT_SIZE] {
+        let mut out = [0u8; ROOT_SIZE];
+        for (i, value) in [0x04b8u16, 0x8392, 0xc357, 0x0c89].iter().enumerate() {
+            out[i * 2..i * 2 + 2].copy_from_slice(&value.to_le_bytes());
+        }
+        for (offset, value) in [
+            (0x08, self.region_a),
+            (0x18, self.main_config),
+            (0x20, self.region_c),
+            (0xa8, self.status_a),
+            (0xb0, self.status_b),
+            (0xb8, self.extra_0),
+            (0xc0, self.extra_1),
+        ] {
+            out[offset..offset + 8].copy_from_slice(&value.to_le_bytes());
+        }
+        out[0x2c..0x30].copy_from_slice(&1u32.to_le_bytes());
+        out[0x30..0x32].copy_from_slice(&0x4000u16.to_le_bytes());
+        out[0x32] = 14;
+        out[0x33] = 3;
+        for (i, (shift, entries)) in [(36u8, 64u16), (25, 2048), (14, 2048)].iter().enumerate() {
+            let level = &mut out[0x34 + i * 0x20..0x54 + i * 0x20];
+            level[..4].copy_from_slice(&[8, 14, 14, *shift]);
+            level[4..6].copy_from_slice(&entries.to_le_bytes());
+            level[6..8].copy_from_slice(&0x4000u16.to_le_bytes());
+            level[8..16].copy_from_slice(&1u64.to_le_bytes());
+            level[16..24].copy_from_slice(&0x0000_03ff_ffff_c000u64.to_le_bytes());
+            level[24..32].copy_from_slice(&((u64::from(*entries) - 1) << shift).to_le_bytes());
+        }
+        out
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_mesh.rs b/drivers/gpu/drm/asahi/g16_mesh.rs
new file mode 100644
index 0000000000000..7d910f984d452
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_mesh.rs
@@ -0,0 +1,349 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright 2026 The Asahi Linux Contributors
+
+//! Native object/mesh launch for the paired experiment.
+//!
+//! The render UAPI does not distinguish a user object shader from a stub that
+//! writes outputs. `native_mesh=1/2/3` selects the user-object convention. A paired
+//! stream starts with a complete mesh state; there is no search for magic words
+//! inside shader data, PPP records, or ordinary vertex streams.
+
+/// Runtime copy of `asahi_m4.native_mesh`, writable from debugfs
+/// `asahi_m4/native_mesh` without a reboot, and the generation of its last
+/// change: `generation << 8 | mode` in one word, so a writer, a VM's latch and
+/// the advertisement always see a consistent pair. A VM latches the mode when
+/// it is created (`Vm::native_mode`); its support header and every decode use
+/// that latch, so a later change affects only VMs created after it.
+static NATIVE_MESH: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+
+/// The highest accepted `native_mesh` value.
+pub(crate) const MAX_MODE: u32 = 4;
+
+/// The current (generation, mode).
+pub(crate) fn snapshot() -> (u64, u32) {
+    let value = NATIVE_MESH.load(core::sync::atomic::Ordering::Acquire);
+    (value >> 8, (value & 0xff) as u32)
+}
+
+pub(crate) fn mode() -> u32 {
+    snapshot().1
+}
+
+/// The boot value: generation 0.
+pub(crate) fn init_mode(mode: u32) {
+    NATIVE_MESH.store(u64::from(mode.min(MAX_MODE)), core::sync::atomic::Ordering::Release);
+}
+
+/// A runtime change. Every call, even to the current mode, starts a new
+/// generation, so a reader that sees one generation twice knows the mode held
+/// in between. Returns the new generation.
+pub(crate) fn set_mode(mode: u32) -> u64 {
+    use core::sync::atomic::Ordering::{AcqRel, Acquire};
+    let next = |value: u64| (((value >> 8) + 1) << 8) | u64::from(mode.min(MAX_MODE));
+    let previous = NATIVE_MESH.fetch_update(AcqRel, Acquire, |value| Some(next(value)));
+    next(previous.unwrap_or_else(|value| value)) >> 8
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Mode {
+    Disabled,
+    SingleParent,
+    MultipleParents,
+    /// Research admission for the capability study: the wider state model in
+    /// `research_state`, with mode 2's object dispatch rules. Not qualified.
+    Research,
+    /// Exactly the 31 device-qualified native-index classes (`QUALIFIED`), with
+    /// the single-parent dispatches they were qualified with: Honeykrisp's
+    /// (16, 1, 1) and the scalar (1, 1, 1) fixture carrier.
+    Qualified,
+}
+
+impl Mode {
+    pub(crate) fn from_parameter(value: u32) -> Option<Self> {
+        match value {
+            0 => Some(Self::Disabled),
+            1 => Some(Self::SingleParent),
+            2 => Some(Self::MultipleParents),
+            3 => Some(Self::Research),
+            4 => Some(Self::Qualified),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn enabled(self) -> bool {
+        self != Self::Disabled
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Profile {
+    /// Exclusive per-render storage, filled by prepare_render, never userspace.
+    pub(crate) payload: u64,
+}
+
+impl Profile {
+    pub(crate) const PAYLOAD_BYTES: usize = 0x4000;
+    pub(crate) const TA_SIZE: u64 = 0x13300;
+    pub(crate) const GATE: u64 = 0xec_0040_0020;
+
+    pub(crate) fn payload_register(self) -> Option<u64> {
+        // Absolute-address interpretation, still requiring device qualification.
+        // Do not retain the research kernel's captured context-relative address.
+        (self.payload != 0 && self.payload < (1 << 40) && self.payload & 0x3fff == 0)
+            .then_some(0x0200_0000_0000_0000 | self.payload)
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum DecodeError {
+    Unmapped,
+    Unsupported,
+}
+
+/// Admit the paired T16/T32 class: four vertices' storage, one primitive and one
+/// direct object dispatch, with position and up to 124 per-vertex scalars.
+/// Primitive outputs, task payload and wider resource classes remain excluded.
+/// Mode 1 retains the qualified one-parent class. Only mode 2 admits multiple
+/// complete physical object workgroups, pending device qualification.
+/// This does not bound the child grid computed by the object shader, nor prove
+/// that a particular aggregate workload fits the available GPU resources.
+/// Mode 3 replaces the state check with `research_state` and also admits point
+/// and line draws; the stream structure and object dispatch rules are mode 2's.
+/// The packet budget bounds malformed streams, including a missing terminator.
+/// The first word of a native object/mesh stream.
+const NATIVE_HEADER: u32 = 0x4000_0d2c;
+
+/// Whether a stream starting with `header` may be native: the native header,
+/// or an unfamiliar header with the native state extension (bit 11), which
+/// `decode` rejects. Any other first word makes `decode` return `Ok(None)`
+/// without reading further, so an ordinary render needs nothing else.
+pub(crate) fn may_be_native(header: u32) -> bool {
+    header == NATIVE_HEADER || (header >> 29 == 2 && header & (1 << 11) != 0)
+}
+
+pub(crate) fn decode(
+    start: u64,
+    mode: Mode,
+    mut read: impl FnMut(u64) -> Option<u32>,
+) -> Result<Option<Profile>, DecodeError> {
+    if !mode.enabled() {
+        return Ok(None);
+    }
+    let mut cursor = start;
+    let mut remaining = 1024;
+    let mut next = || {
+        if remaining == 0 || cursor & 3 != 0 {
+            return Err(DecodeError::Unsupported);
+        }
+        remaining -= 1;
+        let value = read(cursor).ok_or(DecodeError::Unmapped)?;
+        cursor = cursor.checked_add(4).ok_or(DecodeError::Unsupported)?;
+        Ok(value)
+    };
+    let header = next()?;
+    if header != NATIVE_HEADER {
+        // Bit 11 marks the native state extension. Reject unfamiliar native
+        // layouts rather than submitting them with ordinary TA state.
+        return if may_be_native(header) {
+            Err(DecodeError::Unsupported)
+        } else {
+            Ok(None)
+        };
+    }
+    let mut state = [0; 13];
+    for word in &mut state {
+        *word = next()?;
+    }
+    // The low byte counts scalar vertex planes, including XYZW. The next byte
+    // includes the cull/header row as well. For the four-vertex storage class,
+    // each plane occupies 16 bytes, and word 13 repeats that row count. Require
+    // their relationship, rather than enumerating individual shader layouts.
+    // The paired Mesa limit is 128 components (2080 local bytes including the
+    // 32-byte count/index header). The uploaded launch rounds this allocation
+    // up to a power of two. This packet parser does not validate shader code or
+    // its local-allocation instructions.
+    let components = state[0] & 0xff;
+    if mode == Mode::Research {
+        if !research_state(&state) {
+            return Err(DecodeError::Unsupported);
+        }
+    } else if mode == Mode::Qualified {
+        if !qualified_state(&state) {
+            return Err(DecodeError::Unsupported);
+        }
+    } else if !(4..=128).contains(&components)
+        || state[0] != components | ((components + 1) << 8)
+        || state[1] != 0x10
+        || state[2] != 0
+        || state[3] != 0
+        || state[8] != 1
+        || state[9] != 0
+        || !matches!(state[10], 0x400810 | 0x400820)
+        || state[11] != 0
+        || state[12] != components + 1
+    {
+        return Err(DecodeError::Unsupported);
+    }
+    // Words 5..8 describe the object and mesh USC launches, including resource
+    // counts and relocatable handles. They are consumed by the GPU as submitted.
+    let mut drew = false;
+    loop {
+        let word = next()?;
+        match word >> 29 {
+            0 if word & 0x1fff_0000 == 0 && word & 0xff00 != 0 => {
+                // PPP state update: one header and one context-relative pointer.
+                next()?;
+            }
+            1 if word & !0x2000_0013 == 0 => {} // G16 coherency barrier
+            3 if !drew
+                && (word == 0x7000_0600
+                    || (mode == Mode::Research && matches!(word, 0x7000_0000 | 0x7000_0100))) =>
+            {
+                // Total threads describe a nonempty grid of complete object
+                // workgroups. Keep the scalar carrier and physical T16/T32,
+                // independently of the mesh width in the state packet.
+                let total = [next()?, next()?, next()?];
+                let local = [next()?, next()?, next()?];
+                if !matches!(local, [1, 1, 1] | [16, 1, 1] | [32, 1, 1])
+                    || (mode == Mode::SingleParent && total != local)
+                    || (mode == Mode::Qualified
+                        && (!matches!(local, [1, 1, 1] | [16, 1, 1]) || total != local))
+                    || total
+                        .iter()
+                        .zip(local)
+                        .any(|(&n, size)| n == 0 || n % size != 0)
+                {
+                    return Err(DecodeError::Unsupported);
+                }
+                drew = true;
+            }
+            6 if word == 0xc000_0000 && drew => return Ok(Some(Profile { payload: 0 })),
+            // Includes links, indirect draws, mixed vertex/mesh streams, a
+            // second draw, and state changes requiring a different size class.
+            _ => return Err(DecodeError::Unsupported),
+        }
+    }
+}
+
+/// The qualified layouts (`native_mesh=4`): (mesh state word 11, primitive
+/// word 10, vertex row word 13) of the 31 classes in Mesa's
+/// `hk_apple9_native_index_shapes.def`, from their qualification fixtures. The
+/// kernel sees vertices only as ceil(V / 4) quads, so V3 and V4 share a layout
+/// at P1 and P2; the exact class is Mesa's. T16V16P16 is deliberately absent.
+const QUALIFIED: [(u32, u32, u32); 29] = [
+    // T16, one vertex quad (V3, V4): P1..P8, P11, P17, P20, P21.
+    (0x400810, 0, 5), (0x400810, 1, 5), (0x400810, 2, 5), (0x400810, 3, 5),
+    (0x400810, 4, 5), (0x400810, 5, 5), (0x400810, 6, 5), (0x400810, 7, 5),
+    (0x400810, 10, 5), (0x400810, 0x10010, 5), (0x400810, 0x10013, 5), (0x400810, 0x10014, 5),
+    // T16, two quads (V6, V8): P2, P3, P5, P8.
+    (0x400810, 1, 9), (0x400810, 2, 9), (0x400810, 4, 9), (0x400810, 7, 9),
+    // T16, four quads (V16): P4, P8, P17, P21.
+    (0x400810, 3, 17), (0x400810, 7, 17), (0x400810, 0x10010, 17), (0x400810, 0x10014, 17),
+    // T32: V3P1; V24 (six quads) P3, P17, P31, P32; V32 (eight quads) P16, P32, P41, P42.
+    (0x400820, 0, 5),
+    (0x400820, 2, 25), (0x400820, 0x10010, 25), (0x400820, 0x1001e, 25), (0x400820, 0x1001f, 25),
+    (0x400820, 15, 33), (0x400820, 0x1001f, 33), (0x400820, 0x20028, 33), (0x400820, 0x20029, 33),
+];
+
+/// Mode 4's state check: position-only (four planes, no primitive data or
+/// components), as qualified, at one of the `QUALIFIED` layouts. The object
+/// dispatch must be a single parent of (16, 1, 1), as Honeykrisp emits, or the
+/// scalar (1, 1, 1) of the qualification fixtures.
+fn qualified_state(state: &[u32; 13]) -> bool {
+    state[0] == 0x504
+        && state[1] == 0x10
+        && state[2] == 0
+        && state[3] == 0
+        && state[8] == 1
+        && state[11] == 0
+        && QUALIFIED.contains(&(state[10], state[9], state[12]))
+}
+
+/// sha256 of the canonical class list `QUALIFIED` was taken from: one line
+/// `T<t>V<v>P<p>\n` per `HK_NATIVE_INDEX_SHAPE(t, v, p)` of Mesa's
+/// `hk_apple9_native_index_shapes.def`, in file order (31 classes).
+pub(crate) const QUALIFIED_CLASSES_SHA256: &str =
+    "5550ecf263192c596c3f9d8c3b84c0324ac3d0c8ee76da37c378205247f1a3bd";
+
+/// The longest advertisement line, newline included.
+pub(crate) const ADVERTISEMENT_MAX: usize = 160;
+
+/// The native-index advertisement (sysfs `asahi_native_mesh` on the GPU
+/// device), one line: `asahi-native-mesh v1 generation=<G> profile=<P>
+/// classes=<H>`. `qualified` (mode 4) carries the class-list hash, `research`
+/// (mode 3) and `none` (modes 0-2) carry `-`. Userspace treats only
+/// `qualified` with the expected hash as positive, and samples it before and
+/// after VM_CREATE (see `snapshot`).
+pub(crate) fn advertise(generation: u64, mode: u32, out: &mut impl core::fmt::Write) -> core::fmt::Result {
+    let (profile, classes) = match Mode::from_parameter(mode) {
+        Some(Mode::Qualified) => ("qualified", QUALIFIED_CLASSES_SHA256),
+        Some(Mode::Research) => ("research", "-"),
+        _ => ("none", "-"),
+    };
+    writeln!(out, "asahi-native-mesh v1 generation={generation} profile={profile} classes={classes}")
+}
+
+/// Research state model (`native_mesh=3`), from the 2026-10-22 capability
+/// study's own-MSL captures: n vertex planes, P primitives, ceil(V / 4) vertex
+/// quads and C 32-bit primitive components.
+///
+/// - word 1: n | (n + 1) << 8, 4 <= n <= 128
+/// - word 2: 0xd0 with primitive data (C > 0), otherwise 0x10
+/// - word 10: (P - 1) | (ceil(P / 16) - 1) << 16, 1 <= P <= 512, no culling
+/// - word 11: T16 or T32 mesh state, as in modes 1 and 2. Physical W64
+///   (0x400840) only for one probe shape: 4 vertex planes, one primitive, no
+///   primitive data, one vertex quad. That admits the W64 study's streams
+///   and qualifies neither W64 completion nor the fixed TA support resources.
+/// - word 12: P * C, 0 <= C <= 128
+/// - word 13: 1 + ceil(V / 4) * n, 1 <= V <= 256
+///
+/// Primitive data adds one link plane to n. The application output, vertex
+/// planes without that link plus 4 * P * C bytes of primitive data, must fit
+/// the compiler's 32 KiB mesh-output limit. Words 3, 4 and 9 keep their mode
+/// 1/2 values; words 5..8 are launch handles, as in the other modes. The object
+/// payload is not a packet field. Its exclusive storage is fixed at 16 KiB,
+/// the largest payload in the study. Everything is computed from the 13 words
+/// already read, so this adds no command-memory reads.
+/// The one research shape admitted at physical W64 (see `research_state`).
+fn w64_probe(state: &[u32; 13]) -> bool {
+    state[10] == 0x400840
+        && state[0] == 0x504
+        && state[1] == 0x10
+        && state[9] == 0
+        && state[11] == 0
+        && state[12] == 5
+}
+
+fn research_state(state: &[u32; 13]) -> bool {
+    let planes = state[0] & 0xff;
+    let primitives = (state[9] & 0xffff) + 1;
+    let data = state[1] == 0xd0;
+    if !(4..=128).contains(&planes)
+        || state[0] != planes | ((planes + 1) << 8)
+        || !matches!(state[1], 0x10 | 0xd0)
+        || state[2] != 0
+        || state[3] != 0
+        || state[8] != 1
+        || primitives > 512
+        || state[9] != (primitives - 1) | ((primitives.div_ceil(16) - 1) << 16)
+        || !(matches!(state[10], 0x400810 | 0x400820) || w64_probe(state))
+    {
+        return false;
+    }
+    let components = state[11] / primitives;
+    if state[11] % primitives != 0
+        || data != (components != 0)
+        || components > 128
+        || (data && planes < 5)
+    {
+        return false;
+    }
+    // The row count includes the header row. At most 64 vertex quads (V <= 256).
+    let rows = state[12].wrapping_sub(1);
+    let quads = rows / planes;
+    if rows % planes != 0 || !(1..=64).contains(&quads) {
+        return false;
+    }
+    // Bounded above: at most 64 * 16 * 128 + 4 * 512 * 128 bytes.
+    quads * 16 * (planes - u32::from(data)) + 4 * primitives * components <= 0x8000
+}
diff --git a/drivers/gpu/drm/asahi/g16_notify.rs b/drivers/gpu/drm/asahi/g16_notify.rs
new file mode 100644
index 0000000000000..2f62cfd79a668
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_notify.rs
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+
+//! RTKit and scheduler wakeups for the single G16 submission worker.
+
+use core::sync::atomic::AtomicU64;
+use kernel::sync::{CondVar, CondVarTimeoutResult, Mutex};
+use kernel::{prelude::*, time::msecs_to_jiffies};
+
+#[pin_data]
+pub(crate) struct Notifications {
+    /// timeline=2: CNTVCT of the latest completion message at IRQ time, when
+    /// RTKit's workqueue delivered it, and when the pump last woke.
+    pub(crate) last_irq: AtomicU64,
+    pub(crate) last_rx: AtomicU64,
+    pub(crate) last_wake: AtomicU64,
+    #[pin]
+    state: Mutex<State>,
+    #[pin]
+    changed: CondVar,
+}
+
+struct State {
+    generation: u64,
+    crashed: bool,
+}
+
+impl Notifications {
+    pub(crate) fn new() -> impl PinInit<Self> {
+        pin_init!(Self {
+            last_irq: AtomicU64::new(0),
+            last_rx: AtomicU64::new(0),
+            last_wake: AtomicU64::new(0),
+            state <- kernel::new_mutex!(State { generation: 0, crashed: false }),
+            changed <- kernel::new_condvar!(),
+        })
+    }
+
+    /// Called from RTKit's threaded callback or a DRM scheduler callback.
+    /// Neither callback needs the submission engine or firmware memory lock.
+    pub(crate) fn notify(&self, crashed: bool) {
+        let mut state = self.state.lock();
+        state.crashed |= crashed;
+        state.generation = state.generation.wrapping_add(1);
+        self.changed.notify_one();
+    }
+
+    /// Sample before inspecting firmware or ready jobs. A notification between
+    /// that inspection and sleeping must cause another inspection, not be lost.
+    pub(crate) fn snapshot(&self) -> Result<u64> {
+        let state = self.state.lock();
+        if state.crashed {
+            return Err(EIO);
+        }
+        Ok(state.generation)
+    }
+
+    /// Sleep until the sampled generation changes or the progress watchdog
+    /// expires. Spurious wakeups preserve the remaining timeout.
+    pub(crate) fn wait(&self, generation: u64, timeout_ms: u32) -> Result {
+        let mut remaining = msecs_to_jiffies(timeout_ms.max(1));
+        let mut state = self.state.lock();
+        while state.generation == generation && !state.crashed {
+            remaining = match self
+                .changed
+                .wait_interruptible_timeout(&mut state, remaining)
+            {
+                CondVarTimeoutResult::Woken { jiffies }
+                | CondVarTimeoutResult::Signal { jiffies } => jiffies,
+                CondVarTimeoutResult::Timeout => {
+                    if state.generation == generation && !state.crashed {
+                        return Err(ETIMEDOUT);
+                    }
+                    break;
+                }
+            };
+        }
+        if state.crashed {
+            return Err(EIO);
+        }
+        Ok(())
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_platform.rs b/drivers/gpu/drm/asahi/g16_platform.rs
new file mode 100644
index 0000000000000..c7f4ee9ace955
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_platform.rs
@@ -0,0 +1,415 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+
+//! Live platform inputs and initialization builders from g16g_platform.py and
+//! g16g_initdata.py. Firmware data is built from explicit bootloader properties.
+
+use crate::util::{put32, put64};
+
+use kernel::{c_str, device, of, prelude::*};
+
+const PAGE: u64 = 0x4000;
+const REGISTER_BASE: u64 = 0xffff_fc21_8020_0000;
+const REGISTER_LIMIT: u64 = 0xffff_fc21_8100_0000;
+const MCC_BASE: u64 = 0x2201c4000;
+const MCC_SIZE: u32 = 0x18000;
+const REGION_C_IDLE_ENABLE: usize = 0x30;
+const REGION_C_CLOCK_GATED_OFF_DELAY_MS: usize = 0x9bc;
+
+
+
+pub(crate) fn zeroed(size: usize) -> Result<KVec<u8>> {
+    let mut out = KVec::new();
+    out.extend_with(size, 0, GFP_KERNEL)?;
+    Ok(out)
+}
+
+/// The boot boundary preserves original ADT bytes, including float bit patterns.
+pub(crate) fn adt_word(node: &of::Node, name: &CStr, default: Option<u32>) -> Result<u32> {
+    let bytes: Option<KVec<u8>> = node.get_opt_property(name)?;
+    match bytes {
+        Some(bytes) => Ok(u32::from_le_bytes(
+            bytes.as_slice().try_into().map_err(|_| EINVAL)?,
+        )),
+        None => default.ok_or(ENOENT),
+    }
+}
+
+/// Most performance states the firmware tables have room for (0x40-byte rows).
+const MAX_STATES: usize = 16;
+
+/// A per-state ladder from the loader. Index 0 is the off state; every ladder
+/// of a platform has the same length (validated in `Platform::new`).
+fn ladder(node: &of::Node, name: &CStr) -> Result<KVec<u32>> {
+    let values: KVec<u32> = node.get_property(name)?;
+    if values.len() < 2 || values.len() > MAX_STATES {
+        return Err(EINVAL);
+    }
+    Ok(values)
+}
+
+pub(crate) struct Register {
+    pub(crate) slot: usize,
+    pub(crate) physical: u64,
+    pub(crate) address: u64,
+    pub(crate) size: u32,
+    pub(crate) stride: u32,
+    pub(crate) relative: u64,
+    pub(crate) flags: u32,
+}
+
+pub(crate) struct Platform {
+    pub(crate) node: of::Node,
+    pub(crate) freq_a: KVec<u32>,
+    pub(crate) freq_b: KVec<u32>,
+    core_voltage: KVec<u32>,
+    memory_voltage: KVec<u32>,
+    index_a: KVec<u32>,
+    index_b: KVec<u32>,
+    relative_a: KVec<u32>,
+    relative_b: KVec<u32>,
+    pub(crate) maximum_power: u32,
+    pub(crate) core_mask: u32,
+    revision: u32,
+    pub(crate) period_ms: u32,
+    pub(crate) period_clocks: u32,
+    pub(crate) registers: KVec<Register>,
+    pub(crate) mcc: KVec<u64>,
+    gpc: bool,
+}
+
+impl Platform {
+    pub(crate) fn new(dev: &device::Device) -> Result<Self> {
+        let node = dev.of_node().ok_or(ENODEV)?;
+        // Only the maximum is consumed by the firmware builders. A loader
+        // with an observed board maximum need not invent an entire power
+        // ladder. Continue accepting the original loader's modeled ladder.
+        let maximum_power = match node.get_opt_property::<u32>(c_str!("apple,m4-max-power-mw"))? {
+            Some(value) => value,
+            None => {
+                let power = ladder(&node, c_str!("apple,m4-power-mw"))?;
+                if power[0] != 0 || power.windows(2).any(|w| w[0] > w[1]) {
+                    return Err(EINVAL);
+                }
+                power[power.len() - 1]
+            }
+        };
+        let freq_a = ladder(&node, c_str!("apple,m4-freq-a"))?;
+        let freq_b = ladder(&node, c_str!("apple,m4-freq-b"))?;
+        if maximum_power == 0
+            || maximum_power > i32::MAX as u32
+            || freq_a[0] != 0
+            || freq_a.windows(2).any(|w| w[0] >= w[1])
+            || freq_b[0] != 0
+            || freq_b.windows(2).any(|w| w[0] >= w[1])
+        {
+            return Err(EINVAL);
+        }
+        let period_clocks = match adt_word(
+            &node,
+            c_str!("apple,sgx-gpu-pwr-sample-period-aic-clks"),
+            None,
+        ) {
+            Ok(value) => value,
+            Err(ENOENT) => adt_word(&node, c_str!("apple,sgx-gpu-power-sample-period"), None)?
+                .checked_mul(24000)
+                .ok_or(EINVAL)?,
+            Err(error) => return Err(error),
+        };
+        let period_ms = period_clocks / 24000;
+        if period_ms == 0 {
+            return Err(EINVAL);
+        }
+        let core_mask: u32 = node.get_property(c_str!("apple,m4-core-mask"))?;
+        if core_mask == 0 || core_mask & !0x3ff != 0 {
+            return Err(EINVAL);
+        }
+        let mut this = Self {
+            core_voltage: ladder(&node, c_str!("apple,m4-core-voltage"))?,
+            memory_voltage: ladder(&node, c_str!("apple,m4-memory-voltage"))?,
+            index_a: ladder(&node, c_str!("apple,m4-index-a"))?,
+            index_b: ladder(&node, c_str!("apple,m4-index-b"))?,
+            relative_a: ladder(&node, c_str!("apple,m4-relative-a"))?,
+            relative_b: ladder(&node, c_str!("apple,m4-relative-b"))?,
+            revision: node.get_property(c_str!("apple,chip-revision"))?,
+            gpc: adt_word(&node, c_str!("apple,sgx-no-gpc"), Some(0))? == 0,
+            node,
+            freq_a,
+            freq_b,
+            maximum_power,
+            core_mask,
+            period_ms,
+            period_clocks,
+            registers: KVec::new(),
+            mcc: KVec::new(),
+        };
+        let states = this.freq_a.len();
+        if [
+            &this.freq_b,
+            &this.core_voltage,
+            &this.memory_voltage,
+            &this.index_a,
+            &this.index_b,
+            &this.relative_a,
+            &this.relative_b,
+        ]
+        .iter()
+        .any(|ladder| ladder.len() != states)
+        {
+            return Err(EINVAL);
+        }
+        this.build_registers()?;
+        Ok(this)
+    }
+
+    fn build_registers(&mut self) -> Result {
+        let reg: KVec<u32> = self.node.get_property(c_str!("reg"))?;
+        if reg.len() != 8 {
+            return Err(EINVAL);
+        }
+        let base = (u64::from(reg[4]) << 32) | u64::from(reg[5]);
+        let span = (u64::from(reg[6]) << 32) | u64::from(reg[7]);
+        let irq: KVec<u8> = self
+            .node
+            .get_property(c_str!("apple,sgx-meta-sw-interrupt"))?;
+        if irq.len() != 20 && irq.len() != 40 {
+            return Err(EINVAL);
+        }
+        let irq_address = u64::from_le_bytes(
+            irq[irq.len() - 20..irq.len() - 12]
+                .try_into()
+                .map_err(|_| EINVAL)?,
+        );
+        if irq_address < PAGE || irq_address >= 1 << 48 {
+            return Err(EINVAL);
+        }
+        let mask = adt_word(
+            &self.node,
+            c_str!("apple,sgx-active-mcc-bit-vector"),
+            Some(3),
+        )?;
+        if mask == 0 {
+            return Err(EINVAL);
+        }
+        for bit in 0..32 {
+            if mask & (1 << bit) != 0 {
+                self.mcc.push(MCC_BASE + (bit << 25), GFP_KERNEL)?;
+            }
+        }
+        self.registers.push(
+            Register {
+                slot: 0,
+                physical: irq_address & !(PAGE - 1),
+                address: 0,
+                size: PAGE as u32,
+                stride: PAGE as u32,
+                relative: 0,
+                flags: 2,
+            },
+            GFP_KERNEL,
+        )?;
+        self.registers.push(
+            Register {
+                slot: 3,
+                physical: self.mcc[0],
+                address: 0,
+                size: self.mcc.len() as u32 * MCC_SIZE,
+                stride: MCC_SIZE,
+                relative: 0,
+                flags: 2,
+            },
+            GFP_KERNEL,
+        )?;
+        // Native HAL declarations and the three platform-specific windows.
+        for (slot, offset, size, relative, flags) in [
+            (17, 0, 0x20000, true, 2),
+            (26, 0xd04000, 0x8000, true, 2),
+            (27, 0xd0d000, 0x1000, true, 2),
+            (28, 0xd58000, 0x8000, true, 2),
+            (29, 0xd10000, 0x4000, true, 2),
+            (31, 0xd40000, 0x4000, true, 2),
+            (32, 0xd60000, 0x8000, true, 2),
+            // The GPU-side thermal sensor (MTR) block: the firmware looks it
+            // up when an MTR alarm arrives, which happens once PMP arms the
+            // mtr_top_agx alarm.
+            (36, 0xe00000, 0x4000, true, 0),
+            (40, 0xe1c000, 0x4000, true, 2),
+            (22, 0x1000000, 0x8000, false, 2),
+            (39, 0xe08000, 0x8000, false, 2),
+            (41, 0xe1f800, 0x4000, false, 2),
+        ] {
+            if offset + u64::from(size) > span {
+                return Err(EINVAL);
+            }
+            self.registers.push(
+                Register {
+                    slot,
+                    physical: base.checked_add(offset).ok_or(EINVAL)?,
+                    address: 0,
+                    size,
+                    stride: size,
+                    relative: if relative { offset } else { 0 },
+                    flags,
+                },
+                GFP_KERNEL,
+            )?;
+        }
+        for (slot, physical, size, flags) in [
+            (9, 0x3803d0000, 0x1000, 2),
+            (10, 0x3803c0000, 0x2000, 0),
+            (12, 0x50165c000, 0x4000, 2),
+            (14, 0x380280000, 0x8000, 0),
+            (15, 0x38c840000, 0x24000, 0),
+        ] {
+            self.registers.push(
+                Register {
+                    slot,
+                    physical,
+                    address: 0,
+                    size,
+                    stride: size,
+                    relative: 0,
+                    flags,
+                },
+                GFP_KERNEL,
+            )?;
+        }
+        self.registers.sort_unstable_by_key(|r| r.slot);
+        let mut cursor = REGISTER_BASE;
+        for r in &mut self.registers {
+            let offset = r.physical & (PAGE - 1);
+            r.address = cursor + offset;
+            cursor += (offset + u64::from(r.size) + PAGE - 1) & !(PAGE - 1);
+            cursor += PAGE;
+            if cursor > REGISTER_LIMIT {
+                return Err(ENOSPC);
+            }
+        }
+        Ok(())
+    }
+
+    pub(crate) fn hwdata(&self) -> Result<KVec<u8>> {
+        let mut out = zeroed(0x3db4)?;
+        for r in &self.registers {
+            let off = 0x640 + r.slot * 0x28;
+            put64(&mut out, off, r.physical);
+            put64(&mut out, off + 8, r.address);
+            put32(&mut out, off + 0x10, r.size);
+            put32(&mut out, off + 0x14, r.stride);
+            put64(&mut out, off + 0x18, r.relative);
+            put32(&mut out, off + 0x20, r.flags);
+        }
+        for (base, repeats, frequencies) in [(0xfc8, 16, &self.freq_a), (0x1cdc, 1, &self.freq_b)] {
+            for state in 0..frequencies.len() {
+                put32(&mut out, base + state * 4, frequencies[state]);
+                for word in 0..repeats {
+                    put32(
+                        &mut out,
+                        base + 0x40 + state * 0x40 + word * 4,
+                        self.core_voltage[state],
+                    );
+                    put32(
+                        &mut out,
+                        base + 0x440 + state * 0x40 + word * 4,
+                        self.memory_voltage[state],
+                    );
+                }
+            }
+        }
+        for (off, values) in [
+            (0x1808, &self.freq_b),
+            (0x18c8, &self.relative_a),
+            (0x1908, &self.relative_b),
+            (0x19c8, &self.index_a),
+            (0x1a08, &self.index_b),
+        ] {
+            for (i, value) in values.iter().enumerate() {
+                put32(&mut out, off + i * 4, *value);
+            }
+        }
+        for i in 0..self.states() {
+            put32(&mut out, 0x1848 + i * 4, 1.02f32.to_bits());
+        }
+        for (off, value) in [
+            (0xe90, 0x8132),
+            (0xe94, self.revision >> 4),
+            (0xe98, self.revision & 7),
+            (0xea0, u32::from(self.gpc)),
+            (0xeb8, 1),
+            (0xec8, 1),
+            (0xed0, 24000),
+            (0xed8, self.period_ms),
+            (0xee0, 1),
+            (0xee4, 1),
+            (0xee8, 1),
+            (0xfc4, self.max_pstate()),
+            (0x1cd8, self.max_pstate()),
+            (0x2604, 1),
+        ] {
+            put32(&mut out, off, value);
+        }
+        out[0x258e..0x2590].copy_from_slice(&22u16.to_le_bytes());
+        for group in 0..2 {
+            for word in 1..4 {
+                put32(&mut out, 0x2590 + group * 16 + word * 4, 1);
+            }
+        }
+        for word in 0..12 {
+            put32(&mut out, 0x25b4 + word * 4, u32::MAX);
+        }
+        Ok(out)
+    }
+
+    pub(crate) fn region_c(&self) -> Result<KVec<u8>> {
+        let mut out = zeroed(PAGE as usize)?;
+        // Let firmware request automatic idle transitions. With this word
+        // zero, T8132 keeps PMGR GFX ACTUAL at 15 even with no queued work.
+        // Setting it to one permits idle state 0 and wake on new submissions.
+        put32(&mut out, REGION_C_IDLE_ENABLE, 1);
+        // Keep GFX clock-gated briefly before powering it off. On T8132,
+        // 40 permits ACTUAL 4 between frames and state 0 after quiet time.
+        put32(&mut out, REGION_C_CLOCK_GATED_OFF_DELAY_MS, 40);
+        for (off, value) in [
+            (0x78, 1),
+            (0x7ec, 1),
+            (0x7f0, 1),
+            (0xe28, crate::module_parameters::fault_control.value()),
+            (0xe2c, 1),
+            (0x24, 4096),
+            (0x998, 32),
+            (0x99c, 8),
+            (0x9a0, 256),
+            (0x9a4, 1),
+            (0x9c8, 64),
+            (0x9cc, 64),
+            (0x9d0, 2),
+            (0x84, self.maximum_power),
+            (0x88, 1000),
+            (0x8c, 1000),
+            (0x98, 1000),
+        ] {
+            put32(&mut out, off, value);
+        }
+        for (off, value) in [(0x54, u16::MAX), (0x56, 40), (0x58, u16::MAX)] {
+            out[off..off + 2].copy_from_slice(&value.to_le_bytes());
+        }
+        Ok(out)
+    }
+}
+
+impl Platform {
+    /// Number of performance states, including the off state at index 0.
+    pub(crate) fn states(&self) -> usize {
+        self.freq_a.len()
+    }
+
+    /// Index of the top performance state.
+    pub(crate) fn max_pstate(&self) -> u32 {
+        (self.states() - 1) as u32
+    }
+
+    /// Frequency of the top performance state in MHz.
+    pub(crate) fn max_frequency(&self) -> u32 {
+        self.freq_a[self.states() - 1]
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_power.rs b/drivers/gpu/drm/asahi/g16_power.rs
new file mode 100644
index 0000000000000..61de1dee30f65
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_power.rs
@@ -0,0 +1,400 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+
+//! Power configuration from g16g_platform.py and g16g_initdata.py.
+//! ADT values are original platform inputs; every firmware field is built here.
+
+use crate::{
+    f32,
+    float::F32,
+    g16_platform::{adt_word, zeroed, Platform},
+};
+use crate::util::{put32, put64};
+
+use kernel::{c_str, prelude::*};
+
+fn putf(out: &mut [u8], offset: usize, value: F32) -> Result {
+    if value.to_bits() & 0x7f80_0000 == 0x7f80_0000 {
+        return Err(EINVAL);
+    }
+    put32(out, offset, value.to_bits());
+    Ok(())
+}
+
+fn coefficients(count: u32) -> Result<(F32, F32)> {
+    if count == 0 {
+        return Err(EINVAL);
+    }
+    let count = F32::from(count);
+    Ok(((count - f32!(1.0)) / count, f32!(1.0) / count))
+}
+
+struct Filter {
+    alpha: F32,
+    inverse: F32,
+    count_x4: u32,
+    duration: u32,
+    clocks: u64,
+}
+
+fn filter(count: u32, period: u32, request: Option<u32>) -> Result<Filter> {
+    let (alpha, inverse) = coefficients(count)?;
+    let count_x4 = count.checked_mul(4).ok_or(EINVAL)?;
+    let duration = count.checked_mul(period).ok_or(EINVAL)?;
+    let clocks = u64::from(duration.checked_mul(24000).ok_or(EINVAL)?);
+    if let Some(ms) = request {
+        if period == 0 || ms / period != count {
+            return Err(EINVAL);
+        }
+    }
+    Ok(Filter {
+        alpha,
+        inverse,
+        count_x4,
+        duration: request.unwrap_or(duration),
+        clocks,
+    })
+}
+
+impl Platform {
+    /// Entire source-built bundle, including the firmware's power controllers.
+    pub(crate) fn bundle(&self, entropy: u32) -> Result<KVec<u8>> {
+        let mut out = zeroed(crate::g16_fw::BUNDLE_SIZE)?;
+        let hwdata = self.hwdata()?;
+        out[..hwdata.len()].copy_from_slice(&hwdata);
+        let main = crate::g16_fw::MainConfig::bootstrap(crate::g16_fw::BUNDLE_ADDRESS).encode();
+        out[crate::g16_fw::MAIN_OFFSET..crate::g16_fw::MAIN_OFFSET + main.len()]
+            .copy_from_slice(&main);
+        put64(&mut out, 0x8ed0, 0xffff_fc20_000f_3440 + 0x80);
+        put64(&mut out, 0xb698, 0xffff_fc20_c050_0000);
+        self.power_data(&mut out)?;
+        put32(&mut out, 0xb754, entropy);
+        Ok(out)
+    }
+
+    pub(crate) fn power_data(&self, out: &mut [u8]) -> Result {
+        if out.len() < 0xb758 || self.period_ms == 0 {
+            return Err(EINVAL);
+        }
+        // The property spellings and defaults follow the Python reader exactly.
+        macro_rules! uint {
+            ($name:literal, $default:expr) => {
+                adt_word(
+                    &self.node,
+                    c_str!(concat!("apple,sgx-", $name)),
+                    Some($default),
+                )?
+            };
+        }
+        macro_rules! optional {
+            ($name:literal) => {
+                match adt_word(&self.node, c_str!(concat!("apple,sgx-", $name)), None) {
+                    Ok(value) => Some(value),
+                    Err(ENOENT) => None,
+                    Err(e) => return Err(e),
+                }
+            };
+        }
+        macro_rules! gain {
+            ($name:literal, $default:expr) => {
+                F32::from_bits(uint!($name, f32!($default).to_bits()))
+            };
+        }
+        macro_rules! ints {
+            ($($offset:expr => $value:expr),* $(,)?) => {
+                $(put32(out, $offset, $value);)*
+            };
+        }
+        macro_rules! floats {
+            ($($offset:expr => $value:expr),* $(,)?) => {
+                $(putf(out, $offset, $value)?;)*
+            };
+        }
+        let max_scaled = 100 * self.max_pstate();
+        let maximum = F32::from(self.maximum_power);
+        let duty = uint!("gpu-pwr-min-duty-cycle", 40);
+        let minimum = uint!("gpu-pwr-integral-min-clamp", 0);
+        if duty > max_scaled || minimum > self.maximum_power {
+            return Err(EINVAL);
+        }
+        let minimum = F32::from(minimum);
+        let dt = F32::from(self.period_ms) / f32!(1000.0);
+        let micros = self.period_ms.checked_mul(1000).ok_or(EINVAL)?;
+        // Sixteen rows of signed 16-bit initial power slots.
+        for i in 0..16 * 32 {
+            out[0x6f6f + i * 2..0x6f71 + i * 2].copy_from_slice(&i16::MAX.to_le_bytes());
+        }
+        ints!(0x5384 => self.period_clocks, 0x5388 => self.period_clocks, 0x5d38 => 625);
+        for i in 0..self.states() {
+            put32(out, 0x5440 + i * 4, f32!(1.02).to_bits());
+        }
+        let (alpha, inverse) = coefficients(uint!("gpu-pwr-filter-time-constant", 313))?;
+        floats!(0x5d44 => alpha, 0x5d4c => inverse,
+            0x5d54 => gain!("gpu-pwr-integral-gain", 0.0202129),
+            0x5d5c => minimum, 0x5d60 => maximum,
+            0x5d64 => gain!("gpu-pwr-proportional-gain", 5.2831855),
+            0x5d6c => -F32::from(max_scaled) / maximum);
+        ints!(0x5d70 => duty, 0x5d74 => max_scaled, 0x5d78 => max_scaled, 0x5db8 => max_scaled);
+        for off in [0x5d84, 0x7c48, 0x7c4c, 0x7c50] {
+            put32(out, off, self.maximum_power);
+        }
+        floats!(0x7fb0 => f32!(65536.0), 0x7fb4 => f32!(0.0));
+        ints!(0x7fc0 => duty, 0x7fc4 => max_scaled);
+        floats!(0x7570 => f32!(65536.0), 0x7574 => F32::from(duty), 0x7578 => F32::from(max_scaled),
+            0x7598 => f32!(100.0));
+        ints!(0x757c => self.max_frequency(), 0x7590 => duty, 0x759c => max_scaled, 0x7bf0 => max_scaled);
+        let (alpha, inverse) = coefficients(5)?;
+        floats!(0x75a4 => alpha, 0x75a8 => inverse);
+
+        let ppm_ms = uint!("gpu-ppm-filter-time-constant-ms", 16);
+        let ppm = filter(ppm_ms / self.period_ms, self.period_ms, Some(ppm_ms))?;
+        floats!(0x5dfc => ppm.alpha, 0x5e04 => ppm.inverse,
+            0x5e0c => dt * gain!("gpu-ppm-ki", 150.0),
+            0x5e14 => minimum, 0x5e18 => f32!(65536.0), 0x5e1c => gain!("gpu-ppm-kp", 0.25));
+        ints!(0x5df0 => ppm.count_x4, 0x5e28 => duty, 0x5e2c => max_scaled,
+            0x5e3c => self.maximum_power, 0x5e48 => ppm.duration);
+        put64(out, 0x5e50, ppm.clocks);
+
+        let base = match crate::module_parameters::perf_base.value() {
+            0 => uint!("gpu-perf-base-pstate", 1),
+            forced => forced,
+        };
+        let utilization = uint!("gpu-perf-tgt-utilization", 85);
+        let dead_zone = uint!("gpu-perf-dz", 0);
+        let boost = uint!("gpu-perf-boost-min-util", 95);
+        let integral_minimum = uint!("gpu-perf-integral-min-clamp", 0);
+        if base == 0
+            || base >= self.max_pstate() + 1
+            || utilization > 100
+            || dead_zone > utilization
+            || boost > 100
+            || integral_minimum > 95
+        {
+            return Err(EINVAL);
+        }
+        let base_scaled = 100 * base;
+        let target = utilization - dead_zone;
+        for off in [0x5390, 0x53e0] {
+            put32(out, off, 4);
+            putf(out, off + 4, f32!(1.0))?;
+        }
+        for off in [0x53ac, 0x53b0, 0x53ec, 0x53f0] {
+            put32(out, off, 1);
+        }
+        for off in [0x53d0, 0x5410] {
+            put32(out, off, 100);
+        }
+        for off in [0x53bc, 0x53fc] {
+            for (i, value) in [0, base_scaled, 1, max_scaled].iter().enumerate() {
+                put32(out, off + i * 4, *value);
+            }
+        }
+        let first = coefficients(uint!("gpu-perf-filter-time-constant", 5))?;
+        let second = coefficients(uint!("gpu-perf-filter-time-constant2", 200))?;
+        floats!(0x5ecc => first.0, 0x5ed0 => second.0, 0x5ed4 => first.1, 0x5ed8 => second.1,
+            0x5edc => gain!("gpu-perf-integral-gain", 0.7975),
+            0x5ee0 => gain!("gpu-perf-integral-gain2", 0.7975),
+            0x5ee4 => F32::from(integral_minimum), 0x5ee8 => f32!(95.0),
+            0x5eec => gain!("gpu-perf-proportional-gain", 5.4),
+            0x5ef0 => gain!("gpu-perf-proportional-gain2", 5.4),
+            0x5ef4 => F32::from(max_scaled-base_scaled) / f32!(95.0));
+        ints!(0x5ea8 => target, 0x5eb0 => boost,
+            0x5eb4 => uint!("gpu-perf-boost-ce-step", 50),
+            0x5eb8 => uint!("gpu-perf-reset-iters", 6), 0x5ec0 => 6, 0x5ec4 => 1,
+            0x5ec8 => uint!("gpu-perf-filter-drop-threshold", 0),
+            0x5ef8 => base_scaled, 0x5efc => max_scaled, 0x5f00 => base_scaled,
+            0x5f0c => target, 0x5f14 => dead_zone, 0x5f40 => base_scaled);
+
+        let first = filter(
+            uint!("gpu-se-filter-time-constant", 9),
+            self.period_ms,
+            None,
+        )?;
+        let second = filter(
+            uint!("gpu-se-filter-time-constant-1", 3),
+            self.period_ms,
+            None,
+        )?;
+        floats!(0x7ed8 => first.alpha, 0x7edc => second.alpha,
+            0x7ee0 => first.inverse, 0x7ee4 => second.inverse,
+            0x7ee8 => gain!("gpu-se-ki", -50.0) * dt,
+            0x7eec => gain!("gpu-se-ki-1", -100.0) * dt,
+            0x7ef0 => f32!(0.0), 0x7ef4 => f32!(65536.0),
+            0x7ef8 => gain!("gpu-se-kp", -5.0), 0x7efc => gain!("gpu-se-kp-1", -5.0),
+            0x7f40 => f32!(65536.0), 0x7f14 => F32::from(micros));
+        ints!(0x7f04 => 100, 0x7f08 => max_scaled, 0x7f0c => base_scaled,
+            0x7f24 => first.duration, 0x7f28 => second.duration, 0x7f68 => micros,
+            0x7ecc => 50, 0x7ed0 => 1, 0x7f18 => 1400,
+            0x7f6c => (33+self.period_ms/2)/self.period_ms,
+            0x7f70 => uint!("gpu-se-inactive-threshold", 2500),
+            0x7f74 => uint!("gpu-se-engagement-criteria", 600),
+            0x7f78 => uint!("gpu-se-engagement-tolerance", 2),
+            0x7f7c => uint!("gpu-se-reset-tolerance", 4),
+            0x7f80 => uint!("gpu-se-reset-criteria", 50));
+        put64(out, 0x7f2c, first.clocks);
+        put64(out, 0x7f34, second.clocks);
+
+        let average_target = filter(
+            uint!("gpu-avg-power-target-filter-tc", 1),
+            self.period_ms,
+            None,
+        )?;
+        floats!(0x7c5c => average_target.alpha, 0x7c60 => average_target.inverse);
+        ints!(0x7c64 => average_target.count_x4, 0x7c68 => average_target.duration);
+        put64(out, 0x7c6c, average_target.clocks);
+        let ki_only = optional!("gpu-avg-power-ki-only");
+        let direct_ki = optional!("gpu-avg-power-ki");
+        let mut avg_ki = F32::from_bits(ki_only.or(direct_ki).unwrap_or(f32!(16.875).to_bits()));
+        if ki_only.is_some() || direct_ki.is_none() {
+            avg_ki = avg_ki * dt;
+        }
+        let avg_duty = uint!("gpu-avg-power-min-duty-cycle", 40);
+        if avg_duty > max_scaled {
+            return Err(EINVAL);
+        }
+        floats!(0x7d58 => avg_ki, 0x7d60 => f32!(0.0), 0x7d64 => f32!(65536.0),
+            0x7d68 => gain!("gpu-avg-power-kp", 2.42), 0x7d70 => f32!(0.0), 0x7d84 => maximum);
+        ints!(0x7d74 => avg_duty, 0x7d78 => max_scaled, 0x7d7c => max_scaled,
+            0x7d88 => self.maximum_power, 0x7dbc => max_scaled);
+        let request = optional!("gpu-avg-power-filter-tc-ms");
+        let count = match request {
+            Some(ms) => ms / self.period_ms,
+            None => uint!("gpu-avg-power-input-filter-tc", 248 / self.period_ms),
+        };
+        let average = filter(count, self.period_ms, request)?;
+        ints!(0x7d3c => average.count_x4, 0x7d94 => average.duration);
+        floats!(0x7d48 => average.alpha, 0x7d50 => average.inverse);
+        put64(out, 0x7d9c, average.clocks);
+
+        // Fast-die uses the untruncated AIC interval, unlike the other loops.
+        let fast_dt = F32::from(self.period_clocks) / f32!(24000.0) / f32!(1000.0);
+        let release = uint!("gpu-fast-die0-release-temp", 80);
+        let delta = uint!("gpu-fast-die0-prop-tgt-delta", 0);
+        if release > u32::MAX / 100 || delta > u32::MAX / 100 {
+            return Err(EINVAL);
+        }
+        put64(
+            out,
+            0x75e8,
+            (1 << 3) | (1 << 4) | (1 << 6) | (1 << 8) | (1 << 11) | (1 << 13) | (1 << 14),
+        );
+        ints!(0x75f0 => (F32::from(release)*f32!(100.0)).to_u32_checked().ok_or(EINVAL)?,
+            0x75f8 => 4, 0x7630 => duty, 0x7634 => max_scaled, 0x7638 => max_scaled,
+            0x763c => (F32::from(delta)*f32!(100.0)).to_u32_checked().ok_or(EINVAL)?,
+            0x7644 => 11000, 0x7678 => max_scaled);
+        floats!(0x7604 => f32!(0.0), 0x760c => f32!(1.0),
+            0x7614 => gain!("gpu-fast-die0-integral-gain", 200.0)*fast_dt,
+            0x761c => f32!(0.0), 0x7620 => f32!(65536.0),
+            0x7624 => gain!("gpu-fast-die0-proportional-gain", 120.0), 0x762c => f32!(0.0));
+
+        let turbo_input = optional!("gpu-turbo-controller-input");
+        let mode = turbo_input.unwrap_or(2);
+        let (kp, ki, target, delta, threshold) = if mode == 0 {
+            (f32!(300.0), f32!(1.3), 9600, 300, 0)
+        } else {
+            (
+                f32!(250.0),
+                f32!(1.15),
+                if mode == 1 { 0 } else { 10150 },
+                0,
+                700,
+            )
+        };
+        let (alpha, inverse) = coefficients(200)?;
+        out[0x7898] = u8::from(turbo_input.is_some());
+        out[0x7899] = u8::from(mode == 1);
+        floats!(0x7aaa => alpha, 0x7ab2 => inverse, 0x7aba => ki, 0x7ac2 => f32!(0.0),
+            0x7ac6 => f32!(65536.0), 0x7aca => kp, 0x7ad2 => f32!(-100.0/65536.0),
+            0x7ae6 => f32!(3000.0), 0x7b56 => f32!(64.0), 0x7b5a => f32!(65536.0));
+        ints!(0x7ad6 => 900, 0x7ada => 1000, 0x7ade => 1000, 0x7aea => target,
+            0x7af2 => delta, 0x7b1e => 1000, 0x7b3a => 200, 0x7b52 => threshold);
+
+        let (alpha, inverse) = coefficients(32)?;
+        floats!(0x81b8 => alpha, 0x81c0 => inverse, 0x81c8 => f32!(5.0),
+            0x81d0 => f32!(0.0), 0x81d4 => f32!(65536.0), 0x81d8 => f32!(15.0));
+        ints!(0x81ac => 4, 0x81e4 => max_scaled-100);
+        for off in [0x81e8, 0x81ec, 0x81f8, 0x822c] {
+            put32(out, off, max_scaled);
+        }
+        for (off, key) in [
+            (0xb6a0, *b"g0TR"),
+            (0xb708, *b"g0t0"),
+            (0xb70c, *b"g0t1"),
+            (0xb710, *b"g0EB"),
+            (0xb714, *b"g0EL"),
+        ] {
+            put32(out, off, u32::from_be_bytes(key));
+        }
+        Ok(())
+    }
+}
+
+/// Size of the root's extra_0 policy object (root +0xb8).
+pub(crate) const EXTRA0_SIZE: usize = 0x680;
+
+/// The extra_0 policy object: a compact copy of the power and thermal
+/// controllers' parameters, which the firmware reads when PMP manages the
+/// GPU's power (without it, the fast-die loop runs with zero thresholds and
+/// holds the GPU at its lowest state). Every field is taken from the bundle
+/// built above, so the two always agree.
+pub(crate) fn extra0(bundle: &[u8]) -> Result<[u8; EXTRA0_SIZE]> {
+    let word = |offset: usize| -> Result<u32> {
+        let bytes = bundle.get(offset..offset + 4).ok_or(EINVAL)?;
+        Ok(u32::from_le_bytes(bytes.try_into().map_err(|_| EINVAL)?))
+    };
+    let mut out = [0u8; EXTRA0_SIZE];
+    // Average-power controller: input filter length, Ki*dt, Kp, minimum
+    // duty, enabled.
+    put32(&mut out, 0x010, word(0x7d3c)? / 4);
+    put32(&mut out, 0x014, word(0x7d58)?);
+    put32(&mut out, 0x018, word(0x7d68)?);
+    put32(&mut out, 0x01c, word(0x7d74)?);
+    put32(&mut out, 0x020, 1);
+    // Fast-die thermal controller: limit and release (0.01 C), Kp, Ki*dt.
+    put32(&mut out, 0x0c8, word(0x7644)?);
+    put32(&mut out, 0x0cc, word(0x75f0)?);
+    put32(&mut out, 0x0d8, word(0x7624)?);
+    put32(&mut out, 0x0dc, word(0x7614)?);
+    // Turbo controller: target, filter length, Kp, Ki; the 625 constant.
+    put32(&mut out, 0x0f0, word(0x7aea)?);
+    put32(&mut out, 0x0f4, word(0x7b3a)?);
+    put32(&mut out, 0x108, word(0x7aca)?);
+    put32(&mut out, 0x10c, word(0x7aba)?);
+    put32(&mut out, 0x110, word(0x5d38)?);
+    // Power-performance (PPM) controller: enabled, maximum power (mW), Kp,
+    // and the 1.2 the firmware itself places at bundle +0x5e80.
+    put32(&mut out, 0x128, 1);
+    put32(&mut out, 0x12c, word(0x5e3c)?);
+    put32(&mut out, 0x130, word(0x5e1c)?);
+    put32(&mut out, 0x134, f32!(1.2).to_bits());
+    // The 0x81xx controller: gains, filter length, top and top - 100.
+    put32(&mut out, 0x604, word(0x81d8)?);
+    put32(&mut out, 0x608, word(0x81c8)?);
+    put32(&mut out, 0x60c, 32);
+    put32(&mut out, 0x610, word(0x81e8)?);
+    put32(&mut out, 0x620, word(0x81e4)?);
+    // The fast-die limit and release are thermal limits (0.01 C) the
+    // firmware acts on: refuse anything outside a sane band rather than
+    // hand it a wrong limit. Release must sit below the limit.
+    let (limit, release) = (word(0x7644)?, word(0x75f0)?);
+    if !(5000..=12500).contains(&limit) || !(3000..limit).contains(&release) {
+        return Err(EINVAL);
+    }
+    // The PPM controller's power budget (mW): an M4 GPU's is tens of watts.
+    if !(1..=80_000).contains(&word(0x5e3c)?) {
+        return Err(EINVAL);
+    }
+    Ok(out)
+}
+
+/// The thermal and power limits an extra_0 object carries, for the boot log:
+/// fast-die limit and release (0.01 C) and maximum power (mW).
+pub(crate) fn extra0_limits(extra0: &[u8; EXTRA0_SIZE]) -> (u32, u32, u32) {
+    let word = |offset: usize| u32::from_le_bytes([
+        extra0[offset],
+        extra0[offset + 1],
+        extra0[offset + 2],
+        extra0[offset + 3],
+    ]);
+    (word(0x0c8), word(0x0cc), word(0x12c))
+}
diff --git a/drivers/gpu/drm/asahi/g16_queue.rs b/drivers/gpu/drm/asahi/g16_queue.rs
new file mode 100644
index 0000000000000..849a747e0d975
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_queue.rs
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+// Adapted from Niklas Sheth's linux-m4-integration prototype.
+
+//! G16 queue transport fields, independent of allocation addresses.
+
+use crate::util::{put32 as u32_at, put64 as u64_at};
+
+
+pub(crate) struct Queue {
+    pub(crate) pointers: u64,
+    pub(crate) ring: u64,
+    pub(crate) jobs: u64,
+    pub(crate) private: u64,
+    pub(crate) context: u64,
+    pub(crate) uuid: u32,
+}
+
+impl Queue {
+    pub(crate) fn encode(&self) -> [u8; 0xb0] {
+        let mut out = [0; 0xb0];
+        for (off, value) in [
+            (0, self.pointers),
+            (8, self.ring),
+            (0x10, self.jobs),
+            (0x18, self.private),
+            (0xa4, self.context),
+        ] {
+            u64_at(&mut out, off, value);
+        }
+        // Priority zero's scheduler profile.
+        u64_at(&mut out, 0x38, 0xffff_ffff_ffff_0000);
+        for (off, value) in [
+            (0x2c, u32::MAX),
+            (0x40, 1),
+            (0x48, 1),
+            (0x4c, u32::MAX),
+            (0x50, self.uuid),
+        ] {
+            u32_at(&mut out, off, value);
+        }
+        out
+    }
+}
+
+impl Queue {
+    pub(crate) fn encode_priority(&self, priority: u32) -> Option<[u8; 0xb0]> {
+        let (mask, first, last) = match priority {
+            0 => (0xffff_ffff_ffff_0000, 1, 1),
+            1 => (0xffff_ffff_0000_0000, 0, 0),
+            2 => (0xffff_0000_0000_0000, 0, 2),
+            3 => (0, 0, 3),
+            _ => return None,
+        };
+        let mut out = self.encode();
+        u32_at(&mut out, 0x30, priority);
+        u32_at(&mut out, 0x34, priority);
+        u64_at(&mut out, 0x38, mask);
+        u32_at(&mut out, 0x40, first);
+        u32_at(&mut out, 0x48, last);
+        Some(out)
+    }
+}
+
+pub(crate) fn pointers(capacity: u32, write: u32) -> [u8; 0x60] {
+    let mut out = [0; 0x60];
+    u32_at(&mut out, 0x40, write);
+    u32_at(&mut out, 0x50, capacity);
+    out
+}
+
+pub(crate) fn context() -> [u8; 0x40] {
+    let mut out = [0; 0x40];
+    out[..2].copy_from_slice(&[0xff, 0xff]);
+    out[5] = 1;
+    out[0x26] = 2;
+    out[0x33] = 0xff;
+    out
+}
+
+pub(crate) fn jobs(address: u64) -> [u8; 0x18] {
+    let mut out = [0; 0x18];
+    u64_at(&mut out, 8, address);
+    out
+}
+
+pub(crate) fn barrier(stamp: u64, wait: u32, event: u32, stamp_self: u32, uuid: u32) -> [u8; 0x40] {
+    let mut out = [0; 0x40];
+    u32_at(&mut out, 0, 4);
+    u64_at(&mut out, 4, stamp);
+    for (off, value) in [(0xc, wait), (0x10, event), (0x14, stamp_self), (0x18, uuid)] {
+        u32_at(&mut out, off, value);
+    }
+    out
+}
+
+/// General G16 dependency, before a consumer TA, fragment or CDM Work. Type 1
+/// participates in firmware's dynamic dependency graph; the internal TA-to-fragment prelude
+/// retains type 0 for partial-render scheduling.
+pub(crate) fn dependency(
+    stamp: u64,
+    wait: u32,
+    event: u32,
+    stamp_self: u32,
+    uuid: u32,
+    kind: u32,
+) -> [u8; 0x40] {
+    let mut out = [0; 0x40];
+    u32_at(&mut out, 0, 4);
+    u64_at(&mut out, 4, stamp);
+    u64_at(&mut out, 0xc, stamp);
+    for (off, value) in [
+        (0x14, wait),
+        (0x20, event),
+        (0x24, stamp_self),
+        (0x28, uuid),
+        (0x30, kind),
+    ] {
+        u32_at(&mut out, off, value);
+    }
+    out
+}
+
+pub(crate) fn channel(
+    queue: u64,
+    head: u16,
+    event: u8,
+    kind: u32,
+    first: bool,
+    tag: u64,
+) -> [u8; 0x18] {
+    let mut out = [0; 0x18];
+    u64_at(&mut out, 0, tag);
+    u64_at(&mut out, 8, queue);
+    u32_at(&mut out, 0x10, kind);
+    u32_at(
+        &mut out,
+        0x14,
+        u32::from(head) | (u32::from(event) << 16) | (u32::from(first) << 24),
+    );
+    out
+}
+
+// Bootstrap completion stamp; public workqueues allocate their own storage.
+pub(crate) const STAMP: u64 = 0xffff_fc20_0013_8000;
diff --git a/drivers/gpu/drm/asahi/g16_queue_fail.rs b/drivers/gpu/drm/asahi/g16_queue_fail.rs
new file mode 100644
index 0000000000000..05a36fc50ec0f
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_queue_fail.rs
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright 2026 The Asahi Linux Contributors
+
+//! Failure of a public queue.
+//!
+//! Userspace may split one submission into several jobs whose later parts
+//! rely on queue order, and only the last one carries the application's
+//! fence. Once a command on a queue fails, later jobs on that queue must not
+//! report success over its missing or incomplete output: they complete with
+//! ECANCELED, and the queue refuses new work. Pure list logic, host-tested.
+
+/// A queued job as this logic sees it.
+pub(crate) trait QueueJob {
+    type Error: Copy;
+    /// Whether both jobs were submitted to the same public queue.
+    fn same_queue(&self, other: &Self) -> bool;
+    fn error_mut(&mut self) -> &mut Option<Self::Error>;
+}
+
+/// Gives every job after `jobs[at]` (in submission order) on the same queue
+/// `cancelled`, unless it already failed. Returns how many jobs changed.
+pub(crate) fn cancel_later<J: QueueJob>(jobs: &mut [J], at: usize, cancelled: J::Error) -> usize {
+    if at >= jobs.len() {
+        return 0;
+    }
+    let (head, later) = jobs.split_at_mut(at + 1);
+    let failed = &head[at];
+    let mut changed = 0;
+    for job in later.iter_mut().filter(|job| job.same_queue(failed)) {
+        let error = job.error_mut();
+        if error.is_none() {
+            *error = Some(cancelled);
+            changed += 1;
+        }
+    }
+    changed
+}
diff --git a/drivers/gpu/drm/asahi/g16_render.rs b/drivers/gpu/drm/asahi/g16_render.rs
new file mode 100644
index 0000000000000..73ef251ce7fde
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_render.rs
@@ -0,0 +1,1201 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+// Adapted from Niklas Sheth's linux-m4-integration prototype.
+
+//! T8132 render register ABI. Ordered writes are significant, including duplicates.
+//! Ported from the open m1n1 G16/G17 register model. Addresses and lifecycle
+//! values are supplied by the runtime; geometry is derived from each render.
+
+use crate::util::{put32 as u32_at, put64 as u64_at};
+
+#[derive(Clone, Copy, Default)]
+pub(crate) struct Parameters {
+    pub(crate) mesh: Option<crate::g16_mesh::Profile>,
+    pub(crate) vdm_barrier_fragment: bool,
+    pub(crate) request_tvb_growth: bool,
+    pub(crate) fragment_sync_grow: bool,
+    pub(crate) process_empty_tiles: bool,
+    pub(crate) partial_load_pipeline: u64,
+    pub(crate) partial_load_pipeline_bind: u64,
+    pub(crate) partial_store_pipeline: u64,
+    pub(crate) partial_store_pipeline_bind: u64,
+    pub(crate) sample_size: u64,
+    pub(crate) sampler_array: u64,
+    pub(crate) sampler_count: u64,
+
+    pub(crate) aux_fb: u64,
+    pub(crate) aux_fb_flags: u64,
+    pub(crate) aux_fb_page_count: u64,
+    pub(crate) completion_control: u64,
+    /// Diagnostics: the submitting process, captured at ioctl time.
+    pub(crate) tgid: i32,
+    pub(crate) comm: [u8; 16],
+    pub(crate) context_base: u64,
+    pub(crate) cycle: u64,
+    pub(crate) deflake_1: u64,
+    pub(crate) deflake_2: u64,
+    pub(crate) deflake_3: u64,
+    pub(crate) depth_aux_buffer: u64,
+    pub(crate) depth_aux_stride: u64,
+    pub(crate) depth_bias_array: u64,
+    pub(crate) depth_buffer: u64,
+    pub(crate) depth_clear_value_bits: u64,
+    pub(crate) depth_dimensions: u64,
+    pub(crate) depth_flags: u64,
+    pub(crate) depth_stride: u64,
+    pub(crate) encoder: u64,
+    pub(crate) fragment_admission: u64,
+    pub(crate) fragment_gate: u64,
+    pub(crate) fragment_lifecycle: u64,
+    pub(crate) fragment_status: u64,
+    pub(crate) fragment_work_stamp: u64,
+    pub(crate) heapmeta: u64,
+    pub(crate) height: u64,
+    pub(crate) layermeta: u64,
+    pub(crate) layers: u64,
+    pub(crate) load_pipeline: u64,
+    pub(crate) load_pipeline_bind: u64,
+    pub(crate) merge_upper_x_bits: u64,
+    pub(crate) merge_upper_y_bits: u64,
+    pub(crate) multisample_control: u64,
+    pub(crate) occlusion_query_base: u64,
+    pub(crate) ppp_control: u64,
+    pub(crate) scene_slot: u64,
+    pub(crate) samples: u64,
+    pub(crate) scissor_array: u64,
+    pub(crate) stencil_aux_buffer: u64,
+    pub(crate) stencil_aux_stride: u64,
+    pub(crate) stencil_buffer: u64,
+    pub(crate) stencil_clear_value: u64,
+    pub(crate) stencil_stride: u64,
+    pub(crate) store_pipeline: u64,
+    pub(crate) store_pipeline_bind: u64,
+    pub(crate) ta_status: u64,
+    pub(crate) tib_blocks: u64,
+    pub(crate) tile_config: u64,
+    pub(crate) tilemap: u64,
+    pub(crate) tiling_admission: u64,
+    pub(crate) tiling_gate: u64,
+    pub(crate) tiling_lifecycle: u64,
+    pub(crate) tiling_work_stamp: u64,
+    pub(crate) tpc: u64,
+    pub(crate) utile_config: u64,
+    pub(crate) utile_height: u64,
+    pub(crate) utile_width: u64,
+    pub(crate) width: u64,
+}
+
+struct Geometry {
+    tiles_x: u64,
+    tiles_y: u64,
+    size1: u64,
+    size2: u64,
+    size3: u64,
+    x_blocks: u64,
+    y_blocks: u64,
+    screen: u64,
+    pixels: u64,
+    macro_size: u64,
+}
+
+impl Parameters {
+    pub(crate) fn valid(&self) -> bool {
+        (1..=16384).contains(&self.width)
+            && (1..=16384).contains(&self.height)
+            && (1..=2048).contains(&self.layers)
+            && matches!(
+                (self.utile_width, self.utile_height),
+                (32, 32) | (32, 16) | (16, 16)
+            )
+            && matches!(self.samples, 1 | 2 | 4)
+            && self.tib_blocks <= 128
+            // One scene per lease; register 0x1c910 tracks its cursor slot.
+            && self.scene_slot < 80
+            && (self.sampler_array == 0) == (self.sampler_count == 0)
+            && self.sampler_array & 7 == 0
+            && self.sampler_count < u32::MAX as u64
+            && [
+                self.tilemap,
+                self.heapmeta,
+                self.layer_metadata(),
+                self.tpc,
+                self.deflake_1,
+                self.deflake_2,
+                self.deflake_3,
+                self.encoder,
+            ]
+            .iter()
+            .all(|a| {
+                a.checked_sub(self.context_base)
+                    .is_some_and(|v| v <= u32::MAX as u64)
+            })
+    }
+
+    fn ta_offset(&self, address: u64) -> u64 {
+        address - self.context_base
+    }
+    fn layer_metadata(&self) -> u64 {
+        if self.layermeta == 0 {
+            self.heapmeta
+        } else {
+            self.layermeta
+        }
+    }
+    fn tib_encoding(&self) -> u64 {
+        // T8132's 1..8 RGBA16F attachment sweep covers 128 KiB. The low field
+        // wraps at 64 blocks; multisample renders double their bank tag above
+        // 64 KiB, and again above 128 KiB, which 128-byte samples reach in
+        // unchanged 32x16 four-sample tiles. Bit 6 is not an allocation bit.
+        let blocks = self.tib_blocks & 0x3f;
+        if self.samples == 1 {
+            blocks
+        } else {
+            let banks = if self.tib_blocks > 64 {
+                4
+            } else if self.tib_blocks > 32 {
+                2
+            } else {
+                1
+            };
+            ((self.samples * banks) << 16) | blocks
+        }
+    }
+    fn geometry(&self) -> Geometry {
+        let tx = self.width.div_ceil(32);
+        let ty = self.height.div_ceil(32);
+        let mx = (tx.div_ceil(4) + 3) & !3;
+        let my = (ty.div_ceil(4) + 3) & !3;
+        let ux = 32 / self.utile_width;
+        let uy = 32 / self.utile_height;
+        Geometry {
+            tiles_x: tx,
+            tiles_y: ty,
+            size1: (5 * mx * my * ux * uy).div_ceil(4),
+            size2: mx * my,
+            size3: 2 * mx * my * ux * uy,
+            x_blocks: 3 * mx | ((2 * mx) << 9) | (mx << 18),
+            y_blocks: 3 * my | ((2 * my) << 9) | (my << 18),
+            screen: ((ty - 1) << 12) | (tx - 1),
+            pixels: (self.width - 1) | ((self.height - 1) << 16),
+            macro_size: my * uy | ((mx * ux) << 16),
+        }
+    }
+
+    pub(crate) fn tiling_registers(&self) -> Option<[(u32, u64); 71]> {
+        if !self.valid() {
+            return None;
+        }
+        let g = self.geometry();
+        let tilemap = self.ta_offset(self.tilemap);
+        let heapmeta = self.ta_offset(self.heapmeta);
+        let layermeta = self.ta_offset(self.layer_metadata());
+        let target_layers = if self.layers > 1 {
+            0xe000 | (self.layers - 1)
+        } else {
+            0x8000
+        };
+        let deflake_1 = self.ta_offset(self.deflake_1);
+        let record_index = 0x80001 + self.scene_slot * 4;
+        let mut registers = [
+            (0x01748, 1),
+            (0x10141, 512),
+            (0x1c039, tilemap),
+            (0x1c9c8, tilemap),
+            (0x1c0a1, self.ta_offset(self.tpc)),
+            (0x1c031, heapmeta | 0x8000000000000000),
+            (0x1c9c0, heapmeta | 0x8000000000000000),
+            (0x1c051, 0x3a0012006b0003),
+            (0x1c061, 1),
+            (0x10149, self.utile_config),
+            (0x10139, self.multisample_control),
+            (0x10111, deflake_1),
+            (0x1c9b0, deflake_1),
+            (0x10119, self.ta_offset(self.deflake_2)),
+            (0x1c9b8, self.ta_offset(self.deflake_2)),
+            (0x1c958, 1),
+            (0x1c950, self.ta_offset(self.deflake_3) | 0x4000000000000),
+            (0x1c930, 0),
+            (0x1c880, self.ta_offset(self.encoder)),
+            (0x1c079, layermeta),
+            (0x1c9d8, layermeta),
+            (0x10151, 0),
+            (0x1c199, 0),
+            (0x1c1a1, 0),
+            (0x1c1a9, 0),
+            (0x1c1b1, 0),
+            (0x1c1b9, 0),
+            (0x1c8f8, 0x8860),
+            (0x1c0b1, g.size1),
+            (0x1c850, g.size1),
+            (0x10131, 0x88),
+            (0x10121, self.ppp_control),
+            (0x10129, g.pixels),
+            (0x101b9, g.screen),
+            (0x1c069, g.x_blocks),
+            (0x1c071, g.y_blocks),
+            (0x1c081, g.size2),
+            (0x1c0a9, g.size3),
+            (0x10171, 256),
+            (0x10169, target_layers),
+            (0x0a309, 0),
+            (0x1c8e0, 0xffffffffffffffff),
+            (0x1c8e8, 0xffffffffffffffff),
+            (0x1c898, 0),
+            (0x101e1, 28),
+            (0x1c9e8, target_layers & 0x4fff),
+            (0x1a099, 0),
+            (0x1a0a1, 0),
+            (0x1a069, 0),
+            (0x1a071, 0),
+            (0x1a0c9, 0),
+            (0x1a0d1, 0),
+            (0x101c9, 0),
+            (0x0d471, 0),
+            (0x1a0f1, 8),
+            (0x10799, 0xff0000),
+            (0x1c830, self.tiling_admission),
+            (0x1ca30, self.cycle),
+            (0x16c39, self.cycle),
+            (0x1c910, record_index),
+            (0x0a5a1, if self.mesh.is_some() { crate::g16_mesh::Profile::GATE } else { self.tiling_gate }),
+            (0x0d419, 0x200000001),
+            (0x1ca10, self.tiling_lifecycle),
+            (0x014a1, self.tiling_lifecycle),
+            (0x0a349, self.tiling_lifecycle),
+            (0x10209, self.tiling_work_stamp),
+            (0x1c9f0, self.tiling_work_stamp),
+            (0x14320, self.tiling_work_stamp),
+            (0x14308, self.completion_control),
+            (0x14318, self.ta_status | 1),
+            (0x01740, 1),
+        ];
+        if let Some(mesh) = self.mesh {
+            // The extended TA list inserts the payload entry after 0x10799
+            // and omits the duplicate stamp at 0x10209. Order is significant.
+            registers.copy_within(56..65, 57);
+            registers[56] = (0x1ca48, mesh.payload_register()?);
+        }
+        Some(registers)
+    }
+
+    pub(crate) fn fragment_registers(&self) -> Option<[(u32, u64); 87]> {
+        if !self.valid() {
+            return None;
+        }
+        let g = self.geometry();
+        let tile_state = 0x3717f
+            | ((g.tiles_x - 1) << 44)
+            | ((g.tiles_y - 1) << 53)
+            | 0x2000000000
+            | if self.layers > 1 { 0x100000000 } else { 0 }
+            | ((self.utile_config & 0xf000) << 28);
+        Some([
+            (0x01739, 1),
+            (0x10009, self.utile_config),
+            (0x15379, self.store_pipeline_bind),
+            (0x15381, self.store_pipeline),
+            (0x15369, self.load_pipeline_bind),
+            (0x15371, self.load_pipeline),
+            (0x15131, self.merge_upper_x_bits),
+            (0x15139, self.merge_upper_y_bits),
+            (0x100a1, 0),
+            (0x15069, 0),
+            (0x15071, 0),
+            (0x16058, 0),
+            (0x10019, self.multisample_control),
+            (0x100b1, g.macro_size),
+            (0x16030, g.macro_size),
+            (0x100d9, g.screen),
+            (0x0a301, 0),
+            (0x10791, 0xff0200),
+            (0x16098, self.heapmeta),
+            (0x15109, self.scissor_array),
+            (0x15101, self.depth_bias_array),
+            (0x15021, self.aux_fb_flags),
+            (0x15211, self.height << 32 | self.width),
+            (0x15049, self.aux_fb_page_count),
+            (0x10051, self.tib_encoding()),
+            (0x15321, self.depth_dimensions),
+            (0x15301, self.depth_clear_value_bits),
+            (0x15309, self.stencil_clear_value | 0x300),
+            (0x15311, self.occlusion_query_base),
+            (0x15319, self.depth_flags),
+            (0x15349, 0x4040404),
+            (0x15351, 0),
+            (0x15329, self.depth_buffer),
+            (0x15331, self.depth_buffer),
+            (0x15339, self.stencil_buffer),
+            (0x15341, self.stencil_buffer),
+            (0x15231, 0),
+            (0x15221, 0),
+            (0x15239, 0),
+            (0x15229, 0),
+            (0x15401, self.depth_stride),
+            (0x15421, self.depth_stride),
+            (0x15409, self.stencil_stride),
+            (0x15429, self.stencil_stride),
+            (0x153c1, self.depth_aux_buffer),
+            (0x15411, self.depth_aux_stride),
+            (0x153c9, self.depth_aux_buffer),
+            (0x15431, self.depth_aux_stride),
+            (0x153d1, self.stencil_aux_buffer),
+            (0x15419, self.stencil_aux_stride),
+            (0x153d9, self.stencil_aux_buffer),
+            (0x15439, self.stencil_aux_stride),
+            (0x16429, self.tilemap),
+            (0x16060, self.layer_metadata()),
+            (0x16431, 4 * g.size1 << 24),
+            (0x10039, self.tile_config),
+            (0x16020, 0),
+            (0x16451, 0),
+            (0x15359, 0),
+            (0x100b8, 0x8860),
+            (0x16461, self.aux_fb),
+            (0x16090, self.aux_fb),
+            (0x101e9, 28),
+            (0x160a8, 0),
+            (0x16068, tile_state),
+            (0x1a0a9, 0),
+            (0x1a0b1, 0),
+            (0x1a079, 0),
+            (0x1a081, 0),
+            (0x1a0d9, 0),
+            (0x1a0e1, 0),
+            (0x101c1, 0),
+            (0x0d469, 0),
+            (0x1a0f9, 8),
+            (0x0a5a9, self.fragment_gate),
+            (0x0d429, 0x200000001),
+            (0x160e0, self.fragment_lifecycle),
+            (0x01499, self.fragment_lifecycle),
+            (0x0a341, self.fragment_lifecycle),
+            (0x1c838, self.fragment_admission),
+            (0x1ca28, self.cycle),
+            (0x10211, self.fragment_work_stamp),
+            (0x10420, self.fragment_work_stamp),
+            (0x14048, self.completion_control),
+            (0x14080, self.fragment_status | 1),
+            (0x01731, 1),
+            (0x01731, 1),
+        ])
+    }
+}
+
+pub(crate) fn pack_registers(records: &[(u32, u64)]) -> Option<[u8; 0x600]> {
+    if records.len() > 0x600 / 12 {
+        return None;
+    }
+    let mut out = [0; 0x600];
+    for (slot, (number, value)) in out.chunks_exact_mut(12).zip(records) {
+        slot[..4].copy_from_slice(&number.to_le_bytes());
+        slot[4..].copy_from_slice(&value.to_le_bytes());
+    }
+    Some(out)
+}
