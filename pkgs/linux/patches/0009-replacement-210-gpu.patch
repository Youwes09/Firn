+            let raw = SceneG16C {
+                low_slot: (low_slots + i as u64 * 4).to_le_bytes(),
+                firmware_slot: (firmware_end - 80 * 4 + i as u64 * 4).to_le_bytes(),
+                compact_scene: (GPU_SCENE_BASE - CONTEXT_BASE + (i % 36) as u64 * 0x70)
+                    .to_le_bytes(),
+                control: control.to_le_bytes(),
+                ..Default::default()
+            };
