+cursor = 0
+updated = bytearray(raw)
+while cursor < len(raw):
+    h = uapi.drm_asahi_cmd_header.from_bytes(raw[cursor:cursor + 8])
+    cursor += 8
+    if h.cmd_type == uapi.DRM_ASAHI_CMD_RENDER:
+        updated[cursor:cursor + h.size] = cmd.to_bytes()
+    cursor += h.size
