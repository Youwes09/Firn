+// SPDX-License-Identifier: GPL-2.0-only
+// Native Linux compute->indirect render/PB growth: source-owned inputs, no Apple pages.
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <errno.h>
