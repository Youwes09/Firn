+impl Addresses {
+    pub(crate) fn private_regions(&self) -> [(u64, usize); 9] {
+        [
+            (self.buffer_manager, 0x4000),
+            (self.buffer_manager_block_control, 0x4000),
+            (self.buffer_manager_scene_list, 0x4000),
+            (self.buffer_manager_counter, 0x4000),
+            (self.buffer_thing & !0x3fff, 0x4000),
+            (self.buffer_manager_block_list, 0x10000),
+            (self.buffer_manager_page_list, 0x1c000),
+            (self.event_control & !0x3fff, 0x4000),
+            (self.support, 0x4000),
+        ]
+    }
+
+    pub(crate) fn private_page(&self, address: u64, out: &mut [u8]) -> Option<()> {
+        if out.len() != 0x4000 || address & 0x3fff != 0 {
+            return None;
+        }
+        out.fill(0);
+        if address == self.buffer_manager {
+            for (off, value) in [
+                (0xc, self.buffer_manager_slot as u32),
+                (0x28, 0x258000),
+                (0x2c, 0x10),
+                (0x30, 0x1c000),
+                (0x34, 0x2c),
+                (0x38, 0x19b3),
+                (0x3c, 0xb),
+                (0x54, 0x2b),
+                (0x58, 0x20000),
+                (0x7c, 0x66cc),
+                (0x80, 0x2244),
+                (0x84, 0x248000),
+            ] {
+                u32_at(out, off, value);
+            }
+            for (off, value) in [
+                (0x20, self.buffer_manager_page_list),
+                (0x44, self.buffer_manager_block_list),
+                (0x4c, self.buffer_manager_block_control),
+                (0x64, self.buffer_manager_counter),
+            ] {
+                u64_at(out, off, value);
+            }
+        } else if address == self.buffer_manager_block_control {
+            u32_at(out, 0, 11);
+            u32_at(out, 4, 11);
+            u32_at(out, 0x60, 1);
+        } else if address == self.buffer_manager_counter {
+            u32_at(out, 0, 1);
+        } else if address == self.buffer_manager_block_list {
+            for i in 0..11 {
+                u32_at(out, i * 8, (0x11 + i * 5) as u32);
+            }
+        } else if address == self.buffer_manager_page_list {
+            for i in 0..11 {
+                for j in 0..4 {
+                    u32_at(out, (i * 4 + j) * 4, (0x11 + i * 5 + j) as u32);
+                }
+            }
+        } else if address == self.buffer_thing & !0x3fff {
+            for i in 0..80 {
+                for (off, value) in [
+                    (0, self.pool_slots + i as u64 * 4),
+                    (8, self.buffer_manager_scene_list + i as u64 * 4),
+                    // Match submit_render_pool's scene offset. All 80 leases
+                    // have distinct records within the mapped 16-KiB page;
+                    // wrapping here aliases live scenes and disagrees with
+                    // the TA/3D registers for leases 36..79.
+                    (0x28, 0x240000 + i as u64 * 0x30),
+                    (0x40, self.buffer_manager_block_control + 0x40),
+                    (0x48, 0x100000000),
+                ] {
+                    u64_at(out, i * 0x80 + off, value);
+                }
+            }
+        } else if address == self.event_control & !0x3fff {
+            for i in 0..36 {
+                u64_at(out, i * 0x100, self.event_count_array + i as u64 * 4);
+            }
+            u32_at(out, (self.event_control as usize & 0x3fff) + 0x10, 0x50);
+        }
+        Some(())
+    }
+}
+
+/// Reserved support leases; Work storage is allocated per publication.
+pub(crate) const SUPPORT_BASE: u64 = 0xffff_fc20_c300_0000;
+/// Per-lease render shared state, one uncached page per support lease. As on
+/// macOS it is separate from the firmware-cached support object.
+pub(crate) const SUPPORT_SHARED_BASE: u64 = 0xffff_fc20_0280_0000;
+
+impl Addresses {
+    pub(crate) fn publication(&self, ordinal: u64) -> Self {
+        let mut a = *self;
+        a.tiling_counter = a.tiling_counter.wrapping_add(ordinal.wrapping_mul(2));
+        a.fragment_counter = a.fragment_counter.wrapping_add(ordinal.wrapping_mul(2));
+        a.tiling_stamp = u64::from(crate::g16_stamp::value(ordinal, self.tiling_stamp as u32));
+        a.fragment_stamp = u64::from(crate::g16_stamp::value(ordinal, self.fragment_stamp as u32));
+        a.buffer_thing = (self.buffer_thing & !0x3fff) + ((ordinal % 80 + 1) % 80) * 0x80;
+        a
+    }
+}
+
+impl Addresses {
+    pub(crate) fn tiling_prelude(&self, blocks: u32) -> [u8; 0x40] {
+        let mut out = [0; 0x40];
+        for (off, value) in [
+            (0, 6),
+            (4, self.context_id as u32),
+            (8, self.buffer_manager_slot as u32),
+            (0x10, blocks),
+            (0x1c, self.tiling_stamp as u32),
+        ] {
+            u32_at(&mut out, off, value);
+        }
+        u64_at(&mut out, 0x14, self.buffer_manager);
+        out
+    }
+    pub(crate) fn fragment_prelude(&self) -> [u8; 0x40] {
+        let mut out = [0; 0x40];
+        u32_at(&mut out, 0, 4);
+        u64_at(&mut out, 4, self.tiling_firmware_stamp);
+        u64_at(&mut out, 0xc, self.tiling_firmware_stamp);
+        for (off, value) in [
+            (0x14, self.tiling_stamp),
+            (0x20, self.tiling_event),
+            (0x24, self.fragment_stamp),
+            (0x28, self.fragment_uuid),
+        ] {
+            u32_at(&mut out, off, value as u32);
+        }
+        out
+    }
+}
+
+impl Parameters {
+    /// Bytes of tilemap and TPC storage required by this pass. The 16
+    /// macrotiles each carry their own region and pointer strides.
+    pub(crate) fn scratch_sizes(&self) -> Option<(usize, usize)> {
+        if !self.valid() {
+            return None;
+        }
+        let g = self.geometry();
+        Some((
+            ((g.size1 * 64 * self.layers + 0x3fff) & !0x3fff) as usize,
+            ((g.size3 * 64 * self.layers + 0x3fff) & !0x3fff) as usize,
+        ))
+    }
+}
diff --git a/tools/testing/selftests/drivers/gpu/asahi/deferred-unmap.rs b/tools/testing/selftests/drivers/gpu/asahi/deferred-unmap.rs
new file mode 100644
index 0000000000000..01be83c053e7d
--- /dev/null
+++ b/tools/testing/selftests/drivers/gpu/asahi/deferred-unmap.rs
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Included by test-deferred-unmap.py with the production g16_deferred.rs.
+use core::ops::Range;
+use g16_deferred::{admit, covered, overlap, ready, Overlap, Span, MAX_ENTRIES};
+
+#[derive(Clone)]
+struct M(Range<u64>, u32, bool);
+
+impl Span for M {
+    fn range(&self) -> Range<u64> {
+        self.0.clone()
+    }
+    fn permissions(&self) -> u32 {
+        self.1
+    }
+    fn closing(&self) -> bool {
+        self.2
+    }
+}
+
+const RW: u32 = 3;
+const R: u32 = 1;
+
+fn maps() -> Vec<M> {
+    vec![M(0x4000..0x8000, RW, false), M(0x8000..0x10000, R, false), M(0x20000..0x24000, RW, true)]
+}
+
+#[test]
+fn live_mappings_cover_as_before() {
+    let m = maps();
+    assert!(covered(&m, 0x4000, 0x4000, RW));
+    assert!(covered(&m, 0x4000, 0xc000, R)); // spans two adjacent mappings
+    assert!(!covered(&m, 0x4000, 0xc000, RW)); // second is read-only
+    assert!(!covered(&m, 0x10000, 0x4000, R)); // hole
+    assert!(!covered(&m, 0x4000, 0, R)); // empty
+    assert!(!covered(&m, u64::MAX - 0x10, 0x4000, R)); // overflow
+}
+
+#[test]
+fn closing_mappings_never_cover() {
+    let m = maps();
+    assert!(!covered(&m, 0x20000, 0x4000, R));
+    assert!(!covered(&m, 0x21000, 0x10, R));
+    let mut live = m.clone();
+    live[2].2 = false;
+    assert!(covered(&live, 0x20000, 0x4000, RW));
+}
+
+#[test]
+fn overlap_distinguishes_closed_from_live_mappings() {
+    let m = maps();
+    assert_eq!(overlap(&m, 0x10000, 0x20000), Overlap::None);
+    assert_eq!(overlap(&m, 0x20000, 0x24000), Overlap::Deferred);
+    assert_eq!(overlap(&m, 0x1c000, 0x30000), Overlap::Deferred);
+    assert_eq!(overlap(&m, 0x7000, 0x9000), Overlap::Live);
+    // Any live overlap wins: the caller replaces it with the whole-VM rule.
+    assert_eq!(overlap(&m, 0x4000, 0x30000), Overlap::Live);
+    // Touching ends are not overlaps.
+    assert_eq!(overlap(&m, 0x24000, 0x28000), Overlap::None);
+    assert_eq!(overlap(&m, 0x1c000, 0x20000), Overlap::None);
+}
+
+#[test]
+fn readiness_needs_every_fence() {
+    assert!(ready([]));
+    assert!(ready([true, true]));
+    assert!(!ready([true, false, true]));
+}
+
+#[test]
+fn the_entry_cap_falls_back_to_waiting() {
+    assert!(admit(0));
+    assert!(admit(MAX_ENTRIES - 1));
+    assert!(!admit(MAX_ENTRIES));
+}
diff --git a/tools/testing/selftests/drivers/gpu/asahi/drain-progress.rs b/tools/testing/selftests/drivers/gpu/asahi/drain-progress.rs
new file mode 100644
index 0000000000000..d33bec793378a
--- /dev/null
+++ b/tools/testing/selftests/drivers/gpu/asahi/drain-progress.rs
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Included by test-drain-progress.py with the production g16_drain.rs.
+use g16_drain::{Clock, Stats, Verdict, CAP_MS};
+
+#[test]
+fn all_signaled_is_done_at_once() {
+    assert_eq!(Clock::new(0, 12000, CAP_MS).update(0, 0), Verdict::Done);
+    let mut c = Clock::new(3, 12000, CAP_MS);
+    assert_eq!(c.update(5, 0), Verdict::Done);
+    assert_eq!(c.stats(), Stats { waited_ms: 5, signaled: 3, remaining: 0, idle_ms: 0 });
+}
+
+#[test]
+fn no_progress_fails_exactly_at_the_budget() {
+    let mut c = Clock::new(32, 12000, CAP_MS);
+    assert_eq!(c.update(0, 32), Verdict::Wait(12000));
+    assert_eq!(c.update(11_999, 32), Verdict::Wait(1));
+    assert_eq!(c.update(12_000, 32), Verdict::NoProgress);
+    assert_eq!(c.stats(), Stats { waited_ms: 12_000, signaled: 0, remaining: 32, idle_ms: 12_000 });
+}
+
+#[test]
+fn deep_slow_queue_that_keeps_retiring_completes() {
+    // batch-0330 shape: 32 Works retiring about one per 1.1 s takes ~35 s,
+    // three times the old fixed 12 s budget.
+    let mut c = Clock::new(32, 12000, CAP_MS);
+    let mut now = 0;
+    for remaining in (1..=32).rev() {
+        assert!(matches!(c.update(now, remaining), Verdict::Wait(_)), "at {now} ms");
+        now += 1100;
+    }
+    assert_eq!(c.update(now, 0), Verdict::Done);
+    assert_eq!(c.stats().signaled, 32);
+    assert!(now > 12000);
+}
+
+#[test]
+fn a_stall_after_progress_fails_one_budget_after_the_last_signal() {
+    let mut c = Clock::new(4, 12000, CAP_MS);
+    assert!(matches!(c.update(3000, 3), Verdict::Wait(12000)));
+    assert_eq!(c.update(14_999, 3), Verdict::Wait(1));
+    assert_eq!(c.update(15_000, 3), Verdict::NoProgress);
+    assert_eq!(c.stats(), Stats { waited_ms: 15_000, signaled: 1, remaining: 3, idle_ms: 12_000 });
+}
+
+#[test]
+fn trickling_progress_is_capped() {
+    let budget = 12000;
+    let mut c = Clock::new(usize::MAX, budget, CAP_MS);
+    let mut remaining = usize::MAX;
+    let mut now = 0;
+    loop {
+        remaining -= 1;
+        match c.update(now, remaining) {
+            Verdict::Wait(left) => {
+                assert!(left <= i64::from(budget) && left <= CAP_MS - now && left > 0);
+            }
+            Verdict::Capped => break,
+            other => panic!("{other:?} at {now} ms"),
+        }
+        now += 1000;
+    }
+    assert_eq!(now, CAP_MS);
+}
+
+#[test]
+fn budgets_and_caps_are_independent_and_never_zero() {
+    let mut c = Clock::new(1, 35_000, CAP_MS);
+    assert_eq!(c.update(34_999, 1), Verdict::Wait(1));
+    assert_eq!(c.update(35_000, 1), Verdict::NoProgress);
+    // A cap below the budget ends the drain first, as Capped.
+    let mut c = Clock::new(2, 12_000, 5_000);
+    assert_eq!(c.update(4_000, 1), Verdict::Wait(1_000));
+    assert_eq!(c.update(5_000, 1), Verdict::Capped);
+    // Zero budget or an exhausted shared deadline behave as 1 ms, never
+    // as "wait forever".
+    assert_eq!(Clock::new(1, 0, CAP_MS).update(1, 1), Verdict::NoProgress);
+    assert_eq!(Clock::new(1, 12_000, 0).update(1, 1), Verdict::Capped);
+    assert_eq!(Clock::new(1, 12_000, -50).update(0, 1), Verdict::Wait(1));
+}
+
+#[test]
+fn a_shared_deadline_bounds_several_progressing_drains() {
+    // The exit path drains each VM in turn from one per-file deadline:
+    // VMs that keep retiring cannot add up to more than CAP_MS.
+    let mut used = 0;
+    for _vm in 0..4 {
+        let mut c = Clock::new(usize::MAX, 12_000, CAP_MS - used);
+        let mut remaining = usize::MAX;
+        let mut now = 0;
+        loop {
+            remaining -= 1;
+            match c.update(now, remaining) {
+                // Like drain_within: sleep at most what Wait allows.
+                Verdict::Wait(left) => now += left.min(1000),
+                Verdict::Capped => break,
+                other => panic!("{other:?}"),
+            }
+        }
+        used += now;
+    }
+    assert!(used <= CAP_MS + 4, "{used}");
+}
+
+#[test]
+fn growth_and_clock_regressions_are_not_progress() {
+    let mut c = Clock::new(2, 12000, CAP_MS);
+    assert!(matches!(c.update(1000, 3), Verdict::Wait(11000)));
+    assert_eq!(c.stats().remaining, 2);
+    // A backwards clock reading is ignored.
+    assert!(matches!(c.update(500, 2), Verdict::Wait(11000)));
+    assert_eq!(c.update(12_000, 2), Verdict::NoProgress);
+}
diff --git a/tools/testing/selftests/drivers/gpu/asahi/finished.rs b/tools/testing/selftests/drivers/gpu/asahi/finished.rs
new file mode 100644
index 0000000000000..cf79315e90a72
--- /dev/null
+++ b/tools/testing/selftests/drivers/gpu/asahi/finished.rs
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Included by test-finished.py with the production g16_finished.rs.
+use g16_finished::{collect, Bounded};
+
+/// A fixed-capacity list, as KVec is used in the worker: it never grows.
+#[derive(Default)]
+struct List(Vec<u32>, usize);
+
+impl List {
+    fn with_capacity(n: usize) -> Self {
+        List(Vec::new(), n)
+    }
+}
+
+impl Bounded<u32> for List {
+    fn len(&self) -> usize {
+        self.0.len()
+    }
+    fn capacity(&self) -> usize {
+        self.1
+    }
+    fn get_at(&self, index: usize) -> Option<&u32> {
+        self.0.get(index)
+    }
+    fn remove_at(&mut self, index: usize) -> Option<u32> {
+        (index < self.0.len()).then(|| self.0.remove(index))
+    }
+    fn push_within(&mut self, value: u32) -> Result<(), u32> {
+        if self.0.len() < self.1 { self.0.push(value); Ok(()) } else { Err(value) }
+    }
+    fn insert_within(&mut self, index: usize, value: u32) -> Result<(), u32> {
+        if self.0.len() < self.1 && index <= self.0.len() { self.0.insert(index, value); Ok(()) } else { Err(value) }
+    }
+}
+
+const CREDITS: usize = 128;
+const DONE: u32 = 1 << 31;
+
+/// One worker pass, as Execution::run does it: collect in place, then take the
+/// finished list only when it is non-empty, signal, and always put it back.
+fn pass(jobs: &mut List, finished: &mut List, signalled: &mut Vec<u32>) {
+    collect(jobs, finished, |j| j & DONE != 0);
+    if finished.len() != 0 {
+        let mut taken = core::mem::take(finished);
+        signalled.extend(taken.0.drain(..).map(|j| j & !DONE));
+        *finished = taken;
+    }
+}
+
+#[test]
+fn passes_with_nothing_finished_keep_the_list_capacity() {
+    // The p2 boot panic: a pass that found nothing used to drop the list.
+    let (mut jobs, mut finished, mut signalled) = (List::with_capacity(CREDITS), List::with_capacity(CREDITS), vec![]);
+    jobs.push_within(1).unwrap();
+    pass(&mut jobs, &mut finished, &mut signalled);
+    assert_eq!(finished.capacity(), CREDITS);
+    jobs.0[0] |= DONE;
+    pass(&mut jobs, &mut finished, &mut signalled);
+    assert_eq!((signalled, jobs.len(), finished.capacity()), (vec![1], 0, CREDITS));
+}
+
+#[test]
+fn the_old_handoff_loses_the_capacity_and_collect_fails_closed() {
+    // Replay of the panicking protocol (take every pass, restore only when
+    // something was signalled): the list loses its capacity after one empty pass.
+    let (mut jobs, mut finished) = (List::with_capacity(CREDITS), List::with_capacity(CREDITS));
+    jobs.push_within(7).unwrap();
+    let taken = core::mem::take(&mut finished);
+    assert!(collect(&mut jobs, &mut List(taken.0, taken.1), |j| j & DONE != 0));
+    // Not restored: `finished` is now the zero-capacity default.
+    jobs.0[0] |= DONE;
+    // The new collect does not panic or lose the job: it stays in `jobs`.
+    assert!(!collect(&mut jobs, &mut finished, |j| j & DONE != 0));
+    assert_eq!(jobs.0, vec![7 | DONE]);
+}
+
+#[test]
+fn a_long_random_sequence_never_loses_jobs_or_capacity() {
+    let (mut jobs, mut finished, mut signalled) = (List::with_capacity(CREDITS), List::with_capacity(CREDITS), vec![]);
+    let (mut next, mut x) = (0u32, 0x2545f491u32);
+    for _ in 0..200_000 {
+        x ^= x << 13;
+        x ^= x >> 17;
+        x ^= x << 5;
+        // drm_sched admits a job only with a free credit.
+        if x % 3 == 0 && jobs.len() < CREDITS {
+            jobs.push_within(next).unwrap();
+            next += 1;
+        }
+        // Some jobs finish (in any order), then a pass runs.
+        if !jobs.0.is_empty() && x % 5 < 2 {
+            let i = (x as usize >> 8) % jobs.0.len();
+            jobs.0[i] |= DONE;
+        }
+        pass(&mut jobs, &mut finished, &mut signalled);
+        assert_eq!(finished.capacity(), CREDITS);
+        assert_eq!(finished.len(), 0);
+    }
+    // Every job is signalled exactly once or still pending.
+    let mut seen: Vec<u32> = signalled.iter().copied().chain(jobs.0.iter().map(|j| j & !DONE)).collect();
+    seen.sort_unstable();
+    assert_eq!(seen, (0..next).collect::<Vec<_>>());
+}
+
+#[test]
+fn collect_keeps_order_and_leaves_what_does_not_fit() {
+    let mut jobs = List(vec![1 | DONE, 2, 3 | DONE, 4 | DONE, 5], 8);
+    let mut finished = List::with_capacity(2);
+    assert!(!collect(&mut jobs, &mut finished, |j| j & DONE != 0));
+    assert_eq!(finished.0, vec![1 | DONE, 3 | DONE]);
+    assert_eq!(jobs.0, vec![2, 4 | DONE, 5]);
+}
diff --git a/tools/testing/selftests/drivers/gpu/asahi/native-mesh.rs b/tools/testing/selftests/drivers/gpu/asahi/native-mesh.rs
new file mode 100644
index 0000000000000..85c44c6111096
--- /dev/null
+++ b/tools/testing/selftests/drivers/gpu/asahi/native-mesh.rs
@@ -0,0 +1,851 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Included by test-native-mesh.py, together with the actual production methods.
+use g16_mesh::{DecodeError, Mode, Profile};
+
+fn stream() -> Vec<u32> {
+    // T16 mesh state with the research carrier's scalar object dispatch.
+    vec![
+        0x40000d2c, 0x504, 0x10, 0, 0, 0x01000000, 0x22224, 0x01000000, 0x22220, 1, 0, 0x400810, 0,
+        5, 0x500, 0x4001000, 0x20000013, 0x70000600, 1, 1, 1, 1, 1, 1, 0xc0000000,
+    ]
+}
+fn decode(words: &[u32], base: u64) -> std::result::Result<Option<Profile>, DecodeError> {
+    g16_mesh::decode(base, Mode::MultipleParents, |va| {
+        words.get(((va - base) / 4) as usize).copied()
+    })
+}
+
+#[test]
+fn mode_values_keep_disabled_and_single_parent_behavior_explicit() {
+    for (value, expected) in [
+        (0, Mode::Disabled),
+        (1, Mode::SingleParent),
+        (2, Mode::MultipleParents),
+        (3, Mode::Research),
+        (4, Mode::Qualified),
+    ] {
+        let mode = Mode::from_parameter(value).unwrap();
+        assert_eq!(mode, expected);
+        assert_eq!(mode.enabled(), value != 0);
+    }
+    for value in [5, 6, 255, u32::MAX] {
+        assert_eq!(Mode::from_parameter(value), None);
+    }
+    assert_eq!(
+        g16_mesh::decode(3, Mode::Disabled, |_| {
+            panic!("disabled native mode must not read command memory")
+        }),
+        Ok(None)
+    );
+}
+
+#[test]
+fn native_packets_are_relocatable_and_bounded() {
+    for base in [0x1004000000, 0x10d1233ffc] {
+        // includes a page boundary
+        let mut words = stream();
+        assert_eq!(decode(&words, base), Ok(Some(Profile { payload: 0 })));
+        words[6] = 0x12340;
+        words[8] = 0x80004;
+        words[15] = 0xc010000;
+        assert_eq!(decode(&words, base), Ok(Some(Profile { payload: 0 })));
+        for len in 0..words.len() {
+            assert!(decode(&words[..len], base).is_err(), "truncated at {len}");
+        }
+    }
+    assert_eq!(decode(&stream(), 3), Err(DecodeError::Unsupported));
+    let mut words = stream()[..14].to_vec();
+    words.extend(std::iter::repeat_n(0x20000013, 1100));
+    assert_eq!(decode(&words, 0x1004000000), Err(DecodeError::Unsupported));
+}
+
+#[test]
+fn object_dispatch_accepts_complete_scalar_or_physical_t16_t32_grids() {
+    for base in [0x1004000000, 0x10d1233ffc] {
+        for (mesh, width) in [(16, 1), (16, 16), (16, 32), (32, 1), (32, 16), (32, 32)] {
+            let mut words = stream();
+            words[11] = 0x400800 | mesh;
+            words[21] = width;
+            for groups in [
+                [1, 1, 1],
+                [2, 1, 1],
+                [32, 1, 1],
+                [1, 2, 1],
+                [1, 1, 32],
+                [2, 3, 4],
+                [32, 32, 32],
+                [65535, 1, 1],
+            ] {
+                words[18..21].copy_from_slice(&[groups[0] * width, groups[1], groups[2]]);
+                assert_eq!(decode(&words, base), Ok(Some(Profile { payload: 0 })));
+                let single = g16_mesh::decode(base, Mode::SingleParent, |va| {
+                    words.get(((va - base) / 4) as usize).copied()
+                });
+                assert_eq!(
+                    single,
+                    if groups == [1, 1, 1] {
+                        Ok(Some(Profile { payload: 0 }))
+                    } else {
+                        Err(DecodeError::Unsupported)
+                    }
+                );
+                for len in 0..words.len() {
+                    assert!(decode(&words[..len], base).is_err(), "truncated at {len}");
+                }
+                for index in 18..21 {
+                    let mut bad = words.clone();
+                    bad[index] = 0;
+                    assert_eq!(decode(&bad, base), Err(DecodeError::Unsupported));
+                }
+            }
+            words[18..21].copy_from_slice(&[width, 1, 1]);
+            // Partial workgroups and wider/nonlinear local shapes stay out.
+            if width > 1 {
+                for total in [1, width - 1, width + 1, 32 * width - 1, u32::MAX] {
+                    let mut bad = words.clone();
+                    bad[18] = total;
+                    assert_eq!(decode(&bad, base), Err(DecodeError::Unsupported));
+                }
+            }
+            for dimensions in [
+                [0, 1, 1],
+                [16, 0, 1],
+                [32, 1, 0],
+                [2, 1, 1],
+                [31, 1, 1],
+                [33, 1, 1],
+                [64, 1, 1],
+                [128, 1, 1],
+                [1, 16, 1],
+                [1, 1, 16],
+                [16, 2, 1],
+                [16, 1, 2],
+                [1, 32, 1],
+                [1, 1, 32],
+                [32, 2, 1],
+                [32, 1, 2],
+            ] {
+                let mut bad = words.clone();
+                bad[18..21].copy_from_slice(&dimensions);
+                bad[21..24].copy_from_slice(&dimensions);
+                assert_eq!(decode(&bad, base), Err(DecodeError::Unsupported));
+            }
