+    /// The selected slot is retired and held by the common preparation lease.
+    /// Each span pins its physical allocation while CPU clearing runs off-lock.
+    pub(in super::super) fn render_clearing_seed(&self,memory:&Memory,seed:&super::super::super::g17p_render_runtime::PreparationSeed)
+        ->Result<KVec<super::super::super::g17p_memory::ZeroSpan>> {
+        let storage=seed.wrapped_storage().ok_or(EIO)?;
+        let mut spans=KVec::new();
+        let o=self.owners.iter().find(|o|o.pool==seed.pair() && o.client.is_some()).ok_or(EIO)?;
+        let r=o.render.as_ref().ok_or(EIO)?;let root=&o.client.as_ref().ok_or(EIO)?.root;
+        let (address,size)=seed.wrapped_tilemap_span()?;
+        let (base,capacity)=r.tilemap_span();
+        if address<base || address.checked_add(size).ok_or(EOVERFLOW)?
+            >base.checked_add(capacity).ok_or(EOVERFLOW)? {return Err(EIO);}
+        // The pool and work-slot leases pin all retired backing during this
+        // common off-lock clear. Fresh slots remain zero; wrapped slots lose
+        // only their old tilemap/heap contents, preserving the persistent TPC.
+        let mut offset=0;
+        while offset<size {
+            let at=address+offset;let pa=(root.pte(at&!(PAGE-1))?&ADDRESS)+(at&(PAGE-1));
+            let count=(size-offset).min(PAGE-(at&(PAGE-1)))as usize;
+            spans.push(memory.zero_span(pa,count)?,GFP_KERNEL)?;offset+=count as u64;
+        }
+        if let Some((_,pages))=self.render_work_pages.iter().find(|(slot,_)|*slot==storage) {
+            spans.reserve(pages.len(),GFP_KERNEL)?;
+            for pa in pages {spans.push(memory.zero_span(*pa,PAGE as usize)?,GFP_KERNEL)?;}
+        }
+        // Fresh WorkBackingG16C pages are already zeroed/cleaned off-lock.
+        Ok(spans)
+    }
+    fn render_storage(&mut self, memory: &mut Memory, vm: &mut Vm, storage:u32,backing:&mut Option<WorkBackingG16C>,cleared:bool) -> StageResult<()> {
+        if !cleared {return Err(EIO.into());}
+
+        let base=super::super::super::g17p_render_runtime::wrapped_storage_base(storage)?;
+        let alias = 0x7000000000 + base - work::DESCRIPTOR_BASE_G16C;
+        if !self.render_work_pages.iter().any(|(slot,_)|*slot==storage) {
+            self.render_work_pages.reserve(1,GFP_KERNEL).map_err(StageError::allocation)?;
+            prepare_work_mappings(memory,vm,base,FLAGS,&[0,2]).map_err(StageError::allocation)?;
+            let WorkBackingG16C {memory:staged,pages}=backing.take().ok_or(EIO)?;
+            initial_allocation_checkpoint(6, &mut self.initial_allocation_faulted, &staged)?;
+            memory.absorb(staged).map_err(StageError::allocation)?;
+            install_work_pages(memory, vm, base, FLAGS, &[0, 2], pages)?;
+            self.render_work_pages.push((storage,pages),GFP_KERNEL).expect("reserved render storage");
+        }
+        let pages = self.render_work_pages.iter().find(|(slot,_)|*slot==storage).ok_or(EIO)?.1;
+        for (i, flags) in FLAGS.into_iter().enumerate() {
+            if vm.pte(memory, 2, base + i as u64 * PAGE)? != pages[i] | flags {
+                return Err(EIO.into());
+            }
+        }
+        for i in [0, 2] {
+            if vm.pte(memory, 0, alias + i as u64 * PAGE)? != pages[i] | GPU_READ {
+                return Err(EIO.into());
+            }
+        }
+        Ok(())
+    }
+    fn stage_render(
+        &mut self,
+        session: &mut Session,
+        key: Key,
+        client: &mut Option<compute::Client>,
+        input: &command::Parameters,
+        priority: u32,
+        kernel_start: u64,
+        kernel_end: u64,
+        private:&mut Option<OwnerPrivateG16C>,
+        transport:&mut Option<scheduled_queues::QueueBackingG16C>,
+        work_backing:&mut Option<WorkBackingG16C>,
+        prepared:Option<KBox<super::super::super::g17p_render_runtime::PreparedAppend>>,
+        rebind:Option<&mut super::super::super::g17p_boot::PreparedPoolRebind>,
+    ) -> StageResult<Option<Arc<RenderReceipt>>> {
+        let caller=client.as_ref().or_else(||self.client(key)).ok_or(EIO)?;
+        let Some(pool)=self.render_pool(session,caller,input) else {return Ok(None);};
+        if self.render_needs_private(session,caller,input)
+            && !private.as_ref().is_some_and(|plan|plan.matches(caller,kernel_start,kernel_end)) {return Ok(None);}
+
+        if let Some(caller)=client.as_ref().or_else(||self.client(key)) {
+            for bo in &caller.buffers {session.retain_source_backing(bo)?;}
+        }
+        if !self.rebind_render_owner(session,client,input,rebind)? {return Ok(None);}
+        self.compute_mode=false;
+        self.leave_compute_mode();
+        self.release_requested(session)?;
+        let Some(qi) = self.prepare_queue(session, key, client, kernel_start, kernel_end, priority, pool,private,transport)? else {return Ok(None);};
+        self.queues[qi].generation.leases.prepare().map_err(StageError::allocation)?;
+        let oi = self.queues[qi].owner;
+        // Vertex scratch uses the owned queue operand directory at the VM's
+        // requested origin. Admission protects this pool's GPU/CPU leases;
+        // the render resource constructor owns all 28 backing tranches.
+        if self.owners[oi].directory != kernel_start {
+            return Err(EIO.into());
+        }
+        if self.owners[oi].render.is_none() {
+            // PB identities belong to the render cache, not an idle compute
+            // owner's ASID. Detached resources have completed owned-root and
+            // control retirement; all GPU/CPU leases are quiescent above.
+            if let Some(from) = self
+                .owners
+                .iter()
+                .position(|o| o.pool==pool && o.render.as_ref().is_some_and(|r| r.dormant()
+                    && r.private_end.checked_sub(r.directory)
+                        .and_then(|span| self.owners[oi].private_next.checked_add(span))
+                        .is_some_and(|end| end <= self.owners[oi].private_limit)))
+            {
+                let slot = self.owners[from].render.as_ref().ok_or(EIO)?.parameter.slot;
+                self.owners[oi].render = self.owners[from].render.take();
+                kernel::dev_info!(session.peers[0].data.dev.as_ref(),
+                    "G16C: dormant PB {} transferred context {} -> {} with no retained render root\n",
+                    slot, self.owners[from].context, self.owners[oi].context);
+            }
+        }
+        // The existing common template phase builds unpublished PB backing
+        // off-lock. Retry this node once its owner exists; never allocate a
+        // second bulk resource graph while holding the publication mutex.
+        if self.owners[oi].render.is_none() {return Ok(None);}
+        if !self.owners[oi].render.as_ref().ok_or(EIO)?.attached() {
+            let o = &mut self.owners[oi];
+            let r = o.render.as_mut().ok_or(EIO)?;
+            let span = r.private_end.checked_sub(r.directory).ok_or(EIO)?;
+            if o.private_next.checked_add(span).ok_or(EOVERFLOW)? > o.private_limit {
+                return Err(StageError::Rejected(ENOSPC));
+            }
+            r.rebind(
+                session.memory.as_mut().ok_or(EIO)?,
+                session.vm.as_mut().ok_or(EIO)?,
+                &mut o.client.as_mut().ok_or(EIO)?.root,
+                o.private_next,
+                o.private_limit,
+            )?;
+            o.private_next = r.private_end;
+        }
+        let n = self.render_ordinal;
+        let first_event = super::super::super::g17p_render_lifecycle::pool_grids(pool).map_err(|_|EINVAL)?[0] as u8;
+        if n >= 0x3fffffff {
+            return Err(EOVERFLOW.into());
+        }
+        let mut p = *input;
+        p.context_base = 0x1000000000;
+        p.deflake_1 = 0x1000068da0;
+        p.deflake_2 = 0x1000068120;
+        p.deflake_3 = 0x1000068000;
+        p.ta_status = 0x1000078000;
+        p.fragment_status = 0x1000490000;
+        p.aux_fb = 0x10004d0000;
+        // Owned kind-6 requests are serviced by the common runtime before polling retirement.
+        p.reactive_tvb_growth = true;
+        if crate::module_parameters::g16c_parameter_oom_test.value()==n {
+            // Explicit one-shot qualification matches the source OOM7 gate.
+            p.reactive_tvb_growth=false;
+            p.fragment_sync_grow=Some(true);
+            kernel::dev_info!(session.peers[0].data.dev.as_ref(),"G16C: test-only parameter OOM policy at render ordinal={} TA892=0 FG2100=1\n",n);
+        }
+        p.aux_fb_flags = 0xc000 | (p.aux_fb_flags & (1 << 18));
+        let o = &mut self.owners[oi];
+        let r = o.render.as_mut().ok_or(EIO)?;
+        let root=&mut o.client.as_mut().ok_or(EIO)?.root;
+        if r.geometry_plan(root,geometry_sizes(&p)?)?.is_some() {return Ok(None);}
+        r.refresh_root(root)?;
+        let geo=r.geometry_addresses();
+        p=Self::configured_render(input,n,r.sequence,geo)?;
+        let Some(storage)=session.next_wrapped_render_storage(n) else {return Ok(None);};
+        if !self.render_work_pages.iter().any(|(old,_)|*old==storage) && work_backing.is_none() {return Ok(None);}
+        let (configured,wire)=self.render_seed(qi,storage,input)?;
+        let base=wire.base;
+        let Some(prepared)=prepared.filter(|plan|plan.matches_wrapped(wire,&configured,
+            self.owners[oi].client.as_ref().unwrap())) else {return Ok(None);};
+        let o=&mut self.owners[oi];let r=o.render.as_mut().ok_or(EIO)?;
+        let receipt = RenderReceipt::new(n).map_err(StageError::allocation)?;
+        let addresses = [
+            p.ta_user_timestamp_start,
+            p.ta_user_timestamp_end,
+            p.fragment_user_timestamp_start,
+            p.fragment_user_timestamp_end,
+        ];
+        let completion = Completion {
+            client: o.client.as_ref().ok_or(EIO)?.lease().map_err(StageError::allocation)?,
+            stamps: session
+                .timestamps
+                .as_ref()
+                .ok_or(EIO)?
+                .cache_seed(&addresses).map_err(StageError::allocation)?,
+            fence: receipt.fence.clone(),
+            grid: first_event + 1,
+            error: None,
+        };
+        let mut leases = KVec::new();
+        leases.push(o.client.as_ref().ok_or(EIO)?.lease().map_err(StageError::allocation)?, GFP_KERNEL).map_err(StageError::allocation)?;
+        let slot = r.parameter.slot;
+        let manager = r.manager;
+        let auxiliary = r.auxiliary;
+        let resource_count = (r.sequence_base.checked_add(r.sequence).ok_or(EOVERFLOW)? + 1)
+            .checked_mul(2)
+            .ok_or(EOVERFLOW)?;
+        session.reserve_wrapped_render().map_err(StageError::allocation)?;
+        self.render_storage(
+            session.memory.as_mut().ok_or(EIO)?,
+            session.vm.as_mut().ok_or(EIO)?,storage,work_backing,prepared.wrapped_storage_cleared(),
+        )?;
+        let stamp = wire.local.wrapping_add(1).wrapping_shl(8);
+        let mut drivers = KVec::new();
+        for stage in 0..2 {
+            drivers.push(
+                Stamp {
+                    address: base + 0x18000 + stage * 0x40,
+                    value: stamp,
+                },
+                GFP_KERNEL,
+            ).map_err(StageError::allocation)?;
+        }
+        let mut counters = KVec::new();
+        counters.push(
+            Stamp {
+                address: base + 0x20c,
+                value: 2,
+            },
+            GFP_KERNEL,
+        ).map_err(StageError::allocation)?;
+        let next_local = self.queues[qi].render_count.checked_add(1).ok_or(EOVERFLOW)?;
+        flight_allocation_checkpoint(&mut self.initial_allocation_faulted)?;
+        let memory = session.memory.as_mut().ok_or(EIO)?;
+        let vm = session.vm.as_mut().ok_or(EIO)?;
+        prepared.write_wrapped(memory,vm)?;
+        let mut event = [0u8; 0x28];
+        event[..8].copy_from_slice(&(base + 0x18200).to_le_bytes());
+        event[0x10..0x14].copy_from_slice(&0x50u32.to_le_bytes());
+        vm.write(memory, 2, base + 0x200, &event)?;
+        vm.write(memory, 2, base + 0x18200, &2u32.to_le_bytes())?;
+        vm.write(memory, 2, auxiliary, &resource_count.to_le_bytes())?;
+        let [ta, fr, _] = &mut self.queues[qi].storage.lanes;
+        let prepared = session.prepare_g16c_admission(
+            &mut [
+                Request {
+                    lane: ta,
+                    works: &[base + 0x4000, base + 0x40c0],
+                    event: first_event,
+                    tag: 0,
+                },
+                Request {
+                    lane: fr,
+                    works: &[base + 0xc000, base + 0xc0c0],
+                    event: first_event + 1,
+                    tag: 0,
+                },
+            ],
+            Requirements {
+                firmware: KVec::new(),
+                driver: drivers,
+                notifiers: KVec::new(),
+                drains: KVec::new(),
+                counters,
+            },
+            leases,
+        )?;
+        self.activate(session, oi)?;
+        if !self.render_status {
+            boot::activate_render_status(
+                session.memory.as_mut().ok_or(EIO)?,
+                session.vm.as_ref().ok_or(EIO)?,
+            )?;
+            self.render_status = true;
+        }
+        let o = &mut self.owners[oi];
+        o.render.as_mut().ok_or(EIO)?.admit(
+            session,
+            &o.client.as_ref().ok_or(EIO)?.root,
+            o.context,
+            o.high_root,
+            0,
+        )?;
+        session.configure_g16c_engines(
+            &BindingG16C::render(
+                first_event,
+                self.queues[qi].storage.lanes[0].scratch_low,
+                self.queues[qi].storage.lanes[1].scratch_low,
+            )
+            .ok_or(EINVAL)?, false, true,
+        )?;
+        let [ta, fr, _] = &mut self.queues[qi].storage.lanes;
+        let id = session.publish_g16c_submission(&mut [
+            Request { lane: ta, works: &[base + 0x4000, base + 0x40c0], event: first_event, tag: 0 },
+            Request { lane: fr, works: &[base + 0xc000, base + 0xc0c0], event: first_event + 1, tag: 0 },
+        ], prepared)?;
+        if crate::module_parameters::submission_log.value()!=0 {
+            kernel::dev_info!(session.peers[0].data.dev.as_ref(),
+                "G16C: RENDER_PUBLISHED pool={} context={} root={:#x} grids={},{} milestone={} ordinal={} scratch={:#x},{:#x}\n",
+                pool,self.owners[oi].context,self.owners[oi].client.as_ref().ok_or(EIO)?.root.root(),
+                first_event,first_event+1,wire.milestone+1,n,wire.lanes[0].scratch_high,wire.lanes[1].scratch_high);
+        }
+        self.queues[qi].generation.leases.published(receipt.fence.clone())?;
+        receipt.retained_pool.store(slot,Ordering::Relaxed);
+        for (stored,grid)in receipt.milestones.iter().zip([first_event,first_event+1]) {
+            stored.store((u64::from(grid)<<32)|u64::from(wire.milestone+1),Ordering::Relaxed);
+        }
+        receipt.publication_ready.store(true, Ordering::Release);
+        session.push_wrapped_render(
+            RenderTicket {
+                id,
+                receipt: receipt.clone(),
+                render_owner: oi,storage,
+                growth_tokens: KVec::new(),
+                render_work: parameter_error::RenderOwnerG16C {
+                    context:u32::from(self.owners[oi].context),slot,event:u32::from(first_event)+1,stamp,
+                    descriptor:base+0x9b40,manager,queue:self.queues[qi].storage.lanes[1].queue,
+                    driver_stamps:[base+0x18000,base+0x18040],
+                },
+                parameter_error: None,
+                completion,
+                started: kernel::time::Instant::now(),
+            },
+        )?;
+        self.queues[qi].render_count = next_local;
+        self.owners[oi].render.as_mut().ok_or(EIO)?.sequence += 1;
+        self.render_ordinal += 1;
+        Ok(Some(receipt))
+    }
+}
+impl Session {
+    pub(crate) fn stage_g16c_render(
+        &mut self,
+        key: Key,
+        client: &mut Option<compute::Client>,
+        p: &command::Parameters,
+        priority: u32,
+        kernel_start: u64,
+        kernel_end: u64,
+        private:&mut Option<OwnerPrivateG16C>,
+        transport:&mut Option<scheduled_queues::QueueBackingG16C>,
+        work_backing:&mut Option<WorkBackingG16C>,
+        prepared:Option<KBox<super::super::super::g17p_render_runtime::PreparedAppend>>,
+        rebind:Option<&mut super::super::super::g17p_boot::PreparedPoolRebind>,
+    ) -> Result<Option<Arc<RenderReceipt>>> {
+        if self.phase != Phase::Running
+            || self
+                .peers
+                .iter()
+                .any(|p| p.data.crashed.load(Ordering::Acquire))
+        {
+            return Err(EIO);
+        }
+        let mut state = self.g16c_compute.take().ok_or(EIO)?;
+        let result = state.stage_render(self, key, client, p, priority, kernel_start, kernel_end,private,transport,work_backing,prepared,rebind);
+        self.g16c_compute = Some(state);
+        self.finish_g16c_admission(result)
+    }
+}
diff --git a/drivers/gpu/drm/asahi/scheduled_resources.rs b/drivers/gpu/drm/asahi/scheduled_resources.rs
new file mode 100644
index 0000000000000..6b2528236dad1
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_resources.rs
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! Typed, reserved-memory contract for the single G16C firmware instance.
+//! All original ADT interpretation belongs to m1n1. Addresses here come from
+//! Linux resources backed by explicit reserved-memory phandles and no-map.
+
+use kernel::{c_str, of, prelude::*};
+
+pub(crate) const PAGE: u64 = 0x4000;
+pub(crate) const REGIONS: usize = 5;
+
+#[derive(Clone, Copy, Default)]
+pub(crate) struct Region {
+    pub(crate) base: u64,
+    pub(crate) size: u64,
+}
+
+impl Region {
+    pub(crate) fn contains_page(&self, page: u64) -> bool {
+        page & (PAGE - 1) == 0
+            && page >= self.base
+            && page
+                .checked_add(PAGE)
+                .zip(self.base.checked_add(self.size))
+                .is_some_and(|(end, limit)| end <= limit)
+    }
+}
+
+pub(crate) struct ResourcesG16C {
+    pub(crate) regions: [Region; REGIONS],
+    pub(crate) private_vm: [u64; 2],
+}
+
+impl ResourcesG16C {
+    pub(crate) fn from_fdt(node: &of::Node) -> Result<Self> {
+        let firmware: KVec<u8> = node.get_property(c_str!("apple,firmware-build"))?;
+        let names: KVec<u8> = node.get_property(c_str!("memory-region-names"))?;
+        let private: KVec<u64> = node.get_property(c_str!("apple,rtkit-private-vm-region"))?;
+        let handles: KVec<u32> = node.get_property(c_str!("memory-region"))?;
+        if firmware.as_slice() != b"mBoot-18000.161.10\0"
+            || names.as_slice() != b"ttbs\0pagetables\0l2\0handoff\0firmware\0"
+            || private.as_slice() != [0xfffffc0000000000, 0x2000000000]
+            || handles.len() != REGIONS
+        {
+            return Err(EINVAL);
+        }
+        let mut regions = [Region::default(); REGIONS];
+        for (index, name) in [
+            c_str!("ttbs"),
+            c_str!("pagetables"),
+            c_str!("l2"),
+            c_str!("handoff"),
+            c_str!("firmware"),
+        ]
+        .iter()
+        .enumerate()
+        {
+            let region = node
+                .parse_phandle(c_str!("memory-region"), index)
+                .ok_or(ENODEV)?;
+            let no_map: KVec<u8> = region.get_property(c_str!("no-map"))?;
+            let status: KVec<u8> = region.get_property(c_str!("status"))?;
+            if !no_map.is_empty() || status.as_slice() != b"okay\0" {
+                return Err(EINVAL);
+            }
+            let resource = node.reserved_mem_region_to_resource_byname(name)?;
+            let base = resource.start() as u64;
+            let size = resource.size() as u64;
+            let end = base.checked_add(size).ok_or(EINVAL)?;
+            if base == 0 || size == 0 || (base | size) & (PAGE - 1) != 0 || end > 1 << 42 {
+                return Err(EINVAL);
+            }
+            for previous in &regions[..index] {
+                if base < previous.base + previous.size && previous.base < end {
+                    return Err(EINVAL);
+                }
+            }
+            regions[index] = Region { base, size };
+        }
+        Ok(Self {
+            regions,
+            private_vm: [private[0], private[1]],
+        })
+    }
+
+    pub(crate) fn boot_table(&self, page: u64) -> bool {
+        self.regions[1].contains_page(page) || self.regions[2].contains_page(page)
+    }
+}
diff --git a/drivers/gpu/drm/asahi/scheduled_transport.rs b/drivers/gpu/drm/asahi/scheduled_transport.rs
new file mode 100644
index 0000000000000..ea1ae48af52fc
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_transport.rs
@@ -0,0 +1,518 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! Max's wrapped-work publication transaction, owned by the common Session.
+//! Memory/VM and client leases are the existing native owners. This layer does
+//! not schedule CPU jobs or resolve UAPI dependencies; it emits their wire plan.
+
+use super::{
+    g17p_compute_runtime::ClientLease,
+    g17p_memory::{self, Memory},
+    g17p_queue as q,
+    g17p_vm::Vm,
+    scheduled_initdata::Channel,
+    scheduled_queues::LaneG16C,
+};
+use kernel::prelude::*;
+
+#[derive(Clone, Copy)]
+pub(crate) struct Route {
+    pub(crate) read: u64,
+    pub(crate) done: u64,
+    pub(crate) producer: u64,
+    pub(crate) ring: u64,
+}
+impl Route {
+    pub(crate) fn decode(channel: &Channel) -> Result<Self> {
+        let [read, done, producer] = channel.states.map(u64::from_le_bytes);
+        let route = Self {
+            read,
+            done,
+            producer,
+            ring: u64::from_le_bytes(channel.ring),
+        };
+        route.validate()?;
+        Ok(route)
+    }
+    fn validate(&self) -> Result {
+        if [self.read, self.done, self.producer, self.ring]
+            .iter()
+            .any(|&v| v == 0 || v & 3 != 0)
+        {
+            return Err(EINVAL);
+        }
+        self.ring.checked_add(256 * 24).ok_or(EINVAL)?;
+        for a in [self.read, self.done, self.producer] {
+            a.checked_add(4).ok_or(EINVAL)?;
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct Stamp {
+    pub(crate) address: u64,
+    pub(crate) value: u32,
+}
+impl Stamp {
+    fn validate(&self) -> Result {
+        if self.address == 0 || self.address & 3 != 0 || self.address.checked_add(4).is_none() {
+            return Err(EINVAL);
+        }
+        Ok(())
+    }
+}
+pub(crate) struct Requirements {
+    pub(crate) firmware: KVec<Stamp>,
+    pub(crate) driver: KVec<Stamp>,
+    pub(crate) notifiers: KVec<u64>,
+    pub(crate) drains: KVec<Route>,
+    pub(crate) counters: KVec<Stamp>,
+}
+impl Requirements {
+    fn stamps(&self) -> impl Iterator<Item = &Stamp> {
+        Iterator::chain(
+            Iterator::chain(self.firmware.iter(), self.driver.iter()),
+            self.counters.iter(),
+        )
+    }
+
+    fn validate(&self) -> Result {
+        if self.driver.is_empty()
+            || (self.notifiers.is_empty() && self.counters.is_empty())
+            || (self.firmware.is_empty() && self.counters.is_empty())
+        {
+            return Err(EINVAL);
+        }
+        for s in self.stamps() {
+            s.validate()?;
+        }
+        for s in &self.counters {
+            if s.value == 0 {
+                return Err(EINVAL);
+            }
+        }
+        for &a in &self.notifiers {
+            Stamp {
+                address: a,
+                value: 0,
+            }
+            .validate()?;
+        }
+        for r in &self.drains {
+            r.validate()?;
+        }
+        Ok(())
+    }
+}
+
+pub(crate) struct Request<'a> {
+    pub(crate) lane: &'a mut LaneG16C,
+    pub(crate) works: &'a [u64],
+    pub(crate) event: u8,
+    pub(crate) tag: u64,
+}
+
+pub(crate) fn stamp_reached(current: u32, target: u32) -> bool {
+    current.wrapping_sub(target) < 0x80000000
+}
+pub(crate) fn ring_reached(current: u32, target: u32, capacity: u32) -> bool {
+    capacity >= 4
+        && current < capacity
+        && target < capacity
+        && (current + capacity - target) % capacity < capacity / 2
+}
+pub(crate) fn ring_room(tail: u32, read: u32, done: u32, entries: usize, capacity: u32) -> bool {
+    capacity >= 4
+        && capacity <= 0x10000
+        && capacity % 2 == 0
+        && [tail, read, done].iter().all(|&v| v < capacity)
+        && entries > 0
+        && entries < (capacity / 2) as usize
+        && [read, done]
+            .iter()
+            .all(|&v| (tail + capacity - v) % capacity + (entries as u32) < capacity / 2)
+}
+
+#[derive(Clone, Copy)]
+struct QueueTarget {
+    queue: u64,
+    pointers: u64,
+    capacity: u32,
+    head: u32,
+}
+#[derive(Clone, Copy)]
+struct ChannelTarget {
+    index: usize,
+    head: u32,
+}
+struct Flight {
+    id: u64,
+    requirements: Requirements,
+    queues: KVec<QueueTarget>,
+    channels: KVec<ChannelTarget>,
+    // Pins executable roots, GEM identities/backing and their cache owners.
+    _owners: KVec<ClientLease>,
+    completed: bool,
+    quiescent: bool,
+    error: Option<Error>,
+}
+struct Plan {
+    request: usize,
+    index: usize,
+    tail: u32,
+    head: u32,
+    epoch: u32,
+    counters: q::Counters,
+}
+
+/// Prepared host publication plan. The transport already owns its Flight and
+/// leases; no allocation is permitted after the engines are armed.
+pub(crate) struct PreparedG16C {
+    id: u64,
+    plans: KVec<Plan>,
+}
+
+pub(crate) struct StateG16C {
+    routes: [Route; 12],
+    flights: KVec<Flight>,
+    next: u64,
+    poisoned: bool,
+    allocation_faulted: bool,
+}
+fn read(memory: &Memory, vm: &Vm, address: u64) -> Result<u32> {
+    memory.read_firmware32(vm.physical(memory, 2, address)?)
+}
+fn poll(
+    memory: &Memory,
+    vm: &Vm,
+    routes: &[Route; 12],
+    poisoned: bool,
+    f: &mut Flight,
+) -> Result<bool> {
+    if f.quiescent {
+        return Ok(true);
+    }
+    if let Some(e) = f.error {
+        return Err(e);
+    }
+    if poisoned {
+        f.error = Some(EIO);
+        return Err(EIO);
+    }
+    f.completed = true;
+    for s in f.requirements.stamps() {
+        if !stamp_reached(read(memory, vm, s.address)?, s.value) {
+            f.completed = false;
+            return Ok(false);
+        }
+    }
+    if !f.completed {
+        return Ok(false);
+    }
+    let mut idle = true;
+    for &a in &f.requirements.notifiers {
+        idle &= read(memory, vm, a)? == 0;
+    }
+    for q in &f.queues {
+        for a in [q.pointers, q.pointers + 0x30] {
+            idle &= ring_reached(read(memory, vm, a)?, q.head, q.capacity);
+        }
+    }
+    for c in &f.channels {
+        let r = routes[c.index];
+        for a in [r.read, r.done] {
+            idle &= ring_reached(read(memory, vm, a)?, c.head, 256);
+        }
+    }
+    for r in &f.requirements.drains {
+        let tail = read(memory, vm, r.producer)?;
+        idle &= read(memory, vm, r.read)? == tail && read(memory, vm, r.done)? == tail;
+    }
+    f.quiescent = idle;
+    Ok(idle)
+}
+
+struct Writer<'a> {
+    memory: &'a mut Memory,
+    vm: &'a Vm,
+}
+impl q::Writer for Writer<'_> {
+    type Error = Error;
+    fn write(&mut self, address: u64, bytes: &[u8]) -> Result {
+        self.vm.write(self.memory, 2, address, bytes)
+    }
+}
+
+impl StateG16C {
+    pub(crate) fn new(channels: &[Channel]) -> Result<Self> {
+        if channels.len() != 12 {
+            return Err(EINVAL);
+        }
+        let mut routes = [Route {
+            read: 0,
+            done: 0,
+            producer: 0,
+            ring: 0,
+        }; 12];
+        for (out, input) in routes.iter_mut().zip(channels) {
+            *out = Route::decode(input)?;
+        }
+        Ok(Self {
+            routes,
+            flights: KVec::new(),
+            next: 1,
+            poisoned: false,
+            allocation_faulted: false,
+        })
+    }
+    pub(crate) fn poisoned(&self) -> bool {
+        self.poisoned
+    }
+    pub(crate) fn retains_owner(&self, owner: (u64, u32)) -> bool {
+        self.flights.iter().any(|flight|
+            flight._owners.iter().any(|lease| lease.owner == owner))
+    }
+
+    pub(crate) fn submit(
+        &mut self,
+        memory: &mut Memory,
+        vm: &Vm,
+        requests: &mut [Request<'_>],
+        requirements: Requirements,
+        owners: KVec<ClientLease>,
+        send: impl FnMut(u8, u64) -> Result,
+    ) -> Result<u64> {
+        let prepared = self.prepare(memory, vm, requests, requirements, owners)?;
+        self.publish(memory, vm, requests, prepared, send)
+    }
+
+    pub(crate) fn prepare(
+        &mut self, memory: &mut Memory, vm: &Vm, requests: &mut [Request<'_>],
+        requirements: Requirements, owners: KVec<ClientLease>,
+    ) -> Result<PreparedG16C> {
+        vm.require_g16c_graph()?;
+        if self.poisoned {
+            return Err(EIO);
+        }
+        if requests.is_empty() || requests.len() > 12 || owners.is_empty() {
+            return Err(EINVAL);
+        }
+        requirements.validate()?;
+        let mut seen = 0u16;
+        for request in requests.iter() {
+            let l = &request.lane;
+            if l.priority >= 4
+                || l.stage >= 3
+                || l.capacity < 4
+                || l.capacity > 0x10000
+                || l.capacity % 2 != 0
+                || l.head >= l.capacity
+                || request.works.is_empty()
+                || [l.queue, l.pointers, l.ring]
+                    .iter()
+                    .any(|&a| a == 0 || a & 7 != 0)
+                || request.works.iter().any(|&a| a == 0 || a & 3 != 0)
+            {
+                return Err(EINVAL);
+            }
+            l.pointers.checked_add(0x44).ok_or(EINVAL)?;
+            l.ring.checked_add(l.capacity as u64 * 8).ok_or(EINVAL)?;
+            let bit = 1u16 << (l.priority * 3 + l.stage);
+            if seen & bit != 0 {
+                return Err(EINVAL);
+            }
+            seen |= bit;
+        }
+        for s in requirements.stamps() {
+            if stamp_reached(read(memory, vm, s.address)?, s.value) {
+                return Err(EINVAL);
+            }
+        }
+        for old in &mut self.flights {
+            if poll(memory, vm, &self.routes, false, old)? {
+                continue;
+            }
+            for previous in old.requirements.stamps() {
+                for s in requirements.stamps() {
+                    if s.address == previous.address
+                        && (s.value == previous.value || !stamp_reached(s.value, previous.value))
+                    {
+                        return Err(EINVAL);
+                    }
+                }
+            }
+        }
+        let mut plans = KVec::with_capacity(requests.len(), GFP_KERNEL)?;
+        let mut queues = KVec::with_capacity(requests.len(), GFP_KERNEL)?;
+        let mut channels = KVec::with_capacity(requests.len(), GFP_KERNEL)?;
+        for (ri, request) in requests.iter().enumerate() {
+            let l = &request.lane;
+            let index = (l.priority * 3 + l.stage) as usize;
+            let r = self.routes[index];
+            let cr = read(memory, vm, l.pointers)?;
+            let cd = read(memory, vm, l.pointers + 0x30)?;
+            if read(memory, vm, l.pointers + 0x40)? != l.head {
+                return Err(EIO);
+            }
+            if !ring_room(l.head, cr, cd, request.works.len(), l.capacity) {
+                return Err(EBUSY);
+            }
+            let tail = read(memory, vm, r.producer)?;
+            let consumers = [read(memory, vm, r.read)?, read(memory, vm, r.done)?];
+            if !ring_room(tail, consumers[0], consumers[1], 1, 256) {
+                return Err(EBUSY);
+            }
+            let head = (l.head + request.works.len() as u32) % l.capacity;
+            let epoch = (tail + 1) % 256;
+            for old in &self.flights {
+                if old.quiescent {
+                    continue;
+                }
+                for q in &old.queues {
+                    if q.queue == l.queue && !ring_reached(head, q.head, l.capacity) {
+                        return Err(EBUSY);
+                    }
+                }
+                for c in &old.channels {
+                    if c.index == index && !ring_reached(epoch, c.head, 256) {
+                        return Err(EBUSY);
+                    }
+                }
+            }
+            plans.push(
+                Plan {
+                    request: ri,
+                    index,
+                    tail,
+                    head,
+                    epoch,
+                    counters: q::Counters::new([consumers[0],consumers[1],tail]).map_err(|_| EIO)?,
+                },
+                GFP_KERNEL,
+            )?;
+            queues.push(
+                QueueTarget {
+                    queue: l.queue,
+                    pointers: l.pointers,
+                    capacity: l.capacity,
+                    head,
+                },
+                GFP_KERNEL,
+            )?;
+            channels.push(ChannelTarget { index, head: epoch }, GFP_KERNEL)?;
+        }
+        if crate::module_parameters::g16c_initial_alloc_fail.value() == 9 && !self.allocation_faulted {
+            self.allocation_faulted = true;
+            kernel::pr_info!("G16C: injected unpublished transport ENOMEM before flight ownership/producers\n");
+            return Err(ENOMEM);
+        }
+        let id = self.next;
+        let next = id.checked_add(1).ok_or(EINVAL)?;
+        // Retain everything before the first visible store. A send/write may
+        // have reached hardware even when it subsequently reports an error.
+        self.flights.push(
+            Flight {
+                id,
+                requirements,
+                queues,
+                channels,
+                _owners: owners,
+                completed: false,
+                quiescent: false,
+                error: None,
+            },
+            GFP_KERNEL,
+        )?;
+        self.next = next;
+        Ok(PreparedG16C { id, plans })
+    }
+
+    pub(crate) fn publish(
+        &mut self, memory: &mut Memory, vm: &Vm, requests: &mut [Request<'_>],
+        prepared: PreparedG16C, mut send: impl FnMut(u8, u64) -> Result,
+    ) -> Result<u64> {
+        let PreparedG16C { id, plans } = prepared;
+        if self.poisoned || self.flights.last().is_none_or(|flight| flight.id != id)
+            || plans.len() != requests.len() {
+            self.poisoned = true;
+            return Err(EIO);
+        }
+        let result = (|| -> Result {
+            for stage in [1, 0, 2] {
+                for p in &plans {
+                    let request = &requests[p.request];
+                    let l = &request.lane;
+                    if l.stage != stage {
+                        continue;
+                    }
+                    let kind = match l.stage {
+                        0 => q::Kind::Tiling,
+                        1 => q::Kind::Fragment,
+                        _ => q::Kind::Compute,
+                    };
+                    let route = self.routes[p.index];
+                    q::Stage {
+                        queue: l.queue, pointers: l.pointers, item_ring: l.ring,
+                        item_capacity: l.capacity, write_index: l.head,
+                        channel_ring: route.ring, channel_producer: route.producer,
+                        counters: p.counters, slot: Some(p.tail as u8), items: request.works,
+                        group: 0, grid: u32::from(request.event), kind, first: l.first,
+                        in_place: false, announce: false, defer_inner: false, defer_outer: true,
+                        event_subtype: None, event_counter: None, event_counter_low: 0,
+                    }.publish_entry(&mut Writer {memory,vm}, p.head, request.tag, None)
+                        .map_err(|error| match error {
+                            q::StageError::Access(error) => error,
+                            q::StageError::Protocol(_) => EIO,
+                        })?;
+                }
+            }
+            g17p_memory::sync();
+            for stage in [1, 0, 2] {
+                for p in &plans {
+                    if requests[p.request].lane.stage == stage {
+                        vm.write(
+                            memory,
+                            2,
+                            self.routes[p.index].producer,
+                            &p.epoch.to_le_bytes(),
+                        )?;
+                    }
+                }
+            }
+            g17p_memory::sync();
+            for stage in [1, 0, 2] {
+                for p in &plans {
+                    let l = &mut requests[p.request].lane;
+                    if l.stage == stage {
+                        send(
+                            0x21,
+                            0x0083000000000000 | ((l.priority as u64) << 2) | l.stage as u64,
+                        )?;
+                        l.head = p.head;
+                        l.first = false;
+                    }
+                }
+            }
+            send(0x21, 0x0083000000000010)
+        })();
+        if let Err(e) = result {
+            self.poisoned = true;
+            self.flights.last_mut().ok_or(EIO)?.error = Some(e);
+            return Err(e);
+        }
+        Ok(id)
+    }
+
+    pub(crate) fn poll(&mut self, memory: &Memory, vm: &Vm, id: u64) -> Result<bool> {
+        let f = self.flights.iter_mut().find(|f| f.id == id).ok_or(EINVAL)?;
+        poll(memory, vm, &self.routes, self.poisoned, f)
+    }
+    pub(crate) fn release(&mut self, memory: &Memory, vm: &Vm, id: u64) -> Result {
+        if !self.poll(memory, vm, id)? {
+            return Err(EBUSY);
+        }
+        let i = self.flights.iter().position(|f| f.id == id).ok_or(EINVAL)?;
+        drop(self.flights.remove(i).map_err(|_| EIO)?);
+        Ok(())
+    }
+}
diff --git a/drivers/gpu/drm/asahi/scheduled_vm_g16c.rs b/drivers/gpu/drm/asahi/scheduled_vm_g16c.rs
new file mode 100644
index 0000000000000..d5a678f3803a9
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_vm_g16c.rs
@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! Max construction using the common UAT walker and Memory ownership.
+//! Establish the cold boot contract before starting RTKit. Its management
+//! phase may precede graph population, as in the qualified source startup.
+//! Retain the Vm in the session before population; on failure stop RTKit and
+//! restore borrowed tables before Memory releases any owned backing.
+//! Boot page-table DATA is preserved; firmware executable pages are not read.
+//! Context/root publication belongs to startup, after this construction succeeds.
+
+use super::{
+    g17p_memory::Memory,
+    g17p_vm::{BootTables, Vm},
+    scheduled_image::ImageG16C,
+    scheduled_initgraph as graph,
+    scheduled_resources::ResourcesG16C,
+};
+use kernel::prelude::*;
+
+const PAGE: usize = 0x4000;
+const ADDRESS: u64 = 0x0000_ffff_ffff_c000;
+
+// Only inherited page-table DATA is saved, never firmware executable pages.
+// Cold construction may add links to owned tables. Restore the borrowed tree
+// on failure before Memory is allowed to drop those newly allocated pages.
+type SavedTables = BootTables;
+
+// Only protocol page-table DATA in the declared boot reservations is read.
+// Track every child table before the common walker may use an inherited path.
+fn adopt(
+    vm: &mut Vm,
+    memory: &Memory,
+    resources: &ResourcesG16C,
+    table: u64,
+    ancestors: &mut [u64; 3],
+    level: usize,
+    saved: &mut SavedTables,
+) -> Result {
+    if !resources.boot_table(table) || ancestors[..level].contains(&table) {
+        return Err(EINVAL);
+    }
+    memory.invalidate(table, PAGE)?;
+    if let Some((_, depth, _)) = saved.iter().find(|(address, _, _)| *address == table) {
+        if *depth != level {
+            return Err(EINVAL);
+        }
+    } else {
+        let mut bytes = KVVec::new();
+        bytes.extend_with(PAGE, 0, GFP_KERNEL)?;
+        for i in 0..PAGE / 8 {
+            bytes[i * 8..i * 8 + 8]
+                .copy_from_slice(&memory.read64(table + i as u64 * 8)?.to_le_bytes());
+        }
+        saved.push((table, level, bytes), GFP_KERNEL)?;
+    }
+    vm.track_boot_table(table)?;
+    ancestors[level] = table;
+    if level < 2 {
+        for index in 0..if level == 0 { 64 } else { 2048 } {
+            let word = memory.read64(table + index * 8)?;
+            if word == 0 {
+                continue;
+            }
+            if word & 3 != 3 {
+                return Err(EINVAL);
+            }
+            adopt(
+                vm,
+                memory,
+                resources,
+                word & ADDRESS,
+                ancestors,
+                level + 1,
+                saved,
+            )?;
+        }
+    }
+    Ok(())
+}
+
+impl Vm {
+    pub(crate) fn prepare_g16c(memory: &mut Memory, resources: &ResourcesG16C) -> Result<Self> {
+        let mut low = [0; 2];
+        let mut high = [0; 2];
+        for roots in [&mut low, &mut high] {
+            for root in roots {
+                *root = memory.allocate(PAGE)?;
+                memory.zero(*root, PAGE)?;
+                memory.clean(*root, PAGE)?;
+            }
+        }
+        let firmware = resources.regions[1].base;
+        let mut vm = Self::g16c(firmware, low, high)?;
+        let mut saved = SavedTables::new();
+        adopt(
+            &mut vm,
+            memory,
+            resources,
+            firmware,
+            &mut [0; 3],
+            0,
+            &mut saved,
+        )?;
+        vm.retain_boot_tables(saved);
+        Ok(vm)
+    }
+
+    /// RTKit connects the reserved shared L2 during management startup. Walk
+    /// the current table DATA before constructing our graph, keeping original
+    /// snapshots for every table that existed before firmware started.
+    pub(crate) fn refresh_g16c_boot_tables(
+        &mut self, memory: &Memory, resources: &ResourcesG16C,
+    ) -> Result {
+        let mut saved = self.take_g16c_boot_tables()?;
+        let result = adopt(self, memory, resources, self.firmware_root(),
+            &mut [0; 3], 0, &mut saved);
+        // Retain restoration metadata even if a new table is invalid.
+        self.retain_boot_tables(saved);
+        result
+    }
+
+    /// Keep this Vm and Memory in the session through any failure. Restoring
+    /// the inherited tree is permitted only after firmware access has stopped.
+    pub(crate) fn populate_g16c(&mut self, memory: &mut Memory, image: &ImageG16C) -> Result {
+        self.begin_g16c_graph()?;
+        for (index, object) in graph::OBJECT_LAYOUT.iter().enumerate() {
+            let physical = memory.allocate(object.size)?;
+            memory.write(physical, image.object(index)?)?;
+            memory.clean(physical, object.size)?;
+            self.span(
+                memory,
+                2,
+                graph::BASE + object.offset as u64,
+                physical,
+                object.size,
+                object.pte_flags,
+            ).inspect_err(|error| {
+                kernel::pr_err!("G16C: RAM object {} VA {:#x} PA {:#x} size {:#x} mapping failed: {:?}\n",
+                    index, graph::BASE + object.offset as u64, physical, object.size, error);
+            })?;
+        }
+        for mapping in image.mmio.mappings() {
+            // Device PTEs only. MMIO is never CPU-mapped or cleared as RAM.
+            self.span(
+                memory,
+                2,
+                mapping.address,
+                mapping.physical,
+                mapping.size,
+                mapping.pte_flags,
+            ).inspect_err(|error| {
+                kernel::pr_err!("G16C: MMIO VA {:#x} PA {:#x} size {:#x} mapping failed: {:?}\n",
+                    mapping.address, mapping.physical, mapping.size, error);
+            })?;
+        }
+        for alias in graph::ALIASES {
+            for offset in (0..alias.size).step_by(PAGE) {
+                let physical = self.physical(memory, 2, alias.high + offset as u64)?;
+                self.span(
+                    memory,
+                    0,
+                    alias.low + offset as u64,
+                    physical,
+                    PAGE,
+                    alias.pte_flags,
+                )?;
+            }
+        }
+        self.flush_tables(memory)?;
+        Ok(())
+    }
+
+    /// Convenience transaction for a stopped ASC, including host validation.
+    /// Management-running startup uses prepare/populate with session ownership
+    /// so that its error path can stop RTKit before restoring the boot tree.
+    pub(crate) fn build_g16c(
+        memory: &mut Memory,
+        resources: &ResourcesG16C,
+        image: &ImageG16C,
+    ) -> Result<Self> {
+        let mut vm = Self::prepare_g16c(memory, resources)?;
+        if let Err(error) = vm.populate_g16c(memory, image) {
+            vm.restore_boot_tables(memory)
+                .expect("validated cold boot table restore");
+            return Err(error);
+        }
+        Ok(vm)
+    }
+}
diff --git a/drivers/gpu/drm/asahi/scheduled_wire.rs b/drivers/gpu/drm/asahi/scheduled_wire.rs
new file mode 100644
index 0000000000000..f421f3fe4f2ae
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_wire.rs
@@ -0,0 +1,317 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! G16C/G17P scheduled-work wire layouts for macOS 26.6.2.
+//!
+//! These values are owned host staging images, never references to live
+//! firmware-mutated storage. Byte-array fields preserve little-endian encoding
+//! and unaligned addresses without packed references or implicit padding.
+
+use kernel::macros::versions;
+
+#[versions(AGX_SCHEDULED)]
+#[repr(C)]
+pub(crate) struct QueueContext {
+    sentinel: [u8; 2],
+    pad_02: [u8; 3],
+    field_05: [u8; 1],
+    pad_06: [u8; 0x20],
+    field_26: [u8; 1],
+    pad_27: [u8; 0xc],
+    field_33: [u8; 1],
+    pad_34: [u8; 0xc],
+}
+
+#[versions(AGX_SCHEDULED)]
+impl Default for QueueContext::ver {
+    fn default() -> Self {
+        Self { sentinel: [0xff; 2], pad_02: [0; 3], field_05: [1],
+            pad_06: [0; 0x20], field_26: [2], pad_27: [0; 0xc],
+            field_33: [0xff], pad_34: [0; 0xc] }
+    }
+}
+
+#[versions(AGX_SCHEDULED)]
+impl QueueContext::ver {
+    pub(crate) fn as_bytes(&self) -> &[u8] {
+        // SAFETY: Initialized byte-array fields, alignment one, no padding.
+        unsafe { core::slice::from_raw_parts(core::ptr::from_ref(self).cast(), 0x40) }
+    }
+}
+
+#[versions(AGX_SCHEDULED)]
+const QUEUE_CONTEXT_LAYOUT: () = {
+    assert!(core::mem::size_of::<QueueContext::ver>() == 0x40);
+    assert!(core::mem::align_of::<QueueContext::ver>() == 1);
+    assert!(core::mem::offset_of!(QueueContext::ver, sentinel) == 0);
+    assert!(core::mem::offset_of!(QueueContext::ver, pad_02) == 2);
+    assert!(core::mem::offset_of!(QueueContext::ver, field_05) == 5);
+    assert!(core::mem::offset_of!(QueueContext::ver, pad_06) == 6);
+    assert!(core::mem::offset_of!(QueueContext::ver, field_26) == 0x26);
+    assert!(core::mem::offset_of!(QueueContext::ver, pad_27) == 0x27);
+    assert!(core::mem::offset_of!(QueueContext::ver, field_33) == 0x33);
+    assert!(core::mem::offset_of!(QueueContext::ver, pad_34) == 0x34);
+};
+
+#[derive(Clone, Copy)]
+pub(crate) struct QueueParameters {
+    pub(crate) pointers: u64,
+    pub(crate) ring: u64,
+    pub(crate) jobs: u64,
+    pub(crate) context: u64,
+    pub(crate) uuid: u32,
+    pub(crate) priority: u32,
+    pub(crate) unk_2c: u32,
+    pub(crate) unk_30: u64,
+    pub(crate) unk_38: u32,
+    pub(crate) prio5: u32,
+    pub(crate) unk_94: u32,
+}
+
+// G16C: g16c/queue.py Queue.encode, source-built and output-qualified.
+// G17P: g17p.py QUEUE_RECORD_SIZE. The 0xc0 allocation stride belongs to the
+// owner and must not be confused with the 0xac wire record.
+#[versions(AGX_SCHEDULED)]
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub(crate) struct QueueRecord {
+    pointers: [u8; 8],
+    ring: [u8; 8],
+    jobs: [u8; 8],
+    gpu_rptr1: [u8; 4],
+    gpu_rptr2: [u8; 4],
+    gpu_rptr3: [u8; 4],
+    unk_24: [u8; 4],
+    priority: [u8; 4],
+    unk_2c: [u8; 4],
+    unk_30: [u8; 8],
+    unk_38: [u8; 4],
+    unk_3c: [u8; 4],
+    prio5: [u8; 4],
+    unk_44: [u8; 4],
