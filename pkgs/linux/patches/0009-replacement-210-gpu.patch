+                (0x1c948, 0x0),
+                (0x1c888, 0x0),
+                (0x1c890, 0x0),
+                (0x1c918, 0x0),
+                (0x1c079, 0x0),
+                (0x1c9d8, 0x0),
+                (0x1c089, 0x0),
+                (0x1c9e0, 0x0),
+                (0x16c41, 0x0),
+                (0x1ca40, 0x0),
+                (0x1c9a8, 0x5c),
+                (0x1c920, 0x0),
+                (0x10151, 0x0),
+                (0x1c199, 0x0),
+                (0x1c1a1, 0x0),
+                (0x1c1a9, 0x0),
+                (0x1c1b1, 0x0),
+                (0x1c1b9, 0x0),
+                (0x1c8f8, 0x8860),
+                (0x10061, 0x0),
+                (0x11801, 0x0),
+                (0x11809, 0x0),
+                (0x11f71, 0x0),
+                (0x1c0b1, 0x0),
+                (0x1c850, 0x0),
+                (0x10131, 0x88),
