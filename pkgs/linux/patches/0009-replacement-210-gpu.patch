+	o->timestamps = bo_map(o->fd, ts, render_timestamp_range + PAGE * 2);
+	memset(o->timestamps, 0xa5, render_timestamp_range + PAGE * 2);
+	struct drm_asahi_gem_bind_object object = { .op = DRM_ASAHI_BIND_OBJECT_OP_BIND,
