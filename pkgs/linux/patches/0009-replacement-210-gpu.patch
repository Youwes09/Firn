+	if (relocate) puts("G17P_COMPUTE_RELOCATION_PASS eight further submissions after cleanup diagnostics");
+	return 0;
+}
diff --git a/drivers/gpu/drm/asahi/tests/g17p_drm_cpu_parallel.c b/drivers/gpu/drm/asahi/tests/g17p_drm_cpu_parallel.c
