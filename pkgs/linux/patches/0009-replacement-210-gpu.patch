+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Compare the complete Neo VM RAM image with the known-good tagged walker."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
