+static void check_render_owner(struct render_owner *o, unsigned index)
+{
+	CHECK(RENDER_OUTPUT_SIZE == SECOND_RENDER_OUTPUT_SIZE);
+	CHECK(RENDER_PIXEL_0 == SECOND_RENDER_PIXEL_0 && RENDER_PIXEL_1 == SECOND_RENDER_PIXEL_1);
