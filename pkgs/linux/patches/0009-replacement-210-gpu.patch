@@ -0,0 +1,74 @@
+# SPDX-License-Identifier: GPL-2.0-only
+"""Run the qualified source startup's actual build_graph against owned host RAM.
+
+No target setup, device access, captures or Apple executable content is loaded.
+"""
+import ast
+from pathlib import Path
+import struct
+import sys
+from types import SimpleNamespace as NS
+
+
+def build(m1n1,platform,entropy):
+    m1n1=Path(m1n1)
+    sys.path.insert(0,str(m1n1/'proxyclient'))
+    from m1n1.g16c.startup import Bootstrap
+    from m1n1.g16c.memory import AddressSpace,PAGE_SIZE
+    from m1n1.g16c.arena import Arena
+    from m1n1.g16c.firmware import Root,Main,bundle,hardware_regions,HardwareRegion
+    from m1n1.g16c.abi_defaults import apply
+    # Import only the existing independent RAM fixture's class definition;
+    # never execute that experiment's tests or its setup code.
+    source=m1n1/'proxyclient/experiments/agx_g16c_validate_private_lifetime.py'
+    nodes=ast.parse(source.read_text()).body
+    cls=next(n for n in nodes if isinstance(n,ast.ClassDef) and n.name=='RAM')
+    env={'struct':struct}
+    exec(compile(ast.Module(body=[cls],type_ignores=[]),str(source),'exec'),env)
+    ram=env['RAM']();ram.data=bytearray(64*1024*1024)
+    ram.ba=NS(phys_base=ram.base,mem_size_actual=len(ram.data))
+    b=Bootstrap.__new__(Bootstrap)
+    b.u=ram;b.p=ram;b.iface=ram;b.platform=platform;b.started=False
+    b.firmware=AddressSpace(ram,0,ram.memalign(PAGE_SIZE,PAGE_SIZE),ram.memalign(PAGE_SIZE,PAGE_SIZE))
+    b.client=AddressSpace(ram,0,ram.memalign(PAGE_SIZE,PAGE_SIZE),ram.memalign(PAGE_SIZE,PAGE_SIZE))
+    b.arena=Arena(b.firmware,0xfffffc2000000000,0xfffffc218100c000);b.arena.next=b.arena.end
+    b.client_arenas=[];b.asc=NS(work=lambda:None);b.progress=lambda *args:None
+    b.heap_views=b.primary_status_policy=b.hardware_status_mmio=b.initial_control_policy=b.scheduler_regions=True
+    b.native_opening_pool=False;b.single_user_opening=True
+    b.root=Root.bootstrap(max_layout=True,primary_status_policy=True,hardware_status_mmio=True)
+    b.main=Main.bootstrap(max_layout=True,heap_views=True)
+    b.regions=(HardwareRegion(0x100,0x7001848000,0xfffffc20c4000000,0x800,0x40,0),
+               HardwareRegion(0,0x7001870000,0xfffffc20c4028000,0x800,0x40,2))
+    b.scheduler_state=b.main.regions[2]-0x8000
+    image=bytearray(hardware_regions(apply(bundle(platform,entropy,max_layout=True,
+        heap_views=True,power_policy=True),hardware_status_address=0xfffffc218100c000),b.regions))
+    struct.pack_into('<Q',image,0x26b8,b.scheduler_state);b.image=bytes(image)
+    b.region_c_image=platform.region_c(max_policy=True)
+    Bootstrap.build_graph(b)
+    return b,ram
+
+
+def spans(b,ram):
+    pages=[r for _,r in sorted(b.firmware.mappings.items()) if ram.base<=r.physical<ram.base+len(ram.data)]
+    spans=[]
+    for page in pages:
+        if spans and page.address==spans[-1][0]+spans[-1][1] and page.attributes==spans[-1][2]:
+            spans[-1][1]+=page.size
+        else:spans.append([page.address,page.size,page.attributes])
+    return spans
+
+
+def aliases(b,ram):
+    high=[r for r in b.firmware.mappings.values()
+          if ram.base<=r.physical<ram.base+len(ram.data)]
+    pairs=[]
+    for low,r in sorted(b.client.mappings.items()):
+        for offset in range(0,r.size,0x4000):
+            physical=r.physical+offset
+            owner=next(h for h in high if h.physical<=physical<h.physical+h.size)
+            peer=owner.address+physical-owner.physical
+            address=low+offset
+            if pairs and address==pairs[-1][0]+pairs[-1][2] and peer==pairs[-1][1]+pairs[-1][2] and r.attributes==pairs[-1][3]:
+                pairs[-1][2]+=0x4000
+            else:pairs.append([address,peer,0x4000,r.attributes])
+    return pairs
diff --git a/drivers/gpu/drm/asahi/tests/g16c_render_oracle.py b/drivers/gpu/drm/asahi/tests/g16c_render_oracle.py
new file mode 100644
index 0000000000000..201dd73438743
--- /dev/null
+++ b/drivers/gpu/drm/asahi/tests/g16c_render_oracle.py
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: GPL-2.0-only
+"""CPU RGBA8 oracle for the source fixtures' POT Morton surface layout.
+
+Addressing follows Mesa src/asahi/layout/layout.c::ail_initialize_twiddled and
+tests/test-twiddling.cpp::tiled_offset_el. Multisample records contain one RGBA8
+word per sample; writable array layers are 16-KiB aligned. No GPU output input.
+"""
+def spread(value):
+    result=0
+    for bit in range(value.bit_length()):
+        result|=((value>>bit)&1)<<(2*bit)
+    return result
+
+def rgba8_expected(seed,width,height,layers,samples,color,offset=0):
+    assert width>0 and height>0 and layers>0 and samples in (1,2,4)
+    assert color in ('red','three-layer-colors','two-layer-red-green')
+    if color=='three-layer-colors':
+        assert layers==3  # The particular source shader's draw count.
+    if color=='two-layer-red-green':
+        assert layers==2
+    pw=1<<(width-1).bit_length()
+    ph=1<<(height-1).bit_length()
+    tile=min(pw,ph)
+    layer_stride=(pw*ph*4*samples+0x3fff)&-0x4000
+    expected=bytearray(seed)
+    points=set()
+    for layer in range(layers):
+        pixel=bytes.fromhex('ff0000ff') if color=='red' else bytes(((17+37*layer)%256,(51+73*layer)%256,(137+29*layer)%256,255))
+        if color=='two-layer-red-green':
+            pixel=bytes.fromhex('ff0000ff' if layer==0 else '00ff00ff')
+        for y in range(height):
+            for x in range(width):
+                block=((y//tile)*(pw//tile)+x//tile)*tile*tile
+                block+=spread(x%tile)|(spread(y%tile)<<1)
+                for sample in range(samples):
+                    at=offset+layer*layer_stride+block*4*samples+sample*4
+                    assert at+4<=len(expected) and at not in points
+                    points.add(at)
+                    expected[at:at+4]=pixel
+    assert len(points)==width*height*layers*samples
+    return bytes(expected),points,dict(layout='POT Morton',padded_width=pw,padded_height=ph,
+                                      tile=tile,layer_stride=layer_stride,sample_cells=len(points))
diff --git a/drivers/gpu/drm/asahi/tests/g17p_abi.rs b/drivers/gpu/drm/asahi/tests/g17p_abi.rs
new file mode 100644
index 0000000000000..ad15de87eed63
--- /dev/null
+++ b/drivers/gpu/drm/asahi/tests/g17p_abi.rs
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Host-side byte oracle adapter: compile the actual kernel serializers.
+#![allow(dead_code)]
+
+#[path = "../scheduled_initdata.rs"]
+mod scheduled_initdata;
+#[path = "../scheduled_boot_records.rs"]
+mod scheduled_boot_records;
+#[path = "../scheduled_hwdata.rs"]
+mod scheduled_hwdata;
+
+#[path = "../g17p_abi.rs"]
+mod abi;
+
+use std::{env, fs, path::Path};
+
+fn save(path: &Path, name: &str, data: &[u8]) {
+    fs::write(path.join(name), data).unwrap();
+}
+
+fn main() {
+    let directory = env::args().nth(1).expect("output directory");
+    let directory = Path::new(&directory);
+    fs::create_dir_all(directory).unwrap();
+    // Topology selects the actual root form. A null staging pointer must not
+    // turn a secondary instance into a primary-size descriptor.
+    let mut role_root = abi::Root {
+        version: [0x04c0, 0x0396, 0xa322, 0x0c8a],
+        region_a: 0,
+        main: 0,
+        region_c: 0,
+        kind: 1,
+        status: [0; 2],
+        secondary_extra: [0; 2],
+    };
+    let mut secondary = [0xa5; abi::ROOT_SECONDARY_SIZE];
+    role_root
+        .build_for_role(abi::FirmwareRole::Secondary, &mut secondary)
+        .unwrap();
+    assert_eq!(&secondary[0x28..0x2c], &1u32.to_le_bytes());
+    assert_eq!(&secondary[0xb8..], &[0; 16]);
+    let mut refused = [0xa5; abi::ROOT_SIZE];
+    assert_eq!(
+        role_root.build_for_role(abi::FirmwareRole::Primary, &mut refused),
+        Err(abi::InvalidSize)
+    );
+    assert_eq!(refused, [0xa5; abi::ROOT_SIZE]);
+    role_root.kind = 0;
+    role_root.secondary_extra = [1, 0];
+    assert_eq!(
+        role_root.build_for_role(abi::FirmwareRole::Primary, &mut refused),
+        Err(abi::InvalidSize)
+    );
+    assert_eq!(refused, [0xa5; abi::ROOT_SIZE]);
+    for case in 0..64u32 {
+        let address = |index: u64| 0xffff_fc20_0000_0000 + (u64::from(case) << 24) + index * 0x4143;
+        let root = abi::Root {
+            version: [0x04c0 ^ case as u16, 0x0396, 0xa322, 0x0c8a],
+            region_a: address(1),
+            main: address(2),
+            region_c: address(3),
+            kind: case & 1,
+            status: [address(4), address(5)],
+            secondary_extra: match case % 3 {
+                0 => [0, 0],
+                1 => [address(6), 0],
+                _ => [0, address(7)],
+            },
+        };
+        let mut out = vec![0xa5; root.size()];
+        root.build(&mut out).unwrap();
+        save(directory, &format!("root{case}.bin"), &out);
+        let mut wrong = vec![0xa5; root.size() - 1];
+        assert_eq!(root.build(&mut wrong), Err(abi::InvalidSize));
+        assert!(wrong.iter().all(|b| *b == 0xa5));
+
+        let mut channels = [abi::Channel::default(); abi::CHANNELS];
+        for (index, channel) in channels.iter_mut().enumerate() {
+            let base = index as u64 * 4;
+            *channel = abi::Channel {
+                states: [address(base), address(base + 1), address(base + 2)],
+                ring: address(base + 3),
+            };
+        }
+        let main = abi::MainConfig {
+            hardware: address(70),
+            repeated: address(71),
+            channels,
+            addresses: [
+                address(72),
+                address(73),
+                address(74),
+                address(75),
+                address(76),
+            ],
+            region_views: [
+                (u64::MAX, Some(case)),
+                (address(77), Some(0x01840000)),
+                (address(78), None),
+            ],
+            role: if case & 1 != 0 {
+                abi::FirmwareRole::Secondary
+            } else {
+                abi::FirmwareRole::Primary
+            },
+            secondary_extra: if case & 2 != 0 { address(79) } else { 0 },
+        };
+        let mut out = vec![0xa5; abi::MAIN_SIZE];
+        main.build(&mut out).unwrap();
+        save(directory, &format!("main{case}.bin"), &out);
+        let mut out = [0xa5; 0x20];
+        channels[case as usize % abi::CHANNELS]
+            .build(&mut out)
+            .unwrap();
+        save(directory, &format!("channel{case}.bin"), &out);
+
+        let mut out = [0xa5; 0x28];
+        abi::Register {
+            physical: 0x480000000 + u64::from(case) * 0x1800,
+            address: address(80),
+            size: 0x21400 + case,
+            relative: u64::MAX - u64::from(case),
+            flags: case,
+        }
+        .build(&mut out)
+        .unwrap();
+        save(directory, &format!("register{case}.bin"), &out);
+        let mut out = [0xa5; 0x40];
+        abi::RegionRecord {
+            lead: 0x100 + case,
+            value: 0x1848000 + case,
+            address: address(81),
+            size_a: 0x800 + case,
+            size_b: 0x40,
+            trail: case & 3,
+        }
+        .build(&mut out)
+        .unwrap();
+        save(directory, &format!("region{case}.bin"), &out);
+
+        let ladder = |column: u32| std::array::from_fn(|i| case * 1000 + column * 100 + i as u32);
+        let perf = abi::Performance {
+            freq_a: ladder(0),
+            freq_b: ladder(1),
+            core_voltage: ladder(2),
+            memory_voltage: ladder(3),
+            scale_b: ladder(4),
+            relative_a: ladder(5),
+            relative_b: ladder(6),
+            index_a: ladder(7),
+            index_b: ladder(8),
+        };
+        let registers = [
+            (
+                17,
+                abi::Register {
+                    physical: 0x480000000,
+                    address: address(80),
+                    size: 0x21400,
+                    relative: u64::from(case),
+                    flags: 2,
+                },
+            ),
+            (
+                41,
+                abi::Register {
+                    physical: 0x480e1f800,
+                    address: address(81),
+                    size: 0x4000,
+                    relative: u64::MAX,
+                    flags: 2,
+                },
+            ),
+        ];
+        let regions = [abi::RegionRecord {
+            lead: 0x100,
+            value: case,
+            address: address(82),
+            size_a: 0x800,
+            size_b: 0x40,
+            trail: 2,
+        }];
+        let opaque: &[(usize, &[u8])] = &[(0x20, &[0x12, 0x34, 0x56, 0x78])];
+        let hwdata = abi::HardwareData {
+            registers: &registers,
+            flags: &[(0, case), (52, 2)],
+            performance: &perf,
+            chip: if case & 1 != 0 { Some(0x8140) } else { None },
+            regions: &regions,
+            opaque: match case % 3 {
+                0 => None,
+                1 => Some(&[]),
+                _ => Some(opaque),
+            },
+        };
+        let mut out = vec![0xa5; abi::HWDATA_SIZE];
+        hwdata.build(&mut out).unwrap();
+        save(directory, &format!("hardware{case}.bin"), &out);
+        let mut out = vec![0xa5; 0x5000];
+        abi::primary_status(
+            &mut out,
+            address(83),
+            address(84),
+            0x100,
+            if case & 1 != 0 { 0x4000 } else { 0x4900 },
+            opaque,
+        )
+        .unwrap();
+        save(directory, &format!("primary_status{case}.bin"), &out);
+    }
+    let mut out = [0xa5; 0x20];
+    abi::compute_dispatch(&mut out).unwrap();
+    save(directory, "dispatch.bin", &out);
+    let mut out = vec![0xa5; abi::REGION_C_SIZE];
+    abi::region_c(&mut out).unwrap();
+    save(directory, "region_c.bin", &out);
+    for acknowledged in [false, true] {
+        let mut out = [0xa5; 0x80];
+        abi::status(&mut out, acknowledged).unwrap();
+        save(
+            directory,
+            &format!("status{}.bin", u8::from(acknowledged)),
+            &out,
+        );
+    }
+}
diff --git a/drivers/gpu/drm/asahi/tests/g17p_compute.rs b/drivers/gpu/drm/asahi/tests/g17p_compute.rs
