+        return {'target':cursor,'deferred_producer':(CONTROL,struct.pack('<I',cursor))}
+    def tick(counter,label,context_word=0,update_sequence=True):
+        body=bytearray(0x40)
+        struct.pack_into('<II',body,0,0x2e,counter)
