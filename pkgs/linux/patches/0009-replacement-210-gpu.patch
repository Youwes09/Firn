+#[versions(AGX_SCHEDULED)]
+impl Default for WorkRecord::ver {
+    fn default() -> Self {
+        // SAFETY: Every field is a byte array, so all-zero is valid staging.
+        #[allow(unused_mut)]
+        let mut raw: Self = unsafe { core::mem::zeroed() };
+        #[ver(G == G16C)]
+        {
