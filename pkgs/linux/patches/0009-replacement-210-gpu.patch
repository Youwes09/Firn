+  result(&images[0],0);struct drm_syncobj_wait wait={.handles=(uintptr_t)&done,.count_handles=1,.timeout_nsec=now_ns(),.flags=DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL};
