@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Check the actual BufferThing serializer, register builders and scene leases."""
+from pathlib import Path
+import os
+import re
+import subprocess
+import tempfile
+
+root = next(p for p in Path(__file__).resolve().parents
+            if (p / 'drivers/gpu/drm/asahi/g16_render.rs').exists())
+driver = root / 'drivers/gpu/drm/asahi'
+tvb = (driver / 'g16_tvb.rs').read_text()
+runtime = ''.join(p.read_text() for p in sorted(driver.glob('g16_runtime*.rs')))
+util = (driver / 'm4_util.rs').read_text()
+
+
+def item(source, pattern):
+    start = re.search(pattern, source).start()
+    brace = source.index('{', start)
+    depth, end = 1, brace + 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+
+fixture = r'''
+#![allow(dead_code, non_upper_case_globals)]
+#[derive(Debug, PartialEq)] struct Error;
+const EBUSY: Error = Error;
+type Result<T> = std::result::Result<T, Error>;
+mod module_parameters {
+    pub struct Parameter(u32);
+    impl Parameter { pub fn value(&self) -> u32 { self.0 } }
+    pub static notifier_flush: Parameter = Parameter(0);
+}
+// Only fragment_work uses this shim; the test calls the register builders.
+mod float {
+    pub struct F32(f32);
+    impl F32 {
+        pub fn from_bits(bits: u32) -> Self { Self(f32::from_bits(bits)) }
+        pub fn to_bits(self) -> u32 { self.0.to_bits() }
+    }
+    impl From<u32> for F32 { fn from(v: u32) -> Self { Self(v as f32) } }
+    impl std::ops::Div for F32 {
+        type Output = Self;
+        fn div(self, rhs: Self) -> Self { Self(self.0 / rhs.0) }
+    }
+}
+'''
+fixture += 'mod util {\n'
+for name in ('put32', 'put64'):
+    fixture += item(util, r'pub\(crate\) fn ' + name + r'\(') + '\n'
+fixture += '}\n'
+for name in ('g16_render', 'g16_stamp', 'g16_mesh'):
+    fixture += f'#[path = "{driver / (name + ".rs")}"] mod {name};\n'
+fixture += 'use g16_render as render;\n'
+fixture += re.search(r'const SCENES: u32 = .*?;', tvb).group() + '\n'
+fixture += '#[allow(dead_code)]\n' + item(tvb, r'pub\(crate\) enum Refusal') + '\n'
+fixture += '#[derive(Default)]\n' + item(tvb, r'pub\(crate\) struct Tvb')
+fixture += '\nimpl Tvb {\n'
+for name in ('reserve_scene', 'release_scene', 'work_addresses'):
+    fixture += item(tvb, r'pub\(crate\) fn ' + name + r'\(') + '\n'
+fixture += '}\nfn select(params: &mut render::Parameters, scene: u32) {\n'
+fixture += re.search(r'params\.scene_slot = [^;]+;\s*params\.cycle = [^;]+;',
+                     runtime).group() + '\n}\n'
+fixture += r'''
+fn read64(bytes: &[u8], off: usize) -> u64 {
+    u64::from_le_bytes(bytes[off..off + 8].try_into().unwrap())
+}
+fn scene_offset(pool: &Tvb, page: &[u8], scene: u32) -> (u64, u64) {
+    let mut work = render::Addresses::bootstrap();
+    pool.work_addresses(&mut work, scene);
+    let record = (work.buffer_thing - (pool.addresses.buffer_thing & !0x3fff)) as usize;
+    let mut p = render::Parameters::default();
+    p.set_private(0x10e0000000, 0x1100000000).unwrap();
+    p.width = 64; p.height = 64; p.layers = 1; p.samples = 1;
+    p.utile_width = 32; p.utile_height = 32;
+    p.encoder = p.context_base + 0x10000;
+    select(&mut p, scene);
+    let ta = p.tiling_registers().unwrap();
+    let frag = p.fragment_registers().unwrap();
+    for (registers, number) in [(&ta[..], 0x1ca30), (&ta[..], 0x16c39), (&frag[..], 0x1ca28)] {
+        assert_eq!(registers.iter().find(|(reg, _)| *reg == number).unwrap().1, p.cycle);
+    }
+    let cursor_reg = ta.iter().find(|(reg, _)| *reg == 0x1c910).unwrap().1;
+    assert_eq!(read64(page, record), p.context_base + cursor_reg - 1);
+    assert_eq!(read64(page, record + 8), pool.addresses.buffer_manager_scene_list + u64::from(scene) * 4);
+    let offset = read64(page, record + 0x28);
+    // The fixed alias maps one 16-KiB scene page. All records must fit.
+    assert!((0x240000..=0x244000 - 48).contains(&offset));
+    (offset, p.cycle)
+}
+fn main() {
+    for base in [0xfffffc20c0600000, 0xfffffc20c3804000] {
+        let mut addresses = render::Addresses::bootstrap();
+        addresses.buffer_thing = base + 0x80;
+        let mut pool = Tvb { addresses, ..Default::default() };
+        let mut page = [0u8; 0x4000];
+        addresses.private_page(base, &mut page).unwrap();
+        for _ in 0..3 {
+            let mut live = std::collections::BTreeSet::new();
+            let mut mismatches = Vec::new();
+            for expected in 0..SCENES {
+                let scene = pool.reserve_scene().unwrap();
+                assert_eq!(scene, expected);
+                let (offset, register) = scene_offset(&pool, &page, scene);
+                if offset != register { mismatches.push((scene, offset, register)); }
+                live.insert(offset);
+            }
+            assert!(mismatches.is_empty(), "{} mismatches; first={:?}",
+                    mismatches.len(), mismatches.first());
+            assert_eq!(live.len(), SCENES as usize, "live scenes must not alias");
+            assert_eq!(pool.reserve_scene(), Err(EBUSY));
+            // Keep odd leases alive while reusing the retired even leases.
+            for scene in (0..SCENES).step_by(2) { pool.release_scene(scene); }
+            for expected in (0..SCENES).step_by(2) {
+                let scene = pool.reserve_scene().unwrap();
+                assert_eq!(scene, expected);
+                let (offset, register) = scene_offset(&pool, &page, scene);
+                assert_eq!(offset, register);
+            }
+            assert_eq!(pool.reserve_scene(), Err(EBUSY));
+            for scene in 0..SCENES { pool.release_scene(scene); }
+            // Leave the next full cycle starting at zero after the sparse reuse.
+            let last = pool.reserve_scene().unwrap();
+            assert_eq!(last, SCENES - 1);
+            pool.release_scene(last);
+        }
+    }
+    println!("PASS: 80 unique scene offsets, TA/3D and cursor agreement, exhaustion and reuse; 2 placements x 3 cycles");
+}
+'''
+with tempfile.TemporaryDirectory(prefix='asahi-scene-', dir=os.getenv('TMPDIR')) as temp:
+    path = Path(temp)
+    (path / 'test.rs').write_text(fixture)
+    subprocess.run(['rustc', '--edition=2021', '-C', 'opt-level=1',
+                    str(path / 'test.rs'), '-o', str(path / 'test')], check=True)
+    subprocess.run([str(path / 'test')], check=True)
diff --git a/tools/testing/selftests/drivers/gpu/asahi/test-submit-reasons.py b/tools/testing/selftests/drivers/gpu/asahi/test-submit-reasons.py
new file mode 100755
index 0000000000000..0cdacd55dd60e
--- /dev/null
+++ b/tools/testing/selftests/drivers/gpu/asahi/test-submit-reasons.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Host source checks: every SUBMIT rejection names the failed check.
+
+A bare EINVAL from DRM_IOCTL_ASAHI_SUBMIT reached userspace as device loss
+with nothing in the kernel log (replaydump-kit2-20261024). In submit(), its
+timestamp resolver, render_parameters(), compute_parameters() and the mapping
+check, every EINVAL/ENOTSUPP goes through reject()/unsupported(), which log
+the reason (the first 32 per boot, then one "not logged" line).
+"""
+from pathlib import Path
+import re
+
+here = Path(__file__).resolve()
+root = next(p for p in here.parents if (p / 'drivers/gpu/drm/asahi/g16_drm.rs').exists())
+drm = ''.join(p.read_text() for p in sorted((root / 'drivers/gpu/drm/asahi').glob('g16_drm*.rs')))
+
+
+def function(source, name):
+    m = re.search(r'\n(\s*)(?:pub\((?:crate|super)\) )?fn ' + name + r'\b', source)
+    assert m, name
+    indent = m.group(1).lstrip('\n')
+    end = re.search(r'\n' + indent + r'}\n', source[m.end():])
+    return source[m.start():m.end() + end.end()]
+
+
+checks = 0
+bodies = {n: function(drm, n) for n in ('submit', 'render_parameters', 'compute_parameters')}
+m = re.search(r'impl Mapping \{.*?\n\}', drm, re.S)
+bodies['Mapping::cover'] = m.group()
+for name, body in bodies.items():
+    # Sync-entry slicing (try_into of fixed 16-byte chunks) can't fail and keeps its plain mapping.
+    stripped = re.sub(r'\.try_into\(\)\.map_err\(\|_\| EINVAL\)', '', body)
+    for bare in ('Err(EINVAL)', 'ok_or(EINVAL)', 'Err(ENOTSUPP)', 'ok_or(ENOTSUPP)'):
+        assert bare not in stripped, (name, bare)
+checks += 1
+assert sum(b.count('reject(format_args!(') for b in bodies.values()) >= 25
+assert sum(b.count('unsupported(format_args!(') for b in bodies.values()) == 3
+checks += 1
+assert 'const REJECT_LOG: u64 = 32;' in drm
+# Every rejection is counted in dep_stats (review R2), appended last.
+timeline = (root / 'drivers/gpu/drm/asahi/g16_timeline.rs').read_text()
+assert re.search(r'tvb_refused_memory \{\}\\nsubmit_rejected \{\}(?:"|\\n)', timeline)
+assert re.search(r'TVB_REFUSED_MEMORY\.load\(Relaxed\),\s*SUBMIT_REJECTED\.load\(Relaxed\)\s*[,)]', timeline)
+assert 'let n = crate::g16_timeline::SUBMIT_REJECTED.fetch_add(1, Ordering::Relaxed);' in drm
+# Docs stay with their items (review R1).
+assert re.search(r"/// The calling process's name, for hang reports\.\nfn current_comm\(\)", drm)
+log = function(drm, 'log_rejection')
+assert re.search(r'if n < REJECT_LOG \{.*?pr_warn!.*?\} else if n == REJECT_LOG \{\s*pr_warn!\("G16: further SUBMIT rejections are not logged', log, re.S)
+checks += 1
+# The operator's log filter (v2) treats G16 lines with these words as faults; a rejection is the
+# client's error, not a GPU fault, so no reason may contain them ("hang" matches inside words too).
+reasons = re.findall(r'(?:reject|unsupported)\(format_args!\(\s*"([^"]*)"', drm)
+reasons.append('G16: SUBMIT rejected with {}: {} ({} pid {})')
+for text in reasons:
+    assert not re.search(r'fault|timeout|timed out|hang|\bEIO\b|halt|reset', text, re.I), text
+checks += 1
+print(f'test-submit-reasons: {checks} checks passed ({len(reasons) - 1} reasons)')
diff --git a/tools/testing/selftests/drivers/gpu/asahi/test-tvb-growth-gfp.py b/tools/testing/selftests/drivers/gpu/asahi/test-tvb-growth-gfp.py
new file mode 100755
index 0000000000000..63f68bcd3fa0d
--- /dev/null
+++ b/tools/testing/selftests/drivers/gpu/asahi/test-tvb-growth-gfp.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Host source checks: G16 TVB growth, which answers a firmware request from
+the fence-signalling path, never enters reclaim and never takes the atomic
+reserves. Its data allocations use GFP_NOWAIT | __GFP_NOWARN, and a failure
+halves the request down to one block and
+then refuses, so the render finishes under its memory limit. Page tables
+for the new range are still allocated by map_pages (phase 2).
+"""
+from pathlib import Path
+import re
+
+here = Path(__file__).resolve()
+root = next(p for p in here.parents if (p / 'drivers/gpu/drm/asahi/g16_tvb.rs').exists())
+driver = root / 'drivers/gpu/drm/asahi'
+tvb = (driver / 'g16_tvb.rs').read_text()
+vm = (driver / 'g16_vm.rs').read_text()
+
+
+def function(source, name):
+    m = re.search(r'\n(\s*)(?:pub\((?:crate|super)\) )?fn ' + name + r'\b', source)
+    assert m, name
+    indent = m.group(1).lstrip('\n')
+    end = re.search(r'\n' + indent + r'}\n', source[m.end():])
+    return source[m.start():m.end() + end.end()]
+
+
+grow = function(tvb, 'grow')
+blocks = function(vm, 'alloc_tvb_blocks')
+checks = 0
+for name, body in (('grow', grow), ('alloc_tvb_blocks', blocks)):
+    assert 'GFP_KERNEL' not in body, f'{name} may reclaim'
+    checks += 1
+assert 'let gfp = GFP_NOWAIT | __GFP_NOWARN;' in grow and 'GFP_ATOMIC' not in grow
+assert 'client.alloc_tvb_blocks((new - old) as usize, gfp)?' in grow
+assert re.search(r'extend_with\(\(new - old\) as usize \* 8, 0u8, gfp\)', grow)
+checks += 1
+# The fallback: halve, then refuse at one block.
+assert re.search(r'if add == 1 \{\s*self\.refusal = Some\(.*?\);\s*return Ok\(false\);\s*\}\s*new = old \+ add / 2;', grow, re.S)
+checks += 1
+# Every allocation in alloc_tvb_blocks takes the caller's flags; none fails the context.
+assert 'Page::alloc_page(gfp | __GFP_ZERO)' in blocks and 'RBTreeNode::new(va, page, gfp)' in blocks
+assert 'pages.reserve(count * 8, gfp)' in blocks and 'push_within_capacity(node)' in blocks
+for failure in re.findall(r'Err\(_\) => return ([^,]+),', blocks):
+    assert failure == 'Ok(None)', failure
+checks += 1
+print(f'test-tvb-growth-gfp: {checks} checks passed')
diff --git a/tools/testing/selftests/drivers/gpu/asahi/test-tvb-refusal-visibility.py b/tools/testing/selftests/drivers/gpu/asahi/test-tvb-refusal-visibility.py
new file mode 100755
index 0000000000000..9c1228ac3ccf9
--- /dev/null
+++ b/tools/testing/selftests/drivers/gpu/asahi/test-tvb-refusal-visibility.py
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Host source checks: TVB growth refusals are visible.
+
+At a refusal the firmware only re-requests (about every 355 ms) until pages
+free up, so renders crawl and a client's exit drains slowly (2026-10-24).
+Every refusal records its reason (cap, render-arena VA, allocation); dep_stats
+counts them by reason (summing to tvb_refused); each pool reports once, as a
+warning for the first refusal of the boot and as info after that. No
+growth, cap or VA behaviour changes.
+"""
+from pathlib import Path
+import re
+
+here = Path(__file__).resolve()
+root = next(p for p in here.parents if (p / 'drivers/gpu/drm/asahi/g16_tvb.rs').exists())
+driver = root / 'drivers/gpu/drm/asahi'
+tvb = (driver / 'g16_tvb.rs').read_text()
+runtime = ''.join(p.read_text() for p in sorted(driver.glob('g16_runtime*.rs')))
+timeline = (driver / 'g16_timeline.rs').read_text()
+
+
+def function(source, name):
+    m = re.search(r'\n(\s*)(?:pub\((?:crate|super)\) )?fn ' + name + r'\b', source)
+    assert m, name
+    indent = m.group(1).lstrip('\n')
+    end = re.search(r'\n' + indent + r'}\n', source[m.end():])
+    return source[m.start():m.end() + end.end()]
+
+
+checks = 0
+grow = function(tvb, 'grow')
+# Each Ok(false) is preceded by a recorded reason.
+assert grow.count('Ok(false)') == 2
+assert re.search(r'if new == old \{\s*self\.refusal = Some\(Refusal::Cap\);\s*return Ok\(false\);', grow)
+assert re.search(r'if add == 1 \{\s*self\.refusal = Some\(if client\.tvb_va_blocks\(\) == 0 \{\s*Refusal::Va\s*\} else \{\s*'
+                 r'Refusal::Memory\s*\}\);\s*return Ok\(false\);', grow)
+# No behaviour change: the cap clamp and growth policy are p2's.
+assert 'let limit = (crate::module_parameters::tvb_max_blocks.value()).min(MAX_BLOCKS);' in grow
+assert 'let mut new = old.saturating_mul(3).min(limit).max(old);' in grow and 'tvb_va_blocks' not in grow.split('if add == 1')[0]
+checks += 1
+
+# dep_stats: three new fields appended after the existing ones.
+assert re.search(r'partial_renders \{\}\\n\\\s*tvb_refused_cap \{\}\\ntvb_refused_va \{\}\\ntvb_refused_memory \{\}', timeline)
+assert re.search(r'PARTIAL_RENDERS\.load\(Relaxed\),\s*TVB_REFUSED_CAP\.load\(Relaxed\),\s*TVB_REFUSED_VA\.load\(Relaxed\),\s*'
+                 r'TVB_REFUSED_MEMORY\.load\(Relaxed\)', timeline)
+checks += 1
+
+service = function(runtime, 'service_render_events')
+m = re.search(r'if grown \{ &tl::TVB_GROWN \} else \{ &tl::TVB_REFUSED \}\.fetch_add\(1, Relaxed\);\s*if !grown \{(.*?)\n                \}',
+              service, re.S)
+assert m, 'refusal accounting next to tvb_refused'
+body = m.group(1)
+for reason, counter in (('Cap', 'TVB_REFUSED_CAP'), ('Va', 'TVB_REFUSED_VA'), ('Memory', 'TVB_REFUSED_MEMORY')):
+    assert f'crate::g16_tvb::Refusal::{reason} => &tl::{counter},' in body
+# One warning per boot (the first refusal), info for later pools (review V1).
+assert re.search(r'if !pool\.warned \{\s*pool\.warned = true;.*?'
+                 r'if !crate::g16_tvb::REFUSAL_WARNED\.swap\(true, Relaxed\) \{\s*dev_warn!.*?\} else \{\s*dev_info!', body, re.S)
+assert 'pub(crate) static REFUSAL_WARNED: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);' in tvb
+assert 'return Err' not in body
+checks += 1
+print(f'test-tvb-refusal-visibility: {checks} checks passed')
diff --git a/tools/testing/selftests/drivers/gpu/asahi/test-uapi-downstream-bits.py b/tools/testing/selftests/drivers/gpu/asahi/test-uapi-downstream-bits.py
new file mode 100755
index 0000000000000..caefc1318aa62
--- /dev/null
+++ b/tools/testing/selftests/drivers/gpu/asahi/test-uapi-downstream-bits.py
@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Check the downstream (G16) values in include/uapi/drm/asahi_drm.h.
+
+Downstream feature bits and render flags are single bits allocated from bit 30
+downwards, after the "Downstream (G16) extensions" comment in each enum.
+Upstream's values stay below bit 24. The G16 render path accepts exactly the
+expected render flags; the old downstream bits (feature 1, render flag 3) are
+not aliases. With MESA_UAPI_HEADER set, Mesa's copy must be byte-identical.
+"""
+from pathlib import Path
+import os
+import re
+
+root = next(p for p in Path(__file__).resolve().parents
+            if (p / 'include/uapi/drm/asahi_drm.h').exists())
+header = (root / 'include/uapi/drm/asahi_drm.h').read_text()
+
+
+def values(enum):
+    body = re.search(r'^enum ' + enum + r' \{\n(.*?)^\};', header, re.M | re.S).group(1)
+    marker = body.index('Downstream (G16) extensions')
+    found = {}
+    for m in re.finditer(r'(DRM_ASAHI_\w+) = \(1UL?\)? ?<< (\d+)\)?,', body):
+        found[m.group(1)] = (int(m.group(2)), m.start() > marker)
+    return found
+
+
+features = values('drm_asahi_feature')
+flags = values('drm_asahi_render_flags')
+for name, table in (('feature', features), ('render flag', flags)):
+    bits = [bit for bit, _ in table.values()]
+    assert len(bits) == len(set(bits)), f'duplicate {name} bit: {table}'
+    for value, (bit, downstream) in table.items():
+        if downstream:
+            assert 24 <= bit <= 30, f'{value} = bit {bit} is outside the downstream range'
+        else:
+            assert bit < 24, f'upstream {value} = bit {bit} reaches the downstream range'
+
+assert {k: v[0] for k, v in features.items() if v[1]} == {
+    'DRM_ASAHI_FEATURE_FEW_PRIMITIVES': 30, 'DRM_ASAHI_FEATURE_FRAGMENT_BARRIER': 29}
+assert {k: v[0] for k, v in flags.items() if v[1]} == {
+    'DRM_ASAHI_RENDER_FEW_PRIMITIVES': 30, 'DRM_ASAHI_RENDER_VDM_BARRIER_FRAGMENT': 29}
+
+# The render path's accepted-flag mask, by name, resolved through the header.
+driver = ''.join(p.read_text() for p in sorted((root / 'drivers/gpu/drm/asahi').glob('g16_drm*.rs')))
+aliases = dict(re.findall(r'drm_asahi_render_flags_(DRM_ASAHI_RENDER_\w+) as (\w+)', driver))
+mask = re.search(r'c\.flags & !\(([^)]*)\)', driver).group(1)
+accepted = {flags[{v: k for k, v in aliases.items()}[n.strip()]][0] for n in mask.split('|')}
+assert accepted == {1, 18, 29, 30}, accepted
+assert 3 not in accepted
+
+mesa = os.environ.get('MESA_UAPI_HEADER')
+if mesa:
+    assert Path(mesa).read_bytes() == (root / 'include/uapi/drm/asahi_drm.h').read_bytes(), \
+        f'{mesa} differs from the kernel header'
+print('PASS: downstream asahi UAPI bits' + (' (Mesa header identical)' if mesa else ''))
