+// SPDX-License-Identifier: GPL-2.0-only
+
+//! G16C's owned, unpublished single-instance boot graph.
+//!
+//! Addresses, permissions and aliases follow the output-qualified single-user
+//! source builder. Allocation and publication remain separate: these are CPU
+//! staging buffers, not references into memory which firmware can mutate.
+//! The control ring starts inside MainConfig, so it shares the bundle owner.
+
+use super::{
+    scheduled_board::{BoardG16C, HardwarePointers},
+    scheduled_boot_records::{PrimaryStatusG16C, RegionCG16C},
+    scheduled_hwdata::{self as hardware, HardwareDataG16C},
+    scheduled_initdata::{
+        Channel, FirmwareRole, HardwareRegion, InitRootG16C, MainConfigG16C, MmioRegion,
+    },
+    scheduled_power::{self as power, PowerControllerG16C, PowerLinks, SettingsG16C},
+};
+
+pub(crate) const PAGE: usize = 0x4000;
+pub(crate) const BASE: u64 = 0xffff_fc20_0000_0000;
+pub(crate) const BUNDLE_OFFSET: usize = 0xc04d8000;
+pub(crate) const MAIN_OFFSET: usize = 0x1e100;
+pub(crate) const POWER_OFFSET: usize = 0x5240;
+pub(crate) const OBJECTS: usize = 36;
+const STATUS: usize = 2;
+const REGION_C: usize = 3;
+const ROOT: usize = 4;
+const RESUME_FLAG: usize = 14;
+const RESUME_TABLE: usize = 15;
+const POLICY: usize = 19;
+const BUNDLE: usize = 25;
+
+/// Layout only; encoders copy each component's static Default template
+/// directly into staging, without placing this large aggregate on the stack.
+#[repr(C)]
+pub(crate) struct FirmwareBundleG16C {
+    pub(crate) hardware: HardwareDataG16C,
+    pub(crate) pad_3db4: [u8; POWER_OFFSET - hardware::SIZE],
+    pub(crate) power: PowerControllerG16C,
+    pub(crate) entropy: [u8; 4],
+    // Additional observed scalar locations. Their producer/meaning is not
+    // established. The output-qualified source startup initializes them to
+    // zero; never universalize this device's captured calibration values.
+    pub(crate) pad_b618: [u8; 0x48],
+    pub(crate) field_b660: [u8; 4],
+    pub(crate) pad_b664: [u8; 8],
+    pub(crate) fields_b66c: [[u8; 4]; 4],
+    pub(crate) pad_b67c: [u8; 0x70],
+    pub(crate) fields_b6ec: [[u8; 4]; 4],
+    pub(crate) pad_b6fc: [u8; 0x40],
+    pub(crate) field_b73c: [u8; 4],
+    pub(crate) pad_b740: [u8; 4],
+    pub(crate) field_b744: [u8; 4],
+    pub(crate) unmodeled_b748: [u8; MAIN_OFFSET - 0xb748],
+    pub(crate) main: MainConfigG16C,
+    pub(crate) pad_1e600: [u8; 0x20000 - 0x1e600],
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Object {
+    pub(crate) offset: usize,
+    pub(crate) size: usize,
+    pub(crate) pte_flags: u64,
+}
+
+const SHARED: u64 = 0x00c0_0000_0000_044b;
+const CACHED: u64 = 0x00c0_0000_0000_0443;
+const ROOT_SHARED: u64 = 0x0080_0000_0000_044b;
+const fn object(offset: usize, size: usize, pte_flags: u64) -> Object {
+    Object {
+        offset,
+        size,
+        pte_flags,
+    }
+}
+
+// Coalesce adjacent RAM pages with equal permissions, keeping holes unmapped.
+// MMIO (including the hardware-status alias) is never a RAM object to clear.
+pub(crate) const OBJECT_LAYOUT: [Object; OBJECTS] = [
+    object(0x20000, PAGE, SHARED),
+    object(0x28000, PAGE, SHARED),
+    object(0x30000, 0xc4000, SHARED),
+    object(0xf8000, PAGE, ROOT_SHARED),
+    object(0x100000, PAGE, ROOT_SHARED),
+    object(0x10c000, PAGE, ROOT_SHARED),
+    object(0x110000, PAGE, SHARED),
+    object(0x118000, PAGE, SHARED),
+    object(0x120000, PAGE, SHARED),
+    object(0x128000, PAGE, SHARED),
+    object(0x130000, PAGE, SHARED),
+    object(0x140000, PAGE, SHARED),
+    object(0x148000, PAGE, SHARED),
+    object(0x150000, PAGE, SHARED),
+    object(0x1b0000, PAGE, SHARED),
+    object(0x1b8000, PAGE, ROOT_SHARED),
+    object(0x1c0000, 0x10000, SHARED),
+    object(0x1540000, PAGE, SHARED),
+    object(0x1548000, PAGE, SHARED),
+    object(0x1550000, PAGE, SHARED),
+    object(0xc0018000, 0x94000, CACHED),
+    object(0xc00b0000, 0x2a4000, CACHED),
+    object(0xc0358000, 0x12c000, CACHED),
+    object(0xc0488000, 0x34000, CACHED),
+    object(0xc04c0000, 0x10000, CACHED),
+    object(BUNDLE_OFFSET, 0x24000, CACHED),
+    object(0xc0500000, PAGE, CACHED),
+    object(0xc0510000, PAGE, CACHED),
+    object(0xc0524000, PAGE, SHARED),
+    object(0xc0528000, PAGE, CACHED),
+    object(0xc0530000, PAGE, CACHED),
+    object(0xc05e8000, 0x8000, CACHED),
+    object(0xc4000000, 0x20000, CACHED),
+    object(0xc4028000, 0x20000, CACHED),
+    object(0x181000000, PAGE, SHARED),
+    object(0x181008000, PAGE, SHARED),
+];
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Alias {
+    pub(crate) low: u64,
+    pub(crate) high: u64,
+    pub(crate) size: usize,
+    pub(crate) pte_flags: u64,
+}
+const fn alias(low: u64, offset: u64, size: usize, writable: bool) -> Alias {
+    Alias {
+        low,
+        high: BASE + offset,
+        size,
+        pte_flags: if writable {
+            0x00c0_0000_0000_0c8b
+        } else {
+            0x0080_0000_0000_0c8b
+        },
+    }
+}
+
+// Install these in context zero using the physical backing of the high view.
+// Allocating a second zeroed buffer for a low view is not an alias.
+pub(crate) const ALIASES: [Alias; 8] = [
+    alias(0x7000000000, 0xc0018000, 0x94000, false),
+    alias(0x7000098000, 0xc00b0000, 0x204000, false),
+    alias(0x70002a0000, 0xc02b8000, 0x98000, false),
+    alias(0x7000340000, 0xc0358000, 0xf4000, false),
+    alias(0x7001838000, 0x1548000, PAGE, true),
+    alias(0x7001840000, 0x1550000, PAGE, true),
+    alias(0x7001848000, 0xc4000000, 0x20000, true),
+    alias(0x7001870000, 0xc4028000, 0x20000, true),
+];
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct InvalidGraph;
+
+/// Each index must return stable, exclusive storage for its complete owner.
+/// Callers discard the unpublished image if construction returns an error.
+pub(crate) trait Storage {
+    fn object(&mut self, index: usize) -> Result<&mut [u8], InvalidGraph>;
+}
+
+pub(crate) struct Graph {
+    pub(crate) channels: [Channel; 17],
+}
+
+impl Graph {
+    pub(crate) fn root(&self, role: FirmwareRole) -> Option<u64> {
+        match role {
+            FirmwareRole::Primary => Some(BASE + 0x100000),
+            FirmwareRole::Secondary => None,
+        }
+    }
+}
+
+fn region(lead: u32, low: u32, high: u64, trail: u32) -> HardwareRegion {
+    HardwareRegion {
+        lead: lead.to_le_bytes(),
+        low: low.to_le_bytes(),
+        high: high.to_le_bytes(),
+        count: 0x800u32.to_le_bytes(),
+        stride: 0x40u32.to_le_bytes(),
+        trail: trail.to_le_bytes(),
+        ..Default::default()
+    }
+}
+
+pub(crate) fn build(
+    storage: &mut impl Storage,
+    board: &BoardG16C,
+    registers: &[(usize, MmioRegion)],
+    settings: &SettingsG16C,
+    entropy: u32,
+) -> Result<Graph, InvalidGraph> {
+    if board.cs_count == 0 || board.cs_count > board.cs.len() {
+        return Err(InvalidGraph);
+    }
+    let regions = [
+        region(0x100, 0x1848000, BASE + 0xc4000000, 0),
+        region(0, 0x1870000, BASE + 0xc4028000, 2),
+    ];
+    let hardware = board.hardware(
+        registers,
+        HardwarePointers {
+            status: BASE + 0x18100c000,
+            computed: BASE + 0x1540000,
+            timestamp: BASE + 0x181400000,
+        },
+        Some(&regions),
+    );
+    hardware.validate().map_err(|_| InvalidGraph)?;
+    let power = power::ParametersG16C::derive(board, settings).map_err(|_| InvalidGraph)?;
+    // Reject all caller-controlled geometry/configuration before clearing RAM.
+    for (index, object) in OBJECT_LAYOUT.iter().enumerate() {
+        if storage.object(index)?.len() != object.size {
+            return Err(InvalidGraph);
+        }
+    }
+    for index in 0..OBJECTS {
+        storage.object(index)?.fill(0);
+    }
+
+    let mut root = InitRootG16C::default();
+    root.region_a = (BASE + 0x10c000).to_le_bytes();
+    root.main = (BASE + BUNDLE_OFFSET as u64 + MAIN_OFFSET as u64).to_le_bytes();
+    root.region_c = (BASE + 0xf8000).to_le_bytes();
+    root.status_a = (BASE + 0x3f180).to_le_bytes();
+    root.status_b = (BASE + 0x30000).to_le_bytes();
+    root.extra_0 = (BASE + 0x3e440).to_le_bytes();
+    root.extra_1 = (BASE + 0xf3440).to_le_bytes();
+    storage.object(ROOT)?[..InitRootG16C::SIZE].copy_from_slice(root.as_bytes());
+    RegionCG16C::encode(storage.object(REGION_C)?, board.maximum_power)
+        .map_err(|_| InvalidGraph)?;
+    let status = storage.object(STATUS)?;
+    PrimaryStatusG16C::encode(status, BASE + 0x150000, BASE + 0x150040)
+        .map_err(|_| InvalidGraph)?;
+    status[0xf184..0xf188].copy_from_slice(&1u32.to_le_bytes());
+
+    let mut main = MainConfigG16C::default();
+    let bundle_address = BASE + BUNDLE_OFFSET as u64;
+    main.hardware = bundle_address.to_le_bytes();
+    main.repeated = (bundle_address + 0xc040).to_le_bytes();
+    main.repeated_2 = main.repeated;
+    let rings = [
+        0x10240, 0x16240, 0x1c240, 0xea40, 0x14a40, 0x1aa40, 0xd240, 0x13240, 0x19240, 0xba40,
+        0x11a40, 0x17a40, 0x1df00,
+    ];
+    for (i, ring) in rings.into_iter().enumerate() {
+        let row = if i == 12 {
+            0x300
+        } else {
+            (i % 3) * 0x100 + (3 - i / 3) * 0x40
+        };
+        let state = BASE + 0x20000 + row as u64;
+        main.channels[i] = Channel {
+            states: [
+                state.to_le_bytes(),
+                (state + 0x10).to_le_bytes(),
+                (state + 0x20).to_le_bytes(),
+            ],
+            ring: (bundle_address + ring + 0x6c0).to_le_bytes(),
+        };
+    }
+    for (i, values) in [
+        (13, [0x3f1c0, 0x3f440, 0x3f200, 0x43c40]),
+        (14, [0x3f3c0, 0xe5c40, 0x3f400, 0xeec40]),
+    ] {
+        main.channels[i] = Channel {
+            states: core::array::from_fn(|j| (BASE + values[j]).to_le_bytes()),
+            ring: (BASE + values[3]).to_le_bytes(),
+        };
+    }
+    main.channels[15].states[0] = (BASE + 0x6c440).to_le_bytes();
+    main.auxiliary = [0, 0x2740, 0x3380, 0x4400, 0xb7c0, 0xb840].map(|offset| {
+        if offset == 0 {
+            [0; 8]
+        } else {
+            (bundle_address + offset).to_le_bytes()
+        }
+    });
+    main.regions = [
+        BASE + 0xc0518000,
+        0x7001838000,
+        BASE + 0x1548000,
+        0x7001840000,
+        BASE + 0x1550000,
+        0,
+    ]
+    .map(u64::to_le_bytes);
+    main.unaligned = (bundle_address + POWER_OFFSET as u64).to_le_bytes();
+    let bundle = storage.object(BUNDLE)?;
+    hardware.build(bundle).map_err(|_| InvalidGraph)?;
+    power
+        .encode(
+            &mut bundle[POWER_OFFSET..],
+            PowerLinks {
+                thermal_context: BASE + 0xf34c0,
+                auxiliary: BASE + 0xc0500000,
+            },
+        )
+        .map_err(|_| InvalidGraph)?;
+    bundle[0xb614..0xb618].copy_from_slice(&entropy.to_le_bytes());
+    bundle[MAIN_OFFSET..MAIN_OFFSET + MainConfigG16C::SIZE].copy_from_slice(main.as_bytes());
+    // The opening opcode 0x16 is main.interval at +0x4c0. The rest of its
+    // 0x40-byte slot is already zero; it must not get a separate allocation.
+    storage.object(RESUME_FLAG)?[..4].copy_from_slice(&1u32.to_le_bytes());
+    let resume = storage.object(RESUME_TABLE)?;
+    for i in 0..96 {
+        resume[i * 0x40..i * 0x40 + 8].copy_from_slice(&0x7000001822u64.to_le_bytes());
+    }
+    let policy = storage.object(POLICY)?;
+    policy[..8].copy_from_slice(&(0x4000_0000_0000_0000u64 | (0x7000000000u64 >> 7)).to_le_bytes());
+    policy[12..16].copy_from_slice(&(20u32 * 2048 * 2).to_le_bytes());
+    policy[16..20].copy_from_slice(&(20u32 * 2048).to_le_bytes());
+    Ok(Graph {
+        channels: main.channels,
+    })
+}
+
+const _: () = {
+    assert!(core::mem::align_of::<FirmwareBundleG16C>() == 1);
+    assert!(core::mem::size_of::<FirmwareBundleG16C>() == 0x20000);
+    assert!(core::mem::offset_of!(FirmwareBundleG16C, power) == POWER_OFFSET);
+    assert!(core::mem::offset_of!(FirmwareBundleG16C, entropy) == 0xb614);
+    assert!(core::mem::offset_of!(FirmwareBundleG16C, field_b660) == 0xb660);
+    assert!(core::mem::offset_of!(FirmwareBundleG16C, fields_b66c) == 0xb66c);
+    assert!(core::mem::offset_of!(FirmwareBundleG16C, fields_b6ec) == 0xb6ec);
+    assert!(core::mem::offset_of!(FirmwareBundleG16C, field_b73c) == 0xb73c);
+    assert!(core::mem::offset_of!(FirmwareBundleG16C, field_b744) == 0xb744);
+    assert!(core::mem::offset_of!(FirmwareBundleG16C, main) == MAIN_OFFSET);
+    assert!(MAIN_OFFSET + core::mem::offset_of!(MainConfigG16C, interval) == 0x1df00 + 0x6c0);
+    let mut i = 0;
+    while i < OBJECTS {
+        let object = OBJECT_LAYOUT[i];
+        assert!(object.offset % PAGE == 0 && object.size > 0 && object.size % PAGE == 0);
+        if i > 0 {
+            assert!(OBJECT_LAYOUT[i - 1].offset + OBJECT_LAYOUT[i - 1].size <= object.offset);
+        }
+        i += 1;
+    }
+};
diff --git a/drivers/gpu/drm/asahi/scheduled_lifetime.rs b/drivers/gpu/drm/asahi/scheduled_lifetime.rs
new file mode 100644
index 0000000000000..bb3d56809aab2
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_lifetime.rs
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! Source G16C control DATA. Constructors never publish a channel producer.
+
+#[repr(C)]
+pub(crate) struct MaintenanceG16C {
+    opcode: [u8; 4],
+    engine: [u8; 4],
+    phase: [u8; 4],
+    reserved: [u8; 0x34],
+}
+impl Default for MaintenanceG16C {
+    fn default() -> Self {
+        Self {
+            opcode: 0x1bu32.to_le_bytes(),
+            engine: [0; 4],
+            phase: [0; 4],
+            reserved: [0; 0x34],
+        }
+    }
+}
+impl MaintenanceG16C {
+    pub(crate) fn new(engine: u32, phase: u32) -> Option<Self> {
+        if engine > 2 || !(1..=2).contains(&phase) {
+            return None;
+        }
+        Some(Self {
+            engine: engine.to_le_bytes(),
+            phase: phase.to_le_bytes(),
+            ..Self::default()
+        })
+    }
+    pub(crate) fn bytes(&self) -> &[u8; 64] {
+        // SAFETY: Initialized byte arrays, no padding, checked layout below.
+        unsafe { &*core::ptr::from_ref(self).cast() }
+    }
+}
+#[repr(C)]
+pub(crate) struct LifetimeTickG16C {
+    opcode: [u8; 4],
+    reserved: [u8; 0x3c],
+}
+impl Default for LifetimeTickG16C {
+    fn default() -> Self {
+        Self {
+            opcode: 0x2eu32.to_le_bytes(),
+            reserved: [0; 0x3c],
+        }
+    }
+}
+impl LifetimeTickG16C {
+    pub(crate) fn for_render(sequence: u32) -> Self {
+        let mut raw = Self::default();
+        raw.reserved[..4].copy_from_slice(&sequence.to_le_bytes());
+        raw
+    }
+
+    pub(crate) fn bytes(&self) -> &[u8; 64] {
+        // SAFETY: Same byte-array layout invariant.
+        unsafe { &*core::ptr::from_ref(self).cast() }
+    }
+}
+#[repr(C)]
+pub(crate) struct ContextCloseG16C {
+    opcode: [u8; 4],
+    reserved_04: [u8; 4],
+    indices_flags: [u8; 4],
+    context: [u8; 8],
+    reserved_14: [u8; 0x2c],
+}
+impl Default for ContextCloseG16C {
+    fn default() -> Self {
+        Self {
+            opcode: 0x14u32.to_le_bytes(),
+            reserved_04: [0; 4],
+            indices_flags: 0x04000002u32.to_le_bytes(),
+            context: [0; 8],
+            reserved_14: [0; 0x2c],
+        }
+    }
+}
+impl ContextCloseG16C {
+    pub(crate) fn new(context: u64, prefix: [u8; 4]) -> Option<Self> {
+        if context < 0xfffffc0000000000 || context & 15 != 0 || prefix[..2].contains(&255) {
+            return None;
+        }
+        // These are firmware-assigned prefix indices, not a scheduler slot.
+        Some(Self {
+            context: context.to_le_bytes(),
+            indices_flags: (0x04000002u32 | ((prefix[0] as u32) << 8) | ((prefix[1] as u32) << 16))
+                .to_le_bytes(),
+            ..Self::default()
+        })
+    }
+    pub(crate) fn bytes(&self) -> &[u8; 64] {
+        // SAFETY: Same byte-array layout invariant.
+        unsafe { &*core::ptr::from_ref(self).cast() }
+    }
+}
+const _: () = {
+    assert!(core::mem::size_of::<MaintenanceG16C>() == 64);
+    assert!(core::mem::align_of::<MaintenanceG16C>() == 1);
+    assert!(core::mem::offset_of!(MaintenanceG16C, opcode) == 0);
+    assert!(core::mem::offset_of!(MaintenanceG16C, engine) == 4);
+    assert!(core::mem::offset_of!(MaintenanceG16C, phase) == 8);
+    assert!(core::mem::offset_of!(MaintenanceG16C, reserved) == 12);
+    assert!(core::mem::size_of::<LifetimeTickG16C>() == 64);
+    assert!(core::mem::align_of::<LifetimeTickG16C>() == 1);
+    assert!(core::mem::offset_of!(LifetimeTickG16C, opcode) == 0);
+    assert!(core::mem::offset_of!(LifetimeTickG16C, reserved) == 4);
+    assert!(core::mem::size_of::<ContextCloseG16C>() == 64);
+    assert!(core::mem::align_of::<ContextCloseG16C>() == 1);
+    assert!(core::mem::offset_of!(ContextCloseG16C, opcode) == 0);
+    assert!(core::mem::offset_of!(ContextCloseG16C, reserved_04) == 4);
+    assert!(core::mem::offset_of!(ContextCloseG16C, indices_flags) == 8);
+    assert!(core::mem::offset_of!(ContextCloseG16C, context) == 12);
+    assert!(core::mem::offset_of!(ContextCloseG16C, reserved_14) == 20);
+};
diff --git a/drivers/gpu/drm/asahi/scheduled_mmio.rs b/drivers/gpu/drm/asahi/scheduled_mmio.rs
new file mode 100644
index 0000000000000..cbae8d0009ece
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_mmio.rs
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! G16C register configuration and firmware device mappings.
+//! Like Asahi's SoC IOMapping tables, fixed apertures belong to the hardware
+//! profile. m1n1 supplies the interrupt and MCC selection as typed FDT cells.
+//! Linux never interprets raw ADT data here.
+
+use super::scheduled_initdata::MmioRegion;
+use kernel::{c_str, of, prelude::*};
+
+const PAGE: u64 = 0x4000;
+const SGX: u64 = 0x288000000;
+const REGISTER_BASE: u64 = 0xfffffc2180200000;
+const REGISTER_LIMIT: u64 = 0xfffffc2181000000;
+const REGISTERS: usize = 25;
+const MAX_MAPPINGS: usize = 60;
+const MCC_BASE: u64 = 0x2201c4000;
+const MCC_SIZE: u64 = 0x18000;
+
+#[derive(Clone, Copy, Default)]
+pub(crate) struct Mapping {
+    pub(crate) address: u64,
+    pub(crate) physical: u64,
+    pub(crate) size: usize,
+    pub(crate) pte_flags: u64,
+}
+
+pub(crate) struct MmioG16C {
+    registers: [(usize, MmioRegion); REGISTERS],
+    mappings: [Mapping; MAX_MAPPINGS],
+    count: usize,
+}
+
+// SAFETY: Only integer/byte-array records and a zero count; no pointers,
+// references or destructors. A zero image is valid empty CPU staging.
+unsafe impl Zeroable for MmioG16C {}
+
+impl MmioG16C {
+    pub(crate) fn from_fdt(node: &of::Node) -> Result<Self> {
+        Self::build(
+            node.get_property(c_str!("apple,firmware-sw-interrupt"))?,
+            node.get_property(c_str!("apple,active-mcc-mask"))?,
+        )
+    }
+
+    pub(crate) fn from_fdt_boxed(node: &of::Node) -> Result<KBox<Self>> {
+        let mut out = KBox::init(Self::init_zeroed(), GFP_KERNEL)?;
+        out.populate(
+            node.get_property(c_str!("apple,firmware-sw-interrupt"))?,
+            node.get_property(c_str!("apple,active-mcc-mask"))?,
+        )?;
+        Ok(out)
+    }
+
+    fn build(software_interrupt: u64, mcc_mask: u32) -> Result<Self> {
+        let mut out = Self::zeroed();
+        out.populate(software_interrupt, mcc_mask)?;
+        Ok(out)
+    }
+
+    fn populate(&mut self, software_interrupt: u64, mcc_mask: u32) -> Result {
+        if !(PAGE..1 << 48).contains(&software_interrupt) || mcc_mask == 0 {
+            return Err(EINVAL);
+        }
+        let first_mcc = MCC_BASE + ((mcc_mask.trailing_zeros() as u64) << 25);
+        // slot, first PA, total bytes, element size, SGX-relative offset, access.
+        // Slots 3 and 20 are strided physical arrays, not flat MMIO apertures.
+        let rows: [(usize, u64, u64, u64, u64, u32); REGISTERS] = [
+            (0, software_interrupt & !(PAGE - 1), PAGE, PAGE, 0, 2),
+            (
+                3,
+                first_mcc,
+                mcc_mask.count_ones() as u64 * MCC_SIZE,
+                MCC_SIZE,
+                0,
+                2,
+            ),
+            (4, 0x50244c000, PAGE, PAGE, 0, 0),
+            (9, 0x5003d0000, PAGE, PAGE, 0, 2),
+            (10, 0x5003c0000, PAGE, PAGE, 0, 0),
+            (11, 0x5003d8000, PAGE, PAGE, 0, 2),
+            (12, 0x48565c000, PAGE, PAGE, 0, 2),
+            (14, 0x500400000, 0x10000, 0x10000, 0, 0),
+            (15, 0x50cdc0000, PAGE, PAGE, 0, 0),
+            (17, SGX, 0x21400, 0x21400, 0, 2),
+            (20, SGX + 0x3000000, 0x100000, 0x40000, 0, 2),
+            (22, SGX + 0x1000000, 0x8000, 0x8000, 0, 2),
+            (26, SGX + 0xd04000, 0x8000, 0x8000, 0xd04000, 2),
+            (28, SGX + 0xd58000, 0x8000, 0x8000, 0xd58000, 2),
+            (29, SGX + 0xd10000, PAGE, PAGE, 0xd10000, 2),
+            (31, SGX + 0xd40000, PAGE, PAGE, 0xd40000, 2),
+            (32, SGX + 0xd60000, 0x20000, 0x20000, 0xd60000, 2),
+            (33, SGX + 0xd44000, PAGE, PAGE, 0xd44000, 2),
+            (34, SGX + 0xd4c000, 0x200, 0x200, 0xd4c000, 2),
+            (35, SGX + 0xe00000, PAGE, PAGE, 0xe00000, 2),
+            (37, SGX + 0xe40000, PAGE, PAGE, 0xe40000, 2),
+            (39, SGX + 0xe08000, 0x8000, 0x8000, 0, 2),
+            (40, SGX + 0xe1c000, PAGE, PAGE, 0xe1c000, 2),
+            (41, SGX + 0xe1f800, PAGE, PAGE, 0, 2),
+            (43, SGX + 0xe60000, 0x58, 0x58, 0xe60000, 2),
+        ];
+        let mut cursor = REGISTER_BASE;
+        for (index, (slot, physical, size, stride, relative, flags)) in rows.into_iter().enumerate()
+        {
+            let offset = physical & (PAGE - 1);
+            let address = cursor + offset;
+            self.registers[index] = (
+                slot,
+                MmioRegion {
+                    physical: physical.to_le_bytes(),
+                    address: address.to_le_bytes(),
+                    size: (size as u32).to_le_bytes(),
+                    stride: (stride as u32).to_le_bytes(),
+                    relative: relative.to_le_bytes(),
+                    flags: (flags as u32).to_le_bytes(),
+                    ..Default::default()
+                },
+            );
+            let pte_flags = if flags & 2 != 0 {
+                0x00c0_0000_0000_0447
+            } else {
+                0x0080_0000_0000_0447
+            };
+            if slot == 3 {
+                let mut window = 0;
+                for bit in 0..32 {
+                    if mcc_mask & (1 << bit) != 0 {
+                        self.push(
+                            address + window * MCC_SIZE,
+                            MCC_BASE + ((bit as u64) << 25),
+                            MCC_SIZE,
+                            pte_flags,
+                        )?;
+                        window += 1;
+                    }
+                }
+            } else if slot == 20 {
+                for cluster in 0..4 {
+                    self.push(
+                        address + cluster * stride,
+                        physical + cluster * 0x200000,
+                        stride,
+                        pte_flags,
+                    )?;
+                }
+            } else {
+                self.push(
+                    cursor,
+                    physical - offset,
+                    (offset + size + PAGE - 1) & !(PAGE - 1),
+                    pte_flags,
+                )?;
+            }
+            cursor += ((offset + size + PAGE - 1) & !(PAGE - 1)) + PAGE;
+        }
+        if cursor > REGISTER_LIMIT {
+            return Err(EINVAL);
+        }
+        // Hardware status is a separate shared-NC alias of slot 32's aperture.
+        // Only install PTEs: never CPU-map or zero these bytes as RAM.
+        self.push(
+            0xfffffc218100c000,
+            SGX + 0xd60000,
+            0x20000,
+            0x00c0_0000_0000_044b,
+        )?;
+        Ok(())
+    }
+
+    fn push(&mut self, address: u64, physical: u64, size: u64, pte_flags: u64) -> Result {
+        let slot = self.mappings.get_mut(self.count).ok_or(EINVAL)?;
+        *slot = Mapping {
+            address,
+            physical,
+            size: size.try_into()?,
+            pte_flags,
+        };
+        self.count += 1;
+        Ok(())
+    }
+
+    pub(crate) fn registers(&self) -> &[(usize, MmioRegion)] {
+        &self.registers
+    }
+    pub(crate) fn mappings(&self) -> &[Mapping] {
+        &self.mappings[..self.count]
+    }
+}
diff --git a/drivers/gpu/drm/asahi/scheduled_operand_runtime.rs b/drivers/gpu/drm/asahi/scheduled_operand_runtime.rs
new file mode 100644
index 0000000000000..81d3c089cd621
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_operand_runtime.rs
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! Quiescent source-owned compute FList extension. Never rewrite the live
+//! directory, dispatch cursors or firmware support counters from the CPU.
+
+use super::*;
+use super::super::super::g17p_render::admission::RegistrationG16C;
+
+fn low_bytes(memory:&Memory,root:&UserVm,address:u64,data:&mut [u8])->Result {
+    let mut offset=0;
+    while offset<data.len() {
+        let va=address+offset as u64;
+        let pa=root.pte(va & !(PAGE-1))? & ADDRESS;
+        if pa==0 {return Err(EIO);}
+        let within=(va & (PAGE-1)) as usize;
+        let n=(PAGE as usize-within).min(data.len()-offset);
+        memory.read_firmware_words(pa+within as u64,&mut data[offset..offset+n])?;
+        offset+=n;
+    }
+    Ok(())
+}
+impl State {
+    /// Read only our owned scratch DATA, with no executable GPU user. Sampling
+    /// is opt-in and never writes a live pool or follows firmware pointers.
+    fn sample_operands(&self,session:&Session,index:usize,seed:bool)->Result {
+        let memory=session.memory.as_ref().ok_or(EIO)?;
+        self.growth_roots(memory,session.ttbs,index)?;
+        let o=&self.owners[index];
+        let root=&o.client.as_ref().ok_or(EIO)?.root;
+        let mut data=bytes(PAGE as usize)?;
+        let mut changed=0;
+        let mut sampled=0;
+        for (buffer,base) in o.operand_buffers.iter().enumerate().skip(operands::INITIAL_BUFFERS as usize) {
+            for offset in [0,operands::BUFFER_SIZE/2,operands::BUFFER_SIZE-PAGE] {
+                let address=o.directory+base+offset;
+                low_bytes(memory,root,address,&mut data)?;
+                let nonzero=data.iter().filter(|&&v|v!=0).count();
+                sampled+=1;
+                if seed && nonzero!=0 {return Err(EIO);}
+                if nonzero!=0 {
+                    changed+=1;
+                    let hash=data.iter().fold(0xcbf29ce484222325u64,|h,&v|(h^u64::from(v)).wrapping_mul(0x100000001b3));
+                    let mut head=[0u64;8];
+                    for (i,word) in head.iter_mut().enumerate() {*word=u64::from_le_bytes(data[i*8..i*8+8].try_into().unwrap());}
+                    kernel::dev_info!(session.peers[0].data.dev.as_ref(),
+                        "G16C: operand sample context={} buffer={} offset={:#x} nonzero={} fnv={:016x} head={:016x?} address={:#x}\n",
+                        o.context,buffer,offset,nonzero,hash,head,address);
+                }
+            }
+        }
+        kernel::dev_info!(session.peers[0].data.dev.as_ref(),
+            "G16C: operand probe context={} phase={} buffers={} pages={} changed={} GPU_idle=1\n",
+            o.context,if seed {"seed"} else {"retired"},o.operand_buffers.len(),sampled,changed);
+        Ok(())
+    }
+    pub(super) fn seed_operand_probe(&mut self,session:&Session,index:usize)->Result {
+        if crate::module_parameters::g16c_operand_probe.value()==0
+            || self.owners[index].operand_probe_seeded
+            || self.owners[index].operand_buffers.len()<=operands::INITIAL_BUFFERS as usize {return Ok(());}
+        if session.live_render_count()!=0 {return Err(EBUSY);}
+        self.sample_operands(session,index,true)?;
+        self.owners[index].operand_probe_seeded=true;
+        Ok(())
+    }
+    pub(super) fn retire_operand_probe(&mut self,session:&Session)->Result {
+        if crate::module_parameters::g16c_operand_probe.value()==0 {return Ok(());}
+        // Several immutable owners can retire in this idle interval. Sample
+        // every seeded pending pool, not just the last submitted ASID.
+        for index in 0..self.owners.len() {
+            let o=&self.owners[index];
+            if !o.operand_probe_pending || !o.operand_probe_seeded {continue;}
+            self.sample_operands(session,index,false)?;
+            self.owners[index].operand_probe_pending=false;
+        }
+        Ok(())
+    }
+    pub(super) fn grow_operands(&mut self,session:&mut Session,index:usize,total:u32)->StageResult<()> {
+        if !session.retained_render_idle() || self.selected!=Some(index) {return Err(EBUSY.into());}
+        self.growth_roots(session.memory.as_ref().ok_or(EIO)?,session.ttbs,index)?;
+        let o=&mut self.owners[index];
+        let previous=u32::try_from(o.operand_buffers.len())?;
+        if total<=previous || total>1024 {return Err(EINVAL.into());}
+        let added=total-previous;
+        let table=o.directory+operands::DIRECTORY_SIZE+2*PAGE;
+        let base=o.private_next;
+        let end=base.checked_add(u64::from(added)*operands::BUFFER_STRIDE).ok_or(EOVERFLOW)?;
+        if end>o.private_limit {return Err(StageError::Rejected(ENOSPC));}
+        // Construct the receipt before publication. The support/table/context
+        // tuple and previous end own the reply; a generic kind13 is not enough.
+        let bank=DispatchStateG16C::bank_for_context(o.context).ok_or(EINVAL)?;
+        let registration=RegistrationG16C {context:u32::from(o.context),support:o.support,
+            table,added,previous,bank,tag:1};
+        registration.prepare().map_err(|_|EINVAL)?;
+        let memory=session.memory.as_mut().ok_or(EIO)?;
+        let vm=session.vm.as_ref().ok_or(EIO)?;
+        let cursors=boot::control_cursors(memory,vm)?;
+        if cursors!=[cursors[0];3] {return Err(EBUSY.into());}
+        for (i,flags) in [PRIVATE,SHARED].into_iter().enumerate() {
+            if vm.pte(memory,2,o.support+i as u64*PAGE)?!=o.support_pages[i]|flags {return Err(EIO.into());}
+        }
+        let mut header=[0u8;0x100];
+        memory.read_firmware_words(o.support_pages[0],&mut header)?;
+        let word=|at|u32::from_le_bytes(header[at..at+4].try_into().unwrap());
+        let ptr=|at|u64::from_le_bytes(header[at..at+8].try_into().unwrap());
+        if word(0x10)!=2 || ptr(0x14)!=o.directory || ptr(0x30)!=table || word(0x48)!=previous*8 {
+            return Err(EIO.into());
+        }
+        let root=&mut o.client.as_mut().ok_or(EIO)?.root;
+        let mut prefix=bytes(previous as usize*64).map_err(StageError::allocation)?;
+        low_bytes(memory,root,table,&mut prefix)?;
+        let mut expected=bytes(prefix.len()).map_err(StageError::allocation)?;
+        for (i,offset) in o.operand_buffers.iter().enumerate() {
+            expected[i*64..i*64+8].copy_from_slice(&(o.directory+offset|1<<63).to_le_bytes());
+        }
+        if prefix!=expected {return Err(EIO.into());}
+        let mut tail=bytes(added as usize*64).map_err(StageError::allocation)?;
+        o.operand_buffers.reserve(added as usize,GFP_KERNEL).map_err(StageError::allocation)?;
+        // No owner extents, root leaves, table entries or firmware producers
+        // change until ALL backing exists. An allocation failure drops this
+        // detached heap, including chunks from earlier buffers in this attempt.
+        let mut detached=Memory::detached();
+        let mut blocks=KVec::new();
+        for i in 0..added {
+            let fail_after=crate::module_parameters::g16c_operand_alloc_fail_after.value();
+            if !self.operand_allocation_faulted && fail_after==i {
+                self.operand_allocation_faulted=true;
+                let (count,bytes)=detached.allocation_stats();
+                kernel::dev_info!(session.peers[0].data.dev.as_ref(),
+                    "G16C: injected unpublished operand ENOMEM staged_buffers={} allocations={} bytes={}\n",
+                    i,count,bytes);
+                return Err(StageError::Rejected(ENOMEM));
+            }
+            let address=base+u64::from(i)*operands::BUFFER_STRIDE;
+            private_span(&mut detached,&mut blocks,address-o.directory,operands::BUFFER_SIZE)
+                .map_err(StageError::allocation)?;
+            tail[i as usize*64..i as usize*64+8].copy_from_slice(&(address|1<<63).to_le_bytes());
+        }
+        o.private.reserve(blocks.len(),GFP_KERNEL).map_err(StageError::allocation)?;
+        memory.absorb(detached).map_err(StageError::allocation)?;
+        let first=o.private.len();
+        for block in blocks {
+            o.private.push(block,GFP_KERNEL).expect("reserved unpublished operand backing");
+        }
+        // From this point, an error is fatal and all backing remains retained.
+        // In particular, ENOMEM from root mapping is not a benign rejection.
+        map_private(memory,root,o.directory,&o.private[first..])?;
+        let mut offset=0;
+        while offset<tail.len() {
+            let va=table+u64::from(previous)*64+offset as u64;
+            let pa=root.pte(va & !(PAGE-1))? & ADDRESS;
+            if pa==0 {return Err(EIO.into());}
+            let within=(va & (PAGE-1)) as usize;
+            let n=(PAGE as usize-within).min(tail.len()-offset);
+            memory.write(pa+within as u64,&tail[offset..offset+n])?;
+            memory.clean(pa+within as u64,n)?;
+            offset+=n;
+        }
+        let mut unchanged=bytes(prefix.len())?;
+        low_bytes(memory,root,table,&mut unchanged)?;
+        let mut unchanged_header=[0u8;0x100];
+        memory.read_firmware_words(o.support_pages[0],&mut unchanged_header)?;
+        if unchanged!=prefix || unchanged_header!=header {return Err(EIO.into());}
+        UserVm::invalidate(o.context);
+        Vm::invalidate_gpu();
+        super::super::super::g17p_memory::sync();
+        let support=o.support;let context=o.context;
+        self.growth_roots(session.memory.as_ref().ok_or(EIO)?,session.ttbs,index)?;
+        session.g16c_register_flist(&registration)?;
+        // RX and all control cursors retiring do not prove applied capacity.
+        session.g16c_wait(|memory,vm| {
+            let count=memory.read_firmware32(vm.physical(memory,2,support+0x48)?)?;
+            if count==total*8 {Ok(true)} else if count==previous*8 {Ok(false)} else {Err(EIO)}
+        })?;
+        let o=&mut self.owners[index];
+        for i in 0..added {
+            o.operand_buffers.push(base+u64::from(i)*operands::BUFFER_STRIDE-o.directory,GFP_KERNEL)?;
+        }
+        o.private_next=end;
+        o.operand_probe_seeded=false;
+        kernel::dev_info!(session.peers[0].data.dev.as_ref(),
+            "G16C: owned operand growth context={} buffers={}->{} appended DATA only, FList reply/control/applied count retired\n",
+            context,previous,total);
+        Ok(())
+    }
+}
diff --git a/drivers/gpu/drm/asahi/scheduled_operands.rs b/drivers/gpu/drm/asahi/scheduled_operands.rs
new file mode 100644
index 0000000000000..3ad8f322cbe85
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_operands.rs
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! G16C compute FList metadata. These are staging bytes, never live references.
+
+pub(crate) const PAGE: usize = 0x4000;
+pub(crate) const DIRECTORY_SIZE: u64 = 0x1000000;
+pub(crate) const TABLE_SIZE: u64 = 0x10000;
+pub(crate) const BUFFER_SIZE: u64 = 0x800000;
+pub(crate) const BUFFER_STRIDE: u64 = 0x808000;
+pub(crate) const INITIAL_BUFFERS: u32 = 20;
+
+#[repr(C)]
+pub(crate) struct ComputeSupportG16C {
+    header: [u8; 4],
+    pad_04: [u8; 4],
+    active: [u8; 4],
+    pad_0c: [u8; 4],
+    resource_class: [u8; 4],
+    directory: [u8; 8],
+    capacity: [u8; 4],
+    pad_20: [u8; 4],
+    registered_pages: [u8; 4],
+    notify: [u8; 4],
+    available_pages: [u8; 4],
+    table: [u8; 8],
+    pad_38: [u8; 8],
+    field_40: [u8; 4],
+    pad_44: [u8; 4],
+    entries: [u8; 4],
+    auxiliary: [u8; 8],
+    pad_54: [u8; 8],
+    field_5c: [u8; 4],
+    kind: [u8; 4],
+}
+impl Default for ComputeSupportG16C {
+    fn default() -> Self {
+        // SAFETY: All fields are initialized byte arrays, with no padding.
+        let mut value: Self = unsafe { core::mem::zeroed() };
+        value.header = 1u32.to_le_bytes();
+        value.resource_class = 2u32.to_le_bytes();
+        value.capacity = (DIRECTORY_SIZE as u32 / 8).to_le_bytes();
+        value.field_40 = 4u32.to_le_bytes();
+        value.field_5c = 1u32.to_le_bytes();
+        value.kind = 2u32.to_le_bytes();
+        value
+    }
+}
+impl ComputeSupportG16C {
+    pub(crate) fn for_render(directory:u64,table:u64,auxiliary:u64,
+                            allocated:u32,registered:u32,entries:u32)->Option<Self>{
+        if registered>entries || entries>allocated {return None;}
+        let mut raw=Self::new(directory,table,auxiliary,allocated)?;
+        raw.registered_pages=(registered*2048).to_le_bytes();
+        raw.available_pages=raw.registered_pages;
+        raw.entries=(entries*8).to_le_bytes();
+        raw.field_5c=[0;4];
+        raw.kind=4u32.to_le_bytes();
+        Some(raw)
+    }
+    pub(crate) fn new(directory: u64, table: u64, auxiliary: u64, count: u32) -> Option<Self> {
+        if count == 0
+            || count > 1024
+            || [directory, table, auxiliary].contains(&0)
+            || (directory | table | auxiliary) & (PAGE as u64 - 1) != 0
+            || directory.checked_add(DIRECTORY_SIZE)? > 1 << 42
+            || table.checked_add(TABLE_SIZE)? > 1 << 42
+        {
+            return None;
+        }
+        Some(Self {
+            directory: directory.to_le_bytes(),
+            table: table.to_le_bytes(),
+            auxiliary: auxiliary.to_le_bytes(),
+            registered_pages: (count * 2048).to_le_bytes(),
+            available_pages: (count * 2048).to_le_bytes(),
+            entries: (count * 8).to_le_bytes(),
+            ..Self::default()
+        })
+    }
+    pub(crate) fn as_bytes(&self) -> &[u8] {
+        // SAFETY: Initialized byte arrays; size/alignment/offsets below.
+        unsafe { core::slice::from_raw_parts(core::ptr::from_ref(self).cast(), 0x64) }
+    }
+}
+pub(crate) type OperandSupportG16C=ComputeSupportG16C;
+const _: () = {
+    assert!(core::mem::size_of::<ComputeSupportG16C>() == 0x64);
+    assert!(core::mem::align_of::<ComputeSupportG16C>() == 1);
+    macro_rules! at {
+        ($f:ident,$o:expr) => {
+            assert!(core::mem::offset_of!(ComputeSupportG16C, $f) == $o);
+        };
+    }
+    at!(header, 0);
+    at!(pad_04, 4);
+    at!(active, 8);
+    at!(pad_0c, 0xc);
+    at!(resource_class, 0x10);
+    at!(directory, 0x14);
+    at!(capacity, 0x1c);
+    at!(pad_20, 0x20);
+    at!(registered_pages, 0x24);
+    at!(notify, 0x28);
+    at!(available_pages, 0x2c);
+    at!(table, 0x30);
+    at!(pad_38, 0x38);
+    at!(field_40, 0x40);
+    at!(pad_44, 0x44);
+    at!(entries, 0x48);
+    at!(auxiliary, 0x4c);
+    at!(pad_54, 0x54);
+    at!(field_5c, 0x5c);
+    at!(kind, 0x60);
+};
diff --git a/drivers/gpu/drm/asahi/scheduled_parameter_error.rs b/drivers/gpu/drm/asahi/scheduled_parameter_error.rs
new file mode 100644
index 0000000000000..90a11b1fe0767
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_parameter_error.rs
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! Max parameter-memory-limit report and reply. Opaque report words never
+//! supply ownership; the retained render and live descriptor do.
+//! OOM reports contain fixed words (0,1), not pool/context at +4/+8.
+//! Context is at +24; pool identity is the retained manager/descriptor graph.
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub(crate) struct ParameterErrorG16C {
+    kind: [u8;4],
+    reserved: [u8;4],
+    status: [u8;4],
+    event: [u8;4],
+    stamp: [u8;4],
+    opaque_14: [u8;4],
+    context: [u8;4],
+    opaque_1c: [u8;12],
+    descriptor: [u8;8],
+    manager: [u8;8],
+    queue: [u8;8],
+    opaque_40: [u8;8],
+}
+#[repr(C)]
+pub(crate) struct ParameterErrorReplyG16C {
+    kind: [u8;4],
+    success: [u8;4],
+    queue: [u8;8],
+    stamp: [u8;4],
+    pad: [u8;44],
+}
+const _: () = {
+    assert!(core::mem::size_of::<ParameterErrorG16C>()==0x48);
+    assert!(core::mem::align_of::<ParameterErrorG16C>()==1);
+    assert!(core::mem::offset_of!(ParameterErrorG16C,kind)==0);
+    assert!(core::mem::offset_of!(ParameterErrorG16C,reserved)==4);
+    assert!(core::mem::offset_of!(ParameterErrorG16C,status)==8);
+    assert!(core::mem::offset_of!(ParameterErrorG16C,event)==12);
+    assert!(core::mem::offset_of!(ParameterErrorG16C,stamp)==16);
+    assert!(core::mem::offset_of!(ParameterErrorG16C,opaque_14)==20);
+    assert!(core::mem::offset_of!(ParameterErrorG16C,context)==24);
+    assert!(core::mem::offset_of!(ParameterErrorG16C,opaque_1c)==28);
+    assert!(core::mem::offset_of!(ParameterErrorG16C,descriptor)==40);
+    assert!(core::mem::offset_of!(ParameterErrorG16C,manager)==48);
+    assert!(core::mem::offset_of!(ParameterErrorG16C,queue)==56);
+    assert!(core::mem::offset_of!(ParameterErrorG16C,opaque_40)==64);
+    assert!(core::mem::size_of::<ParameterErrorReplyG16C>()==64);
+    assert!(core::mem::align_of::<ParameterErrorReplyG16C>()==1);
+    assert!(core::mem::offset_of!(ParameterErrorReplyG16C,kind)==0);
+    assert!(core::mem::offset_of!(ParameterErrorReplyG16C,success)==4);
+    assert!(core::mem::offset_of!(ParameterErrorReplyG16C,queue)==8);
+    assert!(core::mem::offset_of!(ParameterErrorReplyG16C,stamp)==16);
+    assert!(core::mem::offset_of!(ParameterErrorReplyG16C,pad)==20);
+};
+impl Default for ParameterErrorReplyG16C {
+    fn default()->Self {
+        Self {kind:9u32.to_le_bytes(),success:1u32.to_le_bytes(),queue:[0;8],stamp:[0;4],pad:[0;44]}
+    }
+}
+impl ParameterErrorReplyG16C {
+    pub(crate) fn new(context:u32,queue:u64,stamp:u32)->Option<Self> {
+        if !(1..64).contains(&context) || queue<0xfffffc0000000000 || queue&7!=0 {return None;}
+        Some(Self {queue:queue.to_le_bytes(),
+            stamp:stamp.to_le_bytes(),..Default::default()})
+    }
+    pub(crate) fn bytes(&self)->&[u8;64] {
+        // SAFETY: Initialized byte arrays, no padding, exact layout above.
+        unsafe { &*core::ptr::from_ref(self).cast::<[u8;64]>() }
+    }
+}
+impl ParameterErrorG16C {
+    pub(crate) fn parse(raw:&[u8;0x48])->Option<Self> {
+        // SAFETY: Initialized byte arrays, alignment one, exact size above.
+        let request=unsafe {raw.as_ptr().cast::<Self>().read()};
+        (u32::from_le_bytes(request.kind)==7
+            && u32::from_le_bytes(request.reserved)==0 && u32::from_le_bytes(request.status)==1
+            && (1..64).contains(&request.context())).then_some(request)
+    }
+    pub(crate) fn context(&self)->u32 {u32::from_le_bytes(self.context)}
+    pub(crate) fn event(&self)->u32 {u32::from_le_bytes(self.event)}
+    pub(crate) fn stamp(&self)->u32 {u32::from_le_bytes(self.stamp)}
+    pub(crate) fn reply(&self)->Option<ParameterErrorReplyG16C> {
+        ParameterErrorReplyG16C::new(self.context(),u64::from_le_bytes(self.queue),self.stamp())
+    }
+}
+
+/// Host publication identity, captured before exposing either producer.
+#[derive(Clone, Copy)]
+pub(crate) struct RenderOwnerG16C {
+    pub(crate) context:u32,
+    pub(crate) slot:u32,
+    pub(crate) event:u32,
+    pub(crate) stamp:u32,
+    pub(crate) descriptor:u64,
+    pub(crate) manager:u64,
+    pub(crate) queue:u64,
+    pub(crate) driver_stamps:[u64;2],
+}
+impl RenderOwnerG16C {
+    pub(crate) fn matches_request(&self,request:&ParameterErrorG16C)->bool {
+        request.context()==self.context
+            && request.event()==self.event && request.stamp()==self.stamp
+            && u64::from_le_bytes(request.descriptor)==self.descriptor
+            && u64::from_le_bytes(request.manager)==self.manager
+            && u64::from_le_bytes(request.queue)==self.queue
+    }
+    pub(crate) fn matches(&self,request:&ParameterErrorG16C,body:&[u8])->bool {
+        if body.len()!=0x2240 {return false;}
+        let word=|at|u32::from_le_bytes(body[at..at+4].try_into().unwrap());
+        let pointer=|at|u64::from_le_bytes(body[at..at+8].try_into().unwrap());
+        self.matches_request(request) && word(0)==1 && word(0xc)==self.context && pointer(0x28)==self.manager
+            && pointer(0x2140)==self.driver_stamps[1]
+            && word(0x2150)==self.stamp && word(0x2154)==self.event
+    }
+}
diff --git a/drivers/gpu/drm/asahi/scheduled_parameter_growth.rs b/drivers/gpu/drm/asahi/scheduled_parameter_growth.rs
new file mode 100644
index 0000000000000..abb7c54cc8d59
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_parameter_growth.rs
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! Owned Max active parameter-buffer handshake. The first five reply words
+//! retain Neo's success/pool/VM/counter order. The extra RX word stays opaque.
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub(crate) struct GrowthRequestG16C {
+    kind: [u8; 4],
+    context: [u8; 4],
+    slot: [u8; 4],
+    token: [u8; 4],
+    context_word: [u8; 4],
+    opaque: [u8; 0x34],
+}
+#[repr(C)]
+pub(crate) struct GrowthReplyG16C {
+    kind: [u8; 4],
+    success: [u8; 4],
+    slot: [u8; 4],
+    context: [u8; 4],
+    token: [u8; 4],
+    context_word: [u8; 4],
+    pad: [u8; 40],
+}
+const _: () = {
+    assert!(core::mem::size_of::<GrowthRequestG16C>() == 0x48);
+    assert!(core::mem::align_of::<GrowthRequestG16C>() == 1);
+    assert!(core::mem::offset_of!(GrowthRequestG16C, kind) == 0);
+    assert!(core::mem::offset_of!(GrowthRequestG16C, context) == 4);
+    assert!(core::mem::offset_of!(GrowthRequestG16C, slot) == 8);
+    assert!(core::mem::offset_of!(GrowthRequestG16C, token) == 12);
+    assert!(core::mem::offset_of!(GrowthRequestG16C, context_word) == 16);
+    assert!(core::mem::offset_of!(GrowthRequestG16C, opaque) == 20);
+    assert!(core::mem::size_of::<GrowthReplyG16C>() == 64);
+    assert!(core::mem::align_of::<GrowthReplyG16C>() == 1);
+    assert!(core::mem::offset_of!(GrowthReplyG16C, kind) == 0);
+    assert!(core::mem::offset_of!(GrowthReplyG16C, success) == 4);
+    assert!(core::mem::offset_of!(GrowthReplyG16C, slot) == 8);
+    assert!(core::mem::offset_of!(GrowthReplyG16C, context) == 12);
+    assert!(core::mem::offset_of!(GrowthReplyG16C, token) == 16);
+    assert!(core::mem::offset_of!(GrowthReplyG16C, context_word) == 20);
+    assert!(core::mem::offset_of!(GrowthReplyG16C, pad) == 24);
+};
+impl Default for GrowthReplyG16C {
+    fn default() -> Self {
+        Self { kind: 8u32.to_le_bytes(), success: 1u32.to_le_bytes(), slot: [0;4],
+            context: [0;4], token: [0;4], context_word: [0;4], pad: [0;40] }
+    }
+}
+impl GrowthRequestG16C {
+    pub(crate) fn parse(raw: &[u8; 0x48]) -> Option<Self> {
+        // SAFETY: Every field is an initialized byte array, alignment one.
+        let request = unsafe { raw.as_ptr().cast::<Self>().read() };
+        (u32::from_le_bytes(request.kind) == 6
+            && (1..64).contains(&request.context()) && request.slot() < 15).then_some(request)
+    }
+    pub(crate) fn context(&self) -> u32 { u32::from_le_bytes(self.context) }
+    pub(crate) fn slot(&self) -> u32 { u32::from_le_bytes(self.slot) }
+    pub(crate) fn token(&self) -> u32 { u32::from_le_bytes(self.token) }
+    pub(crate) fn reply(&self, generation: u32) -> Option<GrowthReplyG16C> {
+        if generation == 0 { return None; }
+        // Generation validates retained ownership; it is not the VM word.
+        // Context1/generation1 captures cannot distinguish these fields.
+        Some(GrowthReplyG16C { context: self.context, slot: self.slot,
+            token: self.token,
+            context_word: self.context_word, ..Default::default() })
+    }
+}
+impl GrowthReplyG16C {
+    pub(crate) fn bytes(&self) -> &[u8;64] {
+        // SAFETY: All bytes initialized, no padding, exact size asserted above.
+        unsafe { &*(core::ptr::from_ref(self).cast::<[u8;64]>()) }
+    }
+}
+
+/// Check firmware-updated DATA against the retained backing owner. Active
+/// free-list ordering/holes are firmware-owned; foreign nonzero IDs are not.
+pub(crate) fn metadata_owned(p: &super::resources::ParameterBufferG16C, ids: &[u32],
+    manager: &[u8;0x88], control: &[u8;0x80], counter: u32, region: &[u8;16],
+    pages: &[u8], blocks: &[u8]) -> bool {
+    use super::resources::{ParameterDescriptorG16C, GPU_PAGE_LIST, MAX_BLOCKS, PAGE_LIST_SIZE};
+    let word = |raw: &[u8], at: usize| u32::from_le_bytes(raw[at..at+4].try_into().unwrap());
+    if p.validate().is_err() || ids.len() != p.blocks as usize || counter == 0
+        || pages.len() != PAGE_LIST_SIZE || blocks.len() != ids.len()*8
+        || ids.first().is_none_or(|id| *id == 0)
+        || ids.windows(2).any(|v| v[0].checked_add(4).is_none_or(|end| end > v[1]))
+        || ids.last().is_some_and(|id| id.checked_add(3).is_none())
+        || word(manager,0xc) != p.slot || word(manager,0x34) != p.blocks*4
+        || word(manager,0x38) != MAX_BLOCKS || word(manager,0x3c) != p.blocks
+        || word(manager,0x54) >= p.blocks*4
+        || word(control,0) != p.blocks || word(control,4) != p.blocks
+        || word(control,0x60) > 1 { return false; }
+    for (at, pointer) in [(0x20,p.page_list),(0x44,p.block_list),
+        (0x4c,p.block_control),(0x64,p.counter)] {
+        if u64::from_le_bytes(manager[at..at+8].try_into().unwrap()) != pointer { return false; }
+    }
+    let Ok(descriptor) = ParameterDescriptorG16C::new(GPU_PAGE_LIST,p.blocks*4) else { return false; };
+    if word(region,0)&!1 != word(descriptor.bytes(),0) || region[4..8] != descriptor.bytes()[4..8] {
+        return false;
+    }
+    for (raw, id) in blocks.chunks_exact(8).zip(ids) {
+        if word(raw,0) != *id || word(raw,4) != 0 { return false; }
+    }
+    if pages[p.blocks as usize*16..].iter().any(|b| *b != 0) { return false; }
+    pages[..p.blocks as usize*16].chunks_exact(4).all(|raw| {
+        let value = word(raw,0);
+        value == 0 || ids.partition_point(|id| *id <= value).checked_sub(1)
+            .is_some_and(|index| value - ids[index] < 4)
+    })
+}
diff --git a/drivers/gpu/drm/asahi/scheduled_parameter_oom.rs b/drivers/gpu/drm/asahi/scheduled_parameter_oom.rs
new file mode 100644
index 0000000000000..b2cebd0eb614d
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_parameter_oom.rs
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! Owned Max OOM7 -> error9. Reply retirement does not complete the render:
+//! normal stamps/queues/channels must independently retire before ENOMEM.
+
+use super::*;
+use parameter_error::{ParameterErrorG16C,RenderOwnerG16C};
+use super::super::super::g17p_render::wire::FragmentDescriptorG16C;
+
+// Keep pure identity validation tied to the macro-generated actual layout.
+const _: () = {
+    assert!(core::mem::size_of::<FragmentDescriptorG16C>()==0x2240);
+    assert!(core::mem::offset_of!(FragmentDescriptorG16C,opcode)==0);
+    assert!(core::mem::offset_of!(FragmentDescriptorG16C,context)==0xc);
+    assert!(core::mem::offset_of!(FragmentDescriptorG16C,manager)==0x28);
+    assert!(core::mem::offset_of!(FragmentDescriptorG16C,driver_stamp)==0x2140);
+    assert!(core::mem::offset_of!(FragmentDescriptorG16C,stamp)==0x2150);
+    assert!(core::mem::offset_of!(FragmentDescriptorG16C,event)==0x2154);
+};
+pub(super) struct AcceptedError {
+    id:u64,
+    request:ParameterErrorG16C,
+    owner:RenderOwnerG16C,
+    before_driver:[u32;2],
+}
+pub(super) struct RepliedError {
+    pub(super) owner:RenderOwnerG16C,
+    pub(super) before_driver:[u32;2],
+}
+impl State {
+    pub(super) fn accept_parameter_error(&mut self,memory:&Memory,vm:&Vm,ttbs:u64,
+        pending:&[RenderTicket],raw:&[u8;0x48])->Result<AcceptedError> {
+        let request=ParameterErrorG16C::parse(raw).ok_or(EIO)?;
+        let index=RenderWave::<RenderTicket>::find_owner(pending,|p|
+            p.render_work.matches_request(&request))?;
+        let p=&pending[index];
+        if p.parameter_error.is_some()
+            || unsafe {bindings::dma_fence_get_status(p.receipt.fence.raw())}!=0 {return Err(EIO);}
+        let owner=p.render_work;
+        let oi=p.render_owner;
+        let o=self.owners.get(oi).ok_or(EIO)?;
+        let r=o.render.as_ref().ok_or(EIO)?;
+        if owner.context!=u32::from(o.context) || owner.slot!=r.parameter.slot
+            || owner.manager!=r.manager || !r.admitted()
+            || !self.queues.iter().any(|q|q.live && q.owner==oi && q.storage.lanes[1].queue==owner.queue) {
+            return Err(EIO);
+        }
+        self.growth_roots(memory,ttbs,oi)?;
+        let mut body=bytes(FragmentDescriptorG16C::SIZE)?;
+        boot::read_words(memory,vm,owner.descriptor,&mut body)?;
+        if !owner.matches(&request,&body) {return Err(EIO);}
+        let mut before_driver=[0;2];
+        for (value,address)in before_driver.iter_mut().zip(owner.driver_stamps) {
+            *value=memory.read_firmware32(vm.physical(memory,2,address)?)?;
+        }
+        Ok(AcceptedError {id:p.id,request,owner,before_driver})
+    }
+    pub(super) fn service_parameter_error(&mut self,session:&mut Session,pending:&mut [RenderTicket],accepted:AcceptedError)->Result {
+        let index=RenderWave::<RenderTicket>::find_owner(pending,|p|p.id==accepted.id)?;
+        let pending=&mut pending[index];
+        if pending.parameter_error.is_some() {return Err(EIO);}
+        let reply=accepted.request.reply().ok_or(EIO)?;
+        // The dispatcher has ACKed the validated RX slot before reaching here.
+        // Any control uncertainty returns an error and retains all owners.
+        session.g16c_work_control(reply.bytes())?;
+        pending.parameter_error=Some(RepliedError {owner:accepted.owner,before_driver:accepted.before_driver});
+        kernel::dev_info!(session.peers[0].data.dev.as_ref(),
+            "G16C: owned OOM7 context={} slot={} event={} stamp={} queue={:#x} error9 retired; waiting independent work retirement\n",
+            accepted.owner.context,accepted.owner.slot,accepted.owner.event,accepted.owner.stamp,accepted.owner.queue);
+        Ok(())
+    }
+}
diff --git a/drivers/gpu/drm/asahi/scheduled_parameter_runtime.rs b/drivers/gpu/drm/asahi/scheduled_parameter_runtime.rs
new file mode 100644
index 0000000000000..0f7964f8584cd
--- /dev/null
+++ b/drivers/gpu/drm/asahi/scheduled_parameter_runtime.rs
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! Owned active Max PB growth. The receive dispatcher validates ownership,
+//! ACKs once, then returns here; control waits never recursively service RX.
+
+use super::*;
+use super::super::super::g17p_render::growth::GrowthRequestG16C;
+
+pub(super) struct AcceptedGrowth {
+    request: GrowthRequestG16C,
+    owner: usize,
+    generation: u32,
+    first: bool,
+}
+impl State {
+    pub(super) fn growth_roots(&self,memory:&Memory,ttbs:u64,owner:usize)->Result {
+        let o=self.owners.get(owner).ok_or(EIO)?;
+        let root=&o.client.as_ref().ok_or(EIO)?.root;
+        if !o.published {return Err(EIO);}
+        let at=ttbs+u64::from(o.context)*16;
+        memory.invalidate(at,16)?;
+        if [memory.read64(at)?,memory.read64(at+8)?]
+            !=[root.root(),o.high_root].map(|p|p|u64::from(o.context)<<48|1) {return Err(EIO);}
+        Ok(())
+    }
+
+    pub(super) fn accept_growth(&mut self,memory:&Memory,vm:&Vm,ttbs:u64,
+        pending:&mut [RenderTicket],raw:&[u8;0x48])->Result<AcceptedGrowth> {
+        let request=GrowthRequestG16C::parse(raw).ok_or(EIO)?;
+        // The growth protocol names a retained context/pool. Never choose
+        // another flight merely because it is first in the retirement wave.
+        let index=RenderWave::<RenderTicket>::find_owner(pending,|p|
+            p.render_work.context==request.context() && p.render_work.slot==request.slot())?;
+        let p=&pending[index];
+        if p.parameter_error.is_some() || p.growth_tokens.contains(&request.token()) {
+            return Err(EIO);
+        }
+        let owner=p.render_owner;
+        let o=self.owners.get(owner).ok_or(EIO)?;
+        let r=o.render.as_ref().ok_or(EIO)?;
+        if request.context()!=u32::from(o.context) || request.slot()!=r.parameter.slot {
+            return Err(EIO);
+        }
+        self.growth_roots(memory,ttbs,owner)?;
+        let generation=r.growth_generation(memory,vm).map_err(|error|{
+            kernel::pr_err!("G16C: PB request metadata rejected context={} slot={} token={} blocks={}\n",request.context(),request.slot(),request.token(),r.parameter.blocks);error
+        })?;
+        if r.parameter.blocks==super::super::super::g17p_render::resources::MAX_BLOCKS {
+            return Err(ENOMEM);
+        }
+        let first=p.growth_tokens.is_empty();
+        // Reserve/retain before ACK. Tokens cannot be replayed in this flight.
+        pending[index].growth_tokens.push(request.token(),GFP_KERNEL)?;
+        Ok(AcceptedGrowth {request,owner,generation,first})
+    }
+
+    pub(super) fn service_growth(&mut self,session:&mut Session,accepted:AcceptedGrowth)->Result {
+        if accepted.first {
+            for engine in 0..3 {for phase in 1..=2 {
+                session.g16c_work_control(MaintenanceG16C::new(engine,phase).ok_or(EIO)?.bytes())?;
+            }}
+        }
+        self.growth_roots(session.memory.as_ref().ok_or(EIO)?,session.ttbs,accepted.owner)?;
+        let o=&mut self.owners[accepted.owner];
+        let r=o.render.as_mut().ok_or(EIO)?;
+        let (old,count)=r.grow(session.memory.as_mut().ok_or(EIO)?,session.vm.as_ref().ok_or(EIO)?,
+            &mut o.client.as_mut().ok_or(EIO)?.root,o.context,accepted.generation)?;
+        let reply=accepted.request.reply(accepted.generation).ok_or(EIO)?;
+        session.g16c_work_control(reply.bytes())?;
+        // Control retirement is independent of the firmware manager stores.
+        // Require the exact applied counts, bounded; defer any next request.
+        session.g16c_wait_growth_condition(|memory,vm|r.growth_applied(memory,vm,old))?;
+        // Growth is progress, not a submission deadline extension. The
+        // original pending.started bounds the entire render including growth.
+        kernel::dev_info!(session.peers[0].data.dev.as_ref(),
+            "G16C: owned PB growth context={} slot={} token={} generation={} blocks={}->{} preserved firmware DATA, reply retired\n",
+            o.context,r.parameter.slot,accepted.request.token(),accepted.generation,old,count);
+        Ok(())
+    }
+}
+impl Session {
+    pub(super) fn g16c_work_control(&mut self,record:&[u8;64])->Result {
+        let target=boot::publish_control(self.memory.as_mut().ok_or(EIO)?,
+            self.vm.as_ref().ok_or(EIO)?,record)?;
+        self.g16c_send(0x21,boot::CONTROL_MESSAGE)?;
+        self.g16c_send(0x21,0x0083000000000010)?;
+        self.g16c_wait_work_control(target)
+    }
+}
