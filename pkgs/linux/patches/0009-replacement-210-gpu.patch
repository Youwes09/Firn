+pub(crate) const SCHEDULERS: [(u64, u64, u32); 3] = [
+    (0xfffffc20c0820100, 0xfffffc20015f8004, 0),
+    (0xfffffc20c0828100, 0xfffffc2001600004, 1),
+    (0xfffffc20c0830100, 0xfffffc2001608004, 2),
+];
