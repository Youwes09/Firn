+    let mut out = [0; 0x80];
+    out[..0x60].copy_from_slice(&q::pointers(u32::MAX));
+    c::u32_at(&mut out, 0x60, 0x500);
+    out
+}
+pub(crate) fn channel_control() -> [u8; 0x40] {
+    let mut out = [0; 0x40];
+    for (at, value) in [
+        (0, 0x1000000ffff),
+        (0x20, 0x2000000000000),
+        (0x30, 0xff000000),
+    ] {
+        c::u64_at(&mut out, at, value);
+    }
+    out
+}
