+            let mut row = [0u8; 256];
+            for i in 0..32 {
+                row[i * 8..i * 8 + 8]
+                    .copy_from_slice(&crate::g16_fw::operand_page(first + i).to_le_bytes());
+            }
+            opening_client.write_low(0x70_0000_0000 + (first * 8) as u64, &row)?;
+        }
+        for (base, size) in compute::private_ranges() {
+            opening_client.alloc_low(base, size, crate::pgtable::prot::PROT_GPU_SHARED_RW)?;
+        }
+        for buffer in 0..compute::BUFFER_COUNT {
+            for first in (0..compute::BUFFER_SIZE / 0x1000).step_by(32) {
+                let mut row = [0; 256];
+                for i in 0..32 {
+                    let va = compute::BUFFER_BASE
+                        + buffer as u64 * compute::BUFFER_STRIDE
+                        + (first + i) as u64 * 0x1000;
+                    row[i * 8..i * 8 + 8].copy_from_slice(&va.to_le_bytes());
+                }
+                opening_client.write_low(
+                    compute::DIRECTORY
+                        + (buffer * (compute::BUFFER_SIZE / 0x1000) + first) as u64 * 8,
+                    &row,
+                )?;
+            }
+        }
+        firmware_space.write_live(compute::SUPPORT, &compute::support())?;
+        opening_client.sync();
+        dev_info!(
+            dev,
+            "G16: Linux-built root/main descriptors mapped at {:#x}; not yet published\n",
+            crate::g16_fw::ROOT_ADDRESS
+        );
+        let diagnostics = KBox::init(try_init!(Diagnostics {
+            wedge_since: None,
+            wedge_sampled: None,
+            wedge_signature: 0,
+            wedge_reported: false,
+            // Full capacity now: retirement logs without allocating.
+            retire_log: KVec::with_capacity(render_runtime::RETIRE_LOG, GFP_KERNEL)?,
+            retire_next: 0,
+            handovers: {
+                let mut v = KVec::new();
+                v.extend_with(64, None, GFP_KERNEL)?;
+                v
+            },
+            lane_events: KVec::new(),
+            stale_event_tags: 0,
+            stale_live_tags: 0,
+            stale_live_own_tags: 0,
+            dependency_waits: 0,
+            stale_recent: {
+                let mut v = KVec::new();
+                v.extend_with(64, (0, 0, 0, 0, 0, false), GFP_KERNEL)?;
+                v
+            },
+            stale_next: 0,
+            pressure_reported: core::sync::atomic::AtomicU64::new(0),
+            pressure_seen: core::sync::atomic::AtomicU64::new(0),
+            hold_key: core::sync::atomic::AtomicU64::new(0),
+            hold_since_ns: core::sync::atomic::AtomicI64::new(0),
+            hold_near_misses: core::sync::atomic::AtomicU32::new(0),
+        }), GFP_KERNEL)?;
+        let mut session = Self {
+            dev: pdev.into(),
+            notifications,
+            _rtkit: rtkit,
+            _asc: asc,
+            _sgx: sgx,
+            _handoff: handoff,
+            _address_space: Some(address_space),
+            _firmware_space: Some(firmware_space),
+            _opening_client: Some(opening_client),
+            timestamp_ranges: KVec::new(),
+            opening_notification_pending: true,
+            gpu_revision,
+            core_mask: platform.core_mask,
+            maximum_frequency_khz: platform.max_frequency() * 1000,
+            tvb_pools: KVec::new(),
+            encodings: render_runtime::Encodings::new()?,
+            render_publication: crate::module_parameters::fw_counter_start.value(),
+            diagnostics,
+            next_work_va: render_runtime::WORK_BASE,
+            next_object_va: render_runtime::OBJECT_BASE,
+            work_arenas: [0..0, 0..0],
+            free_work: [KVec::new(), KVec::new()],
+            work_slots: [0, 0],
+            job_notifiers: KVec::with_capacity(render_runtime::MAX_FLIGHTS, GFP_KERNEL)?,
+            poll_scan: false,
+            compute_publication: crate::module_parameters::fw_counter_start.value(),
+            queue_events: Arc::new(core::sync::atomic::AtomicU64::new(0), GFP_KERNEL)?,
+            retired_queues: Arc::pin_init(kernel::new_mutex!(KVec::new()), GFP_KERNEL)?,
+            last_scan: KBox::new(Default::default(), GFP_KERNEL)?,
+            queue_regions: 0,
+            destroying_queues: KVec::new(),
+            free_queues: KVec::new(),
+            render_failed: false,
+            flights: KVec::with_capacity(render_runtime::MAX_FLIGHTS, GFP_KERNEL)?,
+            retired: KVec::with_capacity(render_runtime::MAX_FLIGHTS, GFP_KERNEL)?,
+            publications: KVec::with_capacity(2 * render_runtime::MAX_FLIGHTS, GFP_KERNEL)?,
+            ledger: KBox::new(render_runtime::Ledger::with_capacity(render_runtime::MAX_FLIGHTS)?, GFP_KERNEL)?,
+            progress: None,
+            batch_works: 0,
+            context_roots: [None; 64],
+            context_users: [0; 64],
+            render_support: kernel::sync::Arc::new(
+                core::sync::atomic::AtomicU64::new(0),
+                GFP_KERNEL,
+            )?,
+        };
+        if crate::module_parameters::fw_trace.value() & 1 != 0 {
+            // Region C starts with the firmware KTrace mask, as in the shim.
+            session
+                ._firmware_space
+                .as_mut()
+                .ok_or(EIO)?
+                .write_live(0xffff_fc20_000f_8000, &u32::MAX.to_le_bytes())?;
+        }
+        session.publish(pdev)?;
+        session.open_control(pdev)?;
+        session.submit_barrier(pdev)?;
+        Ok(session)
+    }
+
+    fn submit_barrier(&mut self, pdev: &platform::Device<Core<'_>>) -> Result {
+        use crate::g16_fw::queue as q;
+        let dev = pdev.as_ref();
+        let firmware = self._firmware_space.as_mut().ok_or(EINVAL)?;
+        let sgx_guard = self._sgx.try_access().ok_or(ENODEV)?;
+        let sgx = &*sgx_guard;
+        for addr in [0xffff_fc20_0003_f190, 0xffff_fc20_0003_f198] {
+            firmware.write_live(addr, &0u32.to_le_bytes())?;
+        }
+        let before = (
+            sgx.as_view().relaxed().read32(0xd64040),
+            sgx.as_view().relaxed().read32(0xd64048),
+            sgx.as_view().relaxed().read32(0xd60020),
+        );
+        if before != (0, 0, 0) {
+            return Err(EBUSY);
+        }
+        // Pair-zero fragment channel, with two satisfied barrier items.
+        firmware.write_live(
+            crate::g16_fw::BUNDLE_ADDRESS + 0x16240,
+            &q::channel(BOOT_QUEUE, 2, 1, 1, true, 1),
+        )?;
+        sgx.as_view().relaxed().write32(1, 0xd60020);
+        crate::mem::sync();
+        drop(sgx_guard);
+        let mut committed = false;
+        for _ in 0..3000 {
+            let cursor = firmware.read_u32(crate::g16_fw::CONTROL_DATA + 0x48)?;
+            let aux = firmware.read_u32(crate::g16_fw::CONTROL_AUX)?;
+            if cursor == 20 * 8 && (aux == 0 || aux == 1) {
+                committed = true;
+                break;
+            }
+            kernel::time::delay::fsleep(kernel::time::Delta::from_millis(1));
+        }
+        if !committed {
+            dev_err!(
+                dev,
+                "G16: first-work registration stalled at {:#x}/{:#x}\n",
+                firmware.read_u32(crate::g16_fw::CONTROL_DATA + 0x48)?,
+                firmware.read_u32(crate::g16_fw::CONTROL_AUX)?
+            );
+            return Err(ETIMEDOUT);
+        }
+        self._rtkit
+            .as_mut()
+            .send_message(0x21, 0x0083_0000_0000_0001)?;
+        for _ in 0..3000 {
+            let sgx_guard = self._sgx.try_access().ok_or(ENODEV)?;
+            let sgx = &*sgx_guard;
+            if sgx.as_view().relaxed().read32(0xd64040) == 1
+                && sgx.as_view().relaxed().read32(0xd64048) == 1
+                && firmware.read_u32(BOOT_POINTERS + 0x30)? == 2
+            {
+                // Barriers consume the inner ring without advancing its
+                // separate completion cursor, as in the working source path.
+                dev_info!(dev, "G16: barrier channel retired; two items consumed\n");
+                return Ok(());
+            }
+            drop(sgx_guard);
+            kernel::time::delay::fsleep(kernel::time::Delta::from_millis(1));
+        }
+        let sgx_guard = self._sgx.try_access().ok_or(ENODEV)?;
+        let sgx = &*sgx_guard;
+        dev_err!(
+            dev,
+            "G16: barrier timeout; channel {}/{}/{} item done/read {}/{}\n",
+            sgx.as_view().relaxed().read32(0xd64040),
+            sgx.as_view().relaxed().read32(0xd64048),
+            sgx.as_view().relaxed().read32(0xd60020),
+            firmware.read_u32(BOOT_POINTERS)?,
+            firmware.read_u32(BOOT_POINTERS + 0x30)?
+        );
+        Err(ETIMEDOUT)
+    }
+
+    fn open_control(&mut self, pdev: &platform::Device<Core<'_>>) -> Result {
+        let dev = pdev.as_ref();
+        let firmware = self._firmware_space.as_mut().ok_or(EINVAL)?;
+        let client = self._opening_client.as_ref().ok_or(EINVAL)?;
+        let res = dev
+            .of_node()
+            .ok_or(EINVAL)?
+            .reserved_mem_region_to_resource_byname(c_str!("ttbs"))?;
+        // SAFETY: This is the loader's validated context table reservation.
+        let ttbs = unsafe { io::mem::Mem::try_new(res, io::mem::MemFlag::WB.into())? };
+        // SAFETY: Offsets 16 and 24 are context one's two roots, inside the
+        // mapped table page, and the cache clean covers that line.
+        unsafe {
+            // Context one has ASID one, with independently allocated roots.
+            ttbs.ptr()
+                .add(16)
+                .cast::<u64>()
+                .write_volatile(client.low.ttb() | (1 << 48) | 1);
+            ttbs.ptr()
+                .add(24)
+                .cast::<u64>()
+                .write_volatile(client.high.ttb() | (1 << 48) | 1);
+            core::arch::asm!("dc cvac, {addr}", addr = in(reg) ttbs.ptr());
+        }
+        crate::mem::sync();
+        firmware.alloc(
+            crate::g16_fw::CONTROL_DATA,
+            PAGE_SIZE as usize,
+            crate::pgtable::prot::PROT_FW_PRIV_RW,
+        )?;
+        firmware.alloc(
+            crate::g16_fw::CONTROL_AUX,
+            PAGE_SIZE as usize,
+            crate::pgtable::prot::PROT_FW_SHARED_RW,
+        )?;
+        firmware.write(crate::g16_fw::CONTROL_DATA, &crate::g16_fw::opening_flist())?;
+        // Own distinct shared pages for the mapping-notification state/ring.
+        firmware.alloc(
+            0xffff_fc21_8100_0000,
+            PAGE_SIZE as usize,
+            crate::pgtable::prot::PROT_FW_SHARED_RW,
+        )?;
+        firmware.alloc(
+            0xffff_fc21_8100_8000,
+            PAGE_SIZE as usize,
+            crate::pgtable::prot::PROT_FW_SHARED_RW,
+        )?;
+        firmware.sync();
+        firmware.write_live(
+            crate::g16_fw::BUNDLE_ADDRESS + 0x1df40,
+            &crate::g16_fw::opening_control(),
+        )?;
+        let sgx_guard = self._sgx.try_access().ok_or(ENODEV)?;
+        let sgx = &*sgx_guard;
+        let before = (
+            sgx.as_view().relaxed().read32(0xd640c0),
+            sgx.as_view().relaxed().read32(0xd640c8),
+            sgx.as_view().relaxed().read32(0xd60060),
+        );
+        if before != (1, 1, 1) {
+            dev_err!(dev, "G16: unexpected opening cursors {:?}\n", before);
+            return Err(EIO);
+        }
+        sgx.as_view().relaxed().write32(3, 0xd60060);
+        drop(sgx_guard);
+        for (address, value) in [
+            (0xffff_fc20_0003_4f88, 0xffff_fc21_8100_0000u64),
+            (0xffff_fc20_0003_4f90, 0xffff_fc21_8100_8000u64),
+        ] {
+            firmware.write_live(address, &value.to_le_bytes())?;
+        }
+        firmware.write_live(0xffff_fc20_0003_4fd4, &1u32.to_le_bytes())?;
+        crate::mem::tlbi_asid(1);
+        crate::mem::sync();
+        kernel::time::delay::fsleep(kernel::time::Delta::from_millis(100));
+        self._rtkit
+            .as_mut()
+            .send_message(0x21, 0x0084_0000_0000_0011)?;
+        for _ in 0..3000 {
+            let sgx_guard = self._sgx.try_access().ok_or(ENODEV)?;
+            let sgx = &*sgx_guard;
+            let cursors = (
+                sgx.as_view().relaxed().read32(0xd640c0),
+                sgx.as_view().relaxed().read32(0xd640c8),
+                sgx.as_view().relaxed().read32(0xd60060),
+            );
+            if cursors == (3, 3, 3) && firmware.read_u32(0xffff_fc20_0003_f19c)? == 1 {
+                dev_info!(
+                    dev,
+                    "G16: opening control registration retired; cursors {:?}\n",
+                    cursors
+                );
+                return Ok(());
+            }
+            drop(sgx_guard);
+            kernel::time::delay::fsleep(kernel::time::Delta::from_millis(1));
+        }
+        let sgx_guard = self._sgx.try_access().ok_or(ENODEV)?;
+        let sgx = &*sgx_guard;
+        dev_err!(
+            dev,
+            "G16: control timeout; cursors {}/{}/{} completion {}\n",
+            sgx.as_view().relaxed().read32(0xd640c0),
+            sgx.as_view().relaxed().read32(0xd640c8),
+            sgx.as_view().relaxed().read32(0xd60060),
+            firmware.read_u32(0xffff_fc20_0003_f19c)?
+        );
+        Err(ETIMEDOUT)
+    }
+
+    fn publish(&mut self, pdev: &platform::Device<Core<'_>>) -> Result {
+        let dev = pdev.as_ref();
+        let address_space = self._address_space.as_ref().ok_or(EINVAL)?;
+        let firmware_space = self._firmware_space.as_ref().ok_or(EINVAL)?;
+        let res = dev
+            .of_node()
+            .ok_or(EINVAL)?
+            .reserved_mem_region_to_resource_byname(c_str!("ttbs"))?;
+        // SAFETY: This is the validated reserved hardware context table.
+        let ttbs = unsafe { io::mem::Mem::try_new(res, io::mem::MemFlag::WB.into())? };
+        let sgx_guard = self._sgx.try_access().ok_or(ENODEV)?;
+        let sgx = &*sgx_guard;
+        let main = crate::g16_fw::MainConfig::bootstrap(crate::g16_fw::BUNDLE_ADDRESS);
+        for channel in &main.channels[..12] {
+            for va in channel.state {
+                let offset = if va >= 0xffff_fc20_0002_8000 {
+                    0xd64000 + (va - 0xffff_fc20_0002_8000) as usize
+                } else {
+                    0xd60000 + (va - 0xffff_fc20_0002_0000) as usize
+                };
+                sgx.try_write32(0, offset)?;
+                if sgx.try_read32(offset)? != 0 {
+                    return Err(EIO);
+                }
+            }
+        }
+        // Slot zero (opcode 0x16) is already embedded in the main object.
+        for (offset, value) in [(0xd640c0, 0), (0xd640c8, 0), (0xd60060, 1)] {
+            sgx.try_write32(value, offset)?;
+            if sgx.try_read32(offset)? != value {
+                return Err(EIO);
+            }
+        }
+        drop(sgx_guard);
+        // Slot zero's high root is empty. Firmware keeps using its separate
+        // bootstrap root from the loader reservation, not this context entry.
+        // SAFETY: Offsets 0 and 8 are slot zero's two roots, inside the
+        // mapped context table, and the cache clean covers that line.
+        unsafe {
+            ttbs.ptr()
+                .cast::<u64>()
+                .write_volatile(address_space.low.ttb() | 1);
+            ttbs.ptr()
+                .add(8)
+                .cast::<u64>()
+                .write_volatile(address_space.high.ttb() | 1);
+            core::arch::asm!("dc cvac, {addr}", addr = in(reg) ttbs.ptr());
+        }
+        crate::mem::sync();
+        crate::mem::tlbi_asid(0);
+        crate::mem::sync();
+        self._rtkit
+            .as_mut()
+            .send_message(0x20, 0x0081_0c20_0010_0000)?;
+        dev_info!(dev, "G16: published Linux-built initialization graph\n");
+        for _ in 0..3000 {
+            if firmware_space.read_u32(crate::g16_fw::RootPointers::bootstrap().status_a + 0x14)?
+                == 1
+            {
+                dev_info!(dev, "G16: firmware accepted initialization graph\n");
+                return Ok(());
+            }
+            kernel::time::delay::fsleep(kernel::time::Delta::from_millis(1));
+        }
+        dev_err!(
+            dev,
+            "G16: initialization timeout; status {:#x}/{:#x}/{:#x}\n",
+            firmware_space.read_u32(0xffff_fc20_0003_f190)?,
+            firmware_space.read_u32(0xffff_fc20_0003_f194)?,
+            firmware_space.read_u32(0xffff_fc20_0003_f198)?
+        );
+        Err(ETIMEDOUT)
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_alloc.rs b/drivers/gpu/drm/asahi/g16_alloc.rs
new file mode 100644
index 0000000000000..332ac573ffaed
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_alloc.rs
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+
+//! Allocation of retained backing within a VM's private GPU aperture.
+//!
+//! Scratch grows from the low end and tiler backing from the high end. Both
+//! consume the same remaining range, so neither needs a fixed reservation.
+//! Clone the arena to stage a reservation before a fallible backing allocation.
+
+use core::ops::Range;
+
+#[derive(Clone, Default, Debug, PartialEq)]
+pub(crate) struct Arena {
+    remaining: Range<u64>,
+}
+
+impl Arena {
+    pub(crate) fn new(remaining: Range<u64>) -> Self {
+        Self { remaining }
+    }
+
+    pub(crate) fn alloc(&mut self, size: u64, align: u64) -> Option<Range<u64>> {
+        if size == 0 || !align.is_power_of_two() {
+            return None;
+        }
+        let start = self.remaining.start.checked_add(align - 1)? & !(align - 1);
+        let end = start.checked_add(size)?;
+        if end > self.remaining.end {
+            return None;
+        }
+        self.remaining.start = end;
+        Some(start..end)
+    }
+
+    /// Bytes not yet taken from either end.
+    pub(crate) fn free(&self) -> u64 {
+        self.remaining.end.saturating_sub(self.remaining.start)
+    }
+
+    pub(crate) fn alloc_back(&mut self, size: u64, align: u64) -> Option<Range<u64>> {
+        if size == 0 || !align.is_power_of_two() {
+            return None;
+        }
+        let start = self.remaining.end.checked_sub(size)? & !(align - 1);
+        if start < self.remaining.start {
+            return None;
+        }
+        self.remaining.end = start;
+        Some(start..start + size)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn interleaved_scratch_and_tiler_exceed_old_growth_reservation() {
+        let mut arena = Arena::new(0x1000_4000..0x3000_0000);
+        let mut live = Vec::new();
+        for _ in 0..400 {
+            live.push(arena.alloc(0x14000, 0x4000).unwrap());
+            let block = arena.alloc_back(0x28000, 0x8000).unwrap();
+            assert_eq!(block.start & 0x7fff, 0);
+            live.push(block);
+        }
+        live.sort_unstable_by_key(|r| r.start);
+        assert!(live.windows(2).all(|pair| pair[0].end <= pair[1].start));
+    }
+
+    #[test]
+    fn exhaustion_and_bad_requests_preserve_reservations() {
+        let mut arena = Arena::new(0x4000..0x24000);
+        assert_eq!(arena.alloc(0x10000, 0x4000), Some(0x4000..0x14000));
+        let saved = arena.clone();
+        for (size, align) in [(0x20000, 0x8000), (0, 1), (1, 0), (1, 3), (u64::MAX, 1)] {
+            assert_eq!(arena.alloc(size, align), None);
+            assert_eq!(arena.alloc_back(size, align), None);
+            assert_eq!(arena, saved);
+        }
+        assert_eq!(arena.alloc_back(0x10000, 0x4000), Some(0x14000..0x24000));
+        assert_eq!(arena.alloc(1, 1), None);
+    }
+
+    #[test]
+    fn backing_failure_can_discard_staged_allocation() {
+        let arena = Arena::new(0x4000..0x24000);
+        let mut staged = arena.clone();
+        assert_eq!(staged.alloc_back(0x10000, 0x8000), Some(0x10000..0x20000));
+        let mut retry = arena;
+        assert_eq!(retry.alloc_back(0x10000, 0x8000), Some(0x10000..0x20000));
+        assert_eq!(retry, staged);
+    }
+
+    #[test]
+    fn address_overflow_is_rejected() {
+        let mut arena = Arena::new(u64::MAX - 1..u64::MAX);
+        assert_eq!(arena.alloc(1, 0x4000), None);
+        assert_eq!(arena.alloc(4, 1), None);
+        assert_eq!(arena.alloc_back(4, 1), None);
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_compute.rs b/drivers/gpu/drm/asahi/g16_compute.rs
new file mode 100644
index 0000000000000..393079c420021
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_compute.rs
@@ -0,0 +1,310 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+// Adapted from Niklas Sheth's linux-m4-integration prototype.
+
+//! T8132 compute work and microsequence encoding. All links are supplied by
+//! the owner of the work allocation, independently of Rust structure layout.
+
+use crate::util::{put32 as u32_at, put64 as u64_at};
+
+pub(crate) const QUEUE: u64 = 0xffff_fc20_c500_0000;
+pub(crate) const STATS: u64 = QUEUE + 0x8000;
+pub(crate) const SHARED: u64 = 0xffff_fc20_0200_0000;
+
+// Device-owned opening namespace. Client roots share only the FList directory
+// and spill pool; each command receives distinct scratch/marker VAs instead.
+pub(crate) const DIRECTORY: u64 = 0x70_02cc_0000;
+pub(crate) const DIRECTORY_SIZE: usize = 0x18000;
+pub(crate) const BUFFER_BASE: u64 = 0x70_0310_8000;
+pub(crate) const BUFFER_STRIDE: u64 = 0x208000;
+pub(crate) const BUFFER_SIZE: usize = 0x200000;
+pub(crate) const BUFFER_COUNT: usize = 16;
+pub(crate) const SCRATCH: u64 = 0x70_030e_0000;
+pub(crate) const MARKER: u64 = 0x10_00c6_0000;
+pub(crate) const SUPPORT: u64 = 0xffff_fc20_c05e_8000;
+pub(crate) const SHARED_STATE: u64 = 0xffff_fc20_001b_0000;
+pub(crate) const ENTRY_OFFSET: u64 = 0x1a00;
+
+/// Drain/invalidate compute caches before entering the caller's CDM stream.
+/// Back-to-back M4 Works require the full barrier used by Mesa's CDM helper;
+/// 0x60000168 does not preserve dependent SSBO writes between Works.
+pub(crate) fn entry(stream: u64) -> [u8; 12] {
+    let mut out = [0; 12];
+    u32_at(&mut out, 0, 0x600fffff);
+    u32_at(&mut out, 4, 0x20000000 | (stream >> 32) as u32);
+    u32_at(&mut out, 8, stream as u32);
+    out
+}
+
+pub(crate) fn private_ranges() -> [(u64, usize); 19] {
+    core::array::from_fn(|i| match i {
+        0 => (DIRECTORY, DIRECTORY_SIZE),
+        1 => (SCRATCH, 0x20000),
+        2 => (MARKER, 0x4000),
+        _ => (BUFFER_BASE + (i - 3) as u64 * BUFFER_STRIDE, BUFFER_SIZE),
+    })
+}
+
+pub(crate) fn support() -> [u8; 0x100] {
+    let mut out = [0; 0x100];
+    let pages = (BUFFER_COUNT * BUFFER_SIZE / 0x1000) as u32;
+    u64_at(&mut out, 0, 2);
+    // +8 selects the hardware FList slot; +0 is a separate pool identity.
+    // Sharing slot zero with render corrupts concurrently active pool state.
+    u32_at(&mut out, 8, 2);
+    u64_at(&mut out, 0x14, DIRECTORY);
+    u32_at(&mut out, 0x1c, (DIRECTORY_SIZE / 8) as u32);
+    u32_at(&mut out, 0x24, pages % (DIRECTORY_SIZE / 8) as u32);
+    u32_at(&mut out, 0x2c, pages);
+    u64_at(&mut out, 0x4c, SHARED_STATE);
+    out
+}
+
+
+#[derive(Clone, Copy)]
+pub(crate) struct Parameters {
+    /// Diagnostics: the submitting process, captured at ioctl time.
+    pub(crate) tgid: i32,
+    pub(crate) comm: [u8; 16],
+    pub(crate) cdm: u64,
+    pub(crate) cdm_end: u64,
+    pub(crate) sampler: u64,
+    pub(crate) sampler_count: u32,
+    pub(crate) scratch: u64,
+    pub(crate) marker: u64,
+    pub(crate) save_area: u64,
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct Addresses {
+    pub(crate) work: u64,
+    pub(crate) microsequence: u64,
+    pub(crate) register_table: u64,
+    pub(crate) queue: u64,
+    pub(crate) stats: u64,
+    pub(crate) support: u64,
+    pub(crate) notifier: u64,
+    pub(crate) threshold: u64,
+    pub(crate) driver_stamp: u64,
+    pub(crate) firmware_stamp: u64,
+    pub(crate) timestamp_start: u64,
+    pub(crate) timestamp_end: u64,
+    pub(crate) context: u32,
+    pub(crate) identity: u64,
+    pub(crate) register_identity: u64,
+    pub(crate) counter: u64,
+    pub(crate) event_generation: u32,
+    pub(crate) stamp: u32,
+    pub(crate) event: u32,
+    pub(crate) ordinal: u32,
+    pub(crate) cdm_entry: Option<u64>,
+}
+
+impl Addresses {
+    /// Work storage is retained by its owner. Firmware-width fields wrap
+    /// independently of the full software publication and queue counters.
+    pub(crate) fn publication(index: u64, ordinal: u64, work: u64, alias: u64) -> Self {
+        let count = index.wrapping_add(1);
+        Self {
+            work,
+            microsequence: work + 0x1000,
+            register_table: alias + 0x20,
+            queue: QUEUE,
+            stats: STATS,
+            support: SUPPORT,
+            notifier: work + 0x1400,
+            threshold: work + 0x1800,
+            driver_stamp: work + 0x1600,
+            firmware_stamp: work + 0x1680,
+            timestamp_start: work + 0x1700,
+            timestamp_end: work + 0x1708,
+            context: 1,
+            identity: (1u64 << 32) | u64::from(count as u32),
+            register_identity: (1u64 << 32) + 1,
+            counter: count,
+            event_generation: count as u32,
+            stamp: crate::g16_stamp::value(ordinal, 0x100),
+            event: 4,
+            ordinal: ordinal as u32,
+            cdm_entry: None,
+        }
+    }
+
+    pub(crate) fn notifier(&self, count: u32) -> [u8; 0x100] {
+        let mut out = [0; 0x100];
+        u64_at(&mut out, 0, self.threshold);
+        for (off, val) in [
+            (8, self.event_generation),
+            (12, count),
+            (16, 0x50),
+            (0x24, self.context),
+        ] {
+            u32_at(&mut out, off, val);
+        }
+        out
+    }
+}
+
+impl Parameters {
+    fn valid(&self) -> bool {
+        self.cdm != 0
+            && self.cdm & 3 == 0
+            && self.cdm_end > self.cdm
+            && self.cdm_end & 3 == 0
+            && self.sampler & 7 == 0
+            && self.sampler_count < u32::MAX
+            && (self.sampler_count == 0) == (self.sampler == 0)
+    }
+
+    pub(crate) fn work(&self, a: &Addresses, out: &mut [u8]) -> Option<()> {
+        if !self.valid() {
+            return None;
+        }
+        if out.len() != 0x8c0 {
+            return None;
+        }
+        u32_at(&mut *out, 0, 3);
+        u64_at(&mut *out, 4, a.counter);
+        u32_at(&mut *out, 12, a.context);
+        u64_at(&mut *out, 16, a.notifier);
+        let registers = [
+            (0x1a510, self.save_area),
+            (0x1a420, a.cdm_entry.unwrap_or(self.cdm)),
+            (0x1a4d0, self.save_area + 0x1480),
+            (0x1a4d8, self.save_area + 0x1488),
+            (0x1a4e0, self.save_area + 0x1490),
+            (0x1a4e8, self.save_area + 0x1498),
+            (0x1a440, 0x154024201),
+            (0x1a458, 0x10c08ae0),
+            (0x101d9, 0x1c),
+            (0x1a089, 0),
+            (0x1a091, 0),
+            (0x1a059, 0),
+            (0x1a061, 0),
+            (0x1a0b9, 0),
+            (0x1a0c1, 0),
+            (0x101d1, 0),
+            (0x0d479, 0),
+            (0x1a0e9, 8),
+            (0x107a1, 0x00ff0000),
+            (0x0a599, 0x20000400020),
+            (0x0d411, 0x200000001),
+            (0x1a540, a.register_identity),
+            (0x014a9, a.register_identity),
+            (0x0a351, a.register_identity),
+        ];
+        for (index, (reg, value)) in registers.iter().enumerate() {
+            u32_at(&mut *out, 0x20 + index * 12, *reg);
+            u64_at(&mut *out, 0x24 + index * 12, *value);
+        }
+        for (off, value) in [
+            (0x720, a.register_table),
+            (0x760, a.microsequence),
+            (0x798, self.save_area),
+            (0x7a0, self.cdm_end - 4),
+            (
+                0x7e8,
+                if self.sampler_count == 0 {
+                    0xffff_ffff
+                } else {
+                    self.sampler
+                },
+            ),
+            (0x800, a.driver_stamp),
+            (0x808, a.firmware_stamp),
+            (0x834, a.timestamp_start),
+            (0x83c, a.timestamp_end),
+            (0x86a, a.support),
+            (0x883, 0),
+        ] {
+            u64_at(&mut *out, off, value);
+        }
+        for (off, value) in [
+            (0x728, 24 | (288 << 16)),
+            (0x768, 0x300),
+            (0x7c8, 0x54024201),
+            (0x7cc, 1),
+            (0x7e0, (a.identity >> 32) as u32),
+            (0x7f0, self.sampler_count),
+            (
+                0x7f4,
+                if self.sampler_count == 0 {
+                    0
+                } else {
+                    self.sampler_count + 1
+                },
+            ),
+            (0x810, a.stamp),
+            (0x81c, 1), // Flush notifier stamps before storage reuse.
+            (0x814, a.event),
+            (0x820, a.identity as u32),
+            (0x828, a.ordinal),
+            (0x874, 0x21b00),
+            (0x87c, 0x11700),
+        ] {
+            u32_at(&mut *out, off, value);
+        }
+        out[0x872] = 1;
+        out[0x88b] = 1;
+        Some(())
+    }
+
+    pub(crate) fn microsequence(&self, a: &Addresses) -> [u8; 0x300] {
+        let mut out = [0; 0x300];
+        for (off, value) in [
+            (0, 0x0b),
+            (0x2c, a.context),
+            (0x30, 1),
+            (0x34, a.event_generation),
+            (0x50, a.identity as u32),
+            (0x1b0, a.counter as u32),
+            (0x1b8, a.event),
+            (0x208, 1),
+            (0x258, 0x0c),
+            (0x26c, a.context),
+            (0x27c, a.identity as u32),
+            (0x28c, a.stamp),
+            (0x2bc, (-0x258i32) as u32),
+            (0x2d4, 0x40000002),
+        ] {
+            u32_at(&mut out, off, value);
+        }
+        for (off, value) in [
+            (0x14, a.work + 0x20),
+            (0x1c, a.stats),
+            (0x24, a.queue),
+            (0x44, a.work + 0x76c),
+            (0x160, a.support),
+            (0x178, self.marker),
+            (0x188, self.scratch),
+            (0x190, self.scratch + 0xf400),
+            (0x198, self.scratch + 0x1e800),
+            (0x1a0, self.scratch + 0x1f000),
+            (0x1a8, a.work + 0x8ac),
+            (0x25c, a.stats),
+            (0x264, a.queue),
+            (0x270, a.work + 0x76c),
+            (0x284, a.firmware_stamp),
+            (0x2b4, a.microsequence + 0x160),
+            (0x2c1, a.work + 0x8ac),
+            (0x2c9, a.work + 0x88c),
+        ] {
+            u64_at(&mut out, off, value);
+        }
+        for (base, opcode, update) in [(0x1bc, 0x80000003, 0x834), (0x20c, 3, 0x83c)] {
+            u32_at(&mut out, base, opcode);
+            for (off, value) in [
+                (4, a.work + 0x82c),
+                (12, a.work + 0x834),
+                (20, a.work + update),
+                (28, a.queue),
+                (44, a.work + 0x89c),
+                (52, a.work + 0x7dc),
+            ] {
+                u64_at(&mut out, base + off, value);
+            }
+            u32_at(&mut out, base + 68, a.identity as u32);
+        }
+        out
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_deferred.rs b/drivers/gpu/drm/asahi/g16_deferred.rs
new file mode 100644
index 0000000000000..401e0f7cf44ef
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_deferred.rs
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright 2026 The Asahi Linux Contributors
+
+//! Deferred unmap bookkeeping for GEM close.
+//!
+//! A live GEM close no longer waits for the VM's queued work. The object's
+//! mappings stay in the page tables, marked closing, until every fence that
+//! was pending at the close has signaled; then the reaper unmaps them.
+//! Submissions already keep each mapped object (and so its pages) alive, so
+//! deferral only keeps PTEs valid for work that may still use them. Closing
+//! mappings no longer satisfy `covered`, and a bind over them waits only for
+//! their own snapshot. Pure range logic, host-tested.
+
+use core::ops::Range;
+
+/// Most deferred closes one VM tracks. Past this a close drains as before.
+pub(crate) const MAX_ENTRIES: usize = 4096;
+
+/// A mapping as this logic sees it.
+pub(crate) trait Span {
+    fn range(&self) -> Range<u64>;
+    fn permissions(&self) -> u32;
+    fn closing(&self) -> bool;
+}
+
+/// Whether `items` (sorted by address, non-overlapping) cover
+/// `start..start + size` with at least `permissions`, using only mappings
+/// that are not closing.
+pub(crate) fn covered<T: Span>(items: &[T], start: u64, size: u64, permissions: u32) -> bool {
+    let Some(end) = start.checked_add(size) else { return false };
+    if size == 0 {
+        return false;
+    }
+    // The only candidate for `cursor` is the first mapping ending after it.
+    let mut cursor = start;
+    while cursor < end {
+        let index = items.partition_point(|m| m.range().end <= cursor);
+        match items.get(index) {
+            Some(m)
+                if m.range().contains(&cursor)
+                    && !m.closing()
+                    && m.permissions() & permissions == permissions =>
+            {
+                cursor = end.min(m.range().end);
+            }
+            _ => return false,
+        }
+    }
+    true
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Overlap {
+    /// Nothing mapped in the range.
+    None,
+    /// Only closing mappings: wait for their snapshots, then reap them.
+    Deferred,
+    /// At least one live mapping: the caller replaces it as before.
+    Live,
+}
+
+/// Classify the mappings `start..end` overlaps.
+pub(crate) fn overlap<T: Span>(items: &[T], start: u64, end: u64) -> Overlap {
+    let mut kind = Overlap::None;
+    for m in items {
+        let r = m.range();
+        if start < r.end && end > r.start {
+            if !m.closing() {
+                return Overlap::Live;
+            }
+            kind = Overlap::Deferred;
+        }
+    }
+    kind
+}
+
+/// Whether a deferred close may be recorded on a VM already tracking
+/// `entries`; otherwise the close drains as before.
+pub(crate) fn admit(entries: usize) -> bool {
+    entries < MAX_ENTRIES
+}
+
+/// Whether a snapshot is complete: every fence in it has signaled.
+pub(crate) fn ready(signaled: impl IntoIterator<Item = bool>) -> bool {
+    signaled.into_iter().all(|s| s)
+}
diff --git a/drivers/gpu/drm/asahi/g16_drain.rs b/drivers/gpu/drm/asahi/g16_drain.rs
new file mode 100644
index 0000000000000..275437c6e5b0b
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_drain.rs
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright 2026 The Asahi Linux Contributors
+
+//! Progress-based drain policy for a VM's pending fences.
+//!
+//! A drain fails when none of the VM's own fences has signaled for the
+//! no-progress budget, not after a fixed total time: a deep queue of slow
+//! but retiring work (several parallel clients, long shaders) can need far
+//! longer than one budget, while a stuck or starved VM still fails within
+//! it. An overall cap keeps every drain bounded even if progress trickles.
+//! Pure arithmetic on caller-supplied times, so it is host-testable.
+
+/// Longest any drain may take, however steadily its fences signal.
+pub(crate) const CAP_MS: i64 = 120_000;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Verdict {
+    /// Every fence has signaled.
+    Done,
+    /// Keep waiting, for at most this many ms before re-checking.
+    Wait(i64),
+    /// No fence signaled for the whole no-progress budget.
+    NoProgress,
+    /// The overall cap ran out while fences were still signaling.
+    Capped,
+}
+
+/// What a drain observed, for its caller's log line.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Stats {
+    /// Time since the drain started (ms).
+    pub(crate) waited_ms: i64,
+    /// Fences that signaled during the drain.
+    pub(crate) signaled: usize,
+    /// Fences still pending at the last check.
+    pub(crate) remaining: usize,
+    /// Time since the last fence signaled, or since the start (ms).
+    pub(crate) idle_ms: i64,
+}
+
+pub(crate) struct Clock {
+    budget_ms: i64,
+    cap_ms: i64,
+    initial: usize,
+    remaining: usize,
+    last_progress_ms: i64,
+    now_ms: i64,
+}
+
+impl Clock {
+    /// Start a drain of `remaining` fences with a no-progress budget of
+    /// `budget_ms` and an overall cap of `cap_ms` (callers sharing one
+    /// deadline pass what is left of it; at least 1 ms).
+    pub(crate) fn new(remaining: usize, budget_ms: u32, cap_ms: i64) -> Self {
+        let budget_ms = i64::from(budget_ms).max(1);
+        Self {
+            budget_ms,
+            cap_ms: cap_ms.max(1),
+            initial: remaining,
+            remaining,
+            last_progress_ms: 0,
+            now_ms: 0,
+        }
+    }
+
+    /// Record the pending count at `now_ms` (ms since the start, monotonic)
+    /// and decide. A smaller count is progress. The pending set only
+    /// shrinks during a drain: new submissions are blocked or impossible.
+    pub(crate) fn update(&mut self, now_ms: i64, remaining: usize) -> Verdict {
+        self.now_ms = now_ms.max(self.now_ms);
+        if remaining < self.remaining {
+            self.last_progress_ms = self.now_ms;
+        }
+        self.remaining = remaining.min(self.remaining);
+        if self.remaining == 0 {
+            return Verdict::Done;
+        }
+        let idle_left = self.budget_ms - (self.now_ms - self.last_progress_ms);
+        let cap_left = self.cap_ms - self.now_ms;
+        if idle_left <= 0 {
+            Verdict::NoProgress
+        } else if cap_left <= 0 {
+            Verdict::Capped
+        } else {
+            Verdict::Wait(idle_left.min(cap_left))
+        }
+    }
+
+    pub(crate) fn stats(&self) -> Stats {
+        Stats {
+            waited_ms: self.now_ms,
+            signaled: self.initial - self.remaining,
+            remaining: self.remaining,
+            idle_ms: self.now_ms - self.last_progress_ms,
+        }
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_drm.rs b/drivers/gpu/drm/asahi/g16_drm.rs
new file mode 100644
index 0000000000000..ebd6b7c419d3f
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_drm.rs
@@ -0,0 +1,1198 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+// Adapted from Niklas Sheth's linux-m4-integration prototype.
+
+//! G16 DRM frontend. Firmware initialization and queue ownership stay in the
+//! G16 runtime; GEM storage uses the common DRM shmem implementation.
+//! This file holds the driver, file, VM and job types; the submodules hold
+//! the ioctls (`ioctl_impl`), VM mappings (`bind`), SUBMIT (`submit_impl`)
+//! and the submission pump (`pump`).
+
+use crate::{g16_compute as compute, g16_render as render};
+use core::{
+    ops::Range,
+    sync::atomic::{AtomicBool, AtomicPtr, AtomicU64, Ordering},
+};
+use kernel::dma_fence::{self, RawDmaFence};
+use kernel::drm::sched;
+use kernel::drm::{
+    gem::{shmem, BaseObject, DriverObject},
+    ioctl,
+};
+use kernel::sync::{Arc, CondVar, Mutex, MutexGuard};
+use kernel::error::to_result;
+use kernel::sync::aref::ARef;
+use kernel::uaccess::{UserPtr, UserSlice};
+use kernel::workqueue::{self, impl_has_work, new_work, Work, WorkItem};
+use kernel::{bindings, c_str, device::{Bound, Core}, drm, platform, prelude::*, scatterlist, uapi};
+
+#[path = "g16_drm_ioctl.rs"]
+mod ioctl_impl;
+#[path = "g16_drm_bind.rs"]
+mod bind;
+#[path = "g16_drm_submit.rs"]
+mod submit_impl;
+#[path = "g16_drm_pump.rs"]
+mod pump;
+
+// Downstream UAPI values (asahi_drm.h) are single bits allocated from bit 30
+// downwards; upstream's start at bit 0. Keep the two ranges apart.
+const _: () = {
+    use uapi::*;
+    let upstream = drm_asahi_feature_DRM_ASAHI_FEATURE_SOFT_FAULTS as u64
+        | drm_asahi_render_flags_DRM_ASAHI_RENDER_VERTEX_SCRATCH as u64
+        | drm_asahi_render_flags_DRM_ASAHI_RENDER_PROCESS_EMPTY_TILES as u64
+        | drm_asahi_render_flags_DRM_ASAHI_RENDER_NO_VERTEX_CLUSTERING as u64
+        | drm_asahi_render_flags_DRM_ASAHI_RENDER_DBIAS_IS_INT as u64;
+    let downstream = [
+        drm_asahi_feature_DRM_ASAHI_FEATURE_FEW_PRIMITIVES as u64,
+        drm_asahi_feature_DRM_ASAHI_FEATURE_FRAGMENT_BARRIER as u64,
+        drm_asahi_render_flags_DRM_ASAHI_RENDER_FEW_PRIMITIVES as u64,
+        drm_asahi_render_flags_DRM_ASAHI_RENDER_VDM_BARRIER_FRAGMENT as u64,
+    ];
+    assert!(upstream < 1 << 24);
+    let mut i = 0;
+    while i < downstream.len() {
+        let bit = downstream[i];
+        assert!(bit.is_power_of_two() && bit >= 1 << 24 && bit <= 1 << 30);
+        i += 1;
+    }
+};
+
+enum Command {
+    Render(uapi::drm_asahi_cmd_render),
+    Compute(uapi::drm_asahi_cmd_compute),
+}
+#[derive(Clone, Copy)]
+enum Parameters {
+    Render(render::Parameters),
+    Compute(compute::Parameters),
+}
+
+pub(crate) struct Driver;
+pub(crate) type Device = drm::Device<Driver>;
+pub(crate) type DeviceRef = ARef<Device>;
+pub(crate) type RegDevice = drm::Device<Driver, drm::Registered>;
+
+/// Registration-scoped data: the bound parent device, for DMA mappings.
+pub(crate) struct RegData<'a> {
+    pdev: &'a platform::Device<Bound>,
+}
+type DrmFile = drm::File<File>;
+type Object = shmem::Object<Buffer>;
+const VM_END: u64 = (1 << 42) - 0x8000;
+static NEXT_FILE: AtomicU64 = AtomicU64::new(1);
+static NEXT_EXECUTION: AtomicU64 = AtomicU64::new(1);
+
+#[derive(Clone)]
+struct Mapping {
+    range: Range<u64>,
+    permissions: u32,
+    offset: u64,
+    single: bool,
+    obj: ARef<Object>,
+    /// Its object was closed while work was queued: the PTEs stay until the
+    /// reaper unmaps them (see g16_deferred), but nothing new may use it.
+    closing: bool,
+}
+
+impl crate::g16_deferred::Span for Mapping {
+    fn range(&self) -> Range<u64> {
+        self.range.clone()
+    }
+    fn permissions(&self) -> u32 {
+        self.permissions
+    }
+    fn closing(&self) -> bool {
+        self.closing
+    }
+}
+
+impl Mapping {
+    fn cover(mappings: &[Self], start: u64, size: u64, permissions: u32) -> Result {
+        if crate::g16_deferred::covered(mappings, start, size, permissions) {
+            Ok(())
+        } else {
+            Err(reject(format_args!("{:#x}+{:#x} not mapped with access {:#x}", start, size, permissions)))
+        }
+    }
+}
+
+/// A GEM close deferred until every fence pending at the close has signaled.
+struct Deferred {
+    obj: ARef<Object>,
+    fences: KVec<dma_fence::Fence>,
+}
+
+struct Vm {
+    id: u32,
+    visible: bool,
+    kernel: Range<u64>,
+    // Tables must be removed before the references keeping GEM pages pinned.
+    space: Arc<Mutex<crate::g16_vm::AddressSpace>>,
+    compute_space: Arc<Mutex<crate::g16_vm::AddressSpace>>,
+    // Large address spaces hold thousands of mappings; allow vmalloc.
+    // Sorted by address; mappings never overlap.
+    mappings: KVVec<Mapping>,
+    /// Shared copy of `mappings` retained by submissions. Rebuilt only after
+    /// the mappings change, so a submit costs one reference, not one per
+    /// mapping.
+    snapshot: Option<Arc<KVVec<Mapping>>>,
+    pending: KVec<dma_fence::Fence>,
+    // Count overlapping drains. Submit to this VM sleeps until all finish;
+    // unrelated file ioctls and other VMs can still acquire file state.
+    draining: u32,
+    reservation: ARef<Object>,
+    render_support: Option<Arc<crate::g16::Support>>,
+    /// The native mesh mode when this VM was created. Its support header and
+    /// every decode of its streams use it, whatever the runtime mode is later.
+    native_mode: crate::g16_mesh::Mode,
+    render_ready: bool,
+    /// The runtime holds this VM root's TVB pool (created by its first render
+    /// submission, released with the VM).
+    tvb_ready: bool,
+    compute_ready: bool,
+    render_broken: bool,
+    /// Closes waiting for their snapshot to complete (see g16_deferred).
+    deferred: KVec<Deferred>,
+}
+
+/// Retain submit-time GEM and timestamp bindings until actual completion.
+/// Command preparation never reads caller CDM or shader resource data.
+struct Bindings {
+    _mappings: Arc<KVVec<Mapping>>,
+    _timestamps: KVec<TimestampBuffer>,
+}
+
+struct FileState {
+    next_vm: u32,
+    next_queue: u32,
+    next_timestamp: u32,
+    queues: KVec<Queue>,
+    timestamps: KVec<TimestampBuffer>,
+    retained_timestamps: KVec<TimestampBuffer>,
+    vms: KVec<Vm>,
+    /// Set by file teardown: the reaper must no longer touch the VMs.
+    closed: bool,
+}
+
+struct Queue {
+    id: u32,
+    vm: u32,
+    entity: sched::Entity<SubmissionJob>,
+    firmware: Arc<Mutex<crate::g16::FirmwareQueues>>,
+}
+#[derive(Clone)]
+struct TimestampBuffer {
+    id: u32,
+    /// Keeps the object, and so its pinned pages and DMA mapping, alive while mapped.
+    _obj: ARef<Object>,
+    base: u64,
+    extent: u64,
+    address: u64,
+    size: u64,
+}
+
+#[pin_data]
+pub(crate) struct Data {
+    gpu_revision: u32,
+    core_mask: u32,
+    maximum_frequency_khz: u32,
+    scheduler: sched::Scheduler<SubmissionJob>,
+    #[pin]
+    admission: Mutex<KVec<dma_fence::Fence>>,
+    failed: AtomicBool,
+    notifications: Arc<crate::g16::Notifications>,
+    /// Debug view of the firmware's memory; declared before `runtime` so it
+    /// is removed before the firmware regions can be freed.
+    _fw_mem: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::FwMem>>>,
+    #[pin]
+    runtime: Mutex<crate::g16::Bootstrap>,
+    #[pin]
+    engine: Mutex<Engine>,
+    /// Jobs drm_sched has run but the pump has not yet taken. Scheduler
+    /// callbacks hold only this lock, briefly, never `engine`: the pump
+    /// keeps `engine` through a whole publication pass.
+    #[pin]
+    inbox: Mutex<Inbox>,
+    /// timeline=1/2: the record ring and its debugfs file (dropped before the
+    /// directory).
+    timeline: Option<Pin<KBox<kernel::debugfs::File<crate::g16_timeline::Ring>>>>,
+    _profile: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::Profile>>>,
+    _queue_cap: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::CapKnob>>>,
+    _flags: KVec<Pin<KBox<kernel::debugfs::File<crate::g16_timeline::FlagKnob>>>>,
+    _native_mesh: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::NativeMeshKnob>>>,
+    _native_mesh_attribute: NativeMeshAttribute,
+    _dep_stats: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::DepStats>>>,
+    _lane_cap: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::CapKnob>>>,
+    _debugfs: kernel::debugfs::Dir,
+}
+
+#[vtable]
+impl drm::driver::Driver for Driver {
+    type Data = Data;
+    type RegistrationData<'a> = RegData<'a>;
+    type File = File;
+    type Object = Object;
+    type ParentDevice<Ctx: kernel::device::DeviceContext> = platform::Device<Ctx>;
+    const INFO: drm::driver::DriverInfo = drm::driver::DriverInfo {
+        major: 0,
+        minor: 0,
+        patchlevel: 0,
+        name: c_str!("asahi"),
+        desc: c_str!("Apple G16 Graphics"),
+    };
+    const FEAT_RENDER: bool = true;
+    const FEAT_SYNCOBJ: bool = true;
+    const FEAT_SYNCOBJ_TIMELINE: bool = true;
+
+    kernel::declare_drm_ioctls! {
+        (ASAHI_GET_PARAMS, drm_asahi_get_params, ioctl::RENDER_ALLOW, File::get_params),
+        (ASAHI_GET_TIME, drm_asahi_get_time, ioctl::RENDER_ALLOW, File::get_time),
+        (ASAHI_VM_CREATE, drm_asahi_vm_create, ioctl::RENDER_ALLOW, File::vm_create),
+        (ASAHI_VM_DESTROY, drm_asahi_vm_destroy, ioctl::RENDER_ALLOW, File::vm_destroy),
