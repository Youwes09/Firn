+fn tagged_page(address: u64) -> u64 {
+    (1 << 56) | (address >> 8)
+}
+
+impl Addresses {
+    fn valid(&self) -> bool {
+        (self.support | self.tiling_shared_tail | self.fragment_shared_tail) & 0xff == 0
+    }
+}
