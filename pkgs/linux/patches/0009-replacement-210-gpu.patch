+            0x70_0000_0000,
+            0x400000,
+            crate::pgtable::prot::PROT_GPU_SHARED_RW,
+        )?;
+        opening_client.alloc_low(
+            crate::g16_fw::OPERAND_TABLE,
+            0x10000,
+            crate::pgtable::prot::PROT_GPU_SHARED_RW,
+        )?;
+        for index in 0..20 {
+            opening_client.alloc_low(
+                crate::g16_fw::operand_page(index * 512),
+                0x200000,
+                crate::pgtable::prot::PROT_GPU_SHARED_RW,
+            )?;
+        }
