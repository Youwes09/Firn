new file mode 100644
index 0000000000000..d345370a62247
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_runtime_publish.rs
@@ -0,0 +1,327 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+
+//! Admission and publication: reserving a flight's ring and lane room,
+//! staging queue writes and flushing them to firmware.
+
+use super::*;
+
+impl Bootstrap {
+    pub(super) fn reserve_flight(
+        &mut self,
+        queue: &FirmwareQueues,
+        render: bool,
+        root: u64,
+        entries: [u32; 3],
+    ) -> Result {
+        if self.render_failed {
+            return Err(EIO);
+        }
+        // Work storage is bounded by its GPU alias window. When the window is
+        // full, outstanding Works return storage as they retire, so admission
+        // waits; with nothing in flight it can never clear, so fail.
+        if !self.work_space_left(render) {
+            if self.flights.is_empty() {
+                return Err(ENOSPC);
+            }
+            self.report_pressure(64, "Work storage");
+            return Err(EBUSY);
+        }
+        // Check scarce resources before allocating any per-Work storage.
+        // Commands in either persistent VM root can share its live ASID.
+        if !(1..64).any(|i| {
+            self.context_users[i] == 0 || self.context_roots[i].is_some_and(|s| s.low == root)
+        }) {
+            self.report_pressure(1, "ASIDs");
+            return Err(EBUSY);
+        }
+        // The firmware stops completing a queue's Works (its shared notifier
+        // stalls with the stamps already past, blocked=0x2) when too many
+        // are outstanding: k24-cap129 (129 Works on a lane) and k69 on #108,
+        // where compute waits on the own render lanes add firmware dependency
+        // items. Bound the
+        // whole queue's unretired Works plus their dependency items.
+        let cap = crate::g16_timeline::QUEUE_CAP.load(Ordering::Relaxed) as usize;
+        if cap != 0 {
+            if let Some(lanes) = &queue.lanes {
+                let outstanding: usize = lanes
+                    .iter()
+                    .filter_map(|l| self.ledger.lane(l.pointers))
+                    .map(|b| b.owned as usize)
+                    .sum();
+                let new = entries.iter().copied().max().unwrap_or(1) as usize;
+                if outstanding + new > cap {
+                    self.report_pressure(16, "queue entries");
+                    return Err(EBUSY);
+                }
+            }
+        }
+        let stages: &[usize] = if render { &[0, 1] } else { &[2] };
+        for &stage in stages {
+            let channel = queue.priority as usize * 3 + stage;
+            let staged_count = self
+                .publications
+                .iter()
+                .filter(|p| p.channel == channel)
+                .count() as u32;
+            let mut cursors = self.ledger.cursors[channel];
+            if !cursors.is_some_and(|[read, done, tail]| {
+                ring_room((tail + staged_count) & 255, read, done, 1, 256)
+            }) {
+                cursors = Some(self.read_channel(channel)?);
+                self.ledger.cursors[channel] = cursors;
+            }
+            let [read, done, tail] = cursors.ok_or(EIO)?;
+            let staged = self
+                .publications
+                .iter()
+                .filter(|p| p.channel == channel)
+                .count() as u32;
+            let coalesced = queue.lanes.as_ref().is_some_and(|lanes| {
+                self.publications
+                    .iter()
+                    .any(|p| p.lane.queue == lanes[stage].queue)
+            });
+            if !ring_room(
+                (tail + staged) & 255,
+                read,
+                done,
+                u32::from(!coalesced),
+                256,
+            ) {
+                self.report_pressure(2, "channel");
+                return Err(EBUSY);
+            }
+            // Bound transport epochs, not the number of Works sharing each
+            // epoch. A coalesced batch consumes only one channel-ring slot.
+            let next = (tail + staged + u32::from(!coalesced)) & 255;
+            if self
+                .ledger
+                .targets
+                .iter()
+                .any(|&(c, target)| c == channel && !reached(next, target, 256))
+            {
+                self.report_pressure(2, "channel");
+                return Err(EBUSY);
+            }
+            if let Some(lanes) = &queue.lanes {
+                let lane = lanes[stage];
+                let fw = self._firmware_space.as_ref().ok_or(EIO)?;
+                let before = crate::g16_timeline::reads();
+                let (mut read, mut done) = queue.cursors[stage].get();
+                if read >= 0x500
+                    || done >= 0x500
+                    || !ring_room(lane.head, read, done, entries[stage], 0x500)
+                {
+                    read = fw.read_u32(lane.pointers)?;
+                    done = fw.read_u32(lane.pointers + 0x30)?;
+                    queue.cursors[stage].set((read, done));
+                }
+                crate::g16_timeline::attribute(&crate::g16_timeline::P_RD_ADMIT, before);
+                if read >= 0x500 || done >= 0x500 || lane.head >= 0x500 {
+                    return Err(EIO);
+                }
+                if !ring_room(lane.head, read, done, entries[stage], 0x500) {
+                    self.report_pressure(16, "workqueue");
+                    return Err(EBUSY);
+                }
+                // Retirement compares the firmware cursors with each flight's
+                // head modulo the ring, which is only unambiguous within half
+                // a ring. Like the channel epochs above, never let the head
+                // run half a ring past an unretired flight on this lane, or
+                // that flight's ring check stays false and it never retires.
+                // The firmware reads up to 128 Works ahead on each lane. With
+                // more unretired Works than that on a lane it stops completing
+                // them (Dota 2 bursts: 127 in flight never stalled, 129 did).
+                // This applies to every lane (render TA and 3D as well as
+                // compute), so bound each well below the window, as Metal does
+                // with at most 64 command buffers in flight per queue.
+                let cap = crate::module_parameters::max_lane_works.value() as usize;
+                if cap != 0
+                    && self.ledger.lane(lane.pointers).map_or(0, |b| b.works as usize) >= cap
+                {
+                    self.report_pressure(16, "workqueue");
+                    return Err(EBUSY);
+                }
+                // Dependency items on a lane deeper than its 128-Work window
+                // stall the firmware. Bound each lane's unretired Works plus
+                // the items queued on it (preludes are not Works).
+                let cap = crate::g16_timeline::LANE_CAP.load(Ordering::Relaxed) as usize;
+                if cap != 0 {
+                    let load = self.ledger.lane(lane.pointers).map_or(0, |b| b.load as usize);
+                    // A fragment Work may carry the render item it moved there.
+                    let new = if stage == 1 { 2 } else { entries[stage] as usize };
+                    if load + new > cap {
+                        self.report_pressure(32, "lane entries");
+                        return Err(EBUSY);
+                    }
+                }
+                let next = (lane.head + entries[stage]) % 0x500;
+                if self
+                    .ledger
+                    .heads
+                    .iter()
+                    .any(|&(pointers, head)| pointers == lane.pointers && !reached(next, head, 0x500))
+                {
+                    self.report_pressure(16, "workqueue");
+                    return Err(EBUSY);
+                }
+            }
+        }
+        // Preallocated at init (MAX_FLIGHTS): at the cap, wait for retirement.
+        if self.flights.len() >= MAX_FLIGHTS
+            || !self.ledger.has_room()
+            || self.publications.capacity() - self.publications.len() < stages.len()
+        {
+            self.report_pressure(128, "flights");
+            return Err(EBUSY);
+        }
+        Ok(())
+    }
+
+    /// Read a work channel's transport cursors from the device. The driver
+    /// is the tail's only writer: a cached tail that disagrees means that
+    /// assumption broke.
+    pub(super) fn read_channel(&self, channel: usize) -> Result<[u32; 3]> {
+        let route = g16_fw::work_channel(g16_fw::BUNDLE_ADDRESS, channel);
+        let guard = self._sgx.try_access().ok_or(ENODEV)?;
+        let read =
+            guard.try_read32(0xd64000 + (route.state[0] - 0xffff_fc20_0002_8000) as usize)?;
+        let done =
+            guard.try_read32(0xd64000 + (route.state[1] - 0xffff_fc20_0002_8000) as usize)?;
+        let tail =
+            guard.try_read32(0xd60000 + (route.state[2] - 0xffff_fc20_0002_0000) as usize)?;
+        if read >= 256 || done >= 256 || tail >= 256 {
+            return Err(EIO);
+        }
+        if let Some([_, _, cached]) = self.ledger.cursors[channel] {
+            if cached != tail {
+                pr_warn!("G16: channel {} tail {} differs from the cached {}\n", channel, tail, cached);
+            }
+        }
+        Ok([read, done, tail])
+    }
+
+    /// Stage a queue head; multiple Works share one transport message.
+    pub(super) fn stage_queue(
+        &mut self,
+        channel: usize,
+        lane: Lane,
+        event: u32,
+        sequence: u64,
+    ) -> Result<u32> {
+        if let Some(p) = self
+            .publications
+            .iter_mut()
+            .find(|p| p.lane.queue == lane.queue)
+        {
+            p.lane.head = lane.head;
+            p.sequence = sequence;
+            return Ok(p.epoch);
+        }
+        let tail = match self.ledger.cursors[channel] {
+            Some([_, _, tail]) => tail,
+            None => {
+                let cursors = self.read_channel(channel)?;
+                self.ledger.cursors[channel] = Some(cursors);
+                cursors[2]
+            }
+        };
+        let reserved = self
+            .publications
+            .iter()
+            .filter(|p| p.channel == channel)
+            .count() as u32;
+        let epoch = (tail + reserved) & 255;
+        // reserve_flight checked the room.
+        self.publications
+            .push_within_capacity(Publication {
+                channel,
+                epoch,
+                lane,
+                event,
+                sequence,
+            })
+            .map_err(|_| EIO)?;
+        Ok(epoch)
+    }
+
+    /// Publish fully prepared rings together, then kick each used engine once
+    /// per priority. No staged Work may remain when the worker sleeps.
+    pub(crate) fn flush(&mut self) -> Result {
+        let _t = crate::g16_timeline::Timer::start(&crate::g16_timeline::P_FLUSH);
+        if self.publications.is_empty() {
+            return Ok(());
+        }
+        self.render_failed = true;
+        let config = g16_fw::MainConfig::bootstrap(g16_fw::BUNDLE_ADDRESS);
+        let fw = self._firmware_space.as_mut().ok_or(EIO)?;
+        let mut tails: [Option<u32>; 12] = [None; 12];
+        let mut kicks = 0u32;
+        // Fragment transports must precede tiling, matching normal publication.
+        for stage in [1usize, 0, 2] {
+            for p in self.publications.iter().filter(|p| p.channel % 3 == stage) {
+                let route = &config.channels[p.channel];
+                fw.write_live(p.lane.pointers + 0x40, &p.lane.head.to_le_bytes())?;
+                fw.write_live(
+                    route.ring + u64::from(p.epoch) * 0x18,
+                    &g16_fw::queue::channel(
+                        p.lane.queue,
+                        p.lane.head as u16,
+                        p.event as u8,
+                        stage as u32,
+                        p.lane.new,
+                        p.sequence,
+                    ),
+                )?;
+                tails[p.channel] = Some((p.epoch + 1) & 255);
+                kicks |= 1 << ((p.channel / 3) * 2 + usize::from(stage == 2));
+            }
+        }
+        crate::mem::sync();
+        let guard = self._sgx.try_access().ok_or(ENODEV)?;
+        for stage in [1usize, 0, 2] {
+            for channel in (stage..12).step_by(3) {
+                if let Some(tail) = tails[channel] {
+                    let route = &config.channels[channel];
+                    guard.try_write32(
+                        tail,
+                        0xd60000 + (route.state[2] - 0xffff_fc20_0002_0000) as usize,
+                    )?;
+                    if let Some(cursors) = &mut self.ledger.cursors[channel] {
+                        cursors[2] = tail;
+                    }
+                }
+            }
+        }
+        crate::mem::sync();
+        drop(guard);
+        for bit in 0..8 {
+            if kicks & (1 << bit) != 0 {
+                let priority = bit / 2;
+                let engine = (bit % 2) * 2;
+                self._rtkit.as_mut().send_message(
+                    0x21,
+                    0x0083_0000_0000_0000 | ((priority as u64) << 2) | engine as u64,
+                )?;
+            }
+        }
+        if crate::module_parameters::fw_trace.value() & 4 != 0 {
+            dev_info!(
+                self.dev.as_ref(),
+                "G16: batch works={} messages={} kicks={}\n",
+                self.batch_works,
+                self.publications.len(),
+                kicks.count_ones()
+            );
+        }
+        self.publications.clear();
+        self.batch_works = 0;
+        self.render_failed = false;
+        Ok(())
+    }
+
+    pub(crate) fn poison(&mut self) {
+        self.render_failed = true;
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_runtime_queues.rs b/drivers/gpu/drm/asahi/g16_runtime_queues.rs
new file mode 100644
index 0000000000000..0aefca68654ce
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_runtime_queues.rs
@@ -0,0 +1,393 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+
+//! Firmware queue lifecycle: Work arena slots, queue contexts, and preparing
+//! a userspace queue's lanes, events and TVB pool before its first command.
+
+use super::*;
+
+impl Bootstrap {
+    /// Work storage must stay inside the 4 GiB windows that alias it for the
+    /// GPU (0x71/0x72_0000_0000 + offset): Work arenas grow from WORK_BASE,
+    /// and every other firmware object (queue identities, TVB pools) takes
+    /// its VA from OBJECT_BASE above the window. Before #174 they shared one
+    /// cursor, so context churn (about 0.4 MiB per queue and VM) pushed new
+    /// Work past the window after enough contexts in one boot: CTS on #173
+    /// failed renders with ENOSPC at offset 5.3 GiB.
+    pub(super) fn work_space_left(&self, render: bool) -> bool {
+        let index = usize::from(render);
+        let stride = if render { 0x1c000 } else { 0x8000 };
+        !self.free_work[index].is_empty()
+            || !self.work_arenas[index].is_empty()
+            || self.next_work_va + 16 * stride <= WORK_BASE + WORK_WINDOW
+    }
+
+    /// Lease Work storage until notifier/driver stamps and transport retire.
+    /// Backing stays mapped. Queue-owned wrapping stamps outlive reused Work,
+    /// so a pending dependency never follows a recycled completion address.
+    /// A Work slot and, for a reused one, the client root its alias is
+    /// already mapped into; the device alias exists for every reused slot.
+    pub(super) fn allocate_work(&mut self, render: bool) -> Result<(u64, Option<u64>)> {
+        use crate::pgtable::prot::{PROT_FW_PRIV_RW, PROT_FW_SHARED_RW};
+        let index = usize::from(render);
+        if let Some((va, root)) = self.free_work[index].pop() {
+            return Ok((va, Some(root)));
+        }
+        let stride = if render { 0x1c000 } else { 0x8000 };
+        if self.work_arenas[index].is_empty() {
+            // Retirement must not allocate, so the free list keeps room for
+            // every slot ever carved. Counting flights instead misses slots
+            // still leased after their own flight retired (a submission's
+            // notifier owner, held for its later renders).
+            let slots = self.work_slots[index] + 16;
+            self.free_work[index].reserve(slots - self.free_work[index].len(), GFP_KERNEL)?;
+            let base = self.next_work_va;
+            let end = base.checked_add(16 * stride).ok_or(ENOSPC)?;
+            if end > WORK_BASE + WORK_WINDOW {
+                return Err(ENOSPC);
+            }
+            // Work VA only grows; a steady rise under constant load means
+            // leaked Work allocations.
+            pr_info!(
+                "G16: work arena refill render={} base={:#x} free=[{}, {}] flights={}\n",
+                render,
+                base,
+                self.free_work[0].len(),
+                self.free_work[1].len(),
+                self.flights.len()
+            );
+            // Failed refills retain their partial allocations, but no part of
+            // that range becomes available for a later Work or another arena.
+            self.next_work_va = end;
+            let fw = self._firmware_space.as_mut().ok_or(EIO)?;
+            for va in (base..end).step_by(stride as usize) {
+                fw.alloc(va, if render { 0x10000 } else { 0x4000 }, PROT_FW_PRIV_RW)?;
+                if render {
+                    fw.alloc(va + 0x10000, 0xc000, PROT_FW_SHARED_RW)?;
+                } else {
+                    fw.alloc(va + 0x4000, 0x4000, PROT_FW_SHARED_RW)?;
+                }
+            }
+            fw.sync();
+            self.work_arenas[index] = base..end;
+            self.work_slots[index] = slots;
+        }
+        let va = self.work_arenas[index].start;
+        self.work_arenas[index].start += stride;
+        Ok((va, None))
+    }
+
+    /// Collect storage whose context destruction firmware has consumed. Retire
+    /// polls this too, so the half-ring comparison sees each target promptly.
+    /// It must not allocate: publication reserved each free-list slot.
+    pub(super) fn collect_destroyed_queues(&mut self) -> Result {
+        if self.destroying_queues.is_empty() {
+            return Ok(());
+        }
+        let guard = self._sgx.try_access().ok_or(ENODEV)?;
+        let read = guard.try_read32(0xd640c0)?;
+        let done = guard.try_read32(0xd640c8)?;
+        drop(guard);
+        if read >= 256 || done >= 256 {
+            return Err(EIO);
+        }
+        let mut i = 0;
+        while i < self.destroying_queues.len() {
+            let (base, target) = self.destroying_queues[i];
+            if reached(read, target, 256) && reached(done, target, 256) {
+                self.destroying_queues.swap_remove(i);
+                self.free_queues
+                    .push_within_capacity(base)
+                    .map_err(|_| EIO)?;
+            } else {
+                i += 1;
+            }
+        }
+        Ok(())
+    }
+
+    /// Firmware may still hold a retired queue's context ID binding, so the
+    /// context is destroyed before its storage serves another queue.
+    pub(super) fn recycle_queues(&mut self) -> Result {
+        self.collect_destroyed_queues()?;
+        loop {
+            self.destroying_queues.reserve(1, GFP_KERNEL)?;
+            self.free_queues
+                .reserve(self.destroying_queues.len() + 1, GFP_KERNEL)?;
+            let Some(base) = self.retired_queues.lock().pop() else {
+                return Ok(());
+            };
+            match self.destroy_queue_context(base)? {
+                Some(target) => self.destroying_queues.push((base, target), GFP_KERNEL)?,
+                None => {
+                    // The control ring is full. Its slot was just vacated.
+                    let _ = self.retired_queues.lock().push_within_capacity(base);
+                    return Ok(());
+                }
+            }
+        }
+    }
+
+    /// Publish a context destruction without waiting, as growth replies are.
+    /// Returns the control cursor that acknowledges it, or None when full.
+    pub(super) fn destroy_queue_context(&mut self, base: u64) -> Result<Option<u32>> {
+        let context = base + 0x4140;
+        let fw = self._firmware_space.as_mut().ok_or(EIO)?;
+        let ids = fw.read_u32(context)?;
+        let fields = [
+            (fw.read_u32(context + 0x24)? >> 16) as u8,
+            ids as u8,
+            (ids >> 8) as u8,
+            fw.read_u32(context + 4)? as u8,
+        ];
+        let guard = self._sgx.try_access().ok_or(ENODEV)?;
+        let head = guard.try_read32(0xd640c0)?;
+        let ack = guard.try_read32(0xd640c8)?;
+        let tail = guard.try_read32(0xd60060)?;
+        drop(guard);
+        if head >= 256 || ack >= 256 || tail >= 256 {
+            return Err(EIO);
+        }
+        let successor = (tail + 1) & 255;
+        if successor == head || successor == ack {
+            return Ok(None);
+        }
+        let control = g16_fw::MainConfig::bootstrap(g16_fw::BUNDLE_ADDRESS).channels[12].ring;
+        fw.write_live(
+            control + u64::from(tail) * 64,
+            &g16_fw::destroy_context(context, fields),
+        )?;
+        crate::mem::sync();
+        let guard = self._sgx.try_access().ok_or(ENODEV)?;
+        guard.try_write32(successor, 0xd60060)?;
+        drop(guard);
+        crate::mem::sync();
+        self._rtkit
+            .as_mut()
+            .send_message(0x21, 0x0084_0000_0000_0011)?;
+        Ok(Some(successor))
+    }
+
+    /// Initialize three lanes in `base`, which is newly allocated or recycled.
+    /// `identity` is a fresh address whose page index names the queues, so a
+    /// recycled queue never reuses a destroyed queue's identity.
+    pub(super) fn init_queues(
+        &mut self,
+        owner: &FirmwareQueues,
+        base: u64,
+        identity: u64,
+        fresh: bool,
+    ) -> Result<[Lane; 3]> {
+        use crate::pgtable::prot::{PROT_FW_PRIV_RW, PROT_FW_SHARED_RW};
+        use g16_fw::queue as q;
+
+        let lanes: [Lane; 3] = core::array::from_fn(|stage| {
+            let queue = base + stage as u64 * 0xc000;
+            Lane {
+                queue,
+                pointers: queue + 0x4000,
+                ring: queue + 0x8000,
+                head: 0,
+                new: true,
+            }
+        });
+        if fresh {
+            // Reserve before the region exists, so it can always be retired.
+            let total = self.queue_regions + 1;
+            let mut retired = self.retired_queues.lock();
+            let additional = total - retired.len();
+            retired.reserve(additional, GFP_KERNEL)?;
+            drop(retired);
+            self.queue_regions = total;
+        }
+        let fw = self._firmware_space.as_mut().ok_or(EIO)?;
+        for lane in &lanes {
+            if fresh {
+                fw.alloc(lane.queue, 0x4000, PROT_FW_PRIV_RW)?;
+                fw.alloc(lane.pointers, 0x8000, PROT_FW_SHARED_RW)?;
+            } else {
+                // Restore a new allocation's zeroed state, including the
+                // firmware-private words after each queue descriptor.
+                fw.zero_live(lane.queue, 0x4000)?;
+                fw.zero_live(lane.pointers, 0x8000)?;
+            }
+        }
+        // A notifier list and GPU context belong to the public queue,
+        // shared only by its own vertex, fragment and compute lanes.
+        let jobs = base + 0x4100;
+        let context = base + 0x4140;
+        for (stage, lane) in lanes.iter().enumerate() {
+            let named = identity + stage as u64 * 0xc000;
+            let mut descriptor = q::Queue {
+                pointers: lane.pointers,
+                ring: lane.ring,
+                jobs,
+                private: lane.queue + 0xb0,
+                context,
+                uuid: ((named - 0xffff_fc22_0000_0000) >> 14) as u32 + 2,
+            }
+            .encode_priority(owner.priority)
+            .ok_or(EINVAL)?;
+            // Native TA/3D profiles allow firmware to suspend and restart
+            // renders. Their Work/scratch leases survive until the final
+            // notifier/driver stamp, including intervening partial runs.
+            // Compute remains non-preemptible, matching the M1/M2 driver;
+            // Metal's compute queues use the native preemptible profile.
+            let preemptible = stage != 2;
+            if !preemptible {
+                descriptor[0x30..0x34].copy_from_slice(&0u32.to_le_bytes());
+                descriptor[0x48..0x4c].copy_from_slice(&1u32.to_le_bytes());
+            }
+            fw.write_live(lane.queue, &descriptor)?;
+            fw.write_live(lane.pointers, &q::pointers(0x500, 0))?;
+            // A newly created timeline starts immediately before its first
+            // target. This also permits qualification near stamp rollover.
+            let (ordinal, first) = match stage {
+                0 => (owner.render_count, 0xc00),
+                1 => (owner.render_count, 0x100),
+                _ => (owner.compute_count, 0x100),
+            };
+            let current = g16_stamp::previous(g16_stamp::value(ordinal, first));
+            fw.write_live(lane.firmware_stamp(), &current.to_le_bytes())?;
+            if stage < 2 {
+                fw.write_live(lane.driver_stamp(), &current.to_le_bytes())?;
+            }
+        }
+        fw.write_live(jobs, &q::jobs(jobs))?;
+        fw.write_live(context, &q::context())?;
+        let notifier = render_notifier(&lanes);
+        let count = render_notifier_count(&lanes);
+        fw.write_live(notifier, &[0u8; 0x100])?;
+        fw.write_live(notifier, &count.to_le_bytes())?;
+        fw.write_live(notifier + 0x10, &0x50u32.to_le_bytes())?;
+        fw.write_live(count, &0u32.to_le_bytes())?;
+        fw.sync();
+        Ok(lanes)
+    }
+
+    /// For the SUBMIT ioctl: allocate the queue's firmware rings now rather
+    /// than at its first publication.
+    pub(crate) fn provision_queue(&mut self, owner: &mut FirmwareQueues) -> Result {
+        if self.render_failed {
+            return Err(EIO);
+        }
+        self.prepare_lanes(owner)
+    }
+
+    /// For the SUBMIT ioctl: create the VM root's TVB pool now rather than
+    /// at its first render publication.
+    pub(crate) fn provision_tvb(&mut self, client: &mut g16_vm::AddressSpace, support: &Support) -> Result {
+        if self.render_failed {
+            return Err(EIO);
+        }
+        self.tvb_pool(client, support).map(|_| ())
+    }
+
+    /// The index of the client root's TVB pool, created on first use. Not
+    /// inlined: its creation path would otherwise enlarge the job worker's frame.
+    #[inline(never)]
+    pub(super) fn tvb_pool(&mut self, client: &mut g16_vm::AddressSpace, support: &Support) -> Result<usize> {
+        let root = client.roots().low;
+        if let Some(index) = self.tvb_pools.iter().position(|p| p.root == root) {
+            return Ok(index);
+        }
+        self.tvb_pools.reserve(1, GFP_KERNEL)?;
+        let base = self.next_object_va;
+        self.next_object_va = base.checked_add(0x44000).ok_or(ENOSPC)?;
+        let pool = crate::g16_tvb::Tvb::new(
+            self._firmware_space.as_mut().ok_or(EIO)?,
+            client,
+            base,
+            7 + u64::from(support.index),
+        )?;
+        self.tvb_pools.push_within_capacity(pool).map_err(|_| ENOMEM)?;
+        Ok(self.tvb_pools.len() - 1)
+    }
+
+    pub(super) fn prepare_queues(&mut self, owner: &mut FirmwareQueues) -> Result {
+        self.prepare_lanes(owner)?;
+        self.prepare_events(owner)
+    }
+
+    /// The queue's firmware rings, allocated once per public queue. Not
+    /// inlined, like `tvb_pool`: it is cold and its frame is large.
+    #[inline(never)]
+    pub(super) fn prepare_lanes(&mut self, owner: &mut FirmwareQueues) -> Result {
+        if owner.lanes.is_none() {
+            self.recycle_queues()?;
+            let identity = self.next_object_va;
+            self.next_object_va = identity.checked_add(0x24000).ok_or(ENOSPC)?;
+            let recycled = self.free_queues.pop();
+            let base = recycled.unwrap_or(identity);
+            let lanes = match self.init_queues(owner, base, identity, recycled.is_none()) {
+                Ok(lanes) => lanes,
+                Err(error) => {
+                    // A failed fresh allocation keeps any partial regions
+                    // owned, like a failed Work refill; recycled storage returns.
+                    if let Some(base) = recycled {
+                        let _ = self.free_queues.push_within_capacity(base);
+                    }
+                    return Err(error);
+                }
+            };
+            owner.storage = Some(QueueStorage {
+                base,
+                retired: self.retired_queues.clone(),
+            });
+            owner.lanes = Some(lanes);
+            for c in &owner.cursors {
+                c.set((u32::MAX, u32::MAX));
+            }
+            owner.notified_works = 0;
+            if crate::module_parameters::fw_trace.value() & 1 != 0 {
+                dev_info!(
+                    self.dev.as_ref(),
+                    "G16: queues vertex={:#x} fragment={:#x} compute={:#x} priority={} recycled={}\n",
+                    lanes[0].queue,
+                    lanes[1].queue,
+                    lanes[2].queue,
+                    owner.priority,
+                    recycled.is_some()
+                );
+            }
+        }
+        Ok(())
+    }
+
+    /// An event index for each busy period of the queue (released when its
+    /// last Work retires). EBUSY while all are in use: admission retries.
+    pub(super) fn prepare_events(&mut self, owner: &mut FirmwareQueues) -> Result {
+        if owner.events.is_none() {
+            // Bits 0-31 are the event indices in use; a queue takes the
+            // lowest free one.
+            let mut picked = 0u32;
+            self.queue_events
+                .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                    let free = !(value as u32);
+                    if free == 0 {
+                        return None;
+                    }
+                    picked = free.trailing_zeros();
+                    Some(value | (1 << picked))
+                })
+                .map_err(|_| {
+                    self.report_pressure(8, "events");
+                    EBUSY
+                })?;
+            if crate::module_parameters::fw_trace.value() & 256 != 0 && owner.last_event != Some(picked) {
+                pr_info!("G16: queue event index {:?} -> {}\n", owner.last_event, picked);
+            }
+            owner.last_event = Some(picked);
+            if let Some(lanes) = owner.lanes {
+                for (stage, lane) in lanes.iter().enumerate() {
+                    self.set_lane_event(lane.firmware_stamp(), 32 + picked * 3 + stage as u32);
+                }
+            }
+            owner.events = Some(QueueEvents {
+                slots: self.queue_events.clone(),
+                index: picked,
+            });
+        }
+        Ok(())
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_runtime_render.rs b/drivers/gpu/drm/asahi/g16_runtime_render.rs
new file mode 100644
index 0000000000000..2809542abe735
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_runtime_render.rs
@@ -0,0 +1,719 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+
+//! Render submission: dependency resolution and item elision, then building
+//! and publishing a render's TA and 3D Works.
+
+use super::*;
+
+impl Bootstrap {
+    /// Count a firmware dependency item and decide whether to drop it as
+    /// redundant: when this lane's previous Work already waited on that stamp
+    /// or a later one (Works on a lane start in order), or when the stamp has
+    /// already been reached at publish. An item on the same lane's earlier
+    /// Work is only counted: lane order implies it, but it is kept.
+    pub(super) fn elide_item(
+        &self,
+        queue: &FirmwareQueues,
+        lane: usize,
+        dep: &Stamp,
+        same_lane: bool,
+        tally: &mut DepTally,
+    ) -> Result<bool> {
+        use crate::g16_timeline as t;
+        tally.items += 1;
+        let drop = if same_lane {
+            tally.same_lane += 1;
+            false
+        } else if queue.waited[lane]
+            .iter()
+            .flatten()
+            .any(|w| w.address == dep.address && g16_stamp::reached(w.value, dep.value))
+        {
+            tally.repeat += 1;
+            true
+        } else {
+            let before = t::reads();
+            // The last retire scan's value: stamps only advance, so a value
+            // that already reached the target still does.
+            let now = self.last_scan.peek(dep.address);
+            t::attribute(&t::P_RD_ELIDE, before);
+            let reached = now.is_some_and(|v| g16_stamp::reached(v, dep.value));
+            if reached {
+                tally.reached += 1;
+            }
+            reached
+        };
+        if drop {
+            tally.dropped += 1;
+        }
+        Ok(drop)
+    }
+
+    /// The lane a render's dependency item sits on: slot 0 (render) on the
+    /// fragment lane with a fragment barrier, else the tiling lane.
+    pub(super) fn render_item_lane(params: &render::Parameters, slot: usize) -> usize {
+        usize::from(slot == 0 && params.vdm_barrier_fragment)
+    }
+
+    pub(super) fn resolve_render_dependencies(
+        &self,
+        queue: &mut FirmwareQueues,
+        params: &render::Parameters,
+        dependencies: &[Option<Stamp>; 2],
+        tally: &mut DepTally,
+    ) -> Result<[Option<Stamp>; 2]> {
+        let own_fragment = queue.lanes.as_ref().map(|lanes| lanes[1].firmware_stamp());
+        let mut kept = *dependencies;
+        for (slot, dep) in dependencies.iter().enumerate() {
+            let Some(dep) = dep else { continue };
+            let lane = Self::render_item_lane(params, slot);
+            let same_lane = lane == 1 && own_fragment == Some(dep.address);
+            if self.elide_item(queue, lane, dep, same_lane, tally)? {
+                kept[slot] = None;
+            }
+        }
+        Ok(kept)
+
+    }
+
+    pub(crate) fn submit_render(
+        &mut self,
+        queues: Arc<Mutex<FirmwareQueues>>,
+        owner: Arc<Mutex<g16_vm::AddressSpace>>,
+        params: &render::Parameters,
+        support: &Support,
+        timestamps: [u64; 4],
+        dependencies: &[Option<Stamp>; 2],
+        job: u64,
+    ) -> Result<Receipt> {
+        let _t = crate::g16_timeline::Timer::start(&crate::g16_timeline::P_SUBMIT_RENDER);
+        if self.render_failed {
+            return Err(EIO);
+        }
+        let mut mesh_params;
+        // The VM's latched mode, not the current one: a VM created native keeps
+        // decoding its streams after a runtime switch to 0.
+        let mesh_mode = support.mode;
+        // Peek at the first word without waiting for producers: an ordinary
+        // header publishes as at native_mesh=0, with no stall behind earlier
+        // work. Userspace writes a native header on the CPU before SUBMIT, and
+        // no GPU job rewrites a render's first word (Honeykrisp audit,
+        // 2026-10-24), so a stale read can only see a native header that is
+        // gone by now: that case still waits and decodes, which is
+        // authoritative. An unreadable first word also waits and then fails
+        // in the decode, as before.
+        let params = if mesh_mode.enabled()
+            && owner.lock().command_word(params.encoder).map_or(true, g16_mesh::may_be_native)
+        {
+            mesh_params = *params;
+            let params = &mut mesh_params;
+            // These are the raw producer dependencies, before same-lane wait
+            // elision. A firmware barrier alone cannot protect a CPU read.
+            let fw = self._firmware_space.as_ref().ok_or(EIO)?;
+            for dep in dependencies.iter().flatten() {
+                if !g16_stamp::reached(fw.read_u32(dep.address)?, dep.value) {
+                    crate::g16_timeline::DEFERRED_CPU_HOLD.fetch_add(1, Ordering::Relaxed);
+                    return Err(EBUSY);
+                }
+            }
+            let mut client = owner.lock();
+            params.mesh = g16_mesh::decode(params.encoder, mesh_mode, |va| client.command_word(va).ok())
+                .map_err(|error| match error {
+                    g16_mesh::DecodeError::Unmapped => EFAULT,
+                    g16_mesh::DecodeError::Unsupported => EOPNOTSUPP,
+                })?;
+            drop(client);
+            if params.mesh.is_some() && (params.samples != 1 || params.layers != 1) {
+                return Err(EOPNOTSUPP);
+            }
+            // A VM that first rendered with native_mesh=0 keeps its ordinary
+            // support header, which cannot run a native stream.
+            if params.mesh.is_some() && !support.native {
+                return Err(EOPNOTSUPP);
+            }
+            // The VM already owns and advertises all 24 operand buffers.
+            // This initialized pool serves both ordinary and native Work.
+            &mesh_params
+        } else {
+            params
+        };
+        let mut queue = queues.lock();
+        let mut tally = DepTally::default();
+        let resolved = self.resolve_render_dependencies(&mut queue, params, dependencies, &mut tally)?;
+        let dependencies = &resolved;
+        let root = owner.lock().roots().low;
+        let initbm = !self
+            .tvb_pools
+            .iter()
+            .any(|p| p.root == root && p.initialized);
+        self.reserve_flight(
+            &queue,
+            true,
+            root,
+            [
+                1 + u32::from(initbm) + dependencies.iter().flatten().count() as u32,
+                2,
+                0,
+            ],
+        )?;
+        self.prepare_queues(&mut queue)?;
+        let result = self.submit_render_queue(
+            &mut queue,
+            queues.clone(),
+            owner,
+            params,
+            support,
+            timestamps,
+            dependencies,
+            job,
+        );
+        if queue.pending == 0 {
+            queue.events = None;
+        }
+        if result.is_ok() {
+            tally.publish();
+        }
+        result
+    }
+
+    pub(super) fn submit_render_queue(
+        &mut self,
+        queue: &mut FirmwareQueues,
+        queues: Arc<Mutex<FirmwareQueues>>,
+        owner: Arc<Mutex<g16_vm::AddressSpace>>,
+        params: &render::Parameters,
+        support: &Support,
+        timestamps: [u64; 4],
+        dependencies: &[Option<Stamp>; 2],
+        job: u64,
+    ) -> Result<Receipt> {
+        let mut guard = owner.lock();
+        let client = &mut *guard;
+        // The SUBMIT ioctl created the pool (provision_tvb); this finds it.
+        let index = self.tvb_pool(client, support)?;
+        let scene = self.tvb_pools[index].reserve_scene().inspect_err(|_| {
+            self.report_pressure(4, "scenes");
+        })?;
+        let mut pool = self.tvb_pools.swap_remove(index);
+        // Out of `self` while publication also borrows it; always returned.
+        let mut encodings = core::mem::take(&mut self.encodings);
+        let result = self.submit_render_pool(
+            client,
+            params,
+            support,
+            queue,
+            queues,
+            &mut pool,
+            &mut encodings,
+            owner.clone(),
+            scene,
+            timestamps,
+            dependencies,
+            job,
+        );
+        self.encodings = encodings;
+        if result.is_err() && !self.render_failed {
+            pool.release_scene(scene);
+        }
+        // Back into the slot swap_remove freed: no allocation.
+        self.tvb_pools.push_within_capacity(pool).map_err(|_| EIO)?;
+        result
+    }
+
+    #[inline(never)]
+    pub(super) fn submit_render_pool(
+        &mut self,
+        client: &mut g16_vm::AddressSpace,
+        params: &render::Parameters,
+        support: &Support,
+        queue: &mut FirmwareQueues,
+        queues: Arc<Mutex<FirmwareQueues>>,
+        pool: &mut crate::g16_tvb::Tvb,
+        encodings: &mut Encodings,
+        owner: Arc<Mutex<g16_vm::AddressSpace>>,
+        scene: u32,
+        timestamps: [u64; 4],
+        dependencies: &[Option<Stamp>; 2],
+        job: u64,
+    ) -> Result<Receipt> {
+        if self.render_failed {
+            return Err(EIO);
+        }
+        if !params.valid() || !(2..=3).contains(&queue.priority) {
+            return Err(EINVAL);
+        }
+        let space = client.roots();
+        let mut params = *params;
+        params.tiling_admission = pool.addresses.buffer_manager_slot;
+        params.fragment_admission = pool.addresses.buffer_manager_slot;
+        // These accelerator pointers must select the same leased scene as
+        // BufferThing. Reusing scene 1 here corrupts other in-flight renders.
+        params.scene_slot = u64::from(scene);
+        params.cycle = 0x240000 + u64::from(scene) * 0x30;
+        let scratch = client.prepare_render(&mut params)?;
+        let mut a = render::Addresses::bootstrap().publication(self.render_publication);
+        pool.work_addresses(&mut a, scene);
+        // Keep profiling storage private to the Work. Public timestamp BOs
+        // are written by the firmware through its separate user destinations.
+        let lanes = queue.lanes.as_ref().ok_or(EIO)?;
+        a.tiling_queue = lanes[0].queue;
+        a.fragment_queue = lanes[1].queue;
+        a.tiling_event = u64::from(queue.event(0)?);
+        a.fragment_event = u64::from(queue.event(1)?);
+        a.support = support.address();
+        a.render_shared_state = support.shared_state();
+        a.tiling_status_page = params.ta_status & !0x3fff;
+        a.fragment_status_page = params.fragment_status & !0x3fff;
+        let queue_ordinal = queue.render_count;
+        a.fragment_counter = queue_ordinal.wrapping_mul(2);
+        a.tiling_counter = a.fragment_counter.wrapping_add(1);
+        // Firmware's dependency graph requires consecutive stamp updates
+        // within each lane, even when other queues publish between them.
+        a.fragment_stamp = u64::from(g16_stamp::value(queue_ordinal, 0x100));
+        a.tiling_stamp = u64::from(g16_stamp::value(queue_ordinal, 0xc00));
+        let (va, aliased) = self.allocate_work(true)?;
+        a.tiling_shared_tail = va + 0x10000;
+        a.fragment_shared_tail = va + 0x14000;
+        // The notifier pass stores driver stamps, then sends the IRQ after
+        // a DSB. These destinations must be firmware-uncached: a DSB does
+        // not clean a cached stamp, leaving Linux asleep on stale memory.
+        // Each render has its own driver stamps and, with shared_notifier=0,
+        // its own notifier and count. A notifier shared by the whole queue
+        // with a cumulative count (2026-10-03 to 10-27) was announced only
+        // once every Work published to it had completed, so a busy queue
+        // waited for the safety poll; one per submission (below) is not.
+        // The Work count lives with the stamps in the firmware-uncached page:
+        // a shared notifier's count is raised while the firmware reads it.
+        a.event_control = va + 0x200;
+        a.event_count_array = va + 0x18080;
+        a.tiling_driver_stamp = va + 0x18000;
+        a.fragment_driver_stamp = va + 0x18040;
+        // shared_notifier=1: the submission's renders share the notifier of
+        // its first published render (the owner), as Metal shares one per
+        // command buffer. Like Metal, each render raises the notifier's Work
+        // count by its own two Works as it is published: the owner writes
+        // the header with count 2, the others the new count and their driver
+        // stamps. The count never runs ahead of what was published. A render
+        // published after the owner has retired (a submission held back)
+        // starts a fresh notifier rather than re-arming one that may have
+        // drained, which Metal, publishing a command buffer at once, never does.
+        let job_owner = if crate::g16_timeline::shared_notifier() {
+            let owner = self
+                .job_notifiers
+                .iter()
+                .find(|j| j.job == job && j.owner_root.is_none())
+                .map(|j| j.owner);
+            let owner_va = owner.unwrap_or(va);
+            a.event_control = owner_va + 0x200;
+            a.event_count_array = owner_va + 0x18080;
+            Some((owner_va, owner.is_none()))
+        } else {
+            None
+        };
+        // What this render writes into the notifier: the full header (its
+        // own notifier, or a submission's first) and the Work count.
+        let notifier_write = match job_owner {
+            None | Some((_, true)) => (true, 2u32),
+            Some((owner_va, false)) => {
+                let entry = self.job_notifiers.iter().find(|j| j.owner == owner_va).ok_or(EIO)?;
+                (false, entry.works + 2)
+            }
+        };
+        // Fail before publication: past it, a render must have its Flight.
+        if matches!(job_owner, Some((_, true))) && self.job_notifiers.len() == self.job_notifiers.capacity() {
+            return Err(EIO);
+        }
+
+        a.tiling_firmware_stamp = lanes[0].firmware_stamp();
+        a.fragment_firmware_stamp = lanes[1].firmware_stamp();
+        let alias = 0x72_0000_0000 + (va - WORK_BASE);
+        if alias + 0x8000 > 0x73_0000_0000 {
+            return Err(ENOSPC);
+        }
+        let fw = self._firmware_space.as_mut().ok_or(EIO)?;
+        // A reused slot keeps its device alias, and its client alias when it
+        // returns to the same root: skip those page-table walks.
+        let client_mapped = aliased == Some(space.low);
+        for stage in 0..2u64 {
+            let work_page = va + stage * 0x8000;
+            let register_page = alias + stage * 0x4000;
+            if aliased.is_none() || !client_mapped {
+                let pa = fw.physical(work_page)?;
+                if aliased.is_none() {
+                    self._address_space.as_mut().ok_or(EIO)?.map_work_alias(register_page, pa)?;
+                }
+                if !client_mapped {
+                    client.map_work_alias(register_page, pa)?;
+                }
+            }
+            for view in [self._address_space.as_mut().ok_or(EIO)?, &mut *client] {
+                view.sync();
+            }
+            if stage == 0 {
+                a.tiling_work = work_page + (a.tiling_work & 0x3fff);
+                a.tiling_microsequence = work_page + 0x4000 + (a.tiling_microsequence & 0x3fff);
+                a.tiling_prelude = work_page + 0x4000;
+                a.tiling_register_alias = register_page + (a.tiling_register_alias & 0x3fff);
+            } else {
+                a.fragment_work = work_page + (a.fragment_work & 0x3fff);
+                a.fragment_microsequence = work_page + 0x4000 + (a.fragment_microsequence & 0x3fff);
+                a.fragment_prelude = work_page + 0x4000;
+                a.fragment_register_alias = register_page + (a.fragment_register_alias & 0x3fff);
+            }
+        }
+        fw.sync();
+        self.invalidate_client(self._address_space.as_ref().ok_or(EIO)?);
+        self.invalidate_client(client);
+        // A live context lease keeps these roots fixed through retirement.
+        a.context_id = u64::from(self.acquire_context(space, 9)?);
+        a.tiling_user_timestamp_start = timestamps[0];
+        a.tiling_user_timestamp_end = timestamps[1];
+        a.fragment_user_timestamp_start = timestamps[2];
+        a.fragment_user_timestamp_end = timestamps[3];
+        // From here any publication failure quarantines the roots.
+        self.render_failed = true;
+        let (ta, frag) = (&mut encodings.tiling, &mut encodings.fragment);
+        ta.fill(0);
+        frag.fill(0);
+        // The ioctl validated the parameters and every address here is the
+        // kernel's own, so a failed encoding is a driver bug, not bad input.
+        if params.tiling_work(&a, ta).is_none() || params.fragment_work(&a, frag).is_none() {
+            pr_err!("G16: render Work encoding failed for ioctl-validated parameters\n");
+            return Err(EIO);
+        }
+        // No per-Work start or tiling-end profiling stamps; fragment end
+        // uses one location shared by the queue, separate from UAPI timestamps.
+        ta[0x8c8..0x8d8].fill(0);
+        frag[0xc10..0xc18].fill(0);
+        frag[0xc18..0xc20].copy_from_slice(&(lanes[1].pointers + 0x2080).to_le_bytes());
+        if crate::module_parameters::fw_trace.value() & 128 != 0
+            && !CONFIG_DUMPED.swap(true, Ordering::Relaxed)
+        {
+            // Live firmware configuration, for comparison with macOS.
+            let fw = self._firmware_space.as_ref().ok_or(EIO)?;
+            for (base, size) in [
+                (0xffff_fc20_0010_0000u64, 0x4000u64),
+                (0xffff_fc20_0010_8000, 0x4000),
+                (0xffff_fc20_000f_8000, 0x4000),
+                (0xffff_fc20_c04d_8000, 0x20000),
+                (0xffff_fc20_0003_e000, 0x2000),
+            ] {
+                for line in (base..base + size).step_by(32) {
+                    let words = [
+                        fw.read_u64(line)?,
+                        fw.read_u64(line + 8)?,
+                        fw.read_u64(line + 16)?,
+                        fw.read_u64(line + 24)?,
+                    ];
+                    if words != [0; 4] {
+                        pr_info!(
+                            "G16: cfgdump {:#x}: {:016x} {:016x} {:016x} {:016x}\n",
+                            line, words[0], words[1], words[2], words[3]
+                        );
+                    }
+                }
+            }
+        }
+        if crate::module_parameters::fw_trace.value() & 32 != 0 && queue_ordinal == 10 {
+            pr_info!(
+                "G16: work dump TA={:#x} 3D={:#x} queues={:#x}/{:#x} bm={:#x} thing={:#x} support={:#x} micro={:#x}/{:#x}\n",
+                a.tiling_work, a.fragment_work, a.tiling_queue, a.fragment_queue,
+                a.buffer_manager, a.buffer_thing, a.support,
+                a.tiling_microsequence, a.fragment_microsequence
+            );
+            for (name, bytes) in [("TA", &ta[..]), ("3D", &frag[..])] {
+                for (i, chunk) in bytes.chunks(32).enumerate() {
+                    pr_info!("G16: work {} {:#06x}: {:02x?}\n", name, i * 32, chunk);
+                }
+            }
+        }
+        // TVB initialization and first publication of a firmware queue are
+        // independent: several public queues can share one VM's TVB pool.
+        let initbm = !pool.initialized;
+
+        // The shared count covers individual Work items, not render pairs.
+        // Firmware retires one tiling and one fragment item per submission.
+        let submitted = support.submissions.load(Ordering::Relaxed);
+        let next_submitted = submitted.wrapping_add(2);
+        // Firmware observes the low word of this cumulative count.
+        let use_count = next_submitted as u32;
+        // From here an error conservatively quarantines the client root.
+        self.render_failed = true;
+        self._firmware_space
+            .as_mut()
+            .ok_or(EIO)?
+            .write_live(a.render_shared_state, &use_count.to_le_bytes())?;
+        pool.increment(self._firmware_space.as_mut().ok_or(EIO)?)?;
+        let own = queue.lanes.map_or([0; 3], |l| l.map(|lane| lane.firmware_stamp()));
+        self.note_dependency_events(dependencies, own);
+        let (heads, epochs, lane_items) = self.publish_render(
+            &a, &ta, &frag, queue, initbm, pool.blocks, dependencies,
+            params.vdm_barrier_fragment, notifier_write,
+        )?;
+        pool.initialized = true;
+        support.submissions.store(next_submitted, Ordering::Relaxed);
+        self.render_publication = self.render_publication.wrapping_add(1);
+        queue.render_count = queue_ordinal.wrapping_add(1);
+        // A shared notifier's completed count (+0xc) reaches this render's
+        // running total within the submission once both its Works are done.
+        let notifier_count = match job_owner {
+            None => None,
+            Some((owner_va, first)) => {
+                if first {
+                    self.job_notifiers
+                        .push_within_capacity(JobNotifier {
+                            job,
+                            owner: owner_va,
+                            owner_root: None,
+                            works: 0,
+                            refs: 0,
+                        })
+                        .map_err(|_| EIO)?;
+                }
+                let entry = self.job_notifiers.iter_mut().find(|j| j.owner == owner_va).ok_or(EIO)?;
+                entry.works += 2;
+                entry.refs += 1;
+                Some((a.event_control + 0xc, entry.works))
+            }
+        };
+        let job_notifier = job_owner.map(|(owner_va, _)| owner_va);
+        let lanes = queue.lanes.as_mut().ok_or(EIO)?;
+        for stage in 0..2 {
+            lanes[stage].head = heads[stage];
+            lanes[stage].new = false;
+        }
+        let stamp = Stamp {
+            address: a.fragment_firmware_stamp,
+            value: a.fragment_stamp as u32,
+            event: a.fragment_event as u32,
+        };
+        let receipt = Receipt { id: va, stamp };
+        queue.last[0] = Some(stamp);
+        for (slot, dep) in dependencies.iter().enumerate() {
+            if let Some(dep) = dep {
+                FirmwareQueues::note_wait(&mut queue.waited, Self::render_item_lane(&params, slot), *dep);
+            }
+        }
+        queue.pending += 1;
+        self.flights.push_within_capacity(
+            Flight {
+                id: va,
+                owner: queues,
+                context: a.context_id as u32,
+                stream: params.encoder,
+                ordinal: queue_ordinal,
+                tgid: params.tgid,
+                comm: params.comm,
+                started: Instant::now(),
+                notifier_count,
+                job_notifier,
+                stamps_seen: None,
+                blocked: 0,
+                dependencies: *dependencies,
+                stamps: [
+                    Some(Stamp {
+                        address: a.tiling_firmware_stamp,
+                        value: a.tiling_stamp as u32,
+                        event: a.tiling_event as u32,
+                    }),
+                    Some(stamp),
+                ],
+                driver_stamps: [
+                    Some(Stamp {
+                        address: a.tiling_driver_stamp,
+                        value: a.tiling_stamp as u32,
+                        event: a.tiling_event as u32,
+                    }),
+                    Some(Stamp {
+                        address: a.fragment_driver_stamp,
+                        ..stamp
+                    }),
+                ],
+                scratch,
+                client: owner.clone(),
+                queues: [(lanes[0].pointers, heads[0]), (lanes[1].pointers, heads[1])],
+                lane_items,
+                channels: [
+                    (queue.priority as usize * 3, (epochs[0] + 1) & 255),
+                    (queue.priority as usize * 3 + 1, (epochs[1] + 1) & 255),
+                ],
+                render: Some(RenderFlight {
+                    addresses: a,
+                    client: owner,
+                    root: space.low,
+                    events: RenderEvents::default(),
+                    scene,
+                }),
+            },
+        )
+        .map_err(|_| EIO)?;
+        // Capacity was reserved with the flight in reserve_flight.
+        let flight = self.flights.last().ok_or(EIO)?;
+        self.ledger.add(flight)?;
+        self.render_failed = false;
+        self.batch_works += 1;
+        self.trace_publication("render", va)?;
+        self.trace_dependencies("render", va, a.context_id as u32, dependencies)?;
+        Ok(receipt)
+    }
+
+    pub(super) fn publish_render(
+        &mut self,
+        a: &render::Addresses,
+        ta: &[u8],
+        frag: &[u8],
+        queue: &FirmwareQueues,
+        initbm: bool,
+        blocks: u32,
+        dependencies: &[Option<Stamp>; 2],
+        vdm_barrier_fragment: bool,
+        notifier_write: (bool, u32),
+    ) -> Result<([u32; 2], [u32; 2], [u32; 2])> {
+        let priority = queue.priority;
+        let lanes = queue.lanes.as_ref().ok_or(EIO)?;
+        let publication = self.render_publication;
+        let firsts = [lanes[0].head, lanes[1].head];
+        // Only the render dependency can move to fragment. Compute output
+        // may feed the vertex stage, and input fences were already consumed
+        // by the scheduler before either lane was published.
+        let stage_dependencies = if vdm_barrier_fragment {
+            [[None, dependencies[1]], [dependencies[0], None]]
+        } else {
+            [*dependencies, [None, None]]
+        };
+        let heads = [
+            (firsts[0] + 1 + u32::from(initbm)
+                + stage_dependencies[0].iter().flatten().count() as u32)
+                % 0x500,
+            (firsts[1] + 2 + stage_dependencies[1].iter().flatten().count() as u32) % 0x500,
+        ];
+        // Every byte this render publishes, written as one batch: one region
+        // lookup per destination region and one barrier pair, rather than a
+        // lookup and two barriers for each of about twenty writes.
+        let context = (a.context_id as u32).to_le_bytes();
+        // The notifier header: the full header when this render owns the
+        // notifier (its own, or its submission's first), else only the raised
+        // Work count; then this render's driver stamps.
+        let count_array = a.event_count_array.to_le_bytes();
+        let fragment_stamp = (a.fragment_stamp as u32).to_le_bytes();
+        let zero = 0u32.to_le_bytes();
+        let flags = 0x50u32.to_le_bytes();
+        let count = notifier_write.1.to_le_bytes();
+        let tiling_previous = g16_stamp::previous(a.tiling_stamp as u32).to_le_bytes();
+        let fragment_previous = g16_stamp::previous(a.fragment_stamp as u32).to_le_bytes();
+        let own: [(u64, &[u8]); 8] = [
+            (a.event_control, &count_array[..]),
+            (a.event_control + 8, &fragment_stamp[..]),
+            (a.event_control + 12, &zero[..]),
+            (a.event_control + 0x10, &flags[..]),
+            (a.event_control + 0x24, &context[..]),
+            (a.event_count_array, &count[..]),
+            (a.tiling_driver_stamp, &tiling_previous[..]),
+            (a.fragment_driver_stamp, &fragment_previous[..]),
+        ];
+        let (own, header): (&[(u64, &[u8])], usize) = if notifier_write.0 {
+            (&own[..], own.len())
+        } else {
+            (&own[5..], 3)
+        };
+        let preludes = [a.tiling_prelude(blocks), a.fragment_prelude()];
+        let tiling_micro = a.tiling_microsequence();
+        let fragment_micro = a.fragment_microsequence();
+        // At most two dependency items and four ring entries per stage.
+        let mut items = [[[0u8; 0x40]; 2]; 2];
+        let mut entries = [[[0u8; 8]; 4]; 2];
+        let mut item_counts = [0usize; 2];
+        let mut entry_counts = [0usize; 2];
+        let render_kind = crate::module_parameters::dependency_kind.value();
+        for stage in 0..2 {
+            let (prelude, work) = if stage == 0 {
+                (a.tiling_prelude, a.tiling_work)
+            } else {
+                (a.fragment_prelude, a.fragment_work)
+            };
+            let (stamp, uuid) = if stage == 0 {
+                (a.tiling_stamp, a.tiling_uuid)
+            } else {
+                (a.fragment_stamp, a.fragment_uuid)
+            };
+            // The prelude page leaves +0x40..+0xc0 free before its
+            // microsequence. All barrier bytes share the Work's lifetime.
+            let deps = stage_dependencies[stage]
+                .iter()
+                .enumerate()
+                .filter_map(|(slot, dep)| dep.map(|d| (if slot == 0 { render_kind } else { 1 }, d)));
+            for (index, (kind, dep)) in deps.enumerate() {
+                items[stage][index] = g16_fw::queue::dependency(
+                    dep.address, dep.value, dep.event, stamp as u32, uuid as u32, kind,
+                );
+                entries[stage][entry_counts[stage]] = (prelude + 0x40 + index as u64 * 0x40).to_le_bytes();
+                item_counts[stage] += 1;
+                entry_counts[stage] += 1;
+            }
+            if stage == 1 || initbm {
+                entries[stage][entry_counts[stage]] = prelude.to_le_bytes();
+                entry_counts[stage] += 1;
+            }
+            entries[stage][entry_counts[stage]] = work.to_le_bytes();
+            entry_counts[stage] += 1;
+        }
+        // Write `n` of the batch, in order: the shared notifier's two words
+        // (firmware counts completions at +0xc and writes the lanes' driver
+        // stamps as they retire), then per stage the prelude, Work,
+        // microsequence, dependency items and ring entries (contiguous except
+        // where the ring wraps). Computed on demand: no list on the job
+        // worker's stack, and nothing to allocate.
+        let (ta, frag): (&[u8], &[u8]) = (ta, frag);
+        let preludes = &preludes;
+        let (tiling_micro, fragment_micro) = (&tiling_micro, &fragment_micro);
+        let (items, entries) = (&items, &entries);
+        let rings = [lanes[0].ring, lanes[1].ring];
+        let per_stage = move |stage: usize| 3 + item_counts[stage] + entry_counts[stage];
+        let count = header + per_stage(0) + per_stage(1);
+        let write = move |n: usize| {
+            if n < header {
+                return own[n];
+            }
+            let n = n - header + 2;
+            let (stage, k) = if n - 2 < per_stage(0) { (0, n - 2) } else { (1, n - 2 - per_stage(0)) };
+            let (prelude, work, micro) = if stage == 0 {
+                (a.tiling_prelude, a.tiling_work, a.tiling_microsequence)
+            } else {
+                (a.fragment_prelude, a.fragment_work, a.fragment_microsequence)
+            };
+            match k {
+                0 => (prelude, &preludes[stage][..]),
+                1 => (work, if stage == 0 { ta } else { frag }),
+                2 => (micro, if stage == 0 { &tiling_micro[..] } else { &fragment_micro[..] }),
+                k if k - 3 < item_counts[stage] => {
+                    let index = k - 3;
+                    (prelude + 0x40 + index as u64 * 0x40, &items[stage][index][..])
+                }
+                k => {
+                    let index = k - 3 - item_counts[stage];
+                    let pos = (firsts[stage] + index as u32) % 0x500;
+                    (rings[stage] + u64::from(pos) * 8, &entries[stage][index][..])
+                }
+            }
+        };
+        self._firmware_space.as_mut().ok_or(EIO)?.write_batch(count, write)?;
+        let mut epochs = [0; 2];
+        for stage in [1usize, 0] {
+            let mut lane = lanes[stage];
+            lane.head = heads[stage];
+            epochs[stage] = self.stage_queue(
+                priority as usize * 3 + stage,
+                lane,
+                if stage == 0 {
+                    a.tiling_event
+                } else {
+                    a.fragment_event
+                } as u32,
+                publication.wrapping_add(1),
+            )?;
+        }
+        let lane_items = stage_dependencies.map(|d| d.iter().flatten().count() as u32);
+        Ok((heads, epochs, lane_items))
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_runtime_retire.rs b/drivers/gpu/drm/asahi/g16_runtime_retire.rs
new file mode 100644
index 0000000000000..05cc4f6d38e45
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_runtime_retire.rs
@@ -0,0 +1,646 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright The Gravity Linux Contributors
+
+//! Retirement: completion scans of in-flight Works, render events (TVB
+//! growth, partial renders) and the pump's watchdog windows.
+
+use super::*;
+
+impl Bootstrap {
+    pub(super) fn stamps_done(&self, flight: &Flight) -> Result<bool> {
+        let fw = self._firmware_space.as_ref().ok_or(EIO)?;
+        for stamp in flight.stamps.iter().flatten() {
+            if !g16_stamp::reached(fw.read_u32(stamp.address)?, stamp.value) {
+                return Ok(false);
+            }
+        }
+        Ok(true)
+    }
+
+    /// Dispatch events by the outstanding Work identity, never by the most
+    /// recently submitted job. Completion notifications are hints; stamps and
+    /// ring retirement remain authoritative even if event bits coalesce.
+    pub(super) fn service_flights(&mut self) -> Result {
+        const STATE: u64 = 0xffff_fc20_0003_f1c0;
+        const RING: u64 = 0xffff_fc20_0003_f440;
+        for _ in 0..256 {
+            let fw = self._firmware_space.as_mut().ok_or(EIO)?;
+            let cursor = fw.read_u32(STATE)?;
+            let end = fw.read_u32(STATE + 0x20)?;
+            if cursor >= 256 || end >= 256 {
+                return Err(EIO);
+            }
+            if cursor == end {
+                break;
+            }
+            let base = RING + u64::from(cursor) * 0x48;
+            let kind = fw.read_u32(base)?;
+            if kind == 1
+                || (kind == 13
+                    && self.opening_notification_pending
+                    && fw.read_u32(base + 4)? == 1
+                    && fw.read_u32(base + 8)? == 0
+                    && fw.read_u64(base + 12)? == g16_fw::CONTROL_DATA
+                    && fw.read_u64(base + 20)? == g16_fw::OPERAND_TABLE
+                    && fw.read_u64(base + 28)? == g16_fw::OPERAND_TABLE
+                    && fw.read_u32(base + 36)? == 20 * 8)
+            {
+                if kind == 13 {
+                    self.opening_notification_pending = false;
+                }
+                fw.write_live(STATE, &((cursor + 1) & 255).to_le_bytes())?;
+                continue;
+            }
+            if kind == 0 || kind == 4 {
+                // Firmware fault (0) or timeout (4) report, as upstream's
+                // EventMsg::Fault/Timeout. Upstream fails the pending work and
+                // resumes the halted firmware; the G16 resume handshake is not
+                // known yet, so nothing can continue after one of these.
+                let what = if kind == 0 { "fault" } else { "timeout" };
+                dev_err!(self.dev.as_ref(), "G16: firmware {} event\n", what);
+                self.report_failed_event(base, kind, cursor)?;
+                return Err(EIO);
+            }
+            let mut selected = None;
+            for (index, flight) in self.flights.iter().enumerate() {
+                if let Some(render) = &flight.render {
+                    let a = &render.addresses;
+                    let matches = match kind {
+                        6 => {
+                            fw.read_u32(base + 4)? == a.context_id as u32
+                                && fw.read_u32(base + 8)? == a.buffer_manager_slot as u32
+                                && fw.read_u32(a.fragment_firmware_stamp)?
+                                    != a.fragment_stamp as u32
+                        }
+                        7 => {
+                            fw.read_u32(base + 12)? == a.fragment_event as u32
+                                && fw.read_u32(base + 16)? == a.fragment_stamp as u32
+                        }
+                        _ => false,
+                    };
+                    if matches {
+                        selected = Some(index);
+                        break;
+                    }
+                }
+            }
+            let Some(index) = selected else {
+                self.report_failed_event(base, kind, cursor)?;
+                return Err(EIO);
+            };
+            let mut render = self.flights[index].render.take().ok_or(EIO)?;
+            let pool_index = self
+                .tvb_pools
+                .iter()
+                .position(|p| p.root == render.root)
+                .ok_or(EIO)?;
+            let mut pool = self.tvb_pools.swap_remove(pool_index);
+            let result = self.service_render_events(
+                &mut render.client.lock(),
+                &mut pool,
+                &render.addresses,
+                &mut render.events,
+            );
+            // Back into the slot swap_remove freed: no allocation.
+            self.tvb_pools.push_within_capacity(pool).map_err(|_| EIO)?;
+            self.flights[index].render = Some(render);
+            result?;
+            if self._firmware_space.as_ref().ok_or(EIO)?.read_u32(STATE)? == cursor {
+                break;
+            }
+        }
+        self.drain_trace_rx()
+    }
+
+    pub(crate) fn retire(&mut self) -> Result<Option<(u64, Result)>> {
+        if self.render_failed {
+            return Err(EIO);
+        }
+        // One scan retires every finished flight; later calls return them
+        // without rereading firmware state for each one.
+        if let Some((id, limited)) = self.retired.pop() {
+            return Ok(Some((id, if limited { Err(ENOMEM) } else { Ok(()) })));
+        }
+        let before = crate::g16_timeline::reads();
+        let serviced = self.service_flights();
+        crate::g16_timeline::attribute(&crate::g16_timeline::P_RD_EVENTS, before);
+        let scan_before = crate::g16_timeline::reads();
+        serviced.inspect_err(|error| {
+            dev_err!(
+                self.dev.as_ref(),
+                "G16: firmware event service failed: {:?}\n",
+                error
+            );
+        })?;
+        self.collect_destroyed_queues()?;
+        let config = g16_fw::MainConfig::bootstrap(g16_fw::BUNDLE_ADDRESS);
+        // Device-wide transport state is the same for every flight: read each
+        // register once per scan instead of once per flight.
+        let mut channel_state: [Option<[u32; 2]>; 12] = [None; 12];
+        let control_replied = {
+            let guard = self._sgx.try_access().ok_or(ENODEV)?;
+            let tail = guard.try_read32(0xd60060)?;
+            guard.try_read32(0xd640c0)? == tail && guard.try_read32(0xd640c8)? == tail
+        };
+        // Preallocated to MAX_FLIGHTS, which bounds the flights scanned here.
+        if self.retired.capacity() < self.flights.len() {
+            return Err(EIO);
+        }
+        // Like upstream's per-queue event check, read each lane's stamp and
+        // ring cursors once per scan and judge every flight on that lane
+        // against the same snapshot: flights share a lane's stamp address
+        // with rising values. A completion after the read is retired by the
+        // pass its own notification triggers.
+        let mut snapshot = WordSnapshot::default();
+        let mut index = self.flights.len();
+        while index > 0 {
+            index -= 1;
+            let flight = &self.flights[index];
+            let fw = self._firmware_space.as_ref().ok_or(EIO)?;
+            let mut reached_all = true;
+            for stamp in flight.stamps.iter().flatten() {
+                if !g16_stamp::reached(snapshot.read(fw, stamp.address)?, stamp.value) {
+                    reached_all = false;
+                    break;
+                }
+            }
+            if !reached_all {
+                continue;
+            }
+            let mut done = true;
+            let mut blocked = 0u32;
+            let mut notifier_seen = None;
+            // The notifier pass drops embedded JobMeta references and cleans
+            // their cache lines before publishing these later driver stamps.
+            for stamp in flight.driver_stamps.iter().flatten() {
+                done &= g16_stamp::reached(snapshot.read(fw, stamp.address)?, stamp.value);
+            }
+            blocked |= u32::from(!done);
+            // A reusable Work has its own notifier and exact submitted count.
+            // Removal must be visible before that storage can change queues.
+            if done {
+                let notified = match flight.notifier_count {
+                    // The shared notifier has counted this render's Works.
+                    Some((completed, total)) => {
+                        let count = snapshot.read(fw, completed)?;
+                        notifier_seen = Some((count, total));
+                        (count.wrapping_sub(total) as i32) >= 0
+                    }
+                    None => {
+                        let notifier = flight.id
+                            + if flight.render.is_some() {
+                                0x200
+                            } else {
+                                0x1400
+                            };
+                        fw.read_u32(notifier + 0x94)? == 0
+                    }
+                };
+                blocked |= u32::from(!notified) << 1;
+                done &= notified;
+            }
+            if done {
+                for &(pointers, head) in &flight.queues {
+                    if pointers != 0 {
+                        let lane = reached(snapshot.read(fw, pointers)?, head, 0x500)
+                            && reached(snapshot.read(fw, pointers + 0x30)?, head, 0x500);
+                        blocked |= u32::from(!lane) << 2;
+                        done &= lane;
+                    }
+                }
+            }
+            if done {
+                for &(channel, target) in &flight.channels {
+                    if channel == usize::MAX {
+                        continue;
+                    }
+                    let state = match channel_state.get(channel).copied().flatten() {
+                        Some(state) => state,
+                        None => {
+                            let guard = self._sgx.try_access().ok_or(ENODEV)?;
+                            let mut state = [0; 2];
+                            for (value, address) in
+                                state.iter_mut().zip(&config.channels[channel].state[..2])
+                            {
+                                *value = guard.try_read32(
+                                    0xd64000 + (*address - 0xffff_fc20_0002_8000) as usize,
+                                )?;
+                            }
+                            if let Some(slot) = channel_state.get_mut(channel) {
+                                *slot = Some(state);
+                            }
+                            state
+                        }
+                    };
+                    for value in state {
+                        let consumed = reached(value, target, 256);
+                        blocked |= u32::from(!consumed) << 3;
+                        done &= consumed;
+                    }
+                }
+            }
+            // Growth replies can refer to a Work after its main stage stamp.
+            if flight.render.is_some() {
+                blocked |= u32::from(!control_replied) << 4;
+                done &= control_replied;
+            }
+            {
+                let flight = &mut self.flights[index];
+                if flight.stamps_seen.is_none() {
+                    flight.stamps_seen = Some(Instant::now());
+                }
+                if !done {
+                    flight.blocked = blocked;
+                }
+            }
+            if !done {
+                continue;
+            }
+            let flight = &self.flights[index];
+            if self.poll_scan {
+                // Classify each rescue. Stamps first seen in this very scan
+                // (after_stamps_us ~0) mean no scan ran between completion
+                // and the timeout: no notification came. Stamps seen earlier
+                // with retirement blocked (bit 1: the shared notifier's count
+                // short) mean the notification came and the retirement
+                // condition held the Work back. Rescues are rare; the limit
+                // only bounds a pathological boot.
+                use core::sync::atomic::{AtomicU32, Ordering};
+                static REPORTED: AtomicU32 = AtomicU32::new(0);
+                if REPORTED.fetch_add(1, Ordering::Relaxed) < 256 {
+                    let (relation, owner_retired) = match flight.job_notifier {
+                        None => ("own", false),
+                        Some(owner) => (
+                            if owner == flight.id { "job-owner" } else { "job-member" },
+                            self.job_notifiers
+                                .iter()
+                                .find(|j| j.owner == owner)
+                                .is_some_and(|j| j.owner_root.is_some()),
+                        ),
+                    };
+                    let (count, total) = notifier_seen.unwrap_or((u32::MAX, u32::MAX));
+                    dev_warn!(
+                        self.dev.as_ref(),
+                        "G16: rescue {:#x} render={} comm={} ordinal={} age_ms={} after_stamps_us={} last_blocked={:#x} notifier={} owner_retired={} count={:#x}/{:#x}\n",
+                        flight.id,
+                        flight.render.is_some(),
+                        core::str::from_utf8(&flight.comm)
+                            .unwrap_or("?")
+                            .trim_end_matches('\0'),
+                        flight.ordinal,
+                        flight.started.elapsed().as_millis(),
+                        flight.stamps_seen.map_or(0, |t| t.elapsed().as_micros_ceil()),
+                        flight.blocked,
+                        relation,
+                        owner_retired,
+                        count,
+                        total
+                    );
+                }
+            }
+            if crate::module_parameters::fw_trace.value() & 16 != 0 {
+                dev_info!(
+                    self.dev.as_ref(),
+                    "G16: retire {:#x} render={} after_stamps_us={} last_blocked={:#x} flights={}\n",
+                    flight.id,
+                    flight.render.is_some(),
+                    flight.stamps_seen.map_or(0, |t| t.elapsed().as_micros_ceil()),
+                    flight.blocked,
+                    self.flights.len()
+                );
+            }
+            let limited = flight
+                .render
+                .as_ref()
+                .is_some_and(|r| r.events.memory_limit);
+            let id = flight.id;
+            let render_work = flight.render.is_some();
+            if let Some(render) = &flight.render {
+                let pool = self
+                    .tvb_pools
+                    .iter_mut()
+                    .find(|p| p.root == render.root)
+                    .ok_or(EIO)?;
+                pool.release_scene(render.scene);
+            }
+            let mut owner = flight.owner.lock();
+            owner.pending -= 1;
+            if owner.pending == 0 {
+                owner.events = None;
+            }
+            drop(owner);
+            self.context_users[flight.context as usize] -= 1;
+            // The scan runs downwards: the flight swapped into `index` was
+            // already examined. Order carries no meaning (removal shifted
+            // every later flight, tens of KB per Work under load).
+            let flight = self.flights.swap_remove(index);
+            self.ledger.remove(&flight)?;
+            let root = match &flight.render {
+                Some(render) => render.root,
+                None => flight.client.lock().roots().low,
+            };
+            let entry = Retired {
+                work: id,
+                context: flight.context,
+                root,
+                tgid: flight.tgid,
+                comm: flight.comm,
+                ordinal: flight.ordinal,
+                render: render_work,
+                submitted: flight.started,
+                retired: Instant::now(),
+            };
+            // Retirement must not allocate: capacity is reserved up front.
+            if self.diagnostics.retire_log.len() < RETIRE_LOG {
+                let _ = self.diagnostics.retire_log.push_within_capacity(entry);
+            } else {
+                let slot = self.diagnostics.retire_next % RETIRE_LOG;
+                self.diagnostics.retire_log[slot] = entry;
+            }
+            self.diagnostics.retire_next = self.diagnostics.retire_next.wrapping_add(1);
+            flight.client.lock().release_scratch(flight.scratch)?;
+            // allocate_work reserved a slot for every outstanding lease. A
+            // render whose submission shares its notifier keeps the owner
+            // Work's storage leased until the last render using it retires.
+            let mut free = [Some((id, root)), None];
+            if let Some(owner_va) = flight.job_notifier {
+                if let Some(p) = self.job_notifiers.iter().position(|j| j.owner == owner_va) {
+                    let entry = &mut self.job_notifiers[p];
+                    entry.refs = entry.refs.saturating_sub(1);
+                    if id == owner_va {
+                        entry.owner_root = Some(root);
+                        free[0] = None;
+                    }
+                    if entry.refs == 0 {
+                        if let Some(owner_root) = entry.owner_root {
+                            free[1] = Some((owner_va, owner_root));
+                            self.job_notifiers.swap_remove(p);
+                        }
+                    }
+                }
+            }
+            for (va, root) in free.into_iter().flatten() {
+                self.free_work[usize::from(render_work)]
+                    .push_within_capacity((va, root))
+                    .map_err(|_| EIO)?;
+            }
+            self.retired.push_within_capacity((id, limited)).map_err(|_| ENOMEM)?;
+        }
+        crate::g16_timeline::attribute(&crate::g16_timeline::P_RD_SCAN, scan_before);
+        *self.last_scan = snapshot;
+        if !self.retired.is_empty() {
+            // Queued commands can legitimately wait longer than one Work's
+            // timeout. Watch for a lack of retirement progress, rather than
+            // charging every command for all its predecessors' execution.
+            // One timestamp for all of them, not a write to every flight.
+            self.progress = Some(Instant::now());
+            let (id, limited) = self.retired.pop().ok_or(EIO)?;
+            return Ok(Some((id, if limited { Err(ENOMEM) } else { Ok(()) })));
+        }
+        // Wedge detection needs a few samples per wedge_ms window (default
+        // 2 s), not one per pump pass: each sample reads two stamps per
+        // outstanding render and 36 channel registers.
+        let sample = self.diagnostics.wedge_sampled.is_none_or(|t| t.elapsed().as_millis() >= 50);
+        if sample {
+            self.diagnostics.wedge_sampled = Some(Instant::now());
+            let before = crate::g16_timeline::reads();
+            let checked = self.check_wedge();
+            crate::g16_timeline::attribute(&crate::g16_timeline::P_RD_WEDGE, before);
+            checked?;
+        }
+        let now = Instant::now();
+        if let Some(flight) = self
+            .flights
+            .iter()
+            .find(|f| self.flight_ms(f, now) >= 10000)
+        {
+            dev_err!(
+                self.dev.as_ref(),
+                "G16: async Work {:#x} context {} timeout without retirement progress\n",
+                flight.id,
+                flight.context
+            );
+            let _ = self.dump_hang_state();
+            self.render_failed = true;
+            return Err(ETIMEDOUT);
+        }
+        Ok(None)
+    }
+
+    /// Notifications do not extend the watchdog. Only retirement progress
+    /// resets it, so trace traffic cannot keep a stuck command alive.
+    /// Age of the oldest flight since the last retirement progress (ms).
+    /// A flight's age since the later of its publication and the latest
+    /// retirement progress.
+    pub(super) fn flight_ms(&self, flight: &Flight, now: Instant<Monotonic>) -> i64 {
+        let age = now - flight.started;
+        self.progress.map_or(age, |p| age.min(now - p)).as_millis()
+    }
+
+    /// Mark the following retire scans as safety-poll rescues.
+    pub(crate) fn set_poll_scan(&mut self, on: bool) {
+        self.poll_scan = on;
+    }
+
+    pub(crate) fn oldest_flight_ms(&self) -> u64 {
+        // One clock read for all flights.
+        let now = Instant::now();
+        self.flights
+            .iter()
+            .map(|flight| self.flight_ms(flight, now) as u64)
+            .max()
+            .unwrap_or(0)
+    }
+
+    pub(crate) fn watchdog_remaining_ms(&self) -> u32 {
+        let now = Instant::now();
+        let watchdog = self
+            .flights
+            .iter()
+            .map(|flight| (10000 - self.flight_ms(flight, now)).clamp(1, 10000) as u32)
+            .min()
+            .unwrap_or(10000);
+        // Wedge detection samples render progress a few times per window.
+        // A recorded unreachable hold is re-checked within its grace second.
+        let watchdog = if self.flights.iter().any(|f| f.render.is_some()) {
+            watchdog.min(250)
+        } else if self.diagnostics.hold_key.load(Ordering::Relaxed) != 0 {
+            watchdog.min(500)
+        } else {
+            watchdog
+        };
+        // With work outstanding, recheck at least this often, so a late or
+        // lost completion notification costs milliseconds.
+        if !self.flights.is_empty() {
+            watchdog.min(crate::g16_timeline::SAFETY_POLL_MS)
+        } else {
+            watchdog
+        }
+    }
+}
+
+impl Bootstrap {
+    /// Consume only events owned by this publication. Growth transfers retained
+    /// pages -> block list -> host counts -> reply -> producer, as in the shim.
+    pub(super) fn service_render_events(
+        &mut self,
+        client: &mut g16_vm::AddressSpace,
+        pool: &mut crate::g16_tvb::Tvb,
+        a: &render::Addresses,
+        service: &mut RenderEvents,
+    ) -> Result {
+        const STATE: u64 = 0xfffffc200003f1c0;
+        const RING: u64 = 0xfffffc200003f440;
+        let fw = self._firmware_space.as_mut().ok_or(EIO)?;
+        let mut cursor = fw.read_u32(STATE)?;
+        let end = fw.read_u32(STATE + 0x20)?;
+        if cursor >= 256 || end >= 256 {
+            return Err(EIO);
+        }
+        if cursor != end && crate::module_parameters::fw_trace.value() & 64 != 0 {
+            // SAFETY: ktime_get() has no preconditions.
+            let now = unsafe { kernel::bindings::ktime_get() };
+            let base = RING + u64::from(cursor) * 0x48;
+            pr_info!(
+                "G16: rxring {} event {}..{} first={:#x}/{:#x}\n",
+                now, cursor, end, fw.read_u32(base)?, fw.read_u32(base + 4)?
+            );
+        }
+        while cursor != end {
+            let base = RING + u64::from(cursor) * 0x48;
+            let kind = fw.read_u32(base)?;
+            let next = (cursor + 1) & 255;
+            if kind == 1 {
+                fw.write_live(STATE, &next.to_le_bytes())?;
+                cursor = next;
+                continue;
+            }
+            if !matches!(kind, 6 | 7) {
+                dev_err!(self.dev.as_ref(), "G16: unexpected render Event {}\n", kind);
+                return Err(EIO);
+            }
+            let guard = self._sgx.try_access().ok_or(ENODEV)?;
+            let sgx = &*guard;
+            let head = sgx.try_read32(0xd640c0)?;
+            let ack = sgx.try_read32(0xd640c8)?;
+            let tail = sgx.try_read32(0xd60060)?;
+            drop(guard);
+            if head >= 256 || ack >= 256 || tail >= 256 {
+                return Err(EIO);
+            }
+            let successor = (tail + 1) & 255;
+            if successor == head || successor == ack {
+                break;
+            }
+            let mut reply = [0u8; 64];
+            if kind == 6 {
+                let subpipe = fw.read_u32(base + 16)?;
+                let halt_count = fw.read_u64(base + 20)?;
+                if fw.read_u32(base + 4)? != a.context_id as u32
+                    || fw.read_u32(base + 8)? != pool.addresses.buffer_manager_slot as u32
+                    || fw.read_u32(base + 12)? != pool.counter
+                    || subpipe >= 64
+                {
+                    return Err(EIO);
+                }
+                let grown = pool.grow(fw, client, a.context_id as u8)?;
+                {
+                    use crate::g16_timeline as tl;
+                    use core::sync::atomic::Ordering::Relaxed;
+                    tl::TVB_REQUESTS.fetch_add(1, Relaxed);
+                    if grown { &tl::TVB_GROWN } else { &tl::TVB_REFUSED }.fetch_add(1, Relaxed);
+                    if !grown {
+                        let reason = pool.refusal.unwrap_or(crate::g16_tvb::Refusal::Memory);
+                        match reason {
+                            crate::g16_tvb::Refusal::Cap => &tl::TVB_REFUSED_CAP,
+                            crate::g16_tvb::Refusal::Va => &tl::TVB_REFUSED_VA,
+                            crate::g16_tvb::Refusal::Memory => &tl::TVB_REFUSED_MEMORY,
+                        }
+                        .fetch_add(1, Relaxed);
+                        if !pool.warned {
+                            pool.warned = true;
+                            // Warn for the first refusal of the boot only: CTS
+                            // performance cases refuse in every process.
+                            if !crate::g16_tvb::REFUSAL_WARNED.swap(true, Relaxed) {
+                                dev_warn!(
+                                    self.dev.as_ref(),
+                                    "G16: TVB slot {} growth refused at {} blocks ({}); its renders throttle until pages free (later pools: info)\n",
+                                    pool.addresses.buffer_manager_slot,
+                                    pool.blocks,
+                                    reason.name()
+                                );
+                            } else {
+                                dev_info!(
+                                    self.dev.as_ref(),
+                                    "G16: TVB slot {} growth refused at {} blocks ({})\n",
+                                    pool.addresses.buffer_manager_slot,
+                                    pool.blocks,
+                                    reason.name()
+                                );
+                            }
+                        }
+                    }
+                }
+                dev_info!(
+                    self.dev.as_ref(),
+                    "G16: TVB slot {} blocks {} growth {} subpipe {}\n",
+                    pool.addresses.buffer_manager_slot,
+                    pool.blocks,
+                    grown,
+                    subpipe
+                );
+                for (i, word) in [
+                    8,
+                    u32::from(grown),
+                    pool.addresses.buffer_manager_slot as u32,
+                    a.context_id as u32,
+                    pool.counter,
+                ]
+                .iter()
+                .enumerate()
+                {
+                    reply[i * 4..i * 4 + 4].copy_from_slice(&word.to_le_bytes());
+                }
+                // Native allocateMemoryEvent echoes the request's subpipe
+                // and halt counter. Queued work can request growth on another
+                // subpipe before its main stage starts, so this state belongs
+                // to the pool, not whichever Work is currently executing.
+                reply[20..24].copy_from_slice(&subpipe.to_le_bytes());
+                reply[24..32].copy_from_slice(&halt_count.to_le_bytes());
+                pool.refused |= !grown;
+                pool.counter = pool.counter.checked_add(1).ok_or(EIO)?;
+            } else {
+                if !pool.refused
+                    || service.memory_limit
+                    || fw.read_u32(base + 4)? != 0
+                    || fw.read_u32(base + 8)? != 1
+                    || fw.read_u32(base + 12)? != a.fragment_event as u32
+                    || fw.read_u32(base + 16)? != a.fragment_stamp as u32
+                {
+                    return Err(EIO);
+                }
+                crate::g16_timeline::TVB_MEMORY_LIMIT
+                    .fetch_add(1, core::sync::atomic::Ordering::Relaxed);
+                reply[..4].copy_from_slice(&9u32.to_le_bytes());
+                reply[4..8].copy_from_slice(&1u32.to_le_bytes());
+                reply[8..16].copy_from_slice(&a.fragment_queue.to_le_bytes());
+                reply[16..20].copy_from_slice(&(a.fragment_stamp as u32).to_le_bytes());
+                service.memory_limit = true;
+            }
+            crate::mem::sync();
+            let control = g16_fw::MainConfig::bootstrap(g16_fw::BUNDLE_ADDRESS).channels[12].ring;
+            fw.write_live(control + u64::from(tail) * 64, &reply)?;
+            crate::mem::sync();
+            fw.write_live(STATE, &next.to_le_bytes())?;
+            let guard = self._sgx.try_access().ok_or(ENODEV)?;
+            guard.try_write32(successor, 0xd60060)?;
+            drop(guard);
+            crate::mem::sync();
+            self._rtkit
+                .as_mut()
+                .send_message(0x21, 0x0084_0000_0000_0011)?;
+            return Ok(());
+        }
+        Ok(())
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16_stamp.rs b/drivers/gpu/drm/asahi/g16_stamp.rs
