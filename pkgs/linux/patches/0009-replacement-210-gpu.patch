+            let bytes =
+                unsafe { core::slice::from_raw_parts(core::ptr::from_ref(&raw).cast(), 0x80) };
+            out[i * 0x80..(i + 1) * 0x80].copy_from_slice(bytes);
+        }
+        Ok(())
+    }
+    pub(crate) fn block_ids(&self, out: &mut [u8]) -> Result<(), Error> {
+        self.validate()?;
