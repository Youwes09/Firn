+          {'gpu-avg-power-ki-only':F32(8.0).bits},
+          {'gpu-avg-power-filter-tc-ms':19,'gpu-ppm-filter-time-constant-ms':19},
+          {'gpu-pwr-filter-time-constant':17,'gpu-perf-filter-time-constant2':31,
