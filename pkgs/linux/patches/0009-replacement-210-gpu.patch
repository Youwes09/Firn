+        'gpu-pwr-filter-time-constant':rng.randrange(1,512),
+        'gpu-perf-filter-time-constant':rng.randrange(1,32),
+        'gpu-perf-filter-time-constant2':rng.randrange(1,512),
+        'gpu-ppm-filter-time-constant-ms':rng.randrange(8,128),
