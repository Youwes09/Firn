+    cmd.flags |= uapi.DRM_ASAHI_RENDER_PROCESS_EMPTY_TILES
+if a.fragment_barrier:
+    cmd.flags |= uapi.DRM_ASAHI_RENDER_VDM_BARRIER_FRAGMENT
