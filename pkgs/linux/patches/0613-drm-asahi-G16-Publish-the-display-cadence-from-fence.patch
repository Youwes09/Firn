+    /// Publish the display cadence when it has changed: a new period, or a
+    /// phase more than 100 us off the published grid. With no display
+    /// deadlines coming, publish the shortest period. A full control ring
+    /// leaves it for the next pass.
+    fn publish_cadence(&mut self) -> Result {
+        if crate::module_parameters::display_cadence.value() == 0 {
+            return Ok(());
+        }
+        let now = kernel::time::Instant::<kernel::time::Monotonic>::now();
+        let display = self.cadence.current(now);
+        let release = *g16_fw::DISPLAY_PERIODS.start();
+        if display.is_none() && self.published_cadence.is_some_and(|(_, last)| last == release) {
+            return Ok(());
+        }
+        let (counter, hz): (u64, u64);
+        // SAFETY: These instructions only read architectural timer registers.
+        unsafe {
+            core::arch::asm!("isb", "mrs {c}, cntpct_el0", "mrs {f}, cntfrq_el0",
+                             c = out(reg) counter, f = out(reg) hz);
+        }
+        if hz == 0 {
+            return Err(EIO);
+        }
+        // Both spans are under a second, so this cannot overflow.
+        let ticks = |ns: i64| ns * hz as i64 / 1_000_000_000;
+        let (phase, period) = match display {
+            Some((deadline, period_ns)) => (
+                counter.wrapping_add_signed(ticks((deadline - now).as_nanos())),
+                (ticks(period_ns) as u64)
+                    .clamp(*g16_fw::DISPLAY_PERIODS.start(), *g16_fw::DISPLAY_PERIODS.end()),
+            ),
+            // Left at a display's period, the firmware holds headless work
+            // back to it: on the J713, vkmark scores about 3,700 at 60 Hz,
+            // 6,000 with no cadence ever published, and 7,300 at 240 Hz.
+            None => (counter, release),
+        };
+        if let Some((last_phase, last_period)) = self.published_cadence {
+            let off = (phase.wrapping_sub(last_phase) as i64).rem_euclid(last_period as i64) as u64;
+            let off = off.min(last_period - off);
+            if last_period == period && off <= hz / 10_000 {
+                return Ok(());
+            }
+        }
+        let region_c = g16_fw::RootPointers::bootstrap().region_c;
+        let words = [
+            (g16_fw::REGION_C_DISPLAY_PHASE, phase.to_le_bytes()),
+            (g16_fw::REGION_C_DISPLAY_PERIOD, period.to_le_bytes()),
+        ];
+        let fw = self._firmware_space.as_mut().ok_or(EIO)?;
+        fw.write_batch(words.len(), |n| (region_c + words[n].0, &words[n].1[..]))?;
+        crate::mem::sync();
+        if self.publish_control(&g16_fw::display_cadence())?.is_some() {
+            if self.published_cadence.map(|(_, last)| last) != Some(period) {
+                dev_info!(self.dev.as_ref(), "G16: display cadence {} ticks\n", period);
+            }
+            self.published_cadence = Some((phase, period));
+        }
+        Ok(())
+    }
+
