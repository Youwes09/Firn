 pub(crate) const REGION_C_PSTATE_CAP: u64 = 0x98;
+/// Region C display cadence: a vblank, and the frame period, in counter
+/// ticks. The firmware rereads both on control message 0x22.
+pub(crate) const REGION_C_DISPLAY_PHASE: u64 = 0x988;
+pub(crate) const REGION_C_DISPLAY_PERIOD: u64 = 0x990;
+/// The frame periods macOS publishes: 240 Hz to 60 Hz.
+pub(crate) const DISPLAY_PERIODS: core::ops::RangeInclusive<u64> = 100_000..=400_000;
+
+/// Control message telling the firmware to reread the display cadence.
+pub(crate) fn display_cadence() -> [u8; 0x40] {
+    let mut out = [0; 0x40];
+    out[..4].copy_from_slice(&0x22u32.to_le_bytes());
+    out
+}
 
