index 000000000000..c867e7078cdc
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16_cadence.rs
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! The display's frame cadence, for the firmware's performance control.
+//!
+//! A display commit that waits on a render fence gives it a deadline: the
+//! next vblank start. Deadlines a frame apart give the frame period. The
+//! driver publishes the latest deadline and the period to region C, in
+//! counter ticks, and control message 0x22 has the firmware reread them.
+//! With no deadlines coming, the last cadence stays, as macOS leaves it.
+
+use kernel::{
+    new_spinlock,
+    prelude::*,
+    sync::{Arc, SpinLock},
+    time::{Instant, Monotonic},
+};
+
+/// Gaps between deadlines that are one frame: 240 Hz to just under 59 Hz.
+const FRAME_NS: core::ops::RangeInclusive<i64> = 4_100_000..=17_000_000;
+
+/// Deadlines older than this no longer describe a display being driven.
+const STALE_NS: i64 = 500_000_000;
+
+struct Track {
+    /// The latest deadline.
+    deadline: Option<Instant<Monotonic>>,
+    /// The frame period in ns, from deadlines a frame apart; 0 until known.
+    period: i64,
+}
+
+#[pin_data]
+pub(crate) struct Cadence {
+    #[pin]
+    track: SpinLock<Track>,
+}
+
+impl Cadence {
+    pub(crate) fn new() -> Result<Arc<Self>> {
+        Arc::pin_init(
+            pin_init!(Self {
+                track <- new_spinlock!(Track { deadline: None, period: 0 }),
+            }),
+            GFP_KERNEL,
+        )
+    }
+
+    /// Note a fence deadline. Fences of one commit share theirs.
+    pub(crate) fn add_deadline(&self, deadline: Instant<Monotonic>) {
+        let mut track = self.track.lock();
+        if let Some(last) = track.deadline {
+            let gap = (deadline - last).as_nanos();
+            if gap <= 0 {
+                return;
+            }
+            if FRAME_NS.contains(&gap) {
+                track.period = gap;
+            }
+        }
+        track.deadline = Some(deadline);
+    }
+
+    /// The latest deadline and the frame period in ns, while deadlines come.
+    pub(crate) fn current(&self, now: Instant<Monotonic>) -> Option<(Instant<Monotonic>, i64)> {
+        let track = self.track.lock();
+        let deadline = track.deadline?;
+        if track.period == 0 || (now - deadline).as_nanos() > STALE_NS {
+            return None;
+        }
+        Some((deadline, track.period))
+    }
+}
