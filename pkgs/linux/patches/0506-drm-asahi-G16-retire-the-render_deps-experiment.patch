From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Fri, 16 Oct 2026 10:09:28 -0400
Subject: [PATCH] drm/asahi: G16: retire the render_deps experiment

Keep firmware dependency items, including the existing dep_elide checks. Remove the unselected kernel-wait path and its counters; compute deferral accounting stays intact.

K1: no callers found in boot configs, tools or retained test scripts. Keep the production default exactly.
---
 drivers/gpu/drm/asahi/asahi_m4.rs    |  6 +--
 drivers/gpu/drm/asahi/g16_runtime.rs | 70 ++++------------------------
 2 files changed, 11 insertions(+), 65 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_m4.rs b/drivers/gpu/drm/asahi/asahi_m4.rs
index ae09d9151f1b..7a3d3a1462a8 100644
--- a/drivers/gpu/drm/asahi/asahi_m4.rs
+++ b/drivers/gpu/drm/asahi/asahi_m4.rs
@@ -181,10 +181,6 @@ fn probe<'bound>(
             default: 0,
             description: "Experiment: render lifecycle words (regs 0x1ca10/0x14a1/0xa349 tiling, 0x160e0/0x1499/0xa341 fragment) and Work uuids. 1: unique per render, as Metal: two device-wide counters, the high word +1 and the low word +2 per render (fragment even, tiling odd). 0: the original constants for every render (production)",
         },
-        render_deps: u32 {
-            default: 0,
-            description: "Experiment: 1 orders renders in the kernel (waits for other queues and for the previous fragment stamp a tiling stage needs, then submits with no firmware dependency items); 0 encodes firmware dependency items",
-        },
         compute_deps: u32 {
             default: 2,
             description: "Compute Work ordering against other queues: 1 waits in the kernel and submits Works without firmware dependency items (as Metal); 0 encodes firmware dependency items (the earlier behaviour, which can stall the firmware under heavy compute bursts); 2 as 1, but waits on the same queue's own render lanes stay firmware items (in-submission render -> compute edges without a host round trip)",
@@ -195,7 +191,7 @@ fn probe<'bound>(
         },
         max_lane_entries: u32 {
             default: 120,
-            description: "Maximum unretired Works plus their firmware dependency items on one firmware lane (render TA or 3D, or compute) before submissions back off; 0: unlimited. Keeps dependency items below the firmware's 128-Work per-lane window. Keep it at 127 or less whenever compute_deps or render_deps leave firmware items",
+            description: "Maximum unretired Works plus their firmware dependency items on one firmware lane (render TA or 3D, or compute) before submissions back off; 0: unlimited. Keeps dependency items below the firmware's 128-Work per-lane window. Keep it at 127 or less when firmware dependency items are enabled",
         },
         max_lane_works: u32 {
             default: 64,
diff --git a/drivers/gpu/drm/asahi/g16_runtime.rs b/drivers/gpu/drm/asahi/g16_runtime.rs
index a9a9c5a87a04..7e1182a1e8f7 100644
--- a/drivers/gpu/drm/asahi/g16_runtime.rs
+++ b/drivers/gpu/drm/asahi/g16_runtime.rs
@@ -46,17 +46,6 @@ pub(crate) struct FirmwareQueues {
 /// Cumulative per-queue counts of kernel-resolved dependencies.
 #[derive(Default)]
 struct DependencyStats {
-    /// Renders admitted whose tiling stage waited on an earlier fragment
-    /// stamp in the kernel (render_deps=1: the vertex-consumer order).
-    ta_ordered: u64,
-    /// Admission attempts deferred (EBUSY) because that fragment stamp was
-    /// not yet reached; retries are counted each time.
-    ta_held: u64,
-    /// Render admissions deferred on a compute or other-queue stamp.
-    cross_held: u64,
-    /// Fragment-stage waits on the queue's own fragment lane dropped as
-    /// already ordered by the lane.
-    lane_dropped: u64,
     /// Compute admissions deferred on another queue's stamp.
     compute_held: u64,
     /// Works admitted after at least one deferral, and the total time from
@@ -86,16 +75,12 @@ impl Drop for FirmwareQueues {
     fn drop(&mut self) {
         let d = &self.deps;
         if crate::module_parameters::dep_stats.value() != 0
-            && d.ta_ordered + d.ta_held + d.cross_held + d.lane_dropped + d.compute_held != 0
+            && d.compute_held != 0
         {
             pr_info!(
-                "G16: queue deps renders={} computes={} ta_ordered={} ta_held={} cross_held={} lane_dropped={} compute_held={} held_works={} held_us={}\n",
+                "G16: queue deps renders={} computes={} compute_held={} held_works={} held_us={}\n",
                 self.render_count,
                 self.compute_count,
-                d.ta_ordered,
-                d.ta_held,
-                d.cross_held,
-                d.lane_dropped,
                 d.compute_held,
                 d.held_works,
                 d.held_us
@@ -2206,54 +2191,19 @@ fn resolve_render_dependencies(
         params: &render::Parameters,
         dependencies: &[Option<Stamp>; 2],
     ) -> Result<[Option<Stamp>; 2]> {
-        if crate::module_parameters::render_deps.value() == 0 {
-            crate::g16_timeline::DEP_WORKS.fetch_add(1, Ordering::Relaxed);
-            let own_fragment = queue.lanes.as_ref().map(|lanes| lanes[1].firmware_stamp());
-            let mut kept = *dependencies;
-            for (slot, dep) in dependencies.iter().enumerate() {
-                let Some(dep) = dep else { continue };
-                let lane = Self::render_item_lane(params, slot);
-                let same_lane = lane == 1 && own_fragment == Some(dep.address);
-                if self.elide_item(queue, lane, dep, same_lane)? {
-                    kept[slot] = None;
-                }
-            }
-            return Ok(kept);
-        }
-        let fragment_stage = params.vdm_barrier_fragment
-            || crate::module_parameters::render_barrier.value() & 1 != 0;
+        crate::g16_timeline::DEP_WORKS.fetch_add(1, Ordering::Relaxed);
         let own_fragment = queue.lanes.as_ref().map(|lanes| lanes[1].firmware_stamp());
-        let fw = self._firmware_space.as_ref().ok_or(EIO)?;
-        let mut ta_ordered = false;
-        let mut lane_dropped = false;
+        let mut kept = *dependencies;
         for (slot, dep) in dependencies.iter().enumerate() {
             let Some(dep) = dep else { continue };
-            // Slot 0 is the render dependency: on the fragment stage with a
-            // fragment barrier, else on the tiling stage. Slot 1 (compute) is
-            // always a tiling-stage wait.
-            let lane_ordered = slot == 0 && fragment_stage && own_fragment == Some(dep.address);
-            let ta_wait = slot == 0 && !fragment_stage && own_fragment == Some(dep.address);
-            let now = if lane_ordered { 0 } else { fw.read_u32(dep.address)? };
-            let done = lane_ordered || g16_stamp::reached(now, dep.value);
-            if !lane_ordered {
-                self.hold_check("render", dep, now, done)?;
-            }
-            if !done {
-                if ta_wait {
-                    queue.deps.ta_held += 1;
-                } else {
-                    queue.deps.cross_held += 1;
-                }
-                queue.deps.defer();
-                return Err(EBUSY);
+            let lane = Self::render_item_lane(params, slot);
+            let same_lane = lane == 1 && own_fragment == Some(dep.address);
+            if self.elide_item(queue, lane, dep, same_lane)? {
+                kept[slot] = None;
             }
-            ta_ordered |= ta_wait;
-            lane_dropped |= lane_ordered;
         }
-        queue.deps.ta_ordered += u64::from(ta_ordered);
-        queue.deps.lane_dropped += u64::from(lane_dropped);
-        queue.deps.admit();
-        Ok([None; 2])
+        Ok(kept)
+
     }
 
     pub(crate) fn submit_render(
