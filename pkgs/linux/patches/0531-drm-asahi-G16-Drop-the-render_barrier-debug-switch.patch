From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Tue, 20 Oct 2026 00:25:19 -0400
Subject: [PATCH] drm/asahi: G16: Drop the render_barrier debug switch

render_barrier applied every render's vdm_barrier at fragment (1) or
omitted fragment waits already ordered by the queue's fragment lane (2).
Production never set it; a render's dependency moves to fragment only
when userspace asks for a fragment-stage barrier, as before.

Signed-off-by: Niklas Sheth <hi@niklassheth.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/asahi/asahi_m4.rs    |  4 ----
 drivers/gpu/drm/asahi/g16_runtime.rs | 13 ++-----------
 2 files changed, 2 insertions(+), 15 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_m4.rs b/drivers/gpu/drm/asahi/asahi_m4.rs
index 8f261414f849..7e0ff42c5016 100644
--- a/drivers/gpu/drm/asahi/asahi_m4.rs
+++ b/drivers/gpu/drm/asahi/asahi_m4.rs
@@ -213,10 +213,6 @@ fn probe<'bound>(
             default: 4,
             description: "Debug: completion control value for registers 0x14308/0x14048 (driver original 4; macOS uses 0-3: 3 solo, mostly 1 under contention)",
         },
-        render_barrier: u32 {
-            default: 0,
-            description: "Debug render-to-render barriers: 1=apply every render's vdm_barrier at fragment, 2=omit fragment waits already ordered by the queue's fragment lane",
-        },
         render_preempt: u32 {
             default: 1,
             description: "1 lets firmware suspend and restart TA/3D work (preemptible render queues); 0 gives them compute's non-preemptible profile",
diff --git a/drivers/gpu/drm/asahi/g16_runtime.rs b/drivers/gpu/drm/asahi/g16_runtime.rs
index 5cad35ca31e7..4de0225cd235 100644
--- a/drivers/gpu/drm/asahi/g16_runtime.rs
+++ b/drivers/gpu/drm/asahi/g16_runtime.rs
@@ -2143,9 +2143,7 @@ fn elide_item(&self, queue: &FirmwareQueues, lane: usize, dep: &Stamp, same_lane
     /// The lane a render's dependency item sits on: slot 0 (render) on the
     /// fragment lane with a fragment barrier, else the tiling lane.
     fn render_item_lane(params: &render::Parameters, slot: usize) -> usize {
-        let fragment = params.vdm_barrier_fragment
-            || crate::module_parameters::render_barrier.value() & 1 != 0;
-        usize::from(slot == 0 && fragment)
+        usize::from(slot == 0 && params.vdm_barrier_fragment)
     }
 
     fn resolve_render_dependencies(
@@ -2564,15 +2562,8 @@ fn publish_render(
         // Only the render dependency can move to fragment. Compute output
         // may feed the vertex stage, and input fences were already consumed
         // by the scheduler before either lane was published.
-        let mode = crate::module_parameters::render_barrier.value();
-        let vdm_barrier_fragment = vdm_barrier_fragment || mode & 1 != 0;
-        // A fragment-stage wait on this queue's own fragment lane is already
-        // satisfied by that lane's submission order.
-        let fragment_dependency = dependencies[0].filter(|d| {
-            mode & 2 == 0 || d.address != lanes[1].firmware_stamp()
-        });
         let stage_dependencies = if vdm_barrier_fragment {
-            [[None, dependencies[1]], [fragment_dependency, None]]
+            [[None, dependencies[1]], [dependencies[0], None]]
         } else {
             [*dependencies, [None, None]]
         };
