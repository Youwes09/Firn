From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Thu, 8 Oct 2026 15:22:46 -0400
Subject: [PATCH] drm/asahi: G16: Detect the A4 wedge and optionally re-kick
 render lanes

A4 leaves a render with TA done and every wait satisfied whose 3D never
starts, after which every render queue's fragment stage freezes. All
channels are drained and firmware reports neither a fault nor a timeout,
so the only handling so far was the 10 s watchdog, which fails the whole
device.

Detect it in the kernel: such a render, all 12 channels drained, and no
fragment stamp of any live render moving for wedge_ms (default 2 s).
With wedge_recover=0 (the default) the detection is only logged. With 1
the recovery ladder starts: R1 re-sends the stuck render's 3D channel
message at the queue's current head, R2 re-sends the TA and 3D messages
of every live render queue, one rung per window, before the watchdog.
The worker samples every 250 ms while renders are in flight. See
tmp/kernel-73-validate/a4-recovery-design.md.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit c31a7b9004578d56a317aa7ba114d4b7023f739b)
---
 drivers/gpu/drm/asahi/asahi_m4.rs    |   8 ++
 drivers/gpu/drm/asahi/g16.rs         |   7 ++
 drivers/gpu/drm/asahi/g16_runtime.rs | 127 ++++++++++++++++++++++++++-
 3 files changed, 140 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_m4.rs b/drivers/gpu/drm/asahi/asahi_m4.rs
index d1576cd31632..b69401f757dd 100644
--- a/drivers/gpu/drm/asahi/asahi_m4.rs
+++ b/drivers/gpu/drm/asahi/asahi_m4.rs
@@ -168,6 +168,14 @@ fn probe<'bound>(
             default: 0,
             description: "Experiment: 1 publishes every admitted Work with its own channel message and kick, instead of batching all Works admitted in one worker pass into one message per lane",
         },
+        wedge_ms: u32 {
+            default: 2000,
+            description: "A4 wedge detection window: a render with TA done and all waits met whose 3D never starts, with all channels drained and no fragment progress on any lane for this long",
+        },
+        wedge_recover: u32 {
+            default: 0,
+            description: "A4 wedge handling: 0 logs the detection only; 1 also re-kicks the stuck 3D lane (R1), then every render queue's TA and 3D lanes (R2), one rung per wedge_ms window, before the 10 s watchdog",
+        },
         lifecycle: u32 {
             default: 0,
             description: "Experiment: render lifecycle words (regs 0x1ca10/0x14a1/0xa349 tiling, 0x160e0/0x1499/0xa341 fragment) and Work uuids. 1: unique per render, as Metal: two device-wide counters, the high word +1 and the low word +2 per render (fragment even, tiling odd). 0: the original constants for every render (production)",
diff --git a/drivers/gpu/drm/asahi/g16.rs b/drivers/gpu/drm/asahi/g16.rs
index 02cc2f23d695..b647e027e577 100644
--- a/drivers/gpu/drm/asahi/g16.rs
+++ b/drivers/gpu/drm/asahi/g16.rs
@@ -209,6 +209,10 @@ pub(crate) struct Bootstrap {
     pub(crate) maximum_frequency_khz: u32,
     tvb_pools: KVec<crate::g16_tvb::Tvb>,
     render_publication: u64,
+    /// A4 wedge detection state (check_wedge).
+    wedge_since: Option<kernel::time::Instant<kernel::time::Monotonic>>,
+    wedge_signature: u64,
+    wedge_rung: u32,
     /// Debug (dump_render_buffered): the most recent submitted renders,
     /// printed only by the hang report.
     render_ring: render_runtime::RenderRing,
@@ -697,6 +701,9 @@ pub(crate) fn new(pdev: &platform::Device<Core<'_>>) -> Result<Self> {
             maximum_frequency_khz: platform.max_frequency() * 1000,
             tvb_pools: KVec::new(),
             render_publication: crate::module_parameters::fw_counter_start.value(),
+            wedge_since: None,
+            wedge_signature: 0,
+            wedge_rung: 0,
             render_ring: render_runtime::RenderRing::new(),
             retire_log: KVec::new(),
             retire_next: 0,
diff --git a/drivers/gpu/drm/asahi/g16_runtime.rs b/drivers/gpu/drm/asahi/g16_runtime.rs
index ea295e73dc71..958793f29c48 100644
--- a/drivers/gpu/drm/asahi/g16_runtime.rs
+++ b/drivers/gpu/drm/asahi/g16_runtime.rs
@@ -1365,6 +1365,7 @@ pub(crate) fn retire(&mut self) -> Result<Option<(u64, Result)>> {
             let (id, limited) = self.retired.pop().ok_or(EIO)?;
             return Ok(Some((id, if limited { Err(ENOMEM) } else { Ok(()) })));
         }
+        self.check_wedge()?;
         if let Some(flight) = self
             .flights
             .iter()
@@ -1386,11 +1387,18 @@ pub(crate) fn retire(&mut self) -> Result<Option<(u64, Result)>> {
     /// Notifications do not extend the watchdog. Only retirement progress
     /// resets it, so trace traffic cannot keep a stuck command alive.
     pub(crate) fn watchdog_remaining_ms(&self) -> u32 {
-        self.flights
+        let watchdog = self
+            .flights
             .iter()
             .map(|flight| (10000 - flight.started.elapsed().as_millis()).clamp(1, 10000) as u32)
             .min()
-            .unwrap_or(10000)
+            .unwrap_or(10000);
+        // Wedge detection samples render progress a few times per window.
+        if self.flights.iter().any(|f| f.render.is_some()) {
+            watchdog.min(250)
+        } else {
+            watchdog
+        }
     }
 }
 
@@ -3190,3 +3198,118 @@ fn print_lane_events(&self) {
         }
     }
 }
+
+impl Bootstrap {
+    /// A4 wedge (see tmp/kernel-73-validate/a4-recovery-design.md): a render
+    /// whose TA is done and whose waits are all satisfied, while its 3D never
+    /// starts, every channel is drained and no fragment stamp on any lane
+    /// moves for wedge_ms. Firmware reports nothing for this state, so the
+    /// kernel detects it. wedge_recover=0 only logs the detection; 1 also
+    /// walks the recovery ladder: R1 re-kicks the stuck render's 3D lane, R2
+    /// re-kicks the TA and 3D lanes of every live render queue.
+    fn check_wedge(&mut self) -> Result {
+        let fw = self._firmware_space.as_ref().ok_or(EIO)?;
+        let mut stuck = None;
+        let mut signature = 0u64;
+        for (index, flight) in self.flights.iter().enumerate() {
+            let (Some(_), Some(tiling), Some(fragment)) = (&flight.render, flight.stamps[0], flight.stamps[1]) else {
+                continue;
+            };
+            let ta = fw.read_u32(tiling.address)?;
+            let frag = fw.read_u32(fragment.address)?;
+            signature = signature.wrapping_mul(0x100_0000_01b3).wrapping_add(u64::from(frag));
+            if stuck.is_none()
+                && g16_stamp::reached(ta, tiling.value)
+                && !g16_stamp::reached(frag, fragment.value)
+                && flight.dependencies.iter().flatten().all(|d| {
+                    fw.read_u32(d.address).is_ok_and(|v| g16_stamp::reached(v, d.value))
+                })
+            {
+                stuck = Some(index);
+            }
+        }
+        let drained = {
+            let config = g16_fw::MainConfig::bootstrap(g16_fw::BUNDLE_ADDRESS);
+            let guard = self._sgx.try_access().ok_or(ENODEV)?;
+            config.channels.iter().take(12).all(|route| {
+                let read = guard.try_read32(0xd64000 + (route.state[0] - 0xffff_fc20_0002_8000) as usize);
+                let done = guard.try_read32(0xd64000 + (route.state[1] - 0xffff_fc20_0002_8000) as usize);
+                let tail = guard.try_read32(0xd60000 + (route.state[2] - 0xffff_fc20_0002_0000) as usize);
+                matches!((read, done, tail), (Ok(r), Ok(d), Ok(t)) if r == d && d == t)
+            })
+        };
+        let Some(index) = stuck.filter(|_| drained) else {
+            self.wedge_since = None;
+            self.wedge_rung = 0;
+            return Ok(());
+        };
+        let now = Instant::now();
+        match self.wedge_since {
+            Some(since) if signature == self.wedge_signature => {
+                let wedge_ms = u64::from(crate::module_parameters::wedge_ms.value().max(100));
+                if (now - since).as_millis() < wedge_ms as i64 {
+                    return Ok(());
+                }
+            }
+            _ => {
+                // First sighting, or some fragment stamp moved: restart.
+                self.wedge_since = Some(now);
+                self.wedge_signature = signature;
+                return Ok(());
+            }
+        }
+        let flight = &self.flights[index];
+        let owner = flight.owner.clone();
+        let recover = crate::module_parameters::wedge_recover.value() != 0;
+        if self.wedge_rung < 3 {
+            dev_err!(self.dev.as_ref(),
+                "G16: A4 wedge: Work {:#x} context {} stream {:#x} ordinal {} age {} ms, no fragment progress for {} ms; {}\n",
+                flight.id, flight.context, flight.stream, flight.ordinal,
+                flight.started.elapsed().as_millis(), (now - self.wedge_since.unwrap_or(now)).as_millis(),
+                match (recover, self.wedge_rung) {
+                    (false, _) => "detection only (wedge_recover=0)",
+                    (true, 0) => "R1: re-kicking its 3D lane",
+                    (true, 1) => "R2: re-kicking every render queue's TA and 3D lanes",
+                    _ => "ladder exhausted, leaving it to the watchdog",
+                });
+        }
+        if !recover || self.wedge_rung >= 2 {
+            self.wedge_rung = 3;
+            return Ok(());
+        }
+        if self.wedge_rung == 0 {
+            self.rekick(&owner, &[1])?;
+        } else {
+            let mut owners = KVec::new();
+            for f in self.flights.iter().filter(|f| f.render.is_some()) {
+                if !owners.iter().any(|o: &Arc<Mutex<FirmwareQueues>>| Arc::ptr_eq(o, &f.owner)) {
+                    owners.push(f.owner.clone(), GFP_KERNEL)?;
+                }
+            }
+            for o in owners.iter() {
+                self.rekick(o, &[0, 1])?;
+            }
+        }
+        self.flush()?;
+        self.wedge_rung += 1;
+        self.wedge_since = Some(Instant::now());
+        Ok(())
+    }
+
+    /// Re-send a render queue's channel messages at its current heads, as a
+    /// fresh publication with no new Work: firmware re-reads the lane.
+    fn rekick(&mut self, owner: &Arc<Mutex<FirmwareQueues>>, stages: &[usize]) -> Result {
+        let (lanes, priority, events) = {
+            let q = owner.lock();
+            let Some(lanes) = q.lanes else { return Ok(()) };
+            (lanes, q.priority, [q.event(0).ok(), q.event(1).ok()])
+        };
+        for &stage in stages {
+            let Some(event) = events[stage] else { continue };
+            let mut lane = lanes[stage];
+            lane.new = false;
+            self.stage_queue(priority as usize * 3 + stage, lane, event, self.render_publication)?;
+        }
+        Ok(())
+    }
+}
