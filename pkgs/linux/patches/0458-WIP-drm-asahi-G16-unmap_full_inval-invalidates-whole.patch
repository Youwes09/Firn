From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Thu, 8 Oct 2026 12:44:58 -0400
Subject: [PATCH] WIP drm/asahi: G16 unmap_full_inval invalidates whole
 contexts on VM changes

An experiment for the A4 render stall, whose stuck render is the first
use of a newly bound attachment. Binds and unbinds already publish page
tables, invalidate the changed pages on every context bound to the VM
and complete with dsb sy before the ioctl returns, and binding a context
invalidates its ASID. unmap_full_inval=1 additionally drops each bound
context's whole ASID, and 2 all EL1 translations, to rule out any
partial-invalidation gap.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/asahi/asahi_m4.rs    | 4 ++++
 drivers/gpu/drm/asahi/g16_runtime.rs | 9 +++++++++
 drivers/gpu/drm/asahi/m4_mem.rs      | 7 +++++++
 3 files changed, 20 insertions(+)

diff --git a/drivers/gpu/drm/asahi/asahi_m4.rs b/drivers/gpu/drm/asahi/asahi_m4.rs
index 1f841bd018c4..e6410a3fabfb 100644
--- a/drivers/gpu/drm/asahi/asahi_m4.rs
+++ b/drivers/gpu/drm/asahi/asahi_m4.rs
@@ -156,6 +156,10 @@ fn probe<'bound>(
             default: 400,
             description: "Debug: at most this many renders are dumped per boot",
         },
+        unmap_full_inval: u32 {
+            default: 0,
+            description: "Experiment: on every VM bind and unbind, 1 also invalidates each bound context's whole ASID (not only the changed pages); 2 additionally invalidates all EL1 translations (tlbi vmalle1os). Both complete with dsb sy before the ioctl returns",
+        },
         lifecycle: u32 {
             default: 0,
             description: "Experiment: render lifecycle words (regs 0x1ca10/0x14a1/0xa349 tiling, 0x160e0/0x1499/0xa341 fragment) and Work uuids. 1: unique per render, as Metal: two device-wide counters, the high word +1 and the low word +2 per render (fragment even, tiling odd). 0: the original constants for every render (production)",
diff --git a/drivers/gpu/drm/asahi/g16_runtime.rs b/drivers/gpu/drm/asahi/g16_runtime.rs
index cbf4909b763a..153dcd286e23 100644
--- a/drivers/gpu/drm/asahi/g16_runtime.rs
+++ b/drivers/gpu/drm/asahi/g16_runtime.rs
@@ -1522,12 +1522,21 @@ pub(crate) fn invalidate_client(&self, client: &g16_vm::AddressSpace) {
             client.low.invalidate(Some(0));
             client.high.invalidate(Some(0));
         }
+        let full = crate::module_parameters::unmap_full_inval.value();
         for (index, roots) in self.context_roots.iter().enumerate().skip(1) {
             if roots.is_some_and(|r| r.low == root) {
                 client.low.invalidate(Some(index as u8));
                 client.high.invalidate(Some(index as u8));
+                if full != 0 {
+                    // Experiment: drop every cached translation of the
+                    // context, not just the changed pages.
+                    crate::mem::tlbi_asid(index as u8);
+                }
             }
         }
+        if full >= 2 {
+            crate::mem::tlbi_all();
+        }
         crate::mem::sync();
         client.low.clear_invalidations();
         client.high.clear_invalidations();
diff --git a/drivers/gpu/drm/asahi/m4_mem.rs b/drivers/gpu/drm/asahi/m4_mem.rs
index d9c9d925f910..00943c5141a3 100644
--- a/drivers/gpu/drm/asahi/m4_mem.rs
+++ b/drivers/gpu/drm/asahi/m4_mem.rs
@@ -19,6 +19,13 @@ pub(crate) fn tlbi_asid(asid: u8) {
     }
 }
 
+/// Experiment (unmap_full_inval=2): invalidate every EL1 translation in the
+/// outer-shareable domain, CPU and GPU, all ASIDs.
+pub(crate) fn tlbi_all() {
+    // SAFETY: These instructions only discard cached translations.
+    unsafe { core::arch::asm!(".arch armv8.4-a", "tlbi vmalle1os", options(nostack, preserves_flags)) };
+}
+
 /// Invalidate only these GPU virtual pages, including global firmware mappings.
 /// VA operands use 4 KiB units even though the GPU page size is 16 KiB.
 /// The caller publishes PTE writes before this and completes the batch after it.
