From 4f9f090392b02b35671e2de7f5396ffc92e557ee Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Mon, 26 Oct 2026 02:08:10 -0400
Subject: [PATCH] usb: typec: tipd: cd321x: factor out the data connection test

Move the test that decides whether the PHY leaves safe mode into
cd321x_data_connected(), so that every place that needs to know the PHY
state a status implies uses the same predicate. No functional change.

[Youwes09: from niklassheth/linux acfd7fafe5f9]
Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 drivers/usb/typec/tipd/core.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/typec/tipd/core.c b/drivers/usb/typec/tipd/core.c
index 11db70cc2389..8a2cf77d4bd4 100644
--- a/drivers/usb/typec/tipd/core.c
+++ b/drivers/usb/typec/tipd/core.c
@@ -570,11 +570,21 @@ static void tps6598x_handle_plug_event(struct tps6598x *tps, u32 status)
 	}
 }
 
+/*
+ * Does @st report a data connection, i.e. should the PHY leave safe mode?
+ * The single test for this, shared by the mode update and the decision to
+ * restart the role.
+ */
+static bool cd321x_data_connected(const struct cd321x_status *st)
+{
+	return st->data_status & TPS_DATA_STATUS_DATA_CONNECTION;
+}
+
 static void cd321x_typec_update_mode(struct tps6598x *tps, struct cd321x_status *st)
 {
 	struct cd321x *cd321x = container_of(tps, struct cd321x, tps);
 
-	if (!(st->data_status & TPS_DATA_STATUS_DATA_CONNECTION)) {
+	if (!cd321x_data_connected(st)) {
 		if (cd321x->state.mode == TYPEC_STATE_SAFE)
 			return;
 		cd321x->state.alt = NULL;
