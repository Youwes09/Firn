From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Sun, 8 Nov 2026 23:43:48 -0500
Subject: [PATCH] drm/asahi: G16: reap only the mappings a deferred close
 retired

A GEM close with work queued marks the object's mappings closing and the
reaper unmaps them once the fences pending at the close have signaled.
The reaper found them by object identity, so it also removed every later
mapping of the same object. The object comes back under a new handle
whenever this client imports one of its dma-bufs again (Mesa's reaper
closes a shared BO, then a new import of the same buffer races it, or a
compositor re-imports a client buffer it dropped), and Mesa binds the new
handle at a new address. When the old close completed, that live mapping
was unmapped under the client: the next submit naming it as an attachment
was rejected ("not mapped with access 0x4"), and work already queued that
sampled it faulted. For a compressed image the fault is in DCMP, which
soft faults don't cover, and the firmware stops with a kind-4 timeout
(KWin screencast with KRdp, mini, 2026-11-09 03:42).

Stamp each deferred close's mappings with a close id and unmap only
mappings carrying the id of the completed entry. A close only retires
live mappings; ones an earlier close retired stay with that close. The
bind-over-closed path waits for the entries that own the overlapped
mappings, by id.
---
 drivers/gpu/drm/asahi/g16_deferred.rs         | 16 +++++++++
 drivers/gpu/drm/asahi/g16_drm.rs              | 35 +++++++++++++------
 drivers/gpu/drm/asahi/g16_drm_bind.rs         | 11 +++---
 drivers/gpu/drm/asahi/g16_drm_ioctl.rs        |  2 +-
 .../drivers/gpu/asahi/deferred-unmap.rs       | 15 +++++++-
 5 files changed, 61 insertions(+), 18 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16_deferred.rs b/drivers/gpu/drm/asahi/g16_deferred.rs
index 401e0f7cf44e..556b48c839dd 100644
--- a/drivers/gpu/drm/asahi/g16_deferred.rs
+++ b/drivers/gpu/drm/asahi/g16_deferred.rs
@@ -10,6 +10,13 @@
 //! deferral only keeps PTEs valid for work that may still use them. Closing
 //! mappings no longer satisfy `covered`, and a bind over them waits only for
 //! their own snapshot. Pure range logic, host-tested.
+//!
+//! Each close stamps the mappings it retires with its own id, and the reaper
+//! unmaps only mappings carrying the id of a completed entry. Identity of the
+//! GEM object is not enough: after a close, the same object can come back
+//! under a new handle (a dma-buf imported again, or one exported by another
+//! client of this device) and be bound at a new address. That mapping is live
+//! and must outlive the old close.
 
 use core::ops::Range;
 
@@ -74,6 +81,15 @@ pub(crate) fn overlap<T: Span>(items: &[T], start: u64, end: u64) -> Overlap {
     kind
 }
 
+/// Close id of a mapping that no close has retired.
+pub(crate) const LIVE: u64 = 0;
+
+/// Whether the deferred close `entry` owns a mapping stamped `close`: only the
+/// close that retired a mapping may unmap it.
+pub(crate) fn retired_by(close: u64, entry: u64) -> bool {
+    entry != LIVE && close == entry
+}
+
 /// Whether a deferred close may be recorded on a VM already tracking
 /// `entries`; otherwise the close drains as before.
 pub(crate) fn admit(entries: usize) -> bool {
diff --git a/drivers/gpu/drm/asahi/g16_drm.rs b/drivers/gpu/drm/asahi/g16_drm.rs
index 769bf3ab965a..27aef6b150c7 100644
--- a/drivers/gpu/drm/asahi/g16_drm.rs
+++ b/drivers/gpu/drm/asahi/g16_drm.rs
@@ -91,9 +91,10 @@ struct Mapping {
     offset: u64,
     single: bool,
     obj: ARef<Object>,
-    /// Its object was closed while work was queued: the PTEs stay until the
-    /// reaper unmaps them (see g16_deferred), but nothing new may use it.
-    closing: bool,
+    /// Nonzero once its object was closed while work was queued: the id of
+    /// that close (g16_deferred::LIVE otherwise). The PTEs stay until the
+    /// reaper completes that close, but nothing new may use the mapping.
+    closing: u64,
 }
 
 impl crate::g16_deferred::Span for Mapping {
@@ -104,7 +105,7 @@ fn permissions(&self) -> u32 {
         self.permissions
     }
     fn closing(&self) -> bool {
-        self.closing
+        self.closing != crate::g16_deferred::LIVE
     }
 }
 
@@ -120,10 +121,17 @@ fn cover(mappings: &[Self], start: u64, size: u64, permissions: u32) -> Result {
 
 /// A GEM close deferred until every fence pending at the close has signaled.
 struct Deferred {
-    obj: ARef<Object>,
+    /// Stamped on the mappings this close retired; the reaper unmaps those
+    /// only, not later mappings of the same object.
+    id: u64,
+    /// Keeps the object (and so its pages) alive until the unmap.
+    _obj: ARef<Object>,
     fences: KVec<dma_fence::Fence>,
 }
 
+/// Deferred close ids; never LIVE.
+static NEXT_CLOSE: AtomicU64 = AtomicU64::new(1);
+
 struct Vm {
     id: u32,
     visible: bool,
@@ -499,9 +507,11 @@ fn close(obj: &Object, file: &DrmFile) {
         loop {
             // IDs never repeat. Re-find after each wait: another ioctl may
             // destroy a VM or swap_remove an earlier vector entry meanwhile.
+            // Mappings an earlier close already retired belong to that
+            // close; only live ones (this handle's) are ours.
             let Some(id) = state.vms.iter()
                 .filter(|vm| vm.id > cursor && vm.mappings.iter()
-                    .any(|m| core::ptr::eq(&*m.obj, obj)))
+                    .any(|m| core::ptr::eq(&*m.obj, obj) && !crate::g16_deferred::Span::closing(m)))
                 .map(|vm| vm.id).min()
             else { break };
             cursor = id;
@@ -534,17 +544,20 @@ fn close(obj: &Object, file: &DrmFile) {
             if !vm.pending.is_empty() && crate::g16_deferred::admit(vm.deferred.len()) {
                 let mut fences = KVec::new();
                 let object = vm.mappings.iter()
-                    .find(|m| core::ptr::eq(&*m.obj, obj))
+                    .find(|m| core::ptr::eq(&*m.obj, obj) && m.closing == crate::g16_deferred::LIVE)
                     .map(|m| m.obj.clone());
                 if let Some(object) = object {
                     if fences.extend_from_slice(&vm.pending, GFP_KERNEL).is_ok()
                         && vm.deferred.reserve(1, GFP_KERNEL).is_ok()
                     {
-                        for m in vm.mappings.iter_mut().filter(|m| core::ptr::eq(&*m.obj, obj)) {
-                            m.closing = true;
+                        let close = NEXT_CLOSE.fetch_add(1, Ordering::Relaxed);
+                        for m in vm.mappings.iter_mut().filter(|m| {
+                            core::ptr::eq(&*m.obj, obj) && m.closing == crate::g16_deferred::LIVE
+                        }) {
+                            m.closing = close;
                         }
                         // Reserved above: cannot fail.
-                        let _ = vm.deferred.push_within_capacity(Deferred { obj: object, fences });
+                        let _ = vm.deferred.push_within_capacity(Deferred { id: close, _obj: object, fences });
                         // Pairs with signal_finished: it signals (a fully
                         // ordered bit set), then loads `armed`. If the snapshot
                         // completed before this store, it may have missed us;
@@ -756,7 +769,7 @@ fn reap(state: &mut FileState, device: &Device, armed: &AtomicBool) {
             }
             let entry = vm.deferred.swap_remove(index);
             let runtime = runtime.get_or_insert_with(|| device.runtime.lock());
-            if let Err(error) = vm.unmap_object(&entry.obj, runtime) {
+            if let Err(error) = vm.unmap_closed(entry.id, runtime) {
                 // Page tables may be partly edited: stop the device, as a
                 // failed close-time unbind always has.
                 device.failed.store(true, Ordering::Release);
diff --git a/drivers/gpu/drm/asahi/g16_drm_bind.rs b/drivers/gpu/drm/asahi/g16_drm_bind.rs
index e08c9878a33b..e1c62681d02f 100644
--- a/drivers/gpu/drm/asahi/g16_drm_bind.rs
+++ b/drivers/gpu/drm/asahi/g16_drm_bind.rs
@@ -69,7 +69,7 @@ pub(super) fn map(
                 offset: bo_offset,
                 single,
                 obj,
-                closing: false,
+                closing: crate::g16_deferred::LIVE,
             },
             GFP_KERNEL,
         )?;
@@ -120,11 +120,12 @@ pub(super) fn publish_mappings(&self, runtime: &crate::g16::Bootstrap) {
         }
     }
 
-    /// Unmap every mapping of `obj`: a closed object whose deferred
-    /// snapshot completed, or whose VM has drained.
-    pub(super) fn unmap_object(&mut self, obj: &Object, runtime: &crate::g16::Bootstrap) -> Result {
+    /// Unmap the mappings retired by deferred close `close`, whose snapshot
+    /// has completed. Later mappings of the same object (bound again under a
+    /// new handle) are live and stay.
+    pub(super) fn unmap_closed(&mut self, close: u64, runtime: &crate::g16::Bootstrap) -> Result {
         while let Some(range) = self.mappings.iter()
-            .find(|m| core::ptr::eq(&*m.obj, obj))
+            .find(|m| crate::g16_deferred::retired_by(m.closing, close))
             .map(|m| m.range.clone())
         {
             self.unmap(range, runtime)?;
diff --git a/drivers/gpu/drm/asahi/g16_drm_ioctl.rs b/drivers/gpu/drm/asahi/g16_drm_ioctl.rs
index 52e8bde220c5..efd7a1fca193 100644
--- a/drivers/gpu/drm/asahi/g16_drm_ioctl.rs
+++ b/drivers/gpu/drm/asahi/g16_drm_ioctl.rs
@@ -552,7 +552,7 @@ pub(super) fn vm_bind(device: &RegDevice, reg: &RegData<'_>, data: &mut uapi::dr
                     let mut fences = KVec::new();
                     for entry in vm.deferred.iter() {
                         if vm.mappings.iter().any(|m| {
-                            m.closing && core::ptr::eq(&*m.obj, &*entry.obj)
+                            crate::g16_deferred::retired_by(m.closing, entry.id)
                                 && address < m.range.end && end > m.range.start
                         }) {
                             fences.extend_from_slice(&entry.fences, GFP_KERNEL)?;
diff --git a/tools/testing/selftests/drivers/gpu/asahi/deferred-unmap.rs b/tools/testing/selftests/drivers/gpu/asahi/deferred-unmap.rs
index 01be83c053e7..fcd38ad952b5 100644
--- a/tools/testing/selftests/drivers/gpu/asahi/deferred-unmap.rs
+++ b/tools/testing/selftests/drivers/gpu/asahi/deferred-unmap.rs
@@ -1,7 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 // Included by test-deferred-unmap.py with the production g16_deferred.rs.
 use core::ops::Range;
-use g16_deferred::{admit, covered, overlap, ready, Overlap, Span, MAX_ENTRIES};
+use g16_deferred::{admit, covered, overlap, ready, retired_by, Overlap, Span, LIVE, MAX_ENTRIES};
 
 #[derive(Clone)]
 struct M(Range<u64>, u32, bool);
@@ -73,3 +73,16 @@ fn the_entry_cap_falls_back_to_waiting() {
     assert!(admit(MAX_ENTRIES - 1));
     assert!(!admit(MAX_ENTRIES));
 }
+
+#[test]
+fn a_close_reaps_only_the_mappings_it_retired() {
+    // Close 7 retired the object's first mapping. The same GEM object then
+    // came back under a new handle (dma-buf imported again) and was bound
+    // at a new address: that mapping is live (LIVE) and must survive close
+    // 7's reap, as must a mapping a later close 9 retired.
+    assert!(retired_by(7, 7));
+    assert!(!retired_by(LIVE, 7));
+    assert!(!retired_by(9, 7));
+    // No entry has id LIVE, and a live mapping is never reaped.
+    assert!(!retired_by(LIVE, LIVE));
+}
