From 60b6ebbccf2e491718a71df46eb08bdda2f8fa57 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Tue, 27 Oct 2026 11:55:56 -0400
Subject: [PATCH] usb: typec: tipd: release the USB role before switching the
 mux

cd321x_update_work only drops the USB role before a mux switch when the
role itself changes. A mode change under an unchanged role, e.g. when
the USB4 link drops and the controller renegotiates, switches the ATC
PHY while dwc3 still holds the PIPE interface. atcphy_mux_set then
warns (atc.c pipehandler_up) and the port falls back to USB2.

Drop the role to none before every mux switch. dwc3-apple's role
switch is synchronous, so the PIPE handler is down before the PHY
changes mode; the work function sets the new role afterwards.

[Youwes09: without the Thunderbolt switch calls]
Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 drivers/usb/typec/tipd/core.c | 24 +++++++++++++++++++-----
 1 file changed, 19 insertions(+), 5 deletions(-)

diff --git a/drivers/usb/typec/tipd/core.c b/drivers/usb/typec/tipd/core.c
index 8a2cf77d4bd4..aeb3c82d1bec 100644
--- a/drivers/usb/typec/tipd/core.c
+++ b/drivers/usb/typec/tipd/core.c
@@ -580,6 +580,20 @@ static bool cd321x_data_connected(const struct cd321x_status *st)
 	return st->data_status & TPS_DATA_STATUS_DATA_CONNECTION;
 }
 
+/*
+ * Switch the Type-C mux to cd321x->state. The PHY can only change modes while
+ * dwc3 has released its PIPE interface: a switch under an active USB role
+ * leaves the port on USB2. The role is restored by the caller afterwards.
+ */
+static void cd321x_mux_set(struct tps6598x *tps)
+{
+	struct cd321x *cd321x = container_of(tps, struct cd321x, tps);
+
+	if (usb_role_switch_get_role(tps->role_sw) != USB_ROLE_NONE)
+		usb_role_switch_set_role(tps->role_sw, USB_ROLE_NONE);
+	typec_mux_set(cd321x->mux, &cd321x->state);
+}
+
 static void cd321x_typec_update_mode(struct tps6598x *tps, struct cd321x_status *st)
 {
 	struct cd321x *cd321x = container_of(tps, struct cd321x, tps);
@@ -590,7 +604,7 @@ static void cd321x_typec_update_mode(struct tps6598x *tps, struct cd321x_status
 		cd321x->state.alt = NULL;
 		cd321x->state.mode = TYPEC_STATE_SAFE;
 		cd321x->state.data = NULL;
-		typec_mux_set(cd321x->mux, &cd321x->state);
+		cd321x_mux_set(tps);
 	} else if (st->data_status & TPS_DATA_STATUS_DP_CONNECTION) {
 		struct typec_displayport_data dp_data;
 		unsigned long mode;
@@ -629,7 +643,7 @@ static void cd321x_typec_update_mode(struct tps6598x *tps, struct cd321x_status
 		cd321x->state.alt = cd321x->port_altmode_dp;
 		cd321x->state.data = &dp_data;
 		cd321x->state.mode = mode;
-		typec_mux_set(cd321x->mux, &cd321x->state);
+		cd321x_mux_set(tps);
 	} else if (st->data_status & TPS_DATA_STATUS_TBT_CONNECTION) {
 		struct typec_thunderbolt_data tbt_data;
 
@@ -653,7 +667,7 @@ static void cd321x_typec_update_mode(struct tps6598x *tps, struct cd321x_status
 		cd321x->state.alt = cd321x->port_altmode_tbt;
 		cd321x->state.mode = TYPEC_TBT_MODE;
 		cd321x->state.data = &tbt_data;
-		typec_mux_set(cd321x->mux, &cd321x->state);
+		cd321x_mux_set(tps);
 	} else if (st->data_status & CD321X_DATA_STATUS_USB4_CONNECTION) {
 		struct enter_usb_data eusb_data;
 
@@ -667,14 +681,14 @@ static void cd321x_typec_update_mode(struct tps6598x *tps, struct cd321x_status
 		cd321x->state.alt = NULL;
 		cd321x->state.data = &eusb_data;
 		cd321x->state.mode = TYPEC_MODE_USB4;
-		typec_mux_set(cd321x->mux, &cd321x->state);
+		cd321x_mux_set(tps);
 	} else {
 		if (cd321x->state.alt == NULL && cd321x->state.mode == TYPEC_STATE_USB)
 			return;
 		cd321x->state.alt = NULL;
 		cd321x->state.mode = TYPEC_STATE_USB;
 		cd321x->state.data = NULL;
-		typec_mux_set(cd321x->mux, &cd321x->state);
+		cd321x_mux_set(tps);
 	}
 
 	/* Clear data since it's no longer used after typec_mux_set and points to the stack */
