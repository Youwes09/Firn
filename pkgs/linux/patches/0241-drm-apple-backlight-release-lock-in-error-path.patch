From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caspar Schutijser <caspar@schutijser.com>
Date: Thu, 18 Apr 2024 22:26:58 +0100
Subject: [PATCH] drm: apple: backlight: release lock in error path

Signed-off-by: Caspar Schutijser <caspar@schutijser.com>
---
 drivers/gpu/drm/apple/dcp_backlight.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp_backlight.c b/drivers/gpu/drm/apple/dcp_backlight.c
index 6cb2c57202cc..af593d08b8b8 100644
--- a/drivers/gpu/drm/apple/dcp_backlight.c
+++ b/drivers/gpu/drm/apple/dcp_backlight.c
@@ -149,9 +149,11 @@ static int drm_crtc_set_brightness(struct apple_dcp *dcp)
 	if (!dcp->brightness.update)
 		goto done;
 
-	state = drm_atomic_state_alloc(crtc->dev);
-	if (!state)
-		return -ENOMEM;
+	commit = drm_atomic_commit_alloc(crtc->dev);
+	if (!commit) {
+		ret = -ENOMEM;
+		goto done;
+	}
 
 	commit->acquire_ctx = &ctx;
 	crtc_state = drm_atomic_get_crtc_state(commit, crtc);
