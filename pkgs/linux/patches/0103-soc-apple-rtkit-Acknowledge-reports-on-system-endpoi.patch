From 4624691b8afd8028e0802fa6cceae2c8c710a7b3 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Mon, 26 Oct 2026 18:51:48 -0400
Subject: [PATCH] soc: apple: rtkit: Acknowledge reports on system endpoint 7

Endpoint 7 behaves like IOReport: it asks for a buffer, then sends type
0x8 reports. Only the buffer request was handled; reports were logged
as unknown and never answered. PMP starts sending them some time after
it is running, and on the Air a GPU hang with a sluggish system followed
the first one.

Answer 0x8 and 0xc by echoing them, as for IOReport.

[Youwes09: from niklassheth/linux 1b6d546d99c8]
Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 drivers/soc/apple/rtkit.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/soc/apple/rtkit.c b/drivers/soc/apple/rtkit.c
index 34b6b148d279..92c97db5e38d 100644
--- a/drivers/soc/apple/rtkit.c
+++ b/drivers/soc/apple/rtkit.c
@@ -436,6 +436,17 @@ static void apple_rtkit_system7_rx(struct apple_rtkit *rtk, u64 msg)
 		apple_rtkit_common_rx_get_buffer(rtk, &rtk->system7_buffer,
 						 APPLE_RTKIT_EP_UNKNOWN7, msg);
 		break;
+	/*
+	 * Endpoint 7 follows the IOReport protocol: a buffer request, then
+	 * reports that are answered by echoing them back.  PMP sends these
+	 * once it is running.
+	 */
+	case 0x8:
+	case 0xc:
+		dev_dbg(rtk->dev, "RTKit: system endpoint 7 message %llx, acked\n", msg);
+		apple_rtkit_send_message(rtk, APPLE_RTKIT_EP_UNKNOWN7, msg,
+					 NULL, false);
+		break;
 	default:
 		dev_warn(rtk->dev, "RTKit: Unknown system endpoint 7 message: %llx\n",
 			 msg);
