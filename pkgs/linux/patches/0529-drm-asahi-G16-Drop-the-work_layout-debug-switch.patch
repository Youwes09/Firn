From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Tue, 20 Oct 2026 00:24:30 -0400
Subject: [PATCH] drm/asahi: G16: Drop the work_layout debug switch

work_layout copied Work fields as macOS lays them out: no TVB growth
request or fragment flags (1), render index rings (2), completion
control 3 (4) and fragment gate 0xb5 outside each 40-render cycle start
(8). Production never set it; every field keeps its original value.

Signed-off-by: Niklas Sheth <hi@niklassheth.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/asahi/asahi_m4.rs    |  6 +-----
 drivers/gpu/drm/asahi/g16_drm.rs     |  8 ++------
 drivers/gpu/drm/asahi/g16_runtime.rs | 25 -------------------------
 3 files changed, 3 insertions(+), 36 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_m4.rs b/drivers/gpu/drm/asahi/asahi_m4.rs
index e49a11119448..495e87f7ef6f 100644
--- a/drivers/gpu/drm/asahi/asahi_m4.rs
+++ b/drivers/gpu/drm/asahi/asahi_m4.rs
@@ -197,10 +197,6 @@ fn probe<'bound>(
             default: 0,
             description: "Identify the GPU without starting firmware or registering DRM",
         },
-        work_layout: u32 {
-            default: 0,
-            description: "Work fields as macOS (debug): 1=no TVB growth request or fragment flags 0xba8/0xbdc, 2=render index rings, 4=completion control 3, 8=fragment gate 0xb5 after each 40-render cycle start",
-        },
         compute_preempt: u32 {
             default: 0,
             description: "Debug: 1 gives compute queues the native preemptible profile (Metal uses it for compute; this driver forces compute non-preemptible)",
@@ -215,7 +211,7 @@ fn probe<'bound>(
         },
         completion_control: u32 {
             default: 4,
-            description: "Debug: completion control value for registers 0x14308/0x14048 (driver original 4; macOS uses 0-3: 3 solo, mostly 1 under contention). work_layout bit 4 forces 3",
+            description: "Debug: completion control value for registers 0x14308/0x14048 (driver original 4; macOS uses 0-3: 3 solo, mostly 1 under contention)",
         },
         micro_layout: u32 {
             default: 0,
diff --git a/drivers/gpu/drm/asahi/g16_drm.rs b/drivers/gpu/drm/asahi/g16_drm.rs
index a7c851798940..c10ca4814d8d 100644
--- a/drivers/gpu/drm/asahi/g16_drm.rs
+++ b/drivers/gpu/drm/asahi/g16_drm.rs
@@ -2533,12 +2533,8 @@ fn render_parameters(&self, c: &uapi::drm_asahi_cmd_render) -> Result<render::Pa
         p.tiling_work_stamp = 0x120;
         p.fragment_work_stamp = 0x121;
         // macOS writes 0-3 (3 solo, mostly 1 under contention); this driver's
-        // original value is 4. Debug: work_layout & 4 forces 3.
-        p.completion_control = if crate::module_parameters::work_layout.value() & 4 != 0 {
-            3
-        } else {
-            u64::from(crate::module_parameters::completion_control.value())
-        };
+        // original value is 4.
+        p.completion_control = u64::from(crate::module_parameters::completion_control.value());
         p.layermeta = p.heapmeta;
         if p.layers > 1 {
             p.heapmeta += 0x100;
diff --git a/drivers/gpu/drm/asahi/g16_runtime.rs b/drivers/gpu/drm/asahi/g16_runtime.rs
index 8443e6e761ad..5cad35ca31e7 100644
--- a/drivers/gpu/drm/asahi/g16_runtime.rs
+++ b/drivers/gpu/drm/asahi/g16_runtime.rs
@@ -2308,11 +2308,6 @@ fn submit_render_pool(
         a.tiling_status_page = params.ta_status & !0x3fff;
         a.fragment_status_page = params.fragment_status & !0x3fff;
         let queue_ordinal = queue.render_count;
-        if crate::module_parameters::work_layout.value() & 8 != 0 && queue_ordinal % 40 != 0 {
-            // As macOS: only the first render of each 40-render cycle uses
-            // 0xd5 in this fragment register; the others use 0xb5.
-            params.fragment_gate = 0xb5_0040_0020;
-        }
         a.fragment_counter = queue_ordinal.wrapping_mul(2);
         a.tiling_counter = a.fragment_counter.wrapping_add(1);
         // Firmware's dependency graph requires consecutive stamp updates
@@ -2421,26 +2416,6 @@ fn submit_render_pool(
                 }
             }
         }
-        let layout = crate::module_parameters::work_layout.value();
-        if layout & 1 != 0 {
-            // As macOS in steady state: no TVB growth request and neither
-            // fragment flag that this driver set unconditionally.
-            ta[0x864] = 0;
-            frag[0xba8..0xbac].fill(0);
-            frag[0xbdc..0xbe0].fill(0);
-        }
-        if layout & 2 != 0 && params.layers == 1 {
-            // As macOS: a render index modulo 40, and modulo 4 in the top
-            // bits of the support-page operands.
-            let index = queue_ordinal % 40;
-            ta[0x8a0..0x8a8].copy_from_slice(&index.to_le_bytes());
-            frag[0xbe8..0xbf0].copy_from_slice(&index.to_le_bytes());
-            for (bytes, offset) in [(&mut ta[..], 0x908usize), (&mut frag[..], 0xc50)] {
-                let mut word = u64::from_le_bytes(bytes[offset..offset + 8].try_into().map_err(|_| EINVAL)?);
-                word = (word & !(3 << 62)) | ((queue_ordinal % 4) << 62);
-                bytes[offset..offset + 8].copy_from_slice(&word.to_le_bytes());
-            }
-        }
         let vm_root = client.roots().low;
         let pages = if crate::module_parameters::dump_render_recent.value() != 0
             || crate::module_parameters::dump_render_buffered.value() != 0
