+static int dcp_start_aux_ep(struct apple_dcp *dcp, u32 endpoint,
+			    struct apple_dcp_afkep **out)
+{
+	int ret;
+
+	*out = afk_init(dcp, endpoint, dcp_compact_aux_ops);
+	if (IS_ERR(*out)) {
+		ret = PTR_ERR(*out);
+		*out = NULL;
+		return ret;
+	}
+
+	ret = afk_start(*out);
+	if (ret) {
+		afk_shutdown(*out);
+		*out = NULL;
+	}
+
+	return ret;
