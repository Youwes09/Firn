+	spin_lock_irqsave(&ep->lock, flags);
+	if (!list_empty(&pending.node))
+		list_del_init(&pending.node);
+	pending.status = ret;
+	spin_unlock_irqrestore(&ep->lock, flags);
+out:
+	kfree(wrapped);
+	return ret;
+}
