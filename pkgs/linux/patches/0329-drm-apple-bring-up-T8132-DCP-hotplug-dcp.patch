+
+static int dcp_activate_dpavctrl(struct apple_dcp *dcp)
+{
+	int i, ret;
+
+	/* The two AV controllers must be opened before the deferred interface. */
+	for (i = 1; i >= 0; i--) {
+		if (!dcp->dpavctrl_av_controller[i])
