diff --git a/drivers/gpu/drm/apple/vblank.c b/drivers/gpu/drm/apple/vblank.c
new file mode 100644
index 000000000000..93f389d793a3
--- /dev/null
+++ b/drivers/gpu/drm/apple/vblank.c
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Vblank timing for DCP.
+ *
+ * DCP raises no vblank interrupt the AP can see, but it completes each swap
+ * on the frame boundary: swaps submitted at any time complete on a grid of
+ * the frame period, within about 10 us. A swap must reach DCP about 2.4 ms
+ * before that completion to make the frame, and one that arrives later
+ * than about 2.35 ms makes it but completes up to 100 us late, so
+ * completions can be late but are never early.
+ *
+ * The grid is modelled from the completions: an early one moves it at
+ * once, a late one only by a sixteenth, and the period is measured over
+ * about ten seconds of them. A timer delivers vblanks between swaps.
+ * Timestamps are placed so that the next vblank start, as
+ * drm_crtc_next_vblank_start() computes it, is the latest time a swap
+ * still makes the next frame.
+ */
+
+#include <linux/hrtimer.h>
+#include <linux/ktime.h>
+#include <linux/math64.h>
+#include <linux/spinlock.h>
+
+#include <drm/drm_crtc.h>
+#include <drm/drm_vblank.h>
+
+#include "dcp.h"
+
+/* How long before its completion a swap must reach DCP, measured on J713. */
+#define DCP_SWAP_LEAD_NS (2400 * NSEC_PER_USEC)
+
+/* Completions at most this far off the grid only adjust it. */
+#define DCP_SYNC_WINDOW(period) ((period) / 4)
+
+/* Frames between period measurements: about ten seconds at 60 Hz. */
+#define DCP_PERIOD_FRAMES 600
+
+/* Off by more than this from the mode's period, a measurement is wrong. */
+#define DCP_PERIOD_TOLERANCE(period) ((period) / 200)
+
+static u64 mode_period(struct apple_crtc *crtc)
+{
+	return drm_crtc_vblank_crtc(&crtc->base)->framedur_ns;
+}
+
+/* Swap completion minus the vblank timestamp of its frame. */
+static s64 completion_offset(struct apple_crtc *crtc)
+{
+	struct drm_vblank_crtc *vblank = drm_crtc_vblank_crtc(&crtc->base);
+	const struct drm_display_mode *mode = &vblank->hwmode;
+	u64 blank;
+
+	if (!mode->crtc_vtotal)
+		return DCP_SWAP_LEAD_NS;
+
+	blank = div_u64((u64)vblank->framedur_ns *
+				(mode->crtc_vtotal - mode->crtc_vblank_start),
+			mode->crtc_vtotal);
+	return DCP_SWAP_LEAD_NS - blank;
+}
+
+/* The vblank timestamp at or before @t, or nearest to it if @nearest. */
+static ktime_t grid_point(struct apple_crtc *crtc, ktime_t t, bool nearest)
+{
+	s64 since = ktime_to_ns(ktime_sub(t, crtc->vblank_base));
+	s64 n;
+
+	if (nearest)
+		since += crtc->vblank_period / 2;
+	n = div64_s64(since, crtc->vblank_period);
+	if (since < 0 && n * (s64)crtc->vblank_period != since)
+		n--;
+	return ktime_add_ns(crtc->vblank_base, n * crtc->vblank_period);
+}
+
+static void reset_grid(struct apple_crtc *crtc, ktime_t base)
+{
+	crtc->vblank_base = base;
+	crtc->vblank_ref = base;
+	crtc->vblank_ref_frames = 0;
+}
+
+static enum hrtimer_restart vblank_timer_fn(struct hrtimer *timer)
+{
+	struct apple_crtc *crtc = container_of(timer, struct apple_crtc, vblank_timer);
+	unsigned long flags;
+	ktime_t next;
+
+	spin_lock_irqsave(&crtc->vblank_lock, flags);
+	if (!crtc->vblank_enabled) {
+		spin_unlock_irqrestore(&crtc->vblank_lock, flags);
+		return HRTIMER_NORESTART;
+	}
+	next = ktime_add_ns(grid_point(crtc, ktime_get(), false), crtc->vblank_period);
+	hrtimer_set_expires(timer, next);
+	spin_unlock_irqrestore(&crtc->vblank_lock, flags);
+
+	drm_crtc_handle_vblank(&crtc->base);
+	return HRTIMER_RESTART;
+}
+
+void apple_crtc_vblank_init(struct apple_crtc *crtc)
+{
+	spin_lock_init(&crtc->vblank_lock);
+	hrtimer_setup(&crtc->vblank_timer, vblank_timer_fn, CLOCK_MONOTONIC,
+		      HRTIMER_MODE_ABS);
+}
+
+/* Forget the grid, for a new mode. */
+void apple_crtc_vblank_reset(struct apple_crtc *crtc)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&crtc->vblank_lock, flags);
+	crtc->vblank_synced = false;
+	crtc->vblank_period = mode_period(crtc);
+	crtc->vblank_offset = completion_offset(crtc);
+	reset_grid(crtc, ktime_get());
+	spin_unlock_irqrestore(&crtc->vblank_lock, flags);
+}
+
+int apple_crtc_enable_vblank(struct drm_crtc *base)
+{
+	struct apple_crtc *crtc = to_apple_crtc(base);
+	unsigned long flags;
+	ktime_t next;
+
+	spin_lock_irqsave(&crtc->vblank_lock, flags);
+	if (!crtc->vblank_period) {
+		crtc->vblank_period = mode_period(crtc);
+		crtc->vblank_offset = completion_offset(crtc);
+		reset_grid(crtc, ktime_get());
+	}
+	if (!crtc->vblank_period) {
+		spin_unlock_irqrestore(&crtc->vblank_lock, flags);
+		return -EINVAL;
+	}
+	crtc->vblank_enabled = true;
+	next = ktime_add_ns(grid_point(crtc, ktime_get(), false), crtc->vblank_period);
+	spin_unlock_irqrestore(&crtc->vblank_lock, flags);
+
+	hrtimer_start(&crtc->vblank_timer, next, HRTIMER_MODE_ABS);
+	return 0;
+}
+
+void apple_crtc_disable_vblank(struct drm_crtc *base)
+{
+	struct apple_crtc *crtc = to_apple_crtc(base);
+	unsigned long flags;
+
+	/*
+	 * Called under the vblank core's locks, which the timer takes, so
+	 * it cannot wait for a running timer; that one stops by itself.
+	 */
+	spin_lock_irqsave(&crtc->vblank_lock, flags);
+	crtc->vblank_enabled = false;
+	spin_unlock_irqrestore(&crtc->vblank_lock, flags);
+	hrtimer_try_to_cancel(&crtc->vblank_timer);
+}
+
+bool apple_crtc_get_vblank_timestamp(struct drm_crtc *base, int *max_error,
+				     ktime_t *vblank_time, bool in_vblank_irq)
+{
+	struct apple_crtc *crtc = to_apple_crtc(base);
+	unsigned long flags;
+	bool ok;
+
+	spin_lock_irqsave(&crtc->vblank_lock, flags);
+	ok = crtc->vblank_period != 0;
+	/*
+	 * In a vblank, the timer or a completion may run slightly before the
+	 * grid has caught up with it, so take the nearest point.
+	 */
+	if (ok)
+		*vblank_time = grid_point(crtc, ktime_get(), in_vblank_irq);
+	spin_unlock_irqrestore(&crtc->vblank_lock, flags);
+
+	return ok;
+}
+
+/* Fit the grid to a swap completion at @now. */
+void apple_crtc_vblank_completion(struct apple_crtc *crtc, ktime_t now)
+{
+	ktime_t seen, expected;
+	unsigned long flags;
+	s64 error, frames;
+	u64 period;
+
+	spin_lock_irqsave(&crtc->vblank_lock, flags);
+	period = crtc->vblank_period;
+	if (!period) {
+		spin_unlock_irqrestore(&crtc->vblank_lock, flags);
+		return;
+	}
+
+	seen = ktime_sub_ns(now, crtc->vblank_offset);
+	expected = grid_point(crtc, seen, true);
+	error = ktime_to_ns(ktime_sub(seen, expected));
+
+	if (!crtc->vblank_synced || abs(error) > DCP_SYNC_WINDOW(period)) {
+		crtc->vblank_synced = true;
+		reset_grid(crtc, seen);
+		goto out;
+	}
+
+	frames = div64_s64(ktime_to_ns(ktime_sub(expected, crtc->vblank_base)) +
+				   period / 2, period);
+	crtc->vblank_base = ktime_add_ns(expected, error < 0 ? error : error / 16);
+	crtc->vblank_ref_frames += frames;
+
+	if (crtc->vblank_ref_frames >= DCP_PERIOD_FRAMES) {
+		u64 measured = div64_u64(ktime_to_ns(ktime_sub(crtc->vblank_base,
+							      crtc->vblank_ref)),
+					 crtc->vblank_ref_frames);
+		u64 nominal = mode_period(crtc);
+
+		if (nominal && abs((s64)measured - (s64)nominal) <=
+				       DCP_PERIOD_TOLERANCE(nominal))
+			crtc->vblank_period = measured;
+		crtc->vblank_ref = crtc->vblank_base;
+		crtc->vblank_ref_frames = 0;
+	}
+out:
+	spin_unlock_irqrestore(&crtc->vblank_lock, flags);
+}
