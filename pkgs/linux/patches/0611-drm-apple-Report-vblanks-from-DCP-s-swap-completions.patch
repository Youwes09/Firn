-	seq = 0;
-	if (start != KTIME_MIN) {
-		s64 delta = ktime_us_delta(now, start);
-		if (delta <= 500)
-			flip = now;
-		else if (delta >= 2500)
-			flip = ktime_sub_us(now, 1000);
-		else
-			flip = ktime_sub_us(now, (delta - 500) / 2);
-	} else {
-		flip = now;
-	}
-	e->pipe = pipe;
-	send_vblank_event(dev, e, seq, flip);
