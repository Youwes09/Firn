From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Sun, 4 Oct 2026 09:43:57 -0400
Subject: [PATCH] drm/asahi: Use vmalloc-capable vectors for large M4 bind and
 submit buffers

Vm::map collected every scatterlist segment of the mapped object into a
KVec, and VM_BIND records and the submit command buffer (each up to
1 MiB from userspace) were copied into KVecs. Those need physically
contiguous memory: CS2 under muvm hit an order-5 page allocation
failure in Vm::map under memory pressure, failing the bind and leaving
the application waiting on fences. Use KVVec, which falls back to
vmalloc for large sizes.
(cherry picked from commit a57a0d0932834a218d397f84411870d58df668ad)
[Niklas: ported to v7.3: same three vectors; context differs in the ported G16 code]

Signed-off-by: Niklas Sheth <hi@niklassheth.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RvQieG9SGoR3ZeSdSguHnB
---
 drivers/gpu/drm/asahi/g16_drm.rs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16_drm.rs b/drivers/gpu/drm/asahi/g16_drm.rs
index 452b480ffc32..93851d3c7e67 100644
--- a/drivers/gpu/drm/asahi/g16_drm.rs
+++ b/drivers/gpu/drm/asahi/g16_drm.rs
@@ -676,7 +676,7 @@ fn vm_bind(device: &RegDevice, reg: &RegData<'_>, data: &mut uapi::drm_asahi_vm_
         if byte_count > 1024 * 1024 {
             return Err(EINVAL);
         }
-        let mut records = KVec::new();
+        let mut records = KVVec::new();
         UserSlice::new(UserPtr::from_addr(data.userptr.try_into()?), byte_count)
             .reader()
             .read_all(&mut records, GFP_KERNEL)?;
@@ -874,7 +874,7 @@ fn map(
             return Err(EEXIST);
         }
         let bo_offset = offset;
-        let mut chunks = KVec::new();
+        let mut chunks = KVVec::new();
         let mut va = range.start;
         for segment in sgt.iter() {
             let length = u64::from(segment.dma_len());
@@ -1387,7 +1387,7 @@ fn submit(device: &RegDevice, _reg: &RegData<'_>, data: &mut uapi::drm_asahi_sub
         {
             return Err(EINVAL);
         }
-        let mut bytes = KVec::new();
+        let mut bytes = KVVec::new();
         UserSlice::new(
             UserPtr::from_addr(data.cmdbuf.try_into()?),
             data.cmdbuf_size as usize,
