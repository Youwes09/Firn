@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+//! The GPU as a thermal cooling device.
+//!
+//! Cooling state `n` caps the firmware at `n` performance states below the
+//! top, through region C's performance-state cap. The firmware rereads the
+//! cap by itself, so the driver writes it before its next publication. The
+//! lowest cap is state 1, the slowest state above off.
+//!
+//! The power callbacks let the power allocator governor budget the GPU with
+//! the CPUs. Power at each state follows dynamic power, frequency times the
+//! square of the core voltage, scaled to the device tree's maximum power.
+//! Requested power is that maximum times the share of time the GPU had work
+//! in flight.
+
+use core::sync::atomic::{AtomicU32, Ordering};
+use kernel::{
+    new_spinlock,
+    prelude::*,
+    sync::{Arc, SpinLock},
+    thermal,
+    time::{Instant, Monotonic},
+};
+
+/// Time with work in flight, sampled by `requested_power`.
+struct Busy {
+    /// Start of the current busy period, if work is in flight.
+    since: Option<Instant<Monotonic>>,
+    /// Busy time before `since`, in ns.
+    total: i64,
+    /// The previous sample: when, and `total` then.
+    sampled: Instant<Monotonic>,
+    sampled_total: i64,
+}
+
+#[pin_data]
+pub(crate) struct Cooling {
+    /// The top performance state.
+    top: u32,
+    /// Power in mW at each performance state, from off to the top.
+    power: KVec<u32>,
+    /// The cooling state the thermal core set.
+    state: AtomicU32,
+    #[pin]
+    busy: SpinLock<Busy>,
+}
+
+impl Cooling {
+    pub(crate) fn new(platform: &crate::g16_platform::Platform) -> Result<Arc<Self>> {
+        let top = platform.max_pstate();
+        let (frequency, voltage) = (&platform.freq_a, platform.core_voltage());
+        if voltage.len() != frequency.len() || top == 0 {
+            return Err(EINVAL);
+        }
+        let dynamic = |state: usize| u64::from(frequency[state]) * u64::from(voltage[state]).pow(2);
+        let full = dynamic(top as usize);
+        let mut power = KVec::with_capacity(frequency.len(), GFP_KERNEL)?;
+        for state in 0..frequency.len() {
+            power.push(
+                (u64::from(platform.maximum_power) * dynamic(state) / full) as u32,
+                GFP_KERNEL,
+            )?;
+        }
+        let now = Instant::now();
+        Arc::pin_init(
+            pin_init!(Self {
+                top,
+                power,
+                state: AtomicU32::new(0),
+                busy <- new_spinlock!(Busy { since: None, total: 0, sampled: now, sampled_total: 0 }),
+            }),
+            GFP_KERNEL,
+        )
+    }
+
+    /// The performance-state cap the current cooling state asks for.
+    pub(crate) fn cap(&self) -> u32 {
+        self.top - self.state.load(Ordering::Relaxed)
+    }
+
+    /// Note that work went in flight, or that the last of it retired.
+    pub(crate) fn set_busy(&self, busy: bool) {
+        let now = Instant::now();
+        let mut record = self.busy.lock();
+        match (record.since, busy) {
+            (None, true) => record.since = Some(now),
+            (Some(since), false) => {
+                record.total += (now - since).as_nanos();
+                record.since = None;
+            }
+            _ => {}
+        }
+    }
+}
+
+/// The registered device's callbacks.
+pub(crate) struct Device(pub(crate) Arc<Cooling>);
+
+#[vtable]
+impl thermal::CoolingDevice for Device {
+    fn max_state(&self) -> Result<u64> {
+        Ok(u64::from(self.0.top - 1))
+    }
+
+    fn cur_state(&self) -> Result<u64> {
+        Ok(u64::from(self.0.state.load(Ordering::Relaxed)))
+    }
+
+    fn set_cur_state(&self, state: u64) -> Result {
+        if state >= u64::from(self.0.top) {
+            return Err(EINVAL);
+        }
+        self.0.state.store(state as u32, Ordering::Relaxed);
+        Ok(())
+    }
+
+    fn requested_power(&self) -> Result<u32> {
+        let now = Instant::now();
+        let mut record = self.0.busy.lock();
+        let total = record.total + record.since.map_or(0, |since| (now - since).as_nanos());
+        let busy = total - record.sampled_total;
+        let elapsed = (now - record.sampled).as_nanos();
+        record.sampled = now;
+        record.sampled_total = total;
+        drop(record);
+        if elapsed <= 0 {
+            return Ok(0);
+        }
+        let full = i64::from(self.0.power[self.0.top as usize]);
+        Ok((full * busy.clamp(0, elapsed) / elapsed) as u32)
+    }
+
+    fn state_to_power(&self, state: u64) -> Result<u32> {
+        if state >= u64::from(self.0.top) {
+            return Err(EINVAL);
+        }
+        Ok(self.0.power[(u64::from(self.0.top) - state) as usize])
+    }
+
+    fn power_to_state(&self, power: u32) -> Result<u64> {
+        let top = self.0.top;
+        Ok((0..top - 1)
+            .find(|&state| self.0.power[(top - state) as usize] <= power)
+            .unwrap_or(top - 1)
+            .into())
+    }
+}
