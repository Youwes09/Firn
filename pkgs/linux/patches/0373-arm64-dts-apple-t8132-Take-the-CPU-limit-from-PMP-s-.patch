From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Thu, 5 Nov 2026 19:07:42 -0600
Subject: [PATCH] arm64: dts: apple: t8132: Take the CPU limit from PMP's fast
 die loop

PMP publishes the E cluster's effort in lane 0 of FAST-DIE-CE and the P
cluster's in lane 1. Point each cluster at its lane so cpufreq applies
the limit.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 7f76b9a71323..5420c354edb7 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -454,12 +454,14 @@ cpufreq_e: cpufreq@210e20000 {
 			compatible = "apple,t8132-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
 			reg = <0x2 0x10e20000 0x0 0x1000>;
 			#performance-domain-cells = <0>;
+			apple,fast-die-effort = <&pmp_report 0>;
 		};
 
 		cpufreq_p: cpufreq@211e20000 {
 			compatible = "apple,t8132-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
 			reg = <0x2 0x11e20000 0x0 0x1000>;
 			#performance-domain-cells = <0>;
+			apple,fast-die-effort = <&pmp_report 1>;
 		};
 
 		disp0_dart: iommu@30a300000 {
