From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Mon, 9 Nov 2026 23:38:37 -0500
Subject: [PATCH] drm/asahi: g16: refuse render operand pools known to hang the
 GPU

render_operand_buffers accepted 1..24 operand buffers per VM render
pool, although its own description records that 4 hung the GPU and 8
already stalled large shader scratch frames for 2 s.

Refuse values below 8, the smallest pool seen to complete those frames,
in the debugfs knob and at the first render of a VM, and clamp the
module parameter into range with a warning. The default (24) is
unchanged.

Signed-off-by: Niklas Sheth <hi@niklassheth.com>
---
 drivers/gpu/drm/asahi/asahi_m4.rs       |  2 +-
 drivers/gpu/drm/asahi/g16_drm_submit.rs |  2 +-
 drivers/gpu/drm/asahi/g16_render.rs     |  5 ++++-
 drivers/gpu/drm/asahi/g16_timeline.rs   | 25 +++++++++++++++++--------
 4 files changed, 23 insertions(+), 11 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_m4.rs b/drivers/gpu/drm/asahi/asahi_m4.rs
index eae6f1f908bb..a8198678fba9 100644
--- a/drivers/gpu/drm/asahi/asahi_m4.rs
+++ b/drivers/gpu/drm/asahi/asahi_m4.rs
@@ -173,7 +173,7 @@ fn probe<'bound>(
         },
         render_operand_buffers: u32 {
             default: 24,
-            description: "Research: 2 MiB shader private-memory (operand) buffers in each VM's render pool, 1..=24 (default 24; native mesh VMs always use 24). Each is resident for the VM's lifetime. Smaller pools starve large shader scratch frames: 8 made 32 KiB frames 3.7x slower with a 2 s stall, 4 hung the GPU. Runtime: debugfs asahi_m4/render_operand_buffers, read at each VM's first render",
+            description: "Research: 2 MiB shader private-memory (operand) buffers in each VM's render pool, 8..=24 (default 24; native mesh VMs always use 24). Each is resident for the VM's lifetime. Smaller pools starve large shader scratch frames: 8 made 32 KiB frames 3.7x slower with a 2 s stall; 4 hung the GPU, so values below 8 are refused. Runtime: debugfs asahi_m4/render_operand_buffers, read at each VM's first render",
         },
         compute_pool_buffers: u32 {
             default: 16,
diff --git a/drivers/gpu/drm/asahi/g16_drm_submit.rs b/drivers/gpu/drm/asahi/g16_drm_submit.rs
index 2331a05f5e14..344608a30dfd 100644
--- a/drivers/gpu/drm/asahi/g16_drm_submit.rs
+++ b/drivers/gpu/drm/asahi/g16_drm_submit.rs
@@ -269,7 +269,7 @@ pub(super) fn submit(device: &RegDevice, _reg: &RegData<'_>, data: &mut uapi::dr
                     crate::g16_timeline::RENDER_OPERAND_BUFFERS.load(Ordering::Relaxed)
                 };
                 let pool =
-                    render::OperandPool::with_buffers(vm.kernel.start, vm.kernel.end, buffers).ok_or_else(|| reject(format_args!("VM kernel VA {:#x}..{:#x} too small for the render operand pool, or render_operand_buffers={} outside 1..={}", vm.kernel.start, vm.kernel.end, buffers, render::OPERAND_BUFFERS_MAX)))?;
+                    render::OperandPool::with_buffers(vm.kernel.start, vm.kernel.end, buffers).ok_or_else(|| reject(format_args!("VM kernel VA {:#x}..{:#x} too small for the render operand pool, or render_operand_buffers={} outside {}..={}", vm.kernel.start, vm.kernel.end, buffers, render::OPERAND_BUFFERS_MIN, render::OPERAND_BUFFERS_MAX)))?;
                 // Acquire scarce support and its Arc before editing this
                 // root. ENOSPC/ENOMEM here must not quarantine a healthy VM.
                 let support = Arc::new(
diff --git a/drivers/gpu/drm/asahi/g16_render.rs b/drivers/gpu/drm/asahi/g16_render.rs
index 2cef8d4b3bf6..90eff8d3a358 100644
--- a/drivers/gpu/drm/asahi/g16_render.rs
+++ b/drivers/gpu/drm/asahi/g16_render.rs
@@ -836,6 +836,9 @@ pub(crate) fn fragment_work(&self, a: &Addresses, out: &mut [u8]) -> Option<()>
 const OPERAND_STRIDE: u64 = 0x208000;
 /// Operand (shader private-memory) buffers the VA layout has room for.
 pub(crate) const OPERAND_BUFFERS_MAX: u32 = 24;
+/// Fewest operand buffers allowed: 8 was the smallest pool seen to complete
+/// large shader scratch frames (slowly); 4 hung the GPU.
+pub(crate) const OPERAND_BUFFERS_MIN: u32 = 8;
 /// 4 KiB accelerator pages in each 2 MiB operand buffer.
 const OPERAND_PAGES: u32 = 512;
 const DIRECTORY_BACKING: usize = 0x40000;
@@ -871,7 +874,7 @@ pub(crate) fn with_buffers(start: u64, end: u64, buffers: u32) -> Option<Self> {
             buffers,
         };
         if start & 0x3fff != 0
-            || !(1..=OPERAND_BUFFERS_MAX).contains(&buffers)
+            || !(OPERAND_BUFFERS_MIN..=OPERAND_BUFFERS_MAX).contains(&buffers)
             || pool.end()? > end
         {
             return None;
diff --git a/drivers/gpu/drm/asahi/g16_timeline.rs b/drivers/gpu/drm/asahi/g16_timeline.rs
index d8815a633be2..aff49a647757 100644
--- a/drivers/gpu/drm/asahi/g16_timeline.rs
+++ b/drivers/gpu/drm/asahi/g16_timeline.rs
@@ -345,7 +345,8 @@ pub(crate) fn shared_notifier() -> bool {
 
 /// Operand buffers in the render pool of each VM whose first render comes
 /// afterwards (asahi_m4.render_operand_buffers; runtime: debugfs
-/// asahi_m4/render_operand_buffers). Submission rejects values outside 1..=24.
+/// asahi_m4/render_operand_buffers). Values outside
+/// `OPERAND_BUFFERS_MIN..=OPERAND_BUFFERS_MAX` are refused.
 pub(crate) static RENDER_OPERAND_BUFFERS: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(24);
 
 /// Buffers in the private compute pool of each VM whose first compute comes
@@ -361,32 +362,40 @@ pub(crate) fn shared_notifier() -> bool {
 pub(crate) struct FlagKnob {
     cell: &'static core::sync::atomic::AtomicU32,
     name: &'static str,
+    min: u32,
     max: u32,
 }
 
 impl FlagKnob {
     pub(crate) fn init(&self, value: u32) {
-        self.cell.store(value.min(self.max), core::sync::atomic::Ordering::Relaxed);
+        let clamped = value.clamp(self.min, self.max);
+        if clamped != value {
+            pr_warn!("G16: {}={} outside {}..={}, using {}\n", self.name, value, self.min, self.max, clamped);
+        }
+        self.cell.store(clamped, core::sync::atomic::Ordering::Relaxed);
     }
 
-    pub(crate) const PROFILE: Self = Self { cell: &PROFILE, name: "profile", max: 1 };
-    pub(crate) const SHARED_NOTIFIER: Self = Self { cell: &SHARED_NOTIFIER, name: "shared_notifier", max: 1 };
-    pub(crate) const FAIL_PREP: Self = Self { cell: &FAIL_PREP, name: "fail_prep", max: i32::MAX as u32 };
-    pub(crate) const FAIL_RETIRE: Self = Self { cell: &FAIL_RETIRE, name: "fail_retire", max: i32::MAX as u32 };
-    pub(crate) const FAIL_SKIP: Self = Self { cell: &FAIL_SKIP, name: "fail_skip", max: 4096 };
+    pub(crate) const PROFILE: Self = Self { cell: &PROFILE, name: "profile", min: 0, max: 1 };
+    pub(crate) const SHARED_NOTIFIER: Self = Self { cell: &SHARED_NOTIFIER, name: "shared_notifier", min: 0, max: 1 };
+    pub(crate) const FAIL_PREP: Self = Self { cell: &FAIL_PREP, name: "fail_prep", min: 0, max: i32::MAX as u32 };
+    pub(crate) const FAIL_RETIRE: Self = Self { cell: &FAIL_RETIRE, name: "fail_retire", min: 0, max: i32::MAX as u32 };
+    pub(crate) const FAIL_SKIP: Self = Self { cell: &FAIL_SKIP, name: "fail_skip", min: 0, max: 4096 };
     pub(crate) const RENDER_OPERAND_BUFFERS: Self = Self {
         cell: &RENDER_OPERAND_BUFFERS,
         name: "render_operand_buffers",
+        min: crate::g16_render::OPERAND_BUFFERS_MIN,
         max: crate::g16_render::OPERAND_BUFFERS_MAX,
     };
     pub(crate) const COMPUTE_POOL_BUFFERS: Self = Self {
         cell: &COMPUTE_POOL_BUFFERS,
         name: "compute_pool_buffers",
+        min: 0,
         max: crate::g16_compute::BUFFER_COUNT as u32,
     };
     pub(crate) const COMPUTE_SHARES_RENDER_POOL: Self = Self {
         cell: &COMPUTE_SHARES_RENDER_POOL,
         name: "compute_shares_render_pool",
+        min: 0,
         max: 1,
     };
 }
@@ -422,7 +431,7 @@ fn write(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
 impl kernel::debugfs::Reader for FlagKnob {
     fn read_from_slice(&self, reader: &mut kernel::uaccess::UserSliceReader) -> Result {
         let value = knob_u32(reader)?;
-        if value > self.max {
+        if value < self.min || value > self.max {
             return Err(EINVAL);
         }
         self.cell.store(value, core::sync::atomic::Ordering::Relaxed);
