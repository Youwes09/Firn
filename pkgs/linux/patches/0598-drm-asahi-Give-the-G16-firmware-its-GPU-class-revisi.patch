From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Tue, 17 Nov 2026 00:31:37 -0600
Subject: [PATCH] drm/asahi: Give the G16 firmware its GPU class, revision and
 core count

Bundle 0xfb8, 0xfbc and 0xfc0 were left zero. macOS 26.6.2 sets 0x1b, 4
and 10 on the J713, the fields Asahi's initialization data names
gpu_core, gpu_rev and num_cores. Interface notes by Syd Garlathy
<s@ll.dev>, written from macOS's drivers, give the revision codes as 1,
3 and 4 for A0, B0 and B1; take the revision from apple,chip-revision.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 drivers/gpu/drm/asahi/g16_platform.rs | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16_platform.rs b/drivers/gpu/drm/asahi/g16_platform.rs
index dea9d8065f6d..856dcff3bba1 100644
--- a/drivers/gpu/drm/asahi/g16_platform.rs
+++ b/drivers/gpu/drm/asahi/g16_platform.rs
@@ -336,6 +336,13 @@ pub(crate) fn hwdata(&self) -> Result<KVec<u8>> {
         for i in 0..self.states() {
             put32(&mut out, 0x1848 + i * 4, 1.02f32.to_bits());
         }
+        // The firmware's revision codes: A0 1, B0 3, B1 4.
+        let revision_code = match self.revision {
+            0x00 => 1,
+            0x10 => 3,
+            0x11 => 4,
+            _ => return Err(EINVAL),
+        };
         for (off, value) in [
             (0xe90, 0x8132),
             (0xe94, self.revision >> 4),
@@ -348,6 +355,9 @@ pub(crate) fn hwdata(&self) -> Result<KVec<u8>> {
             (0xee0, 1),
             (0xee4, 1),
             (0xee8, 1),
+            (0xfb8, 0x1b),
+            (0xfbc, revision_code),
+            (0xfc0, 10),
             (0xfc4, self.max_pstate()),
             (0x1cd8, self.max_pstate()),
             (0x2604, 1),
