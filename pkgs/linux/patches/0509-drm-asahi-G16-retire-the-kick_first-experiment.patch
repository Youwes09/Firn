From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Fri, 16 Oct 2026 10:10:12 -0400
Subject: [PATCH] drm/asahi: G16: retire the kick_first experiment

Remove the extra first-Work kick and its debugfs switch. The default keeps batching and stamps the actual end-of-pass doorbell for timeline level 2.

K1: no callers found in boot configs, tools, or the retained test scripts. Keep the production default exactly.
---
 drivers/gpu/drm/asahi/asahi_m4.rs     |  4 ----
 drivers/gpu/drm/asahi/g16_drm.rs      | 24 ------------------------
 drivers/gpu/drm/asahi/g16_timeline.rs |  8 --------
 3 files changed, 36 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_m4.rs b/drivers/gpu/drm/asahi/asahi_m4.rs
index 925173e0ef30..336c83cceed7 100644
--- a/drivers/gpu/drm/asahi/asahi_m4.rs
+++ b/drivers/gpu/drm/asahi/asahi_m4.rs
@@ -289,10 +289,6 @@ fn probe<'bound>(
             default: 1,
             description: "1 (default) cuts per-pass firmware reads: cached admission lane cursors (reread when they show no room), the shared render-notifier count through the retire snapshot, dep_elide's reached test from the last scan, and wedge sampling at most every 50 ms instead of every pump pass; 0 restores #167's reads. Runtime: debugfs asahi_m4/read_opt",
         },
-        kick_first: u32 {
-            default: 0,
-            description: "1 rings the doorbell after each pump pass's first admitted Work as well as at the end of the pass, so a large submission's first Work starts before the rest are written. Runtime: debugfs asahi_m4/kick_first",
-        },
         dep_elide: u32 {
             default: 6,
             description: "Bitmask: drop firmware dependency items that are redundant: 1 on the same lane's earlier Work, 2 already reached at publish, 4 already waited on by this lane's previous Work. Counters in debugfs asahi_m4/dep_stats. Runtime: debugfs asahi_m4/dep_elide",
diff --git a/drivers/gpu/drm/asahi/g16_drm.rs b/drivers/gpu/drm/asahi/g16_drm.rs
index 948a5f6bfb0a..ad89bd1e8ed6 100644
--- a/drivers/gpu/drm/asahi/g16_drm.rs
+++ b/drivers/gpu/drm/asahi/g16_drm.rs
@@ -164,7 +164,6 @@ pub(crate) struct Data {
     _early: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::FlagKnob>>>,
     _dep_elide: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::FlagKnob>>>,
     _dep_stats: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::DepStats>>>,
-    _kick_first: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::FlagKnob>>>,
     _read_opt: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::FlagKnob>>>,
     _safety_poll: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::FlagKnob>>>,
     _scratch_zero: Pin<KBox<kernel::debugfs::File<crate::g16_timeline::FlagKnob>>>,
@@ -252,14 +251,6 @@ pub(crate) fn register<'a>(
         dir.read_write_file(c_str!("dep_elide"), crate::g16_timeline::FlagKnob::DEP_ELIDE),
         GFP_KERNEL,
     )?;
-    crate::g16_timeline::KICK_FIRST.store(
-        crate::module_parameters::kick_first.value().min(1),
-        Ordering::Relaxed,
-    );
-    let kick_first = KBox::pin_init(
-        dir.read_write_file(c_str!("kick_first"), crate::g16_timeline::FlagKnob::KICK_FIRST),
-        GFP_KERNEL,
-    )?;
     crate::g16_timeline::READ_OPT.store(
         crate::module_parameters::read_opt.value().min(1),
         Ordering::Relaxed,
@@ -333,7 +324,6 @@ pub(crate) fn register<'a>(
         _early: early,
         _dep_elide: dep_elide,
         _dep_stats: dep_stats,
-        _kick_first: kick_first,
         _read_opt: read_opt,
         _safety_poll: safety_poll,
         _scratch_zero: scratch_zero,
@@ -1719,20 +1709,6 @@ fn run(this: Arc<Self>) {
                         engine.cursor = index + 1;
                         progress = true;
                         admitted += 1;
-                        if admitted == 1
-                            && crate::g16_timeline::KICK_FIRST.load(Ordering::Relaxed) != 0
-                        {
-                            // Ring the doorbell for the pass's first Work so
-                            // an idle GPU starts it while the rest of the pass
-                            // (up to 63 more Works) is still being written.
-                            runtime.flush()?;
-                            if crate::module_parameters::timeline.value() >= 2 {
-                                let job = &mut engine.jobs[index];
-                                if job.kick == 0 {
-                                    job.kick = ticks();
-                                }
-                            }
-                        }
                         if admitted == 64 {
                             break;
                         }
diff --git a/drivers/gpu/drm/asahi/g16_timeline.rs b/drivers/gpu/drm/asahi/g16_timeline.rs
index a7630605a07d..a3eafa4411cd 100644
--- a/drivers/gpu/drm/asahi/g16_timeline.rs
+++ b/drivers/gpu/drm/asahi/g16_timeline.rs
@@ -360,7 +360,6 @@ impl FlagKnob {
     pub(crate) const EARLY_SIGNAL: Self = Self { cell: &EARLY_SIGNAL, name: "early_signal", max: 2 };
     pub(crate) const PROFILE: Self = Self { cell: &PROFILE, name: "profile", max: 1 };
     pub(crate) const DEP_ELIDE: Self = Self { cell: &DEP_ELIDE, name: "dep_elide", max: 7 };
-    pub(crate) const KICK_FIRST: Self = Self { cell: &KICK_FIRST, name: "kick_first", max: 1 };
     pub(crate) const READ_OPT: Self = Self { cell: &READ_OPT, name: "read_opt", max: 1 };
     pub(crate) const SAFETY_POLL_MS: Self = Self { cell: &SAFETY_POLL_MS, name: "safety_poll_ms", max: 10000 };
     pub(crate) const SCRATCH_ZERO: Self = Self { cell: &SCRATCH_ZERO, name: "scratch_zero", max: 2 };
@@ -437,13 +436,6 @@ fn write(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
     }
 }
 
-/// Ring the doorbell right after each pump pass's first admitted Work
-/// (asahi_m4.kick_first, runtime: debugfs `asahi_m4/kick_first`), besides the
-/// end-of-pass flush. A 64-Work submission otherwise waits for the whole pass
-/// to be written before its first Work can start (kick 411 µs after first
-/// publication, p50, start_lat --chain 64 batch on #165).
-pub(crate) static KICK_FIRST: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(0);
-
 /// Fewer firmware reads per pass (asahi_m4.read_opt, runtime: debugfs
 /// `asahi_m4/read_opt`; 0 restores #167's reads):
 /// - admission reuses the last lane cursors it read and rereads them only when
