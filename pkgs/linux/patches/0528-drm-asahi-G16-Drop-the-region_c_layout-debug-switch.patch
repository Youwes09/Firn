From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Tue, 20 Oct 2026 00:24:07 -0400
Subject: [PATCH] drm/asahi: G16: Drop the region_c_layout debug switch

region_c_layout=1 overwrote region C's host tunables with the words
macOS 25G83 holds there once booted. Production never set it; the
original layout is unchanged.

Signed-off-by: Niklas Sheth <hi@niklassheth.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/asahi/asahi_m4.rs     |  4 ----
 drivers/gpu/drm/asahi/g16_platform.rs | 31 ---------------------------
 2 files changed, 35 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_m4.rs b/drivers/gpu/drm/asahi/asahi_m4.rs
index 0c59bb55d2c0..e49a11119448 100644
--- a/drivers/gpu/drm/asahi/asahi_m4.rs
+++ b/drivers/gpu/drm/asahi/asahi_m4.rs
@@ -197,10 +197,6 @@ fn probe<'bound>(
             default: 0,
             description: "Identify the GPU without starting firmware or registering DRM",
         },
-        region_c_layout: u32 {
-            default: 0,
-            description: "Debug: region C host tunables as macOS 25G83 holds them (0: original)",
-        },
         work_layout: u32 {
             default: 0,
             description: "Work fields as macOS (debug): 1=no TVB growth request or fragment flags 0xba8/0xbdc, 2=render index rings, 4=completion control 3, 8=fragment gate 0xb5 after each 40-render cycle start",
diff --git a/drivers/gpu/drm/asahi/g16_platform.rs b/drivers/gpu/drm/asahi/g16_platform.rs
index 442316c84a0a..91bcfdcd85b9 100644
--- a/drivers/gpu/drm/asahi/g16_platform.rs
+++ b/drivers/gpu/drm/asahi/g16_platform.rs
@@ -380,37 +380,6 @@ pub(crate) fn region_c(&self) -> Result<KVec<u8>> {
         for (off, value) in [(0x54, u16::MAX), (0x56, 40), (0x58, u16::MAX)] {
             out[off..off + 2].copy_from_slice(&value.to_le_bytes());
         }
-        if crate::module_parameters::region_c_layout.value() != 0 {
-            // Debug: the words macOS 26.6.2 (25G83) holds here once booted,
-            // observed under the hypervisor on this machine.
-            for (off, value, size) in [
-                (0x20, 0xbb800000000u64, 8),
-                (0x30, 0x100000001, 8),
-                (0x38, 0x7800000000, 8),
-                (0x58, 0x100000000ffff, 8),
-                (0x60, 0x3000000010000, 8),
-                (0x68, 0x10000, 8),
-                (0x80, 0x150e, 4),
-                (0x7c0, 0x4e200000000, 8),
-                (0x7c8, 0x3f4ccccd3f800000, 8),
-                (0x7d0, 0x3f6666663e4ccccd, 8),
-                (0x7d8, 0x3e8000003dcccccd, 8),
-                (0x7e0, 0x3f6666663f333333, 8),
-                (0x7e8, 0x100000006, 8),
-                (0x7f0, 0x6400000001, 8),
-                (0x7f8, 0x64, 8),
-                (0x988, 0x46749a15, 8),
-                (0x990, 0x61a80, 8),
-                (0x998, 0xa00000028, 8),
-                (0x9a0, 0x1000000fa, 8),
-                (0x9b8, 0x2800000002, 8),
-                (0x9c0, 0x5, 8),
-                (0x9c8, 0x3200000028, 8),
-                (0x9d0, 0x1, 8),
-            ] {
-                out[off..off + size].copy_from_slice(&value.to_le_bytes()[..size]);
-            }
-        }
         Ok(out)
     }
 }
