From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Tue, 27 Oct 2026 08:21:20 -0400
Subject: [PATCH] drm/asahi: G16: build the extra_0 policy object from the
 bundle

The root's extra_0 object (+0xb8) holds a compact copy of the power and
thermal controllers' parameters, and the driver left it zero. Without
PMP the firmware evidently does not use it. With PMP managing the GPU,
the firmware's fast-die thermal loop ran with zero thresholds: it
latched engaged at 37 C and held the GPU at its lowest p-state (338 MHz,
about a third of the work done), re-zeroing the thresholds every tick.
macOS fills the object before the firmware starts (mini, 25G83).

Fill it from the bundle the driver already builds from the ADT: the
average-power controller (filter length, Ki*dt, Kp, minimum duty), the
fast-die limit and release temperatures and gains, the turbo target,
filter length and gains, maximum power and the PPM gain, and the 0x81xx
controller's gains and limits, plus the controllers' enable words. On
the mini this reproduces macOS's object word for word, except the last
bit of one rounded gain.

These are thermal limits the firmware acts on: a fast-die limit outside
50-125 C, a release not below it, or a maximum power outside 1-80 W
leaves the object zero, as before, with an error. The placed limits are
logged once per boot. asahi_m4.extra0=0 restores the zero object.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 62986b3a8041e4ac7e8ba1319943a1024cf744b1)
---
 drivers/gpu/drm/asahi/asahi_m4.rs  |  4 ++
 drivers/gpu/drm/asahi/g16.rs       | 22 ++++++++++
 drivers/gpu/drm/asahi/g16_power.rs | 70 ++++++++++++++++++++++++++++++
 3 files changed, 96 insertions(+)

diff --git a/drivers/gpu/drm/asahi/asahi_m4.rs b/drivers/gpu/drm/asahi/asahi_m4.rs
index fd9a673d05e6..9f6bf66d106c 100644
--- a/drivers/gpu/drm/asahi/asahi_m4.rs
+++ b/drivers/gpu/drm/asahi/asahi_m4.rs
@@ -152,6 +152,10 @@ fn probe<'bound>(
             default: 2193,
             description: "Maximum retained 128 KiB TVB blocks per context (11 through 6579)",
         },
+        extra0: u32 {
+            default: 1,
+            description: "1 (default) fills the extra_0 policy object (power and thermal controller parameters) from the bundle; 0 leaves it zero, as before",
+        },
         probe_only: u32 {
             default: 0,
             description: "Identify the GPU without starting firmware or registering DRM",
diff --git a/drivers/gpu/drm/asahi/g16.rs b/drivers/gpu/drm/asahi/g16.rs
index 943753e69779..80083745049f 100644
--- a/drivers/gpu/drm/asahi/g16.rs
+++ b/drivers/gpu/drm/asahi/g16.rs
@@ -537,6 +537,28 @@ pub(crate) fn new(pdev: &platform::Device<Core<'_>>) -> Result<Self> {
             firmware_space.write(va + 4, &1u32.to_le_bytes())?;
         }
         firmware_space.write(pointers.region_c, &region_c)?;
+        // The extra_0 policy object carries the power and thermal limits the
+        // firmware uses when PMP manages the GPU's power.
+        if crate::module_parameters::extra0.value() != 0 {
+            match crate::g16_power::extra0(&bundle) {
+                Ok(extra0) => {
+                    firmware_space.write(pointers.extra_0, &extra0)?;
+                    let (limit, release, power) = crate::g16_power::extra0_limits(&extra0);
+                    dev_info!(
+                        dev,
+                        "G16: extra_0 policy object built from the bundle: fast-die limit {}.{:02} C release {}.{:02} C, max power {} mW\n",
+                        limit / 100,
+                        limit % 100,
+                        release / 100,
+                        release % 100,
+                        power
+                    );
+                }
+                // A wrong thermal limit is a safety bug: leave the object
+                // zero (the previous behaviour) and say so.
+                Err(e) => dev_err!(dev, "G16: extra_0 not built, bundle limits out of range: {:?}\n", e),
+            }
+        }
         // Extra policy objects, computed descriptors, PB/UMA tables and
         // scheduler counters begin zero, exactly as the current shim.
         firmware_space.alloc(
diff --git a/drivers/gpu/drm/asahi/g16_power.rs b/drivers/gpu/drm/asahi/g16_power.rs
index 672d36d5b746..61de1dee30f6 100644
--- a/drivers/gpu/drm/asahi/g16_power.rs
+++ b/drivers/gpu/drm/asahi/g16_power.rs
@@ -328,3 +328,73 @@ macro_rules! floats {
         Ok(())
     }
 }
+
+/// Size of the root's extra_0 policy object (root +0xb8).
+pub(crate) const EXTRA0_SIZE: usize = 0x680;
+
+/// The extra_0 policy object: a compact copy of the power and thermal
+/// controllers' parameters, which the firmware reads when PMP manages the
+/// GPU's power (without it, the fast-die loop runs with zero thresholds and
+/// holds the GPU at its lowest state). Every field is taken from the bundle
+/// built above, so the two always agree.
+pub(crate) fn extra0(bundle: &[u8]) -> Result<[u8; EXTRA0_SIZE]> {
+    let word = |offset: usize| -> Result<u32> {
+        let bytes = bundle.get(offset..offset + 4).ok_or(EINVAL)?;
+        Ok(u32::from_le_bytes(bytes.try_into().map_err(|_| EINVAL)?))
+    };
+    let mut out = [0u8; EXTRA0_SIZE];
+    // Average-power controller: input filter length, Ki*dt, Kp, minimum
+    // duty, enabled.
+    put32(&mut out, 0x010, word(0x7d3c)? / 4);
+    put32(&mut out, 0x014, word(0x7d58)?);
+    put32(&mut out, 0x018, word(0x7d68)?);
+    put32(&mut out, 0x01c, word(0x7d74)?);
+    put32(&mut out, 0x020, 1);
+    // Fast-die thermal controller: limit and release (0.01 C), Kp, Ki*dt.
+    put32(&mut out, 0x0c8, word(0x7644)?);
+    put32(&mut out, 0x0cc, word(0x75f0)?);
+    put32(&mut out, 0x0d8, word(0x7624)?);
+    put32(&mut out, 0x0dc, word(0x7614)?);
+    // Turbo controller: target, filter length, Kp, Ki; the 625 constant.
+    put32(&mut out, 0x0f0, word(0x7aea)?);
+    put32(&mut out, 0x0f4, word(0x7b3a)?);
+    put32(&mut out, 0x108, word(0x7aca)?);
+    put32(&mut out, 0x10c, word(0x7aba)?);
+    put32(&mut out, 0x110, word(0x5d38)?);
+    // Power-performance (PPM) controller: enabled, maximum power (mW), Kp,
+    // and the 1.2 the firmware itself places at bundle +0x5e80.
+    put32(&mut out, 0x128, 1);
+    put32(&mut out, 0x12c, word(0x5e3c)?);
+    put32(&mut out, 0x130, word(0x5e1c)?);
+    put32(&mut out, 0x134, f32!(1.2).to_bits());
+    // The 0x81xx controller: gains, filter length, top and top - 100.
+    put32(&mut out, 0x604, word(0x81d8)?);
+    put32(&mut out, 0x608, word(0x81c8)?);
+    put32(&mut out, 0x60c, 32);
+    put32(&mut out, 0x610, word(0x81e8)?);
+    put32(&mut out, 0x620, word(0x81e4)?);
+    // The fast-die limit and release are thermal limits (0.01 C) the
+    // firmware acts on: refuse anything outside a sane band rather than
+    // hand it a wrong limit. Release must sit below the limit.
+    let (limit, release) = (word(0x7644)?, word(0x75f0)?);
+    if !(5000..=12500).contains(&limit) || !(3000..limit).contains(&release) {
+        return Err(EINVAL);
+    }
+    // The PPM controller's power budget (mW): an M4 GPU's is tens of watts.
+    if !(1..=80_000).contains(&word(0x5e3c)?) {
+        return Err(EINVAL);
+    }
+    Ok(out)
+}
+
+/// The thermal and power limits an extra_0 object carries, for the boot log:
+/// fast-die limit and release (0.01 C) and maximum power (mW).
+pub(crate) fn extra0_limits(extra0: &[u8; EXTRA0_SIZE]) -> (u32, u32, u32) {
+    let word = |offset: usize| u32::from_le_bytes([
+        extra0[offset],
+        extra0[offset + 1],
+        extra0[offset + 2],
+        extra0[offset + 3],
+    ]);
+    (word(0x0c8), word(0x0cc), word(0x12c))
+}
