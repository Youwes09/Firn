-                                    let word = self
-                                        ._firmware_space
-                                        .as_ref()
-                                        .and_then(|fw| fw.read_u32(owner_va + 0x200 + 0x94).ok())
-                                        .unwrap_or(u32::MAX);
-                                    pr_info!(
-                                        "G16: job notifier {:#x} freed at {}/{} Works, +0x94={:#x}\n",
-                                        owner_va,
-                                        entry.works,
-                                        entry.promised,
-                                        word
-                                    );
-                                }
-                            }
                             free[1] = Some((owner_va, owner_root));
                             self.job_notifiers.swap_remove(p);
                         }
