-                            if entry.works < entry.promised {
-                                use core::sync::atomic::{AtomicU32, Ordering};
-                                static REPORTED: AtomicU32 = AtomicU32::new(0);
-                                if REPORTED.fetch_add(1, Ordering::Relaxed) < 16 {
-                                    // A diagnostic must never fail retirement:
