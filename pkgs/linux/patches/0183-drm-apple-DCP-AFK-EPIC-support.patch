 drivers/gpu/drm/apple/Makefile       |   2 +-
 drivers/gpu/drm/apple/afk.c          | 950 +++++++++++++++++++++++++++
 drivers/gpu/drm/apple/afk.h          | 187 ++++++
 drivers/gpu/drm/apple/dcp-internal.h |   1 +
