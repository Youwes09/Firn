From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Fri, 16 Oct 2026 10:08:51 -0400
Subject: [PATCH] drm/asahi: G16: retire the ta3d_item experiment

Keep fragment stamps starting at 0x100 and the original own-pass barrier fields. Remove the alternate stamp bases, wait values and UUID forms.

K1: no callers found in boot configs, tools, or the retained test scripts. Keep the production default exactly.
---
 drivers/gpu/drm/asahi/asahi_m4.rs    |  4 ----
 drivers/gpu/drm/asahi/g16_render.rs  | 17 ++---------------
 drivers/gpu/drm/asahi/g16_runtime.rs | 15 ++-------------
 3 files changed, 4 insertions(+), 32 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_m4.rs b/drivers/gpu/drm/asahi/asahi_m4.rs
index ef2d7d9ff4b3..ae09d9151f1b 100644
--- a/drivers/gpu/drm/asahi/asahi_m4.rs
+++ b/drivers/gpu/drm/asahi/asahi_m4.rs
@@ -181,10 +181,6 @@ fn probe<'bound>(
             default: 0,
             description: "Experiment: render lifecycle words (regs 0x1ca10/0x14a1/0xa349 tiling, 0x160e0/0x1499/0xa341 fragment) and Work uuids. 1: unique per render, as Metal: two device-wide counters, the high word +1 and the low word +2 per render (fragment even, tiling odd). 0: the original constants for every render (production)",
         },
-        ta3d_item: u32 {
-            default: 0,
-            description: "Experiment: form of each render's own TA-to-3D wait item. 0: +0x24 = the render's fragment stamp; 1: +0x24 = the awaited TA stamp (as Metal); 2: also a Metal-style per-command uuid (context id in the high byte); 3: Metal numbering, fragment stamps equal to tiling stamps (so +0x24 = own = awaited), plus the Metal-style uuid",
-        },
         render_deps: u32 {
             default: 0,
             description: "Experiment: 1 orders renders in the kernel (waits for other queues and for the previous fragment stamp a tiling stage needs, then submits with no firmware dependency items); 0 encodes firmware dependency items",
diff --git a/drivers/gpu/drm/asahi/g16_render.rs b/drivers/gpu/drm/asahi/g16_render.rs
index 664a3517123f..201e6c2be9cd 100644
--- a/drivers/gpu/drm/asahi/g16_render.rs
+++ b/drivers/gpu/drm/asahi/g16_render.rs
@@ -1177,24 +1177,11 @@ impl Addresses {
         u32_at(&mut out, 0, 4);
         u64_at(&mut out, 4, self.tiling_firmware_stamp);
         u64_at(&mut out, 0xc, self.tiling_firmware_stamp);
-        // Experiment (ta3d_item): Metal's own-pass TA-to-3D wait repeats the
-        // awaited TA value at +0x24 (only its cross-queue kind-0 waits carry a
-        // different value there) and uses a per-command uuid with the context
-        // id in the high byte.
-        let form = crate::module_parameters::ta3d_item.value();
-        // Form 3 numbers fragment stamps like tiling stamps, so the
-        // render's own stamp already equals the awaited one.
-        let self_value = if form == 1 || form == 2 { self.tiling_stamp } else { self.fragment_stamp };
-        let uuid = if form >= 2 {
-            (self.context_id << 24) | ((self.fragment_counter >> 1) & 0xff_ffff)
-        } else {
-            self.fragment_uuid
-        };
         for (off, value) in [
             (0x14, self.tiling_stamp),
             (0x20, self.tiling_event),
-            (0x24, self_value),
-            (0x28, uuid),
+            (0x24, self.fragment_stamp),
+            (0x28, self.fragment_uuid),
         ] {
             u32_at(&mut out, off, value as u32);
         }
diff --git a/drivers/gpu/drm/asahi/g16_runtime.rs b/drivers/gpu/drm/asahi/g16_runtime.rs
index 5e6ba98cde7c..a9a9c5a87a04 100644
--- a/drivers/gpu/drm/asahi/g16_runtime.rs
+++ b/drivers/gpu/drm/asahi/g16_runtime.rs
@@ -443,17 +443,6 @@ fn ring_room(tail: u32, read: u32, done: u32, entries: u32, capacity: u32) -> bo
             .all(|&cursor| (tail + capacity - cursor) % capacity + entries < capacity / 2)
 }
 
-/// First fragment-lane stamp of a render queue. Experiment ta3d_item=3
-/// numbers a render's fragment stamps like its tiling stamps, as Metal does,
-/// so its TA-to-3D wait carries the same value as its own (+0x24) and as the
-/// awaited one.
-fn fragment_stamp_base() -> u32 {
-    if crate::module_parameters::ta3d_item.value() >= 3 {
-        0xc00
-    } else {
-        0x100
-    }
-}
 
 impl Bootstrap {
     /// Report each exhausted resource once, without logging every retry or
@@ -776,7 +765,7 @@ fn init_queues(
             // target. This also permits qualification near stamp rollover.
             let (ordinal, first) = match stage {
                 0 => (owner.render_count, 0xc00),
-                1 => (owner.render_count, fragment_stamp_base()),
+                1 => (owner.render_count, 0x100),
                 _ => (owner.compute_count, 0x100),
             };
             let current = g16_stamp::previous(g16_stamp::value(ordinal, first));
@@ -2415,7 +2404,7 @@ fn submit_render_pool(
         a.tiling_counter = a.fragment_counter.wrapping_add(1);
         // Firmware's dependency graph requires consecutive stamp updates
         // within each lane, even when other queues publish between them.
-        a.fragment_stamp = u64::from(g16_stamp::value(queue_ordinal, fragment_stamp_base()));
+        a.fragment_stamp = u64::from(g16_stamp::value(queue_ordinal, 0x100));
         a.tiling_stamp = u64::from(g16_stamp::value(queue_ordinal, 0xc00));
         let (va, aliased) = self.allocate_work(true)?;
         a.tiling_shared_tail = va + 0x10000;
