From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Sat, 3 Oct 2026 22:38:53 -0400
Subject: [PATCH] rust: drm: gem: shmem: Allocate full objects for
 helper-created GEM objects

The shmem ALLOC_OPS route PRIME import (and dumb create) to the C shmem
helpers with no gem_create_object, so the helpers kzalloc a bare
drm_gem_shmem_object that the Rust side then treats as an Object<T>,
reading and freeing past the allocation. Add an optional
DriverObject::import_args(); when a driver implements it, provide a
gem_create_object callback that allocates and initializes the full
Object<T> (with T::new(.., import_args())) for the C helper to finish.
Drivers without import_args keep the current behaviour.

Ported from 7d4448f681720 ("WIP: drm/asahi: G16 work as of 2026-10-03")
onto v7.3's Object layout.

Folded in:
- fixup! rust: drm: gem: shmem: Allocate full objects for helper-created GEM objects

[fixup! rust: drm: gem: shmem: Allocate full objects for helper-created GEM objects]
Now that imports create full objects, sg_table() can be called on an
imported object. Its shmem->sgt belongs to the dma-buf attachment, mapped at
import and released by drm_prime_gem_destroy(). Wrapping it in an SGTableMap
made the object's free path unmap and kfree() it as well: a double unmap and
double free in the dma-buf attachment. Return the attachment's table directly.

Signed-off-by: Niklas Sheth <hi@niklassheth.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RvQieG9SGoR3ZeSdSguHnB
---
 rust/kernel/drm/gem/mod.rs   |  6 +++++
 rust/kernel/drm/gem/shmem.rs | 52 +++++++++++++++++++++++++++++++++++-
 2 files changed, 57 insertions(+), 1 deletion(-)

diff --git a/rust/kernel/drm/gem/mod.rs b/rust/kernel/drm/gem/mod.rs
index a043bb40447c..c03c936794d6 100644
--- a/rust/kernel/drm/gem/mod.rs
+++ b/rust/kernel/drm/gem/mod.rs
@@ -118,6 +118,12 @@ fn export(
     ) -> Result<DmaBuf<<Self::Driver as drm::Driver>::Object>> {
         unimplemented!()
     }
+
+    /// Arguments for the driver data of objects that the C GEM helpers allocate, such as imported
+    /// DMA-BUFs. Implement this to have those objects allocated with a full driver payload.
+    fn import_args() -> Self::Args {
+        unimplemented!()
+    }
 }
 
 /// Trait that represents a GEM object subtype
diff --git a/rust/kernel/drm/gem/shmem.rs b/rust/kernel/drm/gem/shmem.rs
index 485846eb26d6..21e1bda0adda 100644
--- a/rust/kernel/drm/gem/shmem.rs
+++ b/rust/kernel/drm/gem/shmem.rs
@@ -272,6 +272,16 @@ pub fn sg_table<'a>(
             return Err(EINVAL);
         }
 
+        // An imported object's table belongs to its dma-buf attachment: it is mapped for this
+        // device at import and released by `drm_prime_gem_destroy()`. Wrapping it in an
+        // `SGTableMap` would unmap and free it a second time when the object is freed.
+        // SAFETY: `self.as_raw()` is valid for the lifetime of `self`.
+        if !unsafe { (*self.as_raw()).import_attach }.is_null() {
+            // SAFETY: For an imported object `sgt` is set at import and stays valid until the
+            // object is released, which outlives the borrow of `self`.
+            return Ok(unsafe { scatterlist::SGTable::from_raw((*self.as_raw_shmem()).sgt) });
+        }
+
         let sgt_res = 'out: {
             // Fast path: sgt_res is already initialized
             if let Some(sgt_res) = self.sgt_res.as_ref() {
@@ -298,6 +308,40 @@ pub fn sg_table<'a>(
         Ok(sgt_res.access(dev)?)
     }
 
+    /// `gem_create_object` callback: allocates the full Rust object for objects that the C shmem
+    /// helpers create and then initialize themselves, such as imported DMA-BUFs.
+    extern "C" fn create_object_callback(
+        raw_dev: *mut bindings::drm_device,
+        size: usize,
+    ) -> *mut bindings::drm_gem_object {
+        // SAFETY: DRM passes a valid device of this driver.
+        let dev = unsafe { Device::<T::Driver>::from_raw(raw_dev) };
+        let new: Result<Pin<KBox<Self>>> = KBox::try_pin_init(
+            try_pin_init!(Self {
+                obj <- Opaque::init_zeroed(),
+                parent_resv_obj: None,
+                sgt_res: ManuallyDrop::new(SetOnce::new()),
+                sgt_lock <- new_mutex!(()),
+                inner <- T::new(dev, size, T::import_args()),
+            }),
+            GFP_KERNEL,
+        );
+        let new = match new {
+            Ok(new) => new,
+            Err(e) => return e.to_ptr(),
+        };
+
+        // SAFETY: `obj.as_raw()` is guaranteed to be valid by the initialization above.
+        unsafe { (*new.as_raw()).funcs = &Self::VTABLE };
+
+        // SAFETY: We never move out of `self`; `free_callback` recovers the box once the C helper
+        // has initialized and later released the object.
+        let new = KBox::into_raw(unsafe { Pin::into_inner_unchecked(new) });
+
+        // SAFETY: `new` is valid, and the shmem object embeds its GEM object.
+        unsafe { &raw mut (*(*new).obj.get()).base }
+    }
+
     /// Create a new shmem-backed DRM object of the given size.
     ///
     /// Additional config options can be specified using `config`.
@@ -391,7 +435,13 @@ impl<T: DriverObject> driver::AllocImpl for Object<T> {
     type Driver = T::Driver;
 
     const ALLOC_OPS: driver::AllocOps = driver::AllocOps {
-        gem_create_object: None,
+        // Without a driver payload for helper-created objects, the C helpers would allocate a bare
+        // `drm_gem_shmem_object` that the Rust side treats as an `Object<T>`.
+        gem_create_object: if T::HAS_IMPORT_ARGS {
+            Some(Self::create_object_callback)
+        } else {
+            None
+        },
         prime_handle_to_fd: None,
         prime_fd_to_handle: None,
         gem_prime_import: None,
