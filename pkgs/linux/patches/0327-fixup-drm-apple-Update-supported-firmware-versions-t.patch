From 01af9a8c322226147a4f0619b5d931c67461a8ab Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Sun, 23 Aug 2026 22:56:48 +0200
Subject: [PATCH] fixup! drm: apple: Update supported firmware versions to 12.3
 and 13.5

---
 drivers/gpu/drm/apple/iomfb.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/apple/iomfb.c b/drivers/gpu/drm/apple/iomfb.c
index 6cfc8d93f0a5..9e22e82bcbd8 100644
--- a/drivers/gpu/drm/apple/iomfb.c
+++ b/drivers/gpu/drm/apple/iomfb.c
@@ -483,7 +483,7 @@ void dcp_flush(struct drm_crtc *crtc, struct drm_atomic_commit *commit)
 		iomfb_flush_v12_3(dcp, crtc, commit);
 		break;
 	case DCP_FIRMWARE_V_13_5:
-		iomfb_flush_v13_3(dcp, crtc, state);
+		iomfb_flush_v13_3(dcp, crtc, commit);
 		break;
 	default:
 		WARN_ONCE(true, "Unexpected firmware version: %u\n", dcp->fw_compat);
