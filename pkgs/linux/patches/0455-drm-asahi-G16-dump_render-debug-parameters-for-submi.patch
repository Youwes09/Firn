diff --git a/drivers/gpu/drm/asahi/g16_drm.rs b/drivers/gpu/drm/asahi/g16_drm.rs
index 602300c47470..772eb303cd85 100644
--- a/drivers/gpu/drm/asahi/g16_drm.rs
+++ b/drivers/gpu/drm/asahi/g16_drm.rs
@@ -858,6 +858,7 @@ fn gem_mmap_offset(
 
 impl Vm {
     fn detach(&self, runtime: &mut crate::g16::Bootstrap) -> Result {
+        runtime.flush_render_ring(self.space.lock().roots().low);
         runtime.release_render_vm(self.space.lock().roots())?;
