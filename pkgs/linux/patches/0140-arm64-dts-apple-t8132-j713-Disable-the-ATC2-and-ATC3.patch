From feb36ed6085c5f6d92522e132cae20fdf85beac5 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Sat, 31 Oct 2026 00:21:27 -0500
Subject: [PATCH] arm64: dts: apple: t8132-j713: Disable the ATC2 and ATC3
 power domains

The J713 has two USB-C ports, on ATC0 and ATC1; its ADT has no ATC2 or
ATC3 PHY or controller. Their power states refuse to turn on, so every
child domain defers probing forever trying to power its parent.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 arch/arm64/boot/dts/apple/t8132-j713.dts | 60 ++++++++++++++++++++++++
 1 file changed, 60 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713.dts b/arch/arm64/boot/dts/apple/t8132-j713.dts
index cbccf6f3cbbc..158a9f516999 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j713.dts
@@ -169,6 +169,66 @@ &pmp_report_soc_ni5 {
 	apple,always-on;
 };
 
+/*
+ * Only ATC0 and ATC1 are wired up. ATC2 and ATC3 never leave their off
+ * state, so powering them on fails and defers their users forever.
+ */
+&ps_atc2_common {
+	status = "disabled";
+};
+
+&ps_atc2_pcie {
+	status = "disabled";
+};
+
+&ps_atc2_cio {
+	status = "disabled";
+};
+
+&ps_atc2_cio_pcie {
+	status = "disabled";
+};
+
+&ps_atc2_cio_usb {
+	status = "disabled";
+};
+
+&ps_atc2_usb_aon {
+	status = "disabled";
+};
+
+&ps_atc2_usb {
+	status = "disabled";
+};
+
+&ps_atc3_common {
+	status = "disabled";
+};
+
+&ps_atc3_pcie {
+	status = "disabled";
+};
+
+&ps_atc3_cio {
+	status = "disabled";
+};
+
+&ps_atc3_cio_pcie {
+	status = "disabled";
+};
+
+&ps_atc3_cio_usb {
+	status = "disabled";
+};
+
+&ps_atc3_usb_aon {
+	status = "disabled";
+};
+
+&ps_atc3_usb {
+	status = "disabled";
+};
+
 #include "hwmon-laptop.dtsi"
 
 &smc_hwmon {
