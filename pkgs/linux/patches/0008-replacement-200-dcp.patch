+	if (IS_ERR(dcp->dpavctrlep)) {
+		ret = PTR_ERR(dcp->dpavctrlep);
+		dcp->dpavctrlep = NULL;
+		return ret;
+	}
+
+	ret = afk_start(dcp->dpavctrlep);
+	if (ret)
+		return ret;
+
+	timeout = wait_for_completion_timeout(&dcp->dpavctrl_ready,
+					      msecs_to_jiffies(1000));
