+static int apple_drm_gem_remove_direct_map(struct drm_gem_dma_object *dma_obj)
+{
+	struct apple_drm_gem_object *obj =
+		container_of(dma_obj, struct apple_drm_gem_object, dma);
+	struct scatterlist *sg;
+	unsigned int i;
+	int ret = 0;
