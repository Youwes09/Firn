+		spin_unlock_irqrestore(&ep->lock, flags);
+		ret = -ESHUTDOWN;
+		goto out;
+	}
+	list_add_tail(&pending.node, &ep->compact_cmds);
+	spin_unlock_irqrestore(&ep->lock, flags);
