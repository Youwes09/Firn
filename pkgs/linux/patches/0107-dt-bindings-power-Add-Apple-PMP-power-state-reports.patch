From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Fri, 30 Oct 2026 20:44:35 -0500
Subject: [PATCH] dt-bindings: power: Add Apple PMP power-state reports

The application processor tells PMP which SoC blocks are in use by
voting in a shared register region. Each vote is a power domain. T8132
adds an event-config region.

Based on Cody Ho's binding in Gravity Linux bf3e5368a49f.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 .../bindings/power/apple,pmp-report.yaml      | 129 ++++++++++++++++++
 1 file changed, 129 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/apple,pmp-report.yaml

diff --git a/Documentation/devicetree/bindings/power/apple,pmp-report.yaml b/Documentation/devicetree/bindings/power/apple,pmp-report.yaml
new file mode 100644
index 000000000000..83303bc91167
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/apple,pmp-report.yaml
@@ -0,0 +1,129 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/apple,pmp-report.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple Power Management Processor power-state reports
+
+maintainers:
+  - Sven Peter <sven@kernel.org>
+
+description: |
+  The application processor tells the Power Management Processor (PMP)
+  which SoC blocks are in use by voting in a shared register region. Each
+  child is one report, exposed as a power domain; the vote is set while
+  the domain is on.
+
+properties:
+  compatible:
+    enum:
+      - apple,t6000-pmp-v2-report
+      - apple,t6020-pmp-v2-report
+      - apple,t8112-pmp-v2-report
+      - apple,t8132-pmp-v2-report
+
+  reg:
+    minItems: 1
+    maxItems: 2
+
+  reg-names:
+    items:
+      - const: report
+      - const: event-config
+
+  power-domains:
+    maxItems: 1
+
+  "#address-cells":
+    const: 1
+
+  "#size-cells":
+    const: 0
+
+patternProperties:
+  "^report@[0-9a-f]+$":
+    type: object
+    $ref: power-domain.yaml#
+    unevaluatedProperties: false
+
+    properties:
+      compatible:
+        oneOf:
+          - const: apple,t6000-pmp-v2-report-entry
+          - items:
+              - const: apple,t8132-pmp-v2-report-entry
+              - const: apple,t6000-pmp-v2-report-entry
+
+      reg:
+        maxItems: 1
+        description: Report number
+
+      "#power-domain-cells":
+        const: 0
+
+      power-domains:
+        maxItems: 1
+
+      label: true
+
+      apple,always-on:
+        type: boolean
+        description: Keep the vote set for as long as the system runs.
+
+    required:
+      - compatible
+      - reg
+      - "#power-domain-cells"
+      - label
+
+required:
+  - compatible
+  - reg
+  - "#address-cells"
+  - "#size-cells"
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8132-pmp-v2-report
+    then:
+      properties:
+        reg:
+          minItems: 2
+      required:
+        - reg-names
+    else:
+      properties:
+        reg:
+          maxItems: 1
+        reg-names: false
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        pmp-report@3803c0000 {
+            compatible = "apple,t8132-pmp-v2-report";
+            reg = <0x3 0x803c0000 0x0 0x20000>,
+                  <0x3 0x828ac000 0x0 0x2c>;
+            reg-names = "report", "event-config";
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            report@4 {
+                compatible = "apple,t8132-pmp-v2-report-entry",
+                             "apple,t6000-pmp-v2-report-entry";
+                reg = <0x4>;
+                #power-domain-cells = <0>;
+                label = "pmp-agx";
+                apple,always-on;
+            };
+        };
+    };
