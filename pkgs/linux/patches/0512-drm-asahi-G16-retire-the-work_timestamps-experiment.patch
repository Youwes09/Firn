From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Fri, 16 Oct 2026 10:10:56 -0400
Subject: [PATCH] drm/asahi: G16: retire the work_timestamps experiment

Keep internal profiling timestamps disabled apart from the queue-shared fragment-end destination. Explicit user timestamp destinations and completion handling are unchanged.

K1: no callers found in boot configs, tools, or the retained test scripts. Keep the production default exactly.
---
 drivers/gpu/drm/asahi/asahi_m4.rs    |  4 ----
 drivers/gpu/drm/asahi/g16_runtime.rs | 19 +++++--------------
 2 files changed, 5 insertions(+), 18 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_m4.rs b/drivers/gpu/drm/asahi/asahi_m4.rs
index 7bc8f6cc1a1a..3bf821806799 100644
--- a/drivers/gpu/drm/asahi/asahi_m4.rs
+++ b/drivers/gpu/drm/asahi/asahi_m4.rs
@@ -205,10 +205,6 @@ fn probe<'bound>(
             default: 0,
             description: "Identify the GPU without starting firmware or registering DRM",
         },
-        work_timestamps: u32 {
-            default: 0,
-            description: "Per-Work firmware profiling timestamp slots (0: shared end stamp only, as macOS)",
-        },
         region_c_layout: u32 {
             default: 0,
             description: "Debug: region C host tunables as macOS 25G83 holds them (0: original)",
diff --git a/drivers/gpu/drm/asahi/g16_runtime.rs b/drivers/gpu/drm/asahi/g16_runtime.rs
index 9599e4c7b28e..9f752ccb601f 100644
--- a/drivers/gpu/drm/asahi/g16_runtime.rs
+++ b/drivers/gpu/drm/asahi/g16_runtime.rs
@@ -2426,20 +2426,11 @@ fn submit_render_pool(
         frag.extend_with(0xcc0, 0u8, GFP_KERNEL)?;
         params.tiling_work(&a, &mut ta).ok_or(EINVAL)?;
         params.fragment_work(&a, &mut frag).ok_or(EINVAL)?;
-        // Keep firmware's internal profiling destinations distinct from the
-        // explicit user timestamp slots used for UAPI completion above.
-        if crate::module_parameters::work_timestamps.value() != 0 {
-            ta[0x8c8..0x8d0].copy_from_slice(&(va + 0x100).to_le_bytes());
-            ta[0x8d0..0x8d8].copy_from_slice(&(va + 0x108).to_le_bytes());
-            frag[0xc10..0xc18].copy_from_slice(&(va + 0x110).to_le_bytes());
-            frag[0xc18..0xc20].copy_from_slice(&(va + 0x118).to_le_bytes());
-        } else {
-            // As macOS: no per-Work start or tiling-end profiling stamps; the
-            // fragment end stamp goes to one location shared by the queue.
-            ta[0x8c8..0x8d8].fill(0);
-            frag[0xc10..0xc18].fill(0);
-            frag[0xc18..0xc20].copy_from_slice(&(lanes[1].pointers + 0x2080).to_le_bytes());
-        }
+        // No per-Work start or tiling-end profiling stamps; fragment end
+        // uses one location shared by the queue, separate from UAPI timestamps.
+        ta[0x8c8..0x8d8].fill(0);
+        frag[0xc10..0xc18].fill(0);
+        frag[0xc18..0xc20].copy_from_slice(&(lanes[1].pointers + 0x2080).to_le_bytes());
         if crate::module_parameters::fw_trace.value() & 128 != 0
             && !CONFIG_DUMPED.swap(true, Ordering::Relaxed)
         {
