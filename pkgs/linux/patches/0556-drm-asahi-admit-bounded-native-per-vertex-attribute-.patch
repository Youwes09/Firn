diff --git a/drivers/gpu/drm/asahi/g16_mesh.rs b/drivers/gpu/drm/asahi/g16_mesh.rs
index a60a3c6aabca..c30dfb9749c1 100644
--- a/drivers/gpu/drm/asahi/g16_mesh.rs
+++ b/drivers/gpu/drm/asahi/g16_mesh.rs
@@ -33,9 +33,9 @@ pub(crate) enum DecodeError {
     Unsupported,
 }
 
-/// Recognize only the currently qualified resource class: 16 mesh threads,
-/// position-only output, at most four vertices and one primitive, one direct
-/// object invocation. Broader output/resource classes need measured sizing.
+/// Admit the paired T16 class: four vertices' storage, one primitive and one
+/// direct object invocation, with position and up to 124 per-vertex scalars.
+/// Primitive outputs, task payload and wider resource classes remain excluded.
 /// The packet budget bounds malformed streams, including a missing terminator.
 pub(crate) fn decode(
     start: u64,
@@ -66,7 +66,17 @@ pub(crate) fn decode(
     for word in &mut state {
         *word = next()?;
     }
-    if state[0] != 0x504
+    // The low byte counts scalar vertex planes, including XYZW. The next byte
+    // includes the cull/header row as well. For the four-vertex storage class,
+    // each plane occupies 16 bytes, and word 13 repeats that row count. Require
+    // their relationship, rather than enumerating individual shader layouts.
+    // The paired Mesa limit is 128 components (2080 local bytes including the
+    // 32-byte count/index header). The uploaded launch rounds this allocation
+    // up to a power of two. This packet parser does not validate shader code or
+    // its local-allocation instructions.
+    let components = state[0] & 0xff;
+    if !(4..=128).contains(&components)
+        || state[0] != components | ((components + 1) << 8)
         || state[1] != 0x10
         || state[2] != 0
         || state[3] != 0
@@ -74,7 +84,7 @@ pub(crate) fn decode(
         || state[9] != 0
         || state[10] != 0x400810
         || state[11] != 0
-        || state[12] != 5
+        || state[12] != components + 1
     {
         return Err(DecodeError::Unsupported);
     }
diff --git a/tools/testing/selftests/drivers/gpu/asahi/native-mesh.rs b/tools/testing/selftests/drivers/gpu/asahi/native-mesh.rs
index 6fffa6d6b836..5b99fc3395d7 100644
--- a/tools/testing/selftests/drivers/gpu/asahi/native-mesh.rs
+++ b/tools/testing/selftests/drivers/gpu/asahi/native-mesh.rs
@@ -51,6 +51,59 @@ fn ordinary_data_is_not_searched_for_mesh_magic() {
     );
 }
 
+#[test]
+fn vertex_attributes_accept_the_bounded_scalar_and_row_relationship() {
+    for components in 4..=128 {
+        let mut words = stream();
+        words[1] = components | ((components + 1) << 8);
+        words[13] = components + 1;
+        assert_eq!(
+            decode(&words, 0x1004003ffc),
+            Ok(Some(Profile { payload: 0 }))
+        );
+        // Cover all supported counts, including those between device fixtures.
+        for wrong_rows in [0, components, components + 2, u32::MAX] {
+            words[13] = wrong_rows;
+            assert_eq!(decode(&words, 0x1004003ffc), Err(DecodeError::Unsupported));
+        }
+        words[13] = components + 1;
+        for bit in 8..32 {
+            words[1] ^= 1 << bit;
+            assert_eq!(decode(&words, 0x1004003ffc), Err(DecodeError::Unsupported));
+            words[1] ^= 1 << bit;
+        }
+    }
+}
+
+#[test]
+fn attributes_do_not_admit_other_output_or_execution_classes() {
+    for components in (0..4).chain(129..=255) {
+        let mut words = stream();
+        words[1] = components | ((components + 1) << 8);
+        words[13] = components + 1;
+        assert_eq!(decode(&words, 0x1004000000), Err(DecodeError::Unsupported));
+    }
+    for components in [7, 12, 128] {
+        for (index, value) in [
+            (2, 0xd0), // primitive output mode
+            (3, 1),
+            (4, 1), // unqualified state/payload
+            (9, 0), // missing object stage
+            (10, 1),
+            (10, 1 << 30),  // more primitives, culling
+            (11, 0x400820), // wider mesh workgroup
+            (12, 1),        // primitive output components
+            (18, 2),        // more than one direct object invocation
+        ] {
+            let mut words = stream();
+            words[1] = components | ((components + 1) << 8);
+            words[13] = components + 1;
+            words[index] = value;
+            assert_eq!(decode(&words, 0x1004000000), Err(DecodeError::Unsupported));
+        }
+    }
+}
+
