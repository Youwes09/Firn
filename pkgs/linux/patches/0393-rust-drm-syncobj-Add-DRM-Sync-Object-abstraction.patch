 rust/helpers/dma_fence.c        |  11 +++
 rust/helpers/drm_syncobj.c      |  22 +++++
 rust/helpers/helpers.c          |   1 +
 rust/kernel/drm/mod.rs          |   1 +
 rust/kernel/drm/syncobj.rs      | 141 ++++++++++++++++++++++++++++++++
 6 files changed, 178 insertions(+)
