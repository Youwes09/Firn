         }
     }
@@ -212,8 +217,8 @@ fn event(&self, stage: u32) -> Result<u32> {
 /// cursors are shared by every flight on the lane).
 /// A fixed table on the stack: no allocation per scan. Words beyond its
 /// capacity are read directly.
-#[derive(Default)]
-struct WordSnapshot {
+#[derive(Default, Clone)]
+pub(crate) struct WordSnapshot {
     words: [(u64, u32); 32],
     len: usize,
 }
@@ -230,6 +235,11 @@ fn read(&mut self, fw: &g16_vm::FirmwareSpace, address: u64) -> Result<u32> {
         }
         Ok(value)
     }
+
+    /// A value seen by this snapshot, without reading.
+    fn peek(&self, address: u64) -> Option<u32> {
+        self.words[..self.len].iter().find(|(a, _)| *a == address).map(|&(_, v)| v)
+    }
 }
 
 #[derive(Clone, Copy)]
@@ -684,6 +694,9 @@ fn prepare_queues(&mut self, owner: &mut FirmwareQueues) -> Result {
                 retired: self.retired_queues.clone(),
             });
             owner.lanes = Some(lanes);
+            for c in &owner.cursors {
+                c.set((u32::MAX, u32::MAX));
+            }
             owner.notified_works = 0;
             if crate::module_parameters::fw_trace.value() & 1 != 0 {
                 dev_info!(
@@ -835,8 +848,18 @@ fn reserve_flight(
             if let Some(lanes) = &queue.lanes {
                 let lane = lanes[stage];
                 let fw = self._firmware_space.as_ref().ok_or(EIO)?;
-                let read = fw.read_u32(lane.pointers)?;
-                let done = fw.read_u32(lane.pointers + 0x30)?;
+                let before = crate::g16_timeline::reads();
+                let (mut read, mut done) = queue.cursors[stage].get();
+                if !crate::g16_timeline::read_opt()
+                    || read >= 0x500
+                    || done >= 0x500
+                    || !ring_room(lane.head, read, done, entries[stage], 0x500)
+                {
+                    read = fw.read_u32(lane.pointers)?;
+                    done = fw.read_u32(lane.pointers + 0x30)?;
+                    queue.cursors[stage].set((read, done));
+                }
+                crate::g16_timeline::attribute(&crate::g16_timeline::P_RD_ADMIT, before);
                 if read >= 0x500 || done >= 0x500 || lane.head >= 0x500 {
                     return Err(EIO);
                 }
@@ -1369,7 +1392,11 @@ pub(crate) fn retire(&mut self) -> Result<Option<(u64, Result)>> {
         if let Some((id, limited)) = self.retired.pop() {
             return Ok(Some((id, if limited { Err(ENOMEM) } else { Ok(()) })));
         }
-        self.service_flights().inspect_err(|error| {
+        let before = crate::g16_timeline::reads();
+        let serviced = self.service_flights();
+        crate::g16_timeline::attribute(&crate::g16_timeline::P_RD_EVENTS, before);
+        let scan_before = crate::g16_timeline::reads();
+        serviced.inspect_err(|error| {
             dev_err!(
                 self.dev.as_ref(),
                 "G16: firmware event service failed: {:?}\n",
@@ -1422,7 +1449,12 @@ pub(crate) fn retire(&mut self) -> Result<Option<(u64, Result)>> {
                 let notified = match flight.notifier_count {
                     // The shared notifier has counted this render's Works.
                     Some((completed, total)) => {
-                        (fw.read_u32(completed)?.wrapping_sub(total) as i32) >= 0
+                        let count = if crate::g16_timeline::read_opt() {
+                            snapshot.read(fw, completed)?
+                        } else {
+                            fw.read_u32(completed)?
+                        };
+                        (count.wrapping_sub(total) as i32) >= 0
                     }
                     None => {
                         let notifier = flight.id
@@ -1554,6 +1586,8 @@ pub(crate) fn retire(&mut self) -> Result<Option<(u64, Result)>> {
             self.free_work[usize::from(render_work)].push(id, GFP_KERNEL)?;
             self.retired.push_within_capacity((id, limited)).map_err(|_| ENOMEM)?;
         }
+        crate::g16_timeline::attribute(&crate::g16_timeline::P_RD_SCAN, scan_before);
+        *self.last_scan = snapshot;
         if !self.retired.is_empty() {
             // Queued commands can legitimately wait longer than one Work's
             // timeout. Watch for a lack of retirement progress, rather than
@@ -1565,7 +1599,18 @@ pub(crate) fn retire(&mut self) -> Result<Option<(u64, Result)>> {
             let (id, limited) = self.retired.pop().ok_or(EIO)?;
             return Ok(Some((id, if limited { Err(ENOMEM) } else { Ok(()) })));
         }
-        self.check_wedge()?;
+        // Wedge detection needs a few samples per wedge_ms window (default
+        // 2 s), not one per pump pass: each sample reads two stamps per
+        // outstanding render and 36 channel registers.
+        let sample = !crate::g16_timeline::read_opt()
+            || self.wedge_sampled.is_none_or(|t| t.elapsed().as_millis() >= 50);
+        if sample {
+            self.wedge_sampled = Some(Instant::now());
+            let before = crate::g16_timeline::reads();
+            let checked = self.check_wedge();
+            crate::g16_timeline::attribute(&crate::g16_timeline::P_RD_WEDGE, before);
+            checked?;
+        }
         if let Some(flight) = self
             .flights
             .iter()
@@ -1939,8 +1984,16 @@ fn elide_item(&self, queue: &FirmwareQueues, lane: usize, dep: &Stamp, same_lane
             t::DEP_REPEAT.fetch_add(1, Ordering::Relaxed);
             mode & 4 != 0
         } else if mode & 2 != 0 {
-            let fw = self._firmware_space.as_ref().ok_or(EIO)?;
-            let reached = g16_stamp::reached(fw.read_u32(dep.address)?, dep.value);
+            let before = t::reads();
+            let now = if t::read_opt() {
+                // The last retire scan's value: stamps only advance, so a
+                // value that already reached the target still does.
+                self.last_scan.peek(dep.address)
+            } else {
+                Some(self._firmware_space.as_ref().ok_or(EIO)?.read_u32(dep.address)?)
+            };
+            t::attribute(&t::P_RD_ELIDE, before);
+            let reached = now.is_some_and(|v| g16_stamp::reached(v, dep.value));
             if reached {
                 t::DEP_REACHED.fetch_add(1, Ordering::Relaxed);
             }
diff --git a/drivers/gpu/drm/asahi/g16_timeline.rs b/drivers/gpu/drm/asahi/g16_timeline.rs
index 07783b4575e6..c8fa8970d47a 100644
--- a/drivers/gpu/drm/asahi/g16_timeline.rs
+++ b/drivers/gpu/drm/asahi/g16_timeline.rs
@@ -147,8 +147,14 @@ const fn new(name: &'static str) -> Self {
 pub(crate) static P_WRITE_LOW: Section = Section::new("vm write_low");
 pub(crate) static P_FLUSH: Section = Section::new("flush (doorbell)");
 pub(crate) static P_PUMP: Section = Section::new("pump pass");
-
-static SECTIONS: [&Section; 11] = [
+/// Read attribution (calls only): firmware reads made inside each site.
+pub(crate) static P_RD_EVENTS: Section = Section::new("reads: event ring");
+pub(crate) static P_RD_SCAN: Section = Section::new("reads: retire scan");
+pub(crate) static P_RD_ADMIT: Section = Section::new("reads: admission cursors");
+pub(crate) static P_RD_ELIDE: Section = Section::new("reads: dep_elide reached");
+pub(crate) static P_RD_WEDGE: Section = Section::new("reads: wedge check");
+
+static SECTIONS: [&Section; 16] = [
     &P_SUBMIT_RENDER,
     &P_SUBMIT_COMPUTE,
     &P_PREPARE_RENDER,
@@ -160,8 +166,27 @@ const fn new(name: &'static str) -> Self {
     &P_WRITE_LOW,
     &P_FLUSH,
     &P_PUMP,
+    &P_RD_EVENTS,
+    &P_RD_SCAN,
+    &P_RD_ADMIT,
+    &P_RD_ELIDE,
+    &P_RD_WEDGE,
 ];
 
+/// Firmware reads so far (counted only while profiling).
+#[inline(always)]
+pub(crate) fn reads() -> u64 {
+    P_READ.calls.load(core::sync::atomic::Ordering::Relaxed)
+}
+
+/// Attribute the firmware reads since `before` to `site` (profiling only).
+#[inline(always)]
+pub(crate) fn attribute(site: &Section, before: u64) {
+    if PROFILE.load(core::sync::atomic::Ordering::Relaxed) != 0 {
+        site.calls.fetch_add(reads().wrapping_sub(before), core::sync::atomic::Ordering::Relaxed);
+    }
+}
+
 /// Section timing switch (asahi_m4.profile, runtime: debugfs
 /// `asahi_m4/profile`). Off by default: each timed section costs two
 /// serialized counter reads, which a pump-bound load pays per firmware read.
@@ -333,6 +358,7 @@ impl FlagKnob {
     pub(crate) const PROFILE: Self = Self { cell: &PROFILE, name: "profile", max: 1 };
     pub(crate) const DEP_ELIDE: Self = Self { cell: &DEP_ELIDE, name: "dep_elide", max: 7 };
     pub(crate) const KICK_FIRST: Self = Self { cell: &KICK_FIRST, name: "kick_first", max: 1 };
+    pub(crate) const READ_OPT: Self = Self { cell: &READ_OPT, name: "read_opt", max: 1 };
 }
 
 impl kernel::debugfs::Writer for FlagKnob {
@@ -404,3 +430,18 @@ fn write(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
 /// to be written before its first Work can start (kick 411 µs after first
 /// publication, p50, start_lat --chain 64 batch on #165).
 pub(crate) static KICK_FIRST: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(0);
+
+/// Fewer firmware reads per pass (asahi_m4.read_opt, runtime: debugfs
+/// `asahi_m4/read_opt`; 0 restores #167's reads):
+/// - admission reuses the last lane cursors it read and rereads them only when
+///   they show no room (cursors only advance, so a stale view is conservative);
+/// - retirement reads the shared render-notifier count through the scan
+///   snapshot;
+/// - dep_elide's already-reached test uses the last retire scan's values and
+///   keeps the item when the stamp wasn't seen there, with no read.
+pub(crate) static READ_OPT: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(1);
+
+#[inline(always)]
+pub(crate) fn read_opt() -> bool {
+    READ_OPT.load(core::sync::atomic::Ordering::Relaxed) != 0
+}
