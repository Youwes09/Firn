From e3edd1950dd03605f4bdb225d57af973554b287b Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Mon, 26 Oct 2026 12:34:24 -0500
Subject: [PATCH] dt-bindings: nvmem: apple,spmi-nvmem: Add Abbey PMU

The t8132 (M4) MacBook Air has an Abbey PMU on SPMI, with the same NVMEM
interface as Maverick, Sera and Stowe.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 Documentation/devicetree/bindings/nvmem/apple,spmi-nvmem.yaml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Documentation/devicetree/bindings/nvmem/apple,spmi-nvmem.yaml b/Documentation/devicetree/bindings/nvmem/apple,spmi-nvmem.yaml
index 4ca75ed07a54..5142b50fc6e0 100644
--- a/Documentation/devicetree/bindings/nvmem/apple,spmi-nvmem.yaml
+++ b/Documentation/devicetree/bindings/nvmem/apple,spmi-nvmem.yaml
@@ -18,6 +18,7 @@ properties:
   compatible:
     items:
       - enum:
+          - apple,abbey-pmic
           - apple,maverick-pmic
           - apple,sera-pmic
           - apple,stowe-pmic
