From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yureka Lilian <yureka@cyberchaos.dev>
Date: Sat, 25 Jul 2026 23:15:24 +0200
Subject: [PATCH] arm64: dts: apple: t8132: Add NVMe nodes

Add the NVMe controller with the mailbox and SART of its ANS
coprocessor.

Signed-off-by: Yureka Lilian <yureka@cyberchaos.dev>
[Youwes09: from Gravity Linux 79b86cbb44734; commit message, node order, style]
Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 34 ++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index ef56c62fe23e..67168293fec9 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -489,6 +489,26 @@ serial0: serial@3ad200000 {
 			status = "disabled";
 		};
 
+		ans_mbox: mbox@481608000 {
+			compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x4 0x81608000 0x0 0x4000>;
+			#mbox-cells = <0>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1003 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1004 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1005 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1006 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+					  "recv-empty", "recv-not-empty";
+			power-domains = <&ps_ans>;
+		};
+
+		sart: sart@485c50000 {
+			compatible = "apple,t8132-sart", "apple,t6000-sart";
+			reg = <0x4 0x85c50000 0x0 0x10000>;
+			power-domains = <&ps_ans>;
+		};
+
 		pcie0_dart: iommu@490000000 {
 			compatible = "apple,t8132-dart", "apple,t8110-dart";
 			reg = <0x4 0x90000000 0x0 0x4000>;
@@ -520,6 +540,20 @@ pcie2_dart: iommu@492000000 {
 			status = "disabled";
 		};
 
+		nvme: nvme@4c5cc0000 {
+			compatible = "apple,t8132-nvme-ans2";
+			reg = <0x4 0xc5cc0000 0x0 0x60000>,
+			      <0x4 0x81600000 0x0 0x4000>;
+			reg-names = "nvme", "ans";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1018 IRQ_TYPE_LEVEL_HIGH>;
+			mboxes = <&ans_mbox>;
+			power-domains = <&ps_ans>, <&ps_apcie_sys_st>;
+			power-domain-names = "ans", "apcie0";
+			resets = <&ps_ans>;
+			apple,sart = <&sart>;
+		};
+
 		pcie0: pcie@1cb0000000 {
 			compatible = "apple,t8132-pcie", "apple,t6020-pcie";
 			device_type = "pci";
