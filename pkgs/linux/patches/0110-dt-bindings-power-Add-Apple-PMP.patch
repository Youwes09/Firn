From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Fri, 30 Oct 2026 20:44:36 -0500
Subject: [PATCH] dt-bindings: power: Add Apple PMP

The Power Management Processor is an RTKit coprocessor that manages the
power states of the SoC fabric. The bootloader fills in its boot
arguments and passes its configuration as apple,tunable-* properties.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 .../devicetree/bindings/power/apple,pmp.yaml  | 87 +++++++++++++++++++
 1 file changed, 87 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/apple,pmp.yaml

diff --git a/Documentation/devicetree/bindings/power/apple,pmp.yaml b/Documentation/devicetree/bindings/power/apple,pmp.yaml
new file mode 100644
index 000000000000..8f53bf4dba57
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/apple,pmp.yaml
@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/apple,pmp.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple Power Management Processor
+
+maintainers:
+  - Sven Peter <sven@kernel.org>
+
+description: |
+  The Power Management Processor (PMP) is an RTKit coprocessor that
+  manages power states of the SoC fabric and other uncore blocks. The
+  bootloader patches its boot arguments into the node, and passes its
+  configuration and calibration data as apple,tunable-* properties.
+
+properties:
+  compatible:
+    oneOf:
+      - const: apple,t6000-pmp-v2
+      - items:
+          - const: apple,t8132-pmp-v2
+          - const: apple,t6000-pmp-v2
+
+  reg:
+    items:
+      - description: PMP region holding the firmware boot arguments
+      - description: ASC coprocessor control registers
+
+  reg-names:
+    items:
+      - const: pmp
+      - const: asc
+
+  iommus:
+    maxItems: 1
+
+  mboxes:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  apple,board-id:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Board ID, filled in by the bootloader.
+
+  apple,dram-vendor-id:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: DRAM vendor ID, filled in by the bootloader.
+
+  apple,dram-capacity:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: DRAM capacity, filled in by the bootloader where known.
+
+patternProperties:
+  "^apple,tunable-[a-z0-9_-]+$":
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    description:
+      Firmware configuration and calibration data, copied by the bootloader
+      from the Apple device tree and handed to the firmware unchanged.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - iommus
+  - mboxes
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        pmp@380500000 {
+            compatible = "apple,t8132-pmp-v2", "apple,t6000-pmp-v2";
+            reg = <0x3 0x80500000 0x0 0xc0000>,
+                  <0x3 0x80e00000 0x0 0x4000>;
+            reg-names = "pmp", "asc";
+            iommus = <&pmp_dart 0 0x100 0x0 0x10 0x0>;
+            mboxes = <&pmp_mbox>;
+        };
+    };
