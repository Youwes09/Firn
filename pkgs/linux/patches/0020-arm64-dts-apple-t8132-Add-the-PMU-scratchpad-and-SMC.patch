From 5db767aeccdd068c7bb4a72af62c866cb435d651 Mon Sep 17 00:00:00 2001
From: KB2UKA <kb2uka80@gmail.com>
Date: Thu, 29 Oct 2026 00:30:23 -0500
Subject: [PATCH 20/26] arm64: dts: apple: t8132: Add the PMU scratchpad and
 SMC reboot

Add the boot and shutdown state cells in the Abbey PMU's legacy
scratchpad and the SMC reboot node that uses them. Without
shutdown_flag, the SMC off1 command restarts the machine instead of
leaving it off.

Based on work from Omarchy-M4-Native
(https://github.com/Kb2uka/Omarchy-M4-Native), released under GPL-2.0.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 34 ++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 0313a053c11a5..8dffadeca53c5 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -1155,6 +1155,14 @@ smc_rtc: rtc {
 				nvmem-cell-names = "rtc_offset";
 			};
 
+			reboot {
+				compatible = "apple,smc-reboot";
+				nvmem-cells = <&shutdown_flag>, <&boot_stage>,
+					      <&boot_error_count>, <&panic_count>;
+				nvmem-cell-names = "shutdown_flag", "boot_stage",
+						   "boot_error_count", "panic_count";
+			};
+
 			smc_gpio: gpio {
 				compatible = "apple,smc-gpio";
 				gpio-controller;
@@ -1207,6 +1215,32 @@ pm_setting: pm-setting@2001 {
 					rtc_offset: rtc-offset@2100 {
 						reg = <0x2100 0x6>;
 					};
+
+					/*
+					 * Boot and shutdown state in the legacy scratchpad
+					 * (ADT info-leg_scrpad = 0xf800), laid out as on
+					 * T6030. Without shutdown_flag, the SMC off1
+					 * command restarts the machine instead of leaving
+					 * it off.
+					 */
+					boot_stage: boot-stage@f801 {
+						reg = <0xf801 0x1>;
+					};
+
+					boot_error_count: boot-error-count@f802,0 {
+						reg = <0xf802 0x1>;
+						bits = <0 4>;
+					};
+
+					panic_count: panic-count@f802,4 {
+						reg = <0xf802 0x1>;
+						bits = <4 4>;
+					};
+
+					shutdown_flag: shutdown-flag@f80f,3 {
+						reg = <0xf80f 0x1>;
+						bits = <3 1>;
+					};
 				};
 			};
 		};
