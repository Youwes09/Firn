From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Thu, 29 Oct 2026 21:44:20 -0500
Subject: [PATCH] cpuidle: apple: Support T8132

iBoot locks the T8132 power-down control on: every wfi powers the core
down and loses its general registers, and writing the control raises an
SError. There is no clock-gated WFI state, so the deep state is a wfi that
saves the callee-saved registers and leaves the control alone, and the
shallow state waits in wfe with interrupts unmasked, which keeps its
registers and wakes as soon as an interrupt is pending.

On the J713 the idle CPU rail drops from 1314 mW to 13 mW. With a timer
firing on each core, the CPU rail draws:

  period   spin (idle=nop)   power-down only   wfe + power-down
  1 ms     613 mW            76 mW             84 mW
  100 us   576 mW            146 mW            73 mW

with 9 us of average wake-up latency against 5 us when spinning.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 drivers/cpuidle/cpuidle-apple.c | 102 +++++++++++++++++++++++++++++++-
 1 file changed, 100 insertions(+), 2 deletions(-)

diff --git a/drivers/cpuidle/cpuidle-apple.c b/drivers/cpuidle/cpuidle-apple.c
index 3d2b804df8a2..8b6dc27b6c94 100644
--- a/drivers/cpuidle/cpuidle-apple.c
+++ b/drivers/cpuidle/cpuidle-apple.c
@@ -57,7 +57,43 @@ asm(
 	".popsection\n"
 );
 
+/*
+ * T8132: iBoot locks the power-down control on, so every wfi powers the core
+ * down and loses its registers. Writing the control raises an SError.
+ */
+asm(
+	".pushsection .cpuidle.text, \"ax\"\n"
+	".type apple_cpu_t8132_wfi, @function\n"
+	"apple_cpu_t8132_wfi:\n"
+		"str x30, [sp, #-16]!\n"
+		"stp x28, x29, [sp, #-16]!\n"
+		"stp x26, x27, [sp, #-16]!\n"
+		"stp x24, x25, [sp, #-16]!\n"
+		"stp x22, x23, [sp, #-16]!\n"
+		"stp x20, x21, [sp, #-16]!\n"
+		"stp x18, x19, [sp, #-16]!\n"
+
+	"1:\n"
+		"dsb sy\n"
+		"wfi\n"
+
+		"mrs x0, ISR_EL1\n"
+		"cbz x0, 1b\n"
+
+		"ldp x18, x19, [sp], #16\n"
+		"ldp x20, x21, [sp], #16\n"
+		"ldp x22, x23, [sp], #16\n"
+		"ldp x24, x25, [sp], #16\n"
+		"ldp x26, x27, [sp], #16\n"
+		"ldp x28, x29, [sp], #16\n"
+		"ldr x30, [sp], #16\n"
+
+		"ret\n"
+	".popsection\n"
+);
+
 void apple_cpu_deep_wfi(void);
+void apple_cpu_t8132_wfi(void);
 
 static __cpuidle int apple_enter_wfi(struct cpuidle_device *dev, struct cpuidle_driver *drv, int index)
 {
@@ -122,9 +158,69 @@ static struct cpuidle_driver apple_idle_driver = {
 	.state_count = STATE_COUNT,
 };
 
+/*
+ * wfe with interrupts unmasked wakes as soon as one is pending, and the
+ * exception return of one taken just before it sets the event register.
+ */
+static __cpuidle int apple_enter_t8132_wfe(struct cpuidle_device *dev,
+					   struct cpuidle_driver *drv, int index)
+{
+	raw_local_irq_enable();
+	dsb(sy);
+	wfe();
+	raw_local_irq_disable();
+
+	return index;
+}
+
+static __cpuidle int apple_enter_t8132(struct cpuidle_device *dev,
+				       struct cpuidle_driver *drv, int index)
+{
+	/* The power-down loses the FP state too; the CPU PM notifiers save it. */
+	if (cpu_pm_enter())
+		return -1;
+
+	ct_cpuidle_enter();
+	apple_cpu_t8132_wfi();
+	ct_cpuidle_exit();
+
+	cpu_pm_exit();
+
+	return index;
+}
+
+/* Every wfi powers the core down, so the shallow state waits in wfe. */
+static struct cpuidle_driver apple_t8132_idle_driver = {
+	.name = "apple_idle",
+	.owner = THIS_MODULE,
+	.states = {
+		{
+			.enter			= apple_enter_t8132_wfe,
+			.exit_latency		= 1,
+			.target_residency	= 1,
+			.power_usage		= UINT_MAX,
+			.name			= "WFE",
+			.desc			= "CPU waiting for an event",
+		},
+		{
+			.enter			= apple_enter_t8132,
+			.enter_s2idle		= apple_enter_t8132,
+			.exit_latency		= 10,
+			.target_residency	= 100,
+			.power_usage		= 0,
+			.name			= "CPU PD",
+			.desc			= "CPU powered down",
+			.flags			= CPUIDLE_FLAG_RCU_IDLE,
+		},
+	},
+	.state_count = 2,
+};
+
+static struct cpuidle_driver *apple_driver = &apple_idle_driver;
+
 static int apple_cpuidle_probe(struct platform_device *pdev)
 {
-	return cpuidle_register(&apple_idle_driver, NULL);
+	return cpuidle_register(apple_driver, NULL);
 }
 
 static struct platform_driver apple_cpuidle_driver = {
@@ -146,7 +242,9 @@ static int __init apple_cpuidle_init(void)
 	if (!of_machine_is_compatible("apple,arm-platform"))
 		return 0;
 
-	if (!(of_machine_is_compatible("apple,t8103") ||
+	if (of_machine_is_compatible("apple,t8132"))
+		apple_driver = &apple_t8132_idle_driver;
+	else if (!(of_machine_is_compatible("apple,t8103") ||
 	      of_machine_is_compatible("apple,t8112") ||
 	      of_machine_is_compatible("apple,t8122") ||
 	      of_machine_is_compatible("apple,t6000") ||
