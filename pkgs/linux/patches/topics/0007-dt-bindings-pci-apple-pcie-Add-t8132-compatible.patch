From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Mon, 26 Oct 2026 12:29:36 -0500
Subject: [PATCH 07/41] dt-bindings: pci: apple,pcie: Add t8132 compatible

The PCIe controller on t8132 (M4) is compatible with the one on t6020,
with separate PHY register ranges, but it has three root ports where
t6020 has four. The fixed reg-names list cannot describe three ports
followed by their PHYs.

List the register names per controller family instead: apple,pcie
(t8103, t8112, t6000) keeps config, rc and up to four ports; t6020
keeps all ten ranges; t8132 has config, rc, three ports and three PHYs.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 .../devicetree/bindings/pci/apple,pcie.yaml   | 68 +++++++++++++++----
 1 file changed, 55 insertions(+), 13 deletions(-)

diff --git a/Documentation/devicetree/bindings/pci/apple,pcie.yaml b/Documentation/devicetree/bindings/pci/apple,pcie.yaml
index 0bed9e126..72d431e36 100644
--- a/Documentation/devicetree/bindings/pci/apple,pcie.yaml
+++ b/Documentation/devicetree/bindings/pci/apple,pcie.yaml
@@ -42,7 +42,9 @@ properties:
               - apple,t6000-pcie
           - const: apple,pcie
       - items:
-          - const: apple,t8122-pcie
+          - enum:
+              - apple,t8122-pcie
+              - apple,t8132-pcie
           - const: apple,t6020-pcie
       - const: apple,t6020-pcie
 
@@ -52,17 +54,7 @@ properties:
 
   reg-names:
     minItems: 3
-    items:
-      - const: config
-      - const: rc
-      - const: port0
-      - const: port1
-      - const: port2
-      - const: port3
-      - const: phy0
-      - const: phy1
-      - const: phy2
-      - const: phy3
+    maxItems: 10
 
   ranges:
     minItems: 2
@@ -121,6 +113,24 @@ unevaluatedProperties: false
 allOf:
   - $ref: /schemas/pci/pci-host-bridge.yaml#
   - $ref: /schemas/interrupt-controller/msi-controller.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,pcie
+    then:
+      properties:
+        reg:
+          maxItems: 6
+        reg-names:
+          minItems: 3
+          items:
+            - const: config
+            - const: rc
+            - const: port0
+            - const: port1
+            - const: port2
+            - const: port3
   - if:
       properties:
         compatible:
@@ -137,10 +147,42 @@ allOf:
         compatible:
           contains:
             const: apple,t6020-pcie
+          not:
+            contains:
+              const: apple,t8132-pcie
     then:
       properties:
         reg-names:
-          minItems: 10
+          items:
+            - const: config
+            - const: rc
+            - const: port0
+            - const: port1
+            - const: port2
+            - const: port3
+            - const: phy0
+            - const: phy1
+            - const: phy2
+            - const: phy3
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8132-pcie
+    then:
+      properties:
+        reg:
+          maxItems: 8
+        reg-names:
+          items:
+            - const: config
+            - const: rc
+            - const: port0
+            - const: port1
+            - const: port2
+            - const: phy0
+            - const: phy1
+            - const: phy2
 
 examples:
   - |
