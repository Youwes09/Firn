From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Mon, 26 Oct 2026 00:02:04 -0500
Subject: [PATCH 37/41] arm64: dts: apple: t8132-j713: Enable PCIe Wi-Fi and
 Bluetooth

Enable PCIe port 0 and its DART, power the BCM4388 module through SMC
GPIO 19 and describe its Wi-Fi and Bluetooth functions, with the wifi0
and bluetooth0 aliases the loader uses to fill in MAC addresses and
calibration data. Matches the devicetree qualified on J713.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 arch/arm64/boot/dts/apple/t8132-j713.dts | 37 ++++++++++++++++++++++++
 1 file changed, 37 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713.dts b/arch/arm64/boot/dts/apple/t8132-j713.dts
index fe5e2308d..e4b3d937a 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j713.dts
@@ -19,7 +19,9 @@ / {
 	model = "Apple MacBook Air (13-inch, M4, 2025)";
 
 	aliases {
+		bluetooth0 = &bluetooth0;
 		keyboard = &keyboard;
+		wifi0 = &wifi0;
 	};
 
 	led-controller {
@@ -39,6 +41,41 @@ &fpwm1 {
 	status = "okay";
 };
 
+/*
+ * The BCM4388 Wi-Fi/Bluetooth module sits behind PCIe port 0; its power
+ * enable is SMC GPIO 19. The loader fills in the MAC addresses and
+ * calibration through the wifi0/bluetooth0 aliases.
+ */
+&pcie0_dart {
+	status = "okay";
+};
+
+&pcie0 {
+	status = "okay";
+};
+
+&port00 {
+	bus-range = <1 1>;
+	pwren-gpios = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;
+
+	wifi0: wifi@0,0 {
+		compatible = "pci14e4,4434";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+		/* To be filled by the loader */
+		local-mac-address = [00 00 00 00 00 00];
+		apple,antenna-sku = "XX";
+		brcm,board-type = "apple,garden";
+	};
+
+	bluetooth0: bluetooth@0,1 {
+		compatible = "pci14e4,5f72";
+		reg = <0x10100 0x0 0x0 0x0 0x0>;
+		/* To be filled by the loader */
+		local-bd-address = [00 00 00 00 00 00];
+		brcm,board-type = "apple,garden";
+	};
+};
+
 &dwc3_0 {
 	status = "okay";
 };
