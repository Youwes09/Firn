@@ -182,6 +212,49 @@ clkref: clock-ref {
 		clock-output-names = "clkref";
 	};
 
+	/*
+	 * Both tables stop at the state iBoot leaves each cluster in (E1
+	 * 900 MHz, P4 1800 MHz), so no core runs faster or hotter than at
+	 * handoff. Higher states need a CPU thermal policy first.
+	 *
+	 * capacity-dmips-mhz: an E core at 900 MHz does 0.324 of the work
+	 * of a P core at 1800 MHz, so E = 0.324 * 1800 / 900 * 1024 = 663.
+	 */
+	ecluster_opp: opp-table-0 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp01 {
+			opp-hz = /bits/ 64 <900000000>;
+			opp-level = <1>;
+		};
+	};
+
+	pcluster_opp: opp-table-1 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp01 {
+			opp-hz = /bits/ 64 <912000000>;
+			opp-level = <1>;
+		};
+
+		opp02 {
+			opp-hz = /bits/ 64 <1260000000>;
+			opp-level = <2>;
+		};
+
+		opp03 {
+			opp-hz = /bits/ 64 <1512000000>;
+			opp-level = <3>;
+		};
+
+		opp04 {
+			opp-hz = /bits/ 64 <1800000000>;
+			opp-level = <4>;
+		};
+	};
+
 	soc: soc {
 		compatible = "simple-bus";
 		#address-cells = <2>;
@@ -310,6 +383,23 @@ nub_spmi_a0: spmi@388908000 {
 			status = "disabled";
 		};
 
+		/*
+		 * Cluster performance controllers at the ADT pmgr reg[5] and
+		 * reg[16] bases. DVFS_STATUS reads back in the T8112 layout.
+		 * Frequencies are the ADT voltage-states1/5 tables.
+		 */
+		cpufreq_e: cpufreq@210e20000 {
+			compatible = "apple,t8132-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
+			reg = <0x2 0x10e20000 0 0x1000>;
+			#performance-domain-cells = <0>;
+		};
+
+		cpufreq_p: cpufreq@211e20000 {
+			compatible = "apple,t8132-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
+			reg = <0x2 0x11e20000 0 0x1000>;
+			#performance-domain-cells = <0>;
+		};
+
 		smc: smc@38c600000 {
 			compatible = "apple,t8132-smc", "apple,t8103-smc";
 			reg = <0x3 0x8c600000 0x0 0x4000>,
