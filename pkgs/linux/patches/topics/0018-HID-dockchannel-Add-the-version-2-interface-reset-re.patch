From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Mon, 26 Oct 2026 18:53:45 -0500
Subject: [PATCH 18/41] HID: dockchannel: Add the version 2 interface reset
 request

The multi-touch firmware on t8132 (M4) rejects the four-byte version 1
interface reset request with error 0xe00002c2, so the trackpad never
reports ready after its firmware is loaded. That firmware takes a
nine-byte version 2 request: the version 1 fields followed by a phase
byte and a 32-bit status, sent with phase 0 and then phase 1 for each
state change.

Add apple,t8132-dockchannel-hid and select the request version from the
compatible.

The request format follows Omarchy-M4-Native's J713 version 2 power
patch, which adapted it from an investigation of the M4 Pro (t6040)
trackpad.

Link: https://github.com/Kb2uka/Omarchy-M4-Native/blob/develop/docs/j713-input-power-v2.md
Link: https://github.com/damsleth/wallace/blob/55f116dd0e0f28d1412c6be728a101f7d861c473/evidence/2026-08-04-t6040-trackpad-post-upload-reset-contract.md
Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 drivers/hid/dockchannel-hid/dockchannel-hid.c | 33 +++++++++++++++++--
 1 file changed, 30 insertions(+), 3 deletions(-)

diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid.c b/drivers/hid/dockchannel-hid/dockchannel-hid.c
index 399e85853..4bb603443 100644
--- a/drivers/hid/dockchannel-hid/dockchannel-hid.c
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid.c
@@ -13,6 +13,7 @@
 #include <linux/gpio/consumer.h>
 #include <linux/hid.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/slab.h>
 #include <linux/soc/apple/dockchannel.h>
 #include <linux/string.h>
@@ -181,6 +182,7 @@ struct dockchannel_hid {
 	struct device *dev;
 	struct dockchannel *dc;
 	struct device_link *helper_link;
+	unsigned int reset_version;
 
 	bool id_ready;
 	struct dchid_stm_id device_id;
@@ -370,9 +372,32 @@ static int dchid_enable_interface(struct dchid_iface *iface)
 
 static int dchid_reset_interface(struct dchid_iface *iface, int state)
 {
-	u8 msg[] = { CMD_RESET_INTERFACE, 1, iface->index, state };
+	struct {
+		u8 cmd;
+		u8 version;
+		u8 iface;
+		u8 state;
+		/* Version 2 only */
+		u8 phase;
+		__le32 status;
+	} __packed msg = {
+		.cmd = CMD_RESET_INTERFACE,
+		.version = iface->dchid->reset_version,
+		.iface = iface->index,
+		.state = state,
+	};
+	int ret;
 
-	return dchid_comm_cmd(iface->dchid, msg, sizeof(msg));
+	if (msg.version < 2)
+		return dchid_comm_cmd(iface->dchid, &msg, offsetof(typeof(msg), phase));
+
+	/* Version 2 firmware takes each state change in two phases */
+	ret = dchid_comm_cmd(iface->dchid, &msg, sizeof(msg));
+	if (ret < 0)
+		return ret;
+
+	msg.phase = 1;
+	return dchid_comm_cmd(iface->dchid, &msg, sizeof(msg));
 }
 
 static int dchid_send_firmware(struct dchid_iface *iface, void *firmware, size_t size)
@@ -1112,6 +1137,7 @@ static int dockchannel_hid_probe(struct platform_device *pdev)
 	}
 
 	dchid->dev = dev;
+	dchid->reset_version = (uintptr_t)device_get_match_data(dev);
 
 	/*
 	 * First make sure all the GPIOs are available, in cased we need to defer.
@@ -1196,7 +1222,8 @@ static void dockchannel_hid_remove(struct platform_device *pdev)
 }
 
 static const struct of_device_id dockchannel_hid_of_match[] = {
-	{ .compatible = "apple,dockchannel-hid" },
+	{ .compatible = "apple,t8132-dockchannel-hid", .data = (void *)2 },
+	{ .compatible = "apple,dockchannel-hid", .data = (void *)1 },
 	{},
 };
 MODULE_DEVICE_TABLE(of, dockchannel_hid_of_match);
