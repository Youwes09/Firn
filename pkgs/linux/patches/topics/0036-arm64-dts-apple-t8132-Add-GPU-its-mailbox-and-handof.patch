From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Mon, 26 Oct 2026 00:01:45 -0500
Subject: [PATCH 36/41] arm64: dts: apple: t8132: Add GPU, its mailbox and
 handoff carve-outs

Describe the T8132 GPU (AGX) coprocessor, its ASC mailbox and the five
reserved-memory placeholders the loader fills in for the GPU handoff
(TTBs, page tables, L2, handoff region and firmware), as in the
devicetree qualified on J713. The placeholders stay disabled with an
empty reg until the loader sets them.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 arch/arm64/boot/dts/apple/t8132-j713.dts |  8 ++++
 arch/arm64/boot/dts/apple/t8132.dtsi     | 61 ++++++++++++++++++++++++
 2 files changed, 69 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713.dts b/arch/arm64/boot/dts/apple/t8132-j713.dts
index e5a57bbb1..fe5e2308d 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j713.dts
@@ -176,3 +176,11 @@ &atcphy1 {
 &atcphy1_xbar {
 	status = "okay";
 };
+
+&agx_mbox {
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index fa919fce5..dd77a5435 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -1100,6 +1100,67 @@ port02: pci@2,0 {
 				status = "disabled";
 			};
 		};
+
+		agx_mbox: mbox@302608000 {
+			compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x3 0x02608000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 993 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 994 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 995 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 996 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+					  "recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			power-domains = <&ps_gfx>;
+			status = "disabled";
+		};
+
+		gpu: gpu@302600000 {
+			compatible = "apple,agx-t8132";
+			reg = <0x3 0x02600000 0x0 0x88000>,
+			      <0x3 0x00000000 0x0 0x4000000>;
+			reg-names = "asc", "sgx";
+			mboxes = <&agx_mbox>;
+			power-domains = <&ps_gfx>;
+			memory-region = <&uat_ttbs>, <&uat_pagetables>, <&uat_l2>,
+					<&uat_handoff>, <&gpu_fw>;
+			memory-region-names = "ttbs", "pagetables", "l2", "handoff",
+					      "firmware";
+			status = "disabled";
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* GPU handoff regions: the loader fills in reg and enables them. */
+		uat_ttbs: uat-ttbs {
+			reg = <0 0 0 0>;
+			status = "disabled";
+		};
+
+		uat_pagetables: uat-pagetables {
+			reg = <0 0 0 0>;
+			status = "disabled";
+		};
+
+		uat_l2: uat-l2 {
+			reg = <0 0 0 0>;
+			status = "disabled";
+		};
+
+		uat_handoff: uat-handoff {
+			reg = <0 0 0 0>;
+			status = "disabled";
+		};
+
+		gpu_fw: gpu-firmware {
+			reg = <0 0 0 0>;
+			status = "disabled";
+		};
 	};
 };
 
