From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KB2UKA <kb2uka80@gmail.com>
Date: Sun, 25 Oct 2026 23:54:47 -0500
Subject: [PATCH 32/41] arm64: dts: apple: t8132: Add SIO

Add the SIO co-processor with its mailbox and DART.

Based on work from Omarchy-M4-Native
(https://github.com/Kb2uka/Omarchy-M4-Native), released under GPL-2.0.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 36 ++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 8a6b881ba..f8a0dd127 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -620,6 +620,16 @@ fpwm1: pwm@3ad044000 {
 			status = "disabled";
 		};
 
+		sio_dart: iommu@3ad060000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x3 0xad060000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1074 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			power-domains = <&ps_sio_cpu>;
+			status = "disabled";
+		};
+
 		spi2: spi@3ad108000 {
 			compatible = "apple,t8132-spi", "apple,t8103-spi";
 			reg = <0x3 0xad108000 0x0 0x4000>;
@@ -656,6 +666,32 @@ serial0: serial@3ad200000 {
 			status = "disabled";
 		};
 
+		sio: dma-controller@3ade00000 {
+			compatible = "apple,t8132-sio", "apple,sio";
+			reg = <0x3 0xade00000 0x0 0x4000>;
+			dma-channels = <128>;
+			#dma-cells = <1>;
+			mboxes = <&sio_mbox>;
+			iommus = <&sio_dart 0>;
+			power-domains = <&ps_sio_cpu>;
+			status = "disabled";
+		};
+
+		sio_mbox: mbox@3ade08000 {
+			compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x3 0xade08000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1078 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1079 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1080 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1081 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+					  "recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			power-domains = <&ps_sio_cpu>;
+			status = "disabled";
+		};
+
 		dwc3_0: usb@402280000 {
 			compatible = "apple,t8132-dwc3", "apple,t8103-dwc3";
 			reg = <0x4 0x02280000 0x0 0xcd00>,
