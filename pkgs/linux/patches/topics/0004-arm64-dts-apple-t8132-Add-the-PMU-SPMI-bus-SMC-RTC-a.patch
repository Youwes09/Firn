From 9d70b67ae2adb612d7d9decfb954585f9744e072 Mon Sep 17 00:00:00 2001
From: KB2UKA <kb2uka80@gmail.com>
Date: Wed, 28 Oct 2026 21:02:44 -0500
Subject: [PATCH 4/5] arm64: dts: apple: t8132: Add the PMU SPMI bus, SMC RTC
 and reboot

Add the SPMI bus at 0x388714000 with the Abbey PMU and its NVMEM cells,
and the SMC RTC and reboot nodes that use them. Without the scratchpad's
shutdown_flag, the SMC off1 command restarts the machine instead of
leaving it off. Enable the bus on the J713.

Based on work from Omarchy-M4-Native
(https://github.com/Kb2uka/Omarchy-M4-Native), released under GPL-2.0.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 arch/arm64/boot/dts/apple/t8132-j713.dts |  4 ++
 arch/arm64/boot/dts/apple/t8132.dtsi     | 75 ++++++++++++++++++++++++
 2 files changed, 79 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713.dts b/arch/arm64/boot/dts/apple/t8132-j713.dts
index e1fc5d47f487..2195646c2d3b 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j713.dts
@@ -33,3 +33,7 @@ led-0 {
 &fpwm1 {
 	status = "okay";
 };
+
+&nub_spmi {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index afe98c042d6c..986b9175f40c 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -1031,6 +1031,81 @@ smc_gpio: gpio {
 			smc_hwmon: hwmon {
 				compatible = "apple,smc-hwmon";
 			};
+
+			rtc {
+				compatible = "apple,smc-rtc";
+				nvmem-cells = <&rtc_offset>;
+				nvmem-cell-names = "rtc_offset";
+			};
+
+			reboot {
+				compatible = "apple,smc-reboot";
+				nvmem-cells = <&shutdown_flag>, <&boot_stage>,
+					      <&boot_error_count>, <&panic_count>;
+				nvmem-cell-names = "shutdown_flag", "boot_stage",
+						   "boot_error_count", "panic_count";
+			};
+		};
+
+		nub_spmi: spmi@388714000 {
+			compatible = "apple,t8132-spmi", "apple,t8103-spmi";
+			reg = <0x3 0x88714000 0x0 0x100>;
+			#address-cells = <2>;
+			#size-cells = <0>;
+			status = "disabled";
+
+			pmic1: pmic@e {
+				compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
+				reg = <0xe SPMI_USID>;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					pm_setting: pm-setting@2001 {
+						reg = <0x2001 0x1>;
+					};
+
+					rtc_offset: rtc-offset@2100 {
+						reg = <0x2100 0x6>;
+					};
+
+					fault_shadow: fault-shadow@867b {
+						reg = <0x867b 0x10>;
+					};
+
+					socd: socd@8b00 {
+						reg = <0x8b00 0x1800>;
+					};
+
+					/*
+					 * Boot and shutdown state in the legacy scratchpad
+					 * (ADT info-leg_scrpad = 0xf800), laid out as on
+					 * T6030. Without shutdown_flag, the SMC off1
+					 * command restarts the machine instead of leaving
+					 * it off.
+					 */
+					boot_stage: boot-stage@f801 {
+						reg = <0xf801 0x1>;
+					};
+
+					boot_error_count: boot-error-count@f802,0 {
+						reg = <0xf802 0x1>;
+						bits = <0 4>;
+					};
+
+					panic_count: panic-count@f802,4 {
+						reg = <0xf802 0x1>;
+						bits = <4 4>;
+					};
+
+					shutdown_flag: shutdown-flag@f80f,3 {
+						reg = <0xf80f 0x1>;
+						bits = <3 1>;
+					};
+				};
+			};
 		};
 
 		nub_spmi_a0: spmi@388908000 {
