From b9a44cc694070b014286dfb7508e60cd4a71f092 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Wed, 28 Oct 2026 21:02:47 -0500
Subject: [PATCH 5/5] arm64: dts: apple: t8132-j713: Add the GPU

The J713 has the same t8132 GPU as the J773g; m1n1 fills its memory
regions and enables it.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 arch/arm64/boot/dts/apple/t8132-j713.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713.dts b/arch/arm64/boot/dts/apple/t8132-j713.dts
index 2195646c2d3b..6e2f89c84b93 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j713.dts
@@ -11,6 +11,7 @@
 
 #include "t8132.dtsi"
 #include "t8132-jxxx.dtsi"
+#include "t8132-gpu.dtsi"
 #include <dt-bindings/leds/common.h>
 
 / {
