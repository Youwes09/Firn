From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Tue, 20 Oct 2026 00:27:42 -0400
Subject: [PATCH] drm/asahi: G16: Drop the wedge_recover ladder

wedge_recover=1 re-kicked the stuck render's 3D lane (R1) and then every
render queue's TA and 3D lanes (R2) after an A4 wedge detection.
Production never set it, and the A4 hang's cause was found in userspace.
The detection and its one-time log line stay (the line no longer names
the parameter); the firmware watchdog handles the wedge as before. The
parked kind-4 recovery work lives on gpu/g16-recovery.

Signed-off-by: Niklas Sheth <hi@niklassheth.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/asahi/asahi_m4.rs    |  4 --
 drivers/gpu/drm/asahi/g16.rs         |  5 ++-
 drivers/gpu/drm/asahi/g16_runtime.rs | 60 ++++------------------------
 3 files changed, 10 insertions(+), 59 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_m4.rs b/drivers/gpu/drm/asahi/asahi_m4.rs
index 32d53907bccc..bf87f8729d6b 100644
--- a/drivers/gpu/drm/asahi/asahi_m4.rs
+++ b/drivers/gpu/drm/asahi/asahi_m4.rs
@@ -161,10 +161,6 @@ fn probe<'bound>(
             default: 2000,
             description: "A4 wedge detection window: a render with TA done and all waits met whose 3D never starts, with all channels drained and no fragment progress on any lane for this long",
         },
-        wedge_recover: u32 {
-            default: 0,
-            description: "A4 wedge handling: 0 logs the detection only; 1 also re-kicks the stuck 3D lane (R1), then every render queue's TA and 3D lanes (R2), one rung per wedge_ms window, before the 10 s watchdog",
-        },
         compute_deps: u32 {
             default: 2,
             description: "Compute Work ordering against other queues: 1 waits in the kernel and submits Works without firmware dependency items (as Metal); 0 encodes firmware dependency items (the earlier behaviour, which can stall the firmware under heavy compute bursts); 2 as 1, but waits on the same queue's own render lanes stay firmware items (in-submission render -> compute edges without a host round trip)",
diff --git a/drivers/gpu/drm/asahi/g16.rs b/drivers/gpu/drm/asahi/g16.rs
index 12cfbca9c253..b6fb794e7e95 100644
--- a/drivers/gpu/drm/asahi/g16.rs
+++ b/drivers/gpu/drm/asahi/g16.rs
@@ -220,7 +220,8 @@ struct Diagnostics {
     /// flight's stamps and every channel's registers).
     wedge_sampled: Option<kernel::time::Instant<kernel::time::Monotonic>>,
     wedge_signature: u64,
-    wedge_rung: u32,
+    /// The current wedge has been logged.
+    wedge_reported: bool,
     /// Debug (dump_render_buffered): the most recent submitted renders,
     /// printed only by the hang report.
     render_ring: render_runtime::RenderRing,
@@ -767,7 +768,7 @@ pub(crate) fn new(pdev: &platform::Device<Core<'_>>) -> Result<Self> {
             wedge_since: None,
             wedge_sampled: None,
             wedge_signature: 0,
-            wedge_rung: 0,
+            wedge_reported: false,
             render_ring: render_runtime::RenderRing::new(),
             retire_log: KVec::new(),
             retire_next: 0,
diff --git a/drivers/gpu/drm/asahi/g16_runtime.rs b/drivers/gpu/drm/asahi/g16_runtime.rs
index 125615273eb7..65c0bcb04b01 100644
--- a/drivers/gpu/drm/asahi/g16_runtime.rs
+++ b/drivers/gpu/drm/asahi/g16_runtime.rs
@@ -3575,9 +3575,7 @@ impl Bootstrap {
     /// whose TA is done and whose waits are all satisfied, while its 3D never
     /// starts, every channel is drained and no fragment stamp on any lane
     /// moves for wedge_ms. Firmware reports nothing for this state, so the
-    /// kernel detects it. wedge_recover=0 only logs the detection; 1 also
-    /// walks the recovery ladder: R1 re-kicks the stuck render's 3D lane, R2
-    /// re-kicks the TA and 3D lanes of every live render queue.
+    /// kernel detects it and logs it once; the 10 s watchdog handles it.
     fn check_wedge(&mut self) -> Result {
         let fw = self._firmware_space.as_ref().ok_or(EIO)?;
         let mut stuck = None;
@@ -3611,7 +3609,7 @@ fn check_wedge(&mut self) -> Result {
         };
         let Some(index) = stuck.filter(|_| drained) else {
             self.diagnostics.wedge_since = None;
-            self.diagnostics.wedge_rung = 0;
+            self.diagnostics.wedge_reported = false;
             return Ok(());
         };
         let now = Instant::now();
@@ -3629,57 +3627,13 @@ fn check_wedge(&mut self) -> Result {
                 return Ok(());
             }
         }
-        let flight = &self.flights[index];
-        let owner = flight.owner.clone();
-        let recover = crate::module_parameters::wedge_recover.value() != 0;
-        if self.diagnostics.wedge_rung < 3 {
+        if !self.diagnostics.wedge_reported {
+            let flight = &self.flights[index];
             dev_err!(self.dev.as_ref(),
-                "G16: A4 wedge: Work {:#x} context {} stream {:#x} ordinal {} age {} ms, no fragment progress for {} ms; {}\n",
+                "G16: A4 wedge: Work {:#x} context {} stream {:#x} ordinal {} age {} ms, no fragment progress for {} ms; detection only\n",
                 flight.id, flight.context, flight.stream, flight.ordinal,
-                self.flight_ms(flight, now), (now - self.diagnostics.wedge_since.unwrap_or(now)).as_millis(),
-                match (recover, self.diagnostics.wedge_rung) {
-                    (false, _) => "detection only (wedge_recover=0)",
-                    (true, 0) => "R1: re-kicking its 3D lane",
-                    (true, 1) => "R2: re-kicking every render queue's TA and 3D lanes",
-                    _ => "ladder exhausted, leaving it to the watchdog",
-                });
-        }
-        if !recover || self.diagnostics.wedge_rung >= 2 {
-            self.diagnostics.wedge_rung = 3;
-            return Ok(());
-        }
-        if self.diagnostics.wedge_rung == 0 {
-            self.rekick(&owner, &[1])?;
-        } else {
-            let mut owners = KVec::new();
-            for f in self.flights.iter().filter(|f| f.render.is_some()) {
-                if !owners.iter().any(|o: &Arc<Mutex<FirmwareQueues>>| Arc::ptr_eq(o, &f.owner)) {
-                    owners.push(f.owner.clone(), GFP_KERNEL)?;
-                }
-            }
-            for o in owners.iter() {
-                self.rekick(o, &[0, 1])?;
-            }
-        }
-        self.flush()?;
-        self.diagnostics.wedge_rung += 1;
-        self.diagnostics.wedge_since = Some(Instant::now());
-        Ok(())
-    }
-
-    /// Re-send a render queue's channel messages at its current heads, as a
-    /// fresh publication with no new Work: firmware re-reads the lane.
-    fn rekick(&mut self, owner: &Arc<Mutex<FirmwareQueues>>, stages: &[usize]) -> Result {
-        let (lanes, priority, events) = {
-            let q = owner.lock();
-            let Some(lanes) = q.lanes else { return Ok(()) };
-            (lanes, q.priority, [q.event(0).ok(), q.event(1).ok()])
-        };
-        for &stage in stages {
-            let Some(event) = events[stage] else { continue };
-            let mut lane = lanes[stage];
-            lane.new = false;
-            self.stage_queue(priority as usize * 3 + stage, lane, event, self.render_publication)?;
+                self.flight_ms(flight, now), (now - self.diagnostics.wedge_since.unwrap_or(now)).as_millis());
+            self.diagnostics.wedge_reported = true;
         }
         Ok(())
     }
