+/* ASoC requires a bound device for component naming. The Rust audio driver
+ * creates this child only after the AOP service is ready. Keep its driver and
+ * card lifetime separate from the parent's Rust driver data.
+ */
+static int speaker_child_probe(struct platform_device *pdev)
+{
+	return 0;
+}
+static struct platform_driver speaker_child_driver = {
+	.probe = speaker_child_probe,
+	.driver = { .name = "aop-protected-speakers" },
+};
+static DEFINE_MUTEX(speaker_driver_lock);
+static unsigned int speaker_driver_users;
+
+static void speaker_driver_put(void *unused)
+{
+	mutex_lock(&speaker_driver_lock);
+	if (!--speaker_driver_users)
+		platform_driver_unregister(&speaker_child_driver);
+	mutex_unlock(&speaker_driver_lock);
+}
+
+static int speaker_driver_get(struct device *parent)
+{
+	int ret = 0;
+
+	mutex_lock(&speaker_driver_lock);
+	if (!speaker_driver_users)
+		ret = platform_driver_register(&speaker_child_driver);
+	if (!ret)
+		speaker_driver_users++;
+	mutex_unlock(&speaker_driver_lock);
+	if (ret)
+		return ret;
+	return devm_add_action_or_reset(parent, speaker_driver_put, NULL);
+}
+
+static void speaker_child_unregister(void *data)
+{
+	platform_device_unregister(data);
+}
+
+int apple_aop_speaker_new(struct device *dev, const void *context)
+{
+	struct platform_device *child;
+	struct platform_device_info info = {
+		.parent = dev,
+		.name = "aop-protected-speakers",
+		.id = PLATFORM_DEVID_AUTO,
+		.fwnode = dev_fwnode(dev),
+		.of_node_reused = true,
+	};
+	struct aop_speaker *s;
+	struct of_phandle_args gpio;
+	struct resource resource;
+	unsigned int c;
+	int ret;
+
+	ret = speaker_driver_get(dev);
+	if (ret)
+		goto put;
+	/* Keep ASoC card driver data separate from the parent Rust driver. */
+	child = platform_device_register_full(&info);
+	if (IS_ERR(child)) {
+		ret = PTR_ERR(child);
+		goto put;
+	}
+	ret = devm_add_action_or_reset(dev, speaker_child_unregister, child);
+	if (ret)
+		goto put;
+	dev = &child->dev;
+	s = kzalloc(sizeof(*s), GFP_KERNEL);
+	if (!s) {
+		ret = -ENOMEM;
+		goto put;
+	}
+	s->dev = dev;
+	s->context = context;
+	mutex_init(&s->lock);
+	INIT_DELAYED_WORK(&s->watchdog, speaker_watchdog);
+	s->enable = gpiod_get(dev, "speaker-enable", GPIOD_OUT_LOW);
+	if (IS_ERR(s->enable)) {
+		ret = PTR_ERR(s->enable);
+		goto free;
+	}
+	ret = of_parse_phandle_with_args(dev_of_node(dev),
+					 "speaker-enable-gpios", "#gpio-cells",
+					 0, &gpio);
+	if (ret)
+		goto gpio_put;
+	if (!of_device_is_compatible(gpio.np, "apple,t8103-pinctrl")) {
+		of_node_put(gpio.np);
+		ret = -EINVAL;
+		goto gpio_put;
+	}
+	ret = of_address_to_resource(gpio.np, 0, &resource);
+	of_node_put(gpio.np);
+	if (ret || gpio.args_count != 2 || gpio.args[1] ||
+	    (u64)gpio.args[0] * 4 + 4 > resource_size(&resource)) {
+		ret = -EINVAL;
+		goto gpio_put;
+	}
+	s->pin = ioremap(resource.start + gpio.args[0] * 4, 4);
+	if (!s->pin) {
+		ret = -ENOMEM;
+		goto gpio_put;
+	}
+	speaker_cutoff(s);
+	for (c = 0; c < SPKR_CHANNELS; c++) {
+		bool tweeter = c >= 4;
+		/* Native J616 AID35 SPP3 preset. Electrical full scale and minimum
+		 * resistance deliberately overestimate power during quiet bring-up.
+		 */
+		struct thermal_params p = {
+			.fs_mv = 32000,
+			.r_mohm = 2000,
+			.margin_pct = 150,
+			.ceiling = 120,
+			.r_coil = tweeter ? 26910 : 26060,
+			.r_magnet = tweeter ? 23930 : 25550,
+			.tau_coil_ms = tweeter ? 1550 : 5530,
+			.tau_magnet_ms = tweeter ? 73260 : 197250,
+			.t_ambient = 50000,
+			.t_limit = 140000,
+			.t_window = 20000,
+			.t_hysteresis = 5000,
+			.t_hard = 150000,
+			.t_stall = 180000,
+			.delivery_ns = 120000000,
+			.stall_frames = 4800,
+		};
+
+		ret = thermal_init(&s->thermal[c], &p, ktime_get_ns());
+		if (ret)
+			goto unmap;
+	}
+	for (c = 0; c < SPKR_CHANNELS; c++) {
+		s->codecs[c].of_node = of_parse_phandle(
+			dev_of_node(dev), "apple,speaker-codecs", c);
+		s->codecs[c].dai_name = "tas2764 ASI1";
+		if (!s->codecs[c].of_node) {
+			ret = -EINVAL;
+			goto unmap;
+		}
+	}
+	s->cpu = (struct snd_soc_dai_link_component){
+		.name = dev_name(dev), .dai_name = "aop-speaker-tx"
+	};
+	s->platform.name = dev_name(dev);
+	s->link = (struct snd_soc_dai_link){
+		.name = "Protected Speakers",
+		.stream_name = "Protected Speakers",
+		.playback_only = 1,
+		.nonatomic = 1,
+		.cpus = &s->cpu,
+		.num_cpus = 1,
+		.codecs = s->codecs,
+		.num_codecs = SPKR_CHANNELS,
+		.platforms = &s->platform,
+		.num_platforms = 1,
+		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_IF |
+			   SND_SOC_DAIFMT_CBC_CFC,
+		.init = speaker_link_init,
+	};
+	s->card = (struct snd_soc_card){
+		.name = "J616 Speakers",
+		.driver_name = "J616Speakers",
+		.owner = THIS_MODULE,
+		.dev = dev,
+		.dai_link = &s->link,
+		.num_links = 1,
+		.late_probe = speaker_late_probe,
+		.controls = speaker_controls,
+		.num_controls = ARRAY_SIZE(speaker_controls),
+		.dapm_widgets = speaker_widgets,
+		.num_dapm_widgets = ARRAY_SIZE(speaker_widgets),
+		.dapm_routes = speaker_routes,
+		.num_dapm_routes = ARRAY_SIZE(speaker_routes),
+		.fully_routed = true,
+	};
+	snd_soc_card_set_drvdata(&s->card, s);
+	s->panic.notifier_call = speaker_panic;
+	atomic_notifier_chain_register(&panic_notifier_list, &s->panic);
+	ret = devm_add_action_or_reset(dev, speaker_free, s);
+	if (ret)
+		return ret;
+	/* The existing TAS2764 driver owns codec reset/configuration and DAPM.
+	 * Keep common SDZ high during ordinary mute; faults cut it physically.
+	 */
+	speaker_enable(s);
+	ret = devm_snd_soc_register_component(dev, &speaker_component,
+					      &speaker_dai, 1);
+	if (ret)
+		return ret;
+	return devm_snd_soc_register_card(dev, &s->card);
+unmap:
+	for (c = 0; c < SPKR_CHANNELS; c++)
+		of_node_put(s->codecs[c].of_node);
+	iounmap(s->pin);
+gpio_put:
+	gpiod_put(s->enable);
+free:
+	kfree(s);
+put:
+	apple_aop_speaker_context_put(context);
+	return ret;
+}
+
+#else
+int apple_aop_speaker_new(struct device *dev, const void *context)
+{
+	apple_aop_speaker_context_put(context);
+	dev_info(dev, "AOP speakers require TAS2764 and I2C support\n");
+	return 0;
+}
+#endif
diff --git a/sound/soc/apple/aop_speaker_guard.h b/sound/soc/apple/aop_speaker_guard.h
new file mode 100644
index 0000000000000..d89e28dec4530
--- /dev/null
+++ b/sound/soc/apple/aop_speaker_guard.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_AOP_SPEAKER_GUARD_H
+#define APPLE_AOP_SPEAKER_GUARD_H
+/* ALSA S32 -> native low-24-bit integer samples in 32-bit words.
+ * Hardware DVC supplies the immutable -60dB ceiling; no IEEE floats enter DMA.
+ */
+static inline s32 aop_speaker_sample(s32 sample)
+{
+	return sample >> 8;
+}
+
+static inline u32 aop_speaker_dma_word(s32 sample)
+{
+	return (u32)sample & 0xffffff;
+}
+#endif
diff --git a/sound/soc/apple/neo_mic.c b/sound/soc/apple/neo_mic.c
new file mode 100644
index 0000000000000..4589a016c754d
--- /dev/null
+++ b/sound/soc/apple/neo_mic.c
@@ -0,0 +1,465 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Private T8140 microphone bring-up. AFK transport follows the existing Asahi
+ * AOP driver; Neo command layout is checked against native runtime captures.
+ * ALSA capture is exposed by the companion neo_pcm.c RX0 driver. */
+#include <linux/completion.h>
+#include <linux/atomic.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/clocksource.h>
+#include <clocksource/arm_arch_timer.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/soc/apple/rtkit.h>
+#include <linux/unaligned.h>
+#include "neo_secure.h"
+#include "neo_mic.h"
+
+#define NEO_EP_FIRST 0x20
+#define NEO_EP_COUNT 16
+#define NEO_AF_LIMIT 0x10000
+#define NEO_CALL_TIMEOUT msecs_to_jiffies(5000)
+#define NEO_HPAI 0x68706169
+
+struct neo_ring {
+	u32 offset, size, capacity, block;
+	bool valid;
+};
+
+struct neo_ep {
+	void *buffer;
+	dma_addr_t iova;
+	size_t size;
+	struct neo_ring tx, rx;
+};
+
+struct neo_mic {
+	struct device *dev;
+	struct apple_rtkit *rtkit;
+	struct neo_secure *secure;
+	void __iomem *asc;
+	struct neo_ep ep[NEO_EP_COUNT];
+	struct completion announced, replied;
+	struct mutex call_lock;
+	u8 audio_ep;
+	u32 audio_channel;
+	u16 seq, pending_tag;
+	atomic_t power_cookie;
+	bool ready;
+	u32 retcode;
+	u8 reply[256];
+	size_t reply_size;
+	bool crashed;
+};
+
+static int neo_send(struct neo_mic *mic, u8 ep, u64 value)
+{
+	return apple_rtkit_send_message(mic->rtkit, ep, value, NULL, false);
+}
+
+static u32 neo_rb_read(struct neo_ep *ep, u32 off)
+{
+	return le32_to_cpu(READ_ONCE(*(__le32 *)(ep->buffer + off)));
+}
+
+static void neo_rb_write(struct neo_ep *ep, u32 off, u32 value)
+{
+	WRITE_ONCE(*(__le32 *)(ep->buffer + off), cpu_to_le32(value));
+}
+
+static int neo_ring_init(struct neo_mic *mic, struct neo_ep *ep,
+			struct neo_ring *ring, u64 value)
+{
+	u32 offset = ((value >> 32) & 0xffff) * 64;
+	u32 size = ((value >> 16) & 0xffff) * 64;
+	u32 capacity, block;
+
+	if (!ep->buffer || size < 0x100 || offset > ep->size || size > ep->size - offset)
+		return -EINVAL;
+	dma_rmb();
+	capacity = neo_rb_read(ep, offset);
+	if (!capacity || capacity >= size || (size - capacity) % 3)
+		return -EINVAL;
+	block = (size - capacity) / 3;
+	if (block < 64 || block % 64 || capacity % block)
+		return -EINVAL;
+	*ring = (struct neo_ring){offset, size, capacity, block, true};
+	dev_info(mic->dev, "AFK ring offset=%x size=%x capacity=%x block=%x\n",
+		 offset, size, capacity, block);
+	return 0;
+}
+
+static void neo_packet(struct neo_mic *mic, u8 ep, const u8 *packet, size_t size)
+{
+	u8 category;
+	u16 subtype, tag;
+	const u8 *body;
+	size_t length;
+
+	/* QE channel/type (8 bytes), EPIC header and subheader (40 bytes). */
+	if (size < 48)
+		return;
+	category = packet[29];
+	subtype = get_unaligned_le16(packet + 30);
+	tag = get_unaligned_le16(packet + 32);
+	body = packet + 48;
+	length = size - 48;
+	if (category == 0 && subtype == 0xc0 && length >= 36) {
+		dev_info(mic->dev, "Service ep=%x ch=%x name=%.*s\n", ep,
+			 get_unaligned_le32(body + 32), 20, body);
+		if (!memcmp(body, "aop-audio\0", 10)) {
+			mic->audio_ep = ep;
+			mic->audio_channel = get_unaligned_le32(body + 32);
+			complete(&mic->announced);
+		}
+	} else if (category == 0x20 && ep == mic->audio_ep &&
+		   tag == READ_ONCE(mic->pending_tag) && length >= 4) {
+		mic->retcode = get_unaligned_le32(body);
+		mic->reply_size = min(length - 4, sizeof(mic->reply));
+		memcpy(mic->reply, body + 4, mic->reply_size);
+		complete(&mic->replied);
+	}
+}
+
+static int neo_drain(struct neo_mic *mic, u8 number, struct neo_ep *ep)
+{
+	struct neo_ring *ring = &ep->rx;
+	u32 rptr, wptr, offset, magic, length;
+	unsigned int count;
+
+	if (!ring->valid)
+		return -ENXIO;
+	dma_rmb();
+	rptr = neo_rb_read(ep, ring->offset + ring->block);
+	wptr = neo_rb_read(ep, ring->offset + 2 * ring->block);
+	for (count = 0; rptr != wptr && count <= ring->capacity / ring->block; count++) {
+		if (rptr >= ring->capacity || wptr >= ring->capacity ||
+		    rptr + 16 > ring->capacity)
+			return -EINVAL;
+		offset = ring->offset + 3 * ring->block + rptr;
+		magic = neo_rb_read(ep, offset);
+		length = neo_rb_read(ep, offset + 4);
+		if ((magic != 0x20504f49 && magic != 0x20504f41) || length > ring->capacity - 16)
+			return -EINVAL;
+		if (length > ring->capacity - rptr - 16) {
+			rptr = 0;
+			offset = ring->offset + 3 * ring->block;
+			magic = neo_rb_read(ep, offset);
+			length = neo_rb_read(ep, offset + 4);
+			if ((magic != 0x20504f49 && magic != 0x20504f41) || length > ring->capacity - 16)
+				return -EINVAL;
+		}
+		neo_packet(mic, number, ep->buffer + offset + 8, length + 8);
+		rptr = ALIGN(rptr + 16 + length, ring->block) % ring->capacity;
+		dma_wmb();
+		neo_rb_write(ep, ring->offset + ring->block, rptr);
+		dma_rmb();
+		wptr = neo_rb_read(ep, ring->offset + 2 * ring->block);
+	}
+	return rptr == wptr ? 0 : -EOVERFLOW;
+}
+
+static void neo_recv(void *cookie, u8 number, u64 value)
+{
+	struct neo_mic *mic = cookie;
+	struct neo_ep *ep;
+	u16 opcode = value >> 48;
+	int error = 0;
+
+	if (number < NEO_EP_FIRST || number >= NEO_EP_FIRST + NEO_EP_COUNT)
+		return;
+	ep = &mic->ep[number - NEO_EP_FIRST];
+	switch (opcode) {
+	case 0x80:
+		error = neo_send(mic, number, 0xa0ULL << 48);
+		break;
+	case 0x89:
+		if (ep->buffer) { error = -EBUSY; break; }
+		ep->size = ((value >> 16) & 0xffff) * 64;
+		if (!ep->size || ep->size > NEO_AF_LIMIT) { error = -EINVAL; break; }
+		ep->buffer = dma_alloc_coherent(mic->dev, ep->size, &ep->iova, GFP_KERNEL);
+		if (!ep->buffer) { error = -ENOMEM; break; }
+		dev_info(mic->dev, "AFK allocation ep=%x size=%zx iova=%pad\n", number, ep->size, &ep->iova);
+		error = neo_send(mic, number, (0xa1ULL << 48) | ep->iova);
+		break;
+	case 0x8a:
+	case 0x8b:
+		error = neo_ring_init(mic, ep, opcode == 0x8a ? &ep->tx : &ep->rx, value);
+		if (!error && ep->tx.valid && ep->rx.valid)
+			error = neo_send(mic, number, 0xa3ULL << 48);
+		break;
+	case 0x85:
+		error = neo_drain(mic, number, ep);
+		break;
+	case 0x86:
+	case 0x8c:
+	case 0xc1:
+		break;
+	default:
+		dev_warn(mic->dev, "Unknown AFK ep=%x message=%llx\n", number, value);
+	}
+	if (error)
+		dev_err(mic->dev, "AFK ep=%x opcode=%x error=%d\n", number, opcode, error);
+}
+
+static void neo_crashed(void *cookie, const void *log, size_t length)
+{
+	struct neo_mic *mic = cookie;
+	mic->crashed = true;
+	mic->retcode = ~0U;
+	complete_all(&mic->announced);
+	complete_all(&mic->replied);
+	dev_err(mic->dev, "AOP firmware crashed (%zu-byte log)\n", length);
+}
+
+static const struct apple_rtkit_ops neo_rtkit_ops = {
+	.quirks = APPLE_RTKIT_QUIRK_OSLOG_NO_SIZE,
+	.recv_message = neo_recv,
+	.crashed = neo_crashed,
+};
+
+static void neo_halt(void *cookie)
+{
+	struct neo_mic *mic = cookie;
+	/* Stop the coprocessor before RTKit drains its worker and before the
+	 * coherent rings are released. */
+	writel(readl(mic->asc + 0x44) & ~BIT(4), mic->asc + 0x44);
+}
+
+static void neo_free_rings(void *cookie)
+{
+	struct neo_mic *mic = cookie;
+	int i;
+	for (i = 0; i < NEO_EP_COUNT; i++)
+		if (mic->ep[i].buffer)
+			dma_free_coherent(mic->dev, mic->ep[i].size,
+					  mic->ep[i].buffer, mic->ep[i].iova);
+}
+
+static int neo_call(struct neo_mic *mic, const u8 *body, size_t length, u32 inline_size)
+{
+	struct neo_ep *ep = &mic->ep[mic->audio_ep - NEO_EP_FIRST];
+	struct neo_ring *ring = &ep->tx;
+	u8 packet[256] = {0};
+	u32 rptr, wptr, next, needed;
+	int error;
+
+	if (!ring->valid || length > sizeof(packet) - 56 || mic->crashed)
+		return -EINVAL;
+	mutex_lock(&mic->call_lock);
+	put_unaligned_le32(0x20504f49, packet);
+	put_unaligned_le32(40 + length, packet + 4);
+	put_unaligned_le32(mic->audio_channel, packet + 8);
+	packet[16] = 2;
+	put_unaligned_le16(mic->seq++, packet + 17);
+	put_unaligned_le32(length, packet + 32);
+	packet[36] = 2;
+	packet[37] = 0x10;
+	put_unaligned_le16(0x20, packet + 38);
+	mic->pending_tag = 1;
+	put_unaligned_le16(mic->pending_tag, packet + 40);
+	put_unaligned_le32(inline_size, packet + 52);
+	memcpy(packet + 56, body, length);
+	dma_rmb();
+	rptr = neo_rb_read(ep, ring->offset + ring->block);
+	wptr = neo_rb_read(ep, ring->offset + 2 * ring->block);
+	needed = ALIGN(56 + length, ring->block);
+	if (rptr >= ring->capacity || wptr >= ring->capacity || needed >= ring->capacity) {
+		error = -EINVAL; goto out;
+	}
+	if (56 + length > ring->capacity - wptr) {
+		/* AFK leaves a wrap header at the old cursor, then writes at zero. */
+		if (rptr <= needed || ring->capacity - wptr < 16) { error = -ENOSPC; goto out; }
+		memcpy(ep->buffer + ring->offset + 3 * ring->block + wptr, packet, 16);
+		wptr = 0;
+	} else if (wptr < rptr && needed >= rptr - wptr) {
+		error = -ENOSPC; goto out;
+	}
+	next = (wptr + needed) % ring->capacity;
+	if (next == rptr) { error = -ENOSPC; goto out; }
+	reinit_completion(&mic->replied);
+	mic->retcode = ~0U;
+	mic->reply_size = 0;
+	memcpy(ep->buffer + ring->offset + 3 * ring->block + wptr, packet, 56 + length);
+	dma_wmb();
+	neo_rb_write(ep, ring->offset + 2 * ring->block, next);
+	error = neo_send(mic, mic->audio_ep, (0xa2ULL << 48) | next);
+	if (!error && !wait_for_completion_timeout(&mic->replied, NEO_CALL_TIMEOUT))
+		error = -ETIMEDOUT;
+	if (!error && mic->retcode) {
+		dev_err(mic->dev, "Audio call returned %08x\n", mic->retcode);
+		error = -EIO;
+	}
+out:
+	mutex_unlock(&mic->call_lock);
+	return error;
+}
+
+static int neo_query_state(struct neo_mic *mic)
+{
+	u8 body[52] = {0};
+	int error;
+
+	put_unaligned_le32(~0U, body + 4);
+	put_unaligned_le32(0xc3000004, body + 8);
+	put_unaligned_le32(0x30, body + 32);
+	put_unaligned_le32(NEO_HPAI, body + 40);
+	put_unaligned_le32(401, body + 44);
+	put_unaligned_le32(1, body + 48);
+	error = neo_call(mic, body, sizeof(body), 8);
+	if (!error) {
+		if (mic->reply_size < 8 || get_unaligned_le32(mic->reply) != 4)
+			return -EPROTO;
+		dev_info(mic->dev, "HPAI state %08x; audio control transport verified\n",
+			 get_unaligned_le32(mic->reply + 4));
+	}
+	return error;
+}
+
+bool neo_audio_healthy(struct neo_mic *mic)
+{
+	return READ_ONCE(mic->ready) && !READ_ONCE(mic->crashed);
+}
+
+int neo_audio_set(struct neo_mic *mic, u32 device, u32 property,
+		  const void *payload, size_t length)
+{
+	u8 body[200] = {0};
+	if (length > sizeof(body) - 52)
+		return -EINVAL;
+	put_unaligned_le32(~0U, body + 4);
+	put_unaligned_le32(0xc3000005, body + 8);
+	put_unaligned_le32(0x30 + ALIGN(length, 4), body + 32);
+	put_unaligned_le32(device, body + 40);
+	put_unaligned_le32(property, body + 44);
+	put_unaligned_le32(length, body + 48);
+	memcpy(body + 52, payload, length);
+	return neo_call(mic, body, 52 + ALIGN(length, 4), 0);
+}
+
+int neo_audio_power(struct neo_mic *mic, u32 device, u32 state, u32 active)
+{
+	u8 body[100] = {0};
+	u64 ticks = mul_u64_u32_div(arch_timer_read_counter(), 24000000,
+				  arch_timer_get_rate());
+	int error;
+
+	put_unaligned_le32(~0U, body + 4);
+	put_unaligned_le32(0xc3000005, body + 8);
+	put_unaligned_le32(0x60, body + 32);
+	put_unaligned_le32(device, body + 40);
+	put_unaligned_le32(202, body + 44);
+	put_unaligned_le32(48, body + 48);
+	put_unaligned_le32(device, body + 52);
+	put_unaligned_le32(atomic_inc_return(&mic->power_cookie), body + 56);
+	put_unaligned_le64(ticks, body + 60);
+	put_unaligned_le32(state, body + 72);
+	put_unaligned_le32(active, body + 76);
+	error = neo_call(mic, body, sizeof(body), 0);
+	dev_info(mic->dev, "Audio device=%08x power state=%08x active=%u result=%d\n",
+		 device, state, active, error);
+	return error;
+}
+
+int neo_mic_power(struct neo_mic *mic, u32 state, u32 active)
+{
+	return neo_audio_power(mic, NEO_HPAI, state, active);
+}
+
+struct neo_mic *neo_mic_get(struct device *dev)
+{
+	struct device_node *node = of_parse_phandle(dev->of_node, "apple,aop", 0);
+	struct platform_device *pdev;
+	struct neo_mic *mic;
+	if (!node) return ERR_PTR(-ENODEV);
+	pdev = of_find_device_by_node(node);
+	of_node_put(node);
+	if (!pdev) return ERR_PTR(-EPROBE_DEFER);
+	mic = platform_get_drvdata(pdev);
+	if (!mic || !mic->ready) mic = ERR_PTR(-EPROBE_DEFER);
+	else if (!device_link_add(dev, &pdev->dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+		mic = ERR_PTR(-ENOMEM);
+	put_device(&pdev->dev);
+	return mic;
+}
+
+static int neo_mic_channels(struct neo_mic *mic)
+{
+	u8 body[64] = {0};
+	put_unaligned_le32(~0U, body + 4);
+	put_unaligned_le32(0xc3000005, body + 8);
+	put_unaligned_le32(0x3c, body + 32);
+	put_unaligned_le32(0x6c706169, body + 40); /* lpai */
+	put_unaligned_le32(300, body + 44);
+	put_unaligned_le32(12, body + 48);
+	put_unaligned_le32(3, body + 52);
+	put_unaligned_le32(3, body + 56);
+	put_unaligned_le32(3, body + 60);
+	return neo_call(mic, body, sizeof(body), 0);
+}
+
+static int neo_mic_probe(struct platform_device *pdev)
+{
+	struct neo_mic *mic;
+	int error, i;
+
+	mic = devm_kzalloc(&pdev->dev, sizeof(*mic), GFP_KERNEL);
+	if (!mic) return -ENOMEM;
+	mic->dev = &pdev->dev;
+	mic->secure = neo_secure_get(mic->dev);
+	if (IS_ERR(mic->secure)) return PTR_ERR(mic->secure);
+	init_completion(&mic->announced);
+	init_completion(&mic->replied);
+	mutex_init(&mic->call_lock);
+	platform_set_drvdata(pdev, mic);
+	error = dma_set_mask_and_coherent(mic->dev, DMA_BIT_MASK(42));
+	if (error) return error;
+	mic->asc = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(mic->asc)) return PTR_ERR(mic->asc);
+	error = devm_add_action_or_reset(mic->dev, neo_free_rings, mic);
+	if (error) return error;
+	mic->rtkit = devm_apple_rtkit_init(mic->dev, mic, "mbox", 0, &neo_rtkit_ops);
+	if (IS_ERR(mic->rtkit)) return PTR_ERR(mic->rtkit);
+	error = devm_add_action_or_reset(mic->dev, neo_halt, mic);
+	if (error) return error;
+	dev_info(mic->dev, "Starting resident Neo AOP firmware\n");
+	writel(readl(mic->asc + 0x44) | BIT(4), mic->asc + 0x44);
+	error = apple_rtkit_boot(mic->rtkit);
+	if (error) return dev_err_probe(mic->dev, error, "RTKit boot failed\n");
+	error = neo_secure_wait(mic->secure);
+	if (error) return dev_err_probe(mic->dev, error, "Second-host boot failed\n");
+	for (i = 0; i < NEO_EP_COUNT; i++) {
+		u8 ep = NEO_EP_FIRST + i;
+		if (!apple_rtkit_has_endpoint(mic->rtkit, ep)) continue;
+		error = apple_rtkit_start_ep(mic->rtkit, ep);
+		/* Neo firmware initiates AFK with version 8 after endpoint start.
+		 * The older host-initiated INIT transaction is absent natively. */
+		if (error) return error;
+	}
+	if (!wait_for_completion_timeout(&mic->announced, NEO_CALL_TIMEOUT) || mic->crashed)
+		return dev_err_probe(mic->dev, -ETIMEDOUT, "Audio service absent\n");
+	error = neo_query_state(mic);
+	if (error) return dev_err_probe(mic->dev, error, "Microphone state query failed\n");
+	error = neo_mic_channels(mic);
+	if (error) return dev_err_probe(mic->dev, error, "Microphone channel setup failed\n");
+	mic->ready = true;
+	return 0;
+}
+
+static const struct of_device_id neo_mic_of_match[] = {
+	{ .compatible = "apple,t8140-neo-mic" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, neo_mic_of_match);
+
+static struct platform_driver neo_mic_driver = {
+	.probe = neo_mic_probe,
+	.driver = { .name = "neo-aop-mic", .of_match_table = neo_mic_of_match },
+};
+module_platform_driver(neo_mic_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Private Neo AOP microphone control");
diff --git a/sound/soc/apple/neo_mic.h b/sound/soc/apple/neo_mic.h
new file mode 100644
index 0000000000000..4176c12fa99bd
--- /dev/null
+++ b/sound/soc/apple/neo_mic.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef NEO_MIC_H
+#define NEO_MIC_H
+#include <linux/device.h>
+struct neo_mic;
+struct neo_mic *neo_mic_get(struct device *dev);
+int neo_mic_power(struct neo_mic *mic, u32 state, u32 active);
+int neo_audio_set(struct neo_mic *mic, u32 device, u32 property,
+		  const void *payload, size_t length);
+int neo_audio_power(struct neo_mic *mic, u32 device, u32 state, u32 active);
+#define NEO_SPEAKER_DEVICE 0x73706b72
+#define NEO_MIC_WARM 0x70773020 /* pw0 : observed Neo intermediate state */
+#define NEO_MIC_ON 0x70777264 /* pwrd */
+#define NEO_MIC_OFF 0x69646c65 /* idle */
+bool neo_audio_healthy(struct neo_mic *mic);
+#endif
diff --git a/sound/soc/apple/neo_pcm.c b/sound/soc/apple/neo_pcm.c
new file mode 100644
index 0000000000000..890b9b8259776
--- /dev/null
+++ b/sound/soc/apple/neo_pcm.c
@@ -0,0 +1,286 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Private Neo capture-only ADMAC RX0 driver. Hardware programming follows
+ * declared native MMIO captures; the existing Asahi ADMAC ring algorithm
+ * supplies the descriptor/report model. No TX channel is mapped or started. */
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/core.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include "neo_mic.h"
+
+#define CH 0xc000
+#define RING_FULL BIT(9)
+#define RING_EMPTY BIT(8)
+#define RING_ERR BIT(10)
+struct neo_pcm {
+	struct device *dev;
+	struct neo_mic *mic;
+	struct snd_card *card;
+	void __iomem *regs, *proxy;
+	spinlock_t lock;
+	struct snd_pcm_substream *stream;
+	dma_addr_t addr;
+	size_t size, period, submitted, completed;
+	bool running, powered, irq_enabled;
+	int irq;
+	u32 descriptor_id;
+};
+
+static const struct snd_pcm_hardware neo_capture_hw = {
+	.info = SNDRV_PCM_INFO_INTERLEAVED | SNDRV_PCM_INFO_BLOCK_TRANSFER,
+	.formats = SNDRV_PCM_FMTBIT_FLOAT_LE,
+	.rates = SNDRV_PCM_RATE_48000,
+	.rate_min = 48000, .rate_max = 48000,
+	.channels_min = 2, .channels_max = 2,
+	.buffer_bytes_max = 256 * 1024,
+	.period_bytes_min = 3840, .period_bytes_max = 32768,
+	.periods_min = 4, .periods_max = 32,
+};
+
+static void neo_pcm_queue(struct neo_pcm *p)
+{
+	unsigned int count;
+	for (count = 0; count < 4; count++) {
+		dma_addr_t addr = p->addr + p->submitted;
+		if (readl(p->regs + CH + 0x70) & RING_FULL) break;
+		dma_wmb();
+		writel(lower_32_bits(addr), p->proxy + 0x14000);
+		writel(upper_32_bits(addr), p->proxy + 0x14000);
+		writel(p->period, p->proxy + 0x14000);
+		writel(0x110000 | (++p->descriptor_id & 0xffff), p->proxy + 0x14000);
+		p->submitted = (p->submitted + p->period) % p->size;
+	}
+}
+
+static void neo_pcm_stop(struct neo_pcm *p)
+{
+	if (p->irq_enabled) { disable_irq_nosync(p->irq); p->irq_enabled = false; }
+	if (!p->powered) return;
+	writel(0, p->regs + CH + 0x20);
+	writel(1, p->regs + 0xc);
+	writel(0, p->regs + CH + 0xa0);
+	p->running = false;
+}
+
+static irqreturn_t neo_pcm_irq(int irq, void *cookie)
+{
+	struct neo_pcm *p = cookie;
+	struct snd_pcm_substream *stream;
+	unsigned long flags;
+	u32 status, global, ring;
+	unsigned int count, periods = 0;
+	bool error = false;
+
+	spin_lock_irqsave(&p->lock, flags);
+	status = readl(p->regs + CH + 0x10);
+	global = readl(p->regs + 0x50);
+	if (!(readl(p->regs + 0x40) & 1) && !global) {
+		spin_unlock_irqrestore(&p->lock, flags);
+		return IRQ_NONE;
+	}
+	writel(~0U, p->regs + CH + 0x10);
+	writel(~0U, p->regs + 0x50);
+	stream = p->stream;
+	if (p->running) {
+		for (count = 0; count < 4; count++) {
+			ring = readl(p->regs + CH + 0x74);
+			if (ring & RING_ERR) { error = true; break; }
+			if (ring & RING_EMPTY) break;
+			/* Consume the complete four-word ADMAC report. */
+			readl(p->regs + 0x14100);
+			readl(p->regs + 0x14100);
+			readl(p->regs + 0x14100);
+			readl(p->regs + 0x14100);
+			p->completed = (p->completed + p->period) % p->size;
+			periods++;
+		}
+		dma_rmb();
+		if (readl(p->regs + CH + 0x70) & RING_ERR) error = true;
+		if (error) neo_pcm_stop(p);
+		else neo_pcm_queue(p);
+	}
+	spin_unlock_irqrestore(&p->lock, flags);
+	if (error) {
+		dev_err_ratelimited(p->dev, "RX ring error status=%08x\n", status);
+		if (stream) snd_pcm_stop_xrun(stream);
+	} else {
+		while (periods-- && stream) snd_pcm_period_elapsed(stream);
+	}
+	return IRQ_HANDLED;
+}
+
+static int neo_pcm_open(struct snd_pcm_substream *stream)
+{
+	struct neo_pcm *p = snd_pcm_substream_chip(stream);
+	stream->runtime->hw = neo_capture_hw;
+	WRITE_ONCE(p->stream, stream);
+	return snd_pcm_hw_constraint_integer(stream->runtime, SNDRV_PCM_HW_PARAM_PERIODS);
+}
+
+static int neo_pcm_poweroff(struct neo_pcm *p)
+{
+	int error = 0, second;
+	if (p->powered) {
+		synchronize_irq(p->irq);
+		error = neo_mic_power(p->mic, NEO_MIC_WARM, 1);
+		second = neo_mic_power(p->mic, NEO_MIC_OFF, 0);
+		if (!error) error = second;
+		p->powered = false;
+	}
+	return error;
+}
+
+static int neo_pcm_close(struct snd_pcm_substream *stream)
+{
+	struct neo_pcm *p = snd_pcm_substream_chip(stream);
+	unsigned long flags;
+	spin_lock_irqsave(&p->lock, flags);
+	neo_pcm_stop(p);
+	p->stream = NULL;
+	spin_unlock_irqrestore(&p->lock, flags);
+	return neo_pcm_poweroff(p);
+}
+
+static int neo_pcm_hw_free(struct snd_pcm_substream *stream)
+{
+	return neo_pcm_poweroff(snd_pcm_substream_chip(stream));
+}
+
+static int neo_pcm_prepare(struct snd_pcm_substream *stream)
+{
+	struct neo_pcm *p = snd_pcm_substream_chip(stream);
+	struct snd_pcm_runtime *runtime = stream->runtime;
+	int i, error;
+
+	/* Native AOP pw0 opens the gated RX controller before any MMIO. */
+	if (!p->powered) {
+		error = neo_mic_power(p->mic, NEO_MIC_WARM, 0);
+		if (error) return error;
+		p->powered = true;
+	}
+	neo_pcm_stop(p);
+	p->addr = runtime->dma_addr;
+	p->size = snd_pcm_lib_buffer_bytes(stream);
+	p->period = snd_pcm_lib_period_bytes(stream);
+	p->submitted = p->completed = p->descriptor_id = 0;
+	if (!p->size || !p->period || p->size % p->period) return -EINVAL;
+	memset(runtime->dma_area, 0, p->size);
+	/* RX0 setup observed on Neo. Preserve unrelated global configuration. */
+	writel(readl(p->regs + 0x10) & ~BIT(6), p->regs + 0x10);
+	writel(0x30001, p->regs + CH);
+	writel(0x30000, p->regs + CH);
+	writel(0x500, p->regs + CH + 0x70);
+	writel(0x500, p->regs + CH + 0x74);
+	for (i = 0; i < 4; i++) writel(~0U, p->regs + CH + 0x10 + 4 * i);
+	writel(~0U, p->regs + CH + 0x34);
+	writel(0, p->proxy + CH + 0x88);
+	writel(1, p->proxy + 0xc);
+	writel(1, p->proxy + CH);
+	writel(0, p->proxy + CH);
+	writel(0xf02, p->regs + CH + 0x40);
+	writel(0xc0, p->regs + CH + 0x54);
+	writel(1, p->regs + 0x104);
+	for (i = 0; i < 4; i++) writel(~0U, p->regs + 0x50 + 4 * i);
+	writel(~0U, p->regs + 0x60);
+	writel(0x29b0000, p->regs + CH + 4);
+	writel(3, p->regs + CH + 0xa0);
+	writel(0x302, p->regs + CH + 0x30);
+	writel(0, p->regs + CH + 0xa4);
+	neo_pcm_queue(p);
+	dev_info(p->dev, "Capture prepared dma=%pad size=%zx period=%zx\n", &p->addr, p->size, p->period);
+	error = neo_mic_power(p->mic, NEO_MIC_ON, 1);
+	if (error) { neo_pcm_poweroff(p); return error; }
+	return 0;
+}
+
+static int neo_pcm_trigger(struct snd_pcm_substream *stream, int command)
+{
+	struct neo_pcm *p = snd_pcm_substream_chip(stream);
+	unsigned long flags;
+	int error = 0;
+	spin_lock_irqsave(&p->lock, flags);
+	switch (command) {
+	case SNDRV_PCM_TRIGGER_START:
+		p->running = true;
+		if (!p->irq_enabled) { enable_irq(p->irq); p->irq_enabled = true; }
+		writel(~0U, p->regs + CH + 0x10);
+		writel(0x10463, p->regs + CH + 0x20);
+		writel(3, p->regs + CH + 0xa0);
+		writel(1, p->regs + 8);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+		neo_pcm_stop(p);
+		break;
+	default: error = -EINVAL;
+	}
+	spin_unlock_irqrestore(&p->lock, flags);
+	return error;
+}
+
+static snd_pcm_uframes_t neo_pcm_pointer(struct snd_pcm_substream *stream)
+{
+	struct neo_pcm *p = snd_pcm_substream_chip(stream);
+	return bytes_to_frames(stream->runtime, READ_ONCE(p->completed));
+}
+static const struct snd_pcm_ops neo_pcm_ops = {
+	.open = neo_pcm_open, .close = neo_pcm_close,
+	.ioctl = snd_pcm_lib_ioctl, .hw_free = neo_pcm_hw_free,
+	.prepare = neo_pcm_prepare, .trigger = neo_pcm_trigger, .pointer = neo_pcm_pointer,
+};
+
+static int neo_pcm_probe(struct platform_device *pdev)
+{
+	struct neo_pcm *p;
+	struct snd_card *card;
+	struct snd_pcm *pcm;
+	int error, irq;
+
+	error = snd_devm_card_new(&pdev->dev, -1, "NeoMic", THIS_MODULE, sizeof(*p), &card);
+	if (error) return error;
+	p = card->private_data;
+	p->dev = &pdev->dev;
+	p->card = card;
+	p->mic = neo_mic_get(p->dev);
+	if (IS_ERR(p->mic)) return PTR_ERR(p->mic);
+	spin_lock_init(&p->lock);
+	error = dma_set_mask_and_coherent(p->dev, DMA_BIT_MASK(42));
+	if (error) return error;
+	p->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(p->regs)) return PTR_ERR(p->regs);
+	p->proxy = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(p->proxy)) return PTR_ERR(p->proxy);
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0) return irq;
+	/* The RX aperture is gated until AOP accepts a pw0 request. */
+	p->irq = irq;
+	error = devm_request_irq(p->dev, irq, neo_pcm_irq, IRQF_NO_AUTOEN, "neo-mic-rx0", p);
+	if (error) return error;
+	error = snd_pcm_new(card, "Neo Microphone", 0, 0, 1, &pcm);
+	if (error) return error;
+	pcm->private_data = p;
+	strscpy(pcm->name, "Neo built-in microphone", sizeof(pcm->name));
+	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_CAPTURE, &neo_pcm_ops);
+	error = snd_pcm_set_managed_buffer_all(pcm, SNDRV_DMA_TYPE_DEV, p->dev, 128 * 1024, 256 * 1024);
+	if (error) return error;
+	strscpy(card->driver, "NeoMic", sizeof(card->driver));
+	strscpy(card->shortname, "Neo Microphone", sizeof(card->shortname));
+	strscpy(card->longname, "Neo AOP secure RX0 microphone", sizeof(card->longname));
+	platform_set_drvdata(pdev, p);
+	return snd_card_register(card);
+}
+static const struct of_device_id neo_pcm_of_match[] = {
+	{ .compatible = "apple,t8140-neo-mic-capture" }, {}
+};
+MODULE_DEVICE_TABLE(of, neo_pcm_of_match);
+static struct platform_driver neo_pcm_driver = {
+	.probe = neo_pcm_probe,
+	.driver = { .name = "neo-mic-capture", .of_match_table = neo_pcm_of_match },
+};
+module_platform_driver(neo_pcm_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Private Neo ALSA microphone capture");
diff --git a/sound/soc/apple/neo_secure.c b/sound/soc/apple/neo_secure.c
new file mode 100644
index 0000000000000..db44a2ab3d985
--- /dev/null
+++ b/sound/soc/apple/neo_secure.c
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Private Neo AOP second-host transport, derived from declared mailbox data.
+ * Own the link on Linux; no ExclaveOS guest or speaker path is started. */
+#include <linux/completion.h>
+#include <linux/dma-mapping.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/soc/apple/mailbox.h>
+#include <linux/workqueue.h>
+#include "neo_secure.h"
+
+#define NEO_SECURE_ENDPOINTS 0x40
+struct neo_secure_buffer {
+	void *rx, *tx;
+	dma_addr_t rx_iova, tx_iova;
+	size_t size;
+};
+struct neo_secure {
+	struct device *dev;
+	struct apple_mbox *mbox;
+	struct workqueue_struct *wq;
+	struct completion ready;
+	struct neo_secure_buffer buffers[NEO_SECURE_ENDPOINTS];
+	int error;
+};
+struct neo_secure_message {
+	struct work_struct work;
+	struct neo_secure *secure;
+	struct apple_mbox_msg msg;
+};
+
+static int neo_secure_send(struct neo_secure *s, u8 ep, u64 value)
+{
+	struct apple_mbox_msg msg = { .msg0 = value, .msg1 = ep };
+	dma_wmb();
+	return apple_mbox_send(s->mbox, msg, false);
+}
+
+static int neo_secure_allocate(struct neo_secure *s, u8 ep, size_t size)
+{
+	struct neo_secure_buffer *b = &s->buffers[ep];
+	u64 rx, tx;
+	int error;
+
+	if (!size || size > 0x10000 || size % 1024 || b->size)
+		return -EINVAL;
+	b->size = size;
+	b->rx = dma_alloc_coherent(s->dev, size, &b->rx_iova, GFP_KERNEL);
+	b->tx = dma_alloc_coherent(s->dev, size, &b->tx_iova, GFP_KERNEL);
+	if (!b->rx || !b->tx)
+		return -ENOMEM;
+	if ((b->rx_iova >> 36) != 0x20 || (b->tx_iova >> 36) != 0x20)
+		return -ERANGE;
+	/* This protocol encodes a 36-bit offset and a host window selector,
+	 * rather than the canonical 42-bit SID-1 IOVA used by DART. */
+	rx = 0x2000000000ULL | (b->rx_iova & GENMASK_ULL(35, 0));
+	tx = 0x2000000000ULL | (b->tx_iova & GENMASK_ULL(35, 0));
+	dev_info(s->dev, "Second-host queue ep=%x size=%zx rx=%pad tx=%pad\n",
+		 ep, size, &b->rx_iova, &b->tx_iova);
+	error = neo_secure_send(s, ep, 0x1200ULL << 48);
+	if (!error) error = neo_secure_send(s, ep, (0x5041ULL << 48) | rx);
+	if (!error) error = neo_secure_send(s, ep,
+			((0x5000ULL | (size / 1024)) << 48) | tx);
+	return error;
+}
+
+static void neo_secure_work(struct work_struct *work)
+{
+	struct neo_secure_message *message = container_of(work, struct neo_secure_message, work);
+	struct neo_secure *s = message->secure;
+	u64 value = message->msg.msg0;
+	u8 ep = message->msg.msg1;
+	u16 type = value >> 48;
+	int error = 0;
+
+	dev_info(s->dev, "Second-host RX ep=%x value=%016llx\n", ep, value);
+	if (!ep) {
+		switch ((value >> 52) & 0xff) {
+		case 1: /* HELLO: native firmware advertises protocol 12. */
+			if ((value & 0xffffffff) != 0xc000c) { error = -EPROTO; break; }
+			error = neo_secure_send(s, 0, 0x200000000c000cULL);
+			break;
+		case 8: /* Unlike normal RTKit, this host echoes the endpoint map. */
+			error = neo_secure_send(s, 0, value);
+			if (!error && (value & BIT_ULL(51)))
+				error = neo_secure_send(s, 0, 0xb0000000000220ULL);
+			break;
+		case 0xb:
+			if ((value & 0xffff) != 0x20) error = -EPROTO;
+			complete(&s->ready);
+			break;
+		default:
+			error = -EPROTO;
+		}
+	} else if (ep >= 0x20 && ep < NEO_SECURE_ENDPOINTS) {
+		switch (type) {
+		case 0x1200:
+			error = neo_secure_allocate(s, ep, value & 0xffffffff);
+			break;
+		case 0x2000:
+			/* No requests are sent on this link during transport bring-up.
+			 * Acknowledge received notifications so it cannot stall AOP. */
+			dma_rmb();
+			error = neo_secure_send(s, ep, 0x4000ULL << 48);
+			break;
+		default:
+			error = -EPROTO;
+		}
+	} else {
+		error = -EPROTO;
+	}
+	if (error) {
+		s->error = error;
+		dev_err(s->dev, "Second-host error %d ep=%x value=%llx\n", error, ep, value);
+		complete_all(&s->ready);
+	}
+	kfree(message);
+}
+
+static void neo_secure_rx(struct apple_mbox *mbox, struct apple_mbox_msg msg, void *cookie)
+{
+	struct neo_secure *s = cookie;
+	struct neo_secure_message *message = kzalloc(sizeof(*message), GFP_ATOMIC);
+	if (!message) { s->error = -ENOMEM; complete_all(&s->ready); return; }
+	message->secure = s;
+	message->msg = msg;
+	INIT_WORK(&message->work, neo_secure_work);
+	queue_work(s->wq, &message->work);
+}
+
+static void neo_secure_cleanup(void *cookie)
+{
+	struct neo_secure *s = cookie;
+	int i;
+	apple_mbox_stop(s->mbox);
+	destroy_workqueue(s->wq);
+	for (i = 0; i < NEO_SECURE_ENDPOINTS; i++) {
+		struct neo_secure_buffer *b = &s->buffers[i];
+		if (b->rx) dma_free_coherent(s->dev, b->size, b->rx, b->rx_iova);
+		if (b->tx) dma_free_coherent(s->dev, b->size, b->tx, b->tx_iova);
+	}
+}
+
+struct neo_secure *neo_secure_get(struct device *dev)
+{
+	struct device_node *node = of_parse_phandle(dev->of_node, "apple,second-host", 0);
+	struct platform_device *pdev;
+	struct neo_secure *s;
+	if (!node) return ERR_PTR(-ENODEV);
+	pdev = of_find_device_by_node(node);
+	of_node_put(node);
+	if (!pdev) return ERR_PTR(-EPROBE_DEFER);
+	s = platform_get_drvdata(pdev);
+	if (s && !device_link_add(dev, &pdev->dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+		s = ERR_PTR(-ENOMEM);
+	put_device(&pdev->dev);
+	return s ?: ERR_PTR(-EPROBE_DEFER);
+}
+
+int neo_secure_wait(struct neo_secure *s)
+{
+	if (!wait_for_completion_timeout(&s->ready, msecs_to_jiffies(5000)))
+		return -ETIMEDOUT;
+	return s->error;
+}
+
+static int neo_secure_probe(struct platform_device *pdev)
+{
+	struct neo_secure *s = devm_kzalloc(&pdev->dev, sizeof(*s), GFP_KERNEL);
+	int error;
+	if (!s) return -ENOMEM;
+	s->dev = &pdev->dev;
+	init_completion(&s->ready);
+	error = dma_set_mask_and_coherent(s->dev, DMA_BIT_MASK(42));
+	if (error) return error;
+	s->mbox = apple_mbox_get_byname(s->dev, "mbox");
+	if (IS_ERR(s->mbox)) return PTR_ERR(s->mbox);
+	s->wq = alloc_ordered_workqueue("neo-aop-second-host", WQ_MEM_RECLAIM);
+	if (!s->wq) return -ENOMEM;
+	s->mbox->rx = neo_secure_rx;
+	s->mbox->cookie = s;
+	error = devm_add_action_or_reset(s->dev, neo_secure_cleanup, s);
+	if (error) return error;
+	error = apple_mbox_start(s->mbox);
+	if (error) return error;
+	platform_set_drvdata(pdev, s);
+	dev_info(s->dev, "AOP second-host receiver armed\n");
+	return 0;
+}
+static const struct of_device_id neo_secure_of_match[] = {
+	{ .compatible = "apple,t8140-neo-aop-second-host" }, {}
+};
+MODULE_DEVICE_TABLE(of, neo_secure_of_match);
+static struct platform_driver neo_secure_driver = {
+	.probe = neo_secure_probe,
+	.driver = { .name = "neo-aop-second-host", .of_match_table = neo_secure_of_match },
+};
+module_platform_driver(neo_secure_driver);
+MODULE_LICENSE("GPL");
