+                    // (a conflicting PTE) quarantines the VM.
+                    vm.render_broken = error != ENOMEM && error != ENOSPC;
+                    return Err(error);
+                }
                 vm.compute_ready = true;
-                vm.render_broken = false;
             }
         }
         // Provision what this queue's or VM root's first publication would
diff --git a/drivers/gpu/drm/asahi/g16_runtime_compute.rs b/drivers/gpu/drm/asahi/g16_runtime_compute.rs
index aa159064a7b1..28e7380cc5e0 100644
--- a/drivers/gpu/drm/asahi/g16_runtime_compute.rs
+++ b/drivers/gpu/drm/asahi/g16_runtime_compute.rs
@@ -6,31 +6,21 @@
 use super::*;
 
 impl Bootstrap {
+    /// Give a VM's compute root its own FList before its first compute
+    /// command: `buffers` 2 MiB buffers plus the directory, mapped only into
+    /// this root, and an exclusively leased support object and hardware slot.
+    /// No other client's root can reach this pool's pages, and this root
+    /// reaches no other pool. ENOMEM/ENOSPC leave the root healthy: a retry
+    /// resumes the allocation.
     pub(crate) fn map_compute_work(
         &mut self,
         space: &mut g16_vm::AddressSpace,
         private: core::ops::Range<u64>,
+        buffers: usize,
     ) -> Result {
-        let opening = self._opening_client.as_mut().ok_or(EIO)?;
-        for (base, size) in compute::private_ranges() {
-            // Scratch and marker are private to each command at fresh VAs.
-            // Only the device-owned FList directory and spill pool are shared.
-            if base == compute::SCRATCH || base == compute::MARKER {
-                continue;
-            }
-            for va in (base..base + size as u64).step_by(0x4000) {
-                if space.low.translate(va)?.is_some() {
-                    return Err(EEXIST);
-                }
-                let pa = opening.low.translate(va)?.ok_or(EIO)?;
-                space.low.map_pages(
-                    va..va + 0x4000,
-                    pa,
-                    crate::pgtable::prot::PROT_GPU_SHARED_RW,
-                    false,
-                )?;
-            }
-        }
+        space.alloc_compute_pool(buffers)?;
+        let support = Arc::new(self.acquire_compute_support(buffers)?, GFP_KERNEL)?;
+        space.set_compute_support(support)?;
         space.init_compute_private(private);
         space.sync();
         Ok(())
@@ -167,6 +157,8 @@ pub(super) fn submit_compute_queue(
         }
         fw.zero_live(work + 0x2000, 0x2000)?;
         let mut a = compute::Addresses::publication(self.compute_publication, ordinal, work, alias);
+        let support = client.compute_support().ok_or(EIO)?;
+        a.support = support.address();
         a.queue = lane.queue;
         a.driver_stamp = work + 0x4000;
         a.firmware_stamp = lane.firmware_stamp();
@@ -196,12 +188,16 @@ pub(super) fn submit_compute_queue(
         // cache lines lost timestamps once the Work was reused.
         let user_timestamps = a.work + 0x4040;
         let count = self.compute_publication.wrapping_add(1);
-        let count32 = count as u32;
 
         let first = lane.head;
         let head = (first + 1 + dependencies.iter().flatten().count() as u32) % 0x500;
+        // The support's shared state counts every Work submitted against
+        // it (render items included, when compute shares the render pool).
+        let support = client.compute_support().ok_or(EIO)?;
+        let submitted = support.submissions.load(Ordering::Relaxed).wrapping_add(1);
         let fw = self._firmware_space.as_mut().ok_or(EIO)?;
-        fw.write_live(compute::SHARED_STATE, &count32.to_le_bytes())?;
+        fw.write_live(support.shared_state(), &(submitted as u32).to_le_bytes())?;
+        support.submissions.store(submitted, Ordering::Relaxed);
         fw.write_live(a.work, &self.encodings.compute)?;
         fw.write_live(a.work + compute::ENTRY_OFFSET, &compute::entry(params.cdm))?;
         let mut microsequence = params.microsequence(&a);
diff --git a/drivers/gpu/drm/asahi/g16_runtime_contexts.rs b/drivers/gpu/drm/asahi/g16_runtime_contexts.rs
index bc4db7998503..e77c17af666a 100644
--- a/drivers/gpu/drm/asahi/g16_runtime_contexts.rs
+++ b/drivers/gpu/drm/asahi/g16_runtime_contexts.rs
@@ -52,12 +52,13 @@ pub(crate) fn render_failed(&self) -> bool {
         self.render_failed
     }
 
-    /// `mode`: the VM's native mesh mode, latched when it was created.
-    pub(crate) fn acquire_render_support(&mut self, pool: &render::OperandPool, mode: g16_mesh::Mode) -> Result<Support> {
+    /// Lease a support object, its shared state page and hardware FList slot
+    /// 3 + index. Render pools and private compute pools share the leases, so
+    /// no two pools in use ever share a slot.
+    fn acquire_support_slot(&mut self, mode: g16_mesh::Mode) -> Result<Support> {
         if self.render_failed {
             return Err(EIO);
         }
-        let native = mode.enabled();
         let mut used = self.render_support.load(Ordering::Acquire);
         let index = loop {
             let index = (!used).trailing_zeros();
@@ -74,28 +75,46 @@ pub(crate) fn acquire_render_support(&mut self, pool: &render::OperandPool, mode
                 Err(value) => used = value,
             }
         };
-        let lease = Support {
+        Ok(Support {
             slots: self.render_support.clone(),
             index,
             submissions: AtomicU64::new(
                 crate::module_parameters::fw_counter_start.value().wrapping_mul(2),
             ),
-            native,
+            native: mode.enabled(),
             mode,
-        };
-        let mut a = render::Addresses::bootstrap();
-        a.support = lease.address();
-        a.render_shared_state = lease.shared_state();
+        })
+    }
+
+    /// Write a fresh support header (the rest of its page zero) and zero the
+    /// lease's shared state: a reused lease starts its submitted-Work count
+    /// afresh.
+    fn publish_support(&mut self, lease: &Support, header: &[u8; 0x100]) -> Result {
         let mut page = KVec::new();
         page.extend_with(0x4000, 0u8, GFP_KERNEL)?;
-        page[..0x100].copy_from_slice(&pool.support(3 + u64::from(index), a.render_shared_state));
+        page[..0x100].copy_from_slice(header);
+        let fw = self._firmware_space.as_mut().ok_or(EIO)?;
+        fw.write_live(lease.address(), &page)?;
+        fw.zero_live(lease.shared_state(), 0x4000)?;
+        Ok(())
+    }
+
+    /// `mode`: the VM's native mesh mode, latched when it was created.
+    pub(crate) fn acquire_render_support(&mut self, pool: &render::OperandPool, mode: g16_mesh::Mode) -> Result<Support> {
+        let lease = self.acquire_support_slot(mode)?;
+        let mut header = pool.support(3 + u64::from(lease.index), lease.shared_state());
         if lease.native {
-            render::initialize_native_support(&mut page[..0x100]);
+            render::initialize_native_support(&mut header);
         }
-        let fw = self._firmware_space.as_mut().ok_or(EIO)?;
-        fw.write_live(a.support, &page)?;
-        // A reused lease starts its submitted-Work count afresh.
-        fw.zero_live(a.render_shared_state, 0x4000)?;
+        self.publish_support(&lease, &header)?;
+        Ok(lease)
+    }
+
+    /// The support of a VM's private compute pool of `buffers` buffers.
+    pub(crate) fn acquire_compute_support(&mut self, buffers: usize) -> Result<Support> {
+        let lease = self.acquire_support_slot(g16_mesh::Mode::Disabled)?;
+        let header = compute::pool_support(3 + u64::from(lease.index), lease.shared_state(), buffers);
+        self.publish_support(&lease, &header)?;
         Ok(lease)
     }
 
