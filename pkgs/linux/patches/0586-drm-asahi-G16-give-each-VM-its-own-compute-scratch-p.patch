+
+    pub(crate) fn set_compute_support(&mut self, support: kernel::sync::Arc<crate::g16::Support>) -> Result {
+        if self.compute_support.is_some() {
+            return Err(EEXIST);
+        }
+        self.compute_support = Some(support);
