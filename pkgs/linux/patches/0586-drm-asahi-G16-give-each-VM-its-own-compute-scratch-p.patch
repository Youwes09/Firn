@@ -283,13 +286,36 @@ pub(super) fn submit(device: &RegDevice, _reg: &RegData<'_>, data: &mut uapi::dr
                     return Err(error);
                 }
                 vm.render_support = Some(support);
+                vm.render_pool = Some(pool);
