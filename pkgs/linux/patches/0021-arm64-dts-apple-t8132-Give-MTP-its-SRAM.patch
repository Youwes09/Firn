From 9f038af2153065bbbcafe3ca1a2444c95400b9cf Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Thu, 29 Oct 2026 01:01:57 -0500
Subject: [PATCH] arm64: dts: apple: t8132: Give MTP its SRAM

MTP's RTKit firmware asks for its buffers inside the helper's SRAM, the
second register range of the ADT's mtp node (0x194050000, 0x4000). With
only the ASC range, rtkit-helper refuses the request and the probe
fails, leaving the keyboard and trackpad dead.

The range is as in Omarchy-M4-Native's T8132 MTP node, by KB2UKA.

Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 arch/arm64/boot/dts/apple/t8132-mtp.dtsi | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-mtp.dtsi b/arch/arm64/boot/dts/apple/t8132-mtp.dtsi
index 812a054d06ddb..304a59e0a2231 100644
--- a/arch/arm64/boot/dts/apple/t8132-mtp.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-mtp.dtsi
@@ -11,8 +11,9 @@ &soc {
 	mtp: mtp@394600000 {
 		compatible = "apple,t8132-mtp", "apple,t8132-rtk-helper-asc4",
 			     "apple,mtp", "apple,rtk-helper-asc4";
-		reg = <0x3 0x94600000 0x0 0x4000>;
-		reg-names = "asc";
+		reg = <0x3 0x94600000 0x0 0x4000>,
+		      <0x3 0x94050000 0x0 0x4000>;
+		reg-names = "asc", "sram";
 		mboxes = <&mtp_mbox>;
 		iommus = <&mtp_dart 0>;
 		#helper-cells = <0>;
