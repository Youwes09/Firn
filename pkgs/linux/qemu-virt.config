# What QEMU's virt machine needs on top of the J713 configuration, for the
# T2 boot test only (j713-vm.config). Built in, since the initrd carries no
# modules for them.

# Interrupt controller and console
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# Root and EFI disks: -drive if=virtio is virtio-blk on PCI
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
