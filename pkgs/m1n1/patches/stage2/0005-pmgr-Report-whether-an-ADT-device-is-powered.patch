From 5396e47c8fe408309819cd996ae41ec5608a91cc Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Fri, 30 Oct 2026 01:33:34 -0500
Subject: [PATCH] pmgr: Report whether an ADT device is powered

pmgr_adt_power_is_active() lets a caller power a device only if it is
off and leave it as it was found. Like pmgr_set_mode_recursive(), it
follows each gate's parents: on T8132, dart-ane's gates are virtual,
under an ANE_SYS that is off at boot.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 src/pmgr.c | 47 +++++++++++++++++++++++++++++++++++++++++++++++
 src/pmgr.h |  1 +
 2 files changed, 48 insertions(+)

diff --git a/src/pmgr.c b/src/pmgr.c
index 921a9da..4bac2cf 100644
--- a/src/pmgr.c
+++ b/src/pmgr.c
@@ -287,6 +287,53 @@ int pmgr_adt_power_disable_index(const char *path, u32 index)
     return pmgr_adt_device_set_mode(path, index, PMGR_PS_PWRGATE, false);
 }
 
+/* A device is active when it and its parents are. A virtual device has no state of its own. */
+static int pmgr_is_active_recursive(u8 die, u16 id)
+{
+    const struct pmgr_device *device;
+
+    if (pmgr_find_device(id, &device))
+        return -1;
+
+    if (!(device->flags & PMGR_FLAG_VIRTUAL)) {
+        uintptr_t addr = pmgr_device_get_addr(die, device);
+        if (!addr)
+            return -1;
+        if (FIELD_GET(PMGR_PS_ACTUAL, read32(addr)) != PMGR_PS_ACTIVE)
+            return 0;
+    }
+
+    u16 parents[2];
+    pmgr_adt_get_parents(device, parents);
+    for (int i = 0; i < 2; i++) {
+        if (parents[i]) {
+            int ret = pmgr_is_active_recursive(die, parents[i]);
+            if (ret <= 0)
+                return ret;
+        }
+    }
+
+    return 1;
+}
+
+int pmgr_adt_power_is_active(const char *path)
+{
+    const u32 *devices;
+    u32 n_devices;
+
+    if (pmgr_adt_find_devices(path, &devices, &n_devices) < 0)
+        return -1;
+
+    for (u32 i = 0; i < n_devices; ++i) {
+        int ret = pmgr_is_active_recursive(FIELD_GET(PMGR_DIE_ID, devices[i]),
+                                           FIELD_GET(PMGR_DEVICE_ID, devices[i]));
+        if (ret <= 0)
+            return ret;
+    }
+
+    return 1;
+}
+
 static int pmgr_reset_device(int die, const struct pmgr_device *dev)
 {
     if (die < 0 || die > 16) {
diff --git a/src/pmgr.h b/src/pmgr.h
index e0f8195..8542936 100644
--- a/src/pmgr.h
+++ b/src/pmgr.h
@@ -23,6 +23,7 @@ int pmgr_adt_power_enable(const char *path);
 int pmgr_adt_power_disable(const char *path);
 int pmgr_adt_power_enable_index(const char *path, u32 index);
 int pmgr_adt_power_disable_index(const char *path, u32 index);
+int pmgr_adt_power_is_active(const char *path);
 int pmgr_adt_reset(const char *path);
 
 int pmgr_reset(int die, const char *name);
