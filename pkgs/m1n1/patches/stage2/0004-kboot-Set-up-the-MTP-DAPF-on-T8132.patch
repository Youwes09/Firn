From 4303b542c11512da6f71f9e9eca62e4b794c3c79 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Thu, 29 Oct 2026 08:46:50 -0500
Subject: [PATCH] kboot: Set up the MTP DAPF on T8132

DAPF init is skipped on T8132 because it raises an SError, but without
its DAPF the MTP firmware cannot reach the peripherals it drives: the
DART reports a SID exception as soon as the MTP starts, and RTKit never
gets a HELLO. Initialise the MTP's DAPF on its own.
---
 src/kboot.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/kboot.c b/src/kboot.c
index 0b28d16..2a3e5a4 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -2898,9 +2898,14 @@ int kboot_boot(void *kernel)
 
     usb_init();
     pcie_init();
-    /* HACK: DAPF init raises an SError on T8132. */
+    /*
+     * HACK: DAPF init raises an SError on T8132, but the MTP cannot reach
+     * its peripherals without its DAPF, so set that one up alone.
+     */
     if (chip_id != T8132)
         dapf_init_all();
+    else
+        dapf_init("/arm-io/dart-mtp", 1);
 
     printf("Setting SMP mode to WFE...\n");
     smp_set_wfe_mode(true);
-- 
2.54.0

