From fbf3775d0b1a238521821d1d385d148485128aa8 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Wed, 28 Oct 2026 21:13:32 -0500
Subject: [PATCH] kboot: Reserve the trust cache

On t8132 (M4), the trust cache that iBoot lists in /chosen/memory-map
lies inside the usable RAM range handed to the kernel, so Linux may
allocate from and write to it.

Add a /memreserve/ entry for it, so the kernel keeps it mapped but never
allocates from it. Where the trust cache is outside the usable range the
entry has no effect.
---
 src/kboot.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/kboot.c b/src/kboot.c
index c5ed848..7b8585b 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -2787,6 +2787,15 @@ int kboot_prepare_dt(void *fdt)
     if (fdt_add_mem_rsv(dt, (u64)_base, ((u64)_end) - ((u64)_base)))
         bail("FDT: couldn't add reservation for m1n1\n");
 
+    // On M4, iBoot leaves the trust cache inside the usable RAM range.
+    int anode_mmap = adt_path_offset(adt, "/chosen/memory-map");
+    u64 trust_cache[2];
+    if (anode_mmap >= 0 &&
+        ADT_GETPROP_ARRAY(adt, anode_mmap, "TrustCache", trust_cache) == sizeof(trust_cache)) {
+        if (fdt_add_mem_rsv(dt, trust_cache[0], trust_cache[1]))
+            bail("FDT: couldn't add reservation for the trust cache\n");
+    }
+
     /* setup console log buffer early to capture as much log as possible */
     dt_setup_mtd_phram();
 
