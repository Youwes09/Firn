From 6e0c25e1acd105645bb971a4402bdc1ccf93f50b Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Fri, 30 Oct 2026 01:34:51 -0500
Subject: [PATCH] dapf: Skip a DAPF that has no filter data

On T8132, T8142 and T8152, dart-ave has a DAPF but lists no filter
data, so there is nothing to write, yet it was reported as an error.
Look the data up before powering the device and skip the DAPF if there
is none.

Assisted-By: LLM
Signed-off-by: Youwes09 <yuvi.shen@outlook.com>
---
 src/dapf.c | 84 ++++++++++++++++++++++++++++--------------------------
 1 file changed, 44 insertions(+), 40 deletions(-)

diff --git a/src/dapf.c b/src/dapf.c
index ae7f3aa..ea06cde 100644
--- a/src/dapf.c
+++ b/src/dapf.c
@@ -19,14 +19,12 @@ struct dapf_t8020_config {
     u32 r4;
 } PACKED;
 
-static int dapf_init_t8020(const char *path, u64 base, int node)
+static int dapf_init_t8020(const char *path, u64 base, const void *data, u32 length)
 {
-    u32 length = 0;
-    const char *prop = "filter-data-instance-0";
-    const struct dapf_t8020_config *config = adt_getprop(adt, node, prop, &length);
+    const struct dapf_t8020_config *config = data;
 
-    if (!config || !length || (length % sizeof(*config)) != 0) {
-        printf("dapf: Error getting ADT node %s property %s.\n", path, prop);
+    if ((length % sizeof(*config)) != 0) {
+        printf("dapf: Invalid filter data length for %s\n", path);
         return -1;
     }
 
@@ -99,27 +97,8 @@ static int dapf_init_t8110b(u64 base, struct dapf_t8110b_config *config, u32 len
     return 0;
 }
 
-static int dapf_init_t8110(const char *path, u64 base, int node)
+static int dapf_init_t8110(const char *path, u64 base, const void *config, u32 length)
 {
-    u32 length = 0;
-    char prop[32];
-    const void *config = NULL;
-
-    // The dapf config is not always under instance 0; find the first present
-    // dapf-instance-N.
-    for (int i = 0; i < 8; i++) {
-        snprintf(prop, sizeof(prop), "dapf-instance-%d", i);
-        length = 0;
-        config = adt_getprop(adt, node, prop, &length);
-        if (config && length)
-            break;
-    }
-
-    if (!config || !length) {
-        printf("dapf: Error getting ADT node %s dapf-instance property.\n", path);
-        return -1;
-    }
-
     // The least common multiple of 52 and 56 is 728 which is in the range of
     // the observed lengthe for "dapf-instance-0". The 52 byte variant is more
     // common and prefering that works so far.
@@ -128,11 +107,27 @@ static int dapf_init_t8110(const char *path, u64 base, int node)
     } else if (length % sizeof(struct dapf_t8110b_config) == 0) {
         return dapf_init_t8110b(base, (struct dapf_t8110b_config *)config, length);
     } else {
-        printf("dapf: Invalid length for %s property %s\n", path, prop);
+        printf("dapf: Invalid filter data length for %s\n", path);
         return -1;
     }
 }
 
+/* dart,t8110 keeps its filter data in the first dapf-instance-N present. */
+static const void *dapf_filter_data(int node, u32 *length)
+{
+    if (!adt_is_compatible(adt, node, "dart,t8110"))
+        return adt_getprop(adt, node, "filter-data-instance-0", length);
+
+    for (int i = 0; i < 8; i++) {
+        char prop[32];
+        snprintf(prop, sizeof(prop), "dapf-instance-%d", i);
+        const void *data = adt_getprop(adt, node, prop, length);
+        if (data && *length)
+            return data;
+    }
+    return NULL;
+}
+
 int dapf_init(const char *path, int index)
 {
     int ret;
@@ -143,29 +138,38 @@ int dapf_init(const char *path, int index)
         return -1;
     }
 
-    u32 pwr;
-    if (!adt_getprop(adt, node, "clock-gates", &pwr))
-        pwr = 0;
-    if (pwr && (pmgr_adt_power_enable(path) < 0))
-        return -1;
-
     u64 base;
     if (adt_get_reg(adt, dart_path, "reg", index, &base, NULL) < 0) {
         printf("dapf: Error getting DAPF %s base address.\n", path);
         return -1;
     }
 
-    if (adt_is_compatible(adt, node, "dart,t8020")) {
-        ret = dapf_init_t8020(path, base, node);
-    } else if (adt_is_compatible(adt, node, "dart,t6000")) {
-        ret = dapf_init_t8020(path, base, node);
-    } else if (adt_is_compatible(adt, node, "dart,t8110")) {
-        ret = dapf_init_t8110(path, base, node);
-    } else {
+    bool t8110 = adt_is_compatible(adt, node, "dart,t8110");
+    if (!t8110 && !adt_is_compatible(adt, node, "dart,t8020") &&
+        !adt_is_compatible(adt, node, "dart,t6000")) {
         printf("dapf: DAPF %s at 0x%lx is of an unknown type\n", path, base);
         return -1;
     }
 
+    /* M4-generation SoCs list no filter data for dart-ave's DAPF. */
+    u32 length = 0;
+    const void *data = dapf_filter_data(node, &length);
+    if (!data || !length) {
+        printf("dapf: %s has no filter data\n", path);
+        return 0;
+    }
+
+    u32 pwr;
+    if (!adt_getprop(adt, node, "clock-gates", &pwr))
+        pwr = 0;
+    if (pwr && (pmgr_adt_power_enable(path) < 0))
+        return -1;
+
+    if (t8110)
+        ret = dapf_init_t8110(path, base, data, length);
+    else
+        ret = dapf_init_t8020(path, base, data, length);
+
     if (pwr)
         pmgr_adt_power_disable(path);
 
