+static nir_builder
+external_image_shader(glsl_sampler_dim dim, bool array = false,
+                      unsigned coordinates = 2, unsigned binding = 3)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_FRAGMENT, &agx_nir_options, "external_image");
+   nir_variable *sampler = nir_variable_create(b.shader, nir_var_uniform,
+      glsl_sampler_type(dim, false, false, GLSL_TYPE_FLOAT), "external");
+   sampler->data.binding = binding;
+   nir_tex_instr *tex = nir_tex_instr_create(b.shader, 1);
+   tex->op = nir_texop_tex;
+   tex->sampler_dim = dim;
+   tex->is_array = array;
+   tex->dest_type = nir_type_float32;
+   tex->coord_components = coordinates;
+   tex->texture_index = binding;
+   tex->sampler_index = binding;
+   tex->src[0].src_type = nir_tex_src_coord;
+   tex->src[0].src = nir_src_for_ssa(coordinates == 2
+      ? nir_imm_vec2(&b, .375, .875)
+      : nir_imm_vec3(&b, .375, .875, .5));
+   nir_def_init(&tex->instr, &tex->def, 4, 32);
+   nir_builder_instr_insert(&b, &tex->instr);
+   nir_store_output(&b, &tex->def, nir_imm_int(&b, 0),
+      .write_mask = 15, .src_type = nir_type_float32,
+      .io_semantics = {.location = FRAG_RESULT_DATA0, .num_slots = 1});
+   b.shader->info.io_lowered = true;
+   return b;
+}
+
+TEST(Apple9Compiler, ExternalRgbMatchesOrdinary2D)
+{
+   std::vector<uint8_t> reference;
+   for (auto dim : {GLSL_SAMPLER_DIM_2D, GLSL_SAMPLER_DIM_EXTERNAL}) {
+      SCOPED_TRACE(dim);
+      nir_builder b = external_image_shader(dim);
+      agx_shader_part compiled = {};
+      const char *reason = nullptr;
+      ASSERT_TRUE(agx_compile_apple9_fragment(b.shader, &compiled, &reason))
+         << (reason ?: "");
+      EXPECT_EQ(compiled.info.apple9_texture_mask, 1u << 3);
+      EXPECT_EQ(compiled.info.apple9_sampler_mask, 1u << 3);
+      const auto *code = static_cast<const uint8_t *>(compiled.binary);
+      std::vector<uint8_t> actual(code, code + compiled.info.binary_size);
+      if (dim == GLSL_SAMPLER_DIM_2D)
+         reference = actual;
+      else
+         EXPECT_EQ(actual, reference);
+      free(compiled.binary);
+      ralloc_free(b.shader);
+   }
+}
+
+TEST(Apple9Compiler, ExternalNv12UsesRealPlaneLowering)
+{
+   for (bool full_range : {false, true}) {
+      nir_builder b = external_image_shader(GLSL_SAMPLER_DIM_EXTERNAL);
+      nir_lower_tex_options options = {};
+      options.lower_y_uv_external = 1u << 3;
+      options.bt709_external = 1u << 3;
+      options.yuv_full_range_external = full_range ? 1u << 3 : 0;
+      ASSERT_TRUE(nir_lower_tex(b.shader, &options));
+      ASSERT_TRUE(st_nir_lower_tex_src_plane(b.shader, 1u << 7, 1u << 3, 0));
+      nir_opt_dce(b.shader);
+      unsigned samples = 0;
+      nir_foreach_block(block, nir_shader_get_entrypoint(b.shader)) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_tex)
+               continue;
+            nir_tex_instr *tex = nir_instr_as_tex(instr);
+            EXPECT_EQ(tex->sampler_dim, GLSL_SAMPLER_DIM_2D);
+            EXPECT_LT(nir_tex_instr_src_index(tex, nir_tex_src_plane), 0);
+            EXPECT_TRUE(tex->texture_index == 3 || tex->texture_index == 7);
+            ++samples;
+         }
+      }
+      EXPECT_EQ(samples, 2u);
+      agx_shader_part compiled = {};
+      const char *reason = nullptr;
+      ASSERT_TRUE(agx_compile_apple9_fragment(b.shader, &compiled, &reason))
+         << (reason ?: "");
+      EXPECT_EQ(compiled.info.apple9_texture_mask, (1u << 3) | (1u << 7));
+      EXPECT_EQ(compiled.info.apple9_sampler_mask, (1u << 3) | (1u << 7));
+      free(compiled.binary);
+      ralloc_free(b.shader);
+   }
+}
+
+TEST(Apple9Compiler, ExternalSizeAndFetchMatchOrdinary2D)
+{
+   for (auto op : {nir_texop_txs, nir_texop_txf}) {
+      SCOPED_TRACE(op);
+      std::vector<uint8_t> reference;
+      for (auto dim : {GLSL_SAMPLER_DIM_2D, GLSL_SAMPLER_DIM_EXTERNAL}) {
+         nir_builder b = nir_builder_init_simple_shader(
+            MESA_SHADER_FRAGMENT, &agx_nir_options, "external_query_fetch");
+         bool query = op == nir_texop_txs;
+         nir_tex_instr *tex = nir_tex_instr_create(b.shader, query ? 1 : 2);
+         tex->op = op;
+         tex->sampler_dim = dim;
+         tex->dest_type = query ? nir_type_int32 : nir_type_float32;
+         tex->coord_components = query ? 0 : 2;
+         tex->texture_index = tex->sampler_index = 3;
+         tex->src[0] = nir_tex_src_for_ssa(nir_tex_src_lod, nir_imm_int(&b, 0));
+         if (!query)
+            tex->src[1] = nir_tex_src_for_ssa(nir_tex_src_coord,
+                                           nir_imm_ivec2(&b, 2, 3));
+         nir_def_init(&tex->instr, &tex->def, query ? 2 : 4, 32);
+         nir_builder_instr_insert(&b, &tex->instr);
+         nir_def *rgba = query
+            ? nir_vec4(&b, nir_i2f32(&b, nir_channel(&b, &tex->def, 0)),
+               nir_i2f32(&b, nir_channel(&b, &tex->def, 1)),
+               nir_imm_float(&b, 0), nir_imm_float(&b, 1)) : &tex->def;
+         nir_store_output(&b, rgba, nir_imm_int(&b, 0),
+            .write_mask = 15, .src_type = nir_type_float32,
+            .io_semantics = {.location = FRAG_RESULT_DATA0, .num_slots = 1});
+         b.shader->info.io_lowered = true;
+         agx_shader_part compiled = {};
+         const char *reason = nullptr;
+         ASSERT_TRUE(agx_compile_apple9_fragment(b.shader, &compiled, &reason))
+            << (reason ?: "");
+         if (!query) {
+            EXPECT_EQ(compiled.info.apple9_texture_mask, 1u << 3);
+            EXPECT_EQ(compiled.info.apple9_sampler_mask, 0u);
+         }
+         const auto *code = static_cast<const uint8_t *>(compiled.binary);
+         std::vector<uint8_t> actual(code, code + compiled.info.binary_size);
+         if (dim == GLSL_SAMPLER_DIM_2D)
+            reference = actual;
+         else
+            EXPECT_EQ(actual, reference);
+         free(compiled.binary);
+         ralloc_free(b.shader);
+      }
+   }
+}
+
+TEST(Apple9Compiler, ExternalMalformedShapesStayRejected)
+{
+   for (unsigned which = 0; which < 4; ++which) {
+      SCOPED_TRACE(which);
+      nir_builder b = external_image_shader(GLSL_SAMPLER_DIM_EXTERNAL,
+         which == 0, which == 1 ? 3 : 2, which == 2 ? 32 : 3);
+      if (which == 3) {
+         nir_foreach_block(block, nir_shader_get_entrypoint(b.shader)) {
+            nir_foreach_instr(instr, block) {
+               if (instr->type == nir_instr_type_tex)
+                  nir_instr_as_tex(instr)->is_shadow = true;
+            }
+         }
+      }
+      agx_shader_part compiled = {};
+      const char *reason = nullptr;
+      EXPECT_FALSE(agx_compile_apple9_fragment(b.shader, &compiled, &reason));
+      EXPECT_NE(reason, nullptr);
+      free(compiled.binary);
+      ralloc_free(b.shader);
+   }
+}
