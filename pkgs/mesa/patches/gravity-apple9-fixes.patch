+/* External images use ordinary normalized 2D descriptors, as in agx_tex_dim.
+ * Mesa's YUV lowering has already split multiplanar images into 2D samples;
+ * this handles external RGB images that retain the external dimension.
+ * Leave malformed array, shadow, and coordinate shapes for normal rejection.
+ */
+static bool
+apple9_lower_external(UNUSED nir_builder *b, nir_instr *instr, UNUSED void *data)
+{
+   if (instr->type != nir_instr_type_tex)
+      return false;
+
+   nir_tex_instr *tex = nir_instr_as_tex(instr);
+   if (tex->sampler_dim != GLSL_SAMPLER_DIM_EXTERNAL || tex->is_array ||
+       tex->is_shadow)
+      return false;
+
+   bool size_query = tex->op == nir_texop_txs && tex->coord_components == 0;
+   if (!size_query && tex->coord_components != 2)
+      return false;
+
+   tex->sampler_dim = GLSL_SAMPLER_DIM_2D;
+   return true;
+}
+
 static void
 apple9_lower_textures(nir_shader *nir)
 {
    nir_lower_samplers(nir);
+   nir_shader_instructions_pass(nir, apple9_lower_external,
+                                nir_metadata_control_flow, NULL);
    /* Compatibility GL supplies projective texture coordinates. Reuse the
     * common NIR quotient lowering before selecting ordinary 2D sampling. */
    const nir_lower_tex_options tex_options = {
