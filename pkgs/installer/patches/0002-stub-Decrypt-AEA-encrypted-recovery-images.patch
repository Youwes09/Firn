@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: MIT
+"""Decrypt the AEA-encrypted recovery image of macOS 26 restore images.
+
+From macOS 26 the restore image's BaseSystem is an Apple Encrypted Archive.
+Apple publishes each archive's key on its public key server
+(https://wkms-public.apple.com/fcs-keys/); the keys below were fetched from
+there. Only images listed here are accepted, with both the encrypted and the
+decrypted bytes pinned, so a new restore image is added deliberately.
+"""
+from contextlib import contextmanager
+import hashlib, logging, os, shutil, subprocess, tempfile, zlib
+from pathlib import Path
+
+from util import *
+
+IMAGES = {
+    ("26.5.1", "022-21678-093.dmg.aea"): {
+        "encrypted_sha256": "12919ca28b831ec9ff71291ac857a51cef54263f4846180c7b7311a58c51d13e",
+        "decrypted_sha256": "c7e05c0261a687b256c9ee58341346fbb995dfd04f03affd874524e6bc2e615d",
+        "key": "base64:jwTzZTlYzWR0hJi0ISUdhMp39bmqC112h34G5qV6PDM=",
+    },
+}
+
+AEA = "/usr/bin/aea"
+# The archive and the decrypted image are both held at once.
+MIN_FREE = 4 << 30
+
+def checksums(path):
+    digest = hashlib.sha256()
+    crc = 0
+    with open(path, "rb") as fd:
+        while block := fd.read(1 << 20):
+            digest.update(block)
+            crc = zlib.crc32(block, crc)
+    return digest.hexdigest(), crc
+
+@contextmanager
+def mounted(image):
+    with tempfile.TemporaryDirectory(prefix="recovery-mount-") as mount:
+        subprocess.run(["hdiutil", "attach", "-quiet", "-readonly", "-nobrowse",
+                        "-mountpoint", mount, str(image)], check=True)
+        try:
+            yield Path(mount)
+        finally:
+            subprocess.run(["hdiutil", "detach", "-quiet", mount], check=True)
+
+class RecoveryImage:
+    """The decrypted recovery image of one restore image, in a temporary directory."""
+
+    def __init__(self, pkg, member, version):
+        image = IMAGES.get((version, member))
+        if image is None:
+            raise Exception(f"Unknown encrypted recovery image {member} for macOS {version}")
+        if not os.access(AEA, os.X_OK):
+            raise Exception(f"This recovery image needs {AEA} to decrypt it")
+        if shutil.disk_usage(tempfile.gettempdir()).free < MIN_FREE:
+            raise Exception(f"Decrypting the recovery image needs {ssize(MIN_FREE)} free")
+
+        self.tmpdir = tempfile.TemporaryDirectory(prefix="recovery-")
+        try:
+            root = Path(self.tmpdir.name)
+            encrypted = root / "BaseSystem.dmg.aea"
+            self.path = root / "BaseSystem.dmg"
+
+            logging.info(f"Copying {member}")
+            with pkg.open(member) as src, open(encrypted, "xb") as dst:
+                shutil.copyfileobj(src, dst, 1 << 20)
+            if checksums(encrypted)[0] != image["encrypted_sha256"]:
+                raise Exception(f"{member} does not match its pinned SHA-256")
+
+            # The key goes in a file so that it is not in the process list.
+            key = root / "key"
+            key.write_text(image["key"])
+            key.chmod(0o600)
+            logging.info(f"Decrypting {member}")
+            subprocess.run([AEA, "decrypt", "-i", str(encrypted), "-o", str(self.path),
+                            "-key", str(key)], check=True)
+            key.unlink()
+            encrypted.unlink()
+
+            digest, self.crc = checksums(self.path)
+            if digest != image["decrypted_sha256"]:
+                raise Exception(f"Decrypted {member} does not match its pinned SHA-256")
+            self.size = self.path.stat().st_size
+        except BaseException:
+            self.close()
+            raise
+
+    def close(self):
+        self.tmpdir.cleanup()
