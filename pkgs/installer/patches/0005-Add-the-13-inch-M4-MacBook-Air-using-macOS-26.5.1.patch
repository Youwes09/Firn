From 58b70734b2a12f06be331b50fa10e45d2d27c77e Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Tue, 27 Oct 2026 22:02:07 -0500
Subject: [PATCH 5/8] Add the 13-inch M4 MacBook Air using macOS 26.5.1

Add stub support for the J713 (MacBook Air, 13-inch, M4, 2025) with the
macOS 26.5.1 (25F80) restore image, whose OS firmware is
mBoot-18000.120.36. The M4 shipped too late for any restore image the
installer knows.

The restore image's RestoreLongVersion is 25.6.80.0.0,0. Its firmware
version uses Apple's mBoot- prefix, which split_ver() orders after every
iBoot- version and compares numerically against other mBoot- versions,
so the existing minimum checks work unchanged.

Installing from this image needs the earlier changes for macOS 26
restore images: no RestoreBundlePath, an encrypted recovery image, and
the moved Wi-Fi firmware.
---
 src/main.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/main.py b/src/main.py
index 3ffc744..98d5c06 100644
--- a/src/main.py
+++ b/src/main.py
@@ -49,6 +49,7 @@ CHIP_MIN_VER = {
     0x6030: "14.8.3",   # T6030, M3 Pro
     0x6031: "14.8.3",   # T6031, M3 Max (16-core)
     0x6034: "14.8.3",   # T6034, M3 Max (14-core)
+    0x8132: "26.5.1",   # T8132, M4
 }
 
 DEVICES = {
@@ -86,6 +87,7 @@ DEVICES = {
     "j516sap":  Device("14.8.3", False), # MacBook Pro (16-inch, M3 Pro, 2023)
     "j516cap":  Device("14.8.3", False), # MacBook Pro (16-inch, M3 Max, 2023)
     "j516map":  Device("14.8.3", False), # MacBook Pro (16-inch, M3 Max, 2023)
+    "j713ap":   Device("26.5.1", False), # MacBook Air (13-inch, M4, 2025)
 }
 
 # Asahi Linux does not support running in a virtual machine, this option
@@ -123,6 +125,13 @@ IPSW_VERSIONS = [
          False,
          ["j433ap", "j434ap", "j504ap", "j613ap", "j615ap", "j514sap", "j514cap", "j514map", "j516sap", "j516cap", "j516map"],
          "https://updates.cdn-apple.com/2025FallFCS/patches/089-71124/49AD260A-D47F-4B5E-A793-30446187196E/com_apple_MobileAsset_MacSoftwareUpdate/f6d1ac9149f6a06401ff87fae5b262c420bfc5f7.zip"),
+    IPSW("26.5.1",
+         "26.5.1",
+         "mBoot-18000.120.36",
+         "25.6.80.0.0,0",
+         False,
+         ["j713ap"],
+         "https://updates.cdn-apple.com/2026SpringFCS/fullrestores/122-88870/E47EBB85-45F2-4E3C-B9E7-6FF7868C2FBA/UniversalMac_26.5.1_25F80_Restore.ipsw"),
 ]
 
 class InstallerMain:
