From 0954a3080d7b3fdacec04e02ee83d19ce96ba248 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Tue, 27 Oct 2026 21:53:59 -0500
Subject: [PATCH 1/8] stub: Allow restore images without RestoreBundlePath

The macOS 26.5.1 restore image's bootcaches.plist has no RestoreBundlePath
in its bless2 dictionary, so installing a stub from it fails with a
KeyError. Its Preboot keeps the restore bundle in <VGID>/restore.

Look the path up in one place, and fall back to a per-version table for
images known to omit it. Any other image without the key still fails, now
with a message naming the version.

The missing key and the fallback directory were found by the Gravity Linux
installer (MIT) as shipped by Omarchy-M4-Native.
---
 src/stub.py | 23 ++++++++++++++++++-----
 1 file changed, 18 insertions(+), 5 deletions(-)

diff --git a/src/stub.py b/src/stub.py
index 93cacff..f0b85fe 100644
--- a/src/stub.py
+++ b/src/stub.py
@@ -245,6 +245,20 @@ class StubInstaller(PackageInstaller):
         manifest["BuildIdentities"] = [identity]
         return identity
 
+    # Restore images whose bootcaches.plist has no RestoreBundlePath, with the
+    # Preboot directory macOS uses for them instead.
+    RESTORE_BUNDLE_PATHS = {
+        "26.5.1": "restore",
+    }
+
+    def restore_bundle_path(self):
+        bless2 = self.bootcaches["bless2"]
+        if "RestoreBundlePath" in bless2:
+            return bless2["RestoreBundlePath"]
+        if self.install_version in self.RESTORE_BUNDLE_PATHS:
+            return self.RESTORE_BUNDLE_PATHS[self.install_version]
+        raise Exception(f"No RestoreBundlePath for macOS {self.install_version}")
+
     def install_files(self, cur_os):
         logging.info("StubInstaller.install_files()")
         logging.info(f"VGID: {self.osi.vgid}")
@@ -299,9 +313,9 @@ class StubInstaller(PackageInstaller):
 
         os.makedirs(self.pb_vgid, exist_ok=True)
 
-        bless2 = self.bootcaches["bless2"]
+        restore_bundle_path = self.restore_bundle_path()
 
-        restore_bundle = os.path.join(self.pb_vgid, bless2["RestoreBundlePath"])
+        restore_bundle = os.path.join(self.pb_vgid, restore_bundle_path)
         os.makedirs(restore_bundle, exist_ok=True)
         restore_manifest = os.path.join(restore_bundle, "BuildManifest.plist")
         with open(restore_manifest, "wb") as fd:
@@ -342,7 +356,7 @@ class StubInstaller(PackageInstaller):
 
         # This is a workaround for some screwiness in the macOS <12.0 bootability
         # code, which ends up putting the apticket in the wrong volume...
-        sys_restore_bundle = os.path.join(self.osi.system, bless2["RestoreBundlePath"])
+        sys_restore_bundle = os.path.join(self.osi.system, restore_bundle_path)
         if os.path.lexists(sys_restore_bundle):
             os.unlink(sys_restore_bundle)
         os.symlink(restore_bundle, sys_restore_bundle)
@@ -408,8 +422,7 @@ class StubInstaller(PackageInstaller):
             shutil.rmtree("fud_firmware")
 
         os.makedirs("fud_firmware", exist_ok=True)
-        bless2 = self.bootcaches["bless2"]
-        restore_bundle = os.path.join(self.pb_vgid, bless2["RestoreBundlePath"])
+        restore_bundle = os.path.join(self.pb_vgid, self.restore_bundle_path())
         copied = set()
         kernel_path = None
         for identity in [self.identity]:
