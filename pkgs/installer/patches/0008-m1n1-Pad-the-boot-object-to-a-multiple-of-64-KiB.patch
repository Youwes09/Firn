From 808d0c8152397b130417ede02d91a82fcb691890 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Tue, 27 Oct 2026 22:05:22 -0500
Subject: [PATCH 8/8] m1n1: Pad the boot object to a multiple of 64 KiB

On the T8132 (M4) the boot policy tools register stage 1 only when the
boot object, including m1n1's variables, is a multiple of 64 KiB.

Pad it with zeros. m1n1 ends its payload and variable parsing at four
zero bytes, which the variables already end with, so the padding changes
nothing it reads.

The requirement comes from the Gravity Linux installer (MIT) as shipped
by Omarchy-M4-Native, whose installs registered padded boot objects on
the J713. It has not been reproduced here.
---
 src/m1n1.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/m1n1.py b/src/m1n1.py
index bd0d1e4..e099d86 100644
--- a/src/m1n1.py
+++ b/src/m1n1.py
@@ -7,8 +7,13 @@ def build(src, dest, vars):
     with open(src, "rb") as fd:
         m1n1_data = fd.read()
 
+    # The T8132 boot policy only registers a boot object whose size is a
+    # multiple of 64 KiB. m1n1 stops at the zero padding as at the end of vars.
+    data = m1n1_data + vars
+    data += bytes(-len(data) % (64 << 10))
+
     with open(dest, "wb") as fd:
-        fd.write(m1n1_data + vars)
+        fd.write(data)
 
 def extract_vars(src):
     with open(src, "rb") as fd:
