From bce12bc1dbdc359356c184ecc7cadd8c6ebe4ea9 Mon Sep 17 00:00:00 2001
From: Youwes09 <yuvi.shen@outlook.com>
Date: Tue, 27 Oct 2026 22:00:23 -0500
Subject: [PATCH 3/8] asahi_firmware.wifi: Read the firmware layout of macOS 26

macOS 26 keeps the Wi-Fi firmware in the WLAN driver extension
(com.apple.DriverKit-AppleBCMWLAN.dext/Firmware). Three things there stop
the collector:

- TrustedSHAInformation.txt, a list of firmware hashes, sits beside the
  firmware and is parsed as a firmware name;
- 74 files for 4388 C0 modules carry a new F property (F-bb), which trips
  the assertion that every property is known;
- the C-4388__s-C2 directory is always skipped because the 14.6.1 IPSW's
  copy is broken, but the M4 machines' modules are 4388 C2.

Skip the hash list, log and skip files with unknown properties instead of
guessing how Linux would name them, and let the caller choose which
directories to skip. The default keeps skipping the broken directory, so
existing callers are unchanged.

On the macOS 26.5.1 (25F80) recovery image this yields 542 files from
the extension, including the J713's
brcm/brcmfmac4388c2-pcie.apple,garden{.bin,.clm_blob,.txcap_blob,.sig,
-WLMT-a.txt,-WLMT-u.txt} and its antenna variants, the names the J713's
brcmfmac requests.
---
 asahi_firmware/wifi.py | 26 +++++++++++++++++++-------
 1 file changed, 19 insertions(+), 7 deletions(-)

diff --git a/asahi_firmware/wifi.py b/asahi_firmware/wifi.py
index af5abee..cd1af06 100644
--- a/asahi_firmware/wifi.py
+++ b/asahi_firmware/wifi.py
@@ -34,20 +34,25 @@ class WiFiFWCollection(object):
         "sig": "sig",
     }
     DIMS = ["C", "s", "P", "M", "V", "m", "A"]
-    def __init__(self, source_path):
+    # The firmware directory in the 14.6.1 IPSW's usr/share/firmware/wifi is
+    # broken. macOS 26's WLAN driver extension has a working one, which the
+    # M4 machines need.
+    BROKEN_DIRS = ("C-4388__s-C2",)
+
+    def __init__(self, source_path, skip_dirs=BROKEN_DIRS):
         self.root = FWNode()
-        self.load(source_path)
+        self.load(source_path, skip_dirs)
         self.prune()
 
-    def load(self, source_path):
+    def load(self, source_path, skip_dirs):
         for dirpath, dirnames, filenames in os.walk(source_path):
             if "perf" in dirnames:
                 dirnames.remove("perf")
             if "assert" in dirnames:
                 dirnames.remove("assert")
-            # remove broken firmware dir in 14.6.1 IPSW
-            if "C-4388__s-C2" in dirnames:
-                dirnames.remove("C-4388__s-C2")
+            for i in skip_dirs:
+                if i in dirnames:
+                    dirnames.remove(i)
             subpath = os.path.relpath(dirpath, source_path)
             for name in sorted(filenames):
                 if not any(name.endswith("." + i) for i in self.EXTMAP):
@@ -57,6 +62,9 @@ class WiFiFWCollection(object):
                 # them for now
                 if "_gen" in name:
                     continue
+                # macOS 26 lists the firmware hashes beside the firmware.
+                if name == "TrustedSHAInformation.txt":
+                    continue
                 path = os.path.join(dirpath, name)
                 relpath = os.path.join(subpath, name)
                 if not name.endswith(".txt"):
@@ -77,7 +85,11 @@ class WiFiFWCollection(object):
                 for dim in self.DIMS:
                     if dim in props:
                         ident.append(props.pop(dim))
-                assert not props
+                # macOS 26 adds an F property for some 4388 C0 modules. How
+                # Linux would name those files is not known, so leave them out.
+                if props:
+                    log.info(f"Skipping {relpath}: unknown properties {sorted(props)}")
+                    continue
 
                 node = self.root
                 for k in ident:
